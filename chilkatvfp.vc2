	PROCEDURE loadbase64		&& Introduced in version 9.5.0.47. Loads a public key from base64-encoded DER (can be PKCS1 or PKCS8). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadBase64
		* Purpose:           Loads a public key from base64-encoded DER (can be PKCS1 or PKCS8).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyString, the public key string to load
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.47
		** 
		** Loads a public key from base64-encoded DER (can be PKCS1 or PKCS8).
		** 
		** Fixed for Version 11.6.0: Standardized failure behavior across all load methods: 
		** A failed load clears the object (Empty = true, KeyType = "empty", 
		** KeySize = 0, LastMethodSuccess = false) and preserves no previous key.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcKeyString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 47
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadBase64(m.tcKeyString) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadbd		&& Introduced in version 9.5.0.83. Loads a public key from any binary or string format where the data is contained in bd. Chilkat automatically recognizes the format and key type (RSA, EC, DSA, Ed25519, ..)  Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadBd
		* Purpose:           Loads a public key from any binary or string format 
		*                    where the data is contained in bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Loads a public key from any binary or string format where the data is contained in bd. 
		** Chilkat automatically recognizes the format and key type (RSA, EC, DSA, Ed25519, ..)
		** 
		** Fixed for Version 11.6.0: Standardized failure behavior across all load methods: 
		** A failed load clears the object (Empty = true, KeyType = "empty", 
		** KeySize = 0, LastMethodSuccess = false) and preserves no previous key.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		       loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadBd(m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadecdsa		&& Introduced in version 9.5.0.85. Loads an ECDSA public key directly from Qx, Qy values specified as a hex strings.
		*==============================================================================
		* Method:            LoadEcdsa
		* Purpose:           Loads an ECDSA public key directly 
		*                    from Qx, Qy values specified as a hex strings.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCurveName, the elliptic curve name.
		*                    tcQx, the X value
		*                    tcQy, the y value
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.85
		**
		** Loads an ECDSA public key directly from Qx, Qy values specified as a hex strings. 
		** The curveName can be one of the following:
		** 
		**   secp256r1
		**   secp384r1
		**   secp521r1
		**   secp256k1
		**   secp192r1
		**   secp224r1
		**   brainpoolp256r1
		**   brainpoolp160r1
		**   brainpoolp192r1
		**   brainpoolp224r1
		**   brainpoolp320r1
		**   brainpoolp384r1
		**   brainpoolp512r1
		** 
		** Note: ECDSA public keys of various formats, such as PKCS8, PKCS1, JWK, XML, 
		** binary DER, PEM, etc., can be loaded using the LoadBd, LoadFromBinary, LoadFromFile, 
		** and LoadFromString methods.
		**
		** Fixed for Version 11.6.0: Rejects malformed/short coordinates, 
		** prefixes, whitespace, empty and all-zero values, and unsupported curves.
		** 
		** Fixed for Version 11.6.0: Standardized failure behavior across all load methods: 
		** A failed load clears the object (Empty = true, KeyType = "empty", 
		** KeySize = 0, LastMethodSuccess = false) and preserves no previous key.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCurveName AS Character, tcQx AS Character, tcQy AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 85
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadEcdsa(m.tcCurveName, m.tcQx, m.tcQy) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loaded25519		&& Introduced in version 9.5.0.83. Loads the public key object from a 32-byte ed25519 key specified as a hex string. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadEd25519
