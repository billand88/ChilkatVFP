	PROCEDURE privatekeyat		&& Introduced in version 11.0.0. Returns the Nth private key in privKey. (The 1st private key is at index 0.) Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CertAt
		* Purpose:           Returns in cert the Nth certificate in the PFX. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		*                    tiCertificate, the certificate position in the array.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Returns in cert the Nth certificate in the PFX. The 1st certificate is at index 0.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiCertificate AS Integer, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CertAt(m.tiCertificate, m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = m.loParkParameterCert.SetObject(;
		      m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsafebagattr		&& Introduced in version 9.5.0.83. Sets a safe bag attribute for the Nth private key or certificate in the PFX. Safe bag attributes can be added by calling this method once for each attribute to be added to each certificate or key.
		*==============================================================================
		* Method:            SetSafeBagAttr
		* Purpose:           Sets a safe bag attribute for the Nth private key 
		*                    or certificate in the PFX.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuIsPrivateKey, whether or not the index references 
		*                    a private key or a certificate
		*                    tiIndex, the index into the private key/certificate array.
		*                    tcAttributeName, the attribute name to locate.
		*                    tcAttributeValue, the attribute value to set.
		*                    tcEncoding, the encoding of the value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Sets a safe bag attribute for the Nth private key or certificate in the PFX. 
		** Safe bag attributes can be added by calling this method once for each attribute 
		** to be added to each certificate or key. forPrivateKey should be 1 for a private key, 
		** and 0 for a certificate. The index is the index of the certificate or key in the PFX. 
		** (The 1st item is at index 0.) See the example below for more information. 
		** The encoding indicates a binary encoding such as "base64", "hex", "decimal", 
		** "fingerprint", etc if the value contains binary (non-text) data.
		** 
		** A safe bag attribute can be removed by passing an empty string for the value.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuIsPrivateKey AS Unknown, tiIndex AS Integer, ;
		tcAttributeName AS Character, tcAttributeValue AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liIsPrivateKey AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIsPrivateKey, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIsPrivateKey = .LogicalToBit(m.tuIsPrivateKey)
		
		      TRY
		
		        STORE m.loChilkatObject.SetSafeBagAttr(m.liIsPrivateKey, m.tiIndex, ;
		        m.tcAttributeName, m.tcAttributeValue, m.tcEncoding) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE tobd		&& Introduced in version 11.0.0. Write the PFX to bd. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ToBd
		* Purpose:           Write the PFX to bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword the password to the key store.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Write the PFX to bd.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcPassword AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ToBd(m.tcPassword, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE tobinary		&& Introduced in version 9.5.0.44. Write the PFX to in-memory bytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
		* Method:            ToBinary
		* Purpose:           Write the PFX to in-memory bytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- The PEM password
		* Returns:           The binary in-memory bytes.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		** 
		** Write the PFX to in-memory bytes.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		**
		
		LPARAMETERS tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		lqInMemoryBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqInMemoryBytes
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lqInMemoryBytes = m.loChilkatObject.ToBinary(m.tcPassword)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqInMemoryBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE toencodedstring		&& Introduced in version 9.5.0.44. Write the PFX to an encoded string. The encoding can be any encoding such as "base64" or "hex". Returns Nothing on failure
		*==============================================================================
		* Method:            ToEncodedString
		* Purpose:           Write the PFX to an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- the PFX password
		*                    tcEncoded -- the encoding of the returned string.
		* Returns:           An encoded string.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Write the PFX to an encoded string. 
		** The encoding can be any encoding such as "base64" or "hex".
		**
		** Enchancement for Version 49: Added Base58 encoding as an additional choice 
		** for all places where an encoding (such as “base64”, “hex”, etc.) can be selected.
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		** 
		** Enhancement for Version 67: 
		** Added the “base64_mime” to the list of possible encodings. 
		**
		** Enhancement for Version 75: 
		** Added the “hexlower” encoding. “hexlower” may be used instead of “hex” 
		** to get the hexadecimal encoding using lowercase a-f
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcPassword AS Character, tcEncoded AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		lcEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedString = []
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcEncodedString = ;
		        m.loChilkatObject.ToEncodedString(m.tcPassword, m.tcEncoded)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE tofile		&& Introduced in version 9.5.0.44. Write the PFX to a file. PFX and PKCS12 are essentially the same. Standard filename extensions are ".pfx" or ".p12". Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ToFile
		* Purpose:           Write the PFX to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- the PFX password
