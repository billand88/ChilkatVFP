	HIDDEN PROCEDURE fileopenerror_access		&& Access method used to retrieve the Chilkat FileAccess FileOpenError property.
		*==============================================================================
		* Method:            FileOpenError_Access
		* Purpose:           Access method used to retrieve the Chilkat Email FileOpenError property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FileOpenError
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** This property is set by the following methods: FileOpen, OpenForRead, 
		** OpenForWrite, OpenForReadWrite, and OpenForAppend. It provides an error code 
		** indicating the failure reason. Possible values are:
		**
		** 0) Success (No error)
		** 1) Access denied.
		** 2) File not found.
		** 3) General (non-specific) open error.
		** 4) File aleady exists.
		** 5) Path refers to a directory and the access requested involves writing.
		** 6) Too many symbolic links were encountered in resolving path.
		** 7) The process already has the maximum number of files open.
		** 8) Pathname is too long.
		** 9) The system limit on the total number of open files has been reached.
		** 10) Pathname refers to a device special file and no corresponding device exists.
		** 11) Insufficient kernel memory was available.
		** 12) Pathname was to be created but the device containing pathname has no room for the new file.
		** 13) A component used as a directory in pathname is not, in fact, a directory.
		** 14) Pathname refers to a regular file, too large to be opened 
		**     (this would be a limitation of the underlying operating system, 
		**     not a limitation imposed by Chilkat).
		** 15) Pathname refers to a file on a read-only filesystem and write access was requested.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE fileopenerror_assign		&& Assign method used to hold the Chilkat FileAccess FileOpenError property.
		*==============================================================================
		* Method:            FileOpenError_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the FileOpenError property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the FileOpenError property.
		* Returns:           
		* Date Added:        07/26/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE fileread		&& Reads bytes from the currently open file. maxNumBytes specifies the maximum number of bytes to read. Returns an empty byte array on error. Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            FileRead
		* Purpose:           Reads bytes from the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaximumBytes, the maximum number of bytes to read.
		* Returns:           The read bytes
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Reads bytes from the currently open file. 
		** maxNumBytes specifies the maximum number of bytes to read. 
		** Returns an empty byte array on error.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tiMaximumBytes AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, tqBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.tqBytes 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      tqBytes = m.loChilkatObject.FileRead(m.tiMaximumBytes)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.tqBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE filereadbd		&& Introduced in version 9.5.0.64. Reads bytes from the currently open file. maxNumBytes specifies the maximum number of bytes to read. Appends the bytes to the binData. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FileReadBd
		* Purpose:           Reads bytes from the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaximumBytes, the maximum number of bytes to read.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.64
		**
		** Reads bytes from the currently open file. 
		** maxNumBytes specifies the maximum number of bytes to read. 
		** Appends the bytes to the binData.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiMaximumBytes AS Integer, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 64
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FileReadBd(m.tiMaximumBytes, ;
		        m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

