	PROCEDURE appendmimewithflags		&& Same as AppendMime, but allows the flags associated with the email to be set at the same time. A flag is on if 1, and off if 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendMIMEWithFlags
		* Purpose:           Same as AppendMime, but allows the flags associated 
		*                    with the email to be set at the same time.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMailBox -- the mailbox to append the MIME
		*                    tcMIMEText -- the MIME text to append.
		*                    tuSeen -- whether or not the email is set to Seen.
		*                    tuFlagged -- whether or not the email is set to Flagged.
		*                    tuAnswered -- whether or not the email is set to Answered.
		*                    tuDraft -- whether or not the email is set to Draft.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Same as AppendMime, but allows the flags 
		** associated with the email to be set at the same time. 
		** A flag is on if 1, and off if 0.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMailBox AS Character, tcMIMEText AS Character, tuSeen AS Unknown, ;
		tuFlagged AS Unknown, tuAnswered AS Unknown, tuDraft AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liDraft AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		liSeen AS Integer, liFlagged AS Integer, liAnswered AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liSeen, m.liFlagged, m.liAnswered, m.liDraft
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liSeen = .LogicalToBit(m.tuSeen)
		    liFlagged = .LogicalToBit(m.tuFlagged)
		    liAnswered = .LogicalToBit(m.tuAnswered)
		    liDraft = .LogicalToBit(m.tuDraft)
		
		    TRY
		
		      STORE m.loChilkatObject.AppendMIMEWithFlags(m.tcMailBox, m.tcMIMEText, ;
		      m.liSeen, m.liFlagged, m.liAnswered, m.liDraft) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

