	PROCEDURE disconnect		&& Disconnects from the FTP server, ending the current session. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Disconnect
		* Purpose:           Disconnects from the FTP server, ending the current session.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/01/2022
		*==============================================================================
		
		**
		** Disconnects from the FTP server, ending the current session.
		**
		** Fixed for version 92: Automatically clears the internal cached directory 
		** listing when disconnecting or connecting. Previously, 
		** it might’ve been needed to call the ClearDirCache function.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning OF iChilkat.VCX]
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCalculatedBuildNumber
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      ** Before version 92 test
		      IF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 92)
		
		        .ClearDirCache()
		
		      ENDIF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 92)
		      ** Before version 92 test
		
		      TRY
		
		        STORE m.loChilkatObject.Disconnect() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have versioning object test
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE disconnectasync		&& Creates an asynchronous task to call the Disconnect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
