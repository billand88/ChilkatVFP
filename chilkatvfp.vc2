		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCertChain, m.loChilkatCertChain
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCertChain = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCertChain)
		
		      loChilkatCertChain = m.loParkParameterCertChain.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddCertChain(m.loChilkatCertChain) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCertChain = ;
		      m.loParkParameterCertChain.SetObject(m.toChilkatCertChain, m.loChilkatCertChain)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCertChain, m.loChilkatCertChain
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  toChilkatCertChain = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loParkParameterCertChain = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCertChain = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addcertencoded		&& Introduced in version 9.5.0.40. Adds a certificate to the XML vault where certificate is passed directly from encoded bytes (such as Base64, Hex, etc.). The encoding is indicated by encoding. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddCertEncoded
		* Purpose:           Adds a certificate to the XML vault 
		*                    where certificate is passed directly from encoded bytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedBytes, the encoded character bytes.
		*                    tcEncoding, the encoding of the character bytes.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Adds a certificate to the XML vault where certificate is passed directly 
		** from encoded bytes (such as Base64, Hex, etc.). The encoding is indicated by encoding.
		**
		** Enchancement for Version 49: Added Base58 encoding as an additional choice 
		** for all places where an encoding (such as “base64”, “hex”, etc.) can be selected.
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEncodedBytes AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddCertEncoded(m.tcEncodedBytes, m.tcEncoding) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
