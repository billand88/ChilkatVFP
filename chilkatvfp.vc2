	ENDPROC

	PROCEDURE getrcvdclientcert		&& Introduced in version 11.0.0. This method retrieves the Nth client certificate received during an SSL/TLS handshake on the server side of the connection. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetRcvdClientCert
		* Purpose:           This method retrieves the Nth client certificate 
		*                    received during an SSL/TLS handshake on the server side of the connection. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex - the Certificate index value.
		*                    toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This method retrieves the Nth client certificate received during 
		** an SSL/TLS handshake on the server side of the connection. 
		** The first client certificate is found at index 0. 
		** The number of certificates received is available in the NumReceivedClientCerts property. 
		** The client certificate is returned in cert.
		** 
		** Client certificates are typically sent only when the server requests client-side authentication, 
		** such as in a two-way SSL/TLS connection. (2-way TLS (also known as mutual TLS or mTLS) 
		** is a form of Transport Layer Security (TLS) in which both the client and the server 
		** authenticate each other using digital certificates.)
		** 
		** This method enables the server to access and examine client certificates immediately 
		** after the connection is established. If the client certificates 
		** do not meet authentication requirements, the server may disconnect.
		** 
		** Important: Call this method on the socket object returned by AcceptNextConnection.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, llImplemented AS Logical, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatCert
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetRcvdClientCert(m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = m.loParkParameterSocket.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE getreceivedclientcert		&& Returns the Nth client certificate received during an SSL/TLS handshake. This method only applies to the server-side of an SSL/TLS connection. The 1st client certificate is at index 0.
		*==============================================================================
		* Method:            GetReceivedClientCert
		* Purpose:           Returns the Nth client certificate received during an SSL/TLS handshake.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the client certificate index
		* Returns:           loChilkatCert, a Chilkat Certificate object.
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Returns the Nth client certificate received during an SSL/TLS handshake. 
		** This method only applies to the server-side of an SSL/TLS connection. 
		** The 1st client certificate is at index 0. 
		** The NumReceivedClientCerts property indicates the number of client certificates 
		** received during the SSL/TLS connection establishment.
		**
		** Client certificates are customarily only sent 
		** when the server demands client-side authentication, as in 2-way SSL/TLS. 
		** This method provides the ability for the server to access 
		** and examine the client-side certs immediately after a connection is established. 
		** (Of course, if the client-side certs are inadequate for authentication, 
		** then the application can choose to immediately disconnect.)
		**
		** Important: This method should be called from the socket object 
		** that is returned by AcceptNextConnection.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.GetReceivedClientCert(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getservercert		&& Introduced in version 11.0.0. This method returns the digital certificate of the remote SSL server for the current SSL connection on the client side. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetServerCert
		* Purpose:           This method returns the digital certificate of the remote 
		*                    SSL server for the current SSL connection on the client side. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This method returns the digital certificate of the remote SSL server 
		** for the current SSL connection on the client side. 
		** The certificate is returned in cert. If the socket is not connected 
		** or is not using SSL, it returns 0.
