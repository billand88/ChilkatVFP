	HIDDEN PROCEDURE keylength_access		&& Access method used to retrieve the Chilkat Crypt2 KeyLength property.
		*==============================================================================
		* Method:            KeyLength_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 KeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.KeyLength
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** The key length in bits for symmetric encryption algorithms. The default value is 256.
		**
		** Fix for Version 58: The value of the KeyLength property should always 
		** be in agreement with the number of bytes of key material provided by the application.
		** The SetEncodedKey method correctly has the side-effect of also setting the KeyLength property. 
		** However, setting the SecretKey property directly did not also have this desired side-effect.
		** This was fixed. If the SecretKey property is set with 16 bytes of data (128 bits) 
		** then the KeyLength property is automatically updated to 128.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE keylength_assign		&& Assign method used to hold a reference to the KeyLength property.
		*==============================================================================
		* Method:            KeyLength_Assign
		* Purpose:           Assign method used to hold a reference to the KeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the KeyLength property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [RC2EffectiveKeyLength] && See the RC2EffectiveKeyLength property.
		lcMethodToCall = [Long]
		
		WITH THIS
		
		  .CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ** Update the VFP SecretKey property...
		  .SecretKey = .SecretKey
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat Crypt2 LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqValue, the last binary result.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [VariantReadOnly]
		
		THIS.CallAssignObject(m.tqValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE lastchunk_access		&& Access method used to retrieve the Chilkat Crypt2 LastChunk property.
		*==============================================================================
		* Method:            LastChunk_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 LastChunk property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastChunk
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Chilkat Crypt2 provides the ability to feed 
		** the encryption/decryption methods with chunks of data. 
		** This allows a large amount of data, or a data stream, 
		** to be fed piecemeal for encrypting or decrypting. 
		** It applies to all symmetric algorithms currently supported 
		** (AES, Blowfish, Twofish, 3DES, RC2, DES, ARC4), and all algorithms supported in the future.
		** 
		** The default value for both FirstChunk and LastChunk is 1. 
		** This means when an Encrypt* or Decrypt* method is called, 
		** it is both the first and last chunk (i.e. it's the entire amount of data to be encrypted or decrypted).
		**
		** If you wish to feed the data piecemeal, do this:
		** 
		**   1) Set FirstChunk = 1, LastChunk = 0 for the first chunk of data.
		**   2) For all "middle" chunks (i.e. all chunks except for the final chunk) 
		**      set FirstChunk = 0 and LastChunk = 0.
		**   3) For the final chunk, set FirstChunk = 0 and LastChunk = 1
		**
		** There is no need to worry about feeding data 
		** according to the block size of the encryption algorithm. 
		** For example, AES has a block size of 16 bytes. Data may be fed in chunks of any size. 
		** The Chilkat Crypt2 component will buffer the data. When the final chunk is passed, 
		** the output is padded to the algorithm's block size according to the PaddingScheme.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastchunk_assign		&& Assign method used to hold a reference to the LastChunk property.
