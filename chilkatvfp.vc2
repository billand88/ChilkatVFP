	PROCEDURE fetchsingleheader		&& Retrieves a single message header from the IMAP server. If the method fails, it may return a NULL reference.
		*==============================================================================
		* Method:            FetchSingleHeader
		* Purpose:           Retrieves a single message header from the IMAP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageID -- the message ID of the copied message.
		*                    tuUID -- whether or not the message ID is a UID.
		* Returns:           A Chilkat Email object, or NULL
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Retrieves a single message header from the IMAP server. 
		** If the method fails, it may return a NULL reference. 
		** The following methods are useful for retrieving information 
		** about attachments and flags after an email header is retrieved: 
		** GetMailNumAttach, GetMailAttachSize, GetMailAttachFilename, GetMailFlag. 
		** If bUid is true, then msgID represents a UID. 
		** If bUid is false, then msgID represents a sequence number.
		**
		** Fixed in version 69: Fixed a rare internal IMAP message parsing error.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiMessageID AS Integer, tuUID AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		loException AS Exception, loChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmail
		
		luID = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUID = .LogicalToBit(m.tuUID)
		
		    TRY
		
		      loChilkatEmail = m.loChilkatObject.FetchSingleHeader(m.tiMessageID, m.liUID)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmail
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatEmail  = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

