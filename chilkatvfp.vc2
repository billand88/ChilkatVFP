	PROCEDURE quickrequestparams		&& This is the same as the QuickRequest method, except query params can be provided as non-URL-encoded name/value members in the json. Returns Nothing on failure
		*==============================================================================
		* Method:            QuickRequestParams
		* Purpose:           This is the same as the QuickRequest method, except query params 
		*                    can be provided as non-URL-encoded name/value members in the json.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb -- the action to take.
		*                    tcURL -- the URL to request the content.
		*                    toChilkatJSONObject -- a Chilkat JSON object.
		* Returns:           Chilkat HTTP Response object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.89
		**
		** This is the same as the QuickRequest method, 
		** except query params can be provided as non-URL-encoded name/value members in the json.
		**
		** Starting in version 97: 
		**
		** If the HTTP verb is “OPTIONS”, then Chilkat will now allow for the path to be “*”. 
		** Previously, Chilkat forced the path in the HTTP start line to begin with a “/”. 
		** Also, when the HTTP verb is OPTIONS, no “Content-Length” header
		** will be included in the request.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character, ;
		toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		llImplemented = .F.
		liIntroducedInBuild = 89
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        loChilkatHTTPResponse = ;
		        m.loChilkatObject.QuickRequestParams(m.tcVerb, m.tcURL, m.loChilkatJSONObject)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

