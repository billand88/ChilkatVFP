		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumRows
		* Date Added:        05/25/2022
		*==============================================================================
		
		**
		** The number of data rows. 
		** If the CSV has column names, the 1st row is not included in the count. 
		** Also, empty lines containing only whitespace characters that follow 
		** the last non-empty row are not included.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE numrows_assign		&& Assign method used to hold a reference to the NumRows property.
		*==============================================================================
		* Method:            NumRows_Assign
		* Purpose:           Assign method used to hold 
		*                    the NumRows property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the NumRows property.
		* Returns:           
		* Date Added:        05/25/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE rowmatches		&& Compares the contents of an entire row to a wildcarded match pattern where "*" can be used any number of times to match 0 or more of any character. Returns 1 if a match was found, otherwise returns 0.
		*==============================================================================
		* Method:            RowMatches
		* Purpose:           Compares the contents of an entire row to a wildcarded match pattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the related row index value.
		*                    tcMatchPattern, the pattern to match.
		*                    tuCaseSensitive, whether or not the pattern match is case sensitive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/25/2022
		*==============================================================================
		
		**
		** Compares the contents of an entire row to a wildcarded match pattern 
		** where "*" can be used any number of times to match 0 or more of any character. 
		** Returns 1 if a match was found, otherwise returns 0. 
		** If caseSensitive is 1, then the pattern match is case sensitive, 
		** otherwise it is case insensitive.
		**
		
		LPARAMETERS tiIndex AS Integer, tcMatchPattern AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CSV_COM_CALL, liCaseSensitive AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    TRY
		
		      STORE m.loChilkatObject.RowMatches(m.tiIndex, m.tcMatchPattern, m.liCaseSensitive) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSV_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

