	PROCEDURE copysequence		&& Copies one or more emails from one mailbox to another. The emails are specified as a range of sequence numbers. The 1st email in a mailbox is always at sequence number 1. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CopySequence
		* Purpose:           Copies one or more emails from one mailbox to another.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiSequenceNumber -- the starting email sequence number.
		*                    tiCount -- the number of emails to copy
		*                    tcToMailBox -- the mailbox name to receive the messages.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Copies one or more emails from one mailbox to another. 
		** The emails are specified as a range of sequence numbers. 
		** The 1st email in a mailbox is always at sequence number 1.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiSequenceNumber AS Integer, ;
		tiCount AS Integer, tcToMailBox AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CopySequence(m.tiSequenceNumber, ;
		      m.tiCount, m.tcToMailBox) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

