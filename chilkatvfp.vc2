	PROCEDURE verifycertsignatures		&& Introduced in version 9.5.0.40. Verifies the certificate signatures to the root. Returns 1 if all certificate signatures are valid.
		*==============================================================================
		* Method:            VerifySignatures
		* Purpose:           Verifies the certificate signatures to the root.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Verifies the certificate signatures to the root. 
		** Returns 1 if all certificate signatures are valid.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERTCHAIN_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.VerifySignatures() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE x509pkipathv1		&& Introduced in version 9.5.0.88. Returns the base64 representation of an X509PKIPathv1 containing the certificates in this chain. This is typically used in an X.509 Binary Security Token.
		*==============================================================================
		* Method:            X509PKIPathV1
		* Purpose:           Returns the base64 representation of an X509PKIPathv1 
		*                    containing the certificates in this chain.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The certificate chain's certificate path.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		**
		** Returns the base64 representation of an X509PKIPathv1 
		** containing the certificates in this chain. 
		** This is typically used in an X.509 Binary Security Token. 
		** It is a PKIPath that contains an ordered list of X.509 public certificates 
		** packaged in a PKIPath. The X509PKIPathv1 token type may be used to represent 
		** a certificate path. (This is sometimes used in XAdES signatures.)
		** 
		** Returns Nothing on failure
		**
		** Fixed for version 98: Fixed the CertChain.X509PKIPathv1 method. 
		** It was returning the base64 ASN.1 with the certs listed in the order 
		** that is the reverse as specified by the standard.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERTCHAIN_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, lcPath AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		lcPath = []
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcPath = m.loChilkatObject.X509PKIPathV1()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcPath
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS certstore AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a collection of certificates that can be loaded from various sources.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addcertificate		&& (This method only available on Microsoft Windows operating systems.) Adds a certificate to the store. If the certificate is already in the store, it is updated with the new information. Returns 1 for success, 0 for failure.
		*m: avoidwindowspkaccess_access		&& Access method used to retrieve the Chilkat CertStore AvoidWindowsPKAccess property.
		*m: avoidwindowspkaccess_assign		&& Assign method used to hold a reference to the AvoidWindowsPKAccess property.
		*m: closecertstore		&& Introduced in version 9.5.0.94. (This method only available on Microsoft Windows operating systems.) Closes the certificate store previously opened by one of the Open* methods. Returns 1 for success, 0 for failure.
		*m: createfilestore		&& (This method only available on Microsoft Windows operating systems.) Creates a new file-based certificate store. Certificates may be saved to this store by calling AddCertificate. Returns 1 for success, 0 for failure.
		*m: creatememorystore		&& (This method only available on Microsoft Windows operating systems.) Creates an in-memory certificate store. Certificates may be added by calling AddCertificate. Returns 1 for success, 0 for failure.
		*m: createregistrystore		&& (This method only available on Microsoft Windows operating systems.) Creates a registry-based certificate store. regRoot must be "CurrentUser" or "LocalMachine". regPath is a registry path such as "Software/MyApplication/Certificates".
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat CertStore DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: findcert		&& Introduced in version 10.1.2. Searches for a certificate using the criteria in json and stores the result in cert. Returns 1 for success, 0 for failure.
		*m: findcertbykeycontainer		&& Introduced in version 9.5.0.77. Finds a certificate by it's key container name. Returns Nothing on failure.
		*m: findcertbyrfc822name		&& Locates and returns a certificate by its RFC 822 name. If multiple certificates match, then non-expired certificates will take precedence over expired certificates.
		*m: findcertbyserial		&& Finds and returns the certificate that has the matching serial number. Returns Nothing on failure.
		*m: findcertbysha1thumbprint		&& Finds a certificate by it's SHA-1 thumbprint. The thumbprint is a hexidecimal string. Returns Nothing on failure.
		*m: findcertbysubject		&& Finds a certificate where one of the Subject properties (SubjectCN, SubjectE, SubjectO, SubjectOU, SubjectL, SubjectST, SubjectC) matches exactly (but case insensitive) with the passed string.
		*m: findcertbysubjectcn		&& Finds a certificate where the SubjectCN property matches exactly with the passed string. Returns Nothing on failure.
		*m: findcertbysubjecte		&& Finds a certificate where the SubjectE property (email address) matches exactly (but case insensitive) with the passed string.
		*m: findcertbysubjecto		&& Finds a certificate where the SubjectO property (organization) matches exactly (but case insensitive) with the passed string. Returns Nothing on failure.
		*m: findcertforemail		&& (This method only available on Microsoft Windows operating systems.) Finds a certificate that can be used to send secure email to the passed email address.
		*m: getcert		&& Introduced in version 10.1.2. Loads the Nth certificate into cert. The first certificate is at index 0. Returns 1 for success, 0 for failure.
		*m: getcertificate		&& Returns the Nth certificate in the store. The first certificate is at index 0. Returns Nothing on failure.
		*m: getemailcert		&& (This method only available on Microsoft Windows operating systems.) Returns the Nth email certificate in the store. The first certificate is at index 0. Use the NumEmailCertificates property to get the number of email certificates.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat CertStore LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat CertStore LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat CertStore LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat CertStore LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat CertStore LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat CertStore LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat CertStore LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadpemfile		&& Loads the certificates contained within a PEM formatted file. Returns 1 for success, 0 for failure.
		*m: loadpemstr		&& Loads the certificates contained within an in-memory PEM formatted string. Returns 1 for success, 0 for failure.
		*m: loadpfxbd		&& Introduced in version 10.1.2. Loads the PFX/P12 bytes contained in bd. Password is the password to the PFX. Returns 1 for success, 0 for failure.
		*m: loadpfxdata		&& Loads a PFX from an in-memory image of a PFX file. Once loaded, the certificates within the PFX may be searched via the Find* methods.
		*m: loadpfxfile		&& Loads a PFX file. Once loaded, the certificates within the PFX may be searched via the Find* methods. It is also possible to iterate from 0 to NumCertficates-1, calling GetCertificate for each index, to retrieve each certificate within the PFX.
		*m: numcertificates_access		&& Access method used to retrieve the Chilkat CertStore NumCertificates property.
		*m: numcertificates_assign		&& Assign method used to hold a reference to the NumCertificates property.
		*m: numemailcerts_access		&& Access method used to retrieve the Chilkat CertStore NumEmailCerts property.
		*m: numemailcerts_assign		&& Assign method used to hold a reference to the NumEmailCerts property.
		*m: openchilkatstore		&& (This method only available on Microsoft Windows operating systems.) Opens the registry-based local machine certificate store having the path "Software/Chilkat/SystemCertificates". If the certificate store does not exist, it is automatically created.
		*m: opencurrentuserstore		&& (This method is only available on Microsoft Windows operating systems.) Opens the registry-based Current-User\Personal certificate store.
		*m: openfilestore		&& (This method only available on Microsoft Windows operating systems.) Opens a file-based certificate store. Once loaded, the certificates within the store may be searched via the Find* methods.
		*m: openlocalsystemstore		&& (This method is only available on Microsoft Windows operating systems.) Opens the registry-based Local-Computer\Personal certificate store.
		*m: openoutlookstore		&& (This method is only available on Microsoft Windows operating systems.) Opens the registry-based Current-User\Other People certificate store. This is the certificate store use by Microsot Outlook.
		*m: openregistrystore		&& (This method only available on Microsoft Windows operating systems.) Opens an arbitrary registry-based certificate store. regRoot must be "CurrentUser" or "LocalMachine". regPath is a registry path such as "Software/MyApplication/Certificates".
		*m: opensmartcard		&& Introduced in version 9.5.0.80. Opens the certificate store on the smartcard currently in the reader or USB token. The csp can be set to the name of the CSP (Cryptographic Service Provider) that should be used.
		*m: openwindowsstore		&& Introduced in version 9.5.0.49. (This method only available on Microsoft Windows operating systems.) Opens a Microsoft Windows certificate store. storeLocation must be "CurrentUser" or "LocalMachine".
		*m: removecertificate		&& (This method only available on Microsoft Windows operating systems.) Removes the passed certificate from the store.  The certificate object passed as the argument can no longer be used once removed. Returns 1 for success, 0 for failure.
		*m: smartcardpin_access		&& Access method used to retrieve the Chilkat CertStore SmartCardPIN property.
		*m: smartcardpin_assign		&& Assign method used to hold a reference to the SmartCardPIN property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat CertStore UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the SmartCardPIN property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat CertStore VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: avoidwindowspkaccess		&& Applies only when running on a Microsoft Windows operating system. If 1, then any method that returns a certificate will not try to also access the associated private key, assuming one exists.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcertificates		&& The number of certificates held in the certificate store.
		*p: numemailcerts		&& (This property only available on Microsoft Windows operating systems.) The number of certificates that can be used for sending secure email within this store.
		*p: smartcardpin		&& Introduced in version 9.5.0.86. Can be set to the PIN value for a certificate / private key stored on a smart card.
		*p: uncommonoptions		&& Introduced in version 9.5.0.87. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		avoidwindowspkaccess = 0
		cchilkatclass = CertStore
		debuglogfilepath = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "certstore"
		numcertificates = 0
		numemailcerts = 0
		smartcardpin = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addcertificate		&& (This method only available on Microsoft Windows operating systems.) Adds a certificate to the store. If the certificate is already in the store, it is updated with the new information. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddCertificate
		* Purpose:           Adds a certificate to the store.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** (This method only available on Microsoft Windows operating systems.)
		** 
		** Adds a certificate to the store. If the certificate is already in the store, 
		** it is updated with the new information.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddCertificate(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE avoidwindowspkaccess_access		&& Access method used to retrieve the Chilkat CertStore AvoidWindowsPKAccess property.
		*==============================================================================
		* Method:            AvoidWindowsPKAccess_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CertStore AvoidWindowsPKAccess property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AvoidWindowsPKAccess
		* Date Added:        07/27/2022
		*==============================================================================
		
		** 
		** Applies only when running on a Microsoft Windows operating system. 
		** If 1, then any method that returns a certificate will not try 
		** to also access the associated private key, assuming one exists. 
		** This is useful if the certificate was installed with high-security 
		** such that a private key access would trigger the Windows OS to display 
		** a security warning dialog. The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE avoidwindowspkaccess_assign		&& Assign method used to hold a reference to the AvoidWindowsPKAccess property.
		*==============================================================================
		* Method:            AvoidWindowsPKAccess_Assign
		* Purpose:           Assign method used to hold a reference to the AvoidWindowsPKAccess property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AvoidWindowsPKAccess property.
		* Returns:           
		* Date Added:        07/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 10.1.2
		
		  Improved functionality for smart cards and USB tokens. Also extended to better support the Apple Keychain.
		  
		  Added the following methods: FindCert, GetCert, LoadPfxBd.
		
		  Decremented methods that return a newly created Chilkat.Cert object. In the reference documentation, 
		  we’ve added a link to an example showing how to use the new method to replace the decremented method.
		
		** Version 10
		
		  Fixed: The LoadPfxFile method would result in 2 entries per certificate 
		  being listed within the CertStore object.
		
		** Version 96
		
		  Added support for the Watchdata PROXkey USB token.
		  Chilkat should automatically recognize the USB token
		  and use the PKCS11 driver at C:\Windows\System32\SignatureP11.dll.
		  (This is also supported on Linux, assuming the shared lib is at
		  /usr/lib/WatchData/ProxKey/lib/libwdpkcs_SignatureP11.so)
		
		** Version 95
		
		  Chilkat now works with the Turkish smartcard from TUBITAK UEKAE.
		
		  Chilkat now works correctly with the CryptoCertum 3.6 Cryptographic Card
		
		  Chilkat now works more seamlessly with the ePass2003 token.
		
		** Version 90
		
		  Improved automatic recognition and handling for various smart cards.
		
		** Version 88
		
		  Greatly improved internals for automatically recognizing and handling 
		  smart cards and USB tokens from many different vendors. 
		
		** Version 83
		
		  Improved internal functionality relating to SmartCards, Storage Providers, etc.
		  This is for Cert.LoadFromSmartcard, CertStore.OpenSmartcard, etc.
		
		** Version 80
		
		  Added the OpenSmartcard method. This is a Windows-only method that provides access
		  to the certificates on the smart card currently inserted into the reader.
		  (Can also be used with a USB token.)
		
		** Version 77
		
		  Added the FindCertByKeyContainer method.
		
		** Version 75
		
		  Support for Smartcard and USB tokens is much improved. Note: At this point, 
		  smartcards and USB tokens are supported on Windows operating systems only.
		
		  Added the ability to open .pfx/.p12 files where two different passwords are required:
		  one for integrity and the other for the private keys.
		  See the example at https://www.example-code.com/csharp/pfx_multiple_passwords.asp
		
		** Version 69
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		  Fixed an issue with automatically locating pre-installed Windows certificates
		  (for encryption) when the email address stored within the certificate used uppercase letters.
		
		** Version 67
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  Fixed a memory leak in the LoadPemFile method.
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 49
		
		  Added the OpenWindowsStore method.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE closecertstore		&& Introduced in version 9.5.0.94. (This method only available on Microsoft Windows operating systems.) Closes the certificate store previously opened by one of the Open* methods. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CloseCertStore
		* Purpose:           Closes the certificate store previously opened 
		*                    by one of the Open* methods.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        11/05/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.94
		**
		** (This method only available on Microsoft Windows operating systems.)
		** Closes the certificate store previously opened by one of the Open* methods.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 94
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.CloseCertStore() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE createfilestore		&& (This method only available on Microsoft Windows operating systems.) Creates a new file-based certificate store. Certificates may be saved to this store by calling AddCertificate. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CreateFileStore
		* Purpose:           Creates a new file-based certificate store.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the certificate store file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** (This method only available on Microsoft Windows operating systems.)
		**
		** Creates a new file-based certificate store. Certificates may be saved 
		** to this store by calling AddCertificate.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CreateFileStore(m.tcFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

