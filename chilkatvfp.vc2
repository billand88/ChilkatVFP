	PROCEDURE tojks		&& Introduced in version 9.5.0.49. Converts the PEM to JKS and returns the Java KeyStore object. If the alias is non-empty, the 1st object (private key or certificate) will use the alias, and all others (if any) will receive auto-generated aliases.
		*==============================================================================
		* Method:            ToJKS
		* Purpose:           Converts the PEM to JKS and returns the Java KeyStore object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAlias, the alias to apply.
		*                    tcPassword, the password to encrypt the Java.
		* Returns:           A Chilkat Java Key Store Object, or NULL.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Converts the PEM to JKS and returns the Java KeyStore object. 
		** If the alias is non-empty, the 1st object (private key or certificate) 
		** will use the alias, and all others (if any) will receive auto-generated aliases. 
		** The JKS returned will be encrypted using the provided password. 
		** If the PEM contains only certificates (no private keys), then the password is unused.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS tcAlias AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		loChilkatJavaKeyStore AS CHILKAT_JAVAKEYSTORE_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatJavaKeyStore
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatJavaKeyStore = m.loChilkatObject.ToJKS(m.tcAlias, m.tcPassword)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatJavaKeyStore
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loChilkatJavaKeyStore = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE tojksobj		&& Introduced in version 11.0.0. This function converts this PEM to a Java KeyStore (JKS) object and stores it in jksObj. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ToJksObj
		* Purpose:           This function converts this PEM to a Java KeyStore 
		*                    (JKS) object and stores it in jksObj.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAlias -- the JKS alias, if used.
		*                    tcPassword -- The JKS password.
		*                    toJavaKeyStore, a Chilkat Java Key Store object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This function converts this PEM to a Java KeyStore (JKS) object 
		** and stores it in jksObj. If alias is provided, 
		** it will be used as the alias for the first object in the PEM 
		** (either a private key or certificate), while subsequent objects 
		** will receive autogenerated aliases. The resulting JKS will be encrypted with password, 
		** unless the PEM contains only certificates, in which case password is not used.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcAlias AS Character, tcPassword AS Character, ;
		toChilkatJavaKeyStore AS CHILKAT_JAVAKEYSTORE_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterJavaKeyStore AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJavaKeyStore AS CHILKAT_JAVAKEYSTORE_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJavaKeyStore, m.loChilkatJavaKeyStore
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJavaKeyStore = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJavaKeyStore)
		
		      loChilkatJavaKeyStore = m.loParkParameterJavaKeyStore.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ToJksObj(m.tcAlias, m.tcPassword, ;
		        m.loChilkatJavaKeyStore) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  toChilkatJavaKeyStore = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  loParkParameterJavaKeyStore = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJavaKeyStore = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE topem		&& Introduced in version 9.5.0.47. Write the PFX to a PEM formatted string. The resultant PEM will contain the private key, as well as the certs in the chain of authentication (or whatever certs are available in the PFX).
		*==============================================================================
		* Method:            ToPEM
		* Purpose:           Write the PFX to a PEM formatted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A PEM formatted string
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.47
		**
		** Write the PFX to a PEM formatted string. 
		** The resultant PEM will contain the private key, as well as the certs 
		** in the chain of authentication (or whatever certs are available in the PFX). 
		** For example:
		**
		**   -----BEGIN RSA PRIVATE KEY-----
		**  ...
		**  ... the private key associated with the main certificate.
		**  ...
		**  -----END RSA PRIVATE KEY-----
		**  -----BEGIN CERTIFICATE-----
		**  ...
		**  ... the main certificate
		**  ...
		**  -----END CERTIFICATE-----
		**  -----BEGIN CERTIFICATE-----
		**  ...
		**  ... an intermediate CA certificate (if present)
		**  ...
		**  -----END CERTIFICATE-----
		**  -----BEGIN CERTIFICATE-----
		**  ...
		**  ... the root CA certificate
		**  ...
		**  -----END CERTIFICATE----- 
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		lcPEMFormattedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcPEMFormattedString = []
		llImplemented = .F.
		liIntroducedInBuild = 47
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcPEMFormattedString = m.loChilkatObject.ToPEM() 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcPEMFormattedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE topemex		&& Introduced in version 9.5.0.49. Write the PFX to a PEM formatted string. If extendedAttrs is 1, then extended properties (Bag Attributes and Key Attributes) are output. If noKeys is 1, then no private keys are output.
		*==============================================================================
		* Method:            ToPEMEx
		* Purpose:           Write the PFX to a PEM formatted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuExtendedAttributes, whether or not the extended properties are output.
		*                    tuNoKeys, whether or not the key keys are output.
		*                    tuNoCertificates, whether or not certificates are output.
		*                    tuNoCACertificates, whether or not CA certificates are output.
		*                    tcEncryptAlgorithm, the encryption algorithm to be used.
		*                    tcPassword, the password to be used. 
		* Returns:           A formatted string.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Write the PFX to a PEM formatted string. If extendedAttrs is 1, 
		** then extended properties (Bag Attributes and Key Attributes) are output. 
		** If noKeys is 1, then no private keys are output. 
		** If noCerts is 1, then no certificates are output. 
		** If noCaCerts is 1, then no CA certs or intermediate CA certs are output. 
		** If encryptAlg is not empty, it indicates the encryption algorithm to be used 
		** for encrypting the private keys (otherwise the private keys are output unencrypted). 
		** The possible choices for the encryptAlg are "des3", "aes128", "aes192", and "aes256". 
		** (All encryption algorithm choices use CBC mode.) If the private keys are to be encrypted, 
		** then password is the password to be used. Otherwise, password may be left empty. For example:
		** 
		**   Bag Attributes
		**       Microsoft Local Key set: <No Values>
		**       localKeyID: 01 00 00 00 
		**       friendlyName: le-2b09a3d2-9037-4a05-95cc-4d44518e8607
		**       Microsoft CSP Name: Microsoft RSA SChannel Cryptographic Provider
		**   Key Attributes
		**       X509v3 Key Usage: 10 
		**    -----BEGIN RSA PRIVATE KEY-----
		**   ...
		**   ... the private key associated with the main certificate.
		**   ...
		**   -----END RSA PRIVATE KEY-----
		**   Bag Attributes
		**       localKeyID: 01 00 00 00 
		**       1.3.6.1.4.1.311.17.3.92: 00 08 00 00 
		**       1.3.6.1.4.1.311.17.3.20: C2 53 54 F3 ...
		**       1.3.6.1.4.1.311.17.3.71: 49 00 43 00 ...
		**       1.3.6.1.4.1.311.17.3.75: 31 00 42 00 ...
		**   subject=/OU=Domain Control Validated/OU=PositiveSSL/CN=something.com
		**   issuer=/C=GB/ST=Greater Manchester/L=Salford/O=COMODO CA Limited/CN=COMODO RSA Domain Validation Secure Server CA
		**   -----BEGIN CERTIFICATE-----
		**   ...
		**   ... the main certificate
		**   ...
		**   -----END CERTIFICATE-----
		**   ...
		**   -----BEGIN CERTIFICATE-----
		**   ...
		**   ... an intermediate CA certificate (if present)
		**   ...
		**   -----END CERTIFICATE-----
		**   ...
		**   -----BEGIN CERTIFICATE-----
		**   ...
		**   ... the root CA certificate
		**   ...
		**   -----END CERTIFICATE----- 
		**
		** Update for Version 72: Encrypting 0 bytes for block cipher algorithms 
		** with padding now results in one block of output, rather than 0 bytes.
		** (Decrypting the 16-byte block will return the original 0 bytes.) 
		** This only applies to block ciphers operating in modes such as ECB, CBC, etc. 
		** This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tuExtendedAttributes AS Unknown, tuNoKeys AS Unknown, ;
		tuNoCertificates AS Unknown, tuNoCACertificates AS Unknown, ;
		tcEncryptAlgorithm AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loException AS Exception, ;
		liNoKeys AS Integer, liNoCertificates AS Integer, liNoCACertificates AS Integer, ;
		lcFormattedString AS Character, liExtendedAttributes AS Integer
		
		STORE 0 TO m.liExtendedAttributes, m.liNoKeys, ;
		m.liNoCertificates, m.liNoCACertificates, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcFormattedString = []
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liExtendedAttributes = .LogicalToBit(m.tuExtendedAttributes)
		      liNoKeys = .LogicalToBit(m.tuNoKeys)
		      liNoCertificates = .LogicalToBit(m.tuNoCertificates)
		      liNoCACertificates = .LogicalToBit(m.tuNoCACertificates)
		
		      TRY
		
		        lcFormattedString = m.loChilkatObject.ToPEMEx(m.liExtendedAttributes, m.liNoKeys, ;
		        m.liNoCertificates, m.liNoCACertificates, m.tcEncryptAlgorithm, m.tcPassword) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFormattedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE topfx		&& Introduced in version 9.5.0.49. Converts the PEM to PKCS12 and returns the PFX object. The PFX object has method for saving to a file, exporting to an encoded string, converting to a JKS (Java Keystore), or even converting back to PEM.
		*==============================================================================
		* Method:            ToPFX
		* Purpose:           Converts the PEM to PKCS12 and returns the PFX object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat PFX Object, or NULL.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Converts the PEM to PKCS12 and returns the PFX object. 
		** The PFX object has method for saving to a file, exporting to an encoded string, 
		** converting to a JKS (Java Keystore), or even converting back to PEM.
		** 
		** Note: The PEM must contain at least one private key to convert to PKCS12. 
		** The typical case is that a PKCS12 contains a single private key, 
		** along with the associated certificate and the certificates in the chain of authentication.
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		loChilkatPFX AS CHILKAT_PFX_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatPFX
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatPFX = m.loChilkatObject.ToPFX()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatPFX
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loChilkatPFX = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE topfxobj		&& Introduced in version 11.0.0. Converts this PEM object, which must contain at least one private key, to PKCS12 and returns the PFX in pfxObj. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ToPfxObj
		* Purpose:           Converts this PEM object, which must contain at least 
		*                    one private key, to PKCS12 and returns the PFX in pfxObj.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPfx, a Chilkat Pfx object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0.
		**
		** Converts this PEM object, which must contain at least one private key, 
		** to PKCS12 and returns the PFX in pfxObj. Typically, a PKCS12 file 
		** includes one private key, its associated certificate, 
		** and the certificate chain.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatPfx AS CHILKAT_PFX_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterPfx AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPfx AS CHILKAT_PFX_COM_CALL
		
		STORE 0 TO m.liReturn, m.liReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPfx, m.loChilkatPfx 
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPfx = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPfx)
		      loChilkatPfx = m.loParkParameterPfx.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ToPfxObj(m.loChilkatPfx) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPfx = ;
		      m.loParkParameterPfx.SetObject(m.toChilkatPfx, m.loChilkatPfx)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPfx, m.loChilkatPfx
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  toChilkatPfx = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loParkParameterPfx = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPfx = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat PEM VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/15/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS pfx AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides the ability to manage, parse, and read PFX (PKCS12) files. To create PFX (PKCS12) files, use the certificate object's ExportToPfxFile or ExportToPfxData methods.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addcert		&& Introduced in version 9.5.0.44. Adds a certificate, its private key (if it exists), and potentially its certificate chain to the PFX. If includeChain is 1, then the certificate must have a private key.
		*m: addprivatekey		&& Introduced in version 9.5.0.44. Adds a private key and certificate chain to the PFX. The private key should be such that it is associated with the 1st certificate in the chain.
		*m: algorithmid_access		&& Access method used to retrieve the Chilkat PFX AlgorithmID property.
		*m: algorithmid_assign		&& Assign method used to hold a reference to the AlgorithmID property.
		*m: certat		&& Introduced in version 11.0.0. Returns in cert the Nth certificate in the PFX. The 1st certificate is at index 0. Returns 1 for success, 0 for failure.
		*m: certbylocalkeyid		&& Introduced in version 11.0.0.Finds and returns the certificate to cert that has a cert bag localKeyId attribute with the specified value. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat PFX DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: findcertbylocalkeyid		&& Introduced in version 9.5.0.83. Finds and returns the certificate (in the PFX) that has a cert bag "localKeyId" attribute with the specified value. The localKeyId is specifid using the encoding (such as "decimal", "base64", "hex") specified by encoding.
		*m: getcert		&& Introduced in version 9.5.0.40. Returns the Nth certificate in the PFX. (The 1st certificate is at index 0.) Returns Nothing on failure.
		*m: getlastjsondata		&& Introduced in version 11.0.0. Provides information about what happened in the last method called. Returns 1 for success, 0 for failure.
		*m: getprivatekey		&& Introduced in version 9.5.0.40. Returns the Nth private key in the PFX. (The 1st private key is at index 0.) Returns Nothing on failure.
		*m: getsafebagattr		&& Introduced in version 9.5.0.83. Can be called to get one of the following safebag attributes for the Nth private key or certificate in the PFX. forPrivateKey should be 1 for a private key, and 0 for a certificate.
		*m: importtokeychain		&& Introduced in version 10.0.0. Imports the certificates and private keys contained in the PFX to the MacOS/iOS keychain. Returns 1 for success, 0 for failure.
		*m: importtowindows		&& Introduced in version 9.5.0.83. Imports the certificates and private keys contained in the PFX to Windows certificate store(s). If exportable is 1, imported keys are marked as exportable.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat PFX LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat PFX LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat PFX LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat PFX LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastjsondata		&& Introduced in version 9.5.0.83. Provides information about what transpired in the last method called. Returns Nothing on failure
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat PFX LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat PFX LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat PFX LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadpem		&& Introduced in version 9.5.0.47. Loads a PFX from a PEM formatted string. The PEM can contain the private key, the certificate, and certificates in the chain of authentication up to the CA root.
		*m: loadpfxbd		&& Introduced in version 11.0.0. Loads a PFX from the contents of bd. Returns 1 for success, 0 for failure.
		*m: loadpfxbytes		&& Introduced in version 9.5.0.40. Loads a PFX from in-memory bytes. If the .pfx/.p12 uses different passwords for integrity and private keys, then the password argument may contain JSON to specify the passwords.
		*m: loadpfxencoded		&& Introduced in version 9.5.0.40. Loads a PFX from encoded byte data.
		*m: loadpfxfile		&& Introduced in version 9.5.0.40. Loads a PFX from a file.
		*m: numcerts_access		&& Access method used to retrieve the Chilkat PFX NumCerts property.
		*m: numcerts_assign		&& Assign method used to hold a reference to the NumCerts property.
		*m: numprivatekeys_access		&& Access method used to retrieve the Chilkat PFX NumPrivateKeys property.
		*m: numprivatekeys_assign		&& Assign method used to hold a reference to the NumPrivateKeys property.
		*m: pbes2cryptalg_access		&& Access method used to retrieve the Chilkat PFX PBES2CryptAlg property.
		*m: pbes2cryptalg_assign		&& Assign method used to hold a reference to the PBES2CryptAlg property.
		*m: pbes2hmacalg_access		&& Access method used to retrieve the Chilkat PFX PBES2HashAlg property.
		*m: pbes2hmacalg_assign		&& Assign method used to hold a reference to the PBES2HashAlg property.
		*m: privatekeyat		&& Introduced in version 11.0.0. Returns the Nth private key in privKey. (The 1st private key is at index 0.) Returns 1 for success, 0 for failure.
		*m: setsafebagattr		&& Introduced in version 9.5.0.83. Sets a safe bag attribute for the Nth private key or certificate in the PFX. Safe bag attributes can be added by calling this method once for each attribute to be added to each certificate or key.
		*m: tobd		&& Introduced in version 11.0.0. Write the PFX to bd. Returns 1 for success, 0 for failure.
		*m: tobinary		&& Introduced in version 9.5.0.44. Write the PFX to in-memory bytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: toencodedstring		&& Introduced in version 9.5.0.44. Write the PFX to an encoded string. The encoding can be any encoding such as "base64" or "hex". Returns Nothing on failure
		*m: tofile		&& Introduced in version 9.5.0.44. Write the PFX to a file. PFX and PKCS12 are essentially the same. Standard filename extensions are ".pfx" or ".p12". Returns 1 for success, 0 for failure.
		*m: tojavakeystore		&& Introduced in version 9.5.0.44. Converts the PFX (PKCS12) to a JavaKeyStore object. One JKS entry per private key found in the PKCS12 is added. The certs found within the PCKS12 are used to build the certificate chains for each private key.
		*m: tojksobj		&& Introduced in version 11.0.0. Converts this object to a Java KeyStore (JKS) object in jksObj, creating one JKS entry for each private key found in the PFX. Returns 1 for success, 0 for failure.
		*m: topem		&& Introduced in version 9.5.0.47. Write the PFX to a PEM formatted string. The resultant PEM will contain the private key, as well as the certs in the chain of authentication (or whatever certs are available in the PFX).
		*m: topemex		&& Introduced in version 9.5.0.49. Write the PFX to a PEM formatted string. If extendedAttrs is 1, then extended properties (Bag Attributes and Key Attributes) are output. If noKeys is 1, then no private keys are output.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat PFX UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: usecertvault		&& Introduced in version 9.5.0.44. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates for help in building certificate chains to a root certificate. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat PFX VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: algorithmid		&& Introduced in version 9.5.0.83. The encryption algorithm to be used when writing a PFX. After loading a PFX, this property is set to the encryption algorithm used by the loaded PFX.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcerts		&& Introduced in version 9.5.0.40. The number of certificates contained in the PFX.
		*p: numprivatekeys		&& Introduced in version 9.5.0.40. The number of private keys contained in the PFX.
		*p: pbes2cryptalg		&& Introduced in version 9.5.0.83. If the AlgorithmId property equals "pbes2", then this is the encryption algorithm to be used when writing the PFX, or used by the PFX that was loaded.
		*p: pbes2hmacalg		&& Introduced in version 9.5.0.83. If the AlgorithmId property equals "pbes2", then this is the HMAC hash algorithm to be used when writing the PFX, or used by the PFX that was loaded.
		*p: uncommonoptions		&& Introduced in version 9.5.0.83. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		algorithmid = 
		cchilkatclass = Pfx
		debuglogfilepath = 
		iinstancepatch = 40
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "pfx"
		numcerts = 0
		numprivatekeys = 0
		pbes2cryptalg = aes256-cbc
		pbes2hmacalg = hmacWithSha256
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addcert		&& Introduced in version 9.5.0.44. Adds a certificate, its private key (if it exists), and potentially its certificate chain to the PFX. If includeChain is 1, then the certificate must have a private key.
		*==============================================================================
		* Method:            AddCert
		* Purpose:           Adds a certificate, its private key (if it exists).
		*                    and potentially its certificate chain to the PFX.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tuIncludeChain, whether or not the cerficate has a private key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		** 
		** Adds a certificate, its private key (if it exists), 
		** and potentially its certificate chain to the PFX. 
		** If includeChain is 1, then the certificate must have a private key. 
		** The certificate's private key is automatically obtained (internally) 
		** via the cert's ExportPrivateKey method. If the certificate's chain of authentication 
		** is to be added, it is automatically constructed 
		** and added using whatever resources are at hand (such as certs provided 
		** via the UseCertVault method, the trusted roots from Chilkat's TrustedRoots class, etc. 
		** If a certificate chain is to be added, which is the typical case, 
		** then the chain must be completed to the root to succeed.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, tuIncludeChain AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, luReturn AS Unknown, ;
		liIncludeChain AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeChain, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeChain = .LogicalToBit(m.tuIncludeChain)
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddCert(m.loChilkatCert, m.liIncludeChain) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addprivatekey		&& Introduced in version 9.5.0.44. Adds a private key and certificate chain to the PFX. The private key should be such that it is associated with the 1st certificate in the chain.
		*==============================================================================
		* Method:            AddPrivateKey
		* Purpose:           Adds a private key and certificate chain to the PFX.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPrivateKey, a Chilkat Private Key object.
		*                    toChilkatCertChain,  a Chilkat Certificate Chain object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/11/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		** 
		** Adds a private key and certificate chain to the PFX. 
		** The private key should be such that it is associated 
		** with the 1st certificate in the chain. 
		** In other words, the 1st certificate in the chain has a public key 
		** (embedded within the X.509 structure of the cert itself) 
		** that is the counterpart to the private key.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		toChilkatCertChain AS CHILKAT_CERTCHAIN_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, liReturn AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loParkParameterCertChain AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCertChain AS CHILKAT_CERTCHAIN_COM_CALL, ;
		loException AS Exception, luReturn AS Unknown 
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey, ;
		m.loParkParameterCertChain, m.loChilkatCertChain
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loParkParameterCertChain = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCertChain)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		      loChilkatCertChain = m.loParkParameterCertChain.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddPrivateKey(m.loChilkatPrivateKey, ;
		        m.loChilkatCertChain) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		      toChilkatCertChain = ;
		      m.loParkParameterCertChain.SetObject(m.toChilkatCertChain, m.loChilkatCertChain)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey, ;
		m.loParkParameterCertChain, m.loChilkatCertChain
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  toChilkatCertChain = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterCertChain = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loChilkatCertChain = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE algorithmid_access		&& Access method used to retrieve the Chilkat PFX AlgorithmID property.
		*==============================================================================
		* Method:            AlgorithmID_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PFX AlgorithmID property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AlgorithmID
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.83
		** 
		** The encryption algorithm to be used when writing a PFX.
		** After loading a PFX, this property is set to the encryption algorithm 
		** used by the loaded PFX. (This is the algorithm used for the "shrouded key bag", 
		** which is internal to the PFX.)
		** 
		** The default value (for backward compatibility) is "pbeWithSHAAnd3_KeyTripleDES_CBC". 
		** Can be set to "pbes2", in which case the Pbes2CryptAlg and Pbes2HmacAlg properies 
		** will be set to the algorithms to be used when writing, or the algorithms used 
		** by the loaded PFX.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE algorithmid_assign		&& Assign method used to hold a reference to the AlgorithmID property.
		*==============================================================================
		* Method:            AlgorithmID_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PFX AlgorithmID property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the AlgorithmID property.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE certat		&& Introduced in version 11.0.0. Returns in cert the Nth certificate in the PFX. The 1st certificate is at index 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CertAt
		* Purpose:           Returns in cert the Nth certificate in the PFX.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		*                    tiCertificate, the certificate position in the array.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Returns in cert the Nth certificate in the PFX. The 1st certificate is at index 0.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiCertificate AS Integer, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CertAt(m.tiCertificate, m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = m.loParkParameterCert.SetObject(;
		      m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE certbylocalkeyid		&& Introduced in version 11.0.0.Finds and returns the certificate to cert that has a cert bag localKeyId attribute with the specified value. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CertByLocalKeyID
		* Purpose:           Finds and returns the certificate to cert that has a 
		*                    cert bag localKeyId attribute with the specified value.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		*                    tiCertificate, the certificate position in the array.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Finds and returns the certificate to cert that has a cert bag localKeyId 
		** attribute with the specified value. The localKeyId is specified 
		** using the encoding such as "decimal", "base64", "hex".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcLocalKeyID AS Character, ;
		tcEncoding AS Character, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CertByLocalKeyID(m.tcLocalKeyID, ;
		        m.tcEncoding, m.loChilkatCert) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = m.loParkParameterCert.SetObject(;
		      m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		  Many classes have a GetLastJsonData method. This method was fixed 
		  to avoid clearing the contents of the LastErrorText.
		
		** Version 11.0.0
		
		  Added the CertAt, CertByLocalKeyId, GetLastJsonData, LoadPfxBd,
		  PrivateKeyAt, ToBd and ToJksObj methods.
		
		  Decremented the FindCertByLocalKeyId, GetCert, GetPrivateKey, 
		  LastJsonData and ToJavaKeyStore methods.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 94
		
		  Fixed a rare problem such that loading certain .pfx/.p12 files would take an extremely long time.
		
		** Version 87
		
		  When using passwords longer than 32 chars, PFX’s created by Microsoft and others would truncate passwords 
		  to a max length, whereas PFX’s created by Apple and others would not.
		  Therefore, opening such a PFX requires the correct behavior (truncate or no-truncate).
		  Chilkat will now automatically determine the correct behavior and open appropriately.
		
		** Version 83
		
		  Added the following properties and method: AlgorithmId,
		  Pbes2CryptAlg, Pbes2HmacAlg, LastJsonData, UncommonOptions.
		
		** Version 82
		
		  Added the ability to decode PFX files that are AES256-SHA256 Encrypted.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 75
		
		  Added the ability to open .pfx/.p12 files where two different passwords are required:
		  one for integrity and the other for the private keys.
		  See the example at https://www.example-code.com/csharp/pfx_multiple_passwords.asp
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 72
		
		  Encrypting 0 bytes for block cipher algorithms with padding
		  now results in one block of output, rather than 0 bytes.
		  (Decrypting the 16-byte block will return the original 0 bytes.)
		  This only applies to block ciphers operating in modes such as ECB, CBC, etc.
		  This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		
		** Version 69
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		  Fixed an issue with automatically locating pre-installed Windows certificates
		  (for encryption) when the email address stored within the certificate used uppercase letters.
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 66
		
		  Fixed exporting ECC private keys from PFX to other formats.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 56
		
		   Added the “base64url” encoding to the list of supported encodings.
		   See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 55
		
		  A new Chilkat encoding named “fingerprint” was added. The “fingerprint” encoding
		  is lowercase hex with each byte separated by a colon character.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 49
		
		  Added Base58 encoding as an additional choice for all places
		  where an encoding (such as “base64”, “hex”, etc.) can be selected.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		** Version 44
		
		  Added PFX methods: AddPrivateKey, ToFile, ToBinary, ToEncoded.
		
		** Version 40
		
		  Added new Chilkat object/classes: CertChain, XmlCertVault, and Pfx.
		  See the online reference documentation. Various methods were added to various Chilkat classes
		  to make it easy to obtain the full certificate chain, such as for an SSL server’s cert chain,
		  or a PKCS7 signer’s certificate chain.
		  The XmlCertVault object provides a means for persisting a collection of certificates
		  and private keys to an XML file as a repository for an application to use.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat PFX DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PEM DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PFX DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 40
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE findcertbylocalkeyid		&& Introduced in version 9.5.0.83. Finds and returns the certificate (in the PFX) that has a cert bag "localKeyId" attribute with the specified value. The localKeyId is specifid using the encoding (such as "decimal", "base64", "hex") specified by encoding.
		*==============================================================================
		* Method:            FindCertByLocalKeyID
		* Purpose:           Finds and returns the certificate that has a cert bag 
		*                    "localKeyId" attribute with the specified value
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalKeyID -- The local key ID value to find.
		*                    tcEncoding -- The local key ID encoding.
		* Returns:           toChilkatCert, a Chilkat Certificate object.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Finds and returns the certificate (in the PFX) that has a cert bag "localKeyId" 
		** attribute with the specified value. The localKeyId is specified using the encoding 
		** (such as "decimal", "base64", "hex") specified by encoding.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLocalKeyID AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatCert = ;
		        m.loChilkatObject.FindCertByLocalKeyID(m.tcLocalKeyID, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getcert		&& Introduced in version 9.5.0.40. Returns the Nth certificate in the PFX. (The 1st certificate is at index 0.) Returns Nothing on failure.
		*==============================================================================
		* Method:            GetCert
		* Purpose:           Returns the Nth certificate in the PFX.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the certificate index value.
		* Returns:           toChilkatCert, a Chilkat Certificate object.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Returns the Nth certificate in the PFX. (The 1st certificate is at index 0.)
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatCert = m.loChilkatObject.GetCert(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getlastjsondata		&& Introduced in version 11.0.0. Provides information about what happened in the last method called. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetLastJsonData
		* Purpose:           Provides information about what transpired in the last method called.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Provides information about what happened in the last method called.
		**
		** Fixed in Version 11.2.0: Many classes have a GetLastJsonData method. 
		** This method was fixed to avoid clearing the contents of the LastErrorText.
		**
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatJSONObject
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		    loChilkatJSONObject = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      m.loChilkatObject.GetLastJsonData(m.loChilkatJSONObject)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatJSONObject = ;
		    m.loParkParameterCert.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatJSONObject
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getprivatekey		&& Introduced in version 9.5.0.40. Returns the Nth private key in the PFX. (The 1st private key is at index 0.) Returns Nothing on failure.
		*==============================================================================
		* Method:            GetPrivateKey
		* Purpose:           Returns the Nth certificate in the PFX.
