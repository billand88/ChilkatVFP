	PROCEDURE getremotefiletextdata		&& Downloads the content of a remote text file directly into an in-memory string.
		*==============================================================================
		* Method:            GetRemoteFileTextData
		* Purpose:           Downloads the content of a remote text file 
		*                    directly into an in-memory string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteFileName -- contains the path to the remote file.
		* Returns:           Returns text data.
		* Date Added:        03/03/2022
		*==============================================================================
		
		**
		** Downloads the content of a remote text file directly into an in-memory string.
		**
		** Note: If the remote text file does not use the ANSI character encoding, 
		** call GetRemoteFileTextC instead, which allows for the character encoding 
		** to be specified so that characters are properly interpreted.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemoteFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, lcTextString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcTextString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcTextString = m.loChilkatObject.GetRemoteFileTextDataData(m.tcRemoteFileName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcTextString 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

