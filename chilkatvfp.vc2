	PROCEDURE fileunzipped		&& This event fires during method calls that unzip a zip archive. It is called just after each file is unzipped. The abort output-only argument may be set to 1 to abort the method call.
		*==============================================================================
		* Method:            FileUnzipped
		* Purpose:           This event fires during method calls that unzip a zip archive.
		*                    It is called just after each file is unzipped.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file to be unzipped.
		*                    tiCompressedFileSize, the size of the compressed file to be unzipped. 
		*                    tiFileSize, the size of the file to be unzipped.
		*                    tiAbort, the abort setting.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** This event fires during method calls that unzip a zip archive. 
		** It is called just after each file is unzipped. 
		** The abort output-only argument may be set to 1 to abort the method call.
		**
		
		LPARAMETERS tcPath AS Character, tiCompressedFileSize AS Integer, ;
		tiFileSize AS Integer, tiAbort AS Integer
		
		LOCAL lcPath AS Character, liCompressedFileSize AS Integer, ;
		liFileSize AS Integer, liAbort AS Integer
		
		lcPath = m.tcPath
		liCompressedFileSize = m.tiCompressedFileSize 
		liFileSize = m.tiFileSize
		liAbort = m.tiAbort
		
		*!*  
		*!*  ? [FileUnzipped Event!] 
		*!*  ? [FileUnzipped: File Path = ] + lcPath
		*!*  ? [File Compressed Size = ] + STR(liCompressedFileSize)
		*!*  ? [File Size = ] + STR(liFileSize)
		*!*  ? [Abort = ] + STR(liAbort)
		*!*  
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liAbort = 0
		
		    .FileUnzipped_Pre(m.lcPath, m.liCompressedFileSize, m.liFileSize, m.liAbort)
		
		    ** OK to continue test
		    IF m.liAbort = 0
		
		      .FileUnzipped_Process(m.lcPath, m.liCompressedFileSize, m.liFileSize, m.liAbort)
		
		      ** OK to continue test
		      IF m.liAbort = 0
		
		        .FileUnzipped_Post(m.lcPath, m.liCompressedFileSize, m.liFileSize, m.liAbort)
		
		      ENDIF m.liAbort = 0
		      ** End OK to continue test
		
		    ENDIF m.liAbort = 0
		    ** End OK to continue test
		
		  ENDIF m.liAbort = 0
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiCompressedFileSize = m.liCompressedFileSize
		tiFileSize = m.liFileSize
		tiAbort = m.liAbort
		
		RETURN
	ENDPROC

