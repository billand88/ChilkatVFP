		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Returns an embedded "message/rfc822" subpart as an email object. 
		** (Emails are embedded as "message/rfc822" subparts by some mail clients when forwarding an email.) 
		** This method allows the original email to be accessed.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, loChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatEmail = m.loChilkatObject.GetAttachedMessage(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmail
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getattachedmessageattr		&& Returns a header field attribute value for the Nth attached (embedded) email. For example, to get the value of the "name" attribute in the Content-Type header for the 1st attached message:
		*==============================================================================
		* Method:            GetAttachedMessageAttr
		* Purpose:           Returns a header field attribute value for the Nth attached (embedded) email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the index for the attached email array.
		*                    tcFieldName -- the field name to search for
		*                    tcAttributeName -- the attribute name to search for
		* Returns:           lcValue, the field attribute value.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.41
		**
		** Returns a header field attribute value for the Nth attached (embedded) email. 
		** For example, to get the value of the "name" attribute in the Content-Type header 
		** for the 1st attached message:
		**
		** Content-Type: message/rfc822; name="md75000024149.eml"
		** then the method arguments should contain the values 0, "Content-Type", "name".
		**
		** Fixed for Version 48: This method always returned info for index 0,
		** regardless of the index passed in by the app.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer, tcFieldName AS Character, tcAttributeName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		lcValue AS Character, llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcValue = []
		llImplemented = .F.
		liIntroducedInBuild = 41
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcValue = m.loChilkatObject.GetAttachedMessageAttr(m.tiIndex, m.tcFieldName, m.tcAttributeName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcValue 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getattachedmessagefilename		&& Returns the filename of the Nth attached (embedded) email. The filename is the "filename" attribute of the content-disposition header field found within the Nth message/rfc822 sub-part of the calling email object.
		*==============================================================================
		* Method:            GetAttachedMessageFileName
		* Purpose:           Returns the filename of the Nth attached (embedded) email. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the attached email array. 
		* Returns:           lcFileName, the attached email file name
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Returns the filename of the Nth attached (embedded) email. 
		** The filename is the "filename" attribute of the content-disposition header field 
		** found within the Nth message/rfc822 sub-part of the calling email object.
		**
		** Important: The attached message filename is only present if the Content-Disposition 
		** header exists AND contains a "filename" attribute. 
		** If questions arise, one could open the email in a text editor 
		** to examine the MIME sub-header for the attached message 
		** (where the Content-Type = "message/rfc822"). 
		** For example, here is a sub-header that has a filename:
		**
		** Content-Type: message/rfc822; name="GetAttachedMessageAttr.eml"
		** Content-Transfer-Encoding: 7bit
		** Content-Disposition: attachment; filename="GetAttachedMessageAttr.eml"
		**
		** Here is an attached message sub-header that does NOT have a filename:
		**
		** Content-Type: message/rfc822
		** Content-Transfer-Encoding: 7bit
		** Content-Disposition: attachment
		** 
		** Returns Nothing on failure
		**
		** Fixed for Version 48: This method always returned info for index 0,
		** regardless of the index passed in by the app.
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcFileName AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcFileName = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcFileName = m.loChilkatObject.GetAttachedMessageFileName(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFileName
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

