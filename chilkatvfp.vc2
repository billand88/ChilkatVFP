		*                    used to hold a reference to the SendEncrypted property.
		* Returns:           
		* Date Added:        01/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sender_access		&& Access method used to retrieve the Chilkat Email Sender property.
		*==============================================================================
		* Method:            Sender_Access
		* Purpose:           Access method used to retrieve the Chilkat Email Sender property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Sender
		* Date Added:        01/23/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.41
		**
		** The sender's address for this email message.
		**
		** This is the address of the actual sender acting 
		** on behalf of the author listed in the From: field.
		**
		** Note: The Sender and BounceAddress properties are identical and perform the same function. 
		** Setting the Sender property also sets the BounceAddress property, and vice-versa. 
		** The reason for the duplication is that BounceAddress existed first, 
		** and developers typically searched for a "Sender" property 
		** without realizing that the BounceAddress property served this function.
		** 
		** Important Note: This property does not contain the value of the "Sender" header field, 
		** if one exists, for a received email. It is a property that is used when sending email. 
		** To get the value of the "Sender" header field (which may not always exist), 
		** call the GetHeaderField method instead.
		**
		** Version 11.0.0: Property removed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [String]
		
		  la_IntroducedInBuild[1] = 9
		  la_IntroducedInBuild[2] = 5
		  la_IntroducedInBuild[3] = 41
		
		  THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN []
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		  
	ENDPROC

	HIDDEN PROCEDURE sender_assign		&& Assign method used to hold a reference to the Sender property.
		*==============================================================================
		* Method:            Sender_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Email Sender property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Sender property.
		* Returns:           
		* Date Added:        01/23/2022
		*==============================================================================
		
		**
		** Version 11.0.0: Property removed.
		**
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character, ;
		llImplemented AS Logical
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 41
		
		llImplemented = .F.
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    .CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		    llImplemented = ;
		    .IsPEMImplemented(la_IntroducedInBuild[1], la_IntroducedInBuild[2], la_IntroducedInBuild[3])
		
		    ** Property implemented test
		    IF m.llImplemented
		
		      .BounceAddress = .Sender
		
		    ENDIF m.llImplemented
		    ** Property implemented test
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sendsigned_access		&& Access method used to retrieve the Chilkat Email SendSigned property.
		*==============================================================================
		* Method:            SendSigned_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Email SendSigned property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SendSigned
		* Date Added:        01/23/2022
		*==============================================================================
		
		**
		** Set to 1 if this email should be sent with a digital signature.
		** 
		** Note: Please be aware of the Apple Mail bug explained in the web page at the link below.
		** https://www.example-code.com/foxpro/smtp_send_signed_rsassa_pss_email.asp
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sendsigned_assign		&& Assign method used to hold a reference to the SendSigned property.
		*==============================================================================
		* Method:            SendSigned_Assign
		* Purpose:           Assign method used to hold a reference to the SendSigned property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the SendSigned property.
		* Returns:           
		* Date Added:        01/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE setattachmentcharset		&& Sets the charset attribute of the content-type header field for a specified attachment. This can be used if the attachment is a text file that contains text in a non us-ascii charset such as Shift_JIS, iso-8859-2, big5, iso-8859-5, etc.
		*==============================================================================
		* Method:            SetAttachmentCharset
		* Purpose:           Sets the charset attribute of the content-type 
		*                    header field for a specified attachment.  
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the attachment array. 
		*                    tcCharset, the Charset attribute to set.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Sets the charset attribute of the content-type header field for a specified attachment. 
		** This can be used if the attachment is a text file 
		** that contains text in a non us-ascii charset such as Shift_JIS, iso-8859-2, big5, iso-8859-5, etc.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetAttachmentCharset(m.tiIndex, m.tcCharset) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setattachmentdisposition		&& Set's an attachment's disposition. The default disposition of an attachment is "attachment". This method is typically called to change the disposition to "inline". The 1st attachment is at index 0.
		*==============================================================================
