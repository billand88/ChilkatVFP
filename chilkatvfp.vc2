	PROCEDURE shorten		&& Chops N bytes from the end of a byte array. Accepts a Variant, which could be anything (internally) but always returns a Variant containing a byte array. Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            Shorten
		* Purpose:           Chops N bytes from the end of a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqDataBytes -- the bytes to shorten. 
		*                    tiNumBytes -- the number of bytes to shorten.
		* Returns:           A shorter amount of data bytes.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Chops N bytes from the end of a byte array. Accepts a Variant, 
		** which could be anything (internally) 
		** but always returns a Variant containing a byte array.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqDataBytes AS VarBinary, tiNumBytes AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqShortenedDataBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqShortenedDataBytes
		
		WITH THIS
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lqShortenedDataBytes = m.loChilkatObject.Shorten(m.tqDataBytes, m.tiNumBytes)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqShortenedDataBytes 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signbdenc		&& Introduced in version 9.5.0.67. Digitally signs the contents of dataToSign and returns the detached digital signature in an encoded string (according to the EncodingMode property setting). Returns Nothing on failure
		*=============== ===============================================================
		* Method:            SignBdENC
		* Purpose:           Digitally signs the contents of dataToSign 
		*                    and returns the detached digital signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           The hash as an encoded string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** Digitally signs the contents of dataToSign and returns 
		** the detached digital signature in an encoded string 
		** (according to the EncodingMode property setting).
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, lcEncodedSignature AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		lcEncodedSignature = []
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        lcEncodedSignature = m.loChilkatObject.SignBdENC(m.loChilkatBinData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.lcEncodedSignature
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signbdencasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the SignBdENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            SignBdENCAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    SignBdENC method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the SignBdENC method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
