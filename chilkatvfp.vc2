	HIDDEN PROCEDURE pkcs8encryptalg_access		&& Access method used to retrieve the Chilkat PrivateKey PKCS8EncryptAlg property
		*==============================================================================
		* Method:            PKCS8EncryptAlg_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PrivateKey PKCS8EncryptAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PKCS8EncryptAlg
		* Date Added:        06/21/2022
		*==============================================================================
		
		** 
		** The encryption algorithm to be used when exporting the key to encrypted PKCS8. 
		** The default value is "3des". Possible choices also include "aes128", "aes192", 
		** and "aes256". All of the encryption algorithm choices use CBC mode.
		**
		** Fixed for version 11.6.0: Names normalized consistently; 
		** unsupported/empty resets to the default 3des.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE pkcs8encryptalg_assign		&& Assign method used to hold a reference to the PKCS8EncryptAlg property.
		*==============================================================================
		* Method:            PKCS8EncryptAlg_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PrivateKey PKCS8EncryptAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the PKCS8EncryptAlg property.
		* Returns:           
		* Date Added:        06/21/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = [PKCS8EncryptAlg]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE savepemfile		&& Introduced in version 9.5.0.58. Saves the private key to an unencrypted PKCS1 PEM format file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SavePEMFile
		* Purpose:           Saves the private key to an unencrypted PKCS1 PEM format file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMFilePath, the path to the PEM file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Saves the private key to an unencrypted PKCS1 PEM format file.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		** Fixed for version 11.6.0: SavePemFile now writes the traditional representation.
		**
		
		LPARAMETERS tcPEMFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SavePEMFile(m.tcPEMFilePath) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.luReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

