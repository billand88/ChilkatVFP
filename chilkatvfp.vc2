	PROCEDURE compressfiletomem		&& Gzip compresses a file to an in-memory image of a .gz file. Note: There is a 4GB size limitation. The compressed size of the file cannot be more than 4GB. Chilkat will be working to alleviate this limitation in the future.
		*==============================================================================
		* Method:            CompressFileToMem
		* Purpose:           Gzip compresses a file to an in-memory image of a .gz file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to compress
		* Returns:           In-memory image of a .gz file.
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Gzip compresses a file to an in-memory image of a .gz file.
		**
		** Note: There is a 4GB size limitation. 
		** The compressed size of the file cannot be more than 4GB. 
		** Chilkat will be working to alleviate this limitation in the future.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, lqInMemoryBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqInMemoryBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqInMemoryBytes = m.loChilkatObject.CompressFileToMem(m.tcFileName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqInMemoryBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

