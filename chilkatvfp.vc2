	PROCEDURE genkeyfromparamsderbd		&& Introduced in version 11.0.0. Generates a new DSA key using the binary OpenSSL formatted DER parameters in bd. The key can be exported using any of the To* methods. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GenKeyFromParamsDERBd
		* Purpose:           Generates a new DSA key using the binary OpenSSL 
		*                    formatted DER parameters in bd. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Generates a new DSA key using the binary OpenSSL formatted DER parameters in bd. 
		** The key can be exported using any of the To* methods.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, loException AS Exception, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], llImplemented AS Logical, ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		    ** Method implemented test
		    IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenKeyFromParamsDERBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = m.loParkParameterBinData.SetObject(;
		      m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

