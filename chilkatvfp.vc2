		** Returns the boolean at the specified jsonPath.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcJSONPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.BoolOf(m.tcJSONPath) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE bytesof		&& Introduced in version 9.5.0.68. Appends the binary bytes at the specified jsonPath to bd. The encoding indicates the encoding of the bytes, such as "base64", "hex", etc. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            BytesOf
		* Purpose:           Appends the binary bytes at the specified jsonPath to bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSONPath, the JSON path to the boolean.
		*                    tcEncoding, the byte encoding.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.68
		** 
		** Appends the binary bytes at the specified jsonPath to bd. 
		** The encoding indicates the encoding of the bytes, such as "base64", "hex", etc.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcJSONPath AS Character, tcEncoding AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 68
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.BytesOf(m.tcJSONPath, ;
		        m.tcEncoding, m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.1
		
		  The Strict property was left out of the Chilkat ActiveX component. This version fixes the issue.
		
		** Version 11.6.0
		
		  Chilkat’s XML and JSON parsers are deliberately tolerant: given input that is not well-formed 
		  they parse what they can, report success, and leave a partially populated document. 
		  That is the wrong behavior when a silently dropped element or member changes what the application does. 
		  Both classes now have a Strict property that closes this off.
		
		  Property  Behavior when true
		
		  Xml.Strict
		  (default false) Checks the input is well-formed XML before parsing; 
		  on failure the load fails and the object is left unchanged. 
		  Applies to LoadXml, LoadXml2, LoadSb, LoadBd, LoadXmlFile, LoadXmlFile2. 
		  (Well-formedness only, not validating.)
		
		  JsonObject.Strict
		  (default false) Validates the text against the full JSON grammar first; 
		  on failure leaves existing contents unchanged. 
		  Applies to Load, LoadSb, LoadBd, LoadFile, LoadPredefined.
		
		  Both default to false, so existing applications are unaffected. 
		  Turn Strict on for input carrying configuration, credentials, signed content, or security parameters.
		
		  StringOfEquals - Case-sensitivity was reversed (behavior change). 
		  Previously caseSensitive = true compared case-insensitively and vice-versa. 
		  Now corrected: true = case-sensitive, false = case-insensitive. 
		  If you had compensated for the old behavior, review those calls.
		
		  The Load method is now Secrets aware. It can accept a secret specification string 
		  (beginning with !!) in place of a literal value, and Chilkat resolves it 
		  from the Windows Credential Manager (Windows) or Apple Keychain (macOS). 
		  Secrets are identified by the structured format !![appName|]service[|domain]|username, 
		  letting applications resolve credentials at runtime instead of embedding them in code.
		
		** Version 11.5.0
		
		  Added the boolean EnableSecrets property to several Chilkat classes. When set to true, 
		  it provides the ability to pass a secret name rather than the actual value of a sensitive item. 
		  For example, a password for Ftp2, or a client_secret for OAuth2 client credentials. 
		  The value (such as client_secret) would’ve been previously stored via the Chilkat.Secrets API 
		  to the local manager, which on Windows is the Window Credentials Manager, 
		  and on Apple is the Apple Keychain.
		
		  Secrets Conceptual Overview — See Chilkat Secrets API for a refresher on the Secrets API.
		
		  When EnableSecrets is true, certain Chilkat methods and properties are secrets-aware. 
		  A passed-in value having the format “!!part1|part2|part3|part4” where a secret name 
		  is specified by providing 2 to 4 parts will get auto-resolved by looking up the secret 
		  in the local manager and found value will be used instead. 
		  This makes it easier for applications to avoid embedding sensitive information in source code.
		  For more information, see Chilkat EnableSecrets
		
		** Version 11.4.0
		
		  Added the NewArrayOf and NewObjectOf methods.
		
		  The PathPrefix property was not working correctly for the StringOf and StringOfSb methods.
		
		** Version 11.1.0
		
		  Added the ArrayOf2 method.
		
		** Version 11.0.0
		
		  Added the AppendArray2, AppendObject2, ArrayAt2, CopyRef, 
		  FindObjectWithMember2, FindRecord2, GetDocRoot2, MakeCopy, 
		  ObjectAt2 and ObjectOf2 methods.
		
		  Decremented the Clone method.
		
		** Version 10.0.0
		
		  Fixed a problem having to do with emoji chars JSON encoded with high + low surrogate pairs in hex.  
		  When returning utf-8, we fixed so the single utf-8 char is returned 
		  rather than 2 utf-8 surrogate pair “chars”.
		
		  Added the Sort method.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 96
		
		  Added methods for unsigned integers: UpdateUInt and UIntOf.
		
		  Added the StringOfEquals method, to make it more convenient to check of a JSON value equals a particular value.
		
		** Version 82
		
		  Type JsonTypeOf method returned -1 for inner nodes rather than the correct value of 3.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 77
		
		  Added new methods: LoadBd, EmitBd.
		
		** Version 76
		
		  The DtAt, DateAt, DtOf, and DateOf methods will now parse date/time strings
		  having the Microsoft JSON Date (AJAX Date), such as “/Date(12348721342)/”
		  or “/Date(1224043200000-0600)/” where ‘1224043200000’
		  are the number of milliseconds since January 1, 1970 in Universal Coordinated Time (UTC).
		
		  Added the Swap method.
		
		  Added the Clear method to make it obvious how to clear the contents.
		  (Calling Load(“”) also clears the contents.)
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 73
		
		  Added the methods DtOf and DateOf to both JsonObject and JsonArray.
		
		  Fixed the “Unable to lock my JSON object.” error that would be returned
		  if SetStringOf was called on an empty JsonObject.
		
		** Version 68
		
		  The passed-in string was not being JSON escaped like it was for JsonObject.AppendString.
		  This would cause problems for non-usascii chars, or certain special chars
		  that need to be escaped, such as double-quotes, LF’s, CR’s, etc.
		
		  Added the following methods: StringOfSb, BytesOf, UpdateSb, and UpdateBd.
		  The need for these methods became apparent when writing examples for Microsoft Graph / Outlook.
		  The purpose of the methods is to access a potentially large amount of data
		  within JSON without needing to pass the data back/forth in arguments or return values.
		  Passing StringBuilder or BinData object references is far more efficient than passing the actual data.
		
		** Version 67
		
		  Added new methods: EmitWithSubs, Predefine, LoadPredefined.
		
		  Added the AppendStringArray property.
		
		  Added the FindObjectWithMember method.
		
		** Version 65
		
		  Added new methods: UpdateNumber, UpdateNull
		
		  Added new methods: UpdateNull and UpdateNumber.
		
		  Fixed auto-create issue in JsonObject.UpdateString, UpdateInt, etc. for array paths that end in a primitive.
		  For example the following C++ code
		
		  CkJsonObject json;
		  json.put_EmitCompact(false);
		  json.UpdateString("cc_emails[0]","cc-email@paypal.com") ;
		  json.UpdateString("cc_emails[1]","cc-email2@paypal.com") ;
		  json.UpdateString("cc_emails[2]","cc-email3@paypal.com") ;
		  json.UpdateString("cc_emails[3]","cc-email4@paypal.com") ;
		  std::cout << json.emit() << "\r\n" ;
		
		  Now correctly produces:
		
		  {
		    "cc_emails": [
		      "cc-email@paypal.com",
		      "cc-email2@paypal.com",
		      "cc-email3@paypal.com",
		      "cc-email4@paypal.com"
		    ]
		  }
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 62
		
		  Note: One use of BinData and StringBuilder is in use of new methods ending in “Sb” and “Bd”.
		  These methods are for returning or passing text or binary data, especially large amounts of text or data.
		  For example, imagine one Chilkat method is used to retrieve a large amount of data,
		  and then that data is passed to another Chilkat method. A large waste of time and memory is consumed
		  in returning the string (or binary bytes) to the programming language,
		  and then immediately passing it back to Chilkat.
		  If it is .NET, then the data must be marshaled from unmanaged to managed, and then,
		  to pass back to Chilkat it is marshaled from managed to unmanaged.
		  The same applies when using the ActiveX (with BSTR’s and Variants).
		  By retrieving results directly into a BinData or StringBuilder,
		  and then passing the data by passing the object, the data stays on the native side.
		  For example, the new Rest.ReadRespSb method reads the REST response directly in to a StringBuilder.
		  If it is JSON, this can be loaded directly into a JsonObject via the JsonObject.LoadSb.
		  In the future, new “Sb” and “Bd” methods will be added in places
		  where large amounts of data are likely to be encountered.
		  This will create pathways allowing data to stay native as much as possible.
		  Version 9.5.0.62 adds the following initial set of Sb/Bd methods:
		
		    JsonObject.LoadSb
		    JsonObject.EmitSb
		    Xml.LoadSb
		    Xml.GetXmlSb
		
		    Email.GetMimeBd
		    Email.GetMimeSb
		    Email.SetFromMimeSb
		    Email.SetFromMimeBd
		
		    Mime.LoadMimeSb
		    Mime.LoadMimeBd
		    Mime.GetMimeSb
		    Mime.GetMimeBd
		    MailMan.RenderToMimeBd
		    MailMan.RenderToMimeSb
		    Rest.FullRequestSb
		    Rest.ReadRespSb
		    Rest.SendReqSb
		    Rest.SetMultipartBodySb
		    Rest.AddQueryParam
		    Rest.ReadRespBd
		    Rest.SendReqBd
		    Rest.SetMultipartBodyBd
		    Imap.FetchAttachmentSb
		    Imap.FetchAttachmentBd
		    Imap.AppendMimeWithFlagsSb
		    SFtp.UploadSb
		    SFtp.DownloadSb
		    SFtp.UploadBd
		    SFtp.DownloadBd
		    Ftp2.GetFileSb
		    Ftp2.GetFileBd
		
		    Ftp2.PutFileSb
		    Ftp2.PutFileBd
		
		** Version 59
		
		  Fixed a parse problem that occurred when a Unicode char was the very last char in a JSON value string.
		  For example if the value string ended with “\\u6e2c”,
		  then this final char was dropped in the string returned by various methods.
		
		  Fixed a JSON parsing problem having to do with escaped chars.
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Crash bug fixed in the StringOf method.
		
		  (FIXED) Calling json.AddObjectAt on an empty JSON document failed.
		
		** Version 56
		
		  Added the JsonObject and JsonArray classes.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE clear		&& Introduced in version 9.5.0.76. Clears the contents of the JSON object. This is the equivalent of calling jsonObject.Load("{}")
		*==============================================================================
		* Method:            Clear
		* Purpose:           Clears the contents of the JSON object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		** 
		** Clears the contents of the JSON object. 
		** This is the equivalent of calling jsonObject.Load("{}")
		**
		
		LPARAMETERS tcJSONPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.Clear()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE clone		&& Introduced in version 9.5.0.66. Returns a copy of this JSON object. Returns Nothing on failure.
		*==============================================================================
		* Method:            Clone
		* Purpose:           Returns a copy of this JSON object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat JSON object, or NULL.
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Returns a copy of this JSON object.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcJSONPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatJSONObject
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatJSONObject = m.loChilkatObject.Clone()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatJSONObject
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE copyref		&& Introduced in version 11.0.0. Updates jsonObj to reference this JSON object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CopyRef
		* Purpose:           Updates jsonObj to reference this JSON object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Updates jsonObj to reference this JSON object.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJSONObject
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CopyRef(m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJSONObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE dateof		&& Introduced in version 9.5.0.73. Fills the dateTime with the date/time string located at jsonPath.
		*==============================================================================
		* Method:            DateOf
		* Purpose:           Fills the dateTime with the date/time string located at jsonPath.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSONPath, the JSON path to the boolean.
		*                    toChilkatCkDateTime, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.73
		** 
		** Fills the dateTime with the date/time string located at jsonPath. 
		** Auto-recognizes the following date/time string formats: ISO-8061 Timestamp 
		** (such as "2009-11-04T19:55:41Z"), RFC822 date/time format 
		** (such as "Wed, 18 Apr 2018 15:51:55 -0400"), or Unix timestamp integers.
		**
		** Fix for version 76: This method will now parse date/time strings 
		** having the Microsoft JSON Date (AJAX Date), such as “/Date(12348721342)/” 
		** or “/Date(1224043200000-0600)/” where ‘1224043200000’ are the number
		** of milliseconds since January 1, 1970 in Universal Coordinated Time (UTC).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcJSONPath AS Character, toChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterCkDateTime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		llImplemented = .F.
		liIntroducedInBuild = 73
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCkDateTime = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTime)
		
		      loChilkatCkDateTime = m.loParkParameterCkDateTime.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.DateOf(m.tcJSONPath, m.loChilkatCkDateTime) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCkDateTime = ;
		      m.loParkParameterCkDateTime.SetObject(m.toChilkatCkDateTime, m.loChilkatCkDateTime)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loParkParameterCkDateTime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat JSONObject DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat JSONObject DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/03/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat JSONObject DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        06/03/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

