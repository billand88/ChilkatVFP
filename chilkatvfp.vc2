	PROCEDURE loadpkcs8		&& Loads a private key from in-memory PKCS8 byte data.
		*==============================================================================
		* Method:            LoadPKCS8
		* Purpose:           Loads a private key from in-memory PKCS8 byte data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPKCS8Data, the binary DER data.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Loads a private key from in-memory PKCS8 byte data.
		** 
		** For those requiring a deeper understanding, the PKCS8 contains 
		** ASN.1 in DER encoding with the following structure:
		** 
		**   PrivateKeyInfo ::= SEQUENCE {
		**     version         Version,
		**     algorithm       AlgorithmIdentifier,
		**     PrivateKey      BIT STRING
		**   }
		** 
		**   AlgorithmIdentifier ::= SEQUENCE {
		**     algorithm       OBJECT IDENTIFIER,
		**     parameters      ANY DEFINED BY algorithm OPTIONAL
		**   }
		** 
		** Note: Each of the private key Load* methods willl auto-recognize the content 
		** and will parse appropriately. The private key should be successfully loaded 
		** even when the wrong format data is passed to the wrong method.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqPKCS8Data AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadPKCS8(m.tqPKCS8Data) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpkcs8encrypted		&& Loads a private key from in-memory password-protected PKCS8 byte data.
		*==============================================================================
		* Method:            LoadPKCS8Encrypted
		* Purpose:           Loads a private key from in-memory password-protected PKCS8 byte data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPKCS8Data, the binary PKCS8 data.
		*                    tcPassword, the password to unencrypt.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Loads a private key from in-memory password-protected PKCS8 byte data.
		** 
		** For those requiring a deeper understanding, the encrypted PKCS8 contains 
		** ASN.1 in DER encoding with the following structure:
		** 
		**   EncryptedPrivateKeyInfo ::= SEQUENCE {
		**     encryptionAlgorithm  EncryptionAlgorithmIdentifier,
		**     encryptedData        EncryptedData
		**   }
		** 
		**   EncryptionAlgorithmIdentifier ::= AlgorithmIdentifier
		** 
		**   EncryptedData ::= OCTET STRING
		** 
		** Note: Each of the private key Load* methods willl auto-recognize the content 
		** and will parse appropriately. The private key should be successfully loaded 
		** even when the wrong format data is passed to the wrong method.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqPKCS8Data AS VarBinary, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadPKCS8Encrypted(m.tqPKCS8Data, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

