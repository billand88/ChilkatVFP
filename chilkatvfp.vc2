	PROCEDURE launchbrowser		&& Introduced in version 10.1.2. Launches the default browser and navigated to url. If a browser window is already open, the page will be displayed in a new tab. This works on Windows, MacOS, and Linux. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LaunchBrowser
		* Purpose:           Launches the default browser and navigates to url.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL, the URL to navigate.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/09/2025
		*==============================================================================
		
		**
		** Introduced in version 10.1.2
		**
		** Launches the default browser and navigates to url. If a browser window is already open, 
		** the page will be displayed in a new tab. This works on Windows, MacOS, and Linux.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURL AS Character
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, lcURL AS Character, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 0, 2)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    lcURL = m.tcURL
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LaunchBrowser(m.lcURL) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE listenportrangeend_access		&& Access method used to retrieve the Chilkat oAuth2 ListenPortRangeEnd property.
		*==============================================================================
		* Method:            ListenPortRangeEnd_Access
		* Purpose:           Access method used to retrieve 
		*                    the ListenPortRangeEnd property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ListenPortRangeEnd
		* Date Added:        06/08/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.69
		**
		** If set, then an unused port will be chosen in the range 
		** from the ListenPort property to this property. Some OAuth2 services, such as Google, 
		** require that callback URL's, including port numbers, be selected in advance. 
		** This feature allows for a range of callback URL's to be specified 
		** to cope with the possibility that another application on the same computer 
		** might be using a particular port.
		**
		** For example, a Google ClientID might be configured 
		** with a set of authorized callback URI's such as:
		** 
		** http://localhost:55110/
		** http://localhost:55112/
		** http://localhost:55113/
		** http://localhost:55114/
		** http://localhost:55115/
		** http://localhost:55116/
		** http://localhost:55117/
		** 
		** In which case the ListenPort property would be set to 55110, 
		** and this property would be set to 55117.
		** 
		** Enhancement for Version 10: Internally, when binding a socket for listening 
		** (such as listening for the OAuth2 callback), 
		** Chilkat now binds to 127.0.0.1 instead of 0.0.0.0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 69
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

