	HIDDEN PROCEDURE greeting_access		&& Access method used to retrieve the Chilkat Greeting property.
		*==============================================================================
		* Method:            Greeting_Access
		* Purpose:           Access method used to retrieve 
		*                    the Greeting property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Greeting
		* Date Added:        02/24/2022
		*==============================================================================
		
		** 
		** The initial greeting received from the FTP server after connecting.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE greeting_assign		&& Assign method used to hold a reference to the Greeting property.
		*==============================================================================
		* Method:            Greeting_Assign
		* Purpose:           Assign method used to hold
		*                    the Greeting of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Greeting property.
		* Returns:           
		* Date Added:        02/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE hasmodez_access		&& Access method used to retrieve the Chilkat HasModeZ property.
		*==============================================================================
		* Method:            HasModeZ_Access
		* Purpose:           Access method used to retrieve 
		*                    the HasModeZ property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HasModeZ
		* Date Added:        02/24/2022
		*==============================================================================
		
		** 
		** Chilkat FTP2 supports MODE Z, which is a transfer mode implemented by some FTP servers. 
		** It allows for files to be uploaded and downloaded using compressed streams 
		** (using the zlib deflate algorithm). This is a read-only property. 
		** It will be set to 1 if the FTP2 component detects that your FTP server supports MODE Z. 
		** Otherwise it is set to 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE hasmodez_assign		&& Assign method used to hold a reference to the HasModeZ property.
		*==============================================================================
		* Method:            HasModeZ_Assign
