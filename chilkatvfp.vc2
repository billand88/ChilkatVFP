		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER) ;
		AND (EMPTY(m.lcValue) ;
		OR INLIST(UPPER(ALLTRIM(m.lcValue)), [NONE], [LOGIN], [PLAIN], [CRAM-MD5], [NTLM]))
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

