	PROCEDURE query		&& Introduced in version 9.5.0.96. Performs an DNS query for domain and returns the answer in answer. The type of DNS query is specified in recordType and can be A, AAAA, ALIAS, CAA, MX, NS, SOA, TXT. Additional record types can be added as needed.
		*==============================================================================
		* Method:            Query
		* Purpose:           Performs an DNS query for domain and returns the answer in answer.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRecordType -- the DNS query type.
		*                    tcDomain -- the DNS domain.
		*                    toChilkatJSON -- a Chilkat JSON object.
		* Returns:           Returns the item's Content-ID if successful.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Performs an DNS query for domain and returns the answer in answer. 
		** The type of DNS query is specified in recordType 
		** and can be A, AAAA, ALIAS, CAA, MX, NS, SOA, TXT. 
		** Additional record types can be added as needed.
		**
		
		LPARAMETERS tcRecordType AS Character, tcDomain AS Character, ;
		toChilkatJSON AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_DNS_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, luReturn AS Unknown, ;
		loParkParameterJSON AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS CHILKAT_JSONOBJECT_COM_CALL, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSON, m.loChilkatJSON
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSON = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJSON.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.Query(m.tcRecordType, m.tcDomain, m.loChilkatJSON) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJSON.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End not implemented yet test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSON, m.loChilkatJSON
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DNS_COM_CALL)
		  toChilkatJSON = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSON = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE queryasync		&& Introduced in version 9.5.0.96. Creates an asynchronous task to call the Query method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            QueryAsync
		* Purpose:           Creates an asynchronous task to call the Query method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRecordType -- the DNS query type.
		*                    tcDomain -- the DNS domain.
		*                    toChilkatJSON -- a Chilkat JSON object.
		* Returns:           Returns the item's Content-ID if successful.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Creates an asynchronous task to call the Query method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRecordType AS Character, tcDomain AS Character, ;
		toChilkatJSON AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_DNS_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS CHILKAT_JSONOBJECT_COM_CALL, loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJSON, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.QueryAsync(m.tcRecordType, m.tcDomain, m.loChilkatJSON)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End not implemented yet test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJSON
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DNS_COM_CALL)
		  toChilkatJSON = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE removeallnameservers		&& Introduced in version 9.5.0.96. Removes all nameservers from the collection of nameservers used by Chilkat. An application can call this method to reset to 0 nameservers before adding new nameservers.
		*==============================================================================
		* Method:            RemoveAllNameservers
		* Purpose:           Removes all nameservers from the collection of nameservers used by Chilkat.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Removes all nameservers from the collection of nameservers used by Chilkat. 
		** An application can call this method to reset to 0 nameservers before adding new nameservers. 
		** If a DNS domain to IP address resolution is needed by Chilkat, 
		** then the auto-assigned nameserver IP addresses will be automaticaly restored.
		**
		
		LOCAL loChilkatObject AS CHILKAT_DNS_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.RemoveAllNameservers()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DNS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

