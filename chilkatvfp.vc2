	PROCEDURE addicalendaralternativebody		&& Adds an iCalendar (text/calendar) alternative body to the email. The icalContent contains the content of the iCalendar data. A sample is shown here:
		*==============================================================================
		* Method:            AddiCalendarAlternativeBody
		* Purpose:           Adds an iCalendar (text/calendar) alternative body to the email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tciCalendarContent, the content of the iCalendar data.
		*                    tcMethodName, the method attribute.
		* Returns:           Character
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds an iCalendar (text/calendar) alternative body to the email. 
		** The icalContent contains the content of the iCalendar data. A sample is shown here:
		**
		** BEGIN:VCALENDAR
		** VERSION:2.0
		** PRODID:-//hacksw/handcal//NONSGML v1.0//EN
		** BEGIN:VEVENT
		** UID:uid1@example.com
		** DTSTAMP:19970714T170000Z
		** ORGANIZER;CN=John Doe:MAILTO:john.doe@example.com
		** DTSTART:19970714T170000Z
		** DTEND:19970715T035959Z
		** SUMMARY:Bastille Day Party
		** END:VEVENT
		** END:VCALENDAR
		** 
		** The methodName is the "method" attribute used in the Content-Type header field in the alternative body. 
		** For example, if set to "REQUEST", then the alternative body's header would look like this:
		** 
		** Content-Type: text/calendar; method=REQUEST
		** Content-Transfer-Encoding: base64
		**
		** Fixed for version 76: This method did not write the method name in the content-type.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tciCalendarContent AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddiCalendarAlternativeBody(m.tciCalendarContent, tcMethodName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

