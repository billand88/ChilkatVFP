	PROCEDURE loadtext		&& Convenience method for loading an entire text file into an in-memory string. Returns Nothing on failure
		*==============================================================================
		* Method:            LoadText
		* Purpose:           Convenience method for loading 
		*                    an entire text file into an in-memory string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTextFileName -- the text file to load.
		* Returns:           The text file string.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Convenience method for loading an entire text file into an in-memory string.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTextFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, ;
		loException AS Exception, lcString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcString = m.loChilkatObject.LoadText(m.tcTextFileName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

