		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterDtObj AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatDtObj AS CHILKAT_DTOBJ_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterDtObj, m.loChilkatDtObj
		
		llImplemented = .F.
		liIntroducedInBuild = 47
		
