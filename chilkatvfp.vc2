DEFINE CLASS bindata AS ibasechilkat OF "chilkatvfp.vcx" 		&& Container for binary data. Provides methods for getting, setting, appending, etc. in binary and string encoded formats.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: appendbd		&& Introduced in version 9.5.0.62. Appends the contents of another BinData to this object. Returns 1 for success, 0 for failure.
		*m: appendbinary		&& Introduced in version 9.5.0.51. Appends binary data to the current contents, if any. Returns 1 for success, 0 for failure.
		*m: appendbom		&& Introduced in version 9.5.0.62. Appends the appropriate BOM (byte order mark), also known as a "preamble", for the given charset. If the charset has no defined BOM, then nothing is appended.
		*m: appendbyte		&& Introduced in version 9.5.0.77. Appends a single byte. The byteValue should be a value from 0 to 255. Returns 1 for success, 0 for failure.
		*m: appendcountedstring		&& Introduced in version 9.5.0.91. Appends a byte count followed by the string in the desired character encoding, such as "utf-8". The numCountBytes is the size in bytes of the integer to represent the byte count.
		*m: appenddata		&& Introduced in version 11.0.0. Appends binary data to the current contents. Returns 1 for success, 0 for failure.
		*m: appendencoded		&& Introduced in version 9.5.0.51. Appends encoded binary data to the current data.
		*m: appendencodedsb		&& Introduced in version 9.5.0.62. Decodes the contents of sb and appends the decoded bytes to this object.
		*m: appendint2		&& Introduced in version 9.5.0.77. Appends a 16-bit integer (2 bytes). If littleEndian is 1, then the integer bytes are appended in little-endian byte order, otherwise big-endian byte order is used. Returns 1 for success, 0 for failure.
		*m: appendint4		&& Introduced in version 9.5.0.77. Appends a 32-bit integer (4 bytes). If littleEndian is 1, then the integer bytes are appended in little-endian byte order, otherwise big-endian byte order is used. Returns 1 for success, 0 for failure.
		*m: appendpadded		&& Introduced in version 9.5.0.80. Appends a string to this object, padded to the fieldLen with NULL or SPACE chars. If padWithSpace is 1, then SPACE chars are used and the string is not null-terminated.
		*m: appendsb		&& Introduced in version 9.5.0.62. Appends the contents of a StringBuilder to this object. Returns 1 for success, 0 for failure.
		*m: appendstring		&& Introduced in version 9.5.0.62. Appends a string to this object. (This does not append the BOM. If a BOM is required, the AppendBom method can be called to append the appropriate BOM.) Returns 1 for success, 0 for failure.
		*m: byteswap		&& Introduced in version 11.0.0. Does either 16-bit or 32-bit byte swapping of the entire contents. If size equals 16, then swaps in 2 bytes (e.g., 0x1234 ? 0x3412). If size equals 32, then swaps 4 bytes (e.g., 0x12345678 ? 0x78563412).
		*m: charsetconvert		&& Introduced in version 11.0.0. This method converts the character encoding of an object's contents from one format to another, such as from Windows-1252 to UTF-8.
		*m: clear		&& Introduced in version 9.5.0.51. Clears the contents. Returns 1 for success, 0 for failure.
		*m: contentsequal		&& Introduced in version 9.5.0.62. Return 1 if the contents of this object equals the contents of binData.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat BinData DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: findstring		&& Introduced in version 9.5.0.85. Return the index where the first occurrence of str is found. Return -1 if not found. The startIdx indicates the byte index where the search begins.
		*m: getbinary		&& Introduced in version 9.5.0.51. Retrieves the binary data contained within the object. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: getbinarychunk		&& Introduced in version 9.5.0.51. Retrieves a chunk of the binary data contained within the object. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: getbyte		&& Introduced in version 9.5.0.92. Returns the value of the byte at the given index. The returned value is an integer from 0 to 255.
		*m: getdata		&& Introduced in version 11.0.0. Retrieves the binary data contained within the object.
		*m: getdatachunk		&& Introduced in version 11.0.0. Retrieves a chunk of the binary data contained within the object.
		*m: getencoded		&& Introduced in version 9.5.0.51. Retrieves the binary data as an encoded string.
		*m: getencodedchunk		&& Introduced in version 9.5.0.51. Retrieves a chunk of the binary data and returns it in encoded form.
		*m: getencodedsb		&& Introduced in version 9.5.0.64. Writes the encoded data to a StringBuilder.
		*m: gethash		&& Introduced in version 9.5.0.91. Returns the hash of the contents of this object.
		*m: getint2		&& Introduced in version 9.5.0.88. Returns the value of the 16-bit signed integer stored in big-endian or little-endian byte ordering at the given index.
		*m: getint4		&& Introduced in version 9.5.0.88. Returns the value of the 32-bit signed integer stored in big-endian or little-endian byte ordering at the given index.
		*m: getstring		&& Introduced in version 9.5.0.67. Interprets the bytes according to charset and returns the string.
		*m: gettextchunk		&& Introduced in version 9.5.0.85. Returns numBytes bytes starting at startIdx. The bytes are interpreted according to charset (for example, "utf-8", "ansi", "utf-16", "windows-1252", etc.) Returns Nothing on failure.
		*m: isvalidutf8		&& Introduced in version 10.1.0. Returns 1 if this object contains valid utf-8 byte sequences. Any invalid byte sequence that is not valid utf-8 will cause this function to return 0. Returns 1 for success, 0 for failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat BinData LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat BinData LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat BinData LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat BinData LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadbinary		&& Introduced in version 9.5.0.51. Loads binary data and replaces the current contents, if  any. Returns 1 for success, 0 for failure.
		*m: loadencoded		&& Introduced in version 9.5.0.51. Loads binary data from an encoded string, replacing the current contents, if any.
		*m: loadfile		&& Introduced in version 9.5.0.51. Loads data from a file. Returns 1 for success, 0 for failure.
		*m: numbytes_access		&& Access method used to retrieve the Chilkat BinData NumBytes property.
		*m: numbytes_assign		&& Assign method used to hold a reference to the NumBytes property.
		*m: removebyteval		&& Introduced in version 9.5.0.90. Removes bytes having a specified value (0-255). For example, to remove all null bytes, pass 0 in value.
		*m: removechunk		&& Introduced in version 9.5.0.51. Removes a chunk of bytes from the binary data.
		*m: secureclear		&& Introduced in version 9.5.0.67. Securely clears the contents by writing 0 bytes to the memory prior to deallocating the internal memory. Returns 1 for success, 0 for failure.
		*m: writeappendfile		&& Introduced in version 9.5.0.91. Appends the contents of this object to a file. Returns 1 for success, 0 for failure.
		*m: writefile		&& Introduced in version 9.5.0.62. Writes the contents to a file. Returns 1 for success, 0 for failure.
		*p: debuglogfilepath
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numbytes		&& Introduced in version 9.5.0.51. The number of bytes contained within the object.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = BinData
		debuglogfilepath = 
		lastbinaryresult = .NULL.
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "bindata"
		numbytes = 0
	*</PropValue>
	
	PROCEDURE appendbd		&& Introduced in version 9.5.0.62. Appends the contents of another BinData to this object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendBd
		* Purpose:           Appends the contents of another BinData to this object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62
		**
		** Appends the contents of another BinData to this object.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_BINDATA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 62
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AppendBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendbinary		&& Introduced in version 9.5.0.51. Appends binary data to the current contents, if any. Returns 1 for success, 0 for failure.
		*==============================================================================
