		* Returns:           Nothing
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds a related item to the email from an in-memory string. 
		** Related items are things such as images and style sheets that are embedded within an HTML email. 
		** They are not considered attachments because their sole purpose is to participate in the display of the HTML. 
		** The filenameInHtml argument should be set to the filename 
		** used in the HTML img tag's src attribute (if it's an image), 
		** or the URL referenced in an HTML link tag for a stylesheet. 
		** The charset argument indicates that the content should first 
		** be converted to the specified charset prior to adding to the email. 
		** It should hava a value such as "iso-8859-1", "utf-8", "Shift_JIS", etc.
		**
		** Fixed for Version 46: Minor fix to suppress the unintentional creation 
		** of an empty plain-text body in the MIME in some circumstances 
		** (which is usually harmless).
		**
		
		LPARAMETERS tcFileNameInHTML AS Character, tcContent AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      m.loChilkatObject.AddRelatedString2(m.tcFileNameInHTML, m.tcContent, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

