	PROCEDURE decompressfile		&& Performs file-to-file decompression (the opposite of CompressFile). Internally the file is decompressed in streaming mode which allows files of any size to be decompressed. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DecompressFile
		* Purpose:           Performs file-to-file decompression.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSourceFilePath, the path to the source file.
		*                    tcDestinationFilePath, the path to the decompressed file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Performs file-to-file decompression (the opposite of CompressFile). 
		** Internally the file is decompressed in streaming mode which allows files 
		** of any size to be decompressed.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSourceFilePath AS Character, tcDestinationFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DecompressFile(m.tcSourceFilePath, ;
		      m.tcDestinationFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
