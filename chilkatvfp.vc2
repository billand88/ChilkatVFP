	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        01/10/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical, loProcess_Access AS [Process_Access OF ChilkatVFP.VCX], ;
		loProcess_Assign AS [Process_Assign OF ChilkatVFP.VCX], lcErrorMessage AS Character, ;
		llInitializedMsgSvc AS Logical, loChilkat AS Object, llInstanceClass AS Logical, ;
		llIsImplemented AS Logical, llSupportsSemanticVersioning AS Logical, ;
		loVersioning AS [iVersioning OF ChilkatVFP.VCX], liBuildMajor AS Integer, ;
		liBuildMinor AS Integer, liBuildPatch AS Integer, lcSecondParameter AS Character, ;
		lcClassName AS Character, liCalculatedBuildNumber AS Integer, llRetired AS Integer, ;
		lcBuild AS Character, lcInstance AS Character, liInstanceMajor AS Integer, ;
		liInstanceMinor AS Integer, liInstancePatch AS Integer, lcRetirement AS Character, ;
		liRetirementMajor AS Integer, liRetirementMinor AS Integer, liRetirementPatch AS Integer
		
		STORE NULL TO m.loProcess_Access, m.loProcess_Assign, m.loChilkat, m.loVersioning
		STORE .F. TO m.llInitializedMsgSvc, m.llInstanceClass, m.llRetired, ;
		m.llIsImplemented, m.llSupportsSemanticVersioning, m.llReturn
		STORE 0 TO m.liBuildMajor, m.liBuildMinor, m.liBuildPatch, m.liInstanceMajor, ;
		m.liInstanceMinor, m.liInstancePatch, m.liCalculatedBuildNumber, ;
		m.liRetirementMajor, m.liRetirementMinor, m.liRetirementPatch
		STORE [] TO m.lcErrorMessage, m.lcSecondParameter, ;
		m.lcClassName, m.lcBuild, m.lcInstance, m.lcRetirement
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    llInitializedMsgSvc = .InitializeMsgSvc()
		    llReturn = m.llInitializedMsgSvc
		
		    ** Okay to continue test
		    IF m.llReturn
		
		      loProcess_Access = NEWOBJECT([iProcess_Access])
		
		      ** Have a good object test
		      IF TYPE([loProcess_Access.Name]) == T_CHARACTER
		
		        .oProcess_Access = m.loProcess_Access
		
		      ELSE
		
		        lcErrorMessage = ChMsgSvc([Not Instantiate Process_Access], , , THIS)
		       .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		       llReturn = .F.
		
		      ENDIF TYPE([loProcess_Access.Name]) == T_CHARACTER
		      ** End have a good object test
		
		      loProcess_Assign = NEWOBJECT([iProcess_Assign])
		
		      ** Okay to continue and have a good object test
		      IF m.llReturn AND TYPE([loProcess_Assign.Name]) == T_CHARACTER
		
		        .oProcess_Assign = m.loProcess_Assign
		
		      ELSE
		
		        lcErrorMessage = ChMsgSvc([Not Instantiate Process_Assign], , , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		        llReturn = .F.
		
		      ENDIF m.llReturn AND TYPE([loProcess_Assign.Name]) == T_CHARACTER
		      ** End have a good object test
		
		    ELSE && MsgSvc didn't load...
		
		      lcErrorMessage = ChMsgSvc([InitializeMsgSvc failed], , , THIS)
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF m.llReturn
		    ** End okay to continue test
		
		    ** Okay to continue test
		    IF m.llReturn
		
		      llInstanceClass = NOT EMPTY(.cChilkatClass)
		
		      ** Instance class test
		      IF m.llInstanceClass
		
		        loVersioning = .oVersioning
		
		        ** Have custom method on Versioning object test
		        IF TYPE([loVersioning.Name]) == T_CHARACTER ;
		
		          ** Custom property on Versioning object test
		          IF PEMSTATUS(m.loVersioning, [lSupportsSemanticVersioning], 5)
		
		            llSupportsSemanticVersioning = .lSupportsSemanticVersioning
		
		            .cChilkatObjectPrefix = ;
		            IIF(m.llSupportsSemanticVersioning, [Chilkat], [Chilkat_9_5_0])
		
		          ENDIF PEMSTATUS(m.loVersioning, [lSupportsSemanticVersioning], 5)
		          ** End custom property on Versioning object test
		
		          STORE PEMSTATUS(m.loVersioning, [IsImplemented], 5) ;
		          AND m.loVersioning.IsImplemented() ;
		          TO m.llIsImplemented, m.llReturn
		
		          STORE INT(m.loVersioning.iBuildMajor) TO m.liBuildMajor, .iBuildMajor
		          STORE INT(m.loVersioning.iBuildMinor) TO m.liBuildMinor, .iBuildMinor
		          STORE INT(m.loVersioning.iBuildPatch) TO m.liBuildPatch, .iBuildPatch
		
		          ** Not implemented test
		          IF NOT m.llIsImplemented
		
		            lcClassName = .cChilkatClass
		
		            liInstanceMajor = .iInstanceMajor
		            liInstanceMinor = .iInstanceMinor
		            liInstancePatch = .iInstancePatch
		
		            llRetired = .IsRetired()
		
		            ** Class doesn't exist yet test (not retired)
		            IF NOT m.llRetired
		
		              ** Use three dot notation test
		              IF m.liInstanceMajor = 9
		
		                lcInstance = [9.] + ALLTRIM(STR(m.liInstanceMinor)) + [.0.] + ALLTRIM(STR(m.liInstancePatch))
		
		              ELSE && two dot notation 
		
		                lcInstance = ALLTRIM(STR(m.liInstanceMajor)) + ;
		                [.] + ALLTRIM(STR(m.liInstanceMinor)) + [.] + ;
		                ALLTRIM(STR(m.liInstancePatch))
		
		              ENDIF m.liInstanceMajor = 9
		              ** End use three dot notation test
		
		            ELSE && retired, get retirement number.
		
		              ** Note: No Chilkat classes were retired / decremented in the 9.5.0 series
		
		              liRetirementMajor = .iRetirementMajor
		              liRetirementMinor = .iRetirementMinor
		              liRetirementPatch = .iRetirementPatch
		
		              lcRetirement = ALLTRIM(STR(m.liRetirementMajor)) + ;
		              [.] + ALLTRIM(STR(m.liRetirementMinor)) + [.] + ;
		              ALLTRIM(STR(m.liRetirementPatch))
		
		            ENDIF NOT m.llRetired
		            ** End class doesn't exist yet test (not retired)
		
		            ** Use three dot notation test
		            IF m.liBuildMajor = 9
		
		              lcBuild = [9.] + ALLTRIM(STR(m.liBuildMinor)) + [.0.] + ALLTRIM(STR(m.liBuildPatch))
		
		            ELSE && two dot notation 
		
		              lcBuild = ALLTRIM(STR(m.liBuildMajor)) + ;
		              [.] + ALLTRIM(STR(m.liBuildMinor)) + [.] + ;
		              ALLTRIM(STR(m.liBuildPatch))
		
		            ENDIF m.liBuildMajor = 9
		            ** End use three dot notation test
		
		            ** Class doesn't exist yet test
		            IF NOT m.llRetired
		
		              lcSecondParameter = PROPER(m.lcClassName) + [~] + m.lcInstance + [~] + m.lcBuild
		 
		              lcErrorMessage = ChMsgSvc([Class does not exist], m.lcSecondParameter, , THIS)
		              .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		            ELSE && class is retired (decremented)
		
		              lcSecondParameter = PROPER(m.lcClassName) + [~] + m.lcRetirement + [~] + m.lcBuild
		
		              lcErrorMessage = ChMsgSvc([Class removed], m.lcSecondParameter, , THIS)
		              .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		            ENDIF NOT m.llRetired
		            ** End class doesn't exist yet test
		
		          ELSE
		
		            loChilkat = .GetChilkatObject(.cChilkatClass)
		
		          ENDIF NOT m.llIsImplemented
		          ** End not implemented test
		
		        ELSE
		
		          llReturn = .F.
		
		        ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		        ** End have custom method on Versioning object test
		
		      ENDIF m.llInstanceClass
		      ** End instance class test
		
		      llReturn = ;
		      (m.llInstanceClass AND VARTYPE(m.loChilkat) == T_OBJECT) ;
		      OR (NOT m.llInstanceClass)
		
		    ENDIF m.llReturn
		    ** End okay to continue test
		
		    ** Instantiated object test
		    IF m.llReturn
		
		      .qScratch = CAST([] AS VarBinary)
		
		      ** Calculate version number value here??? Or in Versioning?
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Chilkat version processing branch
		      DO CASE
		
		        ** Before version 52 branch [9.5.0.51]
		        CASE (NOT m.llSupportsSemanticVersioning) ;
		        AND m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 52)
		
		          SET PROCEDURE TO ChilkatVFPEventCallbacksPreV52 ADDITIVE
		
		        ** Before version 58 branch [9.5.0.56]
		        CASE (NOT m.llSupportsSemanticVersioning) ;
		        AND m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 58)
		
		          SET PROCEDURE TO ChilkatVFPEventCallbacksPreV58 ADDITIVE
		
		        ** Version 58 or later branch [9.5.0.79]
		        CASE (NOT m.llSupportsSemanticVersioning) ;
		        AND m.liCalculatedBuildNumber > m.loVersioning.GenerateVersionNumber(9, 5, 57)
		
		          SET PROCEDURE TO ChilkatVFPEventCallbacksV58 ADDITIVE
		
		        ** Version 10 or above test [10.0.0]
		        CASE m.llSupportsSemanticVersioning
		
		          SET PROCEDURE TO ChilkatVFPEventCallbacks ADDITIVE
		
		      ENDCASE
		      ** End Chilkat version processing branch
		
		      .Init_Post()
		
		    ENDIF m.llReturn
		    ** End instantiated object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		STORE NULL TO m.loProcess_Access, m.loProcess_Assign, m.loVersioning, m.loChilkat
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loProcess_Access = NEWOBJECT([iProcess_Access], [ChilkatVFP.VCX])
		  loProcess_Assign = NEWOBJECT([iProcess_Assign], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([Versioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE initializemsgsvc		&& Method run to initialize MsgSvc.
		*==============================================================================
		* Method:            InitializeMsgSvc
		* Purpose:           Method run to initialize MsgSvc.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        03/14/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical, loMsgSvc AS [cMsgSvc OF cAbstractDirector]
		
		llReturn = .F.
		
		** Close the MsgSvc table down if it is open, let MsgSvc start clean...
		USE IN SELECT([MsgSvc])
		
		SET PROCEDURE TO [ChMsgSvc.PRG] ADDITIVE
		
		loMsgSvc = THIS.oMsgSvc && this forces the oMsgSvc_Access method to run...
		
		llReturn = (VARTYPE(m.loMsgSvc) == T_OBJECT) AND (NOT ISNULL(m.loMsgSvc))
		
		loMsgSvc = NULL
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE init_post		&& Method used to run a post-initialization process.
		*==============================================================================
		* Method:            Init_Post
		* Purpose:           Method used to run a post-initialization process.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        08/28/2022
		*==============================================================================
		
		LOCAL lcChilkatClass AS Character, liBuildMajor AS Integer, ;
		liBuildMinor AS Integer, liBuildPatch AS Integer
		
		STORE 0 TO liBuildMajor, liBuildMinor, liBuildPatch
		
		WITH THIS
		
		  lcChilkatClass = UPPER(.cChilkatClass)
		
		  liBuildMajor = .iBuildMajor
		  liBuildMinor = .iBuildMinor
		  liBuildPatch = .iBuildPatch
		
		  ** Not CkString class test
		  IF m.lcChilkatClass # [CKSTRING]
		
		    ** Have a LastErrorHTML property test
		    IF PEMSTATUS(THIS, [LastErrorHTML], 5)
		
		      .LastErrorHTML = .LastErrorHTML
		
		    ENDIF PEMSTATUS(THIS, [LastErrorHTML], 5)
		    ** End have a LastErrorHTML property test
		
		    ** Have a LastErrorText property test
		    IF PEMSTATUS(THIS, [LastErrorText], 5)
		
		      .LastErrorText = .LastErrorText
		
		    ENDIF PEMSTATUS(THIS, [LastErrorText], 5)
		    ** End have a LastErrorText property test
		
		    ** Have a LastErrorXML property test
		    IF PEMSTATUS(THIS, [LastErrorXML], 5)
		
		      .LastErrorXML = .LastErrorXML
		
		    ENDIF PEMSTATUS(THIS, [LastErrorXML], 5)
		    ** End have a LastErrorXML property test
		
		    ** Class not one of 4 specified classes, 
		    ** or specified classes are version 83 or above test
		    IF (NOT INLIST(m.lcChilkatClass, [BINDATA], [SFTPDIR], [SFTPFILE], [STRINGBUILDER])) ;
		    OR .lSupportsSemanticVersioning ;
		    OR ((NOT .lSupportsSemanticVersioning) AND liBuildPatch > 82)
		
		      ** Have a LastBinaryResult property test
		      IF PEMSTATUS(THIS, [LastBinaryResult], 5)
		
		        .LastBinaryResult = .LastBinaryResult
		
		      ENDIF PEMSTATUS(THIS, [LastBinaryResult], 5)
		      ** End have a LastBinaryResult property test
		
		      ** Have a LastStringResult property test
		      IF PEMSTATUS(THIS, [LastStringResult], 5)
		
		        .LastStringResult = .LastStringResult
		
		      ENDIF PEMSTATUS(THIS, [LastStringResult], 5)
		      ** End have a LastStringResult property test
		
		    ENDIF (NOT INLIST(m.lcChilkatClass, [BINDATA], [SFTPDIR], [SFTPFILE], [STRINGBUILDER])) ;
		    OR .lSupportsSemanticVersioning ;
		    OR ((NOT .lSupportsSemanticVersioning) AND liBuildPatch > 82)
		    ** End class not one of 4 specified classes, 
		    ** or specified classes are version 83 or above test
		
		  ENDIF m.lcChilkatClass # [CKSTRING]
		  ** End not CkString class test
		
		ENDWITH
		
		RETURN
	ENDPROC

