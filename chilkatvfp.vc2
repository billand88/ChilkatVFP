	PROCEDURE getbyte		&& Introduced in version 9.5.0.92. Returns the value of the byte at the given index. The returned value is an integer from 0 to 255.
		*==============================================================================
		* Method:            GetByte
		* Purpose:           Returns the value of the 16-bit signed integer stored in 
		*                    big-endian or little-endian byte ordering at the given index.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the index value to retrieve the integer.
		*                    tuLittleEndian, whether or not 
		*                    the bytes are retrieved in little-endian byte order.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        11/05/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		** 
		** Returns the value of the 16-bit signed integer stored 
		** in big-endian or little-endian byte ordering at the given index.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tuLittleEndian AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_BINDATA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liLittleEndian AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liLittleEndian, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liLittleEndian = .LogicalToBit(m.tuLittleEndian)
		
		      TRY
		
		        STORE m.loChilkatObject.GetByte(m.tiIndex, m.liLittleEndian) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

