	PROCEDURE getbinarycontent		&& Returns binary content of an XML node as a byte array. The content may have been Zip compressed, AES encrypted, or both. Unzip compression and AES decryption flags should be set appropriately. Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            GetBinaryContent
		* Purpose:           Returns binary content of an XML node as a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuUnZip -- determines whether or not unzipping is needed.
		*                    tuAESDecryption -- determines if AES encryption was used.
		*                    tcPassword -- the password for the Zip file
		* Returns:           Binary content
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Returns binary content of an XML node as a byte array. 
		** The content may have been Zip compressed, AES encrypted, or both. 
		** Unzip compression and AES decryption flags should be set appropriately.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tuUnZip AS Unknown, ;
		tuAESDecryption AS Unknown, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liUnZip AS Integer, liAESDecryption AS Integer, lqContent AS VarBinary
		
		STORE 0 TO m.liUnZip, m.liAESDecryption
		STORE NULL TO m.loChilkatObject, m.loException, m.lqContent
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUnZip = .LogicalToBit(m.tuUnZip)
		    liAESDecryption = .LogicalToBit(m.tuAESDecryption)
		
		    TRY
		
		      lqContent = m.loChilkatObject.GetBinaryContent(m.liUnZip, m.liAESDecryption, m.tcPassword)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqContent
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

