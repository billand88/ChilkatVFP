	PROCEDURE setauth		&& Introduced in version 11.5.0. Sets authorization information that is applied to all calls to DoYourThing. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetResponseXML
		* Purpose:           Writes to XML the HTTP response body from the last call to DoYourThing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML, a Chilkat XML object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/15/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Writes to XML the HTTP response body from the last call to DoYourThing.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatXML AS [Chilkat.XML]
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterXML AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXML AS [Chilkat.XML]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXML, m.loChilkatXML
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterXML = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXML)
		
		      loChilkatXML = m.loParkParameterXML.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetResponseXML(m.loChilkatXML) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatXML = ;
		      m.loParkParameterXML.SetObject(m.toChilkatXML, m.loChilkatXML)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXML, m.loChilkatXML
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.HttpCurl])
		  loException = NEWOBJECT([Exception])
		  toChilkatXML = NEWOBJECT([Chilkat.XML])
		  loParkParameterChilkatXML = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXML = NEWOBJECT([Chilkat.XML])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setvar		&& Introduced in version 11.5.0. Sets the value of a variable to be replaced in curl commands. Variable names are enclosed in {{ and }} and can occur in the path, query params, or the body of the request. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetVar
		* Purpose:           Sets the value of a variable to be replaced in curl commands.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVariableName - the variable name.
		*                    tcVariableValue, the variable value to apply.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/15/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Sets the value of a variable to be replaced in curl commands. 
		** Variable names are enclosed in {{ and }} and can occur in the path, 
		** query params, or the body of the request.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcVariableName AS Character, tcVariableValue AS Character 
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetVar(m.tcVariableName, ;
		        m.tcVariableValue) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
