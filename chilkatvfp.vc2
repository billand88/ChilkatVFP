DEFINE CLASS validateproperty AS ibase OF "chilkatvfp.vcx" 		&& Class used to validate property values.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: algorithm_compression		&& Method run to validate the data for the Compression Algorithm property.
		*m: algorithm_eddsa		&& Method run to validate the data for the EdDSA Algorithm property.
		*m: apispec
		*m: ask		&& Method run to validate the data for the AI Ask property.
		*m: authmethod		&& Method run to validate the data for the AuthMethod property.
		*m: awssignatureversion		&& Method run to validate the data for the AWSSignatureVersion property.
		*m: awssubresources		&& Method run to validate the data for the AWSSubResources property.
		*m: bcryptworkfactor		&& Method run to validate the data for the BCryptWorkFactor property.
		*m: behaviors		&& Method run to validate the data for the Behaviors property.
		*m: bgpercentdone		&& Method run to validate the data for the BgPercentDone property.
		*m: charset		&& Method run to validate the data for the various charset properties.
		*m: ciphermode		&& Method run to validate the data for the CipherMode property.
		*m: clientport		&& Method run to validate the data for the ClientPort property.
