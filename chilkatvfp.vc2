		* Parameters:        tcString -- the string to encrypt
		*                    tcPassword -- the password used to encrypt.
		* Returns:           The encrypted string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Matches MySQL's AES_ENCRYPT function. 
		** The return value is a hex-encoded string of the encrypted data. 
		** The equivalent call in MySQL would look like this: 
		** HEX(AES_ENCRYPT('The quick brown fox jumps over the lazy dog','password'))
		** 
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS tcString AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncryptedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncryptedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncryptedString = ;
		      m.loChilkatObject.MySQLAESEncrypt(m.tcString, m.tcPassword)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncryptedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE numsignercerts_access		&& Access method used to retrieve the Chilkat Crypt2 NumSignerCerts property.
		*==============================================================================
		* Method:            NumSignerCerts_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 NumSignerCerts property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumSignerCerts
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** This property is set when a digital signature is verified. 
		** It contains the number of signer certificates. 
		** Each signing certificate can be retrieved 
		** by calling the GetSignerCert method, passing an index from 0 to NumSignerCerts-1.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE numsignercerts_assign		&& Assign method used to hold a reference to the NumSignerCerts property.
		*==============================================================================
		* Method:            NumSignerCerts_Assign
		* Purpose:           Assign method used to hold a reference to the NumSignerCerts property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the NumSignerCerts property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE oaephash_access		&& Access method used to retrieve the Chilkat Crypt2 OAEPHash property.
		*==============================================================================
		* Method:            OAEPHash_Access
		* Purpose:           Access method used to retrieve the Chilkat Crypt2 OAEPHash property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.OAEPHash
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.67
		** 
		** Selects the hash algorithm for use within OAEP padding when encrypting 
		** using "pki" using RSAES-OAEP. 
		** The valid choices are "sha1", "sha256", "sha384", "sha512",
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 67
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

