	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat MailMan HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        01/07/2022
		*==============================================================================
		
		**
		** The time interval, in milliseconds, between AbortCheck event callbacks. 
		** The heartbeat provides a means for an application to monitor a mail-sending 
		** and/or mail-reading method call, and to abort it while in progress.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MailMan HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the HeartbeatMs property.
		* Returns:           
		* Date Added:        01/07/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [HeartbeatMs]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE helohostname_access		&& Access method used to retrieve the Chilkat MailMan HeloHostName property.
		*==============================================================================
		* Method:            HeloHostname_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan HeloHostname property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeloHostname
		* Date Added:        01/07/2022
		*==============================================================================
		
		**
		** Specifies the hostname to be used for the EHLO/HELO command sent to an SMTP server. 
		** By default, this property is an empty string which causes the local hostname to be used.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE helohostname_assign		&& Assign method used to hold a reference to the HeloHostName property.
		*==============================================================================
		* Method:            HeloHostname_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MailMan HeloHostname property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the HeloHostname property.
