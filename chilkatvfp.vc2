	HIDDEN PROCEDURE autounwrapsecurity_access		&& Access method used to hold a reference to the AutoUnwrapSecurity property.
		*==============================================================================
		* Method:            AutoUnwrapSecurity_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan AutoUnwrapSecurity property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoUnwrapSecurity
		* Date Added:        01/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** If 1, then digitally signed and/or encrypted email when downloaded from a 
		** mail server is automatically "unwrapped" and the results of the signature validation 
		** and decryption are available in various email object properties and methods. 
		** The default value of this property is 1. Set this property to 0 to prevent unwrapping.
		**
		** Note: A digitally signed or encrypted email can ONLY be verified and/or decrypted 
		** when initially loading the original MIME into the email object 
		** (i.e. when downloading from the server, or when loading from MIME). 
		** Once the MIME is parsed and stored in the internal email object format, 
		** the exactnes of the MIME has been lost and the signature can no longer be verified. 
		** This is why the signature is verified upon the intial loading of the MIME, 
		** and the results are made available through the various properties and methods. 
		** This property provides a means for downloading email where the .p7m (or .p7s) attachments 
		** are to be treated as simple attachments 
		** and the desire is to access or save the original .p7m/.p7s files.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE autounwrapsecurity_assign		&& Assign method used to hold a reference to the AutoUnwrapSecurity property.
		*==============================================================================
		* Method:            AutoUnwrapSecurity_Assign
		* Purpose:           Assign method used to hold a reference to the AutoUnwrapSecurity property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoUnwrapSecurity property.
		* Returns:           
		* Date Added:        01/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE checkmail		&& Returns the number of emails available on the POP3 server. Returns -1 on error.
		*==============================================================================
		* Method:            CheckMail
		* Purpose:           Returns the number of emails available on the POP3 server. 
		*                    Returns -1 on error.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Numeric
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Returns the number of emails available on the POP3 server. Returns -1 on error.
		**
		** The VerifyPopConnection method can be called to verify basic 
		** TCP/IP connectivity with the POP3 server. 
		** The VerifyPopLogin method can be called to verify the POP3 login. 
		** The Verify* methods are intended to be called as a way of diagnosing 
		** the failure when a POP3 method returns an error status.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liReturn = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liReturn = m.loChilkatObject.CheckMail()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE checkmailasync		&& Creates an asynchronous task to call the CheckMail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            CheckMailAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    CheckMail method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the CheckMail method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.CheckMailASync()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  Large UID handling — Fixed mailboxes mixing ordinary and very large UIDs, 
		  where UID-based searches previously mishandled the large values.
		
		  Fixed a crash bug in FetchUidlSet.
		
		  RequireHostnameMatch — Added property.
		
		  SniHostName — Added property.
		
		** Version 11.5.0
		
		  In Chilkat classes having SOCKS proxy properties, added the ability 
		  for a SOCKS destination host to be an IPv6 address.
		
		  Added the boolean EnableSecrets property to several Chilkat classes. When set to true, 
		  it provides the ability to pass a secret name rather than the actual value of a sensitive item. 
		  For example, a password for Ftp2, or a client_secret for OAuth2 client credentials. 
		  The value (such as client_secret) would’ve been previously stored via the Chilkat.Secrets API 
		  to the local manager, which on Windows is the Window Credentials Manager, 
		  and on Apple is the Apple Keychain.
		
		  Secrets Conceptual Overview — See Chilkat Secrets API for a refresher on the Secrets API.
		
		  When EnableSecrets is true, certain Chilkat methods and properties are secrets-aware. 
		  A passed-in value having the format “!!part1|part2|part3|part4” where a secret name 
		  is specified by providing 2 to 4 parts will get auto-resolved by looking up the secret 
		  in the local manager and found value will be used instead. 
		  This makes it easier for applications to avoid embedding sensitive information in source code.
		  For more information, see Chilkat EnableSecrets
		
		** Version 11.4.0
		
		  Starting from v11.0.0, the GetHeaders method would return only 1 email header 
		  for calls after the first call where the requested chunk did not start at 0.
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		  Many classes have a GetLastJsonData method. This method was fixed 
		  to avoid clearing the contents of the LastErrorText.
		
		** Version 11.1.0
		
		  Added the DeleteUidlSet method.
		
		** Version 11.0.0
		
		  Removed the UnlockComponent method.
		
		  Removed the IsUnlocked method.
		
		  Added the SMTPMailFrom property.
		
		  Added the AddPfxSourceBd, FetchAll, FetchAllAsync, FetchByUidl, FetchByUidlAsync,
		  FetchFull, FetchFullAsync, FetchMimeByMsgnumBd, FetchMimeByMsgnumBdAsync, 
		  FetchOne, FetchOneAsync, FetchRange, FetchRangeAsync, FetchUidls, FetchUidlsAsync, 
		  FetchUidlSet, FetchUidlSetAsync, GetLastJsonData, GetServerCert, LoadMbxFile, 
		  and SMTPRecipientsLog methods.
		
		  Decremented CopyMail, CopyMailAsync, FetchByMsgNum, FetchByMsgNumAsync, 
		  FetchEmail, FetchEmailAsync, FetchMultiple, FetchMultipleAsync, 
		  FetchMultipleHeaders, FetchMultipleHeadersAsync, FetchMultipleMime, FetchMultipleMimeAsync, 
		  FetchSingleHeader, FetchSingleHeaderAsync, FetchSingleHeaderByUidl, FetchSingleHeaderByUidlAsync, 
		  GetAllHeaders, GetAllHeadersAsync, GetFullEmail, GetFullEmailAsync, 
		  GetHeaders, GetHeadersAsync, GetPop3SslServerCert, GetSmtpSslServerCert,
		  GetUidls, GetUidlsAsync, LastJsonData, LoadEml, LoadMbx, LoadMime, 
		  LoadXMLEmail, LoadXMLEmailString, LoadXMLFile, LoadXMLString, 
		  MxLookup, MxLookupAll, TransferMail, TransferMailAsync, 
		  TransferMultipleMime and TransferMultipleMimeAsync methods.
		
		** Version 10.1.2
		
		  Fixed SMTP XOAUTH2 authentication for SMTP servers that require two separate commands within the SMTP protocol. 
		  (This is an internal fix to Chilkat that will avoid a problem for certain SMTP servers.)
		
		** Version 10.0.0
		
		  Added the ability to create and verify AES-GCM authEnvelopedData. 
		  This applies to anything doing CMS/PKCS7 encryption, but was needed for S/MIME email.
		
		** Version 99
		
		  Client-initiated TLS renegotiation is generally considered a vulnerability, 
		  and Chilkat does not allow it by default. If an application really needs 
		  to enable client-initiated renegotation (which is an extension in the TLS ClientHello, 
		  sent internally by Chilkat), then you can add the keyword “AllowClientInitReneg” 
		  to the UncommonOptions property for any Chilkat function that makes a TLS connection.
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 98
		
		  Fixed a TLS 1.3 session resumption issue (where session resumption wasn’t achieved when it could’ve been).
		
		** Version 97
		
		  The SMTP username/password will now be sent using the utf-8 byte representation instead of ANSI.
		  This makes no difference for logins and passwords that are entirely us-ascii.
		  It only matters if non-us-ascii chars are present. In the very distant past, mail servers
		  would want the ANSI single-byte-per-char encoding for non-us-ascii, but for many years now,
		  more mail servers expect utf-8 for non-us-ascii. The old ANSI behavior can be achieved
		  by adding the keyword “SmtpLoginAnsi” to the MailMan.UncommonOptions property.
		
		** Version 95
		
		  The default value for the OpaqueSigning property has been changed to false.
		  This is because emails that are signed opaquely, where the signed content is contained
		  within the PKCS7 signature w/ a Content-Type of application/pkcs7-mime are often mistaken
		  by servers or recipients as encrypted. When OpaqueSigning is false,
		  Chilkat creates a detached signature with the multipart/signed Content-Type.
		
		  Fixed problem where SMTP sending of email (in rare cases) was slow.
		
		** Version 94
		
		  Fixed issue where an email address contains non-us-ascii chars in the name part of the email address.
		  For example kænnæth@example.com
		
		** Version 93
		
		  Fixed office365.com TLS connection problems.
		
		** Version 92
		
		  Added the Pop3StlsIfPossible property to allow for optional explicit TLS connections
		  with a POP3 server, but only if the POP3 server supports it.
		
		** Version 91
		
		  Changed the default for MailMan.OpaqueSigning to True.
		  This is because opaque signing (as opposed to adding a detached signature)
		  is much less likely to be problematic. This is a case where technically backward compatibility
		  is broken (i.e. an application that never explicitly sets MailMan.OpaqueSigning
		  would now send enveloped signature signed emails instead of detached signatures)
		  but we feel it is very unlikely to cause a problem, and it is very likely to avoid problems.
		
		  Fixed a crash bug (rare) when sending emails with certain characteristics and also with an empty body.
		
		** Version 89
		
		  Fixed a problem with decrypting messages that used AES-GCM with a certificate
		  having a non-exportable private key (such that Microsoft CNG is needed internally).
		
		** Version 85
		
		   Added the LastSmtpStatusMsg property, to provide a one-line summary of the SMTP server’s response.
		   This would be “250 OK” (or something similar) for a successful email, or something like
		   “550 5.4.5 Daily user sending quota exceeded. a23sm14387806pgv.35 – gsmtp” for an unsuccessful send.
		
		** Version 84
		
		   TLS 1.3 is enabled by default.  In the TLS protocol, the client tells the server which versions
		   of TLS it supports and the server then chooses the TLS version to be used.
		   Chilkat now automatically includes TLS 1.3 in the list of supported TLS protocol versions.
		   If the server chooses TLS 1.3, then TLS 1.3 is used.
		
		** Version 83
		
		  Added OAuth2 authentication capability (“AUTH XOAUTH2”) for POP3 servers
		  such as pop.gmail.com that support the XOAUTH2 authentication mechanism.
		
		  Improved support for ECDSA certs.
		
		** Version 82
		
		  TLS 1.3 can be optionally enabled by adding the “EnableTls13” keyword
		  to the UncommonOptions property in various classes: Socket, Http, Rest, Imap, MailMan, Ftp2, etc.
		  TLS 1.3 will be enabled by default starting in the next release of Chilkat.
		
		  For the case where a client certificate is needed for authentication (two-way SSL / mutual authentication),
		  if on a Windows system where the private key is installed in the Windows protected store as non-exportable
		  with the security option to force a dialog to be displayed when accessing —
		  in this case Chilkat would fail because the private key was accessed using the “silent flag”
		  (to prevent a Windows dialog). This is fixed. The dialog will appear
		  (triggered by the private key access and displayed by the Windows OS), and the TLS handshake will complete.
		  NOTE: Private key installed in this way cannot be used in non-interactive applications.
		
		** Version 79
		
		  Fixed duplicate response lines from appearing in the Pop3SessionLog.
		
		  Updated the Pop3SendRawCommand method to properly retrieve multiline responses such as CAPA or UIDL.
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 78
		
		  For classes that have a ConnectFailReason property: Added the value 125 — TLS Pin Set Mismatch.
		
		  Made internal changes to hopefully get rid of
		  “WSAECONNABORTED An established connection was aborted by the software in your host machine.”
		  errors when sending large amounts of data on a socket. (Such as for Amazon Glacier uploads.)
		  This change only applies for builds on the Windows operating system.
		  Other operating systems don’t seem to have this error.
		
		** Version 77
		
		  If the connection is idle for 1 minute or more, the next email sent will automatically use a fresh connection.
		  (When a method to send email is called, such as SendEmail, the connection is kept open
		  for the possibility that another call to SendEmail can use the same open connection.
		  Quite often, the server disconnects from an idle connection and the next call to SendEmail fails.
		  This new behavior eliminates this possibility (for the most part).
		  Applications can always explicitly close the SMTP connection by calling CloseSmtpConnection.)
		
		  Fixed problems w/ TCP/TLS connections in the Windows UWP (Universal Windows Platform) implementation.
		
		** Version 75
		
		  Added the ability to open .pfx/.p12 files where two different passwords are required:
		  one for integrity and the other for the private keys.
		  See the example at https://www.example-code.com/csharp/pfx_multiple_passwords.asp
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 73
		
		  Added methods SendMimeBd and FetchMimeBd.
		
		  Fixed: The “micalg” attribute incorrectly remained in the Content-Type header field
		  for the encrypted MIME part when the email is also signed.
		
		  Fixed problems with IPv6 addresses when using SOCKS5 proxies.
		
		  Fixed an extremely rare issue where a digital signature verification failed but should’ve been successful.
		
		** Version 71
		
		  Added the LogMailReceivedFilename property to log a POP3 conversation to a file in real-time.
		
		  Added the SetPassword method (to set the password using a SecureString
		  rather than just setting the Password property).
		
		** Version 70
		
		  Added internal re-try functionality to cope with various situations
		  for IPv4-only and IPv6-only networks.
		
		** Version 69
		
		  The ability to get the digest and encryption algorithms encountered
		  when verifying signatures and decrypting S/MIME.
		
		  Fixed some HTTP proxy issues.
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		  Added the StartTLSifPossible property.
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 66
		
		  Fixed MailMan.VerifySmtpLogin so that it returns true if the SMTP server requires no authentication.
		
		  Added support for chacha20 ciphers in TLS and SSH.
		
		** Version 65
		
		  Fixed the GetHeaders method. The fromIndex and toIndex arguments are inclusive.
		  For example, if getting headers for emails 1 to 10, then 11 emails
		  should be returned (assuming the mailbox has at least 11 emails).
		  the fix had to do with the case when the fromIndex = 0.
		  If fetching emails 0 to 2, then only 2 emails were returned. This is now fixed.
		  Fetching 0 to 2 should return 3 emails.
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 62
		
		  Note: One use of BinData and StringBuilder is in use of new methods ending in “Sb” and “Bd”.
		  These methods are for returning or passing text or binary data, especially large amounts of text or data.
		  For example, imagine one Chilkat method is used to retrieve a large amount of data,
		  and then that data is passed to another Chilkat method. A large waste of time and memory is consumed
		  in returning the string (or binary bytes) to the programming language,
		  and then immediately passing it back to Chilkat
		  If it is .NET, then the data must be marshaled from unmanaged to managed, and then,
		  to pass back to Chilkat it is marshaled from managed to unmanaged.
		  The same applies when using the ActiveX (with BSTR’s and Variants).
		  By retrieving results directly into a BinData or StringBuilder,
		  and then passing the data by passing the object, the data stays on the native side.
		  For example, the new Rest.ReadRespSb method reads the REST response directly in to a StringBuilder.
		  If it is JSON, this can be loaded directly into a JsonObject via the JsonObject.LoadSb
		  In the future, new “Sb” and “Bd” methods will be added in places
		  where large amounts of data are likely to be encountered.
		  This will create pathways allowing data to stay native as much as possible.
		  Version 9.5.0.62 adds the following initial set of Sb/Bd methods:
		
		    JsonObject.LoadSb
		    JsonObject.EmitSb
		    Xml.LoadSb
		    Xml.GetXmlSb
		
		    Email.GetMimeBd
		    Email.GetMimeSb
		    Email.SetFromMimeSb
		    Email.SetFromMimeBd
		
		    Mime.LoadMimeSb
		    Mime.LoadMimeBd
		    Mime.GetMimeSb
		    Mime.GetMimeBd
		    MailMan.RenderToMimeBd
		    MailMan.RenderToMimeSb
		    Rest.FullRequestSb
		    Rest.ReadRespSb
		    Rest.SendReqSb
		    Rest.SetMultipartBodySb
		    Rest.AddQueryParam
		    Rest.ReadRespBd
		    Rest.SendReqBd
		    Rest.SetMultipartBodyBd
		    Imap.FetchAttachmentSb
		    Imap.FetchAttachmentBd
		    Imap.AppendMimeWithFlagsSb
		    SFtp.UploadSb
		    SFtp.DownloadSb
		    SFtp.UploadBd
		    SFtp.DownloadBd
		    Ftp2.GetFileSb
		    Ftp2.GetFileBd
		
		    Ftp2.PutFileSb
		    Ftp2.PutFileBd
		
		** Version 61
		
		  Fixed TLS connection issue with some cipher suites on Big Endian machines.
		  There was a particular internal piece of code that did not properly account
		  for the endianness of the machine and assume little endian
		  (which is by far the most common byte ordering).
		
		** Version 59
		
		  Fixed: When a cert doesn’t have the Issuer CN,
		  the encrypted message could not be decrypted using Chilkat library,
		  even though the cert does have subject key id.
		
		  Fixed: The server would close the TLS connection during initial handshake
		  (after receiving the ClientHello) if it picked the cipher suite TLS_ECDHE_ECDSA in TLS 1.2.
		  The reason is that Chilkat did not include the ECDSA/SHA1 signature hash algorithm
		  as a candidate for the Server Key Exchange. (Note: This was not a security issue —
		  it was just a case where the TLS handshake would fail if the server picked
		  a particular cipher suite, only in TLS 1.2, and expected to use a paricular
		  Server Key Exchange signature hash algorithm.)
		
		  Added the hmac-sha1-96 algorithm to what is supported in the internal SSH connection protocol.
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Internal client-side and server-side renegotiate problems were fixed.
		
		  Added support for the SHA512 server key exchange hash algorithm.
		  See http://www.chilkatforum.com/questions/10395/sslallowedciphers-options
		
		  (FIXED) The new format of the IMAP-only unlock code unloced IMAP, but not the MailMan object.
		
		  Added the AbortCurrent property to classes that can have event callbacks.
		
		** Version 56
		
		  The SmtpSessionLog is changed to no longer log the 1st 2500 chars of the MIME BODY,
		  but to instead just log the size (number of bytes) of the MIME BODY.
		
		  Added the following methods: Pop3Connect, Pop3Authenticate, and ConnectFailReason.
		  The connect + authenticate has traditionally been a single method call
		  (or something that automatically occurs with the 1st method making a request).
		  The Pop3Connect and Pop3Authenticate methods make it possible for an application
		  to do each step separately, which helps for reporting errors more specifically.
		
		  Added the “base64url” encoding to the list of supported encodings.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		  Added internal workarounds for older POP3 servers that do not support the UIDL command.
		  (It is extremely rare to find a POP3 server that does not support UIDL.)
		
		  The Windows-only SMTPQ related methods were fixed.
		  The SMTPQ methods were working correctly in v9.5.0.54 and earlier,
		  but a problem was inadvertently introduced in v9.5.0.55.
		
		** Version 55
		
		  All Chilkat classes that can do SSL/TLS communications have an SslAllowedCiphers property.
		  This property was enhanced to allow for individual cipher suites to be listed.
		  An application can now explictly list the cipher suites it will accept.
		
		  Enhancement: If the keyword “secureRenegotiate” is included in SslAllowedCiphers, then
		  renegotiating the TLS security parameters MUST be done securely (as per RFC 5746).
		
		  A new Chilkat encoding named “fingerprint” was added. The “fingerprint” encoding
		  is lowercase hex with each byte separated by a colon character.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		  Added TLS pinning functionality. TLS pinning is available for any Chilkat class
		  that communicates via TLS, such as for Socket, Http, Ftp2, MailMan, Imap, etc.
		  All of these classes now have a TlsPinSet property.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added asynchronous functionality for all qualifying methods
		  across all programming languages, operating systems, and architectures.
		  Each Chilkat method that can potentially be time-consuming or involve network communications,
		  now has a corresponding asynchronous version of the method with the name ending in “Async”.
		
		  Added the LastMethodSuccess property.
		
		  Fixed: When the EMail.From is updated, the next email sent did not use it in the MAIL FROM.
		
		  Fixed the VerifySmtpLogin method.
		
		** Version 51
		
		  Applies to any Chilkat class with HTTP proxy capabilities:
		  Fixed issues related to using HTTP proxes for non-HTTP protocols where SSL/TLS is not used.
		
		  128-bit ARC4 is re-enabled by default. Too many sites required it
		  and disabling the algorithm caused too many failures resulting in support issues.
		  The SslAllowedCiphers property can be used to disallow 128-bit ARC4 if needed.
		
		** Version 49
		
		  Added the TlsVersion and TlsCipherSuite properties to Socket, HTTP, Ftp2, MailMan, Imap.
		
		  Added PercentDoneScale property to FTP2, Http, Tar, Zip, SFtp, MailMan, Imap, Upload.
		
		  Added the SmtpPipelining property.
		
		  SHA384/RSA added to TLS 1.2 signature algorithms extension.
		  One particular server required it (but didn’t actually choose the algorithm in the handshake).
		
		  Non-SSL/TLS HTTP proxy connections were trying to use CONNECT.
		
		  Added the AutoUnwrapSecurity property.
		
		  The internal automatic retry from EHLO to HELO did not work.
		  If the SMTP server did not support EHLO, then EHLO
		  was mistakenly tried a 2nd time instead of HELO.
		
		  Added the ClientIpAddress property.
		
		** Version 48
		
		  Added the SslAllowedCiphers property to allow for a comma-separated list o allowed ciphers,
		  in order of preference, to be specified. This property is added to FTP2, MailMan, Imap, Socket,
		  and Http. See the online reference documentation and
		  http://www.chilkatforum.com/questions/7804/ftp2-ssltls-and-ssh-ciphers-freak-attack
		  for more information.
		
		  Chilkat will by-default disallow all possible usage of RSA keys that are less than 1024 bits.
		  To allow for 512 bits or above, add “rsa512” to the list of algorithms in the SslAllowedCiphers list.
		  To allow only 2048 bits or above, add “rsa2048” to the list of algorithms.
		  (Adding “rsa1024” chooses the same as the default.)
		
		  Improved performance through the automatic (internal) use of pipelining.
		
		  Added the MailMan.SmtpConnect and MailMan.SmtpAuthenticate methods so that connecting
		  and authenticating can proceed in two distinct steps instead of a single step.
		  This in combination with the SmtpFailReason property can help applications react more appropriately to errors.
		
		  Added the MailMan.SmtpFailReason property. (See online reference documentation.)
		
		  The MailMan.AutoSmtpRset defaults to false now.
		
		  When using OAuth2 authentication, if the MailMan.SmtpPassword property was unset,
		  then MailMan thought no authentication was necessary.
		  The SmtpPassword property may now be left empty when OAuth2 is used.
		
		** Version 47
		
		  Fixed the “Unsupported server key exchange hash algorithm” error 
		  that could arise when TLS 1.2 was used. (This was somewhat rare.)
		
		  When sending signed + encrypted emails, Chilkat was always using opaque signing for the inner signature.
		  Now MailMan will follow MailMan.OpaqueSigning property. If OpaqueSigning is false,
		  the inner signature will be a detached signature, otherwise it will be signed-data (opaque).
		
		  SendQ2 will now accept a full output file path (meaning path + filename).
		  If only an output directory is indicated, then Chilkat will generate the output filename.
		
		  Fixed a problem w/ TLS 1.2 such that when using client-side certificates (two-way SSL/TLS),
		  the connection handshake failed. (In other words, it was not possible to establish the TLS connection.)
		
		** Version 46
		
		  Chilkat will choose TLS 1.2 for default TLS protocol version, assuming the server supports it.
		  The SslProtocol property, which is common to all classes that communicate via TLS,
		  has been updated to allow for more control over what TLS protcol is used.
		
		** Version 44
		
		  Internal Update: Server Name Indication Extension added for all SSL/TLS connections.
		  This is an internal enhancement/update only. There is no external property or method specific to it.
		
		  Added support for OAuth2 authentication for SMTP and IMAP. The MailMan.OAuth2AccessToken property is new.
		  An OAuth2 access token may be passed in place of the password for the call to Imap.Login.
		  Also added “XOAUTH2” as a valid choice for the Imap.AuthMethod property.
		
		** Version 43
		
		  Fixed crash bug in MailMan relating to sending PKCS7 encrypted email.
		
		** Version 40
		
		  Review the online reference documentation for new methods or properties
		  for Ftp2, TrustedRoots, Rsa, Mime, Cert, Email, Imap, MailMan, Crypt2,
		  Http, Zip, Pfx, XmlCertVault, CertChain, and Upload.
		  New entries are clearly marked by the version in which they are introduced.
		
		** Version 34
		
		  The internal Chilkat SSL/TLS implementation now supports the
		  TLS_DHE_RSA_WITH_AES_256_CBC_SHA and TLS_DHE_RSA_WITH_AES_128_CBC_SHA cipher suites.
		  These allow for perfect forward secrecy. Note: This is implemented
		  on the client-side for all protocols using SSL/TLS.
		  The SSL/TLS client provides the server with a list of algorithms it supports,
		  and it is the server that decides which is to be used.
		  These new algorithms are now included in the list, and will be used if the server chooses.
		
		** Version 30
		
		  Added the mailman.P7mEncryptAttachFilname, P7mSigAttachFilename, P7sSigAttachFilename properties.
		  These properties may be used to set the attachment filenames for signed/encrypted email
		  to something different than the default “smime.p7m” or “smime.p7s”.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE clearbademailaddresses		&& Clears the list of bad email addresses stored within the Mailman object. When an email-sending method is called, any email addresses rejected by the SMTP server will be cached within the Mailman object.
		*==============================================================================
		* Method:            ClearBadEmailAddresses
		* Purpose:           Clears the list of bad email addresses 
		*                    stored within the Mailman object. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Clears the list of bad email addresses stored within the Mailman object. 
		** When an email-sending method is called, any email addresses rejected 
		** by the SMTP server will be cached within the Mailman object. 
		** These can be accessed by calling the GetBadEmailAddresses method. 
		** This method clears the Mailman's in-memory cache of bad addresses.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.ClearBadEmailAddresses()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE clearpop3sessionlog		&& Clears the contents of the Pop3SessionLog property.
		*==============================================================================
		* Method:            ClearPOP3SessionLog
		* Purpose:           Clears the contents of the POP3SessionLog property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Clears the contents of the POP3SessionLog property.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.ClearPOP3SessionLog()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE clearsmtpsessionlog		&& Clears the contents of the SmtpSessionLog property.
		*==============================================================================
		* Method:            ClearSMTP3SessionLog
		* Purpose:           Clears the contents of the POP3SessionLog property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Clears the contents of the SMTP3SessionLog property.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.ClearSMTP3SessionLog()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE clientipaddress_access		&& Access method used to retrieve the Chilkat MailMan ClientIPAddress property.
		*==============================================================================
		* Method:            ClientIPAddress_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan ClientIPAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ClientIPAddress
		* Date Added:        01/06/2022
		*==============================================================================
		
		**
		** The IP address to use for computers with multiple network interfaces or IP addresses. 
		** For computers with a single network interface (i.e. most computers), 
		** this property should not be set. For multihoming computers, the default IP address is 
		** automatically used if this property is not set.
		**
		** The IP address is a string such as in dotted notation using numbers, 
		** not domain names, such as "165.164.55.124".
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

