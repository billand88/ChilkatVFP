	PROCEDURE writeformat		&& Method run to validate the data for the WriteFormat property.
		*==============================================================================
		* Method:            WriteFormat
		* Purpose:           Method run to validate the data for the WriteFormat property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        06/02/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER ;
		AND (NOT EMPTY(m.lcValue)) ;
		AND INLIST(UPPER(ALLTRIM(m.lcValue)), [GNU], [PAX], [USTAR]))
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
		
	ENDPROC

	PROCEDURE x509type		&& Method run to validate the data for the X509Type property.
		*==============================================================================
		* Method:            X509Type
		* Purpose:           Method run to validate the data for 
		*                    the XMLDSigGen X509Type property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
