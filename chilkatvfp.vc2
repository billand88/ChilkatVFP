	PROCEDURE untarfirstmatchingtobd		&& Introduced in version 9.5.0.82. Untars the first file matching the matchPattern into bd. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UnTarFirstMatchingToBd
		* Purpose:           Untars the first file matching the matchPattern into bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTARPath -- the path to the TAR file
		*                    tcMatchPattern -- the pattern to match against.
		*                    toChilkatBinData -- a Chilkat Binary Data object.
		* Returns:           The number of extracted files/directories.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.82
		**
		** Untars the first file matching the matchPattern into bd.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcTARPath AS Character, ;
		tcMatchPattern AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 82
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UnTarFirstMatchingToBd(m.tcTARPath, ;
		        m.tcMatchPattern, m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE untarfirstmatchingtomemory		&& Memory-to-memory untar. The first file matching the matchPattern is extracted and returned. Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            UnTarFirstMatchingToMemory
		* Purpose:           Memory-to-memory untar. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqTARFileBytes -- the path to the TAR file
		*                    tcMatchPattern -- the pattern to match against.
		* Returns:           The memory bytes.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Memory-to-memory untar. The first file matching the matchPattern is extracted and returned.
		** 
		** Fix for version 82: Fixed the method.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		**
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tqTARFileBytes AS VarBinary, tcMatchPattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, ;
		loException AS Exception, lqMemoryBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqMemoryBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqMemoryBytes = ;
		      m.loChilkatObject.UnTarFirstMatchingToMemory(m.tqTARFileBytes, m.tcMatchPattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqMemoryBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE untarfromdir_access		&& Access method used to retrieve the Chilkat TAR UnTarFromDir property.
		*==============================================================================
		* Method:            UnTarFromDir_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat TAR UnTarFromDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnTarFromDir
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** The directory path where files are extracted when untarring. 
		** The default value is ".", meaning that the current working directory 
		** of the calling process is used. If UntarDiscardPaths is set, 
		** then all files are untarred into this directory. 
		** Otherwise, the untar operation will re-create a directory tree rooted in this directory.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE untarfromdir_assign		&& Assign method used to hold a reference to the UnTarFromDir property.
		*==============================================================================
		* Method:            UnTarFromDir_Assign
		* Purpose:           Assign method used to hold a reference to the UnTarFromDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UnTarFromDir property.
		* Returns:           
		* Date Added:        05/07/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE untarfrommemory		&& Extracts the files and directories from an in-memory TAR archive, reconstructing the directory tree(s) in the local filesystem. The files are extracted to the directory specified by the UntarFromDir property.
		*==============================================================================
		* Method:            UnTarFromMemory
		* Purpose:           Extracts the files and directories from an in-memory TAR archive, 
		*                    reconstructing the directory tree(s) in the local filesystem.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqTARFileBytes -- the path to the TAR file
		* Returns:           The number of extracted files/directories.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Extracts the files and directories from an in-memory TAR archive, 
		** reconstructing the directory tree(s) in the local filesystem. 
		** The files are extracted to the directory specified by the UntarFromDir property. 
		** Returns the number of files and directories extracted, or -1 for failure.
		**
		
		LPARAMETERS tqTARFileBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, ;
		loException AS Exception, liExtractions AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liExtractions = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liExtractions = m.loChilkatObject.UnTarFromMemory(m.tqTARFileBytes)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liExtractions
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE untarfrommemoryasync		&& Creates an asynchronous task to call the UntarFromMemory method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            UnTarFromMemoryAsync
		* Purpose:           Extracts the files and directories from an in-memory TAR archive, 
		*                    reconstructing the directory tree(s) in the local filesystem.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqTARFileBytes -- the path to the TAR file
		* Returns:           The number of extracted files/directories.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the UnTarFromMemory method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tqTARFileBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
