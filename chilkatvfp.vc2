		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.FetchEmailAsync(;
		        m.liHeaderOnly, m.tiMessageID, m.liUID, m.loChilkatEMail)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		  
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEmail  = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE fetchflags		&& Fetches the flags for an email. The bUid argument determines whether the msgId is a UID or sequence number. Returns the SPACE separated list of flags set for the email, such as "\Flagged \Seen $label1".
		*==============================================================================
		* Method:            FetchFlags
		* Purpose:           Fetches the flags for an email. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageID -- the message ID of the copied message.
		*                    tuUID -- whether or not the message ID is a UID.
		* Returns:           A space separated list of flags
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Fetches the flags for an email. The bUid argument determines 
		** whether the msgId is a UID or sequence number.
		** 
		** Returns the SPACE separated list of flags set for the email, 
		** such as "\Flagged \Seen $label1".
		** 
		** If an empty string is returned, then it could be that the email referenced 
		** by msgId does not exist in the currently selected mailbox, 
		** or it simply has no flags that are set. To determine the difference, 
		** examine the contents of the LastResponse property. 
		** For the case where the message does not exist, 
		** the LastResponse will contain a "NO" and will look something like this:
		** 
		**   aaah NO The specified message set is invalid.
		** 
		** For the case where the message exists, but no flags are set, 
		** the LastResponse will contain an "OK" in the last response line. For example:
		** 
		**   ...
		**   aaah OK FETCH completed.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiMessageID AS Integer, tuUID AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		loException AS Exception, lcFlags AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		luID = 0
		lcFlags = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUID = .LogicalToBit(m.tuUID)
		
		    TRY
		
		      lcFlags = m.loChilkatObject.FetchFlags(m.tiMessageID, m.liUID)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFlags
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

