	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UnCommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan UnCommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnCommonOptions
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty. 
		**
		** Can be set to a list of the following comma separated keywords:
		**
		** "ProtectFromVpn" - Introduced in v9.5.0.80. 
		**   On Android systems, will bypass any VPN that may be installed or active.
		**
		** "EnableTls13" - Introduced in v9.5.0.82. 
		**    Causes TLS 1.3 to be offered in the ClientHello of the TLS protocol, 
		**   allowing the server to select TLS 1.3 for the session. 
		**
		**   Future versions of Chilkat will enable TLS 1.3 by default. 
		**   This option is only necessary in v9.5.0.82 if TLS 1.3 is desired.
		**
		**   "SmtpLoginAnsi" - Starting in version 97, the SMTP username/password
		**   will now be sent using the utf-8 byte representation instead of ANSI.
		**   To establish prior behavior use the SmtpLoginAnsi keyword.
		**
		** Introduced in version 98: Added the “brainpool_supported_group” UncommonOption 
		** to cause Chilkat to add brainpoolP256r1 to the “supported groups” extension.
		**
		** Introduced in version 99: Client-initiated TLS renegotiation is generally considered a vulnerability, 
		** and Chilkat does not allow it by default. If an application really needs 
		** to enable client-initiated renegotation (which is an extension in the TLS ClientHello, 
		** sent internally by Chilkat), then you can add the keyword “AllowClientInitReneg” 
		** to the UncommonOptions property for any Chilkat function that makes a TLS connection.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property
		*==============================================================================
		* Method:            UnCommonOptions_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat MailMan UnCommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UnCommonOptions property.
		* Returns:           
		* Date Added:        01/13/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		** 
		** Introduced in version 11.5.0: A new AllowExpiredServerCerts keyword has been added to the UncommonOptions property.
		** When this keyword is present, Chilkat will allow connections to servers whose certificates have expired. 
		** This can be useful when working with legacy systems, internal servers, 
		** or test environments where certificate expiration is known and acceptable.
		** 
		** For example:
		** 
		** ftp.UncommonOptions = "AllowExpiredServerCerts";
		** When enabled, certificate expiration alone will not prevent the TLS connection from succeeding.
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		lcValidationMethod = [UnCommonOptions_Mailman]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE useapop_access		&& Access method used to retrieve a reference to the UseAPOP property.
		*==============================================================================
		* Method:            UseAPOP_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan UseAPOP property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UseAPOP
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** If 1, will automatically use APOP authentication if the POP3 server supports it. 
		** The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE useapop_assign		&& Assign method used to hold a reference to the UseAPOP property
		*==============================================================================
		* Method:            UseAPOP_Assign
		* Purpose:           Assign method used to hold a reference to the UseAPOP property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value used 
		*                    to hold a reference to the UseAPOP property.
		* Returns:           
		* Date Added:        01/13/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE usecertvault		&& Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*==============================================================================
		* Method:            UseCertVault
		* Purpose:           Adds an XML certificate vault to the object's internal list 
		*                    of sources to be searched for certificates and private keys.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXMLCertVault, a Chilkat XML Certificate Vault object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Adds an XML certificate vault to the object's internal list of sources 
		** to be searched for certificates and private keys when encrypting/decrypting 
		** or signing/verifying. Unlike the AddPfxSourceData and AddPfxSourceFile methods, 
		** only a single XML certificate vault can be used. 
		** If UseCertVault is called multiple times, only the last certificate vault will be used, 
		** as each call to UseCertVault will replace the certificate vault provided in previous calls.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatXMLCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterXmlCertVault AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXmlCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		       loParkParameterXmlCertVault = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXmlCertVault)
		
		      loChilkatXmlCertVault = m.loParkParameterXmlCertVault.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseCertVault(m.loChilkatXMLCertVault) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatXmlCertVault = m.loParkParameterXmlCertVault.SetObject(;
		      m.toChilkatXmlCertVault, m.loChilkatXmlCertVault)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatXMLCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loParkParameterXmlCertVault = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXmlCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE usessh		&& Uses an existing SSH tunnel for the connections to the POP3 andSMTP servers. This method is identical to the UseSshTunnel method, except the SSH connection is obtained from an SSH object instead of a Socket object.
		*==============================================================================
		* Method:            UseSSH
		* Purpose:           Uses an existing SSH tunnel for the connections to the POP3 and SMTP servers.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSSH, a Chilkat SSH object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** Uses an existing SSH tunnel for the connections to the POP3 and SMTP servers. 
		** This method is identical to the UseSshTunnel method, except the SSH connection 
		** is obtained from an SSH object instead of a Socket object.
		**
		** Uses an existing SSH tunnel. 
		** This is useful for sharing an existing SSH tunnel connection wth other objects. 
		** (SSH is a protocol where the tunnel contains many logical channels. 
		** SMTP and POP3 connections can exist simultaneously within a single SSH tunnel as SSH channels.)
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSSH AS CHILKAT_SSH_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, luReturn AS Unknown, liReturn AS Integer, ;
		loParkParameterSsh AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSsh AS CHILKAT_SSH_COM_CALL liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterSsh, m.loChilkatSsh
		
		llImplemented = .F.
		liIntroducedInBuild = 55
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSsh = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSsh)
		
		      loChilkatSsh = m.loParkParameterSsh.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseSSH(m.loChilkatSSH) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSsh = m.loParkParameterSsh.SetObject(m.toChilkatSsh, m.loChilkatSsh)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterSsh, m.loChilkatSsh
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatSSH = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loParkParameterSsh = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSsh = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

