	PROCEDURE getstorageproviders		&& Introduced in version 9.5.0.83. Loads json with a list of storage providers on the Windows system.
		*==============================================================================
		* Method:            GetStorageProviders
		* Purpose:           Loads json with a list of storage providers on the Windows system.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON Object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Loads json with a list of storage providers on the Windows system.
		**
		** The json will contain JSON such as this:
		** 
		**   {
		**     "cng": [
		**       "Microsoft Software Key Storage Provider",
		**       "Microsoft Passport Key Storage Provider",
		**       "Microsoft Platform Crypto Provider",
		**       "Microsoft Smart Card Key Storage Provider"
		**     ],
		**     "legacy": [
		**       "Microsoft Base Cryptographic Provider v1.0",
		**       "Microsoft Base DSS and Diffie-Hellman Cryptographic Provider",
		**       "Microsoft Base DSS Cryptographic Provider",
		**       "Microsoft Base Smart Card Crypto Provider",
		**       "Microsoft DH SChannel Cryptographic Provider",
		**       "Microsoft Enhanced Cryptographic Provider v1.0",
		**       "Microsoft Enhanced DSS and Diffie-Hellman Cryptographic Provider",
		**       "Microsoft Enhanced RSA and AES Cryptographic Provider",
		**       "Microsoft RSA SChannel Cryptographic Provider",
		**       "Microsoft Strong Cryptographic Provider"
		**     ]
		**   }
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJSONObject AS [Chilkat_9_5_0.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.KeyContainer], ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS [Chilkat_9_5_0.JsonObject], ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetStorageProviders(m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.KeyContainer])
		  toChilkatJSONObject = NEWOBJECT([Chilkat_9_5_0.JsonObject])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT([Chilkat_9_5_0.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE importkey		&& Introduced in version 9.5.0.83. Imports a new key into the storageProvider. If allowOverwrite is 1, if a key already exists in the container with the specified name, the existing key will be overwritten.
		*==============================================================================
		* Method:            ImportKey
		* Purpose:           Imports a new key into the storageProvider. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyName, the key name to export
		*                    tcStorageProvider, the key storage provider.
		*                    tuAllowOverWrite, whether or not to allow 
		*                    the key to be overwritten.
		*                    tuAllowExportable, whether or not the key can be exported.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Imports a new key into the storageProvider. If allowOverwrite is 1, 
		** if a key already exists in the container with the specified name, 
		** the existing key will be overwritten. If allowOverwrite is 0 and the key already exists, 
		** then the method fails. If allowExport is 1, then the key is marked as exportable, 
		** which allows for it to be re-exported to a PFX.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcKeyName AS Character, tcStorageProvider AS Character, ;
		tuAllowOverWrite AS Unknown, tuAllowExportable AS Unknown, ;
		toChilkatPrivateKey AS [Chilkat_9_5_0.PrivateKey]
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.KeyContainer], ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS [Chilkat_9_5_0.PrivateKey], ;
		luReturn AS Unknown, liAllowOverWrite AS Integer, ;
		llAllowExportable AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liAllowOverWrite, ;
		m.llAllowExportable, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liAllowOverWrite = .LogicalToBit(m.tuAllowOverWrite)
		      liAllowExportable = .LogicalToBit(m.tuAllowExportable)
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ImportKey(m.tcKeyName, m.tcStorageProvider, ;
		        m.liAllowOverWrite, m.liAllowExportable, m.loChilkatPrivateKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.KeyContainer])
		  toChilkatPrivateKey = NEWOBJECT([Chilkat_9_5_0.PrivateKey])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT([Chilkat_9_5_0.PrivateKey])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

