		RETURN
	ENDPROC

	HIDDEN PROCEDURE numsocketsinset_access		&& Access method used to retrieve the Chilkat Socket NumSocketsInSet property.
		*==============================================================================
		* Method:            NumSocketsInSet_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket NumSocketsInSet property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumSocketsInSet
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** If this socket is a "socket set", then NumSocketsInSet returns 
		** the number of sockets contained in the set. 
		** A socket object can become a "socket set" by calling the TakeSocket method 
		** on one or more connected sockets. 
		** This makes it possible to select for reading on the set 
		** (i.e. wait for data to arrive from any one of multiple sockets). 
		** See the following methods and properties for more information: 
		** TakeSocket, SelectorIndex, SelectorReadIndex, SelectorWriteIndex, 
		** SelectForReading, SelectForWriting.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

