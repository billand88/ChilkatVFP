	PROCEDURE obtainaccesstoken		&& Introduced in version 9.5.0.58. Sends the HTTP request to fetch the access token. When this method completes successfully, the access token is available in the AccessToken property. The connection is an existing connection to www.googleapis.com.
		*==============================================================================
		* Method:            ObtainAccessToken
		* Purpose:           Sends the HTTP request to fetch the access token.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSocket, a Chilkat Socket object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Sends the HTTP request to fetch the access token. 
		** When this method completes successfully, the access token is available 
		** in the AccessToken property. The connection is an existing connection to www.googleapis.com.
		**
		** Important: Make sure your computer's date/time is accurately set to the current date/time, 
		** otherwise you'll get a 400 response status code with this error: 
		** "Invalid JWT: Token must be a short-lived token (60 minutes) and in a reasonable timeframe. 
		** Check your iat and exp values and use a clock with skew to account 
		** for clock differences between systems.".
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_AUTHGOOGLE_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSocket)
		
		      loChilkatSocket = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ObtainAccessToken(m.loChilkatSocket) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSocket = ;
		      m.loParkParameterSocket.SetObject(m.toChilkatSocket, m.loChilkatSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_AUTHGOOGLE_COM_CALL)
		  toChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE obtainaccesstokenasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the ObtainAccessToken method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            ObtainAccessTokenAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    ObtainAccessToken method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSocket, a Chilkat Socket object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		** 
		** Creates an asynchronous task to call the ObtainAccessToken method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure.
		**
		
		LPARAMETERS toChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_AUTHGOOGLE_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL, loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatTask, m.loParkParameterSocket, m.loChilkatSocket 
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSocket)
		
		      loChilkatSocket = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.ObtainAccessTokenAsync(m.loChilkatSocket)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSocket = ;
		      m.loParkParameterSocket.SetObject(m.toChilkatSocket, m.loChilkatSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_AUTHGOOGLE_COM_CALL)
		  toChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

