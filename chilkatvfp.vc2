	HIDDEN PROCEDURE snihostname_access		&& Access method used to retrieve the Chilkat HTTP SNIHostName property.
		*==============================================================================
		* Method:            SNIHostName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP SNIHostName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SNIHostName
		* Date Added:        01/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.82
		** 
		** Specifies the SNI hostname to be used in the TLS ClientHello. 
		** This property is only needed when the domain 
		** is specified via a dotted IP address and an SNI hostname is desired. 
		** (Normally, Chilkat automatically uses the domain name 
		** in the SNI hostname TLS ClientHello extension.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 82
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE snihostname_assign		&& Assign method used to hold a reference to the SNIHostName property.
		*==============================================================================
		* Method:            SNILogFileName_Assign
		* Purpose:           Assign method used to hold a reference to the SNILogFileName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SNILogFileName property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 82
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sockshostname_access		&& Access method used to retrieve the Chilkat HTTP SOCKSHostName property.
		*==============================================================================
		* Method:            SOCKSHostName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP SOCKSHostName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SOCKSHostName
		* Date Added:        01/28/2022
		*==============================================================================
		
		** 
		** The SOCKS4/SOCKS5 hostname or IPv4 address (in dotted decimal notation). 
		** This property is only used if the SocksVersion property is set to 4 or 5).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sockshostname_assign		&& Assign method used to hold a reference to the SOCKSHostName property.
		*==============================================================================
		* Method:            SOCKSHostName_Assign
		* Purpose:           Assign method used to hold a reference to the SOCKSHostName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SOCKSHostName property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sockspassword_access		&& Access method used to retrieve the Chilkat HTTP SOCKSPassword property.
		*==============================================================================
