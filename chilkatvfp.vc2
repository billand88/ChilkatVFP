		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Upload LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Upload LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Upload LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Upload LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Upload LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Upload LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: login_access		&& Access method used to retrieve the Chilkat Upload Login property.
		*m: login_assign		&& Assign method used to hold a reference to the Login property.
		*m: numbytessent_access		&& Access method used to retrieve the Chilkat Upload NumBytesSent property.
		*m: numbytessent_assign		&& Assign method used to hold a reference to the NumBytesSent property.
		*m: password_access		&& Access method used to retrieve the Chilkat Upload Password property.
		*m: password_assign		&& Assign method used to hold a reference to the Password property.
		*m: path_access		&& Access method used to retrieve the Chilkat Upload Path property.
		*m: path_assign		&& Assign method used to hold a reference to the Path property.
		*m: percentdonescale_access		&& Access method used to retrieve the Chilkat Upload PercentDoneScale property.
		*m: percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*m: percentuploaded_access		&& Access method used to retrieve the Chilkat Upload PercentUploaded property.
		*m: percentuploaded_assign		&& Assign method used to hold a reference to the PercentUploaded property.
		*m: port_access		&& Access method used to retrieve the Chilkat Upload Port property.
		*m: port_assign		&& Assign method used to hold a reference to the Port property.
		*m: preferipv6_access		&& Access method used to retrieve the Chilkat Upload PreferIPV6 property.
		*m: preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*m: proxydomain_access		&& Access method used to retrieve the Chilkat Upload ProxyDomain property.
		*m: proxydomain_assign		&& Assign method used to hold a reference to the ProxyDomain property.
		*m: proxylogin_access		&& Access method used to retrieve the Chilkat Upload ProxyLogin property.
		*m: proxylogin_assign		&& Assign method used to hold a reference to the ProxyLogin property.
		*m: proxypassword_access		&& Access method used to retrieve the Chilkat Upload ProxyPassword property.
		*m: proxypassword_assign		&& Assign method used to hold a reference to the ProxPassword property.
		*m: proxyport_access		&& Access method used to retrieve the Chilkat Upload ProxyPort property.
		*m: proxyport_assign		&& Assign method used to hold a reference to the ProxPort property.
		*m: responsebodystr_access		&& Access method used to retrieve the Chilkat Upload ResponseBodyStr property.
		*m: responsebodystr_assign		&& Assign method used to hold a reference to the ResponseBodyStr property.
		*m: responsebody_access		&& Access method used to retrieve the Chilkat Upload ResponseBody property.
		*m: responsebody_assign		&& Assign method used to hold a reference to the ResponseBody property.
		*m: responseheader_access		&& Access method used to retrieve the Chilkat Upload ResponseHeader property.
		*m: responseheader_assign		&& Assign method used to hold a reference to the ResponseHeader property.
		*m: responsestatus_access		&& Access method used to retrieve the Chilkat Upload ResponseStatus property.
		*m: responsestatus_assign		&& Assign method used to hold a reference to the ResponseStatus property.
		*m: sleepms		&& A convenience method for putting the calling process to sleep for N milliseconds.
		*m: sslallowedciphers_access		&& Access method used to retrieve the Chilkat Upload SSLAllowedCiphers property.
		*m: sslallowedciphers_assign		&& Assign method used to hold a reference to the SSLAllowedCiphers property.
		*m: sslprotocol_access		&& Access method used to retrieve the Chilkat Upload SSLProtocol property.
		*m: sslprotocol_assign		&& Assign method used to hold a reference to the SSLProtocol property.
		*m: ssl_access		&& Access method used to retrieve the Chilkat Upload SSL property.
		*m: ssl_assign		&& Assign method used to hold a reference to the SSL property.
		*m: tlspinset_access		&& Access method used to retrieve the Chilkat Upload TLSPinSet property.
		*m: tlspinset_assign		&& Assign method used to hold a reference to the TLSPinSet property.
		*m: totaluploadsize_access		&& Access method used to retrieve the Chilkat Upload TotalUploadSize property.
		*m: totaluploadsize_assign		&& Assign method used to hold a reference to the TotalUploadSize property.
		*m: uploadinprogress_access		&& Access method used to retrieve the Chilkat Upload UploadProgress property.
		*m: uploadinprogress_assign		&& Assign method used to hold a reference to the UploadProgress property.
		*m: uploadsuccess_access		&& Access method used to retrieve the Chilkat Upload UploadSuccess property.
		*m: uploadsuccess_assign		&& Assign method used to hold a reference to the UploadSuccess property.
		*m: uploadtomemory		&& Writes the complete HTTP POST to memory. The POST contains the HTTP header, any custom params added by calling AddParam, and each file to be uploaded.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Upload VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: bandwidththrottleup		&& Introduced in version 9.5.0.49. If non-zero, limits (throttles) the upload bandwidth to approximately this maximum number of bytes per second. The default value of this property is 0.
		*p: chunksize		&& The chunk size (in bytes) used by the underlying TCP/IP sockets for uploading files. The default value is 65535.
		*p: clientipaddress		&& Introduced in version 9.5.0.49. The IP address to use for computers with multiple network interfaces or IP addresses.
		*p: currentfilename		&& Introduced in version 9.5.0.90. The current filename being uploaded while an asynchronous upload is in progress.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: expect100continue		&& When 1, the request header will included an "Expect: 100-continue" header field. This indicates that the server should respond with an intermediate response of "100 Continue" or "417 Expectation Failed" response.
		*p: heartbeatms		&& This property is only valid in programming environment and languages that allow for event callbacks. Specifies the time interval in milliseconds between AbortCheck events.
		*p: hostname		&& The hostname of the HTTP server that is the target of the upload. Do not include "http://" in the hostname. It can be a hostname, such as "www.chilkatsoft.com", or an IP address, such as "168.144.70.227".
		*p: idletimeoutms		&& A timeout in milliseconds. The default value is 30000. If the upload hangs (i.e. progress halts) for more than this time, the component will abort the upload. (It will timeout.)
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: login		&& The HTTP login for sites requiring authentication. Chilkat Upload supports Basic HTTP authentication.
		*p: numbytessent		&& After an upload has completed, this property contains the number of bytes sent. During asynchronous uploads, this property contains the current number of bytes sent while the upload is in progress.
		*p: password		&& The HTTP password for sites requiring authentication. Chilkat Upload supports Basic HTTP authentication.
		*p: path		&& The path part of the upload URL.
		*p: percentdonescale		&& Introduced in version 9.5.0.49. This property is only valid in programming environment and languages that allow for event callbacks. Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks.
		*p: percentuploaded		&& Contains the current percentage completion (0 to 100) while an asynchronous upload is in progress.
		*p: port		&& The port number of the upload target (i.e. consumer) URL. The default value is 80. If SSL is used, this should be set to 443 (typically).
		*p: preferipv6		&& If 1, then use IPv6 over IPv4 when both are supported for a particular domain. The default value of this property is 0, which will choose IPv4 over IPv6.
		*p: proxydomain		&& The domain name of a proxy host if an HTTP proxy is used. Do not include the "http://". The domain name may be a hostname, such as "www.chilkatsoft.com", or an IP address, such as "168.144.70.227".
		*p: proxylogin		&& If an HTTP proxy is used and it requires authentication, this property specifies the HTTP proxy login.
		*p: proxypassword		&& If an HTTP proxy is used and it requires authentication, this property specifies the HTTP proxy password.
		*p: proxyport		&& The port number of a proxy server if an HTTP proxy is used.
		*p: responsebody		&& An HTTP upload is nothing more than an HTTP POST that contains the content of the files being uploaded. Just as with any HTTP POST or GET, the server should send an HTTP response that consists of header and body.
		*p: responsebodystr		&& Introduced in version 9.5.0.83. Returns the response body as a string.
		*p: responseheader		&& An HTTP upload is nothing more than an HTTP POST that contains the content of the files being uploaded. Just as with any HTTP POST or GET, the server should send an HTTP response that consists of header and body.
		*p: responsestatus		&& The HTTP response status code of the HTTP response.
		*p: ssl		&& Set this to 1 if the upload is to HTTPS. For example, if the target of the upload is: https://www.myuploadtarget.com/consumeUpload.asp then set: Ssl = 1 Hostname = "www.myuploadtarget.com" Path = "/consumeupload.asp" Port = 443
		*p: sslallowedciphers		&& Introduced in version 9.5.0.55. Provides a means for setting a list of ciphers that are allowed for SSL/TLS connections. The default (empty string) indicates that all implemented ciphers are possible.
		*p: sslprotocol		&& Introduced in version 9.5.0.55. Selects the secure protocol to be used for secure (SSL/TLS) connections.
		*p: tlspinset		&& Introduced in version 9.5.0.55. Specifies a set of pins for Public Key Pinning for TLS connections. This property lists the expected SPKI fingerprints for the server certificates.
		*p: totaluploadsize		&& The total size of the upload (in bytes). This property will become set at the beginning of an asynchronous upload. A program may monitor asynchronous uploads by tracking both NumBytesSent and PercentUploaded.
		*p: uploadinprogress		&& Set to 1 when an asynchronous upload is started. When the asynchronous upload is complete, this property becomes equal to 0.
		*p: uploadsuccess		&& Set to 1 (success) or 0 (failed) after an asynchronous upload completes or aborts due to failure. When a program does an asynchronous upload, it will wait until UploadInProgress becomes 0.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	HIDDEN lastbinaryresult
	*<PropValue>
		abortcurrent = 0
		bandwidththrottleup = 0
		cchilkatclass = Upload
		ceventhandlerclass = iBaseEventHandler
		chunksize = 65535
		clientipaddress = 
		currentfilename = 
		debuglogfilepath = 
		expect100continue = 1
		heartbeatms = 0
		hostname = 
		idletimeoutms = 30000
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		login = 
		Name = "upload"
		numbytessent = 0
		password = 
		path = 
		percentdonescale = 100
		percentuploaded = 0
		port = 80
