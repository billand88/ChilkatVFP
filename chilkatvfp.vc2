	PROCEDURE readrespbodystream		&& Introduced in version 9.5.0.58. Reads the response body to the stream. If autoSetStreamCharset is 1, then the stream's StringCharset property will automatically get set based on the charset, if any, indicated in the response header
		*==============================================================================
		* Method:            ReadRespBodyStream
		* Purpose:           Reads the response body to the stream.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStream, a Chilkat Stream object.
		*                    tuAutoStreamCharset, whether or not to automatically set the charset.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Reads the response body to the stream. 
		** If autoSetStreamCharset is 1, then the stream's StringCharset property 
		** will automatically get set based on the charset, if any, indicated in the response header. 
		** If the response is binary, then autoSetStreamCharset is ignored.
		**
		** Fix for version 79: The method immediately failed if the download was larger than 4GB.
		**
		** Fix for version 11.6.0: Fixed a spurious read failure when downloading a response body 
		** into a Stream and reading it on another thread. After the full body was received, 
		** EndOfStream could remain false, so a loop on EndOfStream 
		** made one extra read that failed. Now EndOfStream becomes true 
		** once the body is delivered and consumed, and a read at the very end 
		** returns success with no bytes rather than an error. No code changes required.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStream AS CHILKAT_STREAM_COM_CALL, ;
		tuAutoStreamCharset AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterStream AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStream AS CHILKAT_STREAM_COM_CALL, luReturn AS Unknown, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		liAutoStreamCharset AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liAutoStreamCharset, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liAutoStreamCharset = .LogicalToBit(m.tuAutoStreamCharset)
		
		      loParkParameterStream = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStream)
		
		      loChilkatStream = m.loParkParameterStream.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ReadRespBodyStream(m.loChilkatStream, ;
		        m.liAutoStreamCharset) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStream = ;
		      m.loParkParameterStream.SetObject(m.toChilkatStream, m.loChilkatStream)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  toChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loParkParameterStream = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

