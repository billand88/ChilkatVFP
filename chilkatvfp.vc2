	ENDPROC

	HIDDEN PROCEDURE localhost_access		&& Access method used to retrieve the Chilkat oAuth2 LocalHost property.
		*==============================================================================
		* Method:            LocalHost_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat oAuth2 LocalHost property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LocalHost
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		**
		** Defaults to "localhost". This should typically remain at the default value. 
		** It is the loopback domain or IP address used for the redirect_uri. 
		** For example, "http://localhost:2012/". 
		** (assuming 2012 was used or randomly chosen as the listen port number) 
		** If the desired redirect_uri is to be "http://127.0.0.1:2012/", 
		** then set this property equal to "127.0.0.1".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
