	PROCEDURE compressfile		&& Compresses a file to create a GZip compressed file (.gz). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CompressFile
		* Purpose:           Compresses a file to create a GZip compressed file (.gz).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to compress
		*                    tcDestinationPath -- the destination path for the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Compresses a file to create a GZip compressed file (.gz).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFileName AS Character, tcDestinationPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CompressFile(m.tcFileName, m.tcDestinationPath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE compressfile2		&& Compresses a file to create a GZip compressed file (.gz). inFilename is the actual filename on disk. embeddedFilename is the filename to be embedded in the .gz such that when it is un-gzipped, this is the name of the file that will be created.
