	PROCEDURE exportkey		&& Introduced in version 9.5.0.83. Exports a key into key. If silentFlag is 1, requests that the key service provider (KSP) not display any user interface. If the provider must display the UI to operate, the call fails. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ExportKey
		* Purpose:           Exports a key into key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyName, the key name to export
		*                    tcStorageProvider, the key storage provider.
		*                    tuSilentFlag, whether or not the export is silent.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Exports a key into key. If silentFlag is 1, requests that the key service provider 
		** (KSP) not display any user interface. If the provider must display the UI to operate, 
		** the call fails.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcKeyName AS Character, tcStorageProvider AS Character, ;
		tuSilentFlag AS Unknown, toChilkatPrivateKey AS [Chilkat_9_5_0.PrivateKey]
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.KeyContainer], ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS [Chilkat_9_5_0.PrivateKey], ;
		luReturn AS Unknown, liSilentFlag AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liSilentFlag, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSilentFlag = .LogicalToBit(m.tuSilentFlag)
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ExportKey(m.tcKeyName, m.tcStorageProvider, ;
		        m.liSilentFlag, m.loChilkatPrivateKey) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.KeyContainer])
		  toChilkatPrivateKey = NEWOBJECT([Chilkat_9_5_0.PrivateKey])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT([Chilkat_9_5_0.PrivateKey])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

