	HIDDEN PROCEDURE asyncsendfinished_access		&& Access method used to retrieve the Chilkat Socket AsyncSendFinished property.
		*==============================================================================
		* Method:            AsyncSendFinished_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket AsyncSendFinished property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AsyncSendFinished
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Undocumented property! 
		**
		** Set to true when an asynchronous send operation completes. Once the
		** asynchronous send has finished, the success/failure is available in the
		** AsyncSendSuccess boolean property.
		** 
		** This functionality is replaced by the new model for asynchronous programming
		** introduced in Chilkat v9.5.0.52. Applications should use the new model, which is
		** identified by methods having names ending with "Async" and return a task object.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [LongBitReadOnly]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 1
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test  
	ENDPROC

