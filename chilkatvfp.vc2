	PROCEDURE getlastjsondata		&& Introduced in version 11.5.0. Provides details about the last method called on this object instance. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetLastJsonData
		* Purpose:           Provides details about the last method called on this object instance. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           
		* Date Added:        06/02/2026
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Provides details about the last method called on this object instance. 
		** While many methods do not generate information, 
		** some allow you to retrieve details by accessing the last JSON data 
		** immediately after the method call returns.
		** 
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterMailMan AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMailMan, m.loChilkatJSONObject
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterMailMan = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterMailMan.GetObject()
		
		      TRY
		
		        m.loChilkatObject.GetLastJsonData(m.loChilkatJSONObject)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterMailMan.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMailMan, m.loChilkatJSONObject
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterMailMan = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getlastmoddt		&& Returns the last modified date/time for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1). Returns Nothing on failure.
		*==============================================================================
		* Method:            GetLastModDt
		* Purpose:           Returns the last modified date/time for the Nth file 
		*                    or sub-directory in the current remote directory.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the related remote directory array value.
		* Returns:           Chilkat Date/Time Object, or NULL
		* Date Added:        03/03/2022
		*==============================================================================
		
		**
		** Returns the last modified date/time for the Nth file 
		** or sub-directory in the current remote directory. 
		** The first file/dir is at index 0, and the last one is at index (GetDirCount()-1)
		**
		** Fixed in version 65: This method will return the current date/time instead of NULL for failure.
		** The method now correctly will return NULL (i.e. 0, null, Nothing, etc.)
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
