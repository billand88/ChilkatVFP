	HIDDEN PROCEDURE forceportipaddress_access		&& Access method used to retrieve the Chilkat ForceIPAddress property.
		*==============================================================================
		* Method:            ForcePortIPAddress_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 ForcePortIPAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ForcePortIPAddress
		* Date Added:        02/24/2022
		*==============================================================================
		
		** 
		** If set, forces the IP address used in the PORT command for Active mode (i.e. non-passive) data transfers. 
		** This string property should be set to the IP address in dotted notation, such as "233.190.65.31".
		**
		** Note: This property can also be set to the special keyword "control" to force 
		** the PORT IP address to be the address of the control connection's peer.
		**
		** Starting in v9.5.0.58, the IP address can be prefixed with the string "bind-". 
		** For example, "bind-233.190.65.31". When "bind-" is specified, 
		** the local data socket will be bound to the IP address when created. 
		** Otherwise, the IP address is only used as the argument to the PORT command that is sent to the server.
		**
		** Similar... Version 58: Regarding the ForceIpAddress property: By default, Chilkat will NOT try to bind 
		** the data socket to the IP address specified by the ForceIpAddress property.
		** You may use a special “bind-” prefix in the ForceIpAddress property to cause the data socket 
		** to be bound to the ForceIpAddress property. For example, put_ForceIpAddress(“bind-80.130.210.228”)
		**
		** There was an undocumented feature where you can set the ForceIpAddress property equal to the keyword “control”. 
		** In this case, the IP address of the control connection is used. Also, Chilkat will now recognize 
		** the error message “I won’t open a connection to…”, and will automatically retry 
		** using the IP address from the message.
		** 
		** Enhancement for Version 10: Internally, when binding a socket for listening 
		** (such as listening for the OAuth2 callback), 
		** Chilkat now binds to 127.0.0.1 instead of 0.0.0.0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE forceportipaddress_assign		&& Assign method used to hold a reference to the ForceIPAddress property.
		*==============================================================================
		* Method:            ForcePortIPAddress_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat FTP2 ForcePortIPAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ForcePortIPAddress property.
		* Returns:           
		* Date Added:        02/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [ForcePortIPAddress]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE getcreatedt		&& Returns the create date/time for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1). Returns Nothing on failure
		*==============================================================================
		* Method:            GetCreateDt
		* Purpose:           Returns the create date/time for the Nth file 
		*                    or sub-directory in the current remote directory. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the index for the subdirectory.
		* Returns:           Chilkat Date/Time Object, or NULL
		* Date Added:        03/02/2022
		*==============================================================================
		
		**
		** Returns the create date/time for the Nth file or sub-directory in the current remote directory. 
		** The first file/dir is at index 0, and the last one is at index (GetDirCount()-1)
		**
		** Fixed in version 65: This method will return the current date/time instead of NULL for failure.
		** The method now correctly will return NULL (i.e. 0, null, Nothing, etc.)
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCkDateTime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      loChilkatCkDateTime = m.loChilkatObject.GetCreateDt(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCkDateTime
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

