	PROCEDURE copymultiple		&& Same as the Copy method, except an entire set of emails is copied at once. The set of emails is specified in messageSet. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CopyMultiple
		* Purpose:           Same as the Copy method, 
		*                    except an entire set of emails is copied at once.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatMessageSet -- a Chilkat Message Set object.
		*                    tcToMailBox -- the mailbox name to receive the message.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Same as the Copy method, except an entire set of emails is copied at once. 
		** The set of emails is specified in messageSet.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, ;
		tcToMailBox AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterMessageSet AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterMessageSet = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		    loChilkatMessageSet = m.loParkParameterMessageSet.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.CopyMultiple(m.loChilkatMessageSet, ;
		      m.tcToMailBox) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatMessageSet = ;
		    m.loParkParameterMessageSet.SetObject(m.toChilkatMessageSet, m.loChilkatMessageSet)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loParkParameterMessageSet = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

