		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS url AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides an object representation of a URL and easy access to the parts of the URL.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat URL DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: frag_access		&& Access method used to retrieve the Chilkat URL Frag property.
		*m: frag_assign		&& Assign method used to hold a reference to the Frag property.
		*m: hosttype_access		&& Access method used to retrieve the Chilkat URL HostType property.
		*m: hosttype_assign		&& Assign method used to hold a reference to the HostType property.
		*m: host_access		&& Access method used to retrieve the Chilkat URL Host property.
		*m: host_assign		&& Assign method used to hold a reference to the Host property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat URL LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat URL LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat URL LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat URL LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: login_access		&& Access method used to retrieve the Chilkat URL Login property.
		*m: login_assign		&& Assign method used to hold a reference to the Login property.
		*m: parseurl		&& Introduced in version 9.5.0.49. Parses a full URL. After parsing, the various parts of the URL are available iin the properties. Returns 1 for success, 0 for failure.
		*m: password_access		&& Access method used to retrieve the Chilkat URL Password property.
		*m: password_assign		&& Assign method used to hold a reference to the Password property.
		*m: pathwithqueryparams_access		&& Access method used to retrieve the Chilkat URL PathWithQueryParams property.
		*m: pathwithqueryparams_assign		&& Assign method used to hold a reference to the PathWithQueryParams property.
		*m: path_access		&& Access method used to retrieve the Chilkat URL Path property.
		*m: path_assign		&& Assign method used to hold a reference to the Path property.
		*m: port_access		&& Access method used to retrieve the Chilkat URL Port property.
		*m: port_assign		&& Assign method used to hold a reference to the Port property.
		*m: scheme_access		&& Access method used to retrieve the Chilkat URL Scheme property.
		*m: scheme_assign		&& Assign method used to hold a reference to the Scheme property.
		*m: ssl_access		&& Access method used to retrieve the Chilkat URL SSL property.
		*m: ssl_assign		&& Assign method used to hold a reference to the SSL property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: frag		&& Introduced in version 9.5.0.49. Contains any text following a fragment marker (#) in the URL, excluding the fragment marker. Given the URI http://www.contoso.com/index.htm#main, the fragment is "main".
		*p: host		&& Introduced in version 9.5.0.49.The DNS host name or IP address part of the URL. For example, if the URL is "http://www.contoso.com:8080/", the Host is "www.contoso.com". If the URL is "https://192.168.1.124/test.html", the Host is "192.168.1.124".
		*p: hosttype		&& Introduced in version 9.5.0.49. The type of the host name specified in the URL.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: login		&& Introduced in version 9.5.0.49. If the URL contains a login and password, this is the login part. For example, if the URL is "http://user:password@www.contoso.com/index.htm ", then the login is "user".
		*p: password		&& Introduced in version 9.5.0.49. If the URL contains a login and password, this is the password part. For example, if the URL is "http://user:password@www.contoso.com/index.htm ", then the password is "password".
		*p: path		&& Introduced in version 9.5.0.49. The path (and params) part of the URL, excluding the query and fragment.
		*p: pathwithqueryparams		&& Introduced in version 9.5.0.58. The path (and params) part of the URL, including the query params, but excluding the fragment.
		*p: port		&& Introduced in version 9.5.0.49. The port number of the URL. For example, if the URL is "http://www.contoso.com:8080/", the port number is 8080. If the URL is "https://192.168.1.124/test.html", the port number is the default 80.
		*p: scheme		&& Introduced in version 11.6.0. The scheme part of the URL. For example, if the URL is https://www.contoso.com:8080/, the Scheme is https.
		*p: ssl		&& Introduced in version 9.5.0.49. 1 if the URL indicates SSL/TLS, otherwise false. A URL beginning with "https://" indicates SSL/TLS.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Url
		debuglogfilepath = 
		frag = 
		host = 
		hosttype = 
		iinstancepatch = 49
		lastbinaryresult = .NULL.
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		login = 
		Name = "url"
		password = 
		path = 
		pathwithqueryparams = 
		port = 
		scheme = 
		ssl = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/07/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  Added the Scheme property 
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 49
		
		  Added the Chilkat.Url class.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat URL DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Stream DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/09/2026
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat URL DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/09/2026
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

