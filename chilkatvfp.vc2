	PROCEDURE prefetchpublickey		&& Useful if your application is going to verify many emails from a single domain (or a few domains). This eliminates the need to do a DNS lookup to fetch the public key each time an email's DKIM or DomainKey signature is verified.
		*==============================================================================
		* Method:            PreFetchPublicKey
		* Purpose:           Useful if your application is going to verify many emails 
		*                    from a single domain (or a few domains).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSelector, a DKIM selector value.
		*                    tcDomain, a DKIM domain value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Useful if your application is going to verify many emails 
		** from a single domain (or a few domains). This eliminates the need to do 
		** a DNS lookup to fetch the public key each time an email's DKIM 
		** or DomainKey signature is verified.
		** 
		** This method may be called multiple times -- once for each selector/domain 
		** to be pre-fetched. The verify methods (VerifyDkimSignature and VerifyDomainKeySignature) 
		** will use a pre-fetched key if the selector and domain match.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSelector AS Character, tcDomain AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DKIM_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.PreFetchPublicKey(m.tcSelector, m.tcDomain) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DKIM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

