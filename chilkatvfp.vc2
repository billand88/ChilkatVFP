	PROCEDURE s3_downloadbd		&& The same as DownloadFile, except the downloaded file data is appended to bd. Note: If the bucket is in a region different than us-east-1, makes sure to set the AwsEndpoint property to the correct region, such as "eu-central-1".
		*==============================================================================
		* Method:            S3_DownloadBd
		* Purpose:           The same as DownloadFile, except the downloaded file data is appended to bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBucketPath -- the Amazon S3 bucket path.
		*                    tcObjectName -- the object to download.
		*                    toChilkatBinData, a Chilkat binary data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** The same as DownloadFile, except the downloaded file data is appended to bd.
		**
		** Note: If the bucket is in a region different than us-east-1, 
		** makes sure to set the AwsEndpoint property to the correct region, such as "eu-central-1". 
		** Also, if using an S3 compatible service such as Wasabi, always set the AwsEndpoint property. 
		** For example: "s3.wasabisys.com", "s3.eu-central-1.wasabisys.com".
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcBucketPath AS Character, tcObjectName AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.S3_DownloadBd(m.tcBucketPath, ;
		        m.tcObjectName, m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
