		** 
		** -----END RSA PRIVATE KEY-----
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tuEncrypt AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, ;
		loException AS Exception, lcString AS Character, liEncrypt AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liEncrypt = 0
		lcString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liEncrypt = .LogicalToBit(m.tuEncrypt)
		
		    TRY
		 
		      lcString = m.loChilkatObject.ToOpenSSHPrivateKey(m.liEncrypt)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE toopensshpublickey		&& Exports the public key to a string in OpenSSH format.
		*==============================================================================
		* Method:            ToOpenSSHPublicKey
		* Purpose:           Exports the public key to a string in OpenSSH format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           An SSH formatted string.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Exports the public key to a string in OpenSSH format. 
		** Sample OpenSSH-formatted DSA and RSA public keys are below:
		** 
		** OpenSSH RSA Public Key (Line-breaks are added for readability. 
		** An OpenSSH-formatted public key would typically be a single line, not multiple lines.)
		** 
		** ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC9OMcyDX6cCiBjejxXzNcrB/5W5My0hmCAKJRD01Tzzg94edu17O
