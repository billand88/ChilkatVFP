	PROCEDURE tojavakeystore		&& Introduced in version 9.5.0.44. Converts the PFX (PKCS12) to a JavaKeyStore object. One JKS entry per private key found in the PKCS12 is added. The certs found within the PCKS12 are used to build the certificate chains for each private key.
		*==============================================================================
		* Method:            ToJavaKeyStore
		* Purpose:           Converts the PFX (PKCS12) to a JavaKeyStore object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAlias -- the specified alias to set
		*                    tcPassword -- The local key ID encoding.
		* Returns:           toChilkatJavaKeyStore, a Chilkat Java Key Store object.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Converts the PFX (PKCS12) to a JavaKeyStore object. 
		** One JKS entry per private key found in the PKCS12 is added. 
		** The certs found within the PCKS12 are used to build the certificate chains for each private key. 
		** (A typical PFX file contains a single private key along with its associated certificate, 
		** and the certificates in the chain of authentication to the root CA cert.)
		** 
		** The specified alias is applied to the 1st private key found. 
		** If the alias is empty, then the alias is obtained from the cert/PFX 
		** in the following order of preference:
		** 
		**   1) Certificate's subject common name
		**   2) Certificate's subject email address
		**   3) Certificate's friendly name found in the PKCS9 attributes of the PKCS12
		**   4) Certificate's serial number
		**
		** If multiple private keys are found in the PKCS12, 
		** then all but the first will automaticallly be assigned aliases using the preference just described.
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcAlias AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		loChilkatJavaKeyStore AS CHILKAT_JAVAKEYSTORE_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatJavaKeyStore
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatJavaKeyStore = ;
		        m.loChilkatObject.ToJavaKeyStore(m.tcAlias, m.tcPassword)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatJavaKeyStore
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatJavaKeyStore = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE tojksobj		&& Introduced in version 11.0.0. Converts this object to a Java KeyStore (JKS) object in jksObj, creating one JKS entry for each private key found in the PFX. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ToJksObj
		* Purpose:           Converts this object to a Java KeyStore (JKS) object in jksObj.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAlias -- the JKS alias, if used.
		*                    tcPassword -- The JKS password.
		*                    toJavaKeyStore, a Chilkat Java Key Store object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Converts this object to a Java KeyStore (JKS) object in jksObj, 
		** creating one JKS entry for each private key found in the PFX. 
		** Certificates within the PFX are used to construct certificate chains for each private key. 
		** Typically, a PFX file contains a single private key 
		** along with its associated certificate and the certificates in its chain up to the root CA. 
		** The specified alias is assigned to the first private key. 
		** If no alias is provided, it is derived from the certificate/PFX 
		** using the following preferences, in order:
		**
		** 1.  Certificate's subject common name
		** 2.  Certificate's subject email address
		** 3.  Certificate's friendly name found in the PKCS9 attributes
		** 4.  Certificate's serial number
		**
		** If the PFX contains multiple private keys, 
		** aliases for all keys except the first are automatically assigned 
		** using the same preference order.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcAlias AS Character, tcPassword AS Character, ;
		toChilkatJavaKeyStore AS CHILKAT_JAVAKEYSTORE_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterJavaKeyStore AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJavaKeyStore AS CHILKAT_JAVAKEYSTORE_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJavaKeyStore, m.loChilkatJavaKeyStore
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJavaKeyStore = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJavaKeyStore)
		
		      loChilkatJavaKeyStore = m.loParkParameterJavaKeyStore.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ToJksObj(m.tcAlias, m.tcPassword, ;
		        m.loChilkatJavaKeyStore) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatJavaKeyStore = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  loParkParameterJavaKeyStore = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJavaKeyStore = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE topem		&& Introduced in version 9.5.0.47. Write the PFX to a PEM formatted string. The resultant PEM will contain the private key, as well as the certs in the chain of authentication (or whatever certs are available in the PFX).
		*==============================================================================
		* Method:            ToPEM
		* Purpose:           Write the PFX to a PEM formatted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A PEM formatted string
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.47
		**
		** Write the PFX to a PEM formatted string. 
		** The resultant PEM will contain the private key, as well as the certs 
		** in the chain of authentication (or whatever certs are available in the PFX). 
		** For example:
		**
		**   -----BEGIN RSA PRIVATE KEY-----
		**  ...
		**  ... the private key associated with the main certificate.
		**  ...
		**  -----END RSA PRIVATE KEY-----
		**  -----BEGIN CERTIFICATE-----
		**  ...
		**  ... the main certificate
		**  ...
		**  -----END CERTIFICATE-----
		**  -----BEGIN CERTIFICATE-----
		**  ...
		**  ... an intermediate CA certificate (if present)
		**  ...
		**  -----END CERTIFICATE-----
		**  -----BEGIN CERTIFICATE-----
		**  ...
		**  ... the root CA certificate
		**  ...
		**  -----END CERTIFICATE----- 
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		lcPEMFormattedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcPEMFormattedString = []
		llImplemented = .F.
		liIntroducedInBuild = 47
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcPEMFormattedString = m.loChilkatObject.ToPEM() 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcPEMFormattedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE topemex		&& Introduced in version 9.5.0.49. Write the PFX to a PEM formatted string. If extendedAttrs is 1, then extended properties (Bag Attributes and Key Attributes) are output. If noKeys is 1, then no private keys are output.
		*==============================================================================
		* Method:            ToPEMEx
		* Purpose:           Write the PFX to a PEM formatted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuExtendedAttributes, whether or not the extended properties are output.
		*                    tuNoKeys, whether or not the key keys are output.
		*                    tuNoCertificates, whether or not certificates are output.
		*                    tuNoCACertificates, whether or not CA certificates are output.
		*                    tcEncryptAlgorithm, the encryption algorithm to be used.
		*                    tcPassword, the password to be used. 
		* Returns:           A formatted string.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Write the PFX to a PEM formatted string. If extendedAttrs is 1, 
		** then extended properties (Bag Attributes and Key Attributes) are output. 
		** If noKeys is 1, then no private keys are output. 
		** If noCerts is 1, then no certificates are output. 
		** If noCaCerts is 1, then no CA certs or intermediate CA certs are output. 
		** If encryptAlg is not empty, it indicates the encryption algorithm to be used 
		** for encrypting the private keys (otherwise the private keys are output unencrypted). 
		** The possible choices for the encryptAlg are "des3", "aes128", "aes192", and "aes256". 
		** (All encryption algorithm choices use CBC mode.) If the private keys are to be encrypted, 
		** then password is the password to be used. Otherwise, password may be left empty. For example:
		** 
		**   Bag Attributes
		**       Microsoft Local Key set: <No Values>
		**       localKeyID: 01 00 00 00 
		**       friendlyName: le-2b09a3d2-9037-4a05-95cc-4d44518e8607
		**       Microsoft CSP Name: Microsoft RSA SChannel Cryptographic Provider
		**   Key Attributes
		**       X509v3 Key Usage: 10 
		**    -----BEGIN RSA PRIVATE KEY-----
		**   ...
		**   ... the private key associated with the main certificate.
		**   ...
		**   -----END RSA PRIVATE KEY-----
		**   Bag Attributes
		**       localKeyID: 01 00 00 00 
		**       1.3.6.1.4.1.311.17.3.92: 00 08 00 00 
		**       1.3.6.1.4.1.311.17.3.20: C2 53 54 F3 ...
		**       1.3.6.1.4.1.311.17.3.71: 49 00 43 00 ...
		**       1.3.6.1.4.1.311.17.3.75: 31 00 42 00 ...
		**   subject=/OU=Domain Control Validated/OU=PositiveSSL/CN=something.com
		**   issuer=/C=GB/ST=Greater Manchester/L=Salford/O=COMODO CA Limited/CN=COMODO RSA Domain Validation Secure Server CA
		**   -----BEGIN CERTIFICATE-----
		**   ...
		**   ... the main certificate
		**   ...
		**   -----END CERTIFICATE-----
		**   ...
		**   -----BEGIN CERTIFICATE-----
		**   ...
		**   ... an intermediate CA certificate (if present)
		**   ...
		**   -----END CERTIFICATE-----
		**   ...
		**   -----BEGIN CERTIFICATE-----
		**   ...
		**   ... the root CA certificate
		**   ...
		**   -----END CERTIFICATE----- 
		**
		** Update for Version 72: Modification: Encrypting 0 bytes for block cipher algorithms 
		** with padding now results in one block of output, rather than 0 bytes.
		** (Decrypting the 16-byte block will return the original 0 bytes.) 
		** This only applies to block ciphers operating in modes such as ECB, CBC, etc. 
		** This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tuExtendedAttributes AS Unknown, tuNoKeys AS Unknown, ;
		tuNoCertificates AS Unknown, tuNoCACertificates AS Unknown, ;
		tcEncryptAlgorithm AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loException AS Exception, ;
		liNoKeys AS Integer, liNoCertificates AS Integer, liNoCACertificates AS Integer, ;
		lcFormattedString AS Character, liExtendedAttributes AS Integer
		
		STORE 0 TO m.liExtendedAttributes, m.liNoKeys, ;
		m.liNoCertificates, m.liNoCACertificates, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcFormattedString = []
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liExtendedAttributes = .LogicalToBit(m.tuExtendedAttributes)
		      liNoKeys = .LogicalToBit(m.tuNoKeys)
		      liNoCertificates = .LogicalToBit(m.tuNoCertificates)
		      liNoCACertificates = .LogicalToBit(m.tuNoCACertificates)
		
		      TRY
		
		        lcFormattedString = m.loChilkatObject.ToPEMEx(m.liExtendedAttributes, m.liNoKeys, ;
		        m.liNoCertificates, m.liNoCACertificates, m.tcEncryptAlgorithm, m.tcPassword) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFormattedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat PFX UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve the Chilkat PFX UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty.
		** 
		** Can be set to a list of the following comma separated keywords:
		** 
		** "LegacyOrder" - Introduced in v9.5.0.83. Write the internal ContentInfos in the order 
		**                 Chilkat traditionally used in previous versions.
		** 
		** "NoTruncatePfxPassword64" - Introduced in v9.5.0.87. Microsoft systems/tools such as certmgr.msc 
		**                             would typically truncate extremely long passwords to 64 bytes/chars. 
		**                             Other systems did not. Chilkat will by default truncate passwords 
		**                             to 64 chars. Add this keyword to prevent truncation.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_PFX_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PFX UncommonOptions_PFX property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions_PFX property.
		* Returns:           
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		lcValidationMethod = [UncommonOptions_PFX]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE usecertvault		&& Introduced in version 9.5.0.44. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates for help in building certificate chains to a root certificate. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UseCertVault
		* Purpose:           Adds an XML certificate vault to the object's internal list 
		*                    of sources to be searched for certificates and private keys.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXMLCertVault, a Chilkat XML Certificate Vault object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Adds an XML certificate vault to the object's internal list of sources 
		** to be searched for certificates for help in building certificate chains 
		** to a root certificate.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatXMLCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterXmlCertVault AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXmlCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		       loParkParameterXmlCertVault = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXmlCertVault)
		
		      loChilkatXmlCertVault = m.loParkParameterXmlCertVault.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseCertVault(m.loChilkatXMLCertVault) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatXmlCertVault = m.loParkParameterXmlCertVault.SetObject(;
		      m.toChilkatXmlCertVault, m.loChilkatXmlCertVault)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatXMLCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loParkParameterXmlCertVault = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXmlCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat PFX VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 40
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS pkcs11 AS ibasechilkat OF "chilkatvfp.vcx" 		&& A wrapper around the Cryptographic Token Interface (Cryptoki API) for thePKCS11 architecture of smart cards and tokens. This class provides functions for accessing, adding, deleting, and performing operations on data, certificates, and keys.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: closesession		&& Introduced in version 9.5.0.88. Closes the session on the token (i.e. smart card). Note: Memory leaks can occur if the session is not properly closed. Returns 1 for success, 0 for failure.
		*m: createpkcs11object		&& Introduced in version 9.5.0.96. Creates an object and returns the handle. The attrs specifies the attributes that define the object to be created.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat PKCS11 DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: destroyobject		&& Introduced in version 9.5.0.96. Destroys an object (deletes it from the HSM). hObject is the object's handle.
		*m: discover		&& Introduced in version 9.5.0.88. Discovers the readers, smart cards, and USB tokens accessible via PKCS11 on the computer (using the DLL/shared lib specified by SharedLibPath).
		*m: exportpublickey		&& Introduced in version 9.5.0.96. Export a public key given a public or private key handle. The pubKey is loaded with the exported public key. Returns 1 for success, 0 for failure.
		*m: findallcerts		&& Introduced in version 9.5.0.88. Finds all certificates contained on the smart card (or USB token). This sets the NumCerts property. Each certificate can be obtained by calling GetCert(index) where the 1st cert is at index 0.
		*m: findallkeys		&& Introduced in version 9.5.0.96. Finds all keys contained on the smart card (or USB token). The keyClass indicates the kind of keys to return, and can be one of the following: public/private/secret/otp. Information about the keys is returned in json.
		*m: findcert		&& Introduced in version 9.5.0.88. Finds the certificate where the given certPart equals the partValue. Possible values for certPart are: "privateKey", "subjectDN", "subjectDN_withTags", "subjectCN", "serial", or "serial:issuerCN".
		*m: findobject		&& Introduced in version 9.5.0.96. General function for finding an object such as a private key. Returns the handle of the first matching object, or 0 if not found.
		*m: geneckey		&& Introduced in version 9.5.0.96. Generate an EC key pair suitable for signing data and verifying signatures. The private key is created on the HSM (smart card or token), and the public key is returned in pubKey.
		*m: genrsakey		&& Introduced in version 9.5.0.96. Generate an RSA key pair suitable for signing data and verifying signatures. The private key is created on the HSM (smart card or token), and the public key is returned in pubKey.
		*m: gensecretkey		&& Introduced in version 9.5.0.96. Generates a symmetric encryption key. The keyType is the key type, which can be one of the following values: AES/AES/XTS/Blowfish/Twofish/ChaCha20.
		*m: getcert		&& Introduced in version 9.5.0.88. Loads cert with the Nth certificate indicated by index. The 1st certificate is at index 0. The FindAllCerts method must be called beforehand to load the certs from the smart card into this object.
		*m: importprivatekey		&& Introduced in version 9.5.0.96. Imports a private key onto the HSM. Returns the handle of the unwrapped key, or 0 if failed.
		*m: importsshkey		&& Introduced in version 9.5.0.96. Imports an SSH private key onto the HSM. Returns the handle of the unwrapped key, or 0 if failed.
		*m: initialize		&& Introduced in version 9.5.0.88. Initializes the PKCS#11 library. Should be called after specifying the SharedLibPath. The DLL (or .so/.dylib) is dynamically loaded and the PKCS#11 lib is initialized. Returns 1 for success, 0 for failure.
		*m: initpin		&& Introduced in version 9.5.0.89. Initializes the normal user's PIN. This must be called from the security officer's (SO) logged-in session.
		*m: inittoken		&& Introduced in version 9.5.0.89. Initializes a token. slotId is the slot ID of the token's slot. If the token has not been initialized (i.e. new from the factory), then the pPin parameter becomes the initial value of the SO (Security Officer) PIN.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat PKCS11 LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat PKCS11 LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat PKCS11 LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat PKCS11 LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat PKCS11 LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat PKCS11 LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat PKCS11 LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: login		&& Introduced in version 9.5.0.88. Authenticates a session with a PIN. The userType can be one of the following integer values: 0) Security Officer (0) 1) Normal User (1) 2) Context Specific (2).
		*m: logout		&& Introduced in version 9.5.0.88. Logs out from a token (smart card). Returns 1 for success, 0 for failure.
		*m: numcerts_access		&& Access method used to retrieve the Chilkat PKCS11 NumCerts property.
		*m: numcerts_assign		&& Assign method used to hold a reference to the NumCerts property.
		*m: opensession		&& Introduced in version 9.5.0.88. Opens a session on the token (i.e. smart card). The slotId is the ID of the slot (not the index). Set slotId equal to -1 to choose the first available non-empty slot.
		*m: quicksession		&& Introduced in version 9.5.0.96. Quickly establishes a session on the 1st unempty slot, with or without login. If the pin is the empty string, then no login will take place.
		*m: setpin		&& Introduced in version 9.5.0.89. Modifies the PIN of the user that is currently logged in, or the Normal User PIN if the session is not logged in. Returns 1 for success, 0 for failure.
		*m: sharedlibpath_access		&& Access method used to retrieve the Chilkat PKCS11 SharedLibPath property.
		*m: sharedlibpath_assign		&& Assign method used to hold a reference to the SharedLibPath property.
		*m: sigcontextpin_access		&& Access method used to retrieve the Chilkat PKCS11 SigContextPIN property.
		*m: sigcontextpin_assign		&& Assign method used to hold a reference to the SigContextPIN property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat PKCS11 UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UnCommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat PKCS11 VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcerts		&& Introduced in version 9.5.0.88. The number of certificates contained on the smart card or USB token. This property is set when FindAllCerts is called.
		*p: sharedlibpath		&& Introduced in version 9.5.0.88. On Windows systems, then should be set to the name of the DLL file (if the DLL is located in C:\Windows\System32), or it can be the full path to the DLL.
		*p: sigcontextpin		&& Introduced in version 9.5.0.97. If the smart card or token requires a signature context login within the signing operation, then set this property to the context-specific signature PIN. Most smart cards do not need this.
		*p: uncommonoptions		&& Introduced in version 9.5.0.99. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string. It can be set to a list of one or more of the following comma separated keywords:
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Pkcs11
		debuglogfilepath = 
		iinstancepatch = 88
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "pkcs11"
		numcerts = 0
		sharedlibpath = 
		sigcontextpin = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 99
		
		  Internally, Chilkat increased the max number for FindObjects from 512 to 8192.
		
		  The Discover method can take a long time for some smartcards and tokens. 
		  Chilkat added two UncommonOptions keywords to limit the amount of querying for each discovered token. 
		  The keyword “Pkcs11DiscoverSkipTokenInfo” causes Discover to get only slot info 
		  (token info and mechanisms are skipped). 
		  The “Pkcs11DiscoverSkipMechanisms” causes only mechanisms to be skipped.
		
		** Version 97
		
		  Added the SigContextPin property, for those smart cards that require an additional
		  context-specific login within the context of signing.
		
		** Version 96
		
		  Significantly expanded PKCS11 functionality. See the following bullet points.
		  Remote Signing Services: Added functionality to utilize remote signing services, such as AWS KMS,
		  Azure Key Vault, and Aruba Remote Signing Service (ARSS). This allows all signing functionality
		  in Chilkat, such as PDF, XAdES, CAdES, etc. to use a remote signing service.
		  The design allows for the easy expansion to support additional signing services as needed.
		
		  Added the FindAllKeys method, which returns JSON with information for all keys of a particular type:
		  private, public, secret, or otp.
		
		  Added the GenSecretKey method, to provide the ability to generate a symmetric encryption key,
		  such as AES, on the HSM.
		
		  Added the GenRsaKey method, to provide the ability to generate an RSA key on the HSM.
		
		  Added the GenEcKey method, to provide the ability to generate an ECDSA key on the HSM.
		
		  Added the CreatePkcs11Object method, to provide a generalized method for creating an object on the HSM.
		  This is a way to import non-sensitive material such as a session-only AES key-wrapping key, or a public key.
		
		  Added the QuickSession method, to make it shorter and simpler in code to establish a PKCS11 session.
		
		  Added the ImportPrivateKey method, to make it easy to import an RSA or EC private key on to the HSM.
		  (It can be tricky though, because much depends on the capabilities of the HSM, the details of the template,
		  and the security restrictions of the HSM.)
		
		  Added the DestroyObject method, to make it possible to remove objects from the HSM.
		
		  Added the FindObject method to provide a generalized way to find an object on the HSM.
		
		  Added the ImportSshKey method. This is the same as ImportPrivateKey,
		  but accepts a Chilkat SshKey object instead of a Chilkat PrivateKey object.
		  (An SshKey *is* a private key, but for some foolish reason in the past, Chilkat decided
		  to create a separate class for SSH keys.)
		
		  Added the ExportPublicKey method to make it easy to export a public key from the HSM directly
		  into a Chilkat PublicKey object. Note: There is no method to export a private key.
		  It’s because private keys are meant to stay on the HSM. They are either generated on the HSM,
		  or imported onto the HSM, but once on the HSM, a *private* key just stays there.
		  It’s one of the main reasons for having an HSM — you cannot export the private key,
		  and the signing happens on the HSM.
		
		  Added support for the Watchdata PROXkey USB token.
		  Chilkat should automatically recognize the USB token
		  and use the PKCS11 driver at C:\Windows\System32\SignatureP11.dll.
		  (This is also supported on Linux, assuming the shared lib is at
		  /usr/lib/WatchData/ProxKey/lib/libwdpkcs_SignatureP11.so)
		
		** Version 95
		
		  Chilkat now works with the Turkish smartcard from TUBITAK UEKAE.
		
		  Chilkat now works correctly with the CryptoCertum 3.6 Cryptographic Card
		
		  Chilkat now works more seamlessly with the ePass2003 token.
		
		  Now able to support the PKCS11 shared lib (libkeyfactorpkcs11.so) provided by “RedTrust”,
		  a KeyFactor Company, where the PKCS11 shared lib actually communicates
		  with the redtrust.com (or keyfactor.com) server to do the signing on the server.
		
		** Version 90
		
		  Improved automatic recognition and handling for various smart cards.
		
		** Version 88
		
		  Adding the PKCS11 class to bring smart card and USB token functionality to non-Windows systems,
		  and to support smart cards that are problematic when accessed via Microsoft’s CNG and Legacy CSP.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE closesession		&& Introduced in version 9.5.0.88. Closes the session on the token (i.e. smart card). Note: Memory leaks can occur if the session is not properly closed. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CloseSession
		* Purpose:           Closes the session on the token (i.e. smart card).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		**
		** Closes the session on the token (i.e. smart card).
		** 
		** Note: Memory leaks can occur if the session is not properly closed.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.CloseSession() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE createpkcs11object		&& Introduced in version 9.5.0.96. Creates an object and returns the handle. The attrs specifies the attributes that define the object to be created.
		*==============================================================================
		* Method:            CreatePKCS11Object
		* Purpose:           Creates an object and returns the handle.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSON, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Creates an object and returns the handle. 
		** The attrs specifies the attributes that define the object to be created. 
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSON AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterJSON AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS CHILKAT_JSONOBJECT_COM_CALL, liHandle AS Integer
		
		STORE 0 TO m.liHandle, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSON, m.loChilkatJSON
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSON = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJSON.GetObject()
		
		      TRY
		
		        liHandle = m.loChilkatObject.CreatePKCS11Object(m.loChilkatJSON)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatJSON = ;
		      m.loParkParameterJSON.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		  
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSON, m.loChilkatJSON
		
		RETURN m.liHandle
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatJSON = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSON = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat PKCS11 DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PKCS11 DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PKCS11 DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 88
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE destroyobject		&& Introduced in version 9.5.0.96. Destroys an object (deletes it from the HSM). hObject is the object's handle.
		*==============================================================================
		* Method:            DestroyObject
		* Purpose:           Destroys an object (deletes it from the HSM).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiHandle, the object handle to destroy.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		** 
		** Destroys an object (deletes it from the HSM). hObject is the object's handle.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiHandle AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.DestroyObject(m.tiHandle) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE discover		&& Introduced in version 9.5.0.88. Discovers the readers, smart cards, and USB tokens accessible via PKCS11 on the computer (using the DLL/shared lib specified by SharedLibPath).
		*==============================================================================
		* Method:            Discover
		* Purpose:           Discovers the readers, smart cards, and USB tokens 
		*                    accessible via PKCS11 on the computer.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuOnlyTokensPresent, whether or not only
		*                    slots with tokens should be returned.
		*                    toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		**
		** Discovers the readers, smart cards, and USB tokens accessible 
		** via PKCS11 on the computer (using the DLL/shared lib specified by SharedLibPath). 
		** The onlyTokensPresent specifies if only slots (readers) with tokens (smart cards) 
		** present should be returned. The information is written to the json.
		** (For details, see the example below.)
		**
		** Introduced in version 99: The Discover method can take a long time for some smartcards and tokens. 
		** Chilkat added two UncommonOptions keywords to limit the amount of querying for each discovered token. 
		** The keyword “Pkcs11DiscoverSkipTokenInfo” causes Discover to get only slot info 
		** (token info and mechanisms are skipped). 
		** The “Pkcs11DiscoverSkipMechanisms” causes only mechanisms to be skipped.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tuOnlyTokensPresent AS Unknown, ;
		toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown, liOnlyTokensPresent AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liOnlyTokensPresent, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liOnlyTokensPresent = .LogicalToBit(m.tuOnlyTokensPresent)
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.Discover(m.liOnlyTokensPresent, ;
		        m.loChilkatJSONObject) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		  
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE exportpublickey		&& Introduced in version 9.5.0.96. Export a public key given a public or private key handle. The pubKey is loaded with the exported public key. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ExportPublicKey
		* Purpose:           Export a public key given a public or private key handle.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiKeyHandle, the public or private key handle.
		*                    toChilkatPublicKey, a Chilkat Public Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		** 
		** Export a public key given a public or private key handle. 
		** The pubKey is loaded with the exported public key.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiKeyHandle AS Integer, toChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterPublicKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPublicKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], toChilkatJSON)
		
		      loChilkatPublicKey = loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ExportPublicKey(m.tiKeyHandle, m.loChilkatPublicKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatPublicKey = ;
		      m.loParkParameterPublicKey.SetObject(m.toChilkatPublicKey, m.loChilkatPublicKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey 
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loParkParameterPublicKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  m.loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE findallcerts		&& Introduced in version 9.5.0.88. Finds all certificates contained on the smart card (or USB token). This sets the NumCerts property. Each certificate can be obtained by calling GetCert(index) where the 1st cert is at index 0.
