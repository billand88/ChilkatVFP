	PROCEDURE receivestring		&& Receives as much data as is immediately available on a TCP/IP or SSL socket. If no data is immediately available, it waits up to MaxReadIdleMs milliseconds for data to arrive.
		*==============================================================================
		* Method:            ReceiveString
		* Purpose:           Receives as much data as is immediately available on a TCP/IP or SSL socket.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The received string
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** Receives as much data as is immediately available on a TCP/IP or SSL socket. 
		** If no data is immediately available, 
		** it waits up to MaxReadIdleMs milliseconds for data to arrive. 
		** The incoming bytes are interpreted according to the StringCharset property 
		** and returned as a string.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, lcReturn AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcReturn = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcReturn = m.loChilkatObject.ReceiveString()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

