	PROCEDURE exportcertxml		&& Exports a certificate to an XML format where the XML tags are the names of the ASN.1 objects that compose the X.509 certificate. Binary data is either hex or base64 encoded.
		*==============================================================================
		* Method:            ExportCertXML
		* Purpose:           Exports a certificate to an XML format where 
		*                    the XML tags are the names of the ASN.1 objects.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The digital certificate in PEM format.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Exports a certificate to an XML format where the XML tags 
		** are the names of the ASN.1 objects that compose the X.509 certificate. 
		** Binary data is either hex or base64 encoded. 
		** (The binary data for a "bits" ASN.1 tag is hex encoded, 
		** whereas for all other ASN.1 tags, such as "octets", it is base64.)
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXML = m.loChilkatObject.ExportCertXML()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

