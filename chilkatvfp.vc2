		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Loads the certificate from the PFX contained in pfxData. 
		** Note: If the PFX contains multiple certificates, 
		** the 1st certificate in the PFX is loaded.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tcPFXPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData  
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadPFXBd(m.loChilkatBinData, m.tcPFXPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpfxdata		&& Loads a PFX from an in-memory image of a PFX file. Note: If the PFX contains multiple certificates, the 1st certificate in the PFX is loaded. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadPFXData
		* Purpose:           Loads a PFX from an in-memory image of a PFX file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPFXData, the PFX data to load.
		*                    tcPassword, the PFX password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Loads a PFX from an in-memory image of a PFX file. 
		** Note: If the PFX contains multiple certificates, 
		** the 1st certificate in the PFX is loaded.
		** 
		** Fixed for Version 55: When loading a certificate from a PFX/.p12, 
		** the issuer CN (common name) for some certs was not getting set.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tqPFXData AS VarBinary, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadPFXData(m.tqPFXData, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpfxfile		&& Loads a PFX file. Note: If the PFX contains multiple certificates, the 1st certificate in the PFX is loaded. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadPFXFile
		* Purpose:           Loads a PFX file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPFXFilePath, the path to the PFX file
		*                    tcPassword, the PFX password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Loads a PFX file. Note: If the PFX contains multiple certificates, 
		** the 1st certificate in the PFX is loaded.
		** 
		** Fixed for Version 55: When loading a certificate from a PFX/.p12, 
		** the issuer CN (common name) for some certs was not getting set.
		** 
		** Fixed in version 83: Fixed the “Cert's public key does not match the 
		** private key.” error that could sometimes occur in the method.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcPFXFilePath AS VarBinary, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
