	PROCEDURE getxml		&& Returns the private key in XML format. The private key is returned unencrypted and the parts are base64 encoded.
		*==============================================================================
		* Method:            GetXML
		* Purpose:           Returns the private key in XML format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The private key in XML format.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Returns the private key in XML format. 
		** The private key is returned unencrypted and the parts are base64 encoded.
		** 
		** RSA keys have this XML format:
		** 
		**   <RSAKeyValue>
		**     <Modulus>...</Modulus>
		**     <Exponent>...</Exponent>
		**     <P>...</P>
		**     <Q>...</Q>
		**     <DP>...</DP>
		**     <DQ>...</DQ>
		**     <InverseQ>...</InverseQ>
		**     <D>...</D>
		**   </RSAKeyValue>
		**
		** DSA keys have this XML format:
		**
		**   <DSAKeyValue>
		**     <P>...</P>
		**     <Q>...</Q>
		**     <G>...</G>
		**     <Y>...</Y>
		**     <X>...</X>
		**   </DSAKeyValue>
		** 
		** ECC keys have this XML format. The CURVE_NAME could be one of secp256r1, 
		** secp384r1, secp521r1, secp256k1 (or others as new curves are supported.)
		** 
		**   <ECCKeyValue curve="CURVE_NAME">...</ECCKeyValue>
		**
		** Fixed for version 11.6.0: Ed25519 XML from GetXml now loads successfully.
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXML = m.loChilkatObject.GetXML()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        11/03/2023
		*==============================================================================
		
		LOCAL llReturn AS Logical, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of ChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		loVersioning = NULL
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Version 96 or later without property entry test
		      IF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 96) ;
		      AND EMPTY(.cEventHandlerClass)
		
		        .cEventHandlerClass = [iBaseEventHandler]
		
		      ENDIF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 96) ;
		      AND EMPTY(.cEventHandlerClass)
		      ** End version 96 or later without property entry test
		
		    ELSE
		
		      llReturn = .F.
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have a good object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loVersioning = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE keytype_access		&& Access method used to retrieve the Chilkat PrivateKey KeyType property.
		*==============================================================================
		* Method:            KeyType_Access
		* Purpose:           Access method used to retrieve 
		*                    the KeyType property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.KeyType
		* Date Added:        06/21/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.52
		** 
		** The type of private key. 
		** Can be "empty", "rsa", "dsa", "ecc" (i.e. ECDSA), or "ed25519".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE keytype_assign		&& Assign method used to hold a reference to the KeyType property.
		*==============================================================================
		* Method:            KeyType_Assign
		* Purpose:           Assign method used to hold
		*                    the KeyType of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
