		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE numfilesanddirs_access		&& Access method used to retrieve the Chilkat NumFilesAndDirs property.
		*==============================================================================
		* Method:            NumFilesAndDirs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 NumFilesAndDirs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumFilesAndDirs
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented function!
		**
		** Important: This property is decremented. Applications should instead call the
		** GetDirCount method.
		**
		** The number of files and sub-directories in the current remote directory that
		** match the ListPattern. (The ListPattern defaults to "*", so unless changed, this
		** the total number of files and sub-directories.)
		**
		** Important: Accessing this property can cause the directory listing to be
		** retrieved from the FTP server. For FTP servers that doe not support the
		** MLST/MLSD commands, this is technically a data transfer that requires a
		** temporary data connection to be established in the same way as when uploading or
		** downloading files. If your program hangs while accessing NumFilesAndDirs, it
		** probably means that the data connection could not be established. The most
		** common solution is to switch to using Passive mode by setting the Passive
		** property = true. If this does not help, examine the contents of the
		** LastErrorText property after NumFilesAndDirs finally returns (after timing out).
		** Also, see this Chilkat blog post about FTP connection settings
		** <http://www.cknotes.com/?p=282> .
		**
		** Per the 9.5.0.56 release notes: The IsConnected and NumFilesAndDirs properties 
		** should be avoided. They were already decremented prior to this version release, 
		** but this is another recommendation to avoid these properties. 
		** Instead use the CheckConnection and GetDirCount methods.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [LongReadOnly]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 0
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		
	ENDPROC

	HIDDEN PROCEDURE numfilesanddirs_assign		&& Assign method used to hold a reference to the NumFilesAndDirs property.
		*==============================================================================
		* Method:            NumFilesAndDirs_Assign
		* Purpose:           Assign method used to hold a reference to the NumFilesAndDirs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the NumFilesAndDirs property.
		* Returns:           
		* Date Added:        06/09/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    lcValidationMethod = []
		    lcMethodToCall = [LongReadOnly]
		
		    .CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE partialtransfer_access		&& Access method used to retrieve the Chilkat PartialTransfer property.
		*==============================================================================
		* Method:            PartialTransfer_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 PartialTransfer property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PartialTransfer
		* Date Added:        02/25/2022
		*==============================================================================
		
		**
		** A read-only property that indicates whether a partial transfer 
		** was received in the last method call to download a file. 
		** Set to 1 if a partial transfer was received. 
		** Set to 0 if nothing was received, or if the full file was received.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

