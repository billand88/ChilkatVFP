		liStackLevel = 0
		
		loMsgSvc = m.toMsgSvc
		
		WITH THIS
		
		  ** Parameter validation test
		  IF ISNULL(m.loMsgSvc) ;
		  OR TYPE([loMsgSvc.Name]) == T_CHARACTER
		
		    .oMsgSvc = m.loMsgSvc
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		
		    lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.loMsgSvc) ;
		  OR TYPE([loMsgSvc.Name]) == T_CHARACTER
		  ** End parameter validation test
		
		ENDWITH
		
		loMsgSvc = NULL
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loMsgSvc = NEWOBJECT([cMsgSvc])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE oversioning_access		&& Access method used to retrieve a reference to the Chilkat Versioning object.
		*==============================================================================
		* Method:            oVersioning_Access
		* Purpose:           Access method used to retrieve a reference to the Chilkat Versioning object.
		* Author:            Bill Anderson
		* Parameters:        
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Returns:           .oVersioning, the Versioning object, or NULL.
		* Date Added:        10/07/2024
		* Notes:             Don't instantiate the object if we're sitting in the Destroy method.
		*==============================================================================
		
		LOCAL loVersioning AS [iVersioning OF ChilkatVFP.VCX], lcErrorMessage AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcPEMType AS Character, lcSecondParameter AS Character
		
