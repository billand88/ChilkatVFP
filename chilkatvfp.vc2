DEFINE CLASS hashtable AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a collection of key/value pairs that are stored in a hash table. Note: This class was added in Chilkat v9.5.0.51
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addfromxmlsb		&& Introduced in version 9.5.0.64. Adds to the hash table from XML previously created by calling ToXmlSb. Returns 1 for success, 0 for failure.
		*m: addint		&& Introduced in version 9.5.0.51. Adds or replaces an entry with the given key and integer value to the hash table. Returns 1 if a new hash entry was added or replaced. Returns 0 if an out-of-memory condition occurred. Returns 1 for success, 0 for failure.
		*m: addqueryparams		&& Adds URL query parameters into the hashtable. The queryParams has the form: "field1=value1&field2=value2&field3=value3...".
		*m: addstr		&& Introduced in version 9.5.0.51. Adds or replaces an entry with the given key and string value to the hash table. Returns 1 if a new hash entry was added or replaced. Returns 0 if an out-of-memory condition occurred. Returns 1 for success, 0 for failure.
		*m: clear		&& Introduced in version 9.5.0.51. Removes all elements from the Hashtable.
		*m: clearwithnewcapacity		&& ntroduced in version 9.5.0.51. Removes all elements from the Hashtable and re-sizes with the specified capacity. The capacity is the number of buckets in the hash table.
		*m: contains		&& Introduced in version 9.5.0.51. Determines if a given key is contained within the hash table. Returns 1 if the key exists, otherwise returns 0.
		*m: containsintkey		&& Introduced in version 9.5.0.64. Determines if a given key is contained within the hash table. Returns 1 if the key exists, otherwise returns 0.
		*m: count_access		&& Access method used to retrieve the Chilkat HashTable Count property.
		*m: count_assign		&& Access method used to retrieve the Chilkat HashTable Count property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat HashTable DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getkeys		&& Introduced in version 9.5.0.62. Appends the complete set of hashtable key strings to strTable. Returns 1 for success, 0 for failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat HashTable LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat HashTable LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat HashTable LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat HashTable LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: lookupint		&& Introduced in version 9.5.0.51. Returns the integer value associated with the specified key. If the key is not in the hash table, the return value is 0.
		*m: lookupstr		&& Introduced in version 9.5.0.51. Returns the string value associated with the specified key.
		*m: remove		&& Introduced in version 9.5.0.51. Removes the entry with the specified key from the hash table. Returns 1 if the key existed and was removed. Returns 0 if the key did not already exist.
		*m: toquerystring		&& Introduced in version 9.5.0.92. Serializes the hash table to a query string such as key1=value1&key2=value2&key3=value3 where each value is URL encoded. Returns Nothing on failure.
		*m: toxmlsb		&& Introduced in version 9.5.0.64. Serializes the hash table to XML format. The XML is appended to sbXml. Returns 1 for success, 0 for failure.
		*p: count		&& Introduced in version 9.5.0.97. The number of items (strings/integers) contained in the hash table.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Hashtable
		count = 0
		debuglogfilepath = 
		iinstancepatch = 51
		lastbinaryresult = .NULL.
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "hashtable"
	*</PropValue>
	
	PROCEDURE addfromxmlsb		&& Introduced in version 9.5.0.64. Adds to the hash table from XML previously created by calling ToXmlSb. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddFromXMLSb
		* Purpose:           Adds to the hash table from XML previously created by calling ToXmlSb.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder -- a Chilkat String Builder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.64
		** 
		** Adds to the hash table from XML previously created by calling ToXmlSb.
		**
		** Fixed for version 71: Fixed crash bug in this method.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HASHTABLE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 64
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddFromXMLSb(m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HASHTABLE_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

