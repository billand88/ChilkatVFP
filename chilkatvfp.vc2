	PROCEDURE setresponsebodystream		&& Introduced in version 9.5.0.58. Only applies to the Full* methods, such as FullRequestNoBody, FullRequestBinary, FullRequestStream, etc.
		*==============================================================================
		* Method:            SetResponseBodyStream
		* Purpose:           When set, the response body is streamed directly to responseStream, 
		*                    if (and only if) the HTTP response status code equals expectedStatus.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiExpectedStatus, the expected status to start streaming.
		*                    tuAutoSetStreamCharset, whether or not to set the charset automatically.
		*                    toChilkatStream, a Chilkat Stream object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Only applies to the Full* methods, such as FullRequestNoBody, FullRequestBinary, 
		** FullRequestStream, etc. When set, the response body is streamed directly to responseStream, 
		** if (and only if) the HTTP response status code equals expectedStatus.
		** 
		** If the response body was streamed to responseStream, then the string return value 
		** of the Full* method instead becomes "OK" for success. 
		** If an attempt was made to stream the response body but it failed, 
		** then "FAIL" is returned. If the response body was not streamed because 
		** the response status code was not equal to expectedStatus, 
		** then the returned string contains the server's error response.
		** 
		** If autoSetStreamCharset is 1, then the expectedStatus's StringCharset property 
		** will automatically get set based on the charset, if any, indicated in the response header. 
		** If the response is binary, then autoSetStreamCharset is ignored.
		** 
		** Starting in v9.5.0.75, the expectedStatus may be passed as a negative number 
		** to specify a range of expected (success) status codes. For example:
		** 
		** -200: Allow status codes 200 - 299
		** -210: Allow status codes 210 - 219
		** -220: Allow status codes 220 - 229
		** 
		** etc.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiExpectedStatus AS Integer, ;
		tuAutoSetStreamCharset AS Unknown, toChilkatStream AS CHILKAT_STREAM_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		loParkParameterStream AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStream AS CHILKAT_STREAM_COM_CALL, ;
		luReturn AS Unknown, liAutoSetStreamCharset AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liAutoSetStreamCharset, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liAutoSetStreamCharset = .LogicalToBit(m.tuAutoSetStreamCharset)
		
		      loParkParameterStream = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStream)
		
		      loChilkatStream = m.loParkParameterStream.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetResponseBodyStream(m.tiExpectedStatus, ;
		        m.liAutoSetStreamCharset, m.loChilkatStream) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStream = ;
		      m.loParkParameterStream.SetObject(m.toChilkatStream, m.loChilkatStream)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  toChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loParkParameterStream = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE streamnonchunked_access		&& Access method used to retrieve the Chilkat Rest StreamNotChunked property.
		*==============================================================================
		* Method:            StreamNotChunked_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Rest StreamNotChunked property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.StreamNotChunked
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** If 1, then methods that upload data are sent non-chunked if possible. 
		** For example, if the FullRequestStream method is called where the stream 
		** is a file stream, then the size of the content is known and the HTTP request 
		** will be sent using a Content-Length header instead of using a Transfer-Encoding: chunked upload. 
		** If 0, then the chunked transfer encoding is used. The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE streamnonchunked_assign		&& Assign method used to hold a reference to the StreamNotChunked property.
		*==============================================================================
		* Method:            StreamNotChunked_Assign
		* Purpose:           Assign method used to hold a reference to the StreamNotChunked property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the StreamNotChunked property.
		* Returns:           
		* Date Added:        06/05/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat Rest UncommonOptions property.
		*==============================================================================
		* Method:            UnCommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Rest UnCommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnCommonOptions
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		** 
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty. 
		** Can be set to a list of the following comma separated keywords:
		** 
		** "ProtectFromVpn" - Introduced in v9.5.0.80. On Android systems, will bypass 
		** any VPN that may be installed or active.
		**
		** "AllowInsecureBasicAuth" - Introduced in v9.5.0.80. Allows HTTP Basic authentication 
		** over non-TLS connections. (HTTP Basic authentication puts the login:password 
		** in the Authorization header field in base64 encoding. 
		** If transmitted over an insecure connection, it is potentially visible 
		** to anything sniffing the traffic. By default, Chilkat disallows HTTP Basic authentication 
		** except for SSL/TLS connections, SSH tunneled connections, or connections to localhost.)
		**
		** "EnableTls13" - Introduced in v9.5.0.82. Causes TLS 1.3 to be offered 
		** in the ClientHello of the TLS protocol, allowing the server to select TLS 1.3 for the session. 
		** Future versions of Chilkat will enable TLS 1.3 by default. 
		** This option is only necessary in v9.5.0.82 if TLS 1.3 is desired.
		** 
		** "DisableTls13" - Introduced in v9.5.0.84. Disables TLS 1.3 so that only TLS 1.2 or lower is used.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold a reference to the UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        06/05/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		lcValidationMethod = [UncommonOptions_Rest]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE useconnection		&& Introduced in version 9.5.0.58. Sets the connection to be used for sending the REST request. The connection should be an already-connected socket.
		*==============================================================================
		* Method:            UseConnection
		* Purpose:           Sets the connection to be used for sending the REST request.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSocket, a Chilkat Socket object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Sets the connection to be used for sending the REST request. 
		** The connection should be an already-connected socket. 
		** It may be a TLS connection, an unencrypted connection, 
		** through an HTTP proxy, a SOCKS proxy, or even through SSH tunnels. 
		** All of the connection related functionality is handled by the Chilkat Socket API.
		** 
		** The autoReconnect indicates whether connection should automatically 
		** be established as needed for subsequent REST requests.
		** 
		** Important: The UseConnection method is provided as a means 
		** for handling more complicated connections -- such as connections through proxies, 
		** tunnels, etc. If your application is connecting directly to the HTTP server, 
		** then simply call this class's Connect method.
		**
		** Fixed for version 73: Fixed a problem when a non-standard HTTP port (not 80 nor 443) 
		** is used in for the original Socket connection in conjunction with this method.  
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSocket AS CHILKAT_SOCKET_COM_CALL, tuAutoReconnect AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL, luReturn AS Unknown, ;
		liAutoReconnect AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liAutoReconnect, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liAutoReconnect = .LogicalToBit(m.tuAutoReconnect)
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSocket)
		
		      loChilkatSocket = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseConnection(m.loChilkatSocket, m.liAutoReconnect) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSocket = ;
		      m.loParkParameterSocket.SetObject(m.toChilkatSocket, m.loChilkatSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  toChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat Rest VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/05/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/05/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS rsa AS ibasechilkat OF "chilkatvfp.vcx" 		&& RSA encryption component / library. Encrypt and decrypt byte arrays and strings. Generate public/private key pairs from 384 to 4096 bits in length. Import and export RSA keys. Import keys from SNK files. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: charset_access		&& Access method used to retrieve the Chilkat RSA Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat RSA DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: decryptbd		&& Introduced in version 9.5.0.76. RSA decrypts the contents of bd. usePrivateKey should be set to 1 if the private key is to be used for decrypting. Otherwise it should be set to 0 if the public key is to be used for decrypting.
		*m: decryptbytes		&& Decrypts byte data using the RSA encryption algorithm. usePrivateKey should be set to 1 if the private key is to be used for decrypting. Otherwise it should be set to 0 if the public key is to be used for decrypting.
		*m: decryptbytesenc		&& Same as DecryptBytes, except the input is an encoded string. The encoding is specified by the EncodingMode property, which can have values such as "base64", "hex", "quoted-printable", "url", etc.
		*m: decryptstring		&& Decrypts encrypted string data and returns an unencrypted string. usePrivateKey should be set to 1 if the private key is to be used for decrypting. Otherwise it should be set to 0 if the public key is to be used.
		*m: decryptstringenc		&& Same as DecryptString, except the input is an encoded string. The encoding is specified by the EncodingMode property, which can have values such as "base64", "hex", "quoted-printable", "url", etc.
		*m: encodingmode_access		&& Access method used to retrieve the Chilkat RSA EncodingMode property.
		*m: encodingmode_assign		&& Assign method used to hold a reference to the EncodingMode property.
		*m: encryptbd		&& Introduced in version 9.5.0.76. RSA encrypts the contents of bd. usePrivateKey should be set to 1 if the private key is to be used for encrypting. Otherwise it should be set to 0 if the public key is to be used for encrypting.
		*m: encryptbytes		&& Encrypts byte data using the RSA encryption algorithm. usePrivateKey should be set to 1 if the private key is to be used for encrypting. Otherwise it should be set to 0 if the public key is to be used for encrypting.
		*m: encryptbytesenc		&& Same as EncryptBytes, except the output is an encoded string. The encoding is specified by the EncodingMode property, which can have values such as "base64", "hex", "quoted-printable", "url", etc.
		*m: encryptstring		&& Encrypts a string using the RSA encryption algorithm. usePrivateKey should be set to 1 if the private key is to be used for encrypting. Otherwise it should be set to 0 if the public key is to be used for encrypting.
		*m: encryptstringenc		&& Same as EncryptString, except the output is an encoded string. The encoding is specified by the EncodingMode property, which can have values such as "base64", "hex", "quoted-printable", "url", etc.
		*m: exportprivatekey		&& Exports the private-key of an RSA key pair to XML format. This is typically called after generating a new RSA key via the GenerateKey method. Returns Nothing on failure.
		*m: exportprivatekeyobj		&& Introduced in version 9.5.0.40. Exports the private-key to a private key object. This is typically called after generating a new RSA key via the GenerateKey method.
		*m: exportpublickey		&& Exports the public-key of an RSA key pair to XML format. This is typically called after generating a new RSA key via the GenerateKey method. Returns Nothing on failure
		*m: exportpublickeyobj		&& Introduced in version 9.5.0.40. Exports the public key to a public key object. Once the public key object is obtained, it may be saved in a variety of different formats. Returns Nothing on failure.
		*m: generatekey		&& Generates a new RSA public/private key pair. The number of bits can range from 512 to 8192. Typical key lengths are 1024, 2048, or 4096 bits.
		*m: genkey		&& Introduced in version 11.0.0. Generates a new RSA key and stores it in privKey. numBits specifies the key length, which can range from 512 to 8192 bits. Common key lengths are 1024, 2048, or 4096 bits. Returns 1 for success, 0 for failure.
		*m: importprivatekey		&& Imports a private key from XML format. After successful import, the private key can be used to encrypt or decrypt. A private key (by definition) contains both private and public parts. This is because the public key consist of modulus and exponent.
		*m: importprivatekeyobj		&& Introduced in version 9.5.0.40. Imports a private key from a private key object. The imported private key is used in methods that sign or decrypt. Returns 1 for success, 0 for failure.
		*m: importpublickey		&& Imports a public key from XML format. After successful import, the public key can be used to encrypt or decrypt. Note: Importing a public key overwrites the key that is currently contained in this object - even if it's a private key.
		*m: importpublickeyobj		&& Introduced in version 9.5.0.40. Imports a public key from a public key object. The imported public key is used in methods that encrypt data or verify signatures. Returns 1 for success, 0 for failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat RSA LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat RSA LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat RSA LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat RSA LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat RSA LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat RSA LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat RSA LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: littleendian_access		&& Access method used to retrieve the Chilkat RSA LittleEndian property.
		*m: littleendian_assign		&& Assign method used to hold a reference to the LittleEndian property.
		*m: nounpad_access		&& Access method used to retrieve the Chilkat RSA NoUnpad property.
		*m: nounpad_assign		&& Assign method used to hold a reference to the NoUnpad property.
		*m: numbits_access		&& Access method used to retrieve the Chilkat RSA NumBits property.
		*m: numbits_assign		&& Assign method used to hold a reference to the NumBits property.
		*m: oaephash_access		&& Access method used to retrieve the Chilkat RSA OAEPHash property.
		*m: oaephash_assign		&& Assign method used to hold a reference to the OAEPHash property.
		*m: oaeplabel_access		&& Access method used to retrieve the Chilkat RSA OAEPLabel property.
		*m: oaeplabel_assign		&& Assign method used to hold a reference to the OAEPLabel property.
		*m: oaepmgfhash_access		&& Access method used to retrieve the Chilkat RSA OAEPMGFHash property.
		*m: oaepmgfhash_assign		&& Assign method used to hold a reference to the OAEPMGFHash property.
		*m: oaeppadding_access		&& Access method used to retrieve the Chilkat RSA OAEPPadding property.
		*m: oaeppadding_assign		&& Assign method used to hold a reference to the OAEPPadding property.
		*m: opensslsignbd		&& Introduced in version 9.5.0.77. Duplicates OpenSSL's rsautl utility for creating RSA signatures. The contents of bd are signed. If successful, the result is that bd contains the RSA signature that itself contains (embeds) the original data.
		*m: opensslsignbytes		&& Duplicates OpenSSL's rsautl utility for creating RSA signatures. Input data consists of binary bytes, and returns the signature bytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: opensslsignbytesenc		&& Duplicates OpenSSL's rsautl utility for creating RSA signatures. Input data consists of binary bytes, and returns the signature as a string encoded according to the EncodingMode property (base64, hex, etc.).
		*m: opensslsignstring		&& Duplicates OpenSSL's rsautl utility for creating RSA signatures. Input data is a string, and returns the signature bytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: opensslsignstringenc		&& Duplicates OpenSSL's rsautl utility for creating RSA signatures. Input data is a string, and returns the signature as a string encoded according to the EncodingMode property (base64, hex, etc.). Returns Nothing on failure.
		*m: opensslverifybd		&& Introduced in version 9.5.0.77. Duplicates OpenSSL's rsautl utility for verifying RSA signatures and recovering the original data. On input, the bd contains the RSA signature that embeds the original data.
		*m: opensslverifybytes		&& Duplicates OpenSSL's rsautl utility for verifying RSA signatures and recovering the original data. Input data consists of the raw signature bytes and returns the original bytes. Returns a zero-length byte array (as a Variant) on failure.
		*m: opensslverifybytesenc		&& Duplicates OpenSSL's rsautl utility for verifying RSA signatures and recovering the original data. Input data is a signature string encoded according to the EncodingMode property (base64, hex, etc.). Returns the original bytes.
		*m: opensslverifystring		&& Duplicates OpenSSL's rsautl utility for verifying RSA signatures and recovering the original data. Input data consists of the raw signature bytes and returns the original string. Returns Nothing on failure.
		*m: opensslverifystringenc		&& Duplicates OpenSSL's rsautl utility for verifying RSA signatures and recovering the original data. Input data is a signature string encoded according to the EncodingMode property (base64, hex, etc.). Returns the original string.
		*m: pkcspadding_access		&& Access method used to retrieve the Chilkat RSA PKCSPadding property.
		*m: pkcspadding_assign		&& Assign method used to hold a reference to the PKCSPadding property.
		*m: psssaltlen_access		&& Access method used to retrieve the Chilkat RSA PSSSaltLen property.
		*m: psssaltlen_assign		&& Assign method used to hold a reference to the PSSSaltLen property.
		*m: setx509cert		&& Introduced in version 9.5.0.73. Provides the private or public key indirectly through a certificate. This method is especially useful on Windows computers where the private key is installed as non-exportable (such as on a hardware token).
		*m: signbd		&& Introduced in version 9.5.0.77. Creates an RSA digital signature by hashing the contents of bdData and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512".
		*m: signbytes		&& Creates an RSA digital signature by hashing binaryData and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*m: signbytesenc		&& Creates an RSA digital signature by hashing binaryData and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*m: signhash		&& The same as the SignBytes method, except the hash to be signed is passed directly. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: signhashenc		&& The same as SignBytesENC except the hash is passed directly. Returns Nothing on failure.
		*m: signrawbd		&& Introduced in version 11.0.0. This is legacy low-level raw RSA that duplicates the (now deprecated) OpenSSL rsautl utility. It directly signs raw data rather than signing a hash of the data. PKCS#1 v1.5 padding is always used.
		*m: signstring		&& Creates an RSA digital signature by hashing strToBeHashed and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*m: signstringenc		&& Creates an RSA digital signature by hashing strToBeHashed and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*m: snktoxml		&& Imports a .snk file to an XML document that can be imported via the ImportPrivateKey method. Returns Nothing on failure
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: useprivatekey		&& Introduced in version 11.0.0. Imports a private key from privKey to use for signing or decrypting. Returns 1 for success, 0 for failure.
		*m: usepublickey		&& Introduced in version 11.0.0. Imports a public key from pubKey to use for encrypting or signature verification.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat RSA VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifybd		&& Introduced in version 9.5.0.77. Verifies an RSA digital signature. Returns 1 if the signature in bdSig is valid an confirms that the original data in bdData has not been modified.
		*m: verifybytes		&& Verifies an RSA digital signature. Returns 1 if the signature is valid for the originalData. The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*m: verifybytesenc		&& Verifies an RSA digital signature. Returns 1 if the signature is valid for the originalData. The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*m: verifyhash		&& The same as VerifyBytes except the hash of the original data is passed directly.
		*m: verifyhashenc		&& The same as VerifyBytesENC except the hash of the original data is passed directly.
		*m: verifyprivatekey		&& Returns 1 if the XML contains a valid RSA private key. Otherwise returns 0. Returns 1 for success, 0 for failure.
		*m: verifyrawbd		&& Introduced in version 11.0.0. This is legacy low-level raw RSA that duplicates the (now deprecated) OpenSSL rsautl utility.
		*m: verifystring		&& Verifies an RSA digital signature. Returns 1 if the signature is valid for the originalString. The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*m: verifystringenc		&& Verifies an RSA digital signature. Returns 1 if the signature is valid for the originalString. The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*p: charset		&& This property only applies when encrypting, decrypting, signing, or verifying signatures for strings. When encrypting strings, the input string is first converted to this charset before encrypting.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: encodingmode		&& Encoding mode to be used in methods ending in "ENC", such as EncryptStringENC. Valid EncodingModes are "base64", "hex", "url", or "quoted-printable" (or "qp").
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: littleendian		&& The default value is 0, which means that signatures and encrypted output will be created using the big endian byte ordering. A value of 1 will produce little-endian output, which is what Microsoft's Crypto API produces.
		*p: nounpad		&& If 1, skips unpadding when decrypting. The default is 0. This property value is typically left unchanged.
		*p: numbits		&& The number of bits of the key generated or imported into this RSA encryption object. Keys ranging in size from 384 bits to 4096 bits can be generated by calling GenerateKey.
		*p: oaephash		&& Introduced in version 9.5.0.48. Selects the hash algorithm for use within OAEP padding. The valid choices are "sha1", "sha256", "sha384", "sha512", "md2", "md5", "haval", "ripemd128", "ripemd160","ripemd256", or "ripemd320".
		*p: oaeplabel		&& Introduced in version 9.5.0.95. The optional RSA encryption OAEP label. This property is the hex representation of the OAEP label bytes to be used when encrypting with OAEP padding.
		*p: oaepmgfhash		&& Introduced in version 9.5.0.71. Selects the MGF (mask generation) hash algorithm for use within OAEP padding. The valid choices are "sha1", "sha256", "sha384", "sha512", "md2", "md5", "haval", "ripemd128", "ripemd160","ripemd256", or "ripemd320".
		*p: oaeppadding		&& Controls whether Optimal Asymmetric Encryption Padding (OAEP) is used for the padding scheme (for encrypting/decrypting). If set to 0, PKCS1 v1.5 padding is used. If set to 1, PKCS1 v2.0 (OAEP) padding is used.
		*p: pkcspadding		&& Introduced in version 11.0.0. This property controls padding for both signing and encryption. The default value is true, which is to use PKCS#1 v1.5 padding.
		*p: psssaltlen		&& Introduced in version 9.5.0.80. Selects the PSS salt length when RSASSA-PSS padding is selected for signatures. The default value is -1 to indicate that the length of the hash function should be used.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Rsa
		charset = 
		debuglogfilepath = 
		encodingmode = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		littleendian = 0
		Name = "rsa"
		nounpad = 0
		numbits = 0
		oaephash = sha256
		oaeplabel = 
		oaepmgfhash = sha256
		oaeppadding = 0
		pkcspadding = 0
		psssaltlen = -1
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE charset_access		&& Access method used to retrieve the Chilkat RSA Charset property.
		*==============================================================================
		* Method:            Charset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat RSA Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Charset
		* Date Added:        07/11/2022
		*==============================================================================
		
		** 
		** This property only applies when encrypting, decrypting, signing, or verifying signatures for strings. 
		** When encrypting strings, the input string is first converted to this charset before encrypting.
		** 
		** When decrypting, the decrypted data is interpreted as a string 
		** with this charset encoding and converted to the appropriate return. 
		** For example, ActiveX's returning strings always return Unicode (2 bytes/char). 
		** Java strings are utf-8. Chilkat C++ strings are ANSI or utf-8. .NET strings are Unicode.
		** 
		** The default value of this property is the ANSI charset of the local computer.
		** 
		** When signing string data, the input string is first converted 
		** to this charset before being hashed and signed. 
		** When verifying the signature for string data, 
		** the input string is first converted to this charset before the verification process begins.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE charset_assign		&& Assign method used to hold a reference to the Charset property.
		*==============================================================================
		* Method:            Charset_Assign
		* Purpose:           Assign method used to hold a reference to the Charset property.
		* Author:            Bill Anderson
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Charset property.
		* Returns:           
		* Date Added:        07/11/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Removed the UnlockComponent method.
		
		  OaepHash and OaepMgfHash default properties changed to sha256.
		
		  Added the PkcsPadding property.
		
		  Added the GenKey, SignRawBd, UsePrivateKey, UsePublicKey and VerifyRawBd methods.
		
		  Decremented the OAEPPadding property.
		
		  Decremented the ExportPrivateKey, ExportPrivateKeyObj, ExportPublicKey, ExportPublicKeyObj, 
		  GenerateKey, ImportPrivateKey, ImportPrivateKeyObj, ImportPublicKey, ImportPublicKeyObj, 
		  OpenSslSignBd, OpenSslSignBytes, OpenSslSignBytesENC, OpenSslStringBytes, OpenSslStringBytesENC, 
		  OpenSslSignString, OpenSslSignStringENC, OpenSslVerifyBd, OpenSslVerifyBytes, OpenSslVerifyBytesENC,
		  OpenSslVerifyString and OpenSslVerifyStringENC methods.
		
		** Version 95
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		** Version 83
		
		  Added the SHA3 hash algorithms: sha3-224, sha3-256, sha3-384, sha3-512.
		  The SHA3 hash algorithms may generally be used in any property or method
		  of any Chilkat class where a hash algorithm is specified.
		
		** Version 80
		
		  Added the PssSaltLen property. The default value is -1, which is to use
		  the hash algorithm length for the RSA PSS salt length.
		  This property was added to satisify a customer system
		  that required the PSS salt length to specifically be 20 bytes.
		
		** Version 77
		
		  Added the following methods: OpenSslSignBd, OpenSslVerifyBd, SignBd, VerifyBd.
		
		** Version 76
		
		  Added the EncryptBd and DecryptBd methods.
		
		** Version 73
		
		  Added the SetX509Cert method to make it easy to use the private key of certificate.
		  Also allows for A3 certificates where the private key is non-exportable
		  (on a Windows system) such as on a hardware token.
		
		** Version 71
		
		  Added the OapeMgfHash property to the Email, Crypt2, Mime, and Rsa classes.
		
		** Version 69
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		** Version 67
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 49
		
		  Fixed the LittleEndian property behavior for encryption/decryption.
		
		  Now supports 8192 bits.
		
		  The XML representation of the keys will now omit leading 0 byte if it exists.
		  (Each part of the private key is a very large unsigned integer.
		  When the most significant bit is 1, Chilkat previously prepended a 0 byte to make it non-negative.
		  In hex representation, this would be obvious to see. However, in Base64 representation,
		  an extra null byte at the beginning changes the Base64 string completely,
		  and therefore looks different than the same key encoded without the leading 0 byte.
		  To clarify: suppose you have the number 15. This could be represented as a single byte 0x0F.
		  It could also be represented by 0x000F. Any number of leading zero bytes does not change the number.)
		
		** Version 48
		
		  Added the OaepHash property so that any hash algorithm can be used with OAEP padding (such as SHA256).
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		** Version 40
		
		  Added methods to the Rsa object for importing and exporting public/private keys directly to objects.
		
		  Review the online reference documentation for new methods or properties
		  for Ftp2, TrustedRoots, Rsa, Mime, Cert, Email, Imap, MailMan, Crypt2,
		  Http, Zip, Pfx, XmlCertVault, CertChain, and Upload.
		  New entries are clearly marked by the version in which they are introduced.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat RSA DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat RSA DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/11/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat RSA DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/11/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE decryptbd		&& Introduced in version 9.5.0.76. RSA decrypts the contents of bd. usePrivateKey should be set to 1 if the private key is to be used for decrypting. Otherwise it should be set to 0 if the public key is to be used for decrypting.
		*==============================================================================
		* Method:            DecryptBd
		* Purpose:           RSA decrypts the contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/11/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** RSA decrypts the contents of bd. usePrivateKey should be set to 1 
		** if the private key is to be used for decrypting. 
		** Otherwise it should be set to 0 if the public key is to be used for decrypting.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown, ;
		liUsePrivateKey AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUsePrivateKey, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.DecryptBd(m.loChilkatBinData, m.liUsePrivateKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptbytes		&& Decrypts byte data using the RSA encryption algorithm. usePrivateKey should be set to 1 if the private key is to be used for decrypting. Otherwise it should be set to 0 if the public key is to be used for decrypting.
		*==============================================================================
		* Method:            DecryptBytes
		* Purpose:           Decrypts byte data using the RSA encryption algorithm.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to decrypt. 
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           The decrypted binary data bytes.
		* Date Added:        07/11/2022
		*==============================================================================
		
		**
		** Decrypts byte data using the RSA encryption algorithm. 
		** usePrivateKey should be set to 1 if the private key is to be used for decrypting. 
		** Otherwise it should be set to 0 if the public key is to be used for decrypting.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqData AS VarBinary, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, liUsePrivateKey AS Integer, lqDecryptedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDecryptedBytes
		
		liUsePrivateKey = .F.
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
