		RETURN
	ENDPROC

	PROCEDURE lastnlines		&& Introduced in version 9.5.0.62. Returns the last N lines of the text. If fewer than numLines lines exists, then all of the text is returned.
		*==============================================================================
		* Method:            LastNLines
		* Purpose:           Returns the last N lines of the text.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiNumLines, the number of lines to return.
		*                    tuUseCRLF, return CRLF as line endings.
		* Returns:           lcLines, the lines to return.
		* Date Added:        03/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62.
		**
		** Returns the last N lines of the text. 
		** If fewer than numLines lines exists, then all of the text is returned. 
		** If bCrlf is 1, then the line endings of the returned string are converted to CRLF, 
		** otherwise the line endings are converted to LF-only.
		**
		** Fixed in version 69: Fixed a bug in this method.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiNumLines AS Integer, tuUseCRLF AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, liUseCRLF AS Integer, ;
		lcLines AS Character
		
		STORE 0 TO m.liIntroducedInBuild, m.liUseCRLF 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcLines = []
		llImplemented = .F.
		liIntroducedInBuild = 62
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUseCRLF = .LogicalToBit(m.tuUseCRLF)
		
		      TRY
		
		        lcLines = m.loChilkatObject.LastNLines(m.tiNumLines, m.liUseCRLF)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcLines
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

