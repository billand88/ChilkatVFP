	PROCEDURE setbinarycontent		&& Sets the node's content to a block of binary data with optional Zip compression and/or AES encryption. The binary data is automatically converted to base64 format whenever XML text is generated.
		*==============================================================================
		* Method:            SetBinaryContent
		* Purpose:           Sets the node's content to a block of binary data 
		*                    with optional Zip compression and/or AES encryption.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqContent -- the binary content to set.
		*                    tuUnZip -- determines whether or not unzipping is needed.
		*                    tuAESDecryption -- determines if AES encryption was used.
		*                    tcPassword -- the password for the Zip file
		* Returns:           Binary content
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Sets the node's content to a block of binary data 
		** with optional Zip compression and/or AES encryption. 
		** The binary data is automatically converted 
		** to base64 format whenever XML text is generated. 
		** If the zipFlag is True, the data is first compressed. 
		** If the encryptFlag is True, the data is AES encrypted 
		** using the Rijndael 128-bit symmetric-encryption algorithm.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqContent AS VarBinary, tuUnZip AS Unknown, ;
		tuAESDecryption AS Unknown, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liUnZip AS Integer, ;
		liAESDecryption AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUnZip, m.liAESDecryption
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUnZip = .LogicalToBit(m.tuUnZip)
		    liAESDecryption = .LogicalToBit(m.tuAESDecryption)
		
		    TRY
		
		      STORE m.loChilkatObject.SetBinaryContent(m.tqContent, ;
		      m.liUnZip, m.liAESDecryption, m.tcPassword) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setbinarycontentbd		&& Introduced in version 11.0.0. Sets the element's content to binary data with optional Zip compression and/or AES encryption.
		*==============================================================================
		* Method:            SetBinaryContentBd
		* Purpose:           Sets the element's content to binary data 
		*                    with optional Zip compression and/or AES encryption. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData -- a Chilkat Binary Data object.
		*                    tuUnZip -- determines whether or not unzipping is needed.
		*                    tuAESDecryption -- determines if AES encryption was used.
		*                    tcPassword -- the password for the Zip file
		* Returns:           Binary content
		* Date Added:        05/01/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0.
		**
		** Sets the element's content to binary data with optional Zip compression and/or AES encryption. 
		** The binary data is automatically converted to base64 format whenever XML text is generated. 
		** If the zipFlag is 1, the data is first compressed. If the encryptFlag is 1, 
		** the data is AES encrypted using the Rijndael 128-bit symmetric-encryption algorithm.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		tuUnZip AS Unknown, tuAESDecryption AS Unknown, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		liReturn AS Integer, luReturn AS Unknown, liUnZip AS Integer, ;
		liAESDecryption AS Integer, loChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUnZip, m.liAESDecryption
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatBinData, loParkParameterBinData 
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      liUnZip = .LogicalToBit(m.tuUnZip)
		      liAESDecryption = .LogicalToBit(m.tuAESDecryption)
		
		      TRY
		
		        STORE m.loChilkatObject.SetBinaryContentBd(m.loChilkatBinData, ;
		        m.liUnZip, m.liAESDecryption, m.tcPassword) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setbinarycontentfromfile		&& Sets the node's content with binary (or text) data from a file. The file contents can be Zip compressed and/or encrypted, and the result is base-64 encoded. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetBinaryContentFromFile
		* Purpose:           Sets the node's content with binary (or text) data from a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
