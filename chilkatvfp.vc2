		LOCAL loChilkatObject AS CHILKAT_BZ2_COM_CALL, ;
		loException AS Exception, lqBz2FileData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqBz2FileData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
