	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat CertStore VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/27/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS charset AS ibasechilkat OF "chilkatvfp.vcx" 		&& A component/class for converting character data from one encoding to another. This software is unique in that the data required for converting to/from the supported charsets is entirely embedded witin the Chilkat DLL/library. Decremented in Version 11.0.0
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: alttocharset_access		&& Access method used to retrieve the Chilkat Charset AltToCharset property.
		*m: alttocharset_assign		&& Assign method used to hold a reference to the AltToCharset property.
		*m: charsettocodepage		&& Converts a charset name to a code page number. For example, "iso-8859-1" converts to code page 28591.
		*m: codepagetocharset		&& Converts a code page number to a charset name. For example, 65001 converts to "utf-8". Returns Nothing on failure
		*m: convertdata		&& Converts character data from one charset to another. Before calling ConvertData, the FromCharset and ToCharset properties must be set to the source and destination charset names, such as "iso-8859-1" or "Shift_JIS".
		*m: convertfile		&& Converts a file from one character encoding to another. The FromCharset and ToCharset properties specify the source and destination character encodings. If the ToCharset is utf-16 or utf-8, then the preamble (also known as BOM) is included in the output.
		*m: convertfilenopreamble		&& Converts a file from one character encoding to another. The FromCharset and ToCharset properties specify the source and destination character encodings. No preamble (also known as BOM) is included in the output.
		*m: convertfromunicode		&& Converts Unicode (utf-16) text to the charset specified by the ToCharset property. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: convertfromutf16		&& Converts utf-16 text to the charset specified by the ToCharset property. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: converthtml		&& Converts HTML text from one character encoding to another. The FromCharset and ToCharset properties must be set prior to calling this method. This method automatically edits the META tag within the HTML that indicates the charset.
		*m: converthtmlfile		&& Converts an HTML file from one character encoding to another. The ToCharset properties must be set prior to calling this method. If the FromCharset is not set, it is obtained from the HTML META tag that indicates the charset.
		*m: converttounicode		&& Converts multibyte character data to a Unicode string. The FromCharset property should be set before calling this method. Returns Nothing on failure.
		*m: converttoutf16		&& Converts the mbData to utf-16 bytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Charset DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: entityencodedec		&& Converts non-US-ASCII characters to Unicode decimal entities (&#xxxxx;) Returns Nothing on failure.
		*m: entityencodehex		&& Converts non-US-ASCII characters to Unicode hex entities (&#xXXXX;) Returns Nothing on failure.
		*m: erroraction_access		&& Access method used to retrieve the Chilkat Charset ErrorAction property.
		*m: erroraction_assign		&& Assign method used to hold a reference to the ErrorAction property.
		*m: fromcharset_access		&& Access method used to retrieve the Chilkat Charset FromCharset property.
		*m: fromcharset_assign		&& Assign method used to hold a reference to the FromCharset property.
		*m: gethtmlcharset		&& Examines HTML text and extracts the charset name specified by the META tag, if present. Returns Nothing on failure.
		*m: gethtmlfilecharset		&& Examines an HTML file and extracts the charset name specified by the META tag, if present. Returns Nothing on failure.
		*m: htmldecodetostr		&& Converts HTML entities to Unicode characters. Returns Nothing on failure.
		*m: htmlentitydecode		&& Decodes HTML entities. See http://www.w3.org/TR/REC-html40/sgml/entities.html for information on HTML entities. Examples of HTML entities are &lt; , &#229; , &#xE5; , &#x6C34; , &Iacute; , etc. Returns a zero-length byte array (as a Variant) on failure.
		*m: htmlentitydecodefile		&& Decodes HTML entities in a file and creates a new HTML file with the entities decoded. See http://www.w3.org/TR/REC-html40/sgml/entities.html for information on HTML entities.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Charset LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Charset LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Charset LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Charset LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastinputashex_access		&& Access method used to retrieve the Chilkat Charset LastInputAsHex property.
		*m: lastinputashex_assign		&& Assign method used to hold a reference to the LastInputAsHex property.
		*m: lastinputasqp_access		&& Access method used to retrieve the Chilkat Charset LastInputAsQP property.
		*m: lastinputasqp_assign		&& Assign method used to hold a reference to the LastInputAsQP property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Charset LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastoutputashex_access		&& Access method used to retrieve the Chilkat Charset LastOutputAsHex property.
		*m: lastoutputashex_assign		&& Assign method used to hold a reference to the LastOutputAsHex property.
		*m: lastoutputasqp_access		&& Access method used to retrieve the Chilkat Charset LastOutputAsQP property.
		*m: lastoutputasqp_assign		&& Assign method used to hold a reference to the LastOutputAsQP property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Charset LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Charset LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: lowercase		&& Converts a string to lowercase. Returns Nothing on failure.
		*m: readfile		&& Convenience method for reading the entire contents of a file into a byte array. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: readfiletostring		&& Reads a text file and returns the text converted to a Unicode string. The filename is specified by the first method argument, and the charset of the text data is specified by the 2nd method argument. Returns Nothing on failure.
		*m: savelast_access		&& Access method used to retrieve the Chilkat Charset SaveLast property.
		*m: savelast_assign		&& Assign method used to hold a reference to the SaveLast property.
		*m: seterrorbytes		&& If the ErrorAction property is set to 1, the bytes passed to this method are used as the result for any characters that cannot be converted during a conversion.
		*m: seterrorstring		&& If the ErrorAction property is set to 1, the string passed to this method is used as the result for any characters that cannot be converted during a conversion.
		*m: tocharset_access		&& Access method used to retrieve the Chilkat Charset ToCharset property.
		*m: tocharset_assign		&& Assign method used to hold a reference to the ToCharset property.
		*m: unlockcomponent		&& Unlocks the component. This method must be called once at the beginning of the program. Properties can be get/set without unlocking, but methods will not work unless the component has been unlocked. Returns 1 for success, 0 for failure.
		*m: uppercase		&& Converts a string to uppercase. Returns Nothing on failure.
		*m: urldecodestr		&& URL decodes a string. Returns Nothing on failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Charset VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifydata		&& Returns true if the byte data conforms to the charset passed in the first argument.
		*m: verifyfile		&& Returns true if the file contains character data that conforms to the charset passed in the 1st argument.
		*m: writefile		&& Convenience method for saving an entire byte array to a file.
		*m: writestringtofile		&& Converts a Unicode string to a multibyte charset and writes the multibyte text data to a file. The destination charset is specified in the 2nd method argument. Returns 1 for success, 0 for failure.
		*p: alttocharset		&& If the ErrorAction property is set to 6, then this property controls how errors are handled. It specifies an alternate "To" charset.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: erroraction		&& Controls how errors are handled. When a character in the input data cannot be converted to the target charset, the action taken is controlled by this property.
		*p: fromcharset		&& Tells the charset converter the charset of the input data for a conversion.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastinputashex		&& If SaveLast is set to true, then the input and output of a conversion is saved to allow the exact bytes that are sent to the converter to be seen (for debugging purposes). This property shows the last input data in a hexidecimalized string.
		*p: lastinputasqp		&& If SaveLast is set to true, then the input and output of a conversion is saved to allow the exact bytes that are sent to the converter to be seen (for debugging purposes). This property shows the last input data in a quoted-printable string.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: lastoutputashex		&& If SaveLast is set to true, then the input and output of a conversion is saved to allow the exact bytes that are sent to the converter to be seen (for debugging purposes). This property shows the last output data in a hexidecimalized string.
		*p: lastoutputasqp		&& If SaveLast is set to true, then the input and output of a conversion is saved to allow the exact bytes that are sent to the converter to be seen (for debugging purposes). This property shows the last output data in a quoted-printable string.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: savelast		&& Tells the component to keep the input/output byte data in memory after a conversion is complete so the data can be examined via the LastInputAsHex/QP and LastOutputAsHex/QP properties. (for debugging purposes)
		*p: tocharset		&& Tells the charset converter the target charset for a conversion.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		alttocharset = 
		cchilkatclass = Charset
		debuglogfilepath = 
		erroraction = 0
		fromcharset = utf-8
		iretirementmajor = 12
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastinputashex = 
		lastinputasqp = 
		lastmethodsuccess = 1
		lastoutputashex = 
		lastoutputasqp = 
		laststringresult = 
		laststringresultlen = 0
		Name = "charset"
		savelast = 0
		tocharset = utf-8
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE alttocharset_access		&& Access method used to retrieve the Chilkat Charset AltToCharset property.
		*==============================================================================
		* Method:            AltToCharset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Charset AltToCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AltToCharset
		* Date Added:        07/26/2022
		*==============================================================================
		
		** 
		** If the ErrorAction property is set to 6, then this property controls 
		** how errors are handled. It specifies an alternate "To" charset. 
		** When a character in the input data cannot be converted to the target charset, 
		** an attempt is made to convert it to the AltToCharset. 
		** If that fails, the input character is dropped.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE alttocharset_assign		&& Assign method used to hold a reference to the AltToCharset property.
		*==============================================================================
		* Method:            AltToCharset_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Charset AltToCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the AltToCharset property.
		* Returns:           
		* Date Added:        07/26/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE charsettocodepage		&& Converts a charset name to a code page number. For example, "iso-8859-1" converts to code page 28591.
		*==============================================================================
		* Method:            CharsetToCodePage
		* Purpose:           Converts a charset name to a code page number. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset, the charset name to convert.
		* Returns:           The code page number.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Converts a charset name to a code page number. 
		** For example, "iso-8859-1" converts to code page 28591.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, liCodePage AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liCodePage = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liCodePage = m.loChilkatObject.CharsetToCodePage(m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liCodePage
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Class decremented. Class will be removed in version 12.0.0.
		
		  Removed the UnlockComponent method.
		
		** Version 99
		
		  The Charset.ConvertFile method did not correctly recognize the “no-bom” if converting to “no-bom-utf8” 
		  (which is the utf-8 encoding without the utf-8 preamble consisting of the 3-bytes EF BB BF). 
		  In other words, Chilkat was adding the EF BB BF preamble when it should not.
		
		** Version 91
		
		  Fixed behavior when ErrorAction property is set to value 1
		  to replace non-convertable chars with a pre-specified char.
		
		** Version 77
		
		  Fixed problems converting to/from EBCDIC.
		
		** Version 76
		
		  Fixed: The EntityEncodeDec method did not emit the terminating semicolon for decimal entities.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  Fixed problems in the VerifyData method having to do with us-ascii and utf-8.
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object..)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE codepagetocharset		&& Converts a code page number to a charset name. For example, 65001 converts to "utf-8". Returns Nothing on failure
		*==============================================================================
		* Method:            CodePageToCharset
		* Purpose:           Converts a code page number to a charset name.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiCodePage, the code page number
		* Returns:           lcCharset, the charset tied to the code page.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Converts a code page number to a charset name. For example, 65001 converts to "utf-8".
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiCodePage AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, lcCharset AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcCharset = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcCharset = m.loChilkatObject.CodePageToCharset(m.tiCodePage)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcCharset
		
		** Design time IntelliSense test
