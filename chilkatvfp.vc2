		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      m.loChilkatObject.Subtract(m.loChilkatStringArray)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatStringArray = ;
		    m.loParkParameterStringArray.SetObject(m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE trim_access		&& Access method used to retrieve the Chilkat StringArray Trim property.
		*==============================================================================
		* Method:            Trim_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat StringArray Trim property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Trim
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** If 1, whitespace, including carriage-returns and linefeeds, 
		** are automatically removed from the beginning 
		** and end of a string when added to the collection.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE trim_assign		&& Assign method used to hold a reference to the Trim property.
		*==============================================================================
		* Method:            Trim_Assign
		* Purpose:           Assign method used to hold a reference to the Trim property.
		* Author:            Bill Anderson
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the Trim property.
		* Returns:           
		* Date Added:        06/26/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE union		&& Performs the union set-operator. The result is that the caller will have a string collection that is the union of itself and stringArrayObj.
		*==============================================================================
		* Method:            Union
		* Purpose:           Performs the union set-operator.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringArray, a Chilkat String Array object.
		* Returns:           
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Performs the union set-operator. The result is that the caller 
		** will have a string collection that is the union of itself and stringArrayObj.
		**
		
		LPARAMETERS toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_STRINGARRAY_COM_CALL, loException AS Exception, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      m.loChilkatObject.Union(m.loChilkatStringArray)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatStringArray = ;
		    m.loParkParameterStringArray.SetObject(m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE unique_access		&& Access method used to retrieve the Chilkat StringArray Unique property.
		*==============================================================================
		* Method:            Unique_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat StringArray Unique property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Unique
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** If 1, then duplicates are not allowed. When an attempt is made to insert 
		** a string that already exists, the duplicate insertion is silently suppressed 
		** and no error is returned. The default value is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE unique_assign		&& Assign method used to hold a reference to the Unique property.
		*==============================================================================
		* Method:            Unique_Assign
		* Purpose:           Assign method used to hold a reference to the Unique property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the Unique property.
		* Returns:           
		* Date Added:        06/26/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat StringArray VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/26/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
