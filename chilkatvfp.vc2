	PROCEDURE eval		&& Introduced in version 11.4.0. Run jscript as a script. Return output and errors in result. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Eval
		* Purpose:           Run jscript as a script.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat StringBuilder object.
		*                    toChilkatJsonObject, a Chilkat JsonObject object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/07/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0.
		**
		** Run jscript as a script. Return output and errors in result.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStringBuilder AS [Chilkat.StringBuilder], toChilkatJsonObject AS [Chilkat.JsonObect]
		
		LOCAL loChilkatObject AS [Chilkat.Js], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS [Chilkat.StringBuilder], liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS [Chilkat.JsonObect]
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.Eval(m.loChilkatStringBuilder, m.loChilkatJsonObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.oChilkatStringBuilder, m.loChilkatStringBuilder)
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.oChilkatJsonObject, m.loChilkatJsonObject)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Js])
		  toChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder])
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder])
		  toChilkatJsonObject = NEWOBJECT([Chilkat.JsonObect])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT([Chilkat.JsonObect])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE evalasync		&& Introduced in version 11.4.0. Creates an asynchronous task to call the Eval method with the arguments provided.
		*==============================================================================
		* Method:            EvalAsync
		* Purpose:           Creates an asynchronous task to call the Eval 
		*                    method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toStringBuilder, a Chilkat StringBuilder object.
		*                    toChilkatJsonObject, a Chilkat JsonObject object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/07/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0.
		**
		** Creates an asynchronous task to call the Eval method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatStringBuilder AS [Chilkat.StringBuilder], toChilkatJsonObject AS [Chilkat.JsonObect]
		
		LOCAL loChilkatObject AS [Chilkat.Js], loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS [Chilkat.Task], ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS [Chilkat.StringBuilder], ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterStringBuilder, ;
		m.loChilkatStringBuilder, m.loParkParameterJsonObject, m.loChilkatJsonObject  
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.EvalAsync(m.loChilkatStringBuilder, m.loChilkatJsonObject)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterStringBuilder, ;
		m.loChilkatStringBuilder, m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Js])
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		  toChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder])
		  loParkParameterChilkatStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat Js LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        04/07/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0
		** 
		** This property is mainly used in SQL Server stored procedures 
		** to retrieve binary data from the last method call that returned binary data. 
		** It is only accessible if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This feature allows for the retrieval of large varbinary results in an SQL Server environment, 
		** which has restrictions on returning large data via method calls, 
		** though temp tables can handle binary properties.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 4
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

