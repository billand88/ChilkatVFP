		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE expect100continue_access		&& Access method used to retrieve the Chilkat Upload Expect100Continue property.
		*==============================================================================
		* Method:            Expect100Continue_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Upload Expect100Continue property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Expect100Continue
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** When 1, the request header will included an "Expect: 100-continue" header field. 
		** This indicates that the server should respond with an intermediate response 
		** of "100 Continue" or "417 Expectation Failed" response based 
		** on the information available in the request header. 
		** This helps avoid situations such as limits on upload sizes. 
		** It allows the server to reject the upload, and then the client can abort 
		** prior to uploading the data.
		** 
		** The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE expect100continue_assign		&& Assign method used to hold a reference to the Expect100Continue property.
		*==============================================================================
		* Method:            Expect100Continue_Assign
		* Purpose:           Assign method used to hold a reference to the Expect100Continue property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the Expect100Continue property.
		* Returns:           
		* Date Added:        06/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat Upload HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Upload HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** This property is only valid in programming environment 
		** and languages that allow for event callbacks.
		**
		** Specifies the time interval in milliseconds between AbortCheck events. 
		** A value of 0 (the default) indicate that no AbortCheck events will fire. 
		** Any HTTP operation can be aborted via the AbortCheck event.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

