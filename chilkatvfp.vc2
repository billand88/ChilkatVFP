		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS mime AS ibasechilkat OF "chilkatvfp.vcx" 		&& Chilkat MIME allows you to easily create and manipulate MIME and S/MIME messages from within your applications.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addcontentlength		&& Computes the size of the MIME body and adds a Content-Length header field with the computed value. If the MIME body is non-multipart, the Content-Length is just the size of the content.
		*m: adddecryptcert		&& Introduced in version 9.5.0.40. Makes a certificate available for decrypting if needed by methods that decrypt, such as UnwrapSecurity. This method may be called multiple times to make more than one certificate (and it's private key) available.
		*m: adddetachedsignature		&& Signs the message using the certificate provided. If successful, the message is converted to "multipart/signed" and the original message will be contained in the first sub-part. Returns 1 for success, 0 for failure.
		*m: adddetachedsignature2		&& Same as AddDetachedSignature, except an extra argument is provided to control whether header fields from the calling MIME object are transferred to the content part of the multipart/signed object.
		*m: adddetachedsignaturepk		&& Adds a detached signature using a certificate and it's associated private key.
		*m: adddetachedsignaturepk2		&& Same as AddDetachedSignaturePk, except an extra argument is provided to control whether header fields from the calling MIME object are transferred to the content part of the multipart/signed object.
		*m: addencryptcert		&& Adds a certificate to the object's internal list of certificates to be used when the EncryptN method is called. (See the EncryptN method for more information.) The internal list may be cleared by calling ClearEncryptCerts.
		*m: addheaderfield		&& Adds a header field to the MIME. Returns 1 for success, 0 for failure.
		*m: addpfxsourcebd		&& Introduced in version 11.0.0. Adds a PFX file to the object's list of sources for locating certificates and private keys during decryption or signing. To add multiple PFX sources, call this method for each file. Returns 1 for success, 0 for failure.
		*m: addpfxsourcedata		&& Adds a PFX to the object's internal list of sources to be searched for certificates and private keys when decrypting . Multiple PFX sources can be added by calling this method once for each.
		*m: addpfxsourcefile		&& Adds a PFX file to the object's internal list of sources to be searched for certificates and private keys when decrypting. Multiple PFX files can be added by calling this method once for each.
		*m: appendpart		&& Appends a MIME message to the sub-parts of this message. Arbitrarily complex messages with unlimited nesting levels can be created. If the calling Mime object is not already multipart, it is automatically converted to multipart/mixed first.
		*m: appendpartfromfile		&& Loads a file and creates a Mime message object using the file extension to determine the content type, and adds it as a sub-part to the calling object. Returns 1 for success, 0 for failure.
		*m: asnbodytoxml		&& When the body of a MIME part contains PKCS7 (ASN.1 in DER format, base64-encoded), this method can be used to convert the ASN.1 to an XML format for inspection.
		*m: boundary_access		&& Access method used to retrieve the Chilkat MIME Boundary property.
		*m: boundary_assign		&& Assign method used to hold a reference to the Boundary property.
		*m: charset_access		&& Access method used to retrieve the Chilkat MIME Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: clearencryptcerts		&& Clears the internal list of certificates added by previous calls to the AddEncryptCert method. (See the EncryptN method for information about encrypting using multiple certificates.)
		*m: cmsoptions_access		&& Access method used to retrieve the Chilkat MIME CMSOptions property.
		*m: cmsoptions_assign		&& Assign method used to hold a reference to the CMSOptions property.
		*m: containsencryptedparts		&& Returns 1 if the MIME message contains encrypted parts.
		*m: containssignedparts		&& Returns 1 if the MIME message contains signed parts. Note: This method examines the MIME as-is. If UnwrapSecurity is called and it is successful, then the MIME should no longer contain signed parts, and this method would return 0.
		*m: contenttype_access		&& Access method used to retrieve the Chilkat MIME ContentType property.
		*m: contenttype_assign		&& Assign method used to hold a reference to the ContentType property.
		*m: convert8bit		&& Changes the content-transfer-encoding to "base64" for all 8bit or binary MIME subparts. This allows for the MIME to be exported as a string via the GetMime method.
		*m: converttomultipartalt		&& Converts existing MIME to a multipart/alternative. This is accomplished by creating a new outermost multipart/alternative MIME part. The existing MIME is moved into the 1st (and only) sub-part of the new multipart/alternative enclosure.
		*m: converttomultipartmixed		&& Converts existing MIME to a multipart/mixed. This is accomplished by creating a new outermost multipart/mixed MIME part. The existing MIME is moved into the 1st (and only) sub-part of the new multipart/mixed enclosure.
		*m: converttosigned		&& Digitally signs a MIME message. The MIME is converted to an application/x-pkcs7-mime which is a PKCS7 signature that includes both the original MIME message and the signature.
		*m: converttosignedpk		&& Digitally signs the MIME to convert it to an "opaque" signed message using a certificate and it's associated private key.
		*m: currentdatetime_access		&& Access method used to retrieve the Chilkat MIME CurrentDateTime property.
		*m: currentdatetime_assign		&& Assign method used to hold a reference to the CurrentDateTime property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat MIME DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: decrypt		&& Decrypts PKCS7 encrypted MIME (also known as S/MIME). Information about the certificates required for decryption is always embedded within PKCS7 encrypted MIME.
		*m: decrypt2		&& The same as Decrypt, but useful when the certificate and private key are available in separate files (as opposed to a single file such as a .pfx/.p12). Returns 1 for success, 0 for failure.
		*m: decryptusingcert		&& Introduced in version 9.5.0.40. Decrypts PKCS7 encrypted MIME (also known as S/MIME) using a specific certificate. Returns 1 for success, 0 for failure.
		*m: decryptusingpfxdata		&& Decrypts MIME using a specific PFX ( also known as PKCS12, which is a file format commonly used to store private keys with accompanying public key certificates, protected with a password-based symmetric key).
		*m: decryptusingpfxfile		&& Decrypts MIME using a specific PFX file (also known as PKCS12) as the source for any required certificates and private keys. (Note: .pfx and .p12 files are both PKCS12 format.) Returns 1 for success, 0 for failure.
		*m: disposition_access		&& Access method used to retrieve the Chilkat MIME Disposition property.
		*m: disposition_assign		&& Assign method used to hold a reference to the Disposition property.
		*m: encoding_access		&& Access method used to retrieve the Chilkat MIME Encoding property.
		*m: encoding_assign		&& Assign method used to hold a reference to the Encoding property.
		*m: encrypt		&& Encrypts the MIME to create PKCS7 encrypted MIME. A digital certificate (which always contains a public-key) is used to encrypt. Returns 1 for success, 0 for failure.
		*m: encryptn		&& Encrypt MIME using any number of digital certificates. Each certificate to be used must first be added by calling AddEncryptCert (once per certificate). See the example code below: Returns 1 for success, 0 for failure.
		*m: extractpartstofiles		&& Recursively descends through the parts of a MIME message and extracts all parts having a filename to a file. The files are created in dirPath. Returns a (Ck)StringArray object containing the names of the files created.
		*m: filename_access		&& Access method used to retrieve the Chilkat MIME FileName property.
		*m: filename_assign		&& Assign method used to hold a reference to the FileName property.
		*m: findissuer		&& Finds and returns the issuer certificate. If the certificate is a root or self-issued, then the certificate returned is a copy of the caller certificate. Returns Nothing on failure
		*m: getbodybd		&& Introduced in version 9.5.0.67. Returns the body of the MIME message in a BinData object. Returns 1 for success, 0 for failure.
		*m: getbodybinary		&& Returns the body of the MIME message as a block of binary data. The body is automatically converted from its encoding type, suc h as base64 or quoted-printable, before being returned. Returns a zero-length byte array (as a Variant) on failure.
		*m: getbodydecoded		&& Returns the body of the MIME message as a string. The body is automatically converted from its encoding type, such as base64 or quoted-printable, before being returned. Returns Nothing on failure
		*m: getbodyencoded		&& Returns the body of the MIME message as a String. The body is explicitly not decoded from it's encoding type, so if it was represented in Base64, you will get the Base64 encoded body, as an example. Returns Nothing on failure.
		*m: getdecryptcertinfo		&& Introduced in version 11.4.0. Obtains details about the certificate(s) required to decrypt the encrypted S/MIME data. Returns 1 for success, 0 for failure.
		*m: getencryptcert		&& Returns the Nth certificate found when decrypting. The EncryptCerts property contains the number of certificates. Returns Nothing on failure
		*m: getentirebody		&& Returns the entire MIME body, including all sub-parts. Returns Nothing on failure
		*m: getentirehead		&& Returns the MIME header. Returns Nothing on failure
		*m: getheaderfield		&& Returns the value of a MIME header field. fieldName is case-insensitive. Returns Nothing on failure.
		*m: getheaderfieldattribute		&& Parses a MIME header field and returns the value of an attribute.
		*m: getheaderfieldname		&& Returns the Nth MIME header field name. Returns Nothing on failure
		*m: getheaderfieldvalue		&& Returns the Nth MIME header field value. Returns Nothing on failure
		*m: getmime		&& Returns a string containing the complete MIME message, including all sub-parts. Returns Nothing on failure.
		*m: getmimebd		&& Introduced in version 9.5.0.62. Appends the MIME to a BinData object. Returns 1 for success, 0 for failure.
		*m: getmimebytes		&& Returns a byte array containing the complete MIME message, including all sub-parts. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: getmimesb		&& Introduced in version 9.5.0.62. Appends the MIME to a StringBuilder object. Returns 1 for success, 0 for failure.
		*m: getpart		&& Returns the Nth sub-part of the MIME message. Indexing begins at 0. Returns Nothing on failure.
		*m: getsignaturesigningtime		&& Undocumented method!
		*m: getsignaturesigningtimestr		&& The same as the GetSignatureSigningTime method, but returns tjhe date/time in RFC822 string format. Returns Nothing on failure.
		*m: getsignercert		&& Returns the Nth digital certificate used to sign the MIME message. Indexing begins at 0. Returns Nothing on failure
		*m: getsignercertchain		&& Introduced in version 9.5.0.40. Returns the full certificate chain for the Nth certificate used to sign the MIME message. Indexing begins at 0. Returns Nothing on failure
		*m: getstructure		&& Introduced in version 9.5.0.56. Returns a string summarizing the MIME structure. The output format is specified by fmt and can be "text" or "xml". Returns Nothing on failure.
		*m: getxml		&& Converts the MIME (or S/MIME) message to XML and returns the XML as a string. Returns Nothing on failure.
		*m: hassignaturesigningtime		&& Returns 1 if the Nth signature included a timestamp that recorded the signing time. The number of signatures (i.e. signer certs) is indicated by the NumSignerCerts property.
		*m: isapplicationdata		&& Return 1 if the MIME message contains application data, otherwise returns 0.
		*m: isattachment		&& Return 1 if this MIME message is an attachment, otherwise returns 0. A MIME message is considered an attachment if the Content-Disposition header field contains the value "attachment".
		*m: isaudio		&& Return 1 if the MIME message contains audio data, otherwise returns 0.
		*m: isencrypted		&& Returns 1 if the MIME message is PKCS7 encrypted, otherwise returns 0.
		*m: ishtml		&& Return 1 if the MIME body is HTML, otherwise returns 0.
		*m: isimage		&& Return 1 if the MIME message contains image data, otherwise returns 0.
		*m: ismultipart		&& Return 1 if the MIME message is multipart (multipart/mixed, multipart/related, multipart/alternative, etc.), otherwise returns 0
		*m: ismultipartalternative		&& Return 1 if the MIME message is multipart/alternative, otherwise returns 0.
		*m: ismultipartmixed		&& Return true if the MIME message is multipart/mixed, otherwise returns 0.
		*m: ismultipartrelated		&& Return 1 if the MIME message is multipart/related, otherwise returns 0.
		*m: isplaintext		&& Return 1 if the MIME message body is plain text, otherwise returns 0.
		*m: issigned		&& Return 1 if the MIME message is PKCS7 digitally signed, otherwise returns 0.
		*m: istext		&& Return 1 if the MIME message body is any text content type, such as text/plain, text/html, text/xml, etc., otherwise returns 0.
		*m: isunlocked		&& Undocumented method! Returns true if the class has been unlocked.
		*m: isvideo		&& Return 1 if the MIME message contains video data, otherwise returns 0.
		*m: isxml		&& Return 1 if the MIME message body is XML, otherwise returns 0.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat MIME LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastdecryptcert		&& Introduced in version 11.0.0. Returns the Nth certificate found when decrypting. The NumDecryptCerts property contains the number of certificates. Returns 1 for success, 0 for failure.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat MIME LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat MIME LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat MIME LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastjsondata		&& Introduced in version 9.5.0.69. Provides information about what transpired in the last method called on this object instance. For many methods, there is no information.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat MIME LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastsignercert		&& Introduced in version 11.0.0. Returns in cert the Nth digital certificate used to sign the MIME message. Indexing begins at 0. Returns 1 for success, 0 for failure.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat MIME LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat MIME LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadmime		&& Discards the current contents of the MIME object and loads a new MIME message from a string. Returns 1 for success, 0 for failure.
		*m: loadmimebd		&& Introduced in version 9.5.0.62. Discards the current contents of the MIME object and loads a new MIME message from a BinData object. Returns 1 for success, 0 for failure.
		*m: loadmimebytes		&& Loads a MIME document from an in-memory byte array. Returns 1 for success, 0 for failure.
		*m: loadmimefile		&& Discards the current contents of the MIME object and loads a new MIME message from a file. Returns 1 for success, 0 for failure.
		*m: loadmimesb		&& Introduced in version 9.5.0.62. Discards the current contents of the MIME object and loads a new MIME message from a StringBuilder. Returns 1 for success, 0 for failure.
		*m: loadxml		&& Converts XML to MIME and replaces the MIME object's contents with the converted XML. Returns 1 for success, 0 for failure.
		*m: loadxmlfile		&& Converts XML to MIME and replaces the MIME object's contents with the converted XML. Returns 1 for success, 0 for failure.
		*m: micalg_access		&& Access method used to retrieve the Chilkat MIME MicAlg property.
		*m: micalg_assign		&& Assign method used to hold a reference to the MicAlg property.
		*m: mimename_access		&& Access method used to retrieve the Chilkat MIME Name property.
		*m: mimename_assign		&& Assign method used to hold a reference to the Name property.
		*m: newmessagerfc822		&& Clears the Mime object and initializes it such that the header contains a "content-type: message/rfc822" line and the body is the MIME text of the Mime object passed to the method. Returns 1 for success, 0 for failure.
		*m: newmultipartalternative		&& Discards the current MIME message header fields and contents, if any, an initializes the MIME object to be an empty mulipart/alternative message. Returns 1 for success, 0 for failure.
		*m: newmultipartmixed		&& Discards the current MIME message header fields and contents, if any, an initializes the MIME object to be an empty mulipart/mixed message. Returns 1 for success, 0 for failure.
		*m: newmultipartrelated		&& Discards the current MIME message header fields and contents, if any, an initializes the MIME object to be an empty mulipart/related message. Returns 1 for success, 0 for failure.
		*m: numdecryptcerts_access		&& Access method used to retrieve the NumDecryptCerts property of the referenced Chilkat object.
		*m: numdecryptcerts_assign		&& Assign method used to hold a reference to the NumDecryptCerts property.
		*m: numencryptcerts_access		&& Access method used to retrieve the Chilkat MIME NumEncrypttCerts property.
		*m: numencryptcerts_assign		&& Assign method used to hold a reference to the NumEncryptCerts property.
		*m: numheaderfields_access		&& Access method used to retrieve the Chilkat MIME NumHeaderFields property.
		*m: numheaderfields_assign		&& Assign method used to hold a reference to the NumHeaderFields property.
		*m: numparts_access		&& Access method used to retrieve the Chilkat MIME NumParts property.
		*m: numparts_assign		&& Assign method used to hold a reference to the NumParts property.
		*m: numsignercerts_access		&& Access method used to retrieve the Chilkat MIME NumSignerCerts property.
		*m: numsignercerts_assign		&& Assign method used to hold a reference to the NumSignerCerts property.
		*m: oaephash_access		&& Access method used to retrieve the Chilkat MIME OAEPHash property.
		*m: oaephash_assign		&& Assign method used to hold a reference to the OAEPHash property.
		*m: oaepmgfhash_access		&& Access method used to retrieve the Chilkat MIME OAEPMGFHash property.
		*m: oaepmgfhash_assign		&& Assign method used to hold a reference to the OAEPMGFHash property.
		*m: oaeppadding_access		&& Access method used to retrieve the Chilkat MIME OAEPPadding property.
		*m: oaeppadding_assign		&& Assign method used to hold a reference to the OAEPPadding property.
		*m: partat		&& Introduced in version 11.0.0. Returns the Nth sub-part in subPart, with indexing starting at 0. Returns 1 for success, 0 for failure.
		*m: partstofiles		&& Introduced in version 11.0.0. The function recursively traverses a MIME message, extracting and saving parts that have a filename. It saves these parts to the directory specified by path. Returns 1 for success, 0 for failure.
		*m: pkcs7cryptalg_access		&& Access method used to retrieve the Chilkat MIME PKCS7CryptAlg property.
		*m: pkcs7cryptalg_assign		&& Assign method used to hold a reference to the PKCS7CrypttAlg property.
		*m: pkcs7keylength_access		&& Access method used to retrieve the Chilkat MIME PKCS7KeyLength property.
		*m: pkcs7keylength_assign		&& Assign method used to hold a reference to the PKCS7KeyLength property.
		*m: protocol_access		&& Access method used to retrieve the Chilkat MIME Protocol property.
		*m: protocol_assign		&& Assign method used to hold a reference to the Protocol property.
		*m: removeheaderfield		&& Removes a header field from the MIME header. If bAllOccurrences is 1, then all occurrences of the header field are removed. Otherwise, only the 1st occurrence is removed.
		*m: removepart		&& Removes the Nth subpart from the MIME message. Returns 1 for success, 0 for failure.
		*m: savebody		&& Saves the MIME message body to a file. If the body is base64 or quoted-printable encoded, it is automatically decoded. Returns 1 for success, 0 for failure.
		*m: savemime		&& Saves the MIME message to a file, in MIME format. (This is the same as the .EML format used by Microsoft Outlook Express.) Returns 1 for success, 0 for failure.
		*m: savexml		&& Converts the MIME message to XML and saves to an XML file. Returns 1 for success, 0 for failure.
		*m: setbody		&& Sets the MIME body content to a text string.
		*m: setbodybd		&& Introduced in version 11.0.0. Sets the MIME message body from the bytes contained in bd. Returns 1 for success, 0 for failure.
		*m: setbodyfrombinary		&& Sets the MIME message body from a byte array. Returns 1 for success, 0 for failure.
		*m: setbodyfromencoded		&& Sets the MIME message body from a Base64 or Quoted-Printable encoded string. Returns 1 for success, 0 for failure.
		*m: setbodyfromfile		&& Sets the MIME message body from the contents of a file. Note: A MIME message consists of a header and a body. The body may itself be a MIME message that consists of a header and body, etc. T
		*m: setbodyfromhtml		&& Sets the MIME message body from a string containing HTML. The Content-Type header is added or updated to the value "text/html".
		*m: setbodyfromplaintext		&& Sets the MIME message body from a string containing plain-text. The Content-Type header is added or updated to the value "text/plain".
		*m: setbodyfromxml		&& Sets the MIME message body from a string containing XML. The Content-Type header is added or updated to the value "text/xml".
		*m: setcsp		&& Undocumented method! Accepts a (decremented) Chilkat CSP reference.
		*m: setheaderfield		&& Adds or replaces a MIME message header field. If the field already exists, it is automatically replaced. Otherwise it is added. Pass zero-length value to remove the header field. Returns 1 for success, 0 for failure.
		*m: setverifycert		&& Allows a certificate to be explicitly specified for verifying a signature. Returns 1 for success, 0 for failure.
		*m: signingalg_access		&& Access method used to retrieve the Chilkat MIME SigningAlg property.
		*m: signingalg_assign		&& Assign method used to hold a reference to the SigningAlg property.
		*m: signinghashalg_access		&& Access method used to retrieve the Chilkat MIME SigningHashAlg property.
		*m: signinghashalg_assign		&& Assign method used to hold a reference to the SigningHashAlg property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat MIME UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: unwrapextras_access		&& Access method used to retrieve the Chilkat MIME UnwrapExtras property.
		*m: unwrapextras_assign		&& Assign method used to hold a reference to the UnwrapExtras property.
		*m: unwrapsecurity		&& Decrypts and/or verifies all digital signatures contained within the MIME message, and returns 1 if all decryptions and verifications succeeded. Otherwise returns 0.
		*m: urlencodebody		&& URL encodes the MIME body. The charset is important.
		*m: usecertvault		&& Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*m: usemmdescription_access		&& Access method used to retrieve the Chilkat MIME UseMmDescription property.
		*m: usemmdescription_assign		&& Assign method used to hold a reference to the UseMmDescription property.
		*m: usexpkcs7_access		&& Access method used to retrieve the Chilkat MIME UseXPKCS7 property.
		*m: usexpkcs7_assign		&& Assign method used to hold a reference to the UseXPKCS7 property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat MIME VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verify		&& Verifies PKCS7 signed MIME and "unwraps" the signature. The MIME is restored to the original structure that it would have originally had prior to signing. The Verify method works with both detached signatures, as well as opaque/attached signatures.
		*p: boundary		&& The boundary string for a multipart MIME message. It is the value of the boundary attribute of the Content-Type header field.
		*p: charset		&& The value of the "charset" attribute of the Content-Type header field. For example, if the Content-Type header is this: Content-Type: text/plain; charset="iso-8859-1"
		*p: cmsoptions		&& Introduced in version 9.5.0.78. A JSON string for controlling extra CMS (PKCS7) signature and validation options.
		*p: contenttype		&& The MIME content type, such as "text/plain", "text/html", "image/gif", "multipart/alternative", "multipart/mixed", etc. It is the value of the Content-Type header field, excluding any attributes.
		*p: currentdatetime		&& Returns the current date/time in RFC 822 format.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: disposition		&& The value of the Content-Disposition header field, excluding any attributes. For example, if the Content-Disposition header is this: Content-Disposition: attachment; filename="starfish.gif"
		*p: encoding		&& The value of the Content-Transfer-Encoding header field. Typical values are "base64", "quoted-printable", "7bit", "8bit", "binary", etc.
		*p: filename		&& The value of the "filename" attribute of the Content-Disposition header field. For example, if the Content-Disposition header is this: Content-Disposition: attachment; filename="starfish.gif"
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.vvvv
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: micalg		&& The value of the "micalg" attribute of the Content-Type header field.
		*p: mimename		&& The value of the "name" attribute of the Content-Type header field. For example, if the Content-Type header is this: Content-Type: image/gif; name="starfish.gif" then the value of the Name property is "starfish.gif".
		*p: numdecryptcerts		&& Introduced in version 11.0.0. The number of certificates found when decrypting S/MIME. This property is set after UnwrapSecurity is called.
		*p: numencryptcerts		&& The number of certificates found when decrypting S/MIME. This property is set after UnwrapSecurity is called.
		*p: numheaderfields		&& The number of header fields. Header field names and values can be retrieved by index (starting at 0) by calling GetHeaderFieldName and GetHeaderFieldValue.
		*p: numparts		&& MIME messages are composed of parts in a tree structure. The NumParts property contains the number of direct children.
		*p: numsignercerts		&& The number of certificates found when verifying signature(s). This property is set after UnwrapSecurity is called.
		*p: oaephash		&& Introduced in version 9.5.0.67. Selects the hash algorithm for use within OAEP padding when encrypting MIME using RSAES-OAEP. The valid choices are "sha1", "sha256", "sha384", "sha512".
		*p: oaepmgfhash		&& Introduced in version 9.5.0.71. Selects the MGF hash algorithm for use within OAEP padding when encrypting MIME using RSAES-OAEP. The valid choices are "sha1", "sha256", "sha384", "sha512", The default is "sha1".
		*p: oaeppadding		&& Introduced in version 9.5.0.67. Selects the RSA encryption scheme when encrypting MIME. The default value is 0, which selects RSAES_PKCS1-V1_5. If set to 1, then RSAES_OAEP is used.
		*p: pkcs7cryptalg		&& When the MIME is encrypted (using PKCS7 public-key encryption), this selects the underlying symmetric encryption algorithm. Possible values are: "aes", "des", "3des", and "rc2". The default value is "aes".
		*p: pkcs7keylength		&& When the MIME is encrypted (using PKCS7 public-key encryption), this selects the key length of the underlying symmetric encryption algorithm. The possible values allowed depend on the Pkcs7CryptAlg property.
		*p: protocol		&& The value of the "protocol" attribute of the Content-Type header field.
		*p: signingalg		&& Introduced in version 9.5.0.67. Selects the signature algorithm to be used when creating signed (PKCS7/CMS) MIME. The default value is "PKCS1-v1_5". This can be set to "RSASSA-PSS" (or simply "pss") to use the RSASSA-PSS signature scheme.
		*p: signinghashalg		&& Selects the underlying hash algorithm used when creating signed (PKCS7) MIME. Possible values are "sha1", "sha256", "sha384", "sha512", "md5", and "md2". Note: This property does not get set when a signature is verified.
		*p: uncommonoptions		&& Introduced in version 9.5.0.89. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: unwrapextras		&& Controls whether extra (informative) header fields are added to the MIME message when unwrapping security.
		*p: usemmdescription		&& Controls whether the boilerplate text "This is a multi-part message in MIME format." is used as the body content of a multipart MIME part.
		*p: usexpkcs7		&& If 1, then the Content-Type header fields created by Chilkat will use "x-pkcs7" instead of simply "pkcs7". If 0, then the "pcks7" is used. he default value of this property is 1, meaning that "x-" is used by default.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0.
	*</DefinedPropArrayMethod>

	*<PropValue>
		boundary = 
		cchilkatclass = Mime
		charset = 
		cmsoptions = 
		contenttype = 
		currentdatetime = 
		debuglogfilepath = 
		disposition = 
		encoding = 
		filename = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		micalg = 
		mimename = 
		Name = "mime"
		numdecryptcerts = 0
		numencryptcerts = 0
		numheaderfields = 0
		numparts = 0
		numsignercerts = 0
		oaephash = 
		oaepmgfhash = sha1
		oaeppadding = 0
		pkcs7cryptalg = aes
		pkcs7keylength = 0
		protocol = 
		signingalg = PKCS1-v1_5
		signinghashalg = sha256
		uncommonoptions = 
		unwrapextras = 0
		usemmdescription = 0
		usexpkcs7 = 1
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addcontentlength		&& Computes the size of the MIME body and adds a Content-Length header field with the computed value. If the MIME body is non-multipart, the Content-Length is just the size of the content.
		*==============================================================================
		* Method:            AddContentLength
		* Purpose:           Computes the size of the MIME body and adds 
		*                    a Content-Length header field with the computed value.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Computes the size of the MIME body and adds a Content-Length header field 
		** with the computed value. If the MIME body is non-multipart, 
		** the Content-Length is just the size of the content. 
		** If the MIME is multipart, then the Content-Length is the sum of all the sub-parts. 
		** Calling this method more than once 
		** causes the Content-Length header to be re-computed and updated.
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddContentLength()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE adddecryptcert		&& Introduced in version 9.5.0.40. Makes a certificate available for decrypting if needed by methods that decrypt, such as UnwrapSecurity. This method may be called multiple times to make more than one certificate (and it's private key) available.
		*==============================================================================
		* Method:            AddDecryptCert
		* Purpose:           Makes a certificate available for decrypting if needed 
		*                    by methods that decrypt, such as UnwrapSecurity.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		** 
		** Makes a certificate available for decrypting if needed by methods that decrypt, 
		** such as UnwrapSecurity. This method may be called multiple times 
		** to make more than one certificate (and it's private key) available. 
		** Alternative methods for making certificates available are 
		** UseCertVault, AddPfxSourceFile, and AddPfxSourceData.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatMime AS CHILKAT_MIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddDecryptCert(m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE adddetachedsignature		&& Signs the message using the certificate provided. If successful, the message is converted to "multipart/signed" and the original message will be contained in the first sub-part. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddDetachedSignature
		* Purpose:           Signs the message using the certificate provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Signs the message using the certificate provided. 
		** If successful, the message is converted to "multipart/signed" 
		** and the original message will be contained in the first sub-part.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddDetachedSignature(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		 
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE adddetachedsignature2		&& Same as AddDetachedSignature, except an extra argument is provided to control whether header fields from the calling MIME object are transferred to the content part of the multipart/signed object.
		*==============================================================================
		* Method:            AddDetachedSignature2
		* Purpose:           Same as AddDetachedSignature, except an extra argument is provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tuTransferHeaderFields, whether or not to transfer header fields.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Same as AddDetachedSignature, except an extra argument is provided 
		** to control whether header fields from the calling MIME object 
		** are transferred to the content part of the multipart/signed object. 
		** This method transforms the calling object into a multipart/signed MIME with two sub-parts. 
		** The first contains the original content of the calling object, 
		** and the second contains the digital signature.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, tuTransferHeaderFields AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, liTransferHeaderFields AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liTransferHeaderFields
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liTransferHeaderFields = .LogicalToBit(m.tuTransferHeaderFields)
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddDetachedSignature2(m.loChilkatCert, ;
		      m.liTransferHeaderFields) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE adddetachedsignaturepk		&& Adds a detached signature using a certificate and it's associated private key.
		*==============================================================================
		* Method:            AddDetachedSignaturePK
		* Purpose:           Adds a detached signature using a certificate 
		*                    and it's associated private key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Adds a detached signature using a certificate and it's associated private key. 
		** This method would be used when the private key is external 
		** to the certificate -- for example, if a PFX/P12 file is not used, 
		** but instead a pair of .cer and .pem files are used 
		** (one for the certificate and one for the associated private key).
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddDetachedSignaturePK(;
		      m.loChilkatCert, m.loChilkatPrivateKey) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE adddetachedsignaturepk2		&& Same as AddDetachedSignaturePk, except an extra argument is provided to control whether header fields from the calling MIME object are transferred to the content part of the multipart/signed object.
		*==============================================================================
		* Method:            AddDetachedSignaturePK2
		* Purpose:           ame as AddDetachedSignaturePk, except an extra argument is provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		*                    tuTransferHeaderFields, whether or not to transfer header fields.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Same as AddDetachedSignaturePk, except an extra argument is provided 
		** to control whether header fields from the calling MIME object 
		** are transferred to the content part of the multipart/signed object. 
		** This method transforms the calling object into a multipart/signed MIME with two sub-parts. 
		** The first contains the original content of the calling object, 
		** and the second contains the digital signature.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, tuTransferHeaderFields AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		luReturn AS Unknown, liTransferHeaderFields AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liTransferHeaderFields
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liTransferHeaderFields = .LogicalToBit(m.tuTransferHeaderFields)
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddDetachedSignaturePK2(;
		      m.loChilkatCert, m.loChilkatPrivateKey, m.liTransferHeaderFields) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addencryptcert		&& Adds a certificate to the object's internal list of certificates to be used when the EncryptN method is called. (See the EncryptN method for more information.) The internal list may be cleared by calling ClearEncryptCerts.
		*==============================================================================
		* Method:            AddEncryptCert
		* Purpose:           Adds a certificate to the object's internal list of certificates 
		*                    to be used when the EncryptN method is called.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Adds a certificate to the object's internal list of certificates 
		** to be used when the EncryptN method is called. 
		** (See the EncryptN method for more information.) 
		** The internal list may be cleared by calling ClearEncryptCerts.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddEncryptCert(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

