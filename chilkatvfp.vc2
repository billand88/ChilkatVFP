	PROCEDURE sslallowedciphers		&& Method run to validate the data for the SSLAllowedCiphers property.
		*==============================================================================
		* Method:            SSLAllowedCiphers
		* Purpose:           Method run to validate the data for the SSLAllowedCiphers property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/17/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer ;
		liCurrentBuild AS Integer, liWords AS Integer, li AS Integer, lcWord AS Character
		
		LOCAL ARRAY la_Values[43, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have a word to validate test (should be true)
		  IF m.liWords = 1
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = STRTRAN(m.lcValue, [ ])
		
		          la_Values[1, 1] = [TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256]
		          la_Values[1, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[2, 1] = [TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256]
		          la_Values[2, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[3, 1] = [TLS_DHE_RSA_WITH_CHACHA20_POLY1305_SHA256]
		          la_Values[3, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[4, 1] = [TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA]
		          la_Values[4, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[5, 1] = [TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256]
		          la_Values[5, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[6, 1] = [TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA]
		          la_Values[6, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[7, 1] = [TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384]
		          la_Values[7, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[8, 1] = [TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384]
		          la_Values[8, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[9, 1] = [TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384]
		          la_Values[9, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[10, 1] = [TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA]
		          la_Values[10, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[11, 1] = [TLS_DHE_RSA_WITH_AES_256_CBC_SHA256]
		          la_Values[11, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[12, 1] = [TLS_DHE_RSA_WITH_AES_256_GCM_SHA384]
		          la_Values[12, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[13, 1] = [TLS_DHE_RSA_WITH_AES_256_CBC_SHA]
		          la_Values[13, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[14, 1] = [TLS_RSA_WITH_AES_256_CBC_SHA256]
		          la_Values[14, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[15, 1] = [TLS_RSA_WITH_AES_256_GCM_SHA384]
		          la_Values[15, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[16, 1] = [TLS_RSA_WITH_AES_256_CBC_SHA]
		          la_Values[16, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[17, 1] = [TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256]
		          la_Values[17, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[18, 1] = [TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256]
		          la_Values[18, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[19, 1] = [TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA]
		          la_Values[19, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[20, 1] = [TLS_DHE_RSA_WITH_AES_128_CBC_SHA256]
		          la_Values[20, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[21, 1] = [TLS_DHE_RSA_WITH_AES_128_GCM_SHA256]
		          la_Values[21, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[22, 1] = [TLS_DHE_RSA_WITH_AES_128_CBC_SHA]
		          la_Values[22, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[23, 1] = [TLS_RSA_WITH_AES_128_CBC_SHA256]
		          la_Values[23, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[24, 1] = [TLS_RSA_WITH_AES_128_GCM_SHA256]
		          la_Values[24, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[25, 1] = [TLS_RSA_WITH_AES_128_CBC_SHA]
		          la_Values[25, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[26, 1] = [TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA]
		          la_Values[26, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[27, 1] = [TLS_DHE_RSA_WITH_3DES_EDE_CBC_SHA]
		          la_Values[27, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[28, 1] = [TLS_RSA_WITH_3DES_EDE_CBC_SHA]
		          la_Values[28, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[29, 1] = [TLS_ECDHE_RSA_WITH_RC4_128_SHA]
		          la_Values[29, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[30, 1] = [TLS_RSA_WITH_RC4_128_SHA]
		          la_Values[30, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[31, 1] = [TLS_RSA_WITH_RC4_128_MD5]
		          la_Values[31, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[32, 1] = [TLS_DHE_RSA_WITH_DES_CBC_SHA]
		          la_Values[32, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[33, 1] = [TLS_RSA_WITH_DES_CBC_SHA]
		          la_Values[33, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[34, 1] = [rsa1024]
		          la_Values[34, 2] = .GenerateVersionNumber(9, 5, 48)
		          la_Values[35, 1] = [rsa2048]
		          la_Values[36, 2] = .GenerateVersionNumber(9, 5, 48)
		          la_Values[37, 1] = [aes256-cbc]
		          la_Values[37, 2] = .GenerateVersionNumber(9, 5, 48)
		          la_Values[38, 1] = [aes128-cbc]
		          la_Values[38, 2] = .GenerateVersionNumber(9, 5, 48)
		          la_Values[39, 1] = [3des-cbc]
		          la_Values[39, 2] = .GenerateVersionNumber(9, 5, 48)
		          la_Values[40, 1] = [rc4]
		          la_Values[40, 2] = .GenerateVersionNumber(9, 5, 48)
		          la_Values[41, 1] = [secure-renegotiation]
		          la_Values[41, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[42, 1] = [best-practices]
		          la_Values[42, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[43, 1] = [secureRenegotiate]
		          la_Values[43, 2] = .GenerateVersionNumber(9, 5, 55)
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End walk through words loop
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords > 0
		  ** End have words to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sslprotocol		&& Method run to validate the data for the SSLProtocol property.
		*==============================================================================
		* Method:            SSLProtocol
		* Purpose:           Method run to validate the data for the SSLProtocol property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/17/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		lcValue = UPPER(STRTRAN(m.lcValue, [ ]))
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER ;
		AND (NOT EMPTY(m.lcValue)) ;
		AND INLIST(UPPER(ALLTRIM(m.lcValue)), [DEFAULT], [TLS1.3], [TLS1.2], [TLS1.1], [TLS1.0], ;
		[SSL3.0], [TLS1.3ORHIGHER], [TLS1.2ORHIGHER], [TLS1.1ORHIGHER], [TLS1.0ORHIGHER]))
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

