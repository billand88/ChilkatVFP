		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcProperty, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		WITH THIS
		
		  loVersioning = .oVersioning
		
		  ** Object doesn't exist test
		  IF ISNULL(m.loVersioning) ;
		  OR TYPE([loVersioning.Name]) # T_CHARACTER
		
		    ASTACKINFO(la_Stack)
		
		    ** Not in Destroy method test
		    IF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		
		      loVersioning = CREATEOBJECT([iVersioning], THIS)
		 
		      ** Problems with instantiation test
		      IF TYPE([loVersioning.Name]) # T_CHARACTER
		
		        liStackLevel = ASTACKINFO(la_Stack)
		        lcMethod = m.la_Stack(m.liStackLevel, 3)
		        lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		        lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		        lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		        lcSecondParameter = m.lcProperty + [~] + m.lcMethod + [~] + m.lcPEMType
		
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF TYPE([loVersioning.Name]) # T_CHARACTER
		      ** End problems with instantiation test
		
		    ENDIF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		    ** End not in Destroy method test
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.loVersioning) ;
		  OR TYPE([loVersioning.Name]) # T_CHARACTER
		  ** End object doesn't exist test
		
		  .oVersioning = m.loVersioning
		
		ENDWITH
		
		loVersioning = NULL
		
		RETURN THIS.oVersioning
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE oversioning_assign		&& Assign method used to hold a reference to the Versioning object.
		*==============================================================================
		* Method:            oVersioning_Assign
		* Purpose:           Assign method used to hold a reference to the Versioning object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toVersioning, the Versioning object, or NULL
		* Returns:           
		* Date Added:        10/07/2024
		*==============================================================================
		
		LPARAMETERS toVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL loVersioning AS [iVersioning OF ChilkatVFP.VCX], lcErrorMessage AS Character, ;
		lcPEMType AS Character, lcSecondParameter AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		loVersioning = m.toVersioning
		
		WITH THIS
		
		  ** Parameter validation test
		  IF ISNULL(m.loVersioning) ;
		  OR TYPE([loVersioning.Name]) == T_CHARACTER
		
		    .oVersioning = m.loVersioning
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		
		    lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.loVersioning) ;
		  OR TYPE([loVersioning.Name]) == T_CHARACTER
		  ** End parameter validation test
		
		ENDWITH
		
		loVersioning = NULL
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test  
	ENDPROC

	HIDDEN PROCEDURE version_access		&& Access method used to retrieve the Version property of the referenced Chilkat object.
		*==============================================================================
		* Method:            Version_Access
		* Purpose:           Access method used to retrieve 
		*                    the Version property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/05/2022
		*==============================================================================
		
		**
		** Version of the component/library, such as "9.5.0.63"
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer, lcVersion AS Character, ;
		llCkStringProperty AS Logical, llSFTPDirProperty AS Logical, llSFTPFileProperty AS Logical, ;
		loChilkatObject AS [Global OF ChilkatVFP.VCX], llNoVersionProperty AS Logical, ;
		llStringBuilderMethod AS Logical, llBinDataMethod AS Logical, llSecureStringMethod AS Logical, ;
		llServerSentEventProperty AS Logical, llMailboxesMethod AS Logical, ;
		llMessageSetProperty AS Logical, llURLProperty AS Logical, llHashTableMethod AS Logical, ;
		loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.lcVersion, m.la_Stack
		STORE .F. TO m.llCkStringProperty, m.llSFTPDirProperty, m.llSFTPFileProperty, ;
		m.llStringBuilderMethod, m.llBinDataMethod, m.llNoVersionProperty, ;
		m.llSecureStringMethod, m.llServerSentEventProperty, m.llMailboxesMethod, ;
		m.llMessageSetProperty, m.llURLProperty, m.llHashTableMethod
		STORE NULL TO m.loChilkatObject, m.loVersioning
		
		** Note: The test against the wrapper is deliberate.
		** Testing the Chilkat object property works in the debugger
		** (when the program is stopped) but does not necessarily work at runtime.
		
		llCkStringProperty = (PEMSTATUS(THIS, [NumCyrillic], 5))
		llSFTPDirProperty = (PEMSTATUS(THIS, [OriginalPath], 5))
		llSFTPFileProperty = (PEMSTATUS(THIS, [IsImmutable], 5))
		llStringBuilderMethod = (PEMSTATUS(THIS, [ReplaceNoCase], 5))
		llBinDataMethod = (PEMSTATUS(THIS, [GetTextChunk], 5))
		llSecureStringMethod = (PEMSTATUS(THIS, [SecStrEquals], 5))
		llServerSentEventProperty = (PEMSTATUS(THIS, [LastEventID], 5))
		llMailboxesMethod = (PEMSTATUS(THIS, [HasInferiors], 5))
		llMessageSetProperty = (PEMSTATUS(THIS, [HasUIDs], 5))
		llURLProperty = (PEMSTATUS(THIS, [Frag], 5))
		llHashTableMethod = (PEMSTATUS(THIS, [ClearWithNewCapacity], 5))
		
		llNoVersionProperty = (m.llCkStringProperty OR m.llSecureStringMethod OR m.llSFTPDirProperty ;
		OR m.llSFTPFileProperty OR m.llStringBuilderMethod OR m.llBinDataMethod ;
		OR m.llServerSentEventProperty OR m.llMailboxesMethod OR m.llMessageSetProperty ;
		OR m.llURLProperty OR m.llHashTableMethod)
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		lcMethodToCall = [StringReadOnly]
		
		WITH THIS
		
		  ** Using a class with a Version property test
		  IF NOT m.llNoVersionProperty
		
		    .CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		    lcVersion = EVALUATE([THIS.] + m.lcProperty)
		
		  ELSE
		
		    ** Note: Several Chilkat objects do not contain a Version property.
		    ** So we fake it out/kludge it/workaround it calling the 
		    ** loVersioning GetChilkatVersioningObject method and instantianting some sort of object.
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		      loChilkatObject = m.loVersioning.GetChilkatVersioningObject()
		
		      ** Have an object test
		      IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		      AND (NOT ISNULL(m.loChilkatObject))
		
		        lcVersion = m.loChilkatObject.Version
		
		      ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		      AND (NOT ISNULL(m.loChilkatObject))
		      ** End have an object test
		
		    ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		    ** End have versioning object test
		
		  ENDIF NOT m.llNoVersionProperty
		  ** End not using a class with a Version property test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loVersioning
		
		RETURN m.lcVersion
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GLOBAL_COM_CALL) && guessing on this one, see the GetChilkatObject method.
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE version_assign		&& Assign method used to hold the Version property of the referenced Chilkat object.
		*==============================================================================
		* Method:            Version_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the Version property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the version of the Chilkat object.
		* Returns:           
		* Date Added:        01/05/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS baseeventhandler AS ibase OF "chilkatvfp.vcx" 		&& Template ChilkatVFP class with properties/methods that span all ChilkatVFP event handler objects.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: abortcheck		&& Provides the opportunity for a method call to be aborted. The AbortCheck event is fired periodically based on the value of the HeartbeatMs property. If HeartbeatMs is 0, then no AbortCheck events will fire.
		*m: abortcheck_post		&& Template AbortCheck post-processing method.
		*m: abortcheck_pre		&& Template AbortCheck pre-processing method.
		*m: abortcheck_process		&& Template AbortCheck processing method.
