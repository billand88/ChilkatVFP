	PROCEDURE getdeliverystatusinfo		&& If the email is a multipart/report, then it is a delivery status notification. This method can be used to get individual pieces of information from the message/delivery-status part of the email.
		*==============================================================================
		* Method:            GetDeliveryStatusInfo
		* Purpose:           Get individual pieces of information 
		*                    from the message/delivery-status part of the email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFieldName -- the delivery status field name.
		* Returns:           lcFieldValue, the value from the delivery status field name.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** If the email is a multipart/report, then it is a delivery status notification. 
		** This method can be used to get individual pieces of information 
		** from the message/delivery-status part of the email. 
		** This method should only be called if the IsMultipartReport method returns 1.
		**
		** The fieldName should be set a string such as 
		** "Final-Recipient", "Status", "Action", "Reporting-MTA", etc.
		**
		** Reporting-MTA: dns; XYZ.abc.nl
		**
		** Final-recipient: RFC822; someEmailAddr@doesnotexist123.nl
		** Action: failed
		** Status: 5.4.4
		** X-Supplementary-Info: < #5.4.4 smtp;554 5.4.4
		**  SMTPSEND.DNS.NonExistentDomain; nonexistent domain>
		**
		** Fixed for version 66: Fixed this method for certain cases
		** where the body of information contained multiple blank lines.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFieldName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcFieldValue AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcFieldValue = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcFieldValue = m.loChilkatObject.GetDeliveryStatusInfo(m.tcFieldName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFieldValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getdigest		&& Returns an digest contained within a multipart/digest as an email object. The 1st digest is at index 0. Use the NumDigests property to get the number of digests available. Note: This example requires Chilkat v9.5.0.66 or greater.
		*==============================================================================
		* Method:            GetDigest
		* Purpose:           Returns an digest contained within a multipart/digest as an email object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the index to the attachment array
		* Returns:           Chilkat Email Object or NULL
		* Date Added:        01/25/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.66
		**
		** Returns an digest contained within a multipart/digest as an email object. 
		** The 1st digest is at index 0. Use the NumDigests property to get the number of digests available.
		**
		** Note: This example requires Chilkat v9.5.0.66 or greater.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmail
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatEmail = m.loChilkatObject.GetDigest(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmail
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getdigestemail		&& Introduced in version 11.0.0. Returns in email the Nth digest email contained within a multipart/digest. The 1st digest is at index 0. Use the NumDigests property to get the number of digests available. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetDigestEmail
		* Purpose:           Returns in email the Nth digest email contained within a multipart/digest.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the attachment file name.
		*                    toChilkatEmail -- a Chilkat EMail object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Returns in email the Nth digest email contained within a multipart/digest. 
		** The 1st digest is at index 0. Use the NumDigests property 
		** to get the number of digests available.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail  
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterEmail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetDigestEmail(m.tiIndex, m.loChilkatEmail) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

