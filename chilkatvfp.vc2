		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Finds a certificate where the SubjectE property (email address) matches exactly 
		** (but case insensitive) with the passed string. This function differs 
		** from FindCertForEmail in that the certificate does not need 
		** to match the ForSecureEmail property.
		**
		** Note: Decremented in version 10.1.2 and will be removed in a future release.
		** Use FindCert instead.
		** 
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tcString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.FindCertBySubjectE(m.tcString)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE findcertbysubjecto		&& Finds a certificate where the SubjectO property (organization) matches exactly (but case insensitive) with the passed string. Returns Nothing on failure.
		*==============================================================================
		* Method:            FindCertBySubjectO
		* Purpose:           Finds a certificate where one of the SubjectO property 
		*                    matches exactly (but case insensitive) with the passed string.
