	PROCEDURE verifyrecips		&& Initiates sending an email, but aborts just after passing all recipients (TO, CC, BCC) to the SMTP server. This allows your program to collect email addresses flagged as invalid by the SMTP server.
		*==============================================================================
		* Method:            VerifyRecips
		* Purpose:           Initiates sending an email, but aborts just after 
		*                    passing all recipients (TO, CC, BCC) to the SMTP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		*                    toChilkatStringArray, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/20/2022
		*==============================================================================
		
		**
		** Initiates sending an email, but aborts just after passing all recipients 
		** (TO, CC, BCC) to the SMTP server.
		** This allows your program to collect email addresses flagged as invalid by the SMTP server.
		**
		** Important: Please read this blog post before using this method: http://www.cknotes.com/?p=249
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, liReturn AS Integer, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		     loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.VerifyRecips(m.loChilkatEmail, m.loChilkatStringArray) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		    toChilkatStringArray = m.loParkParameterStringArray.SetObject(;
		    m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

