	PROCEDURE hotp		&& Introduced in version 9.5.0.77. Implements RFC 4226: HOTP: An HMAC-Based One-Time Password Algorithm.
		*==============================================================================
		* Method:            HOTP
		* Purpose:           Hashes a string and returns the hash bytes as an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedSecret -- the encoded shared secret.
		*                    tcEncoding -- the encoding of the encoded secret.
		*                    tcCounterHex -- the 8-byte counter in hexidecimal format.
		*                    tiNumDigits -- the number of digits to return.
		*                    tiTruncationOffset -- the offset value.
		*                    tcHashAlgorithm -- the hash algorithm used.
		* Returns:           The generated password.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.77
		**
		** Implements RFC 4226: HOTP: An HMAC-Based One-Time Password Algorithm. 
		** The arguments to this method are:
		**
		**   secret: The shared secret in an enocded representation such as base64, hex, ascii, etc.
		**   secretEnc: The encoding of the shared secret, such as "base64"
		**   counterHex: The 8-byte counter in hexidecimal format.
		**   numDigits: The number of decimal digits to return.
		**   truncOffset: Normally set this to -1 for dynamic truncation. 
		**                Otherwise can be set in the range 0..15.
		**   hashAlg: Normally set to "sha1". Can be set to other hash algorithms 
		**            such as "sha256", "sha512", etc.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncodedSecret AS Character, tcEncoding AS Character, ;
		tcCounterHex AS Character, tiNumDigits AS Integer, ;
		tiTruncationOffset AS Integer, tcHashAlgorithm AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcPassword AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcPassword = []
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcPassword = m.loChilkatObject.HOTP(m.tcEncodedSecret, m.tcEncoding, ;
		        m.tcCounterHex, m.tiNumDigits, m.tiTruncationOffset, m.tcHashAlgorithm)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcPassword
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE includecertchain_access		&& Access method used to retrieve the Chilkat Crypt2 IncludeCertChain property.
		*==============================================================================
		* Method:            IncludeCertChain_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 IncludeCertChain property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IncludeCertChain
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Only applies when creating digital signatures. If 1 (the default), 
		** then additional certificates (if any) in the chain of authentication 
		** are included in the PKCS7 digital signature.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

