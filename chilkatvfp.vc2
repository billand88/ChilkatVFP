	PROCEDURE genrandom		&& Introduced in version 9.5.0.52. Generates and returns numBytes random bytes in encoded string form. The binary encoding is specified by encoding, and can be "hex", "base64", etc. (See the link below for supported binary encodings.)
		*==============================================================================
		* Method:            GenRandom
		* Purpose:           Generates and returns numBytes random bytes in encoded string form.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiBytes -- the entropy bytes to add
		*                    tcEncoding, the binary encoding
		* Returns:           Random string bytes
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** Generates and returns numBytes random bytes in encoded string form. 
		** The binary encoding is specified by encoding, 
		** and can be "hex", "base64", etc. (See the link below for supported binary encodings.)
		**
		** Important: If no entropy was explicitly added prior 
		** to first call to generate random bytes, then 32 bytes of entropy 
		** (from the system source, such as /dev/random) are automatically added to seed the PRNG.
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiBytes AS Integer, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		lcRandomBytes AS Character, liIntroducedInBuild AS Integer, llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcRandomBytes = []
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcRandomBytes = m.loChilkatObject.GenRandom(m.tiBytes, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcRandomBytes 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE genrandombd		&& Introduced in version 9.5.0.66. Appends numBytes random bytes to bd.
		*==============================================================================
		* Method:            GenRandomBd
		* Purpose:           Generates and returns numBytes random bytes in encoded string form.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiBytes -- the entropy bytes to add
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Appends numBytes random bytes to bd.
		**
		** Important: If no entropy was explicitly added 
		** prior to first call to generate random bytes, 
		** then 32 bytes of entropy (from the system source, such as /dev/random) 
		** are automatically added to seed the PRNG.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiBytes AS Integer, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenRandomBd(m.tiBytes, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

