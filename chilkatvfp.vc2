	HIDDEN PROCEDURE syncmustnotmatchdir_access		&& Access method used to retrieve the Chilkat SyncMustNotMatchDir property.
		*==============================================================================
		* Method:            SyncMustNotMatchDir_Access
		* Purpose:           Access method used to retrieve 
		*                    the SyncMustNotMatchDir property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SyncMustNotMatchDir
		* Date Added:        05/04/2025
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Can contain a wildcarded list of file patterns separated by semicolons. 
		** For example, "xml; txt; data_*". If set, the Sync* upload and download methods 
		** will only enter directories that match any one of these patterns. 
		** Pattern matching is case-insensitive.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 76
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE syncmustnotmatchdir_assign		&& Assign method used to hold a reference to the SyncMustNotMatchDir property.
