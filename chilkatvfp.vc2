	PROCEDURE getmailflag		&& Returns the value of a flag (1 = yes, 0 = no) for an email. Both standard system flags as well as custom flags may be set.
		*==============================================================================
		* Method:            GetMailFlag
		* Purpose:           Returns the value of a flag (1 = yes, 0 = no) for an email. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail -- a Chilkat Email object.
		*                    tcFlagName -- the mailbox name to receive the message.
		* Returns:           Returns 1 for yes, 0 for no.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Returns the value of a flag (1 = yes, 0 = no) for an email. 
		** Both standard system flags as well as custom flags may be set. 
		** Standard system flags typically begin with a backslash character, 
		** such as "\Seen", "\Answered", "\Flagged", "\Draft", "\Deleted", and "\Answered". 
		** Custom flags can be anything, such as "NonJunk", "$label1", "$MailFlagBit1", etc. 
		**
		** Fixed for Version 11.6.0: Returns -1 when the required ckx-imap-* metadata is missing from the Email.
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, tcFlagName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.GetMailFlag(m.loChilkatEmail, m.tcFlagName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

