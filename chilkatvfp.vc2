		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS jsonobject AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a JSON object, which contains an unordered set of name/value pairs. Each value can be a string, number, JSON object, JSON array, true, false, or null.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addarrayat		&& Introduced in version 9.5.0.56. Inserts a new and empty JSON array member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*m: addarraycopyat		&& Introduced in version 9.5.0.82. Inserts a copy of a JSON array to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addboolat		&& Introduced in version 9.5.0.56. Inserts a new boolean member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addintat		&& Introduced in version 9.5.0.56. Inserts a new integer member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addnullat		&& Introduced in version 9.5.0.56. Inserts a new null member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addnumberat		&& Introduced in version 9.5.0.56. Inserts a new numeric member to the position indicated by index. The numericStr is an integer, float, or double already converted to a string in the format desired by the application. To prepend, pass an index of 0.
		*m: addobjectat		&& Introduced in version 9.5.0.56. Inserts a new and empty JSON object member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*m: addobjectcopyat		&& Introduced in version 9.5.0.82. Inserts a copy of a JSON object to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addstringat		&& Introduced in version 9.5.0.56. Inserts a new string member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: appendarray		&& Introduced in version 9.5.0.58. Appends a new and empty JSON array and returns it. Important: The name is the member name, it is not a JSON path. Returns Nothing on failure.
		*m: appendarray2		&& Introduced in version 11.0.0. Appends a new and empty JSON array and returns it in jarr. Important: The name is the member name, it is not a JSON path. Returns 1 for success, 0 for failure.
		*m: appendarraycopy		&& Introduced in version 9.5.0.82. Appends a copy of a JSON array. Important: The name is the member name, it is not a JSON path. Returns 1 for success, 0 for failure.
		*m: appendbool		&& Introduced in version 9.5.0.58. Appends a new boolean member. (This is the same as passing -1 to the AddBoolAt method.) Important: The name is the member name. It is not a JSON path. To append (or update) using a JSON path, call UpdateBool instead.
		*m: appendint		&& Introduced in version 9.5.0.58. Appends a new integer member. (This is the same as passing an index of -1 to the AddIntAt method.) Important: The name is the member name. It is not a JSON path.
		*m: appendobject		&& Introduced in version 9.5.0.58. Appends a new and empty JSON object and returns it. Important: The name is the member name, it is not a JSON path. Returns Nothing on failure.
		*m: appendobject2		&& Introduced in version 11.0.0. Appends a new and empty JSON object and returns it in jsonObj. Important: The name is the member name, it is not a JSON path. Returns 1 for success, 0 for failure.
		*m: appendobjectcopy		&& Introduced in version 9.5.0.82. Appends a copy of a JSON object. Important: The name is the member name, it is not a JSON path. Returns 1 for success, 0 for failure.
		*m: appendstring		&& Introduced in version 9.5.0.58. Appends a new string member. (This is the same as passing -1 to the AddStringAt method.) Important: The name is the member name. It is not a JSON path. To append (or update) using a JSON path, call UpdateString instead.
		*m: appendstringarray		&& Introduced in version 9.5.0.67. Appends an array of string values. Important: The name is the member name, it is not a JSON path. Returns 1 for success, 0 for failure.
		*m: arrayat		&& Introduced in version 9.5.0.56. Returns the JSON array that is the value of the Nth member. Indexing is 0-based (the 1st member is at index 0). Returns Nothing on failure.
		*m: arrayat2		&& Introduced in version 11.0.0. Sets jarr to reference the JSON array found at index, where indexing starts at 0. Returns 1 for success, 0 for failure.
		*m: arrayof		&& Introduced in version 9.5.0.56. Returns the JSON array at the specified jsonPath. Returns Nothing on failure.
		*m: arrayof2		&& Introduced in version 11.1.0. sets jarr to reference the JSON array found at jsonPath. Returns 1 for success, 0 for failure.
		*m: boolat		&& Introduced in version 9.5.0.56. Returns the boolean value of the Nth member. Indexing is 0-based (the 1st member is at index 0).
		*m: boolof		&& Introduced in version 9.5.0.56. Returns the boolean at the specified jsonPath.
		*m: bytesof		&& Introduced in version 9.5.0.68. Appends the binary bytes at the specified jsonPath to bd. The encoding indicates the encoding of the bytes, such as "base64", "hex", etc. Returns 1 for success, 0 for failure.
		*m: clear		&& Introduced in version 9.5.0.76. Clears the contents of the JSON object. This is the equivalent of calling jsonObject.Load("{}")
		*m: clone		&& Introduced in version 9.5.0.66. Returns a copy of this JSON object. Returns Nothing on failure.
		*m: copyref		&& Introduced in version 11.0.0. Updates jsonObj to reference this JSON object. Returns 1 for success, 0 for failure.
		*m: dateof		&& Introduced in version 9.5.0.73. Fills the dateTime with the date/time string located at jsonPath.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat JSONObject DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: delete		&& Introduced in version 9.5.0.56. Deletes the member at having the name specified by name. Note: The name is not a tag path. It is the name of a member of this JSON object. Returns 1 for success, 0 for failure.
		*m: deleteat		&& Introduced in version 9.5.0.56. Deletes the member at index index. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: deleterecords		&& Introduced in version 9.5.0.88. Deletes JSON records in an array where a particular field equals or matches a value pattern. Returns the number of JSON records deleted.
		*m: delimiterchar_access		&& Access method used to retrieve the Chilkat JSONObject DelimiterChar property.
		*m: delimiterchar_assign		&& Assign method used to hold a reference to the DelimiterChar property.
		*m: dtof		&& Introduced in version 9.5.0.73. Fills the dt with the date/time string located at jsonPath. If bLocal is 1, then dt is filled with the local date/time values, otherwise it is filled with the UTC/GMT values.
		*m: emit		&& Introduced in version 9.5.0.56. Writes the JSON document (rooted at the caller) and returns as a string. Returns Nothing on failure
		*m: emitbd		&& Introduced in version 9.5.0.77. Emits (appends) to the contents of bd. Returns 1 for success, 0 for failure.
		*m: emitcompact_access		&& Access method used to retrieve the Chilkat JSONObject EmitCompact property.
		*m: emitcompact_assign		&& Assign method used to hold a reference to the EmitCompact property.
		*m: emitcrlf_access		&& Access method used to retrieve the Chilkat JSONObject EmitCRLFproperty.
		*m: emitcrlf_assign		&& Assign method used to hold a reference to the EmitCRLF property.
		*m: emitsb		&& Introduced in version 9.5.0.62. Appends the JSON to a StringBuilder object. Returns 1 for success, 0 for failure.
		*m: emitwithsubs		&& Introduced in version 9.5.0.67. Emits the JSON document with variable substitutions applied. If omitEmpty is 1, then members having empty strings or empty arrays are omitted. Returns Nothing on failure
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat JSONObject EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: findobjectwithmember		&& Introduced in version 9.5.0.67. Recursively searches the JSON subtree rooted at the caller's node for a JSON object containing a member having a specified name.
		*m: findobjectwithmember2		&& Introduced in version 11.0.0. Recursively searches this JSON subtree for an object containing a specified member, name. If initiated at the root, it searches the entire document. Returns 1 for success, 0 for failure.
		*m: findrecord		&& Introduced in version 9.5.0.63. Finds a JSON record in an array where a particular field equals or matches a value pattern. Reviewing the example below is the best way to understand this function. Returns Nothing on failure
		*m: findrecord2		&& Introduced in version 11.0.0. Locate a JSON record in an array where a specific field matches a given value or pattern. Refer to the example below for clarification. Returns 1 for success, 0 for failure.
		*m: findrecordstring		&& Introduced in version 9.5.0.63. Finds a JSON value in an record array where a particular field equals or matches a value pattern. Reviewing the example below is the best way to understand this function. Returns Nothing on failure.
		*m: firebaseapplyevent		&& Introduced in version 9.5.0.58. Applies a Firebase event to the JSON.
		*m: firebasepatch		&& Introduced in version 9.5.0.58. For each key in the jsonData, update (or add) the corresponding key in the JSON at the given jsonPath. The jsonPath is relative to this JSON object. (This is effectively applying a Firebase patch event.)
		*m: firebaseput		&& Introduced in version 9.5.0.58. Inserts or replaces the value at the jsonPath. The value can contain JSON text, an integer (in decimal string format), a boolean (true/false), the keyword "null", or a quoted string.
		*m: getdocroot		&& Introduced in version 9.5.0.56. Returns the root of the JSON document. The root can be obtained from any JSON object within the JSON document. The entire JSON document remains in memory as long as at least one JSON object is referenced by the application
		*m: getdocroot2		&& Introduced in version 11.0.0. Returns in docRoot the root of the JSON document. The entire document stays in memory as long as at least one JSON object is referenced by the application. Returns 1 for success, 0 for failure.
		*m: hasmember		&& Introduced in version 9.5.0.58. Returns 1 if the item at the jsonPath exists. Returns 1 for success, 0 for failure.
		*m: indexof		&& Introduced in version 9.5.0.56. Returns the index of the member having the given name. Returns -1 if the name is not found.
		*m: intat		&& Introduced in version 9.5.0.56. Returns the integer value of the Nth member. Indexing is 0-based (the 1st member is at index 0).
		*m: intof		&& Introduced in version 9.5.0.56. Returns the integer at the specified jsonPath.
		*m: isnullat		&& Introduced in version 9.5.0.56. Returns the boolean value of the member having the specified index.
		*m: isnullof		&& Introduced in version 9.5.0.56. Returns 1 if the value at the specified jsonPath is null. Otherwise returns 0.
		*m: i_access		&& Access method used to retrieve the Chilkat JSONObject I property.
		*m: i_assign		&& Assign method used to hold a reference to the I property.
		*m: jsontypeof		&& Introduced in version 9.5.0.68
		*m: j_access		&& Access method used to retrieve the Chilkat JSONObject J property.
		*m: j_assign		&& Assign method used to hold a reference to the J property.
		*m: k_access		&& Access method used to retrieve the Chilkat JSONObject K property.
		*m: k_assign		&& Assign method used to hold a reference to the K property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat JSONObject LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat JSONObject LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat JSONObject LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat JSONObject LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat JSONObject LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat JSONObject LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat JSONObject LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: load		&& Introduced in version 9.5.0.56. Parses a JSON string and loads it into this JSON object to provide DOM-style access. Returns 1 for success, 0 for failure.
		*m: loadbd		&& Introduced in version 9.5.0.77. Loads the contents of bd. Returns 1 for success, 0 for failure.
		*m: loadfile		&& Introduced in version 9.5.0.56. Loads a JSON file into this JSON object. The path is the file path to the JSON file. Returns 1 for success, 0 for failure.
		*m: loadpredefined		&& Introduced in version 9.5.0.67. Loads this JSON object from a predefined document having a specified name. Returns 1 for success, 0 for failure.
		*m: loadsb		&& Introduced in version 9.5.0.62. Loads JSON from the contents of a StringBuilder object. Returns 1 for success, 0 for failure.
		*m: lowercasenames_access		&& Access method used to retrieve the Chilkat JSONObject LowerCaseNames property.
		*m: lowercasenames_assign		&& Assign method used to hold a reference to the LowerCaseNames property.
		*m: makecopy		&& Introduced in version 11.0.0. Returns a copy of this JSON object in json. Returns 1 for success, 0 for failure.
		*m: movemember		&& Introduced in version 9.5.0.80. Move the member from fromIndex to toIndex. If toIndex equals -1, then moves the member at position fromIndex to the last position. Set toIndex = 0 to move a member to the first position.
		*m: nameat		&& Introduced in version 9.5.0.56. Returns the name of the Nth member. Indexing is 0-based (the 1st member is at index 0). Returns Nothing on failure.
		*m: newarrayof		&& Introduced in version 11.4.0. Creates a new array at the path and loads it with jArr. Returns 1 for success, 0 for failure.
		*m: objectat		&& Introduced in version 9.5.0.56. Returns the JSON object that is the value of the Nth member. Indexing is 0-based (the 1st member is at index 0). Returns Nothing on failure.
		*m: objectat2		&& Introduced in version 11.0.0. Sets jsonObj to reference the JSON object found at index, where indexing starts at 0. Returns 1 for success, 0 for failure.
		*m: objectof		&& Introduced in version 9.5.0.56. Returns the JSON object at the specified jsonPath. Returns Nothing on failure.
		*m: objectof2		&& Introduced in version 11.0.0. Returns in jsonObj the JSON object at the specified jsonPath. Returns 1 for success, 0 for failure.
		*m: pathprefix_access		&& Access method used to retrieve the Chilkat JSONObject PathPrefix property.
		*m: pathprefix_assign		&& Assign method used to hold a reference to the PathPrefix property.
		*m: predefine		&& Introduced in version 9.5.0.67. Adds or replaces this JSON to an internal global set of predefined JSON documents that can be subsequently loaded by name. Returns 1 for success, 0 for failure.
		*m: rename		&& Introduced in version 9.5.0.56. Renames the member named oldName to newName. Returns 1 for success, 0 for failure.
		*m: renameat		&& Introduced in version 9.5.0.56. Renames the member at index to name. Returns 1 for success, 0 for failure.
		*m: setboolat		&& Introduced in version 9.5.0.56. Sets the boolean value of the Nth member. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setboolof		&& Introduced in version 9.5.0.56. Sets the boolean value at the specified jsonPath. Returns 1 for success, 0 for failure.
		*m: setintat		&& Introduced in version 9.5.0.56. Sets the integer value of the Nth member. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setintof		&& Introduced in version 9.5.0.56. Sets the integer at the specified jsonPath. Returns 1 for success, 0 for failure.
		*m: setnullat		&& Introduced in version 9.5.0.56. Sets the value of the Nth member to null. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setnullof		&& Introduced in version 9.5.0.56. Sets the value at the specified jsonPath to null. Returns 1 for success, 0 for failure.
		*m: setnumberat		&& Introduced in version 9.5.0.56. Sets the numeric value of the Nth member. The value is an integer, float, or double already converted to a string in the format desired by the application. Indexing is 0-based (the 1st member is at index 0).
		*m: setnumberof		&& Introduced in version 9.5.0.56. Sets the numeric value at the specified jsonPath. The value is an integer, float, or double already converted to a string in the format desired by the application. Returns 1 for success, 0 for failure.
		*m: setstringat		&& Introduced in version 9.5.0.56. Sets the string value of the Nth member. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setstringof		&& Introduced in version 9.5.0.56. Sets the string value at the specified jsonPath. Returns 1 for success, 0 for failure.
		*m: sizeofarray		&& Introduced in version 9.5.0.56. Returns the size of the array at the given jsonPath. Returns -1 if the jsonPath does not evaluate to an existent JSON array.
		*m: size_access		&& Access method used to retrieve the Chilkat JSONObject Size property.
		*m: size_assign		&& Assign method used to hold a reference to the Size property.
		*m: sort		&& Introduced in version 9.5.0.100. Sorts the JSON members by the member name.
		*m: strict_access		&& Access method used to retrieve the Chilkat JSONObject Strict property.
		*m: strict_assign		&& Assign method used to hold a reference to the Strict property.
		*m: stringat		&& Introduced in version 9.5.0.56. Returns the string value of the Nth member. Indexing is 0-based (the 1st member is at index 0). Returns Nothing on failure
		*m: stringof		&& Introduced in version 9.5.0.56. Returns the string value at the specified jsonPath. Returns Nothing on failure
		*m: stringofequals		&& Introduced in version 9.5.0.96. Returns 1 if the string value at the specified jsonPath equals value. Otherwise returns 0.
		*m: stringofsb		&& Introduced in version 9.5.0.68. Appends the string value at the specified jsonPath to sb. Returns 1 for success, 0 for failure.
		*m: swap		&& Introduced in version 9.5.0.76. Swaps the positions of members at index1 and index2. Returns 1 for success, 0 for failure.
		*m: typeat		&& Introduced in version 9.5.0.58. Returns the type of data at the given index. Possible return values are: 1) string 2) number 3) object 4) array 5) boolean 6) null. Returns -1 if no member exists at the given index.
		*m: uintof		&& Introduced in version 9.5.0.96. Returns the unsigned integer at the specified jsonPath.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat JSONObject UncommonOpotions property
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: updatebd		&& Introduced in version 9.5.0.68. Updates or appends a new string member with the encoded contents of bd. If the full path specified by jsonPath does not exist, it is automatically created as needed.
		*m: updatebool		&& Introduced in version 9.5.0.63. Updates or appends a new boolean member. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: updateint		&& Introduced in version 9.5.0.63. Updates or appends a new integer member. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: updatenewarray		&& Introduced in version 9.5.0.75. Updates or appends a new and empty array at the jsonPath. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: updatenewobject		&& Introduced in version 9.5.0.75. Updates or appends a new and empty JSON object at the jsonPath. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: updatenull		&& Introduced in version 9.5.0.65. Updates or appends a null member. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: updatenumber		&& Introduced in version 9.5.0.65. Updates or appends a new numeric member. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: updatesb		&& Introduced in version 9.5.0.68. Updates or appends a new string member with the contents of sb. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: updatestring		&& Introduced in version 9.5.0.63. Updates or appends a new string member. If the full path specified by jsonPath does not exist, it is automatically created as needed.
		*m: updateuint		&& Introduced in version 9.5.0.96. Updates or appends a new unsigned integer member. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat JSONObject VerboseLogging property
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: writefile		&& Introduced in version 9.5.0.76. Saves the JSON to a file. Returns 1 for success, 0 for failure.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: delimiterchar		&& Introduced in version 9.5.0.58. Sets the delimiter char for JSON paths. The default value is ".". To use Firebase style paths, set this property to "/". (This is a string property that should have a length of 1 char.)
		*p: emitcompact		&& Introduced in version 9.5.0.56. If 1 then the Emit method outputs in the most compact form possible (a single-line with no extra whitespace). If 0, then emits with whitespace and indentation to make the JSON human-readable. The default value is 1.
		*p: emitcrlf		&& Introduced in version 9.5.0.56. If 1 then the Emit method uses CRLF line-endings when emitting the non-compact (pretty-print) format. If 0, then bare-LF's are emitted.
		*p: enablesecrets		&& Introduced in version 11.5.0. If 1 then the JSON value for the following methods can be a special format to indicate a Chilkat secret name to be found in the local manager (Windows Credentials Manager or Apple Keychain). The default value is 0.
		*p: i		&& Introduced in version 9.5.0.56. The value of the "i" index to be used when evaluating a JSON path.
		*p: j		&& Introduced in version 9.5.0.56. The value of the "j" index to be used when evaluating a JSON path.
		*p: k		&& Introduced in version 9.5.0.56. The value of the "k" index to be used when evaluating a JSON path.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: lowercasenames		&& Introduced in version 9.5.0.87. If 1 then all member names are converted to lowercase when the JSON is initially loaded by the following methods: Load, LoadBd, LoadSb, LoadFile. The default value is 0.
		*p: pathprefix		&& Introduced in version 9.5.0.76. A prefix string that is automatically added to the JSON path passed in the first argument for other methods (such as StringOf, UpdateString, SetBoolOf, SizeOfArray, etc.) The default value is the empty string.
		*p: size		&& Introduced in version 9.5.0.56. The number of name/value members in this JSON object.
		*p: strict		&& Introduced in version 11.6.0. When Strict is true, the Load methods first check that the data is well-formed JSON. If it is not, the load fails and the contents of this JsonObject are left unchanged. The default is 0.
		*p: uncommonoptions		&& Introduced in version 9.5.0.90. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = JsonObject
		debuglogfilepath = 
		delimiterchar = .
		emitcompact = 1
		emitcrlf = 1
		enablesecrets = 0
		i = 0
		iinstancepatch = 56
		j = 0
		k = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		lowercasenames = 0
		Name = "jsonobject"
		pathprefix = 
		size = 0
		strict = 0
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addarrayat		&& Introduced in version 9.5.0.56. Inserts a new and empty JSON array member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*==============================================================================
		* Method:            AddArrayAt
		* Purpose:           Inserts a new and empty JSON array member 
		*                    to the position indicated by index.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, determines where the array is added.
		*                    tcName, the name of the member array.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/03/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Inserts a new and empty JSON array member to the position indicated by index. 
		** To prepend, pass an index of 0. To append, pass an index of -1. 
		** Indexing is 0-based (the 1st member is at index 0).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tcName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		luReturn AS Unknown
		
