	PROCEDURE fileexists		&& Returns 1 if filePath exists, otherwise returns 0.
		*==============================================================================
		* Method:            FileExists
		* Purpose:           Returns 1 if filePath exists, otherwise returns 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Returns 1 if filePath exists, otherwise returns 0.
		**
		** Fix for version 78: The method returned true for network paths that don’t exist. 
		** (The FileExists3 method, which is recommended over FileExists 
		** because it returns three possible values: exist, not-exist, and unable-to-check, 
		** would return unable-to-check, but now returns not-exist.)
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.FileExists(m.tcFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fileexists3		&& Introduced in version 9.5.0.45. Returns 1 if the file exists, 0 if the file does not exist, and -1 if unable to check because of directory permissions or some other error that prevents the ability to obtain the information.
		*==============================================================================
		* Method:            FileExists3
		* Purpose:           Returns 1 if the file exists, 0 if the file does not exist, 
		*                    and -1 otherwise.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file.
		* Returns:           1 if exists, 0 if not, -1 if can't check.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.45
		**
		** Returns 1 if the file exists, 0 if the file does not exist, 
		** and -1 if unable to check because of directory permissions 
		** or some other error that prevents the ability to obtain the information.
		** 
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liFileStatus AS Integer
		
		STORE 0 TO m.liFileStatus, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 45
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liFileStatus = m.loChilkatObject.FileExists3(m.tcFilePath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFileStatus 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fileopen		&& This method should only be called on Windows operating systems. It's arguments are similar to the Windows Platform SDK function named CreateFile.
		*==============================================================================
		* Method:            FileOpen
		* Purpose:           This method should only be called on Windows operating systems.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the existing file and path.
		*                    tiFileAccessMode, the access mode setting.
		*                    tiFileShareMode, the file share mode setting.
		*                    tiCreateDisposition, the file disposition setting.
		*                    tiFileAttributeMode, the file attribute mode.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** This method should only be called on Windows operating systems. 
		** It's arguments are similar to the Windows Platform SDK function named CreateFile. 
		** For Linux, MAC OS X, and other operating system, use the OpenForRead, 
		** OpenForWrite, OpenForReadWrite, and OpenForAppend methods.
		** 
		** Opens a file for reading or writing. The arguments mirror the Windows CreateFile function:
		** 
		** Access Modes:
		** GENERIC_READ  (0x80000000)
		** GENERIC_WRITE (0x40000000)
		** 
		** Share Modes:
		** FILE_SHARE_READ(0x00000001)
		** FILE_SHARE_WRITE(0x00000002)
		** 
		** Create Dispositions
		** CREATE_NEW          1
		** CREATE_ALWAYS       2
		** OPEN_EXISTING       3
		** OPEN_ALWAYS         4
		** TRUNCATE_EXISTING   5
		** 
		** // Attributes:
		** FILE_ATTRIBUTE_READONLY         0x00000001
		** FILE_ATTRIBUTE_HIDDEN           0x00000002
		** FILE_ATTRIBUTE_SYSTEM           0x00000004
		** FILE_ATTRIBUTE_DIRECTORY        0x00000010
		** FILE_ATTRIBUTE_ARCHIVE          0x00000020
		** FILE_ATTRIBUTE_NORMAL           0x00000080
		** FILE_ATTRIBUTE_TEMPORARY         0x00000100
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath AS Character, tiFileAccessMode AS Integer, ;
		tiFileShareMode AS Integer, tiCreateDisposition AS Integer, ;
		tiFileAttributeMode AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liErrorIfFileExists AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liErrorIfFileExists
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.FileOpen(m.tcFilePath, m.tiFileAccessMode, ;
		      m.tiFileShareMode, m.tiCreateDisposition, m.tiFileAttributeMode) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE fileopenerrormsg_access		&& Access method used to retrieve the Chilkat FileAccess FileOpenErrorMsg property.
		*==============================================================================
		* Method:            FileOpenErrorMsg_Access
		* Purpose:           Access method used to retrieve 
		*                    the FileOpenErrorMsg property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FileOpenErrorMsg
		* Date Added:        06/18/2022
		*==============================================================================
		
		** 
		** The error message text associated with the FileOpenError code.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE fileopenerrormsg_assign		&& Assign method used to hold the Chilkat FileAccess FileOpenErrorMsg property.
		*==============================================================================
		* Method:            FileOpenErrorMsg_Assign
		* Purpose:           Assign method used to hold
		*                    the FileOpenErrorMsg of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the FileOpenErrorMsg property.
