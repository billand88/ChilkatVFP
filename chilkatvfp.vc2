	PROCEDURE fetchattachmentbytes		&& Downloads one of an email's attachments and returns the attachment data as in-memory bytes that may be accessed by an application. ***See the FetchAttachment method description for more information about fetching attachments.
		*==============================================================================
		* Method:            FetchAttachmentBytes
		* Purpose:           Downloads one of an email's attachments 
		*                    and returns the attachment data as in-memory bytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail -- a Chilkat Email object.
		*                    tiAttachIndex -- the attachment index.
		* Returns:           The attachment data as in-memory bytes.
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Downloads one of an email's attachments and returns the attachment data 
		** as in-memory bytes that may be accessed by an application. 
		** ***See the FetchAttachment method description for more information about fetching attachments.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		**
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, tiAttachIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, lqData AS VarBinary, ;
		loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.lqData, m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		     NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		
		      lqData = ;
		      m.loChilkatObject.FetchAttachmentBytes(m.loChilkatEmail, m.tiAttachIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		     toChilkatEmail = ;
		     m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.lqData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

