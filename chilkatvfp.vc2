	PROCEDURE unzipmatching		&& Same as Unzip, but only unzips files matching a pattern. If no wildcard characters ('*') are used, then only files that exactly match the pattern will be unzipped. The "*" characters matches 0 or more of any character.
		*==============================================================================
		* Method:            UnZipMatching
		* Purpose:           Same as Unzip, but only unzips files matching a pattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryPath -- the path to unzip the file.
		*                    tcPattern -- the pattern to match.
		*                    tuVerbose -- whether or not the unzipping is verbose.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Same as Unzip, but only unzips files matching a pattern. 
		** If no wildcard characters ('*') are used, 
		** then only files that exactly match the pattern will be unzipped. 
		** The "*" characters matches 0 or more of any character.
		**
		
		LPARAMETERS tcDirectoryPath AS Character, ;
		tcPattern AS Character, tuVerbose AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liVerbose AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liVerbose
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liVerbose = .LogicalToBit(m.tuVerbose)
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.UnZipMatching(m.tcDirectoryPath, m.tcPattern, m.liVerbose) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

