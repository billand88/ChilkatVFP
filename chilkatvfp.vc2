	PROCEDURE find		&& Finds the index of the first string equal to findStr. The search begins at startIndex. If the string is not found, -1 is returned. The first string in the array is at index 0.
		*==============================================================================
		* Method:            Find
		* Purpose:           Finds the index of the first string equal to findStr.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the string to find.
		*                    tiStartIndex, the index value to start the search.
		* Returns:           The index value, or -1 if not found.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Finds the index of the first string equal to findStr. 
		** The search begins at startIndex. If the string is not found, -1 is returned. 
		** The first string in the array is at index 0.
		** 
		
		LPARAMETERS tcString AS Character, tiStartIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, liFound AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFound = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFound = m.loChilkatObject.Find(m.tcString, m.tiStartIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFound
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE findfirstmatch		&& Finds the first string that matches the matchPattern. The search begins at startIndex. If the string is not found, -1 is returned. The first string in the array is at index 0.
		*==============================================================================
		* Method:            FindFirstMatch
		* Purpose:           Finds the first string that matches the matchPattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMatchString, the string to match against.
		*                    tiStartIndex, the index value to start the search.
		* Returns:           The index value, or -1 if not found.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Finds the first string that matches the matchPattern. The search begins at startIndex. 
		** If the string is not found, -1 is returned. The first string in the array is at index 0.
		** 
		** The matchPattern may contain zero or more asterisk chars, 
		** each of which matches 0 or more of any character.
		**
		
		LPARAMETERS tcMatchString AS Character, tiStartIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, liFound AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFound = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFound = m.loChilkatObject.FindFirstMatch(m.tcMatchString, m.tiStartIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFound
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

