DEFINE CLASS versioning AS base OF "chilkatvfp.vcx" 		&& Lightweight class used for version testing.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: calculatemajorminorpatch		&& Method used to calculate the major/minor/patch pieces of Chilkat object when it originally existed and the current version being used.
		*m: generateversionnumber		&& Method run to generate a usable version number.
		*m: getchilkatversioningobject		&& Method used to return a Chilkat object that contains a Version property.
		*m: getversioningattributes		&& Method acting as a controller to the versioning properties of the Chilkat and ChilkatVFP objects.
		*m: isimplemented		&& Method used to determine if the property or class or method is implemented.
		*p: cchilkatobjectprefix		&& Character property used to hold a reference to the Chilkat prefix expression used to make the COM call.
		*p: ibuildmajor		&& Property used to hold the iBuildMajor property of the Chilkat object.
		*p: ibuildminor		&& Property used to hold the iBuildMinor property of the Chilkat object.
		*p: ibuildpatch		&& Property used to hold the iBuildPatch property of the Chilkat object.
		*p: iinstancemajor		&& Property used to hold a reference to the major version number for the referenced Chilkat object.
		*p: iinstanceminor		&& Property used to hold a reference to the minor version number for the referenced Chilkat object.
		*p: iinstancepatch		&& Property used to hold a reference to the patch version number for the referenced Chilkat object.
		*p: lretired		&& Logical property used to determine if the class has been retired (removed).
		*p: lsupportssemanticversioning		&& Logical property used to determine if the Chilkat object supports semantic versioning.
		*p: ochilkatversion		&& Object property used to hold the Chilkat object with a Version property.
		*p: ochilkatvfp		&& Object property used to hold a reference to the ChilkatVFP object.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatobjectprefix = 
		ibuildmajor = 0
		ibuildminor = 0
		ibuildpatch = 0
		iinstancemajor = 0
		iinstanceminor = 0
		iinstancepatch = 0
		lretired = .F.
		lsupportssemanticversioning = <fb2p_value>.F.&#13;</fb2p_value>
		Name = "versioning"
		ochilkatversion = .NULL.
		ochilkatvfp = .NULL.
	*</PropValue>
	
	PROCEDURE calculatemajorminorpatch		&& Method used to calculate the major/minor/patch pieces of Chilkat object when it originally existed and the current version being used.
		*==============================================================================
		* Method:            CalculateMajorMinorPatch
		* Purpose:           Method used to calculate the major/minor/patch pieces 
		*                    of Chilkat object when it originally existed 
		*                    and the current version being used.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        09/28/2024
		*==============================================================================
		
		LOCAL loChilkatVersion AS Object, llReturn AS Logical, liDots AS Integer, ;
		loChilkatVFP AS [BaseChilkat Of ChilkatVFP.VCX], lcVersion AS Character
		
		llReturn = .F.
		lcVersion = []
		liDots = 0
		
		WITH THIS
		
		  loChilkatVersion = .oChilkatVersion
		  loChilkatVFP = .oChilkatVFP
		
		  ** Have objects test
		  IF VARTYPE(m.loChilkatVersion) == T_OBJECT ;
		  AND VARTYPE(m.loChilkatVFP) == T_OBJECT
		
		    llReturn = .T.
		
		    lcVersion = m.loChilkatVersion.Version
		
		    liDots = OCCURS([.], m.lcVersion)
		
		    ** Version processing branch
		    DO CASE
		
		      ** Two dots test
		      CASE m.liDots = 2 && i.e. [10.0.0]
		
		        .iBuildMajor = INT(VAL(SUBSTRC(m.lcVersion, 1, AT_C([.], m.lcVersion, 1) - 1)))
		        .iBuildMinor = INT(VAL(STREXTRACT(m.lcVersion, [.], [.])))
		        .iBuildPatch = INT(VAL(SUBSTRC(m.lcVersion, AT_C([.], m.lcVersion, 2) + 1)))
		
		      ** Three dots test
		      CASE m.liDots = 3 && i.e. [9.5.0.63]
		
		        .iBuildMajor = INT(VAL(SUBSTRC(m.lcVersion, 1, AT_C([.], m.lcVersion, 1) - 1)))
		        .iBuildMinor = INT(VAL(STREXTRACT(m.lcVersion, [.], [.])))
		        .iBuildPatch = INT(VAL(SUBSTRC(m.lcVersion, AT_C([.], m.lcVersion, 3) + 1)))
		 
		    ENDCASE
		    ** End version processing branch
		
		  ENDIF VARTYPE(m.loChilkatVersion) == T_OBJECT ;
		  AND VARTYPE(m.loChilkatVFP) == T_OBJECT
		  ** End have objects test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatVersion, m.loChilkatVFP 
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE Destroy
		*==============================================================================
		* Method:            Destroy
		* Purpose:           Occurs when an object is released.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        09/28/2024
		*==============================================================================
		
		WITH THIS
		
		  ** Have a good object test
		  IF TYPE([.oChilkatVFP.Name]) == T_CHARACTER
		
		    .oChilkatVFP.Release()
		
		  ENDIF TYPE([.oChilkatVFP.Name]) == T_CHARACTER
		  ** End have a good object test
		
		  STORE NULL TO .oChilkatVersion, .oChilkatVFP
		
		ENDWITH
		
		RETURN DODEFAULT()
	ENDPROC

	PROCEDURE generateversionnumber		&& Method run to generate a usable version number.
		*==============================================================================
		* Method:            GenerateVersionNumber
		* Purpose:           Method run to generate a usable version number.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, a numeric expression, a character expression, or an array.
		*                    tiMinorVersion, the version's minor number.
		*                    tiPatchVersion, the version's patch number.
		* Returns:           The calculated version number.
		* Date Added:        12/05/2024
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown, tiMinorVersion AS Integer, tiPatchVersion AS Integer
		
		LOCAL luValue AS Unknown, liMinorVersion AS Integer, liPatchVersion AS Integer, ;
		liCalculatedVersionNumber AS Integer, liParameterCount As Integer
		
		LOCAL ARRAY la_Version[3, 1]
		
		luValue = m.tuValue
		liMinorVersion = m.tiMinorVersion
		liPatchVersion = m.tiPatchVersion
		
		STORE 0 TO m.liCalculatedVersionNumber, m.liParameterCount
		
		la_Version = []
		liParameterCount = PCOUNT()
		
		** Parameter processing branch
		DO CASE
		
		  ** Passed token test
		  CASE m.liParameterCount = 1 AND (TYPE([m.luValue]) = T_CHARACTER)
		
		    WITH THIS
		
		      ** Token processing branch
		      DO CASE
		
		        ** Calculate the build branch
		        CASE ALLTRIM(UPPER(m.luValue)) == [BUILD]
		
		          liCalculatedVersionNumber = (.iBuildMajor * 1000000) + (.iBuildMinor * 1000) + .iBuildPatch
		
		        ** Calculate the instance branch
		        CASE ALLTRIM(UPPER(m.luValue)) == [INSTANCE]
		
		          liCalculatedVersionNumber = (.iInstanceMajor * 1000000) + (.iInstanceMinor * 1000) + .iInstancePatch
		
		      ENDCASE
		      ** End token processing branch
		
		    ENDWITH
		
		  ** Passed array as first parameter test
		  CASE TYPE([tuValue], 1) == [A]
		
		    ACOPY(tuValue, m.la_Version)
		
		    liCalculatedVersionNumber = ;
		    (IIF(VARTYPE(m.la_Version[1]) == T_NUMERIC, m.la_Version[1], 0) * 1000000) + ;
		    (IIF(VARTYPE(m.la_Version[2]) == T_NUMERIC, m.la_Version[2], 0) * 1000) + ;
		    IIF(VARTYPE(m.la_Version[3]) == T_NUMERIC, m.la_Version[3], 0)
		 
		  ** Passed values test
		  CASE m.liParameterCount = 3 
		
		    liCalculatedVersionNumber = (m.luValue * 1000000) + (m.liMinorVersion * 1000) + m.liPatchVersion
		
		ENDCASE
		** End parameter processing branch
		
		liCalculatedVersionNumber = INT(m.liCalculatedVersionNumber)
		
		** Redefine when not in use.
		LOCAL ARRAY la_Version[1, 1]
		
		la_Version = []
		
		RETURN m.liCalculatedVersionNumber
	ENDPROC

	PROCEDURE getchilkatversioningobject		&& Method used to return a Chilkat object that contains a Version property.
		*==============================================================================
		* Method:            GetChilkatVersioningObject
		* Purpose:           Method used to return a Chilkat object that contains a Version property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat object or NULL
		* Date Added:        08/29/2022
		*==============================================================================
		
		LOCAL loChilkatObject AS Object, li1 AS Integer, lcClassName AS Character, ;
		lcError AS Character, llInstantiatedChilkatObject AS Logical, li2 AS Integer
		
		LOCAL ARRAY la_Class[50], la_Prefix[2]
		
		STORE [] TO m.lcClassName, m.lcError, m.la_Classes, m.la_Prefix
		STORE 0 TO m.li1, m.li2
		
		loChilkatObject = NULL
		lcError = ON([ERROR])
		
		la_Prefix[1] = [Chilkat_9_5_0]
		la_Prefix[2] = [Chilkat]
		
		** The idea here is to try a smattering of purchased classes after Global, 
		** hoping to find one that can be instantiated. If not, rifle through
		** all the free classes and see if you can find one to load.
		
		la_Class[1] = [Global]
		la_Class[2] = [Email]
		la_Class[3] = [Zip]
		la_Class[4] = [Crypt]
		la_Class[5] = [Mht]
		la_Class[6] = [Mime]
		la_Class[7] = [Imap]
		la_Class[8] = [Bounce]
		la_Class[9] = [Pfx]
		la_Class[10] = [Ftp2]
		la_Class[11] = [Http]
		la_Class[12] = [HtmlToXml]
		la_Class[13] = [Xmp]
		la_Class[14] = [Rsa]
		la_Class[15] = [Socket]
		la_Class[16] = [Tar]
		la_Class[17] = [Ssh]
		la_Class[18] = [Sftp]
		la_Class[19] = [Xml]
		la_Class[20] = [Atom]
		la_Class[21] = [BinData]
		la_Class[22] = [Cert]
		la_Class[23] = [CertChain]
		la_Class[24] = [CertStore]
		la_Class[25] = [CkDateTime]
		la_Class[26] = [CreateCS]
		la_Class[27] = [Csp]
		la_Class[28] = [Csv]
		la_Class[29] = [DirTree]
		la_Class[30] = [DtObj]
		la_Class[31] = [FileAccess]
		la_Class[32] = [HashTable]
		la_Class[33] = [JsonArray]
		la_Class[34] = [JsonObject]
		la_Class[35] = [KeyContainer]
		la_Class[36] = [Log]
		la_Class[37] = [PrivateKey]
		la_Class[38] = [PublicKey]
		la_Class[39] = [Rss]
		la_Class[40] = [SecureString]
		la_Class[41] = [ServerSentEvent]
		la_Class[42] = [Spider]
		la_Class[43] = [Stream]
		la_Class[44] = [StringArray]
		la_Class[45] = [StringBuilder]
		la_Class[46] = [StringTable]
		la_Class[47] = [TrustedRoots]
		la_Class[48] = [Upload]
		la_Class[49] = [Url]
		la_Class[50] = [XmlCertVault]
		
		ON ERROR * && Eat the ERROR 1733 errors...
		
		** Walk through array list test
		FOR li1 = 1 TO ALEN(m.la_Class, 1)
		
		  ** Walk through Chilkat prefixes loop
		  FOR li2 = 1 TO 2
		
		    lcClassName = m.la_Prefix(m.li2) + [.] + m.la_Class(m.li1)
		
		    loChilkatObject = CREATEOBJECT(m.lcClassName)
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      ** We have a good one!
		      llInstantiatedChilkatObject = .T.
		      THIS.oChilkatVersion = m.loChilkatObject
		
		      EXIT
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good Chilkat object test
		
		  ENDFOR m.li2 = 1 TO 2
		  ** End walk through Chilkat prefixes loop
		
		  ** Have a good object test
		  IF m.llInstantiatedChilkatObject
		
		    EXIT
		
		  ENDIF m.llInstantiatedChilkatObject 
		  ** End have a good object test
		
		ENDFOR m.li1 = 1 TO ALEN(m.la_Class, 1)
		** End walk through array list test
		
		ON ERROR &lcError.
		
		** Got a good Chilkat object test
		IF m.llInstantiatedChilkatObject
		
		  ** Set object properties based on the results before leaving...
		  WITH THIS
		
		    .cChilkatObjectPrefix = m.la_Prefix[m.li2]
		    .lSupportsSemanticVersioning = ((m.li2 = 2) OR ((OCCURS([.], m.loChilkatObject.Version) = 2)))
		
		  ENDWITH
		
		ENDIF m.llInstantiatedChilkatObject
		** End got a good Chilkat object test
		
		RETURN m.llInstantiatedChilkatObject 
		
		
	ENDPROC

	PROCEDURE getversioningattributes		&& Method acting as a controller to the versioning properties of the Chilkat and ChilkatVFP objects.
		*==============================================================================
		* Method:            GetVersioningAttributes
		* Purpose:           Method acting as a controller to the versioning 
		*                    properties of the Chilkat and ChilkatVFP objects.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat object or NULL
		* Date Added:        09/28/2024
		*==============================================================================
		
		LOCAL loChilkatVersion AS [Versioning OF ChilkatVFP.VCX], ;
		llReturn AS Logical, llCkStringProperty AS Logical, ;
		llSFTPDirProperty AS Logical, llSFTPFileProperty AS Logical, ;
		llStringBuilderMethod AS Logical, llBinDataMethod AS Logical, ;
		llNoVersionProperty AS Logical, lcVersion AS Character, ;
		llSecureStringMethod AS Logical, llServerSentEventProperty AS Logical, ;
		llMailboxesMethod AS Logical, llMessageSetProperty AS Logical, ;
		llURLProperty AS Logical, llHashTableMethod AS Logical, ;
		loChilkatVFP AS [BaseChilkat OF ChilkatVFP.VCX]
		
		STORE NULL TO m.loChilkatVersion, m.loChilkatVFP
		
		STORE .F. TO m.llCkStringProperty, m.llSFTPDirProperty, m.llSFTPFileProperty, ;
		m.llStringBuilderMethod, m.llBinDataMethod, m.llNoVersionProperty, ;
		m.llSecureStringMethod, m.llServerSentEventProperty, m.llMailboxesMethod, ;
		m.llMessageSetProperty, m.llURLProperty, m.llHashTableMethod
		
		lcVersion = []
		llReturn = .T.
		
		WITH THIS
		
		  loChilkatVersion = .GetChilkatVersioningObject()
		
		  ** Have a good Chilkat comparison object test
		  IF VARTYPE(m.loChilkatVersion) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatVersion))
		
		    loChilkatVFP = .oChilkatVFP
		
		    ** Have object reference test (should be true)
		    IF VARTYPE(m.loChilkatVFP) == T_OBJECT
		
		      ** Note: The test against the ChilkatVFP wrapper is deliberate.
		      ** Testing the Chilkat object property works in the debugger
		      ** (when the program is stopped) but does not necessarily work at runtime.
		
		      llCkStringProperty = (PEMSTATUS(THIS, [NumCyrillic], 5))
		      llSFTPDirProperty = (PEMSTATUS(THIS, [OriginalPath], 5))
		      llSFTPFileProperty = (PEMSTATUS(THIS, [IsImmutable], 5))
		      llStringBuilderMethod = (PEMSTATUS(THIS, [ReplaceNoCase], 5))
		      llBinDataMethod = (PEMSTATUS(THIS, [GetTextChunk], 5))
		      llSecureStringMethod = (PEMSTATUS(THIS, [SecStrEquals], 5))
		      llServerSentEventProperty = (PEMSTATUS(THIS, [LastEventID], 5))
		      llMailboxesMethod = (PEMSTATUS(THIS, [HasInferiors], 5))
		      llMessageSetProperty = (PEMSTATUS(THIS, [HasUIDs], 5))
		      llURLProperty = (PEMSTATUS(THIS, [Frag], 5))
		      llHashTableMethod = (PEMSTATUS(THIS, [ClearWithNewCapacity], 5))
		
		      llNoVersionProperty = (m.llCkStringProperty OR m.llSecureStringMethod OR m.llSFTPDirProperty ;
		      OR m.llSFTPFileProperty OR m.llStringBuilderMethod OR m.llBinDataMethod ;
		      OR m.llServerSentEventProperty OR m.llMailboxesMethod OR m.llMessageSetProperty ;
		      OR m.llURLProperty OR m.llHashTableMethod)
		
		     ** The referenced Chilkat objects have no Version property. So we test for 
		      ** a unique property on the container (the container being a ChilkatVFP object
		      ** that calls the Chilkat object by the same property name)
		  
		      ** Using a class with a Version property test
		      IF NOT m.llNoVersionProperty
		
		        lcVersion = m.loChilkatVFP.Version
		
		      ELSE
		
		        lcVersion = m.loChilkatVersion.Version 
		
		      ENDIF NOT m.llNoVersionProperty
		      ** End using a class with a Version property test
		
		      THIS.cChilkatVersion = m.lcVersion
		
		    ELSE
		
		      llReturn = .F.
		
		    ENDIF VARTYPE(m.loChilkatVFP) == T_OBJECT
		    ** End have object reference test (should be true)
		
		  ELSE
		
		    llReturn = .F.
		
		  ENDIF VARTYPE(m.loChilkatVersion) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatVersion))
		  ** Have a good Chilkat comparison object test
		
		ENDWITH
		
		loChilkatVersion = NULL
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatVFPInstanceClass, a Chilkat VFP Instance class (e.g. Asn)
		* Returns:           Logical, indicating success.
		* Date Added:        10/06/2024
		*==============================================================================
		
		LPARAMETERS toChilkatVFPInstanceClass AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatVFPInstanceClass AS [iBaseChilkat OF ChilkatVFP.VCX], llReturn AS Logical
		
		llReturn = .T.
		
		loChilkatVFPInstanceClass = m.toChilkatVFPInstanceClass
		
		** Have object test
		IF TYPE([loChilkatVFPInstanceClass.Name]) == T_CHARACTER ;
		AND PEMSTATUS(m.loChilkatVFPInstanceClass, [oChilkat], 5)
		
		  WITH THIS
		
		    ** Have property on passed object test
		    IF PEMSTATUS(m.loChilkatVFPInstanceClass, [iInstanceMajor], 5)
		
		      .iInstanceMajor = m.loChilkatVFPInstanceClass.iInstanceMajor
		
		    ELSE
		
		      llReturn = .F.
		
		    ENDIF PEMSTATUS(m.loChilkatVFPInstanceClass, [iInstanceMajor], 5)
		    ** End have property on passed object test
		
		    ** Have property on passed object test
		    IF m.llReturn AND (PEMSTATUS(m.loChilkatVFPInstanceClass, [iInstanceMinor], 5))
		
		      .iInstanceMinor = m.loChilkatVFPInstanceClass.iInstanceMinor
		
		    ELSE
		
		      llReturn = .F.
		
		    ENDIF m.llReturn AND (PEMSTATUS(m.loChilkatVFPInstanceClass, [iInstanceMinor], 5))
		    ** End have property on passed object test
		
		    ** Have property on passed object test
		    IF m.llReturn AND (PEMSTATUS(m.loChilkatVFPInstanceClass, [iInstancePatch], 5))
		
		      .iInstancePatch = m.loChilkatVFPInstanceClass.iInstancePatch
		
		    ELSE
		
		      llReturn = .F.
		
		    ENDIF m.llReturn AND (PEMSTATUS(m.loChilkatVFPInstanceClass, [iInstancePatch], 5))
		    ** End have property on passed object test
		
		    ** Okay to continue test
		    IF m.llReturn
		
		      .oChilkatVFP = m.toChilkatVFPInstanceClass
		
		      llReturn = .GetChilkatVersioningObject()
		
		      ** Okay to continue test
		      IF m.llReturn
		
		        .CalculateMajorMinorPatch()
		
		        ** We determined the version so we don't need the extra "weight"...
		        .oChilkatVersion = NULL
		
		      ENDIF m.llReturn
		      ** End okay to continue test
		
		    ENDIF m.llReturn
		    ** End okay to continue test
		
		  ENDWITH
		
		ELSE
		
		  llReturn = .F.
		
		ENDIF TYPE([loChilkatVFPInstanceClass.Name]) == T_CHARACTER ;
		AND PEMSTATUS(m.loChilkatVFPInstanceClass, [oChilkat], 5)
		** End have object test
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE isimplemented		&& Method used to determine if the property or class or method is implemented.
		*==============================================================================
		* Method:            IsImplemented
		* Purpose:           Method used to determine if the property or class or method is implemented.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiInstanceMajor - The instance major version. 
		*                    tiInstanceMinor - The instance minor version. 
		*                    tiInstancePatch - The instance patch version. 
		* Returns:           Logical, indicating implementation.
		* Date Added:        09/29/2024
		*==============================================================================
		
		** Current Chilkat version is contained in the iBuild* properties.
		** The original definition (the instance it existed) is contained within the iInstance* properties.
		
		LPARAMETERS tiInstanceMajor AS Integer, tiInstanceMinor AS Integer, tiInstancePatch AS Integer
		
		LOCAL liInstance AS Integer, liBuild AS Integer, llReturn AS Logical, ;
		liBuildMajor AS Integer, liBuildMinor AS Integer, liBuildPatch AS Integer, ;
		liPCount AS Integer, liRetirementMajor AS Integer, liRetirementMinor AS Integer, ;
		liRetirementPatch AS Integer, liRetirement AS Integer
		
		liPCount = PCOUNT()
		
		STORE 0 TO m.liInstance, m.liBuild, m.liBuildMajor, m.liBuildMinor, m.liBuildPatch, ;
		m.liRetirementMajor, m.liRetirementMinor, m.liRetirementPatch, m.liRetirement
		
		llReturn = .F.
		
		WITH THIS
		
		  ** Chilkat/ChilkatVFP version calculation branch
		  DO CASE 
		
		    ** Chilkat/ChilkatVFP object creation branch
		    CASE m.liPCount = 0
		
		      ** This option occurs when we instantiate the Chilkat/ChilkatVFP objects.
		      ** In this case we have to calculate the Chilkat version on the fly.
		
		      liBuildMajor = .iBuildMajor
		      liBuildMinor = .iBuildMinor
		      liBuildPatch = .iBuildPatch
		
		    ** Chilkat property/method existence branch
		    CASE m.liPCount = 3
		
		      ** This option can occur after the Chilkat/ChilkatVFP objects are created.
		      ** It is used when a relevant property or method on the object(s) existed
		      ** starting in a particular Chilkat version.
		
		      liBuildMajor = m.tiInstanceMajor
		      liBuildMinor = m.tiInstanceMinor
		      liBuildPatch = m.tiInstancePatch
		
		  ENDCASE
		  ** End Chilkat/ChilkatVFP version calculation branch
		
		  liBuild = (m.liBuildMajor * 1000000) + (m.liBuildMinor * 1000) + m.liBuildPatch
		  liInstance = (.iInstanceMajor * 1000000) + (.iInstanceMinor * 1000) + .iInstancePatch
		
		  llReturn = NOT (m.liInstance > m.liBuild)
		
		ENDWITH
		
		** Class could exist test
		IF m.llReturn
		
		  liRetirementMajor = .iRetirementMajor
		  liRetirementMinor = .iRetirementMinor
		  liRetirementPatch = .iRetirementPatch
		
		  liRetirement = (m.liRetirementMajor * 1000000) + (m.liRetirementMinor * 1000) + m.liRetirementPatch
		
		  llReturn = (m.liRetirement = 0) OR (m.liBuild < m.liRetirement)
		
		  THIS.lRetired = (NOT m.llReturn)  
		
		ENDIF m.llReturn
		** End class could exist test
		
		RETURN m.llReturn
	ENDPROC

ENDDEFINE

DEFINE CLASS websocket AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides an API for implementing the client side of the WebSocket protocol.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addclientheaders		&& Introduced in version 9.5.0.70. Adds the required WebSocket client-side open handshake headers.
		*m: closeautorespond_access		&& Access method used to retrieve the Chilkat WebSocket CloseAutoRespond property.
		*m: closeautorespond_assign		&& Assign method used to hold a reference to the CloseAutoRespond property.
		*m: closeconnection		&& Introduced in version 9.5.0.70. Forcibly closes the underlying connection. This is a non-clean way to close the connection, but may be used if needed.
		*m: closereason_access		&& Access method used to retrieve the Chilkat WebSocket CloseReason property.
		*m: closereason_assign		&& Assign method used to hold a reference to the CloseReason property.
		*m: closereceived_access		&& Access method used to retrieve the Chilkat WebSocket CloseReceived property.
		*m: closereceived_assign		&& Assign method used to hold a reference to the CloseReceived property.
		*m: closestatuscode_access		&& Access method used to retrieve the Chilkat WebSocket CloseStatusCode property.
		*m: closestatuscode_assign		&& Assign method used to hold a reference to the CloseStatusCode property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat WebSocket DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: finalframe_access		&& Access method used to retrieve the Chilkat WebSocket FinalFrame property.
		*m: finalframe_assign		&& Assign method used to hold a reference to the FinalFrame property.
		*m: framedatalen_access		&& Access method used to retrieve the Chilkat WebSocket FrameDataLen property.
		*m: framedatalen_assign		&& Assign method used to hold a reference to the FrameDataLen property.
		*m: frameopcodeint_access		&& Access method used to retrieve the Chilkat WebSocket FrameOpCodeInt property.
		*m: frameopcodeint_assign		&& Assign method used to hold a reference to the FrameOpCodeInt property.
		*m: frameopcode_access		&& Access method used to retrieve the Chilkat WebSocket FrameOpCode property.
		*m: frameopcode_assign		&& Assign method used to hold a reference to the FrameOpCode property.
		*m: getframedata		&& Introduced in version 9.5.0.70. Returns the accumulated received frame data as a string. Calling GetFrameData clears the internal receive buffer. Returns Nothing on failure.
		*m: getframedatabd		&& Introduced in version 9.5.0.70. Returns the accumulated received frame data in a BinData object. The received data is appended to the binData. Calling this method clears the internal receive buffer.
		*m: getframedatasb		&& Introduced in version 9.5.0.70. Returns the accumulated received frame data in a StringBuilder object. The received data is appended to the sb. Calling this method clears the internal receive buffer.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat WebSocket HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: idletimeoutms_access		&& Access method used to retrieve the Chilkat WebSocket IdleTimeoutMs property.
		*m: idletimeoutms_assign		&& Assign method used to hold a reference to the IdleTimeoutMs property.
		*m: isconnected_access		&& Access method used to retrieve the Chilkat WebSocket IsConnected property.
		*m: isconnected_assign		&& Assign method used to hold a reference to the IsConnected property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat WebSocket LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat WebSocket LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat WebSocket LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat WebSocket LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat WebSocket LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat WebSocket LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat WebSocket LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: needsendpong_access		&& Access method used to retrieve the Chilkat WebSocket NeedSendPong property.
		*m: needsendpong_assign		&& Assign method used to hold a reference to the NeedSendPong property.
		*m: pingautorespond_access		&& Access method used to retrieve the Chilkat WebSocket PingAutoRespond property.
		*m: pingautorespond_assign		&& Assign method used to hold a reference to the PingAutoRespond property.
		*m: polldataavailable		&& Introduced in version 9.5.0.70. Check to see if data is available for reading on the websocket. Returns 1 if data is waiting and 0 if no data is waiting to be read.
		*m: pongautoconsume_access		&& Access method used to retrieve the Chilkat WebSocket PongAutoConsume property.
		*m: pongautoconsume_assign		&& Assign method used to hold a reference to the PongAutoConsume property.
		*m: pongconsumed_access		&& Access method used to retrieve the Chilkat WebSocket PongConsumed property.
		*m: pongconsumed_assign		&& Assign method used to hold a reference to the PongConsumed property.
		*m: readframe		&& Introduced in version 9.5.0.70. Reads a single frame from the connected websocket.
		*m: readframeasync		&& Introduced in version 9.5.0.70. Creates an asynchronous task to call the ReadFrame method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: readframefailreason_access		&& Access method used to retrieve the Chilkat WebSocket ReadFrameFailReason property.
		*m: readframefailreason_assign		&& Assign method used to hold a reference to the ReadFrameFailReason property.
		*m: sendclose		&& Introduced in version 9.5.0.70. Sends a Close control frame. If includeStatus is 1, then the statusCode is sent in the application data part of the Close frame. A Close reason may be provided only if includeStatus is 1.
		*m: sendcloseasync		&& Introduced in version 9.5.0.70. Creates an asynchronous task to call the SendClose method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendframe		&& Introduced in version 9.5.0.70. Sends a single data frame containing a string. If this is the final frame in a message, then finalFrame should be set to 1. Otherwise set finalFrame equal to 0. Returns 1 for success, 0 for failure.
		*m: sendframeasync		&& Introduced in version 9.5.0.70. Creates an asynchronous task to call the SendFrame method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendframebd		&& Introduced in version 9.5.0.70. Sends a single data frame containing binary data (the contents of bdToSend). If this is the final frame in a message, then finalFrame should be set to 1. Otherwise set finalFrame equal to 0.
		*m: sendframebdasync		&& Introduced in version 9.5.0.70. Creates an asynchronous task to call the SendFrameBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendframesb		&& Introduced in version 9.5.0.70. Sends a single data frame containing a string (the contents of sbToSend). If this is the final frame in a message, then finalFrame should be set to 1. Otherwise set finalFrame equal to 0.
		*m: sendframesbasync		&& Introduced in version 9.5.0.70. Creates an asynchronous task to call the SendFrameSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendping		&& Introduced in version 9.5.0.70. Sends a Ping control frame, optionally including text data. If pingData is non-empty, the utf-8 representation of the string must be 125 bytes or less.
		*m: sendpingasync		&& Introduced in version 9.5.0.70. Creates an asynchronous task to call the SendPing method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendpong		&& Introduced in version 9.5.0.70. Sends a Pong control frame. If this Pong frame is sent to satisfy an unresponded-to Ping frame, then the previously received Ping data is automatically sent in this Pong frame. Returns 1 for success, 0 for failure.
		*m: sendpongasync		&& Introduced in version 9.5.0.70. Creates an asynchronous task to call the SendPong method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: shareconnection		&& Introduced in version 11.0.0. The caller will share ws's existing websocket connection, enabling multi-threaded applications to read and write to the websocket simultaneously. Returns 1 for success, 0 for failure.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat WebSocket UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: useconnection		&& Introduced in version 9.5.0.70. Initializes the connection for a WebSocket session. All WebSocket sessions begin with a call to UseConnection.
		*m: validateserverhandshake		&& Introduced in version 9.5.0.70. Called after sending the opening handshake from the Rest object. Validates the server's response to the opening handshake message.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat WebSocket VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: closeautorespond		&& Introduced in version 9.5.0.70. If 1, then a Close control frame is automatically sent in response to receiving a Close control frame (assuming that we did not initiate the Close in the first place).
		*p: closereason		&& Introduced in version 9.5.0.70. The reason string received with the Close frame, if any.
		*p: closereceived		&& Introduced in version 9.5.0.70. If 1, then a Close frame was already received on this websocket connection. If CloseAutoRespond is 0, then an application can check this property value to determine if a Close frame should be sent in response.
		*p: closestatuscode		&& Introduced in version 9.5.0.70. The status code received with the Close frame. If no status code was provided, or no Close frame has yet been received, then this property will be 0.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: finalframe		&& Introduced in version 9.5.0.70. 1 if the last data frame received by calling ReadFrame was a final frame. Otherwise 0.
		*p: framedatalen		&& Introduced in version 9.5.0.70. The number of bytes accumulated from one or more calls to ReadFrame. Accumulated incoming frame data can be retrieved by calling GetFrameData, GetFrameDataSb, or GetFrameDataBd.
		*p: frameopcode		&& Introduced in version 9.5.0.70. Indicates the type of frame received in the last call to ReadFrame. Possible values are "Continuation", "Text", "Binary", "Close", "Ping", or "Pong".
		*p: frameopcodeint		&& Introduced in version 9.5.0.70. The integer value of the opcode (type of frame) received in the last call to ReadFrame. Possible values are: 0 - Continuation, 1 - Text, 2 - Binary, 8 - Close, 9 - Ping, 10 - Pong.
		*p: heartbeatms		&& Introduced in version 9.5.0.97. The time interval, in milliseconds, between AbortCheck event callbacks. The heartbeat provides a means for an application to monitor a method call that has event callbacks, and to abort it while in progress.
		*p: idletimeoutms		&& The maximum amount of time to wait for additional incoming data when receiving, or the max time to wait to send additional data. The default value is 30000 (30 seconds).
		*p: isconnected		&& Introduced in version 9.5.0.70. Returns 1 if the websocket is connected. Otherwise returns 0.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: needsendpong		&& Introduced in version 9.5.0.70. If 1, then a Ping frame was received, but no Pong frame has yet been sent in response. The application should send a Pong frame by calling SendPong as soon as possible.
		*p: pingautorespond		&& Introduced in version 9.5.0.70. If 1, then a Pong frame is automatically sent when a Ping frame is received.
		*p: pongautoconsume		&& Introduced in version 9.5.0.70. If 1, then incoming Pong frames are automatically consumed, and a call to ReadFrame will continue reading until it receives a non-Pong frame.
		*p: pongconsumed		&& Is 1 if the last call to ReadFrame auto-consumed a Pong frame.
		*p: readframefailreason		&& Introduced in version 9.5.0.70. If the ReadFrame method returns 0, this property holds the fail reason.
		*p: uncommonoptions		&& Introduced in version 9.5.0.80. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = WebSocket
		ceventhandlerclass = iBaseEventHandler
		closeautorespond = 1
		closereason = 
		closereceived = 0
		closestatuscode = 0
		debuglogfilepath = 
		finalframe = 0
		framedatalen = 0
		frameopcode = 
		frameopcodeint = 0
		heartbeatms = 0
		idletimeoutms = 30000
		iinstancepatch = 70
		isconnected = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "websocket"
		needsendpong = 0
		pingautorespond = 1
		pongautoconsume = 1
		pongconsumed = 0
		readframefailreason = 0
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addclientheaders		&& Introduced in version 9.5.0.70. Adds the required WebSocket client-side open handshake headers.
		*==============================================================================
		* Method:            AddClientHeaders
		* Purpose:           Adds the required WebSocket client-side open handshake headers.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Adds the required WebSocket client-side open handshake headers.
		** The headers specifically added to the previously specified REST object 
		** (in the call to UseConnection) are:
		** 
		**   Upgrade: websocket
		**   Connection: Upgrade
		**   Sec-WebSocket-Key: ...
		**   Sec-WebSocket-Version: 13
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_WEBSOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddClientHeaders() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Added the ShareConnection method.
		
		** Version 89
		
		  Fixed problems when ECDSA certs are used for 2-way SSL (i.e. TLS client authentication).
		
		** Version 85
		
		  Fixed the error “Unexpected key_share group” that occurred in certain rare situations.
		
		** Version 83
		
		  Improved support for ECDSA certs.
		
		** Version 71
		
		  Fixed so that if corrupt data is received (i.e. bytes that do not conform
		  to the WebSocket framing protocol), then the connection is closed as per the WebSocket standard.
		
		** Version 70
		
		  Added the WebSocket class.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE closeautorespond_access		&& Access method used to retrieve the Chilkat WebSocket CloseAutoRespond property.
		*==============================================================================
		* Method:            CloseAutoRespond_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat WebSocket CloseAutoRespond property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CloseAutoRespond
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** If 1, then a Close control frame is automatically sent in response to receiving 
		** a Close control frame (assuming that we did not initiate the Close in the first place). 
		** When the Close frame has both been received and sent, 
		** the underlying connection is automatically closed 
		** (as per the WebSocket protocol RFC specifications). 
		** Thus, if this property is 1, then two things automatically happen when 
		** a Close frame is received: (1) a Close frame is sent in response, 
		** and (2) the connection is closed.
		** 
		** The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 70
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE closeautorespond_assign		&& Assign method used to hold a reference to the CloseAutoRespond property.
		*==============================================================================
		* Method:            CloseAutoRespond_Assign
		* Purpose:           Assign method used to hold a reference to the CloseAutoRespond property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the CloseAutoRespond property.
		* Returns:           
		* Date Added:        07/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 70
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE closeconnection		&& Introduced in version 9.5.0.70. Forcibly closes the underlying connection. This is a non-clean way to close the connection, but may be used if needed.
		*==============================================================================
		* Method:            CloseConnection
		* Purpose:           Forcibly closes the underlying connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Forcibly closes the underlying connection. 
		** This is a non-clean way to close the connection, but may be used if needed. 
		** The clean way to close a websocket is to send a Close frame, 
		** and then receive the Close response.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_WEBSOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.CloseConnection() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

