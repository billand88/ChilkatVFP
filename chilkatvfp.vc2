	PROCEDURE getcerts		&& Introduced in version 9.5.0.76. Returns the certificates found in the signature indicated by the Selector property. The base64 representation of each certificate is returned. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetCerts
		* Purpose:           Returns the certificates found in the signature 
		*                    indicated by the Selector property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringArray, a Chilkat String Array object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Returns the certificates found in the signature indicated by the Selector property. 
		** The base64 representation of each certificate is returned.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringArray = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		      loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetCerts(m.loChilkatStringArray) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringArray = m.loParkParameterStringArray.SetObject(;
		      m.toChilkatStringArray, m.loChilkatStringArray)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getkeyinfo		&& Introduced in version 9.5.0.69. Returns the KeyInfo XML for the signature indicated by the Selector property. Returns Nothing if no KeyInfo exists. Returns Nothing on failure.
