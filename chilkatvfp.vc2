	HIDDEN PROCEDURE numcachelevels_access		&& Access method used to retrieve the Chilkat MHT NumCacheLevels property.
		*==============================================================================
		* Method:            NumCacheLevels_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MHT NumCacheLevels property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumCacheLevels
		* Date Added:        07/18/2022
		*==============================================================================
		
		**
		** The number of directory levels to be used under each cache root. 
		** The default is 0, meaning that each cached item is stored in a cache root directory. 
		** A value of 1 causes each cached page to be stored in one of 255 subdirectories 
		** named "0","1", "2", ..."255" under a cache root. A value of 2 causes two levels 
		** of subdirectories ("0..255/0..255") under each cache root. 
		** The MHT control automatically creates subdirectories as needed. 
		** The reason for mutliple levels is to alleviate problems that may arise 
		** when huge numbers of files are stored in a single directory. 
		** For example, Windows Explorer does not behave well 
		** when trying to display the contents of directories with thousands of files.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE numcachelevels_assign		&& Assign method used to hold a reference to the MHT NumCacheLevels property.
		*==============================================================================
		* Method:            NumCacheLevels_Assign
		* Purpose:           Assign method used to hold a reference to the NumCacheLevels property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the NumCacheLevels property.
		* Returns:           
		* Date Added:        07/18/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [NumCacheLevels]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE numcacheroots_access		&& Access method used to retrieve the Chilkat MHT NumCacheRoots property.
		*==============================================================================
