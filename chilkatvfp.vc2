		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the WasRedirected property.
		* Returns:           
		* Date Added:        01/31/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE xmlrpc		&& Makes an XML RPC call to a URL endpoint. The XML string is passed in an HTTP POST, and the XML response is returned. Returns Nothing on failure.
		*==============================================================================
		* Method:            XMLRPC
		* Purpose:           Makes an XML RPC call to a URL endpoint.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURLEndpoint -- the URL to post to
		*                    tcXMLIn -- the XML string
		* Returns:           Character
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Makes an XML RPC call to a URL endpoint. 
		** The XML string is passed in an HTTP POST, and the XML response is returned.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURLEndpoint AS Character, tcXMLIn AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, lcXMLOut AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXMLOut = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXMLOut = m.loChilkatObject.XMLRPC(m.tcURLEndpoint, m.tcXMLIn)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXMLOut
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE xmlrpcasync		&& Creates an asynchronous task to call the XmlRpc method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            XMLRPCAsync
		* Purpose:           Creates an asynchronous task to call
		*                    the XmlRpc method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURLEndpoint -- the URL to post to
		*                    tcXMLIn -- the XML string
		* Returns:           Chilkat Task object or NULL
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the XmlRpc method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURLEndpoint AS Character, tcXMLIn AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.XMLRPCAsync(m.tcURLEndpoint, m.tcXMLIn)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

