	PROCEDURE loadtext		&& Convenience method to load the entire contents of a text file into a string. It is assumed that the text contains ANSI encoded character data. Returns Nothing on failure.
		*==============================================================================
		* Method:            LoadText
		* Purpose:           Convenience method to load the entire contents of a text file into a string..
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file to load.
		* Returns:           The text from the file.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Convenience method to load the entire contents of a text file into a string. 
		** It is assumed that the text contains ANSI encoded character data.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, lcText AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcText = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcText = m.loChilkatObject.LoadText(m.tcFilePath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcText
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE savetext		&& Convenience method to save a string to a text file. The text is saved using the ANSI character encoding. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SaveText
		* Purpose:           Convenience method to save a string to a text file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcText, the text to save.
		*                    tcFilePath, the file path to save the text.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Convenience method to save a string to a text file. 
		** The text is saved using the ANSI character encoding.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcText AS Character, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SaveText(m.tcText, m.tcFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setencodedhash		&& Provides a way to set the Hash property by passing an encoded string. The encoding can be "hex" or "base64". The encodedHash contains the encoded bytes of the hash that will be signed or verified via the SignHash and Verify methods.
		*==============================================================================
		* Method:            SetEncodedHash
		* Purpose:           Provides a way to set the Hash property by passing an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncoding, the encoding for the hash
		*                    tcEncodedHash, the encoded hash to save.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Provides a way to set the Hash property by passing an encoded string. 
		** The encoding can be "hex" or "base64". The encodedHash contains the encoded bytes 
		** of the hash that will be signed or verified via the SignHash and Verify methods.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEncoding AS Character, tcEncodedHash AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetEncodedHash(m.tcEncoding, m.tcEncodedHash) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setencodedsignature		&& Sets the bytes of the Signature property. (The signature must be specified prior to calling the Verify method.) This method allows for the signature to be set via a hex or base64 encoded string. The encoding should be set to either "hex" or "base64".
		*==============================================================================
		* Method:            SetEncodedSignature
		* Purpose:           Sets the bytes of the Signature property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncoding, the encoding for the hash
		*                    tcEncodedSignature, the encoded signature to save.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Sets the bytes of the Signature property. 
		** (The signature must be specified prior to calling the Verify method.) 
		** This method allows for the signature to be set via a hex or base64 encoded string. 
		** The encoding should be set to either "hex" or "base64".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEncoding AS Character, tcEncodedSignature AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetEncodedSignature(m.tcEncoding, ;
		      m.tcEncodedSignature) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
