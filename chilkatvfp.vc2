	PROCEDURE appendbase64		&& Creates a new Zip entry and initializes it with already-compressed data that is Base64 encoded. (The ZipEntry.CopyBase64 method can be used to retrieve the compressed data in Base64 format.)
		*==============================================================================
		* Method:            AppendBase64
		* Purpose:           Creates a new Zip entry and initializes it with 
		*                    already-compressed data that is Base64 encoded
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to append.
		*                    tcEncodedCompressionData -- the data to append to the file.
		* Returns:           toChilkatZipEntry, a Chilkat Zip Entry object.
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** Creates a new Zip entry and initializes it with already-compressed data that is Base64 encoded. 
		** (The ZipEntry.CopyBase64 method can be used to retrieve the compressed data in Base64 format.)
		**
		** Note 1: This method only updates the zip object. 
		** To update (rewrite) a zip file, either the WriteZip or WriteZipAndClose method 
		** would need to be called.
		**
		** Note 2: It is assumed that the compressed data is unencrypted deflated data. 
		** (Meaning data compressed using the "deflate" compression algorithm.)
		**
		** Update for Version 10: This method is now decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character, tcEncodedCompressionData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, ;
		loException AS Exception, loChilkatZipEntry AS CHILKAT_ZIPENTRY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatZipEntry
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatZipEntry = ;
		      m.loChilkatObject.AppendBase64(m.tcFileName, m.tcEncodedCompressionData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatZipEntry
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

