	PROCEDURE hasheadermatching		&& Returns 1 if the email has a header field with the specified fieldName with a value matching valuePattern. Case sensitivity is controlled by caseSensitive.
		*==============================================================================
		* Method:            HasHeaderMatching
		* Purpose:           Returns 1 if the email has a header field  
		*                    with the specified fieldName with a value matching valuePattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFieldName -- the field name to match against.
		*                    tcValuePattern -- the value pattern to match against.
		*                    tuCaseSensitive -- Set to 1 to make the search case sensitive.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Returns 1 if the email has a header field with the specified fieldName 
		** with a value matching valuePattern. 
		** Case sensitivity is controlled by caseSensitive. 
		** The valuePattern may include 0 or more asterisk (wildcard) characters 
		** which match 0 or more of any character.
		**
		
		LPARAMETERS tcFieldName AS Character, tcValuePattern AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, liMatches AS Integer, ;
		loException AS Exception, liCaseSensitive AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liMatches, m.liCaseSensitive
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    TRY
		
		      liMatches = ;
		      m.loChilkatObject.HasHeaderMatching(m.tcFieldName, m.tcValuePattern, m.liCaseSensitive)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liMatches
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

