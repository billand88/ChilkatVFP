	PROCEDURE loadtaskresult		&& Introduced in version 9.5.0.52. Loads the string collection from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadTaskResult
		* Purpose:           Loads the string collection from a completed asynchronous task.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTask, a Chilkat Task object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Loads the string collection from a completed asynchronous task.
		**
		** Fix for Version 58: This method always returned 0, regardless of success/failure.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatTask AS CHILKAT_TASK_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_STRINGARRAY_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer, llImplemented AS Logical, ;
		loParkParameterTask AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTask = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTask)
		
		      loChilkatTask = m.loParkParameterTask.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadTaskResult(m.loChilkatTask) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTask = ;
		      m.loParkParameterTask.SetObject(m.toChilkatTask, m.loChilkatTask)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  toChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loParkParameterTask = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE pop		&& Returns the last string and removes it from the internal collection. Returns Nothing on failure.
		*==============================================================================
		* Method:            Pop
		* Purpose:           Returns the last string and removes it from the internal collection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The last string in the collection.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Returns the last string and removes it from the internal collection.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_STRINGARRAY_COM_CALL, ;
