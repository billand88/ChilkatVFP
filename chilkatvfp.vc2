		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatZipEntry
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendzip		&& Adds the contents of another existing Zip file to this Zip object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendZIP
		* Purpose:           Adds the contents of another existing Zip file to this Zip object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcZIPFileName -- the ZIP file name.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Adds all entries from another existing ZIP archive into the current ZIP object.
		**
		** The zipPath argument specifies the path of a ZIP file located in the local filesystem.
		**
		** All entries from the specified ZIP archive are appended to the current in-memory ZIP object.
		**
		** The ZIP archive itself is not rewritten until a Write* method is called.
		**
		** This method is useful for merging the contents of multiple ZIP archives into a single ZIP.
		**
		** Returns 1 for success, 0 for failure.
		**
		** Fixed in version 11.5.0: Fixed the AppendZip method.
		**
		
		LPARAMETERS tcZIPFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendZIP(m.tcZIPFileName) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE autorunparams_access		&& Access method used to retrieve the Chilkat ZIP AutoRunParams property.
		*==============================================================================
		* Method:            AutoRunParams_Access
		* Purpose:           Command line parameters that get passed to the AutoRun executable.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoRunParams
		* Date Added:        04/28/2022
		*==============================================================================
		
		**
		** (Relevant only when running on a Microsoft Windows operating system.) 
		** Command line parameters that get passed to the AutoRun executable.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autorunparams_assign		&& Assign method used to hold a reference to the AutoRunParams property.
		*==============================================================================
		* Method:            AutoRunParams_Assign
		* Purpose:           Assign method used to hold a reference to the AutoRunParams property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold 
		*                    a reference to the AutoRunParams property.
		* Returns:           
		* Date Added:        04/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

