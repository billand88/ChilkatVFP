	ENDPROC

	PROCEDURE rawcommandbdasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the RawCommandBd method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*==============================================================================
		* Method:            RawCommandBdAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the RawCommandBd method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinDataCommand -- a Chilkat Binary Data object.
		*                    toChilkatBinDataPassword -- a Chilkat Binary Data object.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Creates an asynchronous task to call the RawCommandBd method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatBinDataCommand AS CHILKAT_BINDATA_COM_CALL, ;
		toChilkatBinDataResponse AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinDataCommand AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataCommand AS CHILKAT_BINDATA_COM_CALL, ;
		loParkParameterBinDataResponse AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataResponse AS CHILKAT_BINDATA_COM_CALL, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterBinDataCommand, m.loChilkatBinDataCommand, ;
		m.loParkParameterBinDataResponse, m.loChilkatBinDataResponse
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinDataCommand = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataCommand)
		
		      loParkParameterBinDataResponse = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataResponse)
		
		      loChilkatBinDataCommand = m.loParkParameterBinDataCommand.GetObject()
		      loChilkatBinDataResponse = m.loParkParameterBinDataResponse.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.RawCommandBdAsync(;
		        m.loChilkatBinDataCommand, m.loChilkatBinDataResponse)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinDataCommand = m.loParkParameterBinDataCommand.SetObject(;
		      m.toChilkatBinDataCommand, m.loChilkatBinDataCommand)
		
		      toChilkatBinDataResponse = m.loParkParameterBinDataResponse.SetObject(;
		      m.toChilkatBinDataResponse, m.loChilkatBinDataResponse)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataCommand, m.loChilkatBinDataCommand, ;
		m.loParkParameterBinDataResponse, m.loChilkatBinDataResponse
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
