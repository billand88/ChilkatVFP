	PROCEDURE loadbodyfrombd		&& Introduced in version 9.5.0.67. Uses the contents of the requestBody as the HTTP request body. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadBodyFromBd
		* Purpose:           Uses the contents of the requestBody as the HTTP request body.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData -- a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		** 
		** Uses the contents of the requestBody as the HTTP request body.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadBodyFromBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadbodyfrombytes		&& The HTTP protocol is such that all HTTP requests are MIME. For non-multipart requests, this method may be called to set the MIME body of the HTTP request to the exact contents of the byteData.
		*==============================================================================
		* Method:            LoadBodyFromBytes
		* Purpose:           Set the MIME body of the HTTP request to the exact contents of the byteData.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the binary byte data
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** The HTTP protocol is such that all HTTP requests are MIME. 
		** For non-multipart requests, this method may be called to set 
		** the MIME body of the HTTP request to the exact contents of the byteData.
		** Note: A non-multipart HTTP request consists of (1) the HTTP start line, 
		** (2) MIME header fields, and (3) the MIME body. This method sets the MIME body.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadBodyFromBytes(m.tqData) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadbodyfromfile		&& The HTTP protocol is such that all HTTP requests are MIME. For non-multipart requests, this method may be called to set the MIME body of the HTTP request to the exact contents of filePath.
		*==============================================================================
		* Method:            LoadBodyFromFile
		* Purpose:           Set the MIME body of the HTTP request to the exact contents of the filePath.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath -- the full path to the file
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** The HTTP protocol is such that all HTTP requests are MIME. 
		** For non-multipart requests, this method may be called 
		** to set the MIME body of the HTTP request to the exact contents of filePath.
		** Note: A non-multipart HTTP request consists of (1) the HTTP start line, 
		** (2) MIME header fields, and (3) the MIME body. This method sets the MIME body.
