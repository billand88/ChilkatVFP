	PROCEDURE addcacheroot		&& This method must be called at least once if disk caching is to be used. The file path (including drive letter) such as "E:\MyHttpCache\" is passed to AddCacheRoot to specify the root directory.
		*==============================================================================
		* Method:            AddCacheRoot
		* Purpose:           This method must be called at least once if disk caching is to be used. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectory, the cache root directory.
		* Returns:           
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** This method must be called at least once if disk caching is to be used. 
		** The file path (including drive letter) such as "E:\MyHttpCache\" 
		** is passed to AddCacheRoot to specify the root directory. 
		** The cache can be spread across multiple disk drives by calling AddCacheRoot multiple times, 
		** each with a directory path on a separate disk drive.
		**
		** Fixed for version 70: Fixed problem with using the caching feature. 
		** If the http.AllowGzip property was set to true, and a Gzip response was cached, 
		** then a subsequent cache-hit would not return the ungzipped response 
		** (as would a normal non-cache-hit response).
		**
		
		LPARAMETERS tcDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddCacheRoot(m.tcDirectory)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE allowgzip_access		&& Access method used to retrieve the Chilkat HTTP AllowGZip property.
		*==============================================================================
		* Method:            AllowGZip_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP AllowGZip property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AllowGZip
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** Controls whether the "Accept-Encoding: gzip" header is added 
		** to HTTP requests sent via any method that sends an HTTP request 
		** without using the HttpRequest object (such as QuickGetStr). 
		** If 0, then the empty Accept-Encoding header is added 
		** which means the server response should contain the uncompressed content. 
		** The default value is 1, which means the server, if it chooses, may send a gzipped response.
		**
		** Fixed for version 70:  Fixed problem with using the caching feature 
		** (FetchFromCache, UpdateCache, AddCacheRoot, NumCacheLevels, etc.). 
		** If the this property was set to true, and a Gzip response was cached, 
		** then a subsequent cache-hit would not return the ungzipped response 
		** (as would a normal non-cache-hit response).
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE allowgzip_assign		&& Assign method used to hold a reference to the AllowGZip property.
