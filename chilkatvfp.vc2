		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE reconnect		&& Introduced in version 9.50.87. Reestablishes a connection to a reader that was previously connected to using Connect(). In a multi application environment it is possible for an application to reset the card in shared mode.
		*==============================================================================
		* Method:            Reconnect
		* Purpose:           Reestablishes a connection to a reader 
		*                    that was previously connected to using Connect().
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcShareMode, the share mode setting.
		*                    tcPreferredProtocol, the preferred protocol.
		*                    tcAction, the desired action on the card reader. 
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.50.87
		**
		** Reestablishes a connection to a reader that was previously connected to using Connect().
		** 
		** In a multi application environment it is possible 
		** for an application to reset the card in shared mode. 
		** When this occurs any other application trying to access certain commands 
		** will be returned the value SCARD_W_RESET_CARD. When this occurs Reconnect() 
		** must be called in order to acknowledge that the card was reset 
		** and allow it to change its state accordingly.
		**
		** The shareMode can be "shared", "exclusive", or "direct". 
		** The preferredProtocol can be "0" (valid only if the shareMode = "direct"), 
		** "T0", "T1", "raw", or "no_preference". (No preference is effectively T0 or T1.) 
		** The action is the desired action taken on the card/reader. 
		** It can be "leave", "reset", "unpower", or "eject".
		** 
		** If successful, the state of this object instance is that it's connected to the reader.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcShareMode AS Character, ;
		tcPreferredProtocol AS Character, tcAction AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.Reconnect(m.tcShareMode, ;
		        m.tcPreferredProtocol, m.tcAction) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE releasecontext		&& Introduced in version 9.50.87. Destroys a communication context to the PC/SC Resource Manager. This must be the last function called in a PC/SC application. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ReleaseContext
		* Purpose:           Destroys a communication context to the PC/SC Resource Manager.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.50.87
		**
		** Destroys a communication context to the PC/SC Resource Manager. 
		** This must be the last function called in a PC/SC application.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.ReleaseContext() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE scarderror_access		&& Access method used to retrieve the Chilkat SCard SCardError property.
		*==============================================================================
		* Method:            SCardError_Access
		* Purpose:           Access method used to retrieve 
		*                    the SCardError property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
