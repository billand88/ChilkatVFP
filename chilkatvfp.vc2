	PROCEDURE compressstringenc		&& The same as CompressString, except the binary output is returned in encoded string form according to the encoding. Returns Nothing on failure
		*==============================================================================
		* Method:            CompressStringEnc
		* Purpose:           The same as CompressString, except the binary output 
		*                    is returned in encoded string form
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string name to compress
		*                    tcCharset -- the string charset
		*                    tcEncoding -- the encoding of the returned string
		* Returns:           Character
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** The same as CompressString, except the binary output is returned 
		** in encoded string form according to the encoding. 
		** The encoding can be any of the following: "Base64", "modBase64", "Base32", 
		** "UU", "QP" (for quoted-printable), "URL" (for url-encoding), "Hex", "Q", 
		** "B", "url_oath", "url_rfc1738", "url_rfc2396", and "url_rfc3986".
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcString AS Character, tcCharset AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, lcEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedString = ;
		      m.loChilkatObject.CompressStringEnc(m.tcString, m.tcCharset, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE compressstringtofile		&& Gzip compresses a string and writes the output to a .gz compressed file. The string is first converted to the charset specified by destCharset. Typical charsets are "utf-8", "iso-8859-1", "shift_JIS", etc. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CompressStringToFile
		* Purpose:           Gzip compresses a string and writes the output to a .gz compressed file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string name to compress
		*                    tcDestinationCharset -- the destination charset
		*                    tcDestinationPath -- the destination path of the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Gzip compresses a string and writes the output to a .gz compressed file. 
		** The string is first converted to the charset specified by destCharset. 
		** Typical charsets are "utf-8", "iso-8859-1", "shift_JIS", etc.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcString AS Character, ;
		tcDestinationCharset AS Character, tcDestinationPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CompressStringToFile(m.tcString, ;
