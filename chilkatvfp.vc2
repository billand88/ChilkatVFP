	PROCEDURE sendq		&& Undocumented function! Queues an email to be sent using the Chilkat SMTP queue service. This is the same as SendEmail, except the email is written to the SMTPQ's queue directory.
		*==============================================================================
		* Method:            SendQ
		* Purpose:           Undocumented method! 
		*                    Queues an email to be sent using the Chilkat SMTP queue service.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		* Returns:           Chilkat Email Object, or NULL
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Undocumented method!
		**
		** Queues an email to be sent using the Chilkat SMTP queue service. This is the
		** same as SendEmail, except the email is written to the SMTPQ's queue directory.
		** 
		** The email is written as a .eml to the SMTPQ's queue directory. The SMTP server
		** hostname, login, password, and send-time parameters are saved as encrypted
		** headers in the .eml. The SMTPQ service watches the queue directory. When a .eml
		** file appears, it loads the .eml, extracts and removes the encrypted information
		** from the header, and sends the email.
		**  
		** Note: When the Chilkat SMTPQ service is configured, the location of the queue
		** directory is written to the registry. Because Chilkat SMTPQ is a 32-bit service,
		** it is the 32-bit registry that is written. (Microsoft 64-bit systems have two
		** separate registries -- one for 32-bit and one for 64-bit.) Therefore, if your
		** application is a 64-bit app, the registry lookup for the queue directory will
		** fail. You should instead call the SendQ2 method which allows for the queue
		** directory to be explicitly specified.
		**  
		** Note: After calling this method, the filename of the .eml that was created will
		** be available in the LastSendQFilename property.
		**  
		** Important: The SMTPQ functionality is decremented and will be removed in a future
		** version. The SMTPQ Windows Service Visual Studio project is available on GitHub
		** at the link below. Users would need to build the project prior to using. Chilkat
		** does not provide pre-built binaries for the SMTPQ Windows Service.
		**
		** Fixed for Version 56: The Windows-only SMTPQ related methods were fixed. 
		** The SMTPQ methods were working correctly in v9.5.0.54 and earlier, 
		** but a problem was inadvertently introduced in v9.5.0.55.
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.SendQ(m.loChilkatEmail) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendq2		&& Undocumented method! Same as SendQ, but the queue directory can be explicitly specified in a method argument.
		*==============================================================================
		* Method:            SendQ2
		* Purpose:           Undocumented method! Same as SendQ, but the queue directory 
		*                    can be explicitly specified in a method argument.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		*                    tcQueueDirectory, the queue directory.
		* Returns:           Chilkat Email Object, or NULL
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Undocumented method!
		**
		** Same as SendQ, but the queue directory can be explicitly specified in a method
		** argument.
		**   
		** Beginning with version 9.5.0.47, the queueDir can indicate the exact output filepath
		** to be written. If queueDir specifies only the directory, then SendQ2 will
		** automatically generate the output filename.
		**   
		** Important: The SMTPQ functionality is decremented and will be removed in a future
		** version. The SMTPQ Windows Service Visual Studo project is available on GitHub
		** at the link below. Users would need to build the project prior to using. Chilkat
		** does not provide pre-built binaries for the SMTPQ Windows Service.
		**
		** Enhancement for Version 47: This method will now accept a full output file path 
		** (meaning path + filename). If only an output directory is indicated, 
		** then Chilkat will generate the output filename.
		**
		** Fixed for Version 56: The Windows-only SMTPQ related methods were fixed. 
		** The SMTPQ methods were working correctly in v9.5.0.54 and earlier, 
		** but a problem was inadvertently introduced in v9.5.0.55.
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		tcQueueDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.SendQ2(m.loChilkatEmail, m.tcQueueDirectory) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setcsp		&& Undocumented method! This is not commonly used because the default Microsoft CSP is typically appropriate. One instance where SetCSP is necessary is when using the Crypto-Pro CSP for the GOST R 34.10-2001 and GOST R 34.10-94 providers.
		*==============================================================================
		* Method:            SetCSP
		* Purpose:           Decremented function! Accepts a (decremented) Chilkat CSP reference.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCSP, a Chilkat CSP object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Decremented function! Accepts a (decremented) Chilkat CSP reference.
		** 
		** (Only applies to the Microsoft Windows OS) Sets the Cryptographic Service
		** Provider (CSP) to be used for encryption or digital signing, 
		** or decryption / signature verification.
		**  
		** This is not commonly used becaues the default Microsoft CSP is typically
		** appropriate. One instance where SetCSP is necessary is when using the Crypto-Pro
		** CSP for the GOST R 34.10-2001 and GOST R 34.10-94 providers.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCSP AS [Chilkat_9_5_0.Csp]
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Csp], ;
		loParkParameterCsp AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCsp AS [Chilkat_9_5_0.Csp], loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.llImplemented
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCsp = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCsp)
		
		      loChilkatCsp = m.loParkParameterCsp.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetCSP(m.loChilkatCSP) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCsp = ;
		      m.loParkParameterCsp.SetObject(m.toChilkatCsp, m.loChilkatCsp)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatCSP = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loParkParameterCsp = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCsp = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setdecryptcert		&& Explicitly specifies the certificate to be used for decrypting encrypted email. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetDecryptCert
		* Purpose:           Explicitly specifies the certificate 
		*                    to be used for decrypting encrypted email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		** 
		** Enhancement for Version 58: 
		** Added support for the SHA512 server key exchange hash algorithm.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Explicitly specifies the certificate to be used for decrypting encrypted email.
		**
		** Enhancement to Version 83: Improved support for ECDSA certs.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert 
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetDecryptCert(m.loChilkatCert) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		       m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setdecryptcert2		&& Explicitly specifies the certificate and associated private key to be used for decrypting S/MIME encrypted email.
		*==============================================================================
		* Method:            SetDecryptCert2
		* Purpose:           Explicitly specifies the certificate 
		*                    to be used for decrypting encrypted email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChikatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Explicitly specifies the certificate and associated private key to be used 
		** for decrypting S/MIME encrypted email.
		**
		** Note: In most cases, it is easier to call AddPfxSourceFile or AddPfxSourceData 
		** to provide the required cert and private key. 
		** On Windows systems where the certificate + private key has already been installed 
		** in the default certificate store, nothing needs to be done -- the mailman will 
		** automatically locate and use the required cert + private key.
		** 
		** Fixed for Version 59: When a cert doesn’t have the Issuer CN, 
		** the encrypted message could not be decrypted using Chilkat library, 
		** even though the cert does have subject key id.
		** 
		** Enhancement for Version 58: 
		** Added support for the SHA512 server key exchange hash algorithm.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Fixed for Version 89: Fixed a problem with decrypting messages that 
		** used AES-GCM with a certificate having a non-exportable private key.
		**
		** Enhancement to Version 83: Improved support for ECDSA certs.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		toChikatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetDecryptCert2(m.loChilkatCert, loChikatPrivateKey) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setpassword		&& Provides a more secure way of setting either the POP3 or SMTP password.
		*==============================================================================
		* Method:            SetPassword
		* Purpose:           Provides a more secure way of setting either the POP3 or SMTP password.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcProtocol -- the email protocol.
		*                    toChilkatSecureString, a Chilkat Secure String object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Provides a more secure way of setting either the POP3 or SMTP password. 
		** The protocol can be "pop3" or "smtp". 
		** When the protocol is "pop3", this is equivalent to setting the PopPassword property. 
		** When protocol is "smtp", this is equivalent to setting the SmtpPassword property.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcProtocol AS Character, toChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical, lcSecondParameter AS Character, ;
		loParkParameterSecureString AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL, ;
		lcErrorMessage AS Character
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE [] TO m.lcSecondParameter, m.lcErrorMessage 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    ** Bad string value test
		    IF VARTYPE(lcProtocol) == T_CHARACTER ;
		    AND (NOT (INLIST(UPPER(lcProtocol), [POP3], [SMTP])))
		
		      lcSecondParameter = lcMethod + [~] + lcPEMType
		
		      lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ELSE
		
		      loChilkatObject = .oChilkat
		
		      ** Have a good object test
		      IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		      AND (NOT ISNULL(m.loChilkatObject))
		
		        loParkParameterSecureString = ;
		        NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureString)
		
		        loChilkatSecureString = m.loParkParameterSecureString.GetObject()
		
		        TRY
		
		          STORE m.loChilkatObject.SetPassword(m.tcProtocol, m.loChilkatSecureString) ;
		          TO m.liReturn, m.luReturn
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		        toChilkatSecureString = m.loParkParameterSecureString.SetObject(;
		        m.toChilkatSecureString, m.loChilkatSecureString)
		
		      ELSE
		
		        .MissingObjectError(THIS)
		
		      ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		      AND (NOT ISNULL(m.loChilkatObject))
		      ** End have a good object test
		
		    ENDIF VARTYPE(lcProtocol) == T_CHARACTER ;
		    AND (NOT (INLIST(UPPER(lcProtocol), [POP3], [SMTP])))
		    ** End bad string value test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loParkParameterSecureString = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsslclientcert		&& Sets the client-side certificate to be used with SSL connections. This is typically not required, as most SSL connections are such that only the server is authenticated while the client remains unauthenticated. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetSSLClientCert
		* Purpose:           Sets the client-side certificate to be used with SSL connections.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Sets the client-side certificate to be used with SSL connections. 
		** This is typically not required, as most SSL connections 
		** are such that only the server is authenticated while the client remains unauthenticated.
		** 
		** Enhancement for Version 58: 
		** Added support for the SHA512 server key exchange hash algorithm.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Enhancement to Version 83: Improved support for ECDSA certs.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], liReturn AS Integer, ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		     NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		     loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetSSLClientCert(m.loChilkatCert) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsslclientcertpem		&& Allows for a client-side certificate to be used for the SSL / TLS connection. Returns 1 for success, 0 for failure.
		*==============================================================================
