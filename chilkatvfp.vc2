	PROCEDURE openchilkatstore		&& (This method only available on Microsoft Windows operating systems.) Opens the registry-based local machine certificate store having the path "Software/Chilkat/SystemCertificates". If the certificate store does not exist, it is automatically created.
		*==============================================================================
		* Method:            OpenChilkatStore
		* Purpose:           Loads the certificates contained within an in-memory PEM formatted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuReadOnly, whether or not to open the certificate store read only.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** (This method only available on Microsoft Windows operating systems.)
		**
		** Opens the registry-based local machine certificate store having 
		** the path "Software/Chilkat/SystemCertificates". 
		** If the certificate store does not exist, it is automatically created. 
		** Setting readOnly = 1 causes the certificate store to be opened read-only, 
		** and will prevent "permission denied" errors caused by the need for read-write permission.
		** 
		** Once loaded, the certificates within the store may be searched via the Find* methods. 
		** An application may also iterate from 0 to NumCertficates-1 
		** and call GetCertificate to access each certificate by index.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuReadOnly AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liReadOnly AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liReadOnly
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liReadOnly = .LogicalToBit(m.tuReadOnly)
		
		    TRY
		
		      STORE m.loChilkatObject.OpenChilkatStore(m.liReadOnly) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

