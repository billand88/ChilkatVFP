		RETURN
	ENDPROC

	HIDDEN PROCEDURE preferipv6_access		&& Access method used to retrieve the Chilkat IMAP PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PreferIPV6
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** If 1, then use IPv6 over IPv4 when both are supported for a particular domain. 
		** The default value of this property is 0, which will choose IPv4 over IPv6.
		**
		** Enhancement for version 70: Added internal re-try functionality 
		** to cope with various situations for IPv4-only and IPv6-only networks.
		**
		** (Note: Chilkat was updated in v9.5.0.97 to enable "dual-stack" support, 
		** where a server can handle both IPv6 and IPv4 traffic using a single socket. 
		** Prior to v9.5.0.97, setting this property to 1 
		** had the effect that only IPv6 connections could be accepted.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Assign
		* Purpose:           Assign method used to hold a reference to the PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PreferIPV6 property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE querymbx		&& Introduced in version 11.0.0. Searches the selected mailbox for messages matching criteria and returns a message set of all matches. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            QueryMbx
		* Purpose:           Searches the selected mailbox for messages matching criteria 
		*                    and returns a message set of all matches.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCriteria -- the query criteria.
		*                    tuReturnUIDs -- whether or not to return the UIDs.
		*                    toChilkatMessageSet -- a Chilkat Messageset object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Searches the selected mailbox for messages matching criteria 
		** and returns a message set of all matches. If bUid is 1, UIDs are returned; 
		** otherwise, sequence numbers are returned.
		**
		** See the information at the link below which explains the IMAP search criteria
		**
		** The criteria can be set to a special value new-email to check for new messages. 
		** When the criteria equals "new-email", this method detects new emails received 
		** since the mailbox was last selected or since the previous QueryMbx call, 
		** whichever is more recent. It operates by closing and reopening the current mailbox 
		** and issuing a SEARCH command for recent emails 
		** or those with a UID greater than the UIDNEXT value. It then returns 
		** a message set object containing the UIDs of the new emails, 
		** which can be used with methods like FetchMsgSet to download them.
		** 
		** If the SortCriteria property is non-empty, 
		** then this method sends a SORT command instead of a SEARCH command. 
		** It can be used to request search results in a specific order. 
		** However only IMAP servers that include SORT in the CAPABILITY list have this feature.
		** 
		** Note: The SearchCharset property applies to IMAP searches.
		**
		** Fixed for Version 11.6.0: With the special new-email criterion — 
		** a caller-supplied MessageSet is now cleared when no new messages are found, 
		** instead of retaining prior state.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCriteria AS Character, ;
		tcMbxPattern AS Character, toChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterMessageSet AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterMessageSet = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		      loChilkatMessageSet = m.loParkParameterMessageSet.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.QueryMbx(m.tcCriteria, ;
		        m.tcMbxPattern, m.loChilkatMessageSet) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatMessageSet = m.loParkParameterMessageSet.SetObject(;
		      m.toChilkatMessageSet, m.loChilkatMessageSet)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMessageSet  = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loParkParameterMessageSet = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE querymbxasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the QueryMbx method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*==============================================================================
		* Method:            QueryMbxAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    QueryMbx method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCriteria -- the query criteria.
		*                    tuReturnUIDs -- whether or not to return the UIDs.
		*                    toChilkatMessageSet -- a Chilkat Messageset object.
		* Returns:           Chilkat Task Object, or NULL
