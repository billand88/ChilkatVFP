	PROCEDURE sethttpobj		&& Introduced in version 9.5.0.85. Sets the HTTP object to be used to communicate with the timestamp authority (TSA) server for cases where long term validation (LTV) of signatures is desired.
		*==============================================================================
		* Method:            SetHTTPObj
		* Purpose:           Sets the HTTP object to be used to communicate with the timestamp 
		*                    authority server for cases where long term validation 
		*                    of signatures is desired.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatHTTP -- a Chilkat HTTP object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.85
		**
		** Sets the HTTP object to be used to communicate with the timestamp authority (TSA) 
		** server for cases where long term validation (LTV) of signatures is desired. 
		** The http is used to send the requests, and it allows for connection related settings 
		** and timeouts to be set. For example, if HTTP or SOCKS proxies are required, 
		** these features can be specified on the http.
		** 
		** The http is also used to send OCSP requests to store OCSP responses 
		** in the PDF's document security store (DSS).
		** 
		** Enhancement in Version 94: Chilkat improved OCSP requests 
		** (used in various parts of the Chilkat API) to satisfy some servers 
		** that are more picky about certain parts of the OCSP protocol which should be optional.
		**
		** Fixed in version 95: Fixed OCSP requests for ECDSA certificates. 
		** This problem also caused PDF signatures using ECDSA cerificates to not be LTV-enabled.
		** 
		** Fixed for Version 10: Fixed a problem having to do 
		** with sending OCSP requests for ECDSA based certificates.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatHTTP AS CHILKAT_HTTP_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterHttp AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatHttp AS CHILKAT_HTTP_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHttp, m.loChilkatHttp
		
		llImplemented = .F.
		liIntroducedInBuild = 85
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterHttp = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHttp)
		
		      loChilkatHttp = m.loParkParameterHttp.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetHTTPObj(m.loChilkatHTTP) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatHttp = ;
		       m.loParkParameterHttp.SetObject(m.toChilkatHttp, m.loChilkatHttp)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHttp, m.loChilkatHttp
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatHTTP = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loParkParameterHttp = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatHttp = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

