	PROCEDURE sort		&& Introduced in version 9.5.0.76. Searches the already selected mailbox for messages that match searchCriteria and returns a message set of all matching messages in the order specified by sortCriteria
		*==============================================================================
		* Method:            Sort
		* Purpose:           Searches the already selected mailbox for messages that match 
		*                    searchCriteria and returns a message set of all matching messages.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSortCriteria -- the sort criteria.
		*                    tcCharset -- the charset of the search
		*                    tcSearchCriteria -- the quota amount.
		*                    tuUID -- whether or not the message ID is a UID.
		* Returns:           A Chilkat Message Set object, or NULL.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Searches the already selected mailbox for messages that match searchCriteria 
		** and returns a message set of all matching messages in the order specified by sortCriteria. 
		** If bUid is 1, then UIDs are returned in the message set, otherwise sequence numbers are returned.
		**
		** The sortCriteria is a string of SPACE separated keywords to indicate sort order 
		** (default is ascending). The keyword "REVERSE" can precede a keyword 
		** to reverse the sort order (i.e. make it descending). Possible sort keywords are:
		** 
		** ARRIVAL
		** CC
		** DATE
		** FROM
		** SIZE
		** SUBJECT
		** TO
		** 
		** Some examples of sortCriteria are:
		** 
		** "SUBJECT REVERSE DATE"
		** "REVERSE SIZE"
		** "ARRIVAL"
		** 
		** The searchCriteria is passed through to the low-level IMAP protocol unmodified, 
		** and therefore the rules for the IMAP SEARCH command (RFC 3501) apply. 
		** See the documentation for the Search method for more details (and also see RFC 3501).
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcSortCriteria AS Character, tcCharset AS Character, ;
		tcSearchCriteria AS Character, tuUID AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, loChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL
		
		STORE 0 TO m.liUID, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatMessageSet
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUID = .LogicalToBit(m.tuUID)
		
		      TRY
		
		        loChilkatMessageSet = m.loChilkatObject.Sort(;
		        m.tcSortCriteria, m.tcCharset, m.tcSearchCriteria, m.liUID)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatMessageSet
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE sortasync		&& Introduced in version 9.5.0.76. Creates an asynchronous task to call the Sort method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            SortAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    Sort method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSortCriteria -- the sort criteria.
		*                    tcCharset -- the charset of the search
		*                    tcSearchCriteria -- the quota amount.
		*                    tuUID -- whether or not the message ID is a UID.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the Sort method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcSortCriteria AS Character, tcCharset AS Character, ;
		tcSearchCriteria AS Character, tuUID AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liUID AS Integer
		
		STORE 0 TO m.liUID, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUID = .LogicalToBit(m.tuUID)
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.SortAsync(;
		        m.tcSortCriteria, m.tcCharset, m.tcSearchCriteria, m.liUID)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		  
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	HIDDEN PROCEDURE sortcriteria_access		&& Access method used to retrieve the Chilkat IMAP SortCriteria property.
		*==============================================================================
		* Method:            SortCriteria_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP SortCriteria property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SortCriteria
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** This applies to the QueryMbx method to set a sort order for search results. 
		** By default, this property is an empty string.
		** 
		** Can be set to a string of SPACE separated keywords to indicate sort order 
		** (default is ascending). The keyword REVERSE can precede a keyword to reverse the sort order 
		** (i.e. make it descending). Possible sort keywords are:
		** 
		** ARRIVAL
		** CC
		** DATE
		** FROM
		** SIZE
		** SUBJECT
		** TO
		** 
		** Examples:
		** 
		** SUBJECT REVERSE DATE
		** REVERSE SIZE
		** ARRIVAL
		** Note: Not all IMAP servers support SORT.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
		
	ENDPROC

	HIDDEN PROCEDURE sortcriteria_assign		&& Assign method used to hold a reference to the SortCriteria property.
		*==============================================================================
		* Method:            SortCriteria_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat IMAP SortCriteria property.
