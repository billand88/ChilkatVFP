	HIDDEN PROCEDURE readfailreason_access		&& Access method used to retrieve the Chilkat Stream ReadFailReason property.
		*==============================================================================
		* Method:            ReadFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the ReadFailReason property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReadFailReason
		* Date Added:        06/13/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.56
		**
		** This property is automatically set when a Read* method is called. 
		** It indicates the reason for failure. Possible values are:
		** 
		** 0) No failure (success)
		** 1) Timeout, or no data is immediately available for a polling read.
		** 2) Aborted by an application callback.
		** 3) Already at end-of-stream.
		** 4) Fatal stream error.
		** 5) Out-of-memory error (this is very unlikely).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE readfailreason_assign		&& Assign method used to hold a reference to the ReadFailReason property.
		*==============================================================================
		* Method:            ReadFailReason_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the ReadFailReason property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ReadFailReason property.
		* Returns:           
		* Date Added:        06/13/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

