	PROCEDURE addrelatedfile2		&& Adds a related item to the email from a file. Related items are things such as images and style sheets that are embedded within an HTML email. They are not considered attachments because their sole purpose is to participate in the display of the HTML.
		*==============================================================================
		* Method:            AddRelatedFile2
		* Purpose:           Adds a related item to the email from a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileNameOnDisk -- path in the local filesystem of the added file.
		*                    tcFileNameInHTML -- filename used in the HTML img tag's src attribute
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds a related item to the email from a file. 
		** Related items are things such as images and style sheets 
		** that are embedded within an HTML email. 
		** They are not considered attachments because their sole purpose 
		** is to participate in the display of the HTML. 
		** This method differs from AddRelatedFile in that it does not use or return a Content-ID. 
		** The filenameInHtml argument should be set to the filename 
		** used in the HTML img tag's src attribute (if it's an image), 
		** or the URL referenced in an HTML link tag for a stylesheet. 
		** The filenameOnDisk is the path in the local filesystem of the file to be added.
		**
		** Note: Outlook.com will not properly display embedded HTMl images 
		** when the filenameInHtml includes a path part. 
		** Apparently, Outlook.com is only capable of correctly displaying images 
		** when the filenameInHtml is a only a filename. 
		** Other email clients, such as Mozilla Thunderbird, ;
		** have no trouble when the filenameInHtml includes a path part.
		**
		** Fixed for Version 46: Minor fix to suppress the unintentional creation 
		** of an empty plain-text body in the MIME in some circumstances 
		** (which is usually harmless).
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFileNameOnDisk AS Character, tcFileNameInHTML AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddRelatedFile2(m.tcFileNameOnDisk, m.tcFileNameInHTML) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

