	PROCEDURE changeremotedir		&& Changes the current remote directory. The remoteDirPath should be relative to the current remote directory, which is initially the HOME directory of the FTP user account.
		*==============================================================================
		* Method:            ChangeRemoteDir
		* Purpose:           Changes the current remote directory. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteDirectory, the remote directory to change.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Changes the current remote directory. 
		** The remoteDirPath should be relative to the current remote directory, 
		** which is initially the HOME directory of the FTP user account.
		**
		** If the remoteDirPath contains non-English characters, 
		** it may be necessary to set the DirListingCharset property equal to "utf-8". 
		** Please refer to the documentation for the DirListingCharset property.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcRemoteDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ChangeRemoteDir(m.tcRemoteDirectory) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE changeremotedirasync		&& Creates an asynchronous task to call the ChangeRemoteDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            ChangeRemoteDirAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    ChangeRemoteDir method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteDirectory, the remote directory to change.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the ChangeRemoteDir method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemoteDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.ChangeRemoteDirAsync(m.tcRemoteDirectory)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE checkconnection		&& Introduced in version 9.5.0.44. Returns 1 if currently connected and logged into an FTP server, otherwise returns 0. Note: This may cause a NOOP command to be sent to the FTP server. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CheckConnection
		* Purpose:           Returns 1 if currently connected 
		*                    and logged into an FTP server, otherwise returns 0.
		* Author:            Bill Anderson
