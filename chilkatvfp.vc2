	PROCEDURE appendfilesex		&& Appends one or more files to the Zip object. The filePattern can use the "*" to mean 0 or more of any character. The recurse controls whether directories are recursively traversed.
		*==============================================================================
		* Method:            AppendFilesEx
		* Purpose:           Appends one or more files to the Zip object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePattern -- the file pattern filter.
		*                    tuRecursive -- whether or not to recurse subdirectories.
		*                    tuSaveExtraPath -- whether or not to save full path.
		*                    tuArchiveOnly -- whether or not to save archive files only
		*                    tuIncludeHiddenFiles -- whether or not to include
		*                    hidden files to the Zip.
		*                    tuIncludeSystemFiles -- whether or not to include
		*                    system files to the Zip.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** Appends one or more files to the Zip object. ;
		** The filePattern can use the "*" to mean 0 or more of any character. 
		** The recurse controls whether directories are recursively traversed. 
		** Set recurse equal to 1 to append files and subdirectories in the directory tree. 
		** Set recurse equal to 0 to add files only from the indicated directory.
		** 
		** The saveExtraPath only applies when the filePattern is an absolute path pattern, 
		** such as "C:/temp/abc/*.txt". If saveExtraPath is 1, 
		** then the absolute path will be included in the zip entry filenames 
		** as relative paths. For example, "temp/abc/xyz.txt".
		**
		** The archiveOnly, includeHidden, and includeSystem flags only apply 
		** when on the Windows operating system. If archiveOnly is 1, 
		** then only files that have the archive bit set will be included in the zip. 
		** If includeHidden is 0, then hidden files are not included. 
		** If includeSystem is 0, then files having the System attribute are not included.
		**
		** Note: This method does not write the zip archive. 
		** It simply adds references to the files that will be included in the .zip 
		** when the WriteZip or WriteZipAndClose methods are eventually called. 
		** Files and/or data may be added to the zip object by calling 
		** any combination of the Append* methods before finally writing 
		** the zip via one of the Write* methods.
		**
		** Fixed for Version 48: This method w/ ArchiveOnly=true omitted directory entries, 
		** which was unnoticed when the directory contained files 
		** because the files still get added and unzip software automatically re-creates directories 
		** when unzipping as needed. However, this is noticed for empty directories 
		** because the empty directory entries were not added to the .zip.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePattern AS Character, tuRecursive AS Unknown, ;
		tuSaveExtraPath AS Unknown, tuArchiveOnly AS Unknown, ;
		tuIncludeHiddenFiles AS Unknown, tuIncludeSystemFiles AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liRecursive AS Integer, ;
		liSaveExtraPath AS Integer, liArchiveOnly AS Integer, ;
		liIncludeHiddenFiles AS Integer, liIncludeSystemFiles AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liRecursive, m.liSaveExtraPath, ;
		m.liArchiveOnly, m.liIncludeHiddenFiles, m.liIncludeSystemFiles  
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liRecursive = .LogicalToBit(m.tuRecursive)
		    liSaveExtraPath = .LogicalToBit(m.tuSaveExtraPath)
		    liArchiveOnly = .LogicalToBit(m.tuArchiveOnly)
		    liIncludeHiddenFiles = .LogicalToBit(m.tuIncludeHiddenFiles)
		    liIncludeSystemFiles = .LogicalToBit(m.tuIncludeSystemFiles)
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.AppendFilesEx(m.tcFilePattern, m.liRecursive, m.liSaveExtraPath, ;
		      m.liArchiveOnly, m.liIncludeHiddenFiles, m.liIncludeSystemFiles) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

