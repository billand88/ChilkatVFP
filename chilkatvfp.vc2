		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(m.lqValue) == T_VARBINARY
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_VARBINARY
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
