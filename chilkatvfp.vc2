		        loChilkatTask = ;
		        m.loChilkatObject.GetSecretSbAsync(m.loChilkatJSON, m.loChilkatStringBuilder)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJson.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Secrets])
		  toChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJson = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder]
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder]
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsecretstr		&& Introduced in version 10.1.0. Fetches a string secret and returns the content of the secret. Returns Nothing on failure
		*==============================================================================
		* Method:            GetSecretStr
		* Purpose:           Fetches a string secret and returns the content of the secret.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSON, a Chilkat JSON object.
		* Returns:           lcSecret, the secret content.
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		**
		** Fetches a string secret and returns the content of the secret.
		**
		** Fixed in version 11.2.0: The “The data exceeds the maximum size of a secret 
		** (CredentialBlob) in the Windows Credentials Manager.” error, 
		** which occurred on some older Windows systems.
		**
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS toChilkatJSON AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Secrets], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJson AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS [Chilkat.JsonObject], lcSecret AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		lcSecret = []
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJson = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJson.GetObject()
		
		      TRY
		
		        lcSecret = m.loChilkatObject.GetSecretStr(m.loChilkatJSON)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJson.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		RETURN m.lcSecret
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Secrets])
		  toChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJson = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsecretstrasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the GetSecretStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            GetSecretStrAsync
		* Purpose:           Creates an asynchronous task to call the GetSecretStr 
		*                    method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONIn, a Chilkat JSON object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0.
		**
		** Creates an asynchronous task to call the GetSecretStr method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Fixed in version 11.2.0: The “The data exceeds the maximum size of a secret 
		** (CredentialBlob) in the Windows Credentials Manager.” error, 
		** which occurred on some older Windows systems.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatJSON AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Secrets], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJson AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS [Chilkat.JsonObject], loChilkatTask AS [Chilkat.Task]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON, m.loChilkatTask
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJson = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJson.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.GetSecretStrAsync(m.loChilkatJSON)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJson.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Secrets])
		  toChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJson = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the LastBinaryResult property of the referenced Chilkat object.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqValue, the last binary result.
		* Returns:           
		* Date Added:        12/26/2024
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tqValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

