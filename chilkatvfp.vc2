	PROCEDURE hasflag		&& Returns 1 if the Nth mailbox has the specified flag set. The flag name is case insensitive and should begin with a backslash character, such as "\Flagged". The index is the index of the Nth mailbox.
		*==============================================================================
		* Method:            HasFlag
		* Purpose:           Returns 1 if the Nth mailbox has the specified flag set.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the mailbox array value.
		*                    tcFlagName, the flag name to search.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Returns 1 if the Nth mailbox has the specified flag set. 
		** The flag name is case insensitive and should begin with a backslash character, 
		** such as "\Flagged". The index is the index of the Nth mailbox.
		**
		
		LPARAMETERS tiIndex AS Integer, tcFlagName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILBOXES_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.HasFlag(m.tiIndex, m.tcFlagName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILBOXES_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE hasinferiors		&& Returns 1 if the Nth mailbox has inferiors (i.e. sub-mailboxes), or if it is possible to create child mailboxes in the future. Note: the HasNoChildren attribute/flag should not be confused with the IMAP4 [RFC-2060] defined attribute.
		*==============================================================================
		* Method:            HasInferiors
		* Purpose:           Returns 1 if the Nth mailbox has inferiors (i.e. sub-mailboxes),
		*                    or if it is possible to create child mailboxes in the future.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the mailbox array value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Returns 1 if the Nth mailbox has inferiors (i.e. sub-mailboxes), 
		** or if it is possible to create child mailboxes in the future.
		** 
		** Note: the HasNoChildren attribute/flag should not be confused with the IMAP4 
		** [RFC-2060] defined attribute Noinferiors which indicates 
		** that no child mailboxes exist now AND none can be created in the future.
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MAILBOXES_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.HasInferiors(m.tiIndex) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILBOXES_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

