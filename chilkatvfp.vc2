	PROCEDURE postxml		&& A simplified way of posting XML content to a web server. This method is good for making SOAP calls using HTTP POST.
		*==============================================================================
		* Method:            PostXML
		* Purpose:           A simplified way of posting XML content to a web server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEndpointURL -- the URL to post the content.
		*                    tcXMLContent -- the XML to post.
		*                    tcXMLCharset -- the charset of the passed XML.
		* Returns:           Chilkat HTTP Response object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** A simplified way of posting XML content to a web server. 
		** This method is good for making SOAP calls using HTTP POST. 
		** The xmlCharset should match the character encoding used in the xmlContent, 
		** which is typically "utf-8". The HTTP response is returned in an HTTP response object.
		**
		** Important: This method sends the POST with a "Content-Type" header value of "application/xml". 
		** In rare cases, a server might require the Content-Type header to be "text/xml". 
		** To use "text/xml" instead of the default "application/xml", 
		** call SetRequestHeader("Content-Type","text/xml") prior to calling this method.
		**
		** To use HTTPS simply pass an endpointUrl beginning with "https://" instead of "http://". 
		** This applies to any Chilkat method where a URL is passed as an argument.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEndpointURL AS Character, tcXMLContent AS Character, tcXMLCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatHTTPResponse = ;
		      m.loChilkatObject.PostXML(m.tcEndpointURL, m.tcXMLContent, m.tcXMLCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE postxmlasync		&& Creates an asynchronous task to call the PostXml method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            PostXMLAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    PostXMLAsync method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEndpointURL -- the URL to post the content.
		*                    tcXMLContent -- the XML to post.
		*                    tcXMLCharset -- the charset of the passed XML.
		* Returns:           Chilkat Task object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the PostXml method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEndpointURL AS Character, tcXMLContent AS Character, tcXMLCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.PostXMLAsync(m.tcEndpointURL, m.tcXMLContent, m.tcXMLCharset)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE preferipv6_access		&& Access method used to retrieve the Chilkat HTTP PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PreferIPV6
		* Date Added:        01/28/2022
		*==============================================================================
		
		**
		** If 1, then use IPv6 over IPv4 when both are supported for a particular domain. 
		** The default value of this property is 0, which will choose IPv4 over IPv6.
		**
		** Enhancement for version 70: Added internal re-try functionality 
		** to cope with various situations for IPv4-only and IPv6-only networks.
		**
		** (Note: Chilkat was updated in v9.5.0.97 to enable "dual-stack" support, 
		** where a server can handle both IPv6 and IPv4 traffic using a single socket. 
		** Prior to v9.5.0.97, setting this property to 1 
		** had the effect that only IPv6 connections could be accepted.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Assign
		* Purpose:           Assign method used to hold a reference to the PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PreferIPV6 property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE proxyauthmethod_access		&& Access method used to retrieve the Chilkat HTTP ProxyAuthMethod property.
		*==============================================================================
		* Method:            ProxyAuthMethod_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP ProxyAuthMethod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ProxyAuthMethod
		* Date Added:        01/28/2022
		*==============================================================================
		
		** 
		** Set this to "basic" if you know in advance that Basic authentication 
		** is to be used for the HTTP proxy. Otherwise leave this property unset. 
		** Note: It is not necessary to set this property. 
		** The HTTP component will automatically handle proxy authentication 
		** for any of the supported authentication methods: NTLM, Digest, or Basic. 
		** Setting this property equal to "basic" prevents the 407 response 
		** which is automatically handled internal to Chilkat and never seen by your application.
		**
		** Note: If NTLM authentication does not succeed, 
		** set the Global.DefaultNtlmVersion property equal to 1 and then retry.
		**
		** Fixed in Version 51: Fixed issues related to using 
		** HTTP proxies for non-HTTP protocols where SSL/TLS is not used.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE proxyauthmethod_assign		&& Assign method used to hold a reference to the ProxyAuthMethod property.
		*==============================================================================
