	PROCEDURE signdata		&& Introduced in version 9.5.0.87. Signs the data passed in bdData. The hashDataAlg can be "sha1", "sha256", "sha384", "sha512", or "none". If not equal to "none", then the hash of the data passed in bdData is signed.
		*==============================================================================
		* Method:            SignData
		* Purpose:           Signs the data passed in bdData.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the key container index value.
		*                    tcKeySpec, the key specification.
		*                    tcHashDataAlgorithm, the hash data algorithm
		*                    toChilkatBinData, a Chilkat Binary data object.
		*                    toChilkatBinDataSigned, a Chilkat Binary data object.
		*                    tcPINID, the PIN ID value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Signs the data passed in bdData. The hashDataAlg can be "sha1", "sha256", ;
		** "sha384", "sha512", or "none". If not equal to "none", 
		** then the hash of the data passed in bdData is signed.
		** 
		** The containerIndex specifies the key container. By specifying the key container, 
		** you are almost specifying the key. A key container can contain two keys: 
		** A signature key, and a key-exchange key. The keySpec indicates 
		** which of these two keys to use. keySpec should be set to "sig" or "kex".
		** 
		** Note: The type of signature created, such as RSA or ECC, is determined 
		** by the type of key that exists in the key container 
		** (specified by containerIndex and keySpec). If it is an RSA key, 
		** additional options can be specified via the RsaPaddingScheme 
		** and RsaPaddingHash properties.
		** 
		** If successful, the signature is written to bdSignedData.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tcKeySpec AS Character, tcHashDataAlgorithm AS Character ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, toChilkatBinDataSigned AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loParkParameterBinDataSigned AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataSigned AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown
		
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData, ;
		m.loParkParameterBinDataSigned, m.loChilkatBinDataSigned
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loParkParameterBinDataSigned = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataSigned)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		      loChilkatBinDataSigned = m.loParkParameterBinDataSigned.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SignData(m.tiIndex, m.tcKeySpec, m.tcHashDataAlgorithm, ;
		        m.loChilkatBinData, m.loChilkatBinDataSigned) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		      toChilkatBinDataSigned = ;
		      m.loParkParameterBinData.SetObject(toChilkatBinDataSignedSigned, m.loChilkatBinDataSigned)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData, ;
		m.loParkParameterBinDataSigned, m.loChilkatBinDataSigned
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatBinDataSigned = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinDataSigned = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatBinDataSigned = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

