	HIDDEN PROCEDURE micalg_access		&& Access method used to retrieve the Chilkat MIME MicAlg property.
		*==============================================================================
		* Method:            MicAlg_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME MicAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.MicAlg
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** The value of the "micalg" attribute of the Content-Type header field. 
		** For example, if the Content-Type header is this:
		** 
		**  Content-Type: multipart/signed; protocol="application/x-pkcs7-signature"; micalg=sha1; 
		      boundary="------------ms000908010507020408060303"
		** 
		** then the value of the Micalg property is "sha".
		** 
		** Note: The micalg attribute is only present in PKCS7 signed MIME. 
		** Setting the Micalg property has the effect of choosing the hash algorithm used w/ signing. 
		** Possible choices are "sha1", "md5", "sha256", "sha384", and "sha512". 
		** However, it is preferable to set the signing hash algorithm 
		** by setting the SigningHashAlg property instead.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE micalg_assign		&& Assign method used to hold a reference to the MicAlg property.
		*==============================================================================
		* Method:            MicAlg_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME MicAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the MicAlg property.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [MicAlg]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE mimename_access		&& Access method used to retrieve the Chilkat MIME Name property.
		*==============================================================================
		* Method:            MIMEName_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME Name property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.MIMEName
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** The value of the "name" attribute of the Content-Type header field. 
		** For example, if the Content-Type header is this:
		** 
		**   Content-Type: image/gif; name="starfish.gif"
		** 
		** then the value of the Name property is "starfish.gif".
		** 
		
		** Note: The Visual Foxpro property name does not match the Chilkat property name!!
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		WITH THIS
		
		  .cChilkatProperty = [Name]
		  .CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		  .cChilkatProperty = []
		
		ENDWITH
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE mimename_assign		&& Assign method used to hold a reference to the Name property.
		*==============================================================================
		* Method:            MIMEName_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME Name property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the MIMEName property.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		WITH THIS
		
		  .cChilkatProperty = [Name]
		  .CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		  .cChilkatProperty = []
		
		ENDWITH  
		
		RETURN
	ENDPROC

	PROCEDURE newmessagerfc822		&& Clears the Mime object and initializes it such that the header contains a "content-type: message/rfc822" line and the body is the MIME text of the Mime object passed to the method. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            NewMessageRfc822
		* Purpose:           Clears the Mime object and initializes it such that the header 
		*                    contains a "content-type: message/rfc822" line.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatMime, a Chilkat MIME object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Clears the Mime object and initializes it such that the header 
		** contains a "content-type: message/rfc822" line 
		** and the body is the MIME text of the Mime object passed to the method.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatMime AS CHILKAT_MIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loParkParameterMime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMime AS CHILKAT_MIME_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMime, m.loChilkatMime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterMime = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMime)
		
		    loChilkatMime = m.loParkParameterMime.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.NewMessageRfc822(m.loChilkatMime) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatMime = ;
		    m.loParkParameterMime.SetObject(m.toChilkatMime, m.loChilkatMime)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMime, m.loChilkatMime
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatMime = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loParkParameterMime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMime = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

