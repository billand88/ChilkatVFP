		*                    used to hold a reference to the EXEDefaultDir property.
		* Returns:           
		* Date Added:        04/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE exefinishnotifier_access		&& Access method used to retrieve the Chilkat ZIP EXEFinishNotifier property.
		*==============================================================================
		* Method:            EXEFinishNotifier_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP EXEFinishNotifier property.
		* Author:            Bill Anderson
