ENDDEFINE

DEFINE CLASS mcp AS ibasechilkat OF "chilkatvfp.vcx" 		&& Chilkat.Mcp connects to an MCP server and gives an application access to the server's tools, resourTooces, and prompts over a single, unified API. MCP is an open protocol that standardizes how applications supply context and callable tools to AI models.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: authtoken_access		&& Access method used to retrieve the Chilkat Mcp AuthToken property.
		*m: authtoken_assign		&& Assign method used to hold a reference to the AuthToken property.
		*m: calltool		&& Introduced in version 11.6.0. Calls the MCP tools/call method for the tool named name, passing the JSON arguments object in arguments. The members of arguments are the tool's input arguments and should match the tool's inputSchema as returned by ListTools
		*m: calltoolasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the CallTool method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: close		&& Introduced in version 11.6.0
		*m: closeasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the Close method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: connect		&& Introduced in version 11.6.0. Connects to the MCP (Model Context Protocol) server at the Streamable HTTP endpoint URL in url (for example https://example.com/mcp) and performs the MCP initialize handshake. Returns 1 for success, 0 for failure.
		*m: connectasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the Connect method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: connected_access		&& Access method used to retrieve the Chilkat Mcp Connected property.
		*m: connected_assign		&& Assign method used to hold a reference to the Connected property.
		*m: connecttimeoutms_access		&& Access method used to retrieve the Chilkat Mcp ConnectTimeout property.
		*m: connecttimeoutms_assign		&& Assign method used to hold a reference to the ConnectTimeout property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Mcp DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getlastjsondata		&& Introduced in version 11.6.0. Returns, in json, the complete JSON-RPC response envelope from the most recent request (the jsonrpc, id, and result or error members), for diagnostics and logging.
		*m: getprompt		&& Introduced in version 11.6.0. Calls the MCP prompts/get method for the prompt named name, passing the JSON arguments object in arguments (pass an empty object for a prompt that takes no arguments). Returns 1 for success, 0 for failure.
		*m: getpromptasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the GetPrompt method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat Mcp HeartBeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: idletimeoutms_access		&& Access method used to retrieve the Chilkat Mcp IdleTimeoutMs property.
		*m: idletimeoutms_assign		&& Assign method used to hold a reference to the IdleTimeOutMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Mcp LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Mcp LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Mcp LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Mcp LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Mcp LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Mcp LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Mcp LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: listprompts		&& Introduced in version 11.6.0. Calls the MCP prompts/list method. On success, the server's result object is placed in json. Connect must be called first. Returns 1 for success, 0 for failure.
		*m: listpromptsasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the ListPrompts method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: listresources		&& Introduced in version 11.6.0. Calls the MCP resources/list method. On success, the server's result object is placed in json. Connect must be called first. Returns 1 for success, 0 for failure.
		*m: listresourcesasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the ListResources method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: listtools		&& Introduced in version 11.6.0. Calls the MCP tools/list method. On success, the server's result object is placed in json. Connect must be called first. Returns 1 for success, 0 for failure.
		*m: listtoolsasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the ListTools method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: protocolversion_access		&& Access method used to retrieve the Chilkat Mcp ProtocolVersion property.
		*m: protocolversion_assign		&& Assign method used to hold a reference to the ProtocolVersion property.
		*m: readresource		&& Introduced in version 11.6.0. Calls the MCP resources/read method for the resource identified by the URI in uri. Connect must be called first. Returns 1 for success, 0 for failure.
		*m: readresourceasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the ReadResource method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: serverinstructions_access		&& Access method used to retrieve the Chilkat Mcp ServerInstructions property.
		*m: serverinstructions_assign		&& Assign method used to hold a reference to the ServerInstructions property.
		*m: servername_access		&& Access method used to retrieve the Chilkat Mcp ServerName property.
		*m: servername_assign		&& Assign method used to hold a reference to the ServerName property.
		*m: serverversion_access		&& Access method used to retrieve the Chilkat Mcp ServerVersion property.
		*m: serverversion_assign		&& Assign method used to hold a reference to the ServerVersion property.
		*m: sessionid_access		&& Access method used to retrieve the Chilkat Mcp SessionID property.
		*m: sessionid_assign		&& Assign method used to hold a reference to the SessionID property.
		*m: setconnectionsettings		&& Introduced in version 11.6.0. Copies connection settings, including HTTP proxy, SOCKS proxy, bind (network interface) IP address, and TLS options, from sock. This is optional; if not used, default settings apply. Call this method before Connect.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Mcp VerboseLogging property.
		*m: verboselogging_assign		&& Access method used to retrieve the Chilkat Mcp VerboseLogging property.
		*p: authtoken		&& Introduced in version 11.6.0. An optional bearer token for authenticating to the MCP server. When set, it is sent as an Authorization: Bearer <token> header on every request. The default is the empty string.
		*p: connected		&& Introduced in version 11.6.0. Read-only. 1 after a successful Connect (the initialize handshake completed).
		*p: connecttimeoutms		&& Introduced in version 11.6.0. The maximum amount of time, in milliseconds, to wait to establish the TCP/TLS connection to the MCP server. The default value is 30000 (30 seconds).
		*p: debuglogfilepath		&& If set to a file path, this property logs the LastErrorText of each Chilkat method or property call to the specified file. This logging helps identify the context and history of Chilkat calls leading up to any crash or hang, aiding in debugging.
		*p: heartbeatms		&& Introduced in version 11.6.0. The interval in milliseconds between each AbortCheck event callback, which enables an application to abort a method before it completes. By default, HeartbeatMs is 0, meaning no AbortCheck event callbacks fire.
		*p: idletimeoutms		&& Introduced in version 11.6.0. The maximum amount of time, in milliseconds, to wait for additional incoming data when receiving a response has paused. This is not a total timeout. The default value is 180000 (180 seconds).
		*p: lastbinaryresult		&& This property is mainly used in SQL Server stored procedures to retrieve binary data from the last method call that returned binary data. It is only accessible if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides HTML-formatted information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lasterrortext		&& Provides plain text information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lasterrorxml		&& Provides XML-formatted information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lastmethodsuccess		&& Indicates the success or failure of the most recent method call: 1 means success, 0 means failure. This property remains unchanged by property setters or getters.
		*p: laststringresult		&& In SQL Server stored procedures, this property holds the string return value of the most recent method call that returns a string. It is accessible only when Chilkat.Global.KeepStringResult is set to TRUE.
		*p: laststringresultlen		&& The length, in characters, of the string contained in the LastStringResult property.
		*p: protocolversion		&& Introduced in version 11.6.0. The MCP protocol version. May be set before Connect to request a specific version; after Connect it reflects the version negotiated with the server and is sent in the MCP-Protocol-Version header of each request.
		*p: serverinstructions		&& Introduced in version 11.6.0. Read-only. Optional usage instructions provided by the server in the initialize result (may be the empty string), available after Connect.
		*p: servername		&& Introduced in version 11.6.0. Read-only. The server name reported in the initialize result, available after Connect.
		*p: serverversion		&& Introduced in version 11.6.0. Read-only. The server version reported in the initialize result, available after Connect.
		*p: sessionid		&& Introduced in version 11.6.0. Read-only. The Mcp-Session-Id assigned by the server during the Connect handshake, or the empty string if the server is stateless. Chilkat automatically includes this session id on all subsequent requests.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		authtoken = 
		cchilkatclass = Mcp
		ceventhandlerclass = iBaseEventHandler
		connected = 0
		connecttimeoutms = 30000
		debuglogfilepath = 
		heartbeatms = 0
		idletimeoutms = 180000
		iinstancemajor = 11
		iinstanceminor = 6
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 0
		laststringresult = 
		laststringresultlen = 0
		Name = "mcp"
		protocolversion = 2025-06-18
		serverinstructions = 
		servername = 
		serverversion = 
		sessionid = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE authtoken_access		&& Access method used to retrieve the Chilkat Mcp AuthToken property.
		*==============================================================================
		* Method:            AuthToken_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Mcp AuthToken property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AuthToken
		* Date Added:        09/06/2026
		*==============================================================================
		
		** 
		** Introduced in version 11.6.0
		**
		** An optional bearer token for authenticating to the MCP server. 
		** When set, it is sent as an Authorization: Bearer <token> header on every request. 
		** The default is the empty string.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE authtoken_assign		&& Assign method used to hold a reference to the AuthToken property.
		*==============================================================================
		* Method:            AuthToken_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Mcp AuthToken property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the AuthToken property.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE calltool		&& Introduced in version 11.6.0. Calls the MCP tools/call method for the tool named name, passing the JSON arguments object in arguments. The members of arguments are the tool's input arguments and should match the tool's inputSchema as returned by ListTools
		*==============================================================================
		* Method:            CallTool
		* Purpose:           Calls the MCP tools/call method for the tool named name.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcToolName, the tool name that gets the call.
		*                    toChilkatJsonObjectArg, the JSON object holding arguments.
		*                    toChilkatJsonObjectResult, the JSON Object holding results.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Calls the MCP tools/call method for the tool named name, 
		** passing the JSON arguments object in arguments. The members of arguments are the tool's 
		** input arguments and should match the tool's inputSchema as returned by ListTools. 
		** For example, a weather tool might be called with the arguments 
		** { "location": "Boston, MA", "units": "fahrenheit" }. 
		** Pass an empty JSON object (not a null) for a tool that takes no arguments.
		**
		** On success, the tool result is placed in result. It contains a content array, 
		** an isError boolean, and optionally a structuredContent object. 
		** Each element of the content array has a type ("text", "image", "audio", or "resource"); 
		** for a "text" element the value is in its text member. A typical result looks like:
		** 
		** 
		**   {
		**     "content": [ { "type": "text", "text": "The weather in Boston is 72F and sunny." } ],
		**     "isError": false
		**   }
		**
		** Thus the text of the first content item is at JSON path content[0].text.
		** Note: A tool that executes but reports a failure returns 1 here with isError set 
		** to 1 in result (the failure message is typically carried in the content array). 
		** The return value is 0 only for transport- or protocol-level failures.
		** 
		** Connect must be called first.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcToolName AS Character, ;
		toChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		toChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterJsonObjectArg AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		loParkParameterJsonObjectResult AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectArg, m.loChilkatJsonObjectArg, ;
		m.loParkParameterJsonObjectResult, m.loChilkatJsonObjectResult
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObjectArg = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectArg)
		
		      loChilkatJsonObjectArg = m.loParkParameterJsonObjectArg.GetObject()
		
		      loParkParameterJsonObjectResult = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectResult)
		
		      loChilkatJsonObjectResult = m.loParkParameterJsonObjectResult.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CallTool(m.tcToolName, m.loChilkatJsonObjectArg, ;
		        m.loChilkatJsonObjectResult) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObjectArg = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectArg, m.loChilkatJsonObjectArg)
		
		      toChilkatJsonObjectResult = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectResult, m.loChilkatJsonObjectResult)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectArg, m.loChilkatJsonObjectArg, ;
		m.loParkParameterJsonObjectResult, m.loChilkatJsonObjectResult
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  loException = NEWOBJECT([Exception])
		  toChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectArg = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectResult = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE calltoolasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the CallTool method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            CallToolAsync
		* Purpose:           Creates an asynchronous task to call the CallTool 
		*                    method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcToolName, the tool name that gets the call.
		*                    toChilkatJsonObjectArg, the JSON object holding arguments.
		*                    toChilkatJsonObjectResult, the JSON Object holding results.
		* Returns:           loChilkatTask, a Chilkat Task object.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Creates an asynchronous task to call the CallTool method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcToolName AS Character, ;
		toChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		toChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS [Chilkat.Task], ;
		loParkParameterJsonObjectArg AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		loParkParameterJsonObjectResult AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObjectArg = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectArg)
		
		      loChilkatJsonObjectArg = m.loParkParameterJsonObjectArg.GetObject()
		
		      loParkParameterJsonObjectResult = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectResult)
		
		      loChilkatJsonObjectResult = m.loParkParameterJsonObjectResult.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.CallToolAsync(m.tcToolName, ;
		        m.loChilkatJsonObjectArg, m.loChilkatJsonObjectResult)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatJsonObjectArg = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectArg, m.loChilkatJsonObjectArg)
		
		      toChilkatJsonObjectResult = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectResult, m.loChilkatJsonObjectResult)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectArg, m.loChilkatJsonObjectArg, ;
		m.loParkParameterJsonObjectResult, m.loChilkatJsonObjectResult
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		  toChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectArg = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectResult = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        09/07/2026
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		  
		  Chilkat v11.6.0 adds support for the Model Context Protocol (MCP) — an open protocol 
		  that standardizes how applications provide tools, resources, and prompts to AI models. 
		  This release introduces a new Mcp class (an MCP client) and integrates MCP tools 
		  into the existing Ai class through a new UseMcp method.
		
		  New class: Mcp
		
		  The Mcp class connects to an MCP server and gives an application unified access to the server’s tools, 
		  resources, and prompts. It uses the MCP Streamable HTTP transport (protocol version 2025-06-18): 
		  a single endpoint URL handles the JSON-RPC exchange over HTTP POST, 
		  and a server response may arrive either as a single JSON object or as a Server-Sent-Events stream — 
		  both handled transparently. The stdio transport is not supported in this release.
		
		
		  Capability  Details
		
		  Connecting  Connect performs the MCP initialize handshake, then SessionId, ProtocolVersion, 
		  ServerName, ServerVersion, and ServerInstructions are populated and Connected is true. 
		  Chilkat sends the MCP-Protocol-Version and Mcp-Session-Id headers automatically; 
		  Close terminates the session (HTTP DELETE).
		
		  Tools  ListTools returns each tool’s name, description, and inputSchema; 
		  CallTool invokes a tool by name and returns its content array and isError flag. 
		  A tool that runs but reports failure returns success with isError true.
		  Resources & prompts  ListResources / ReadResource (text or base64 blob) and ListPrompts / GetPrompt.
		  Auth & settings  AuthToken for a bearer token; SetConnectionSettings copies proxy, 
		  bind-IP, and TLS options from a Socket. Timeouts via IdleTimeoutMs (180000) 
		  and ConnectTimeoutMs (30000); HeartbeatMs controls the AbortCheck interval.
		
		ENDTEXT
		
		#ENDIF .F.
		
	ENDPROC

	PROCEDURE close		&& Introduced in version 11.6.0
		*==============================================================================
		* Method:            Close
		* Purpose:           Explicitly terminates the MCP session.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Explicitly terminates the MCP session by sending an HTTP DELETE with 
		** the Mcp-Session-Id header, then releases the connection. 
		** It is safe to call this method when not connected (it simply releases any transport). 
		** A server that does not permit client-terminated sessions 
		** responds with HTTP 405, which is not treated as an error.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.Close() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

