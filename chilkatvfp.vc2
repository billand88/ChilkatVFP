	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat Mcp DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Mcp DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        09/06/2026
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Mcp DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE getlastjsondata		&& Introduced in version 11.6.0. Returns, in json, the complete JSON-RPC response envelope from the most recent request (the jsonrpc, id, and result or error members), for diagnostics and logging.
		*==============================================================================
		* Method:            GetLastJsonData
		* Purpose:           Returns, in json, the complete JSON-RPC response envelope. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Returns, in json, the complete JSON-RPC response envelope from the most recent request 
		** (the jsonrpc, id, and result or error members), for diagnostics and logging. 
		** Note that this is the full JSON-RPC envelope, whereas ListTools, CallTool, ReadResource,
		** and GetPrompt each return only the inner result object.
		** 
		
		LPARAMETERS toChilkatJSONObject AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], llImplemented AS Logical, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS [Chilkat.JsonObject], loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        m.loChilkatObject.GetLastJsonData(m.loChilkatJSONObject)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  toChilkatJSONObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getprompt		&& Introduced in version 11.6.0. Calls the MCP prompts/get method for the prompt named name, passing the JSON arguments object in arguments (pass an empty object for a prompt that takes no arguments). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetPrompt
		* Purpose:           Calls the MCP prompts/get method for the prompt named name.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName, the prompt name.
		*                    toChilkatJsonObjectArg, the JSON object holding arguments.
		*                    toChilkatJsonObjectResult, the JSON Object holding results.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Calls the MCP prompts/get method for the prompt named name, 
		** passing the JSON arguments object in arguments (pass an empty object 
		** for a prompt that takes no arguments). On success, the result is placed in json, 
		** consisting of an optional description and a messages array 
		** in which each message has a role and content.
		**
		** Connect must be called first.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcName AS Character, ;
		toChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		toChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterJsonObjectArg AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		loParkParameterJsonObjectResult AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectArg, m.loChilkatJsonObjectArg, ;
		m.loParkParameterJsonObjectResult, m.loChilkatJsonObjectResult
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObjectArg = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectArg)
		
		      loChilkatJsonObjectArg = m.loParkParameterJsonObjectArg.GetObject()
		
		      loParkParameterJsonObjectResult = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectResult)
		
		      loChilkatJsonObjectResult = m.loParkParameterJsonObjectResult.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetPrompt(m.tcName, m.loChilkatJsonObjectArg, ;
		        m.loChilkatJsonObjectResult) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObjectArg = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectArg, m.loChilkatJsonObjectArg)
		
		      toChilkatJsonObjectResult = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectResult, m.loChilkatJsonObjectResult)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectArg, m.loChilkatJsonObjectArg, ;
		m.loParkParameterJsonObjectResult, m.loChilkatJsonObjectResult
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  loException = NEWOBJECT([Exception])
		  toChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectArg = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectResult = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE getpromptasync		&& Introduced in version 11.6.0. Creates an asynchronous task to call the GetPrompt method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetPromptAsync
		* Purpose:           Creates an asynchronous task to call the GetPrompt 
		*                    method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName, the prompt name.
		*                    toChilkatJsonObjectArg, the JSON object holding arguments.
		*                    toChilkatJsonObjectResult, the JSON Object holding results.
		* Returns:           loChilkatTask, a Chilkat Task object.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Creates an asynchronous task to call the GetPrompt method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcName AS Character, ;
		toChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		toChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS [Chilkat.Task], ;
		loParkParameterJsonObjectArg AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectArg AS [Chilkat.JsonObject], ;
		loParkParameterJsonObjectResult AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectResult AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObjectArg = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectArg)
		
		      loChilkatJsonObjectArg = m.loParkParameterJsonObjectArg.GetObject()
		
		      loParkParameterJsonObjectResult = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectResult)
		
		      loChilkatJsonObjectResult = m.loParkParameterJsonObjectResult.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.GetPromptAsync(m.tcName, ;
		        m.loChilkatJsonObjectArg, m.loChilkatJsonObjectResult)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatJsonObjectArg = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectArg, m.loChilkatJsonObjectArg)
		
		      toChilkatJsonObjectResult = ;
		      m.loParkParameterJsonObjectArg.SetObject(m.toChilkatJsonObjectResult, m.loChilkatJsonObjectResult)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectArg, m.loChilkatJsonObjectArg, ;
		m.loParkParameterJsonObjectResult, m.loChilkatJsonObjectResult
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		  toChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectArg = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectArg = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectResult = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectResult = NEWOBJECT([Chilkat.JsonObject])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat Mcp HeartBeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Mcp HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** The interval in milliseconds between each AbortCheck event callback, 
		** which enables an application to abort certain method calls before they complete. 
		** By default, HeartbeatMs is set to 0, meaning no AbortCheck event callbacks will trigger.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold a reference to the HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold a 
		*                    reference to the HeartbeatMs property.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [HeartbeatMs]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE idletimeoutms_access		&& Access method used to retrieve the Chilkat Mcp IdleTimeoutMs property.
		*==============================================================================
		* Method:            IdleTimeoutMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the IdleTimeoutMs property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IdleTimeoutMs
		* Date Added:        09/06/2026
		*==============================================================================
		
		** 
		** Introduced in version 11.6.0.
		** 
		** The maximum amount of time, in milliseconds, to wait for additional incoming data 
		** when receiving a response has paused. This is not a total timeout. 
		** The default value is 180000 (180 seconds).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

