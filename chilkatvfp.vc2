	PROCEDURE hasprivatekey		&& Returns 1 if a private key associated with the certificate is available.
		*==============================================================================
		* Method:            HasPrivateKey
		* Purpose:           Returns 1 if a private key associated with the certificate is available.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Returns 1 if a private key associated with the certificate is available.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.HasPrivateKey() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        11/03/2023
		*==============================================================================
		
		LOCAL llReturn AS Logical, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of ChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		loVersioning = NULL
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Version 96 or later without property entry test
		      IF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 96) ;
		      AND EMPTY(.cEventHandlerClass)
		
		        .cEventHandlerClass = [iBaseEventHandler]
		
		      ENDIF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 96) ;
		      AND EMPTY(.cEventHandlerClass)
		      ** End version 96 or later without property entry test
		
		    ELSE
		
		      llReturn = .F.
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have a good object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loVersioning = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE intendedkeyusage_access		&& Access method used to retrieve the Chilkat Cert IntendedKeyUsage property.
		*==============================================================================
		* Method:            IntendedKeyUsage_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert IntendedKeyUsage property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IntendedKeyUsage
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Bitflags indicating the intended usages of the certificate. The flags are:
		** 
		**   Digital Signature: 0x80
		**   Non-Repudiation: 0x40
		**   Key Encipherment: 0x20
		**   Data Encipherment: 0x10
		**   Key Agreement: 0x08
		**   Certificate Signing: 0x04
		**   CRL Signing: 0x02
		**   Encipher-Only: 0x01
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE intendedkeyusage_assign		&& Assign method used to hold a reference to the IntendedKeyUsage property.
		*==============================================================================
		* Method:            IntendedKeyUsage_Assign
		* Purpose:           Assign method used to hold a reference to the IntendedKeyUsage property.
