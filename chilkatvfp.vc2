	PROCEDURE uncompressfiletostring		&& Uncompresses a .gz file that contains a text file. The contents of the text file are returned as a string. The character encoding of the text file is specified by charset.
		*==============================================================================
		* Method:            UncommpressFileToString
		* Purpose:           Uncompresses a .gz file that contains a text file. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcGZipFileName -- the GZip file to uncompress
		*                    tcCharset -- the charset of the file.
		* Returns:           Character
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Uncompresses a .gz file that contains a text file. 
		** The contents of the text file are returned as a string. 
		** The character encoding of the text file is specified by charset. 
		** Typical charsets are "iso-8859-1", "utf-8", "windows-1252", "shift_JIS", "big5", etc.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcGZipFileName AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, lcDecodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcDecodedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcDecodedString = ;
		      m.loChilkatObject.UncommpressFileToString(m.tcGZipFileName, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcDecodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

