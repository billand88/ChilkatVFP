		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSsh, m.loChilkatSsh
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  toChilkatSSH = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  loParkParameterSsh = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSsh = NEWOBJECT(CHILKAT_SSH_COM_CALL)
