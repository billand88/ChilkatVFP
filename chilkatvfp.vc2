	PROCEDURE downloadrate		&& Called periodically with download progress information: The byteCount is the cumulative number of bytes downloaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*==============================================================================
		* Method:            DownloadRate
		* Purpose:           Called periodically with download progress information.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** Called periodically with download progress information: 
		** The byteCount is the cumulative number of bytes downloaded so far. 
		** The bytesPerSec is the current transfer rate in bytes per second.
		**
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount
		liBytesPerSec = m.tiBytesPerSec
		llReturn = .T.
		
		*!*  ? [DownloadRate Event!]
		*!*  ? [DownloadRate: ByteCount = ] + STR(liByteCount) + [, BytesPerSec = ] + STR(liBytesPerSec)
		
		WITH THIS
		
		  llReturn = .DownloadRate_Pre(m.liByteCount, m.liBytesPerSec)
		
		  ** OK to continue test
		  IF m.llReturn 
		
		    llReturn = .DownloadRate_Process(m.liByteCount, m.liBytesPerSec)
		
		    ** OK to continue test
		    IF m.llReturn 
		
		      llReturn = .DownloadRate_Post(m.liByteCount, m.liBytesPerSec)
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		tiByteCount = m.liByteCount
		tiBytesPerSec = m.liBytesPerSec
		
		RETURN
	ENDPROC

	PROCEDURE downloadrate_post		&& DownloadRate post-processing method.
		*==============================================================================
		* Method:            DownloadRate_Post
		* Purpose:           DownloadRate post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		RETURN
	ENDPROC

	PROCEDURE downloadrate_pre		&& DownloadRate pre-processing method.
		*==============================================================================
		* Method:            DownloadRate_Pre
		* Purpose:           DownloadRate pre-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		RETURN
	ENDPROC

	PROCEDURE downloadrate_process		&& DownloadRate processing method.
		*==============================================================================
		* Method:            DownloadRate_Process
		* Purpose:           DownloadRate processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		RETURN
	ENDPROC

	PROCEDURE enddownloadfile		&& Called just after a file download has completed.
		*==============================================================================
		* Method:            EndDownloadFile
		* Purpose:           Called just after a file download has completed.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file.
		*                    tiByteCount, the size of the downloaded file.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** Called just after a file download has completed.
		**
		
		LPARAMETERS tcPath AS Character, tiByteCount AS Integer
		
		LOCAL lcPath AS Character, liByteCount AS Integer, llReturn AS Logical
		
		lcPath = m.tcPath
		liByteCount = m.tiByteCount
		
		llReturn = .T.
		
		*!*  ? [EndDownloadFile Event!]
