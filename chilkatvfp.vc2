	ENDPROC

	PROCEDURE hmacbytes		&& Undocumented method! Computes a keyed-Hash Message Authentication Code (HMAC or KHMAC), which is a type of message authentication code (MAC) calculated using a specific algorithm involving a cryptographic hash function in combination with a secret key.
		*==============================================================================
		* Method:            HMACBytes
		* Purpose:           Undocumented method!
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqDataBytes -- the bytes to convert. 
		* Returns:           The HMAC code.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Undocumented method!
		**
		** Computes a keyed-Hash Message Authentication Code (HMAC or KHMAC), which is a
		** type of message authentication code (MAC) calculated using a specific algorithm
		** involving a cryptographic hash function in combination with a secret key. As
		** with any MAC, it may be used to simultaneously verify both the data integrity
		** and the authenticity of a message. Any iterative cryptographic hash function,
		** such as MD5, SHA-1, SHA256, or any of the hash algorithms listed in the
		** HashAlgorithm property, may be used in the calculation of an HMAC; the resulting
		** MAC algorithm is termed HMAC-MD5, HMAC-SHA-1, etc. accordingly. The
		** cryptographic strength of the HMAC depends upon the cryptographic strength of
		** the underlying hash function, on the size and quality of the key and the size of
		** the hash output length in bits.
		** 
		** The secret key is set by calling one of the following methods prior to calling
		** this method: SetHmacKeyBytes, SetHmacKeyEncoded, or SetHmacKeyString.
		** 
		** The hash algorithm is specified by the HashAlgorithm property.
		** 
		** Note: If using Chilkat v9.5.0.55 or later, update your programs to use MacBytes
		** instead (with the MacAlgorithm property set to "hmac").
		**
		** Version 11.0.0: Method removed.
		**
		
		LPARAMETERS tqDataBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqMACCode AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqMACCode
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        lqMACCode = m.loChilkatObject.HMACBytes(m.tqDataBytes)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqMACCode
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE hmacbytesenc		&& Undocumented method! Computes an HMAC using a secret key and hash algorithm. The result is encoded to a string using the encoding (base64, hex, etc.) specified by the EncodingMode property.
		*==============================================================================
		* Method:            HMACBytesENC
		* Purpose:           Undocumented method!
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqDataBytes -- the bytes to convert. 
		* Returns:           The encoded MAC string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Undocumented method!
		**
		** Computes an HMAC using a secret key and hash algorithm. The result is encoded to
		** a string using the encoding (base64, hex, etc.) specified by the EncodingMode
		** property.
		**  
		** The secret key is set by calling one of the following methods prior to calling
		** this method: SetHmacKeyBytes, SetHmacKeyEncoded, or SetHmacKeyString.
		** 
		** The hash algorithm is specified by the HashAlgorithm property.
		** 
		** Note: If using Chilkat v9.5.0.55 or later, update your programs to use
		** MacBytesEnc instead (with the MacAlgorithm property set to "hmac")
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Version 11.0.0: Method removed.
		** 
		
		LPARAMETERS tqDataBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedMACString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedMACString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        lcEncodedMACString = m.loChilkatObject.HMACBytesENC(m.tqDataBytes)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedMACString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

