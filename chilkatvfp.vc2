	ENDPROC

	HIDDEN PROCEDURE stringtosign_access		&& Access method used to retrieve the Chilkat AuthAzureSAS StringToSign property.
		*==============================================================================
		* Method:            StringToSign_Access
		* Purpose:           Access method used to retrieve the 
		*                    Chilkat AuthAzureSAS StringToSign property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.StringToSign
		* Date Added:        07/30/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.65
		**
		** Defines the format of the string to sign.
		** 
		** The format is specified as a comma-separated list of names. For example:
		** 
		**   signedpermissions,signedstart,signedexpiry,canonicalizedresource,signedidentifier,signedIP,signedProtocol,signedversion,rscc,rscd,rsce,rscl,rsct
		**
		** This will result in an actual string-to-sign that is composed 
		** of the values for each name separated by newline (LF) chars. For example:
		**
		**   signedpermissions + "\n" +  
		**   signedstart + "\n" +  
		**   signedexpiry + "\n" +  
		**   canonicalizedresource + "\n" +  
		**   signedidentifier + "\n" +  
		**   signedIP + "\n" +  
		**   signedProtocol + "\n" +  
		**   signedversion + "\n" +  
		**   rscc + "\n" +  
		**   rscd + "\n" +  
		**   rsce + "\n" +  
		**   rscl + "\n" +  
		**   rsct
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 65
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE stringtosign_assign		&& Assign method used to hold a reference to the StringToSign property.
		*==============================================================================
		* Method:            StringToSign_Assign
		* Purpose:           Assign method used to hold the 
		*                    Chilkat AuthAzureSAS StringToSign property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the StringToSign property.
		* Returns:           
		* Date Added:        07/30/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
