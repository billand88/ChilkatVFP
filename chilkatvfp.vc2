	HIDDEN PROCEDURE xmllisting_access		&& Access method used to retrieve the Chilkat TAR XMLListing property.
		*==============================================================================
		* Method:            XMLListing_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat TAR XMLListing property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.XMLListing
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		**
		** Contains the XML listing of the contents of the TAR archive 
		** for the last untar method call (such as Untar, UntarGz, etc.) 
		** where the CaptureXmlListing property was set to 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 46
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE xmllisting_assign		&& Assign method used to hold a reference to the XMLListing property.
		*==============================================================================
		* Method:            XMLListing_Assign
		* Purpose:           Assign method used to hold a reference to the XMLListing property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the XMLListing property.
		* Returns:           
		* Date Added:        05/07/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 46
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS tareventhandler AS ibaseeventhandler OF "chilkatvfp.vcx" 		&& Event Handler for the ChilkatVFP object associated with the TAR class.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: nexttarfile		&& Called for methods that create a TAR archive. This event is called just before a file is to be added to the TAR. The skip argument may be set to 1 to prevent the file from being added.
		*m: nexttarfile_post		&& NextTarFile post-processing method.
		*m: nexttarfile_pre		&& NextTarFile pre-processing method.
		*m: nexttarfile_process		&& NextTarFile processing method.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "tareventhandler"
	*</PropValue>
	
	PROCEDURE nexttarfile		&& Called for methods that create a TAR archive. This event is called just before a file is to be added to the TAR. The skip argument may be set to 1 to prevent the file from being added.
		*==============================================================================
		* Method:            NextTarFile
		* Purpose:           Called for methods that create a TAR archive.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file to compress
		*                    tiFileSize, the file size in bytes.
		*                    tiIsDirectory, 1 if directory, 0 if not
		*                    tiSkip, 1 to skip file, 0 if not.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** Called for methods that create a TAR archive. 
		** This event is called just before a file is to be added to the TAR. 
		** The skip argument may be set to 1 to prevent the file from being added.
		**
		
		LPARAMETERS tcPath AS Character, tiFileSize AS Integer, ;
		tiIsDirectory AS Integer, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liFileSize AS Integer, ;
		liIsDirectory AS Integer, liSkip AS Integer
		
		lcPath = m.tcPath
		liFileSize = m.tiFileSize
		liIsDirectory = m.tiIsDirectory
		liSkip = m.tiSkip
		
		*!*
		*!*  ? [NextTARFile Event!]
		*!*  ? [NextTARFile: Path = ] + lcPath
		*!*  ? [NextTARFile: File Size = ] + ALLTRIM(STR(liFileSize))
		*!*  ? [NextTARFile: Is Directory = ] + IIF(liIsDirectory = 0, [No], [Yes])
		*!*  ? [NextTARFile: Skip File = ] + IF(liSkip = 0, [No], [Yes])
		*!*
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liSkip = 0
		
		    .NextTarFile_Pre(m.lcPath, m.liFileSize, m.liIsDirectory, m.liSkip)
		
		    ** OK to continue test
		    IF m.liSkip = 0
		
		      .NextTarFile_Process(m.lcPath, m.liFileSize, m.liIsDirectory, m.liSkip)
		
		      ** OK to continue test
		      IF m.liSkip = 0
		
		        .NextTarFile_Post(m.lcPath, m.liFileSize, m.liIsDirectory, m.liSkip)
		
		      ENDIF m.liSkip = 0
		      ** End OK to continue test
		
		    ENDIF m.liSkip = 0
		    ** End OK to continue test
		
		  ENDIF m.liSkip = 0
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiFileSize = m.liFileSize
		tiIsDirectory = m.liIsDirectory
		tiSkip = m.liSkip
		
		RETURN
	ENDPROC

	PROCEDURE nexttarfile_post		&& NextTarFile post-processing method.
		*==============================================================================
		* Method:            NextTarFile_Post
		* Purpose:           NextTarFile post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file to compress
		*                    tiFileSize, the file size in bytes.
		*                    tiIsDirectory, 1 if directory, 0 if not
		*                    tiSkip, 1 to skip file, 0 if not.
		* Returns:           liSkip, the skip setting.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tcPath AS Character, tiFileSize AS Integer, ;
		tiIsDirectory AS Integer, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liFileSize AS Integer, ;
		liIsDirectory AS Integer, liSkip AS Integer
		
		lcPath = m.tcPath
		liFileSize = m.tiFileSize
		liIsDirectory = m.tiIsDirectory
		liSkip = m.tiSkip
		
		tcPath = m.lcPath
		tiFileSize = m.liFileSize
		tiIsDirectory = m.liIsDirectory
		tiSkip = m.liSkip
		
		RETURN m.liSkip
	ENDPROC

	PROCEDURE nexttarfile_pre		&& NextTarFile pre-processing method.
		*==============================================================================
		* Method:            NextTarFile_Pre
