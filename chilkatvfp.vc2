	HIDDEN PROCEDURE sendbuffersize_access		&& Access method used to retrieve the Chilkat SendBufferSize property.
		*==============================================================================
		* Method:            SendBufferSize_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 SendBufferSize property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SendBufferSize
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented property! This property is now decremented, and has no effect 
		** in Chilkat versions 9.5.0.69 and greater.
		**
		** In the past, it affected how often percent completion callbacks were made.
		** Setting it to a smaller value caused more frequent percentage completion event
		** callbacks. The default value is 65536 (64K) and should generally not be changed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [Long]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 65536
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		
	ENDPROC

	HIDDEN PROCEDURE sendbuffersize_assign		&& Assign method used to hold a reference to the SendBufferSize property.
