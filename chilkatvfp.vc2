	ENDPROC

	PROCEDURE disconnect		&& Disconnects from the SSH server.
		*==============================================================================
		* Method:            Disconnect
		* Purpose:           Disconnects from the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Disconnects from the SSH server.
		**
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.Disconnect()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE disconnectcode_access		&& Access method used to retrieve the Chilkat SSH DisconnectCode property.
		*==============================================================================
		* Method:            DisconnectCode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH DisconnectCode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DisconnectCode
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** If the SSH server sent a DISCONNECT message when closing the connection, 
		** this property contains the "reason code" as specified in RFC 4253:
		** 
		**            Symbolic name                                reason code
		**            -------------                                -----------
		**       SSH_DISCONNECT_HOST_NOT_ALLOWED_TO_CONNECT             1
		**       SSH_DISCONNECT_PROTOCOL_ERROR                          2
		**       SSH_DISCONNECT_KEY_EXCHANGE_FAILED                     3
		**       SSH_DISCONNECT_RESERVED                                4
		**       SSH_DISCONNECT_MAC_ERROR                               5
		**       SSH_DISCONNECT_COMPRESSION_ERROR                       6
		**       SSH_DISCONNECT_SERVICE_NOT_AVAILABLE                   7
		**       SSH_DISCONNECT_PROTOCOL_VERSION_NOT_SUPPORTED          8
		**       SSH_DISCONNECT_HOST_KEY_NOT_VERIFIABLE                 9
		**       SSH_DISCONNECT_CONNECTION_LOST                        10
		**       SSH_DISCONNECT_BY_APPLICATION                         11
		**       SSH_DISCONNECT_TOO_MANY_CONNECTIONS                   12
		**       SSH_DISCONNECT_AUTH_CANCELLED_BY_USER                 13
		**       SSH_DISCONNECT_NO_MORE_AUTH_METHODS_AVAILABLE         14
		**       SSH_DISCONNECT_ILLEGAL_USER_NAME                      15
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE disconnectcode_assign		&& Assign method used to hold a reference to the SSH DisconnectCode property.
		*==============================================================================
		* Method:            DisconnectCode_Assign
		* Purpose:           Assign method used to hold a reference to the DisconnectCode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the DisconnectCode property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

