	PROCEDURE writefile		&& Convenience method to write an entire byte array to a file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            WriteFile
		* Purpose:           Convenience method to write an entire byte array to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to be written.
		*                    tqFileData -- the file data to write.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Convenience method to write an entire byte array to a file.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFileName AS Character, tqFileData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.WriteFile(m.tcFileName, m.tqFileData) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE xtssetdataunitnumber		&& Introduced in version 9.5.0.91. Sets the XTS-AES mode data unit number. The data unit number is a 64-bit unsigned integer. It is passed in as two 32-bit unsigned integers representing the high and low 32-bits.
		*==============================================================================
		* Method:            XTSSetDataUnitNumber
		* Purpose:           Sets the XTS-AES mode data unit number.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        ti32Bit1 -- the first 32 bit integer.
		*                    ti32Bit2 -- the second 32 bit integer.
		* Returns:           
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		**
		** Sets the XTS-AES mode data unit number. 
		** The data unit number is a 64-bit unsigned integer. 
		** It is passed in as two 32-bit unsigned integers representing the high and low 32-bits.
		**
		** Setting the data unit number is one way of setting the tweak value. 
		** The tweak value is 16 bytes in length and can alternatively 
		** be set by calling XtsSetEncodedTweakValue.
		** 
		** This method sets the tweak value such that the first 8 bytes 
		** are composed of the little-endian 64-bit data unit number, followed by 8 zero bytes.
		** 
		** (Unfortunately, Chilkat cannot use 64-bit integers in method arguments 
		** because many older programming environments, such as ActiveX, do not support it. 
		** Chilkat must present an identical and uniform API across all programming languages.)
		** 
		
		LPARAMETERS ti32Bit1 AS Integer, ti32Bit2 AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 91
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.XTSSetDataUnitNumber(m.ti32Bit1, m.ti32Bit2)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE xtssetencodedtweakkey		&& Introduced in version 9.5.0.91. Sets the XTS-AES mode tweak key from an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", "ascii", or "url".
		*==============================================================================
		* Method:            XTSSetEncodedTweakKey
		* Purpose:           Sets the XTS-AES mode tweak key from an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTweakKey -- the tweak key to set.
		*                    tcEncoding -- the key encoding.
		* Returns:           
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		**
		** Sets the XTS-AES mode tweak key from an encoded string. 
		** The encoding argument can be set to any of the following strings: 
		** "base64", "hex", "quoted-printable", "ascii", or "url". 
		** The tweak key should be equal in size to the encryption key. 
		** For example, to do 256-bit AES-XTS, the encryption key is 256-bits, 
		** and the tweak key is also 256-bits.
		** 
		
		LPARAMETERS tcTweakKey AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, loException AS Exception, ;
