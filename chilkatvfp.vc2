	HIDDEN PROCEDURE passiveusehostaddr_access		&& Access method used to retrieve the Chilkat PassiveUseHostAddr property.
		*==============================================================================
		* Method:            PassiveUseHostAddr_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 PassiveUseHostAddr property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PassiveUseHostAddr
		* Date Added:        02/25/2022
		*==============================================================================
		
		**
		** This can handle problems that may arise when an FTP server is located behind a NAT router. 
		** FTP servers respond to the PASV command by sending the IP address 
		** and port where it will be listening for the data connection. 
		** If the control connection is SSL encrypted, 
		** the NAT router is not able to convert from an internal IP address 
		** (typically beginning with 192.168) to an external address. 
		** When set to 1, PassiveUseHostAddr property tells the FTP client 
		** to discard the IP address part of the PASV response 
		** and replace it with the IP address of the already-established control connection. 
		** The default value of this property is 1.
		**
		** Enhancement for Version 53: Will auto-retry using the opposite 
		** of this property setting in certain situations.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE passiveusehostaddr_assign		&& Assign method used to hold a reference to the PassiveUseHostAddr property.
		*==============================================================================
		* Method:            PassiveUseHostAddr_Assign
		* Purpose:           Assign method used to hold a reference to the PassiveUseHostAddr property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PassiveUseHostAddr property.
		* Returns:           
		* Date Added:        02/25/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

