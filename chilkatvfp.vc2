		*==============================================================================
		
		LPARAMETERS tcPath AS Character, tiFileSize AS Integer, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liFileSize AS Integer, liSkip AS Integer
		
		lcPath = m.tcPath
		liFileSize = m.tiFileSize
		liSkip = m.tiSkip
		
		tcPath = m.lcPath
		tiFileSize = m.liFileSize
		tiSkip = m.liSkip
		
		RETURN m.liSkip
	ENDPROC

