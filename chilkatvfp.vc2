	PROCEDURE unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/23/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE unsubscribe		&& Unsubscribe from an IMAP mailbox. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Unsubscribe
		* Purpose:           Unsubscribe from an IMAP mailbox.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMailBox, the mailbox to unsubscribe.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Unsubscribe from an IMAP mailbox.
		** 
		** Note: The term "mailbox" and "folder" are synonymous. 
		** Whenever the word "mailbox" is used, it has the same meaning as "folder".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMailBox AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.Unsubscribe(m.tcMailBox) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE unsubscribeasync		&& Creates an asynchronous task to call the Unsubscribe method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            UnsubscribeAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    Unsubscribe method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMailBox -- the mailbox to close.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the Unsubscribe method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcMailBox AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.UnsubscribeAsync(m.tcMailBox)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		  
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE usecertvault		&& Introduced in version 9.5.0.40. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*==============================================================================
		* Method:            UseCertVault
		* Purpose:           Adds an XML certificate vault to the object's internal list 
		*                    of sources to be searched for certificates and private keys.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXMLCertVault, a Chilkat XML Certificate Vault object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Adds an XML certificate vault to the object's internal list 
		** of sources to be searched for certificates and private keys 
		** when encrypting/decrypting or signing/verifying. 
		** Unlike the AddPfxSourceData and AddPfxSourceFile methods, only a single XML certificate vault 
		** can be used. If UseCertVault is called multiple times, 
		** only the last certificate vault will be used, 
		** as each call to UseCertVault will replace the certificate vault provided in previous calls.)
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatXMLCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterXmlCertVault AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXmlCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
