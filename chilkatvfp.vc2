	PROCEDURE dirtobeadded		&& This event fires during the AppendFiles and AppendFilesEx method calls. It is called just before each directory is to be added. The skip output-only argument may be set to 1 to prevent the directory and everything it contains from being added.
		*==============================================================================
		* Method:            DirToBeAdded
		* Purpose:           This event fires during the AppendFiles and AppendFilesEx method calls.
		*                    It is called just before each directory is to be added. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the directory to be added.
		*                    tiSkip, the skip setting.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** This event fires during the AppendFiles and AppendFilesEx method calls. 
		** It is called just before each directory is to be added. 
		** The skip output-only argument may be set to 1 to prevent the directory 
		** and everything it contains from being added.
		**
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		*!*  ? [DirToBeAdded Event!]
		*!*  ? [DirToBeAdded: File Path = ] + lcPath + [, Skip = ] + STR(liSkip)
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liSkip = 0
		
		    .DirToBeAdded_Pre(m.lcPath, m.liSkip)
		
		    ** OK to continue test
		    IF m.liSkip = 0
		
		      .DirToBeAdded_Process(m.lcPath, m.liSkip)
		
		      ** OK to continue test
		      IF m.liSkip = 0
		
		        .DirToBeAdded_Post(m.lcPath, m.liSkip)
		
		      ENDIF m.liSkip = 0
		      ** End OK to continue test
		
		    ENDIF m.liSkip = 0
		    ** End OK to continue test
		
		  ENDIF m.liSkip = 0
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN
	ENDPROC

	PROCEDURE dirtobeadded_post		&& Template DirToBeAdded post-processing method.
		*==============================================================================
		* Method:            DirToBeAdded_Post
		* Purpose:           DirToBeAdded post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the directory to be added.
		*                    tiSkip, the skip setting.
		* Returns:           liSkip, the skip setting.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN m.liSkip
	ENDPROC

