	PROCEDURE resetperf		&& Introduced in version 9.5.0.78. Resets the performance measurements for either receiving or sending. If rcvPerf is 1, then the receive performance monitoring is reset. If rcvPerf is 0, then the sending performance monitoring is reset.
		*==============================================================================
		* Method:            ResetPerf
		* Purpose:           Resets the performance measurements for either receiving or sending.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuUnsigned -- whether or not the byte is signed or not.
		* Returns:           
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.78
		**
		** Resets the performance measurements for either receiving or sending. 
		** If rcvPerf is 1, then the receive performance monitoring is reset. 
		** If rcvPerf is 0, then the sending performance monitoring is reset.
		**
		
		LPARAMETERS tuPerformanceReset AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liPerformanceReset AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liPerformanceReset
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 78
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liPerformanceReset = .LogicalToBit(m.tuPerformanceReset)
		
		      TRY
		
		        m.loChilkatObject.ResetPerf(m.liPerformanceReset)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE selectforreading		&& Waits a maximum of timeoutMs milliseconds. If maxWaitMs = 0, then it is effectively a poll. Returns the number of sockets with data available for reading. If no sockets have data available for reading, then a value of 0 is returned.
		*==============================================================================
		* Method:            SelectForReading
		* Purpose:           Wait for data to arrive on this socket, or any of 
		*                    the contained sockets if the caller is a "socket set".
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiTimeoutMs -- the millisecond timeout value.
		* Returns:           The number of sockets with data available for reading.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** Wait for data to arrive on this socket, or any of the contained sockets 
		** if the caller is a "socket set". (If the socket is a listener socket, 
		** then waits for an incoming connect. Listener sockets can be added to the "socket set" 
		** just like connected sockets.)
		** 
		** (see the example at the link below for more detailed information)
		** 
		** Waits a maximum of timeoutMs milliseconds. If maxWaitMs = 0, then it is effectively a poll. 
		** Returns the number of sockets with data available for reading. 
		** If no sockets have data available for reading, then a value of 0 is returned. 
		** A value of -1 indicates an error condition. 
		** Note: when the remote peer (in this case the web server) disconnects, 
		** the socket will appear as if it has data available. 
		** A "ready" socket is one where either data is available for reading 
		** or the socket has become disconnected.
		** 
		** If the peer closed the connection, it will not be discovered until an attempt is made 
		** to read the socket. If the read fails, then the IsConnected property may be checked 
		** to see if the connection was closed.
		**
		
		LPARAMETERS tiTimeoutMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liSockets AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liSockets = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liSockets = m.loChilkatObject.SelectForReading(m.tiTimeoutMs)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liSockets
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE selectforreadingasync		&& Creates an asynchronous task to call the SelectForReading method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
