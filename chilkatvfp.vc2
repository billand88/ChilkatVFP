	PROCEDURE addrelateddata		&& Adds the memory data as a related item to the email and returns the Content-ID. Emails formatted in HTML can include images with this call and internally reference the image through a "cid"hyperlink. (Chilkat Email.NET fully supports the MHTML standard.)
		*==============================================================================
		* Method:            AddRelatedData
		* Purpose:           Adds the memory data as a related item 
		*                    to the email and returns the Content-ID.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the attachment file name.
		*                    tuContent -- the (variable) content.
		* Returns:           Content-ID if successful.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds the memory data as a related item to the email and returns the Content-ID. 
		** Emails formatted in HTML can include images with this call 
		** and internally reference the image through a "cid"hyperlink. 
		** (Chilkat Email.NET fully supports the MHTML standard.)
		**
		** Fixed for Version 44: The 1st argument to this method is the pathInHtml argument. 
		** The MIME related item’s Content-Location header was being set 
		** to only the filename part of the path, and not the entire path.
		**
		** Fixed for Version 46: Minor fix to suppress the unintentional creation 
		** of an empty plain-text body in the MIME in some circumstances 
		** (which is usually harmless).
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character, tuContent AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcContentID AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcContentID = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcContentID = m.loChilkatObject.AddRelatedData(m.tcFileName, m.tuContent)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcContentID
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addrelateddata2		&& Adds a related item to the email from in-memory byte data. Related items are things such as images and style sheets that are embedded within an HTML email.
		*==============================================================================
		* Method:            AddRelatedData2
		* Purpose:           Adds a related item to the email from in-memory byte data. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuContent -- the (variable) content.
		*                    tcFileNameInHTML -- filename used in the HTML img tag's src attribute
		* Returns:           Content-ID if successful.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds a related item to the email from in-memory byte data. 
		** Related items are things such as images and style sheets that are embedded within an HTML email. 
		** They are not considered attachments because their sole purpose is to participate in the display of the HTML. 
		** This method differs from AddRelatedData in that it does not use or return a Content-ID. 
		** The filename argument should be set to the filename used 
		** in the HTML img tag's src attribute (if it's an image), 
		** or the URL referenced in an HTML link tag for a stylesheet.
		**
		** Fixed for Version 46: Minor fix to suppress the unintentional creation 
		** of an empty plain-text body in the MIME in some circumstances 
		** (which is usually harmless).
		**
		
		LPARAMETERS tuContent AS Unknown, tcFileNameInHTML AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      m.loChilkatObject.AddRelatedData2(m.tuContent, m.tcFileNameInHTML)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

