	PROCEDURE sort		&& Introduced in version 9.5.0.79. Sorts the files and sub-directories in ascending or descending order based on the field. Possible values for field are "filename", "filenameNoCase", "lastModifiedTime", "lastAccessTime", "lastCreateTime", or "size".
		*==============================================================================
		* Method:            Sort
		* Purpose:           Sorts the files and sub-directories in ascending 
		*                    or descending order based on the field.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcField, the field sort to implement.
		* Returns:           lcFileName, the file name.
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.79
		**
		** Sorts the files and sub-directories in ascending or descending order based on the field. 
		** Possible values for field are "filename", "filenameNoCase", "lastModifiedTime", 
		** "lastAccessTime", "lastCreateTime", or "size". 
		** (For case-insensitive filename sorting, use "filenameNoCase".)
		**
		
		LPARAMETERS tcField AS Character, tuDescending AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SFTPDIR_COM_CALL, ;
		loException AS Exception, liDescending AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liDescending, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 79
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liDescending = .LogicalToBit(m.tuDescending)
		
		      TRY
		
		        m.loChilkatObject.Sort(m.tcField, m.liDescending)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS sftpeventhandler AS ibaseeventhandler OF "chilkatvfp.vcx" 		&& Event Handler for the ChilkatVFP object associated with the SFTP class.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: downloadrate		&& Called periodically with download progress information: The byteCount is the cumulative number of bytes downloaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*m: downloadrate_post		&& DownloadRate post-processing method.
		*m: downloadrate_pre		&& DownloadRate pre-processing method.
		*m: downloadrate_process		&& DownloadRate processing method.
		*m: uploadrate		&& Called periodically with upload progress information: The byteCount is the cumulative number of bytes uploaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*m: uploadrate_post		&& UploadRate post-processing method.
		*m: uploadrate_pre		&& UploadRate pre-processing method.
		*m: uploadrate_process		&& UploadRate processing method.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "sftpeventhandler"
	*</PropValue>
	
	PROCEDURE downloadrate		&& Called periodically with download progress information: The byteCount is the cumulative number of bytes downloaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*==============================================================================
		* Method:            DownloadRate
		* Purpose:           Called periodically with download progress information.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** Called periodically with download progress information: 
		** The byteCount is the cumulative number of bytes downloaded so far. 
		** The bytesPerSec is the current transfer rate in bytes per second.
		**
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount
		liBytesPerSec = m.tiBytesPerSec
		llReturn = .T.
		
		*!*  ? [DownloadRate Event!]
		*!*  ? [DownloadRate: ByteCount = ] + STR(liByteCount) + [, BytesPerSec = ] + STR(liBytesPerSec)
		
		WITH THIS
		
		  llReturn = .DownloadRate_Pre(m.liByteCount, m.liBytesPerSec)
		
		  ** OK to continue test
		  IF m.llReturn 
		
		    llReturn = .DownloadRate_Process(m.liByteCount, m.liBytesPerSec)
		
		    ** OK to continue test
		    IF m.llReturn 
		
		      llReturn = .DownloadRate_Post(m.liByteCount, m.liBytesPerSec)
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		tiByteCount = m.liByteCount
		tiBytesPerSec = m.liBytesPerSec
		
		RETURN
	ENDPROC

	PROCEDURE downloadrate_post		&& DownloadRate post-processing method.
		*==============================================================================
		* Method:            DownloadRate_Post
		* Purpose:           DownloadRate post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE downloadrate_pre		&& DownloadRate pre-processing method.
		*==============================================================================
		* Method:            DownloadRate_Pre
		* Purpose:           DownloadRate pre-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE downloadrate_process		&& DownloadRate processing method.
		*==============================================================================
		* Method:            DownloadRate_Process
		* Purpose:           DownloadRate processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE uploadrate		&& Called periodically with upload progress information: The byteCount is the cumulative number of bytes uploaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*==============================================================================
		* Method:            UploadRate
		* Purpose:           Called periodically with upload progress information.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes uploaded.
		*                    tiBytesPerSec, the uploaded bytes per second.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** Called periodically with upload progress information: 
		** The byteCount is the cumulative number of bytes Uploaded so far. 
		** The bytesPerSec is the current transfer rate in bytes per second.
		**
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount
		liBytesPerSec = m.tiBytesPerSec
		llReturn = .T.
		
		*!*  ? [UploadRate Event!]
		*!*  ? [UploadRate: ByteCount = ] + STR(liByteCount) + [, BytesPerSec = ] + STR(liBytesPerSec)
		
		WITH THIS
		
		  llReturn = .UploadRate_Pre(m.liByteCount, m.liBytesPerSec)
		
		  ** OK to continue test
		  IF m.llReturn 
		
		    llReturn = .UploadRate_Process(m.liByteCount, m.liBytesPerSec)
		
		    ** OK to continue test
		    IF m.llReturn 
		
		      llReturn = .UploadRate_Post(m.liByteCount, m.liBytesPerSec)
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		tiByteCount = m.liByteCount
		tiBytesPerSec = m.liBytesPerSec
		
		RETURN
	ENDPROC

	PROCEDURE uploadrate_post		&& UploadRate post-processing method.
		*==============================================================================
		* Method:            UploadRate_Post
		* Purpose:           UploadRate post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes uploaded.
		*                    tiBytesPerSec, the uploaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE uploadrate_pre		&& UploadRate pre-processing method.
		*==============================================================================
		* Method:            UploadRate_Pre
		* Purpose:           UploadRate pre-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes uploaded.
		*                    tiBytesPerSec, the uploaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE uploadrate_process		&& UploadRate processing method.
		*==============================================================================
		* Method:            UploadRate_Process
		* Purpose:           UploadRate processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes uploaded.
		*                    tiBytesPerSec, the uploaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

ENDDEFINE

DEFINE CLASS sftpfile AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a remote SFTP file.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: createtimestr_access		&& Access method used to retrieve the Chilkat SFtpFile CreateTimeStr property.
		*m: createtimestr_assign		&& Assign method used to hold a reference to the CreateTimeStr property.
		*m: createtime_access		&& Access method used to retrieve the Chilkat SFtpFile CreateTime property.
		*m: createtime_assign		&& Assign method used to hold a reference to the CreateTime property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SFTPFile DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: filename_access		&& Access method used to retrieve the Chilkat SFtpFile FileName property.
		*m: filename_assign		&& Assign method used to hold a reference to the FileName property.
		*m: filetype_access		&& Access method used to retrieve the Chilkat SFtpFile FileType property.
		*m: filetype_assign		&& Assign method used to hold a reference to the FileType property.
		*m: getcreatedt		&& Returns the file creation date and time (GMT / UTC). This method is only supported by servers running SFTP v4 or later. Returns Nothing on failure
		*m: getlastaccessdt		&& Returns the last-access date and time (GMT / UTC). Returns Nothing on failure
		*m: getlastmodifieddt		&& Returns the last-modified date and time (GMT / UTC). Returns Nothing on failure
		*m: gid_access		&& Access method used to retrieve the Chilkat SFtpFile gID property.
		*m: gid_assign		&& Assign method used to hold a reference to the gID property.
		*m: group_access		&& Access method used to retrieve the Chilkat SFtpFile Group property.
		*m: group_assign		&& Assign method used to hold a reference to the Group property.
		*m: isappendonly_access		&& Access method used to retrieve the Chilkat SFtpFile IsAppend property.
		*m: isappendonly_assign		&& Assign method used to hold a reference to the IsAppend property.
		*m: isarchive_access		&& Access method used to retrieve the Chilkat SFtpFile IsArchive property.
		*m: isarchive_assign		&& Assign method used to hold a reference to the IsArchive property.
		*m: iscaseinsensitive_access		&& Access method used to retrieve the Chilkat SFtpFile IsCaseInsensitive property.
		*m: iscaseinsensitive_assign		&& Assign method used to hold a reference to the IsCaseInsenitive property.
		*m: iscompressed_access		&& Access method used to retrieve the Chilkat SFtpFile IsCompressed property.
		*m: iscompressed_assign		&& Assign method used to hold a reference to the IsCompressed property.
		*m: isdirectory_access		&& Access method used to retrieve the Chilkat SFtpFile IsDirectory property.
		*m: isdirectory_assign		&& Assign method used to hold a reference to the IsDirectory property.
		*m: isencrypted_access		&& Access method used to retrieve the Chilkat SFtpFile IsEncrypted property.
		*m: isencrypted_assign		&& Assign method used to hold a reference to the IsEncrypted property.
		*m: ishidden_access		&& Access method used to retrieve the Chilkat SFtpFile IsHidden property.
		*m: ishidden_assign		&& Assign method used to hold a reference to the IsHidden property.
		*m: isimmutable_access		&& Access method used to retrieve the Chilkat SFtpFile IsImmutable property.
		*m: isimmutable_assign		&& Assign method used to hold a reference to the IsImmutable property.
		*m: isreadonly_access		&& Access method used to retrieve the Chilkat SFtpFile IsReadOnly property.
		*m: isreadonly_assign		&& Assign method used to hold a reference to the IsReadOnly property.
		*m: isregular_access		&& Access method used to retrieve the Chilkat SFtpFile IsRegular property.
		*m: isregular_assign		&& Assign method used to hold a reference to the IsRegular property.
		*m: issparse_access		&& Access method used to retrieve the Chilkat SFtpFile IsSparse property.
		*m: issparse_assign		&& Assign method used to hold a reference to the IsSparse property.
		*m: issymlink_access		&& Access method used to retrieve the Chilkat SFtpFile IsSymLink property.
		*m: issymlink_assign		&& Assign method used to hold a reference to the IsSymLink property.
		*m: issync_access		&& Access method used to retrieve the Chilkat SFtpFile IsSync property.
		*m: issync_assign		&& Assign method used to hold a reference to the IsSync property.
		*m: issystem_access		&& Access method used to retrieve the Chilkat SFtpFile IsSystem property.
		*m: issystem_assign		&& Assign method used to hold a reference to the IsSystem property.
		*m: lastaccesstimestr_access		&& Access method used to retrieve the Chilkat SFtpFile LastAccessTimeStr property.
		*m: lastaccesstimestr_assign		&& Assign method used to hold a reference to the LastAccessTimeStr property.
		*m: lastaccesstime_access		&& Access method used to retrieve the Chilkat SFtpFile LastAccessTime property.
		*m: lastaccesstime_assign		&& Assign method used to hold a reference to the LastAccessTime property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SFtpFile LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SFtpFile LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastmodifiedtimestr_access		&& Access method used to retrieve the Chilkat SFtpFile LastModifiedTimeStr property.
		*m: lastmodifiedtimestr_assign		&& Assign method used to hold a reference to the LastModifiedTimeStr property.
		*m: lastmodifiedtime_access		&& Access method used to retrieve the Chilkat SFtpFile LastModifiedTime property.
		*m: lastmodifiedtime_assign		&& Assign method used to hold a reference to the LastModifiedTime property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SFtpFile LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SFtpFile LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: owner_access		&& Access method used to retrieve the Chilkat SFtpFile Owner property.
		*m: owner_assign		&& Assign method used to hold a reference to the Owner property.
		*m: permissions_access		&& Access method used to retrieve the Chilkat SFtpFile Permissions property.
		*m: permissions_assign		&& Assign method used to hold a reference to the Permissions property.
		*m: size32_access		&& Access method used to retrieve the Chilkat SFtpFile Size property.
		*m: size32_assign		&& Assign method used to hold a reference to the Size property.
		*m: sizestr_access		&& Access method used to retrieve the Chilkat SFtpFile SizeStr property.
		*m: sizestr_assign		&& Assign method used to hold a reference to the SizeStr property.
		*m: uid_access		&& Access method used to retrieve the Chilkat SFtpFile UID property.
		*m: uid_assign		&& Assign method used to hold a reference to the UID property.
		*p: createtime		&& Undocumented property! Returns a datetime value, assumed to be the file creation time.
		*p: createtimestr		&& The same as the CreateTime property, but returns the date/time as an RFC822 formatted string.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: filename		&& The filename (or directory name, symbolic link name, etc.)
		*p: filetype		&& One of the following values: regular, directory, symLink, special, unknown, socket, charDevice, blockDevice, fifo.
		*p: gid		&& The integer Group ID of the file.
		*p: group		&& The group ownership of the file. This property is only supported by servers running SFTP v4 or later.
		*p: isappendonly		&& If 1, this file may only be appended. This property is only supported by servers running SFTP v6 or later.
		*p: isarchive		&& If 1, the file should be included in backup / archive operations. This property is only supported by servers running SFTP v6 or later.
		*p: iscaseinsensitive		&& This attribute applies only to directories. This attribute means that files and directory names in this directory should be compared without regard to case. This property is only supported by servers running SFTP v6 or later.
		*p: iscompressed		&& The file is stored on disk using file-system level transparent compression. This flag does not affect the file data on the wire. This property is only supported by servers running SFTP v6 or later.
		*p: isdirectory		&& If 1, this is a directory.
		*p: isencrypted		&& The file is stored on disk using file-system level transparent encryption. This flag does not affect the file data on the wire (for either READ or WRITE requests.) This property is only supported by servers running SFTP v6 or later.
		*p: ishidden		&& If 1, the file SHOULD NOT be shown to user unless specifically requested.
		*p: isimmutable		&& The file cannot be deleted or renamed, no hard link can be created to this file, and no data can be written to the file. This bit implies a stronger level of protection than ReadOnly, the file permission mask or ACLs.
		*p: isreadonly		&& If 1, the file is read-only. This property is only supported by servers running SFTP v6 or later.
		*p: isregular		&& 1 if this is a normal file (not a directory or any of the other non-file types).
		*p: issparse		&& The file is a sparse file; this means that file blocks that have not been explicitly written are not stored on disk.
		*p: issymlink		&& 1 if this is a symbolic link.
		*p: issync		&& When the file is modified, the changes are written synchronously to the disk. This property is only supported by servers running SFTP v6 or later.
		*p: issystem		&& 1 if the file is part of the operating system. This property is only supported by servers running SFTP v6 or later.
		*p: lastaccesstime		&& Undocumented property! Returns a datetime value, assumed to be the last file access time.
		*p: lastaccesstimestr		&& The same as the LastAccessTime property, but returns the date/time as an RFC822 formatted string.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: lastmodifiedtime		&& Undocumented property!  Returns a datetime value, assumed to be the last modified time.
		*p: lastmodifiedtimestr		&& The same as the LastModifiedTime property, but returns the date/time as an RFC822 formatted string.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: owner		&& The owner of the file. This property is only supported by servers running SFTP v4 or later.
		*p: permissions		&& The 'permissions' field contains a bit mask specifying file permissions. These permissions correspond to the st_mode field of the stat structure defined by POSIX [IEEE.1003-1.1996].
		*p: size32		&& Size of the file in bytes. If the size is too large for 32-bits, a -1 is returned.
		*p: sizestr		&& Same as Size64, but the number is returned as a string in decimal format.
		*p: uid		&& The integer User ID of the file.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = SFtpFile
		createtime = ({/:})
		createtimestr = 
		debuglogfilepath = 
		filename = 
		filetype = regular
		gid = 0
		group = 
		isappendonly = 0
		isarchive = 0
		iscaseinsensitive = 0
		iscompressed = 0
		isdirectory = 0
		isencrypted = 0
		ishidden = 0
		isimmutable = 0
		isreadonly = 0
		isregular = 0
		issparse = 0
		issymlink = 0
		issync = 0
		issystem = 0
		lastaccesstime = ({/:})
		lastaccesstimestr = 
		lastbinaryresult = .NULL.
		lastmethodsuccess = 1
		lastmodifiedtime = ({/:})
		lastmodifiedtimestr = 
		laststringresult = 
		laststringresultlen = 0
		Name = "sftpfile"
		owner = 
		permissions = 0
		size32 = 0
		sizestr = 
		uid = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/07/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Decremented the GetCreateDt, GetLastAccessDt and GetLastModifiedDt methods.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
