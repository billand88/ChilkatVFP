	PROCEDURE regexmatch		&& Introduced in version 11.1.0. Searches the content of this object for substrings that match a regular expression pattern and returns the matches in json. Returns the number of matches or -1 for failure.
		*==============================================================================
		* Method:            RegExMatch
		* Purpose:           Searches the content of this object for substrings 
		*                    that match a regular expression pattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPattern, the pattern to match.
		*                    toChilkatJSONObject, a Chilkat JSON object.
		*                    tiTimeOutMs, the millisecond timeout value.
		* Returns:           Returns the number of matches, or -1 for failure.
		* Date Added:        07/31/2025
		*==============================================================================
		
		**
		** Introduced in version 11.1.0
		**
		** Searches the content of this object for substrings that match a regular expression pattern 
		** and returns the matches in json. Returns the number of matches or -1 for failure. 
		** iTimeOutMs is the maximum number of milliseconds of processing allowed before giving up. 
		** Pass 0 for an infinite amount of time. Failure information is also returned in json.
		** 
		
		LPARAMETERS tcPattern AS Character, ;
		toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, tiTimeOutMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		liReturn AS Integer, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		liReturn = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        liReturn = m.loChilkatObject.RegExMatch(;
		        m.tcPattern, m.loChilkatJSONObject, m.tiTimeOutMs)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

