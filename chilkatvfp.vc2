	PROCEDURE loadfile		&& Loads an entire text file into the string object. The character encoding of the text file is specified by charsetEncoding. This method allows for text files in any charset to be loaded: utf-8, Unicode, Shift_JIS, iso-8859-1, etc.
		*==============================================================================
		* Method:            LoadFile
		* Purpose:           Loads an entire text file into the string object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the multi-byte text to load.
		*                    tcEncoding, the character encoding of the file to load.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Loads an entire text file into the string object. 
		** The character encoding of the text file is specified by charsetEncoding. 
		** This method allows for text files in any charset to be loaded: 
		** utf-8, Unicode, Shift_JIS, iso-8859-1, etc.
		**
		** Enhancements for version 73: This method will now recognize Unicode/utf-8 BOMs 
		** and will load files correctly based on the BOM encountered.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		** 
		
		LPARAMETERS tcFilePath AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadFile(m.tcFilePath, m.tcEncoding) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadxmldoc		&& Loads an XML document into the CkString. The xmlDocumentBytes contains the raw bytes of the XML document.
		*==============================================================================
		* Method:            LoadXMLDoc
		* Purpose:           Loads an XML document into the CkString.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqXMLDocBytes, the bytes of the XML document
		* Returns:           
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Loads an XML document into the CkString. 
		** The xmlDocumentBytes contains the raw bytes of the XML document. 
		** The reason for providing a separate method for loading an XML document 
		** is because the charset encoding is usually specified using a "charset" attribute 
		** at the beginning of the XML document. The LoadXmlDoc method reads 
		** just enough of the XML document to get the charset, 
		** and then it knows how to read and interpret the bytes of the entire XML document, 
		** so that the bytes of the characters are properly interpeted 
		** and loaded into the CkString object.
		** 
		
		LPARAMETERS tqXMLDocBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.LoadXMLDoc(m.tqXMLDocBytes)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE matches		&& Returns 1 if the string matches the strPattern, which may contain one or more asterisk wildcard characters. Case-sensitivity is controlled by , where 1 = case sensitive, 0 = case insensitive.
		*==============================================================================
		* Method:            Matches
		* Purpose:           Returns 1 if the string matches the strPattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcStringPattern, the pattern to search for matches
		*                    tuCaseSensitive, whether or not the search is case sensitive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Returns 1 if the string matches the strPattern, which may contain 
		** one or more asterisk wildcard characters. Case-sensitivity is controlled by caseSensitive, 
		** where 1 = case sensitive, 0 = case insensitive.
		** 
		
		LPARAMETERS tcStringPattern AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liCaseSensitive AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    TRY
		
		      STORE m.loChilkatObject.Matches(m.tcStringPattern, m.liCaseSensitive) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE mid		&& Same as the VB/VBScript "Mid" function, except that the 1st char is at index 0 (i.e. it is not 1-based). Returns a substring of length numChars starting at index. Returns Nothing on failure.
		*==============================================================================
		* Method:            Mid
		* Purpose:           Same as the VB/VBScript "Mid" function, 
		*                    except that the 1st char is at index 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the Nth character to start the string to retieve.
		*                    tiNumCharacters, the number of characters to retrieve.
		* Returns:           A substring of length numChars starting at index.
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Same as the VB/VBScript "Mid" function, except that the 1st char is at index 0 
		** (i.e. it is not 1-based). Returns a substring of length numChars starting at index.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiIndex AS Integer, tiNumCharacters AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, lcString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcString = m.loChilkatObject.Mid(m.tiIndex, m.tiNumCharacters)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE numarabic_access		&& Access method used to retrieve the Chilkat CkString NumArabic property.
		*==============================================================================
		* Method:            NumArabic_Access
		* Purpose:           Access method used to retrieve the Chilkat CkString NumArabic property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
