	HIDDEN PROCEDURE body_access		&& Access method used to retrieve the Chilkat Email Body property.
		*==============================================================================
		* Method:            Body_Access
		* Purpose:           Access method used to retrieve the Chilkat Email Body property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Body
		* Date Added:        01/21/2022
		*==============================================================================
		
		** 
		** The body of the email. If the email has both HTML and plain-text bodies, 
		** this property returns the HTML body. 
		** The GetHtmlBody and GetPlainTextBody methods can be used to access a specific body. 
		** The HasHtmlBody and HasPlainTextBody methods can be used to determine the presence of a body.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE body_assign		&& Assign method used to hold a reference to the Body property.
		*==============================================================================
		* Method:            Body_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Email Body property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Body property.
		* Returns:           
		* Date Added:        01/21/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE bounceaddress_access		&& Access method used to retrieve the Chilkat Email BounceAddress property.
		*==============================================================================
		* Method:            BounceAddress_Access
		* Purpose:           Access method used to retrieve the Chilkat Email BounceAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BounceAddress
		* Date Added:        01/21/2022
		*==============================================================================
		
		** 
		** The "return-path" address of the email to be used when the email is sent. 
		** Bounces (i.e. delivery status notifications, or DSN's) will go to this address.
		** Note: This is not the content of the "return-path" header for emails that are 
		** downloaded from a POP3 or IMAP server. 
		** The BounceAddress is the email address to be used in the process of sending the email via SMTP. 
		** (See the "SMTP Protocol in a Nutshell" link below.) 
		** The BounceAddress is the email address passed in the "MAIL FROM" 
		** SMTP command which becomes the "return-path" header in the email when received.
		**
		** Note: The Sender and BounceAddress properties are identical and perform the same function. 
		** Setting the Sender property also sets the BounceAddress property, and vice-versa. 
		** The reason for the duplication is that BounceAddress existed first, 
		** and developers typically searched for a "Sender" property 
		** without realizing that the BounceAddress property served this function.
		**
		** Fixed for Version 54: Setting the From property *after* setting this property 
		** would have the side-effect of overwriting this property.
		**
		** Update to Version 11.0.0: Property decremented.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE bounceaddress_assign		&& Assign method used to hold a reference to the BounceAddress property.
		*==============================================================================
		* Method:            BounceAddress_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Email BounceAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the BounceAddress property.
		* Returns:           
		* Date Added:        01/21/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character, ;
		llImplemented AS Logical
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 41
		
		llImplemented = .F.
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		WITH THIS
		
		  .CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		  llImplemented = ;
		  .IsPEMImplemented(la_IntroducedInBuild[1], la_IntroducedInBuild[2], la_IntroducedInBuild[3])
		
		  ** Property implemented test
		  IF m.llImplemented
		
		    .Sender = .BounceAddress
		
		  ENDIF m.llImplemented
		  ** Property implemented test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE charset_access		&& Access method used to retrieve the Chilkat Email Charset property.
		*==============================================================================
		* Method:            Charset_Access
		* Purpose:           Access method used to retrieve the Chilkat Email Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Charset
		* Date Added:        01/21/2022
		*==============================================================================
		
		** 
		** Sets the charset for the entire email. 
		** The header fields and plain-text/HTML bodies will be converted and sent in this charset. 
		** (This includes parsing and updating the HTML with the appropriate META tag specifying the charset.) 
		** All formatting and encoding of the email MIME is handled automatically by the Chilkat Mail component. 
		** If your application wants to send a Shift_JIS email, 
		** you simply set the Charset property to "Shift_JIS". 
		** Note: If a charset property is not explicitly set, 
		** the Chilkat component automatically detects the charset and chooses the appropriate charset. 
		** If all characters are 7bit (i.e. us-ascii) the charset is left blank. 
		** If the email contain a mix of languages such that no one charset can be chosen, 
		** or if the language cannot be determined without ambiguity, then the "utf-8" charset will be chosen.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE charset_assign		&& Assign method used to hold a reference to the Charset property.
		*==============================================================================
		* Method:            Charset_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Email Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Charset property.
		* Returns:           
		* Date Added:        01/21/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.4.0
		
		  aes-gcm / smime-type=”authEnveloped-data” — When the Pkcs7CryptAlg property is set to aes-gcm, 
		  the encrypted email should use the Content-Type header smime-type=authEnveloped-data 
		  rather than smime-type=enveloped-data. This issue has been fixed.
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 11.0.0
		
		  Removed the Sender property.
		
		  BouncedAddress property is now decremented.
		
		  Added the AddPfxSourceBd, GetAttachmentEmail, GetDigestEmail, GetDsnInfo, 
		  LastDecryptCert, LastSignerCert, LinkedDomains, MakeCopy, SetBodyBd, 
		  ToDsn, ToForward, ToMdn and ToReply methods.
		
		  Decremented the Clone, CreateDsn, CreateForward, CreateMdn, CreateReply, 
		  FindIssuer, GetAttachedMessage, GetDigest, GetDSNFinalRecipients, GetDt, 
		  GetEncrypt, GetEncryptedByCert, GetLinkedDomains, GetSignedByCert, 
		  GetSignedByCertChain and GetSigningCert methods.
		
		** Version 10.1.3
		
		  Fixed a problem relating to quoted-printable FROM names in the email MIME header. 
		  This was a problem introduced in v10.1.2 and resolved in 10.1.3.
		
		** Version 10.1.2
		
		  Added the ability to get the HTML email body with all related images embedded directly within the HTML. 
		  This makes it possible to view the HTML in an embedded browser because there are no external images referenced. 
		  The GetHtmlBodySb method was added to accomplish this. It includes a boolean argument 
		  to indicate whether image data should be embedded as base64 within the HTML.
		
		** Version 10.1
		
		  Email.FromName: Fixed a parsing problem that happened 
		  when the Email.FromName property is set to a string that contains a comma character.
		  
		  Fixed a problem having to do with recognizing related images in poorly formatted/structured email MIME.
		
		** Version 10.0
		
		  Added the GetRelatedHeader method.
		
		  Added the ability to provide a list of email addresses in the ReplyTo property.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 98
		
		  Chilkat will now automatically use the quoted-printable Content-Transfer-Encoding 
		  (if the application hasn’t explicitly set a Content-Transfer-Encoding) 
		  for HTML bodies that have line lengths > 2000 chars, which caused problems 
		  with some mail servers.
		
		** Version 96
		
		  If the file path passed to AddFileAttachment or AddRelatedFile contained both forward and backward slashes,
		  then the filename part of the path, which is what appears in the “filename” attribute
		  within the MIME sub-header, could include part of the file path. This was fixed.
		
		** Version 95
		
		  Fixed a rare problem where an email should’ve been decoded as iso-8859-7,
		  but was thought to be utf-8 (and incorrectly decoded as utf-8)
		  because the string “utf-8” found in the email.
		
		** Version 94
		
		  Fixed problems with Emoji chars when they are used in the email subject
		  or other parts of the email, but only when used in Java because Java requires modified-utf8
		  for passing strings in/out of methods. However, we don’t want modified-utf8 w/ surrogate pairs
		  to be used in the MIME content of an email (when the email uses the utf-8 charset).
		
		  Fixed problems in handling erroneously nested MIME structures
		  (where Chilkat detects very badly MIME nesting having to do with multipart/mixed, multipart/related,
		  and multipart/alternative and Chilkat automatically normalizes according to best practices).
		
		  Fixed issue where an email address contains non-us-ascii chars in the name part of the email address.
		  For example kænnæth@example.com
		
		** Version 91
		
		  Fixed a crash bug (rare) when loading particular encrypted emails (LoadEml method).
		
		** Version 87
		
		  The SetAttachmentFilename method will now also update the “name” attribute
		  of the Content-Type header if it also contains the existing filename.
		
		  Some extremely long header fields (> 998 chars without SPACE chars) did not get folded.
		  These are now folded using “B” encoding.
		
		  Fixed iso-2022-jp encoding issues in Content-Type and Content-Disposition headers.
		
		** Version 84
		
		  Fixed some email address parsing problems — for very rare issues
		  (basically crazy situations that should realistically never occur,
		  but fools exist such that foolproof software is required.)
		
		** Version 80
		
		  Fixed automatic Q/B decoding for email address header fields.
		  Normally, a TO or CC email header may be Q/B encoded such that
		  the friendly-name part is encoded but not the address part.
		  For example: “=?utf-8?B?TWF0dA==?= <support@chilkatsoft.com>”. This was already handled correctly.
		  However, if the entire name+address string, including the quotes around the name part
		  are Q/B encoded, such as like this  “=?utf-8?B?Ik1hdHQiIDxzdXBwb3J0QGNoaWxrYXRzb2Z0LmNvbT4=?=”,
		  then Chilkat returned the entire string as the email address, without decoding.
		  The GetTo, GetToName, GetToAddr, GetCC, GetCcName, and GetCcAddr methods
		  will now return automatically decoded strings for this case.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 78
		
		  Added the ConvertInlineImages method.
		
		** Version 77
		
		  The NumRelatedItems property was 1 too large in some cases.
		
		  CreateReply did not automatically drop attachments in the reply email that is returned.
		
		** Version 76
		
		  Added the Clear method, so that an email object can be restored to its initial pristine state.
		  (The Clear method was not previously available because it’s also easy
		  to simply instantiate a new email object rather than try to re-use an existing object.)
		
		  Text attachments using the utf-16 encoding WITH a preamble (i.e. byte order mark)
		  would inadvertently get converted to utf-8. This no longer happens.
		
		  Fixed – the AddiCalendarAlternativeBody method did not write the method name in the content-type.
		
		** Version 75
		
		  Added the ability to open .pfx/.p12 files where two different passwords are required:
		  one for integrity and the other for the private keys.
		  See the example at https://www.example-code.com/csharp/pfx_multiple_passwords.asp
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		  Fixed a problem with the SetSigningCert and SetSigningCert2 methods.
		
		** Version 73
		
		  The SetHtmlBody method, in certain circumstances,  would incorrectly set
		  the top-level MIME header to text/html for multipart messages. This was fixed.
		
		  Fixed: The “micalg” attribute incorrectly remained in the Content-Type header field
		  for the encrypted MIME part when the email is also signed.
		
		  Added flexibility in parsing non-compliant RFC822 date strings,
		  where the month name and month day number are not in the correct order as specified by RFC822.
		
		  Added more internal flexibility for handling mixtures of CRLF and bare-LF line endings.
		
		  Fixed certain automatic MIME structuring issues w.r.t. multipart/alternative and multipart/related.
		
		** Version 72
		
		  Encrypting 0 bytes for block cipher algorithms with padding
		  now results in one block of output, rather than 0 bytes.
		  (Decrypting the 16-byte block will return the original 0 bytes.)
		  This only applies to block ciphers operating in modes such as ECB, CBC, etc.
		  This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		
		** Version 71
		
		  Automatically fixes FROM email addresses to prevent email spoofing
		  as described at https://www.mailsploit.com/index
		
		  Added the OapeMgfHash property to the Email, Crypt2, Mime, and Rsa classes.
		
		  Added a method named ApplyFixups. (Read more about it in the online reference documentation.)
		
		** Version 69
		
		  Fixed an issue with automatically locating pre-installed Windows certificates
		  (for encryption) when the email address stored within the certificate used uppercase letters.
		
		** Version 67
		
		  Added the GetAttachmentBd and GetAlternativeBodyBd methods.
		
		  Added the OaepPadding and OaepHash properties.
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		  Added RSASSA-PSS and RSAES-OAEP capabilities for signed and encrypted email.
		  This was spurred by customer needs to satisfy new requirements in Germany
		  that apparently go into effect on 1-June-2017 regarding email signatures and encryption.
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 66
		
		  Added the Email.NumDigests property, and the Email.GetDigest method.
		
		  Fixed the Email.GetDeliveryStatusInfo method for certain cases
		  where the body of information contained multiple blank lines.
		
		  Fixed Email.AddFileAttachment2 for the case when an attachment is the text/plain Content-Type.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 63
		
		  Added the Email.AddAttachmentBd method.
		
		** Version 62
		
		  Note: One use of BinData and StringBuilder is in use of new methods ending in “Sb” and “Bd”.
		  These methods are for returning or passing text or binary data, especially large amounts of text or data.
		  For example, imagine one Chilkat method is used to retrieve a large amount of data,
		  and then that data is passed to another Chilkat method. A large waste of time and memory is consumed
		  in returning the string (or binary bytes) to the programming language,
		  and then immediately passing it back to Chilkat.
		  If it is .NET, then the data must be marshaled from unmanaged to managed, and then,
		  to pass back to Chilkat it is marshaled from managed to unmanaged.
		  The same applies when using the ActiveX (with BSTR’s and Variants).
		  By retrieving results directly into a BinData or StringBuilder,
		  and then passing the data by passing the object, the data stays on the native side.
		  For example, the new Rest.ReadRespSb method reads the REST response directly in to a StringBuilder.
		  If it is JSON, this can be loaded directly into a JsonObject via the JsonObject.LoadSb.
		  In the future, new “Sb” and “Bd” methods will be added in places
		  where large amounts of data are likely to be encountered.
		  This will create pathways allowing data to stay native as much as possible.
		  Version 9.5.0.62 adds the following initial set of Sb/Bd methods:
		
		    JsonObject.LoadSb
		    JsonObject.EmitSb
		    Xml.LoadSb
		    Xml.GetXmlSb
		
		    Email.GetMimeBd
		    Email.GetMimeSb
		    Email.SetFromMimeSb
		    Email.SetFromMimeBd
		
		    Mime.LoadMimeSb
		    Mime.LoadMimeBd
		    Mime.GetMimeSb
		    Mime.GetMimeBd
		    MailMan.RenderToMimeBd
		    MailMan.RenderToMimeSb
		    Rest.FullRequestSb
		    Rest.ReadRespSb
		    Rest.SendReqSb
		    Rest.SetMultipartBodySb
		    Rest.AddQueryParam
		    Rest.ReadRespBd
		    Rest.SendReqBd
		    Rest.SetMultipartBodyBd
		    Imap.FetchAttachmentSb
		    Imap.FetchAttachmentBd
		    Imap.AppendMimeWithFlagsSb
		    SFtp.UploadSb
		    SFtp.DownloadSb
		    SFtp.UploadBd
		    SFtp.DownloadBd
		    Ftp2.GetFileSb
		    Ftp2.GetFileBd
		
		    Ftp2.PutFileSb
		    Ftp2.PutFileBd
		
		** Version 59
		
		  Fixed Q/B decoding issue for address related headers.
		  The SPACE char between the friendly name and the email address was dropped when Q/B decoding.
		
		  Eliminated problems arising from X.400 email addresses where there is no “@” character.
		
		  Fixed email structure problems for certain situations when SetHtmlBody was called.
		
		  The ComputeGlobalKey method was decremented and should not be used.
		  The inputs to the MD5 hash algorithm were not properly canonicalized,
		  and therefore the computed key could change from version to version
		  (based on fixes, improvements, etc. in the MIME processing).
		
		  Added the ComputeGlobalKey2 method, which is properly canonicalized 
		  to avoid the issues of the original ComputeGlobalKey implementation.
		
		  Fixed problems where the values in address related header fields were not returned Q/B decoded.
		  (For example, the value returned by the GetHeaderField method should be Q/B decoded.)
		
		  Fixed GetSignedByCert so that it will still return the certificate even if the signature validation fails.
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Fixed problems with comma characters found in email addresses that are Q/B encoded.
		
		  (FIXED) Comma characters embedded in an email address friendly name,
		  such as “Doug, Smith ” would interfere with the parsing of the email address.
		
		  (FIXED) The ActiveX LoadTaskResult methods always returned 0,
		  regardless of success/failure.
		
		  Fixed issues having to do with structuring an email with multipart/related, multipart/alternative, etc.
		
		** Version 56
		
		  Very rare crash bug fixed.
		
		  Fixed: If only the FromName property was set (and not the FromAddress property, nor the “From” property,
		  then the FromName was getting lost when generating the MIME, such as by calling GetMime.
		  This was because technically the email address is still incomplete/invalid.
		
		  Fixed: Emails that have address of the format “CN=abc/O=abc” are not altered in any way.
		  An email address can have any form (not just the standard name@address form).
		
		  Workaround for uuencoded email bodies where the uuencoding starts with a “begin …” line.
		
		  The default value of the Pkcs7CryptAlg was changed from “RC2” to “AES”.
		
		  Fixed a SetHtmlBody problem.
		  See http://www.chilkatforum.com/questions/9536/change-html-body-in-a-multipartrelated-mail
		
		** Version 55
		
		  Email.SaveXml did not save BCC recipients.
		
		  Fixed: When a new email is created, if an attachment is first added prior to calling SetHtmlBody,
		  the resultant email did not have the correct MIME structure.
		
		** Version 54
		
		  Fixed: Setting the Email.From property *after* setting the Email.BounceAddress property
		  would have the side-effect of overwriting the BounceAddress property.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Fixed: The Email.GetTo method returned Q/B encoded (if 8bit)
		  instead of automatically decoding (as was the behavior in prior versions).
		
		  Added the LastMethodSuccess property.
		
		** Version 49
		
		  The From property returned the name part undecoded if Q/B encoding was present.
		
		  UnpackUseRelPaths was ignored for Email.UnpackHtml and Mht.UnpackHtml.
		  It was always unpacked to relative paths. (The Email.AspUnpack methods,
		  however, must always have relative paths in the URLs within the HTML.)
		
		  Fixed the ApUnpack and AspUnpackk2 methods.
		
		  The internal automatic retry from EHLO to HELO did not work.
		  If the SMTP server did not support EHLO, then EHLO
		  was mistakenly tried a 2nd time instead of HELO.
		
		** Version 48
		
		  Improved performance through the automatic (internal) use of pipelining.
		
		  The AddMultipleCC method added each email address twice.
		  This was a bug introduced in v9.5.0.47 and fixed in this version (9.5.0.48).
		
		  The GetAttachedMessageFilename and GetAttachedMessageAttr methods
		  always returned info for index 0, regardless of the index passed in by the app.
		
		  The LoadEml method will automatically ignore the leading “From …” line
		  that might exist if the file was an email saved in Mbox format.
		
		  Email.AddStringAttachment2 can specify a charset prepened with “bom-” or “no-bom-”
		  to include or exclude the BOM for charsets such utf-8 or ucs-2 / utf-16.
		
		  Fixed problem when setting the FileDistList equal to the empty string
		  (which should simply clear the property, but instead cause an error in the call to SendEmail).
		
		  Bare CR’s or LF’s in quoted-printable/Base64 email bodies (non-encoded) auto-converted to CRLF
		  (for compliance to RFC 2822). This does NOT change the actual content of the email bodies.
		
		  (Internal MIME parsing fix.) When an email is received that uses star-encoding,
		  if a single char was multi-byte and the bytes were split across two lines, then Chilkat did not decode properly.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		** Version 46
		
		  The AddRelatedFile2 and other AddRelated* methods had a minor fix
		  to suppress the unintentional creation of an empty plain-text body
		  in the MIME in some circumstances (which is usually harmless).
		
		** Version 44
		
		  New: Chilkat.Email (CkEmail) methods: GetNumPartsOfType,
		  GetNthTextPartOfType, SetBinaryBody, GetNthBinaryPartOfType
		
		  Fix: The 1st argument to email.AddRelatedData is the pathInHtml argument.
		  The MIME related item’s Content-Location header was being set
		  to only the filename part of the path, and not the entire path.
		
		** Version 41
		
		  Fixes relating to the use of the hz-gb-2312 charset in email and MIME.
		
		  Added the following methods to the Email object for the purpose
		  of getting header field attributes from sub-headers within an email:
		  GetAttachmentAttr, GetRelatedAttr, and GetAttachedMessageAttr
		
		  Added the Email.Sender property.
		  The Sender and BounceAddress properties are identical and perform the same function.
		  Setting the Sender property also sets the BounceAddress property, and vice-versa.
		  The reason for the duplication is that BounceAddress existed first,
		  and developers typically searched for a “Sender” property
		  without realizing that the BounceAddress property served this function.
		
		** Version 40
		
		  Fixed SendEmail when the email object’s FileDistList property is used.
		
		  Fixed problem with saving email attachments where the filename ends in .txt.gz,
		  but the Content-Type for the attachment within the email indicated “text/plain”.
		
		  Review the online reference documentation for new methods or properties
		  for Ftp2, TrustedRoots, Rsa, Mime, Cert, Email, Imap, MailMan, Crypt2,
		  Http, Zip, Pfx, XmlCertVault, CertChain, and Upload.
		  New entries are clearly marked by the version in which they are introduced.
		
		** Version 28
		
		  Added the Email.SetEdifactBody method to make it easier to create EDIFACT emails.
		
		** Version 24
		
		  Chilkat’s “Q”/”B” internal decoding methods did not recognize the name “Cp1252”.
		  The usage of the name “Cp1252” is very rarely encountered in Q/B encodings for email.
		  Usuallly the name used is “windows-1252” or the almost-equivalent “iso-8859-1”.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE clear		&& Introduced in version 9.5.0.76. Clears the email object of all information to the state as if the object was just created, which will have default headers such as Mime-Version, Date, Message-ID, Content-Type, Content-Transfer-Encoding, and X-Priority.
		*==============================================================================
		* Method:            Clear
		* Purpose:           Clears the email object of all information.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Clears the email object of all information to the state as if the object was just created, 
		** which will have default headers such as Mime-Version, Date, Message-ID, Content-Type, 
		** Content-Transfer-Encoding, and X-Priority.
		**
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
