	PROCEDURE isimplemented		&& Method used to determine if the class being referenced has been implemented in the current version of the object.
		*==============================================================================
		* Method:            IsImplemented
		* Purpose:           Method used to determine if the class being referenced 
		*                    has been implemented in the current version of the object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMajorVersion -- the major version number of the implementation.
		*                    tiMinorVersion -- the minor version number of the implementation.
		*                    tiPatchVersion -- the patch version number of the implementation.
		* Returns:           Logical, indicating implementation.
		* Date Added:        05/10/2022
		*==============================================================================
		
		LPARAMETERS tuArrayOrInteger AS Integer, tiMajorVersion AS Integer, tiMinorVersion AS Integer
		
		LOCAL lcCaller AS Character, liStackLevel AS Integer, liCallingMethodLayer AS Integer, ;
		liIntroducedInBuild AS Integer, lcObject AS Character, lcSecondParameter AS Character, ;
		liCurrentBuild AS Integer, llImplemented AS Logical, lcPEMType AS Character, ;
		loVersioning AS [iVersioning OF ChilkatVFP.VCX], lcErrorMessage AS Character, ;
		liMajorVersion AS Integer, liMinorVersion AS Integer, liPatchVersion AS Integer, ;
		liInstanceMajorHold AS Integer, liInstanceMinorHold AS Integer, ;
		liInstancePatchHold AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_Implemented[3, 1]
		
		STORE [] TO m.lcObject, m.lcCaller, m.lcSecondParameter, m.lcPEMType, ;
		m.lcErrorMessage, m.la_Stack, m.la_Implemented
		
		STORE 0 TO m.liIntroducedInBuild, m.liCurrentBuild, m.liCallingMethodLayer, ;
		m.liMajorVersion, m.liMinorVersion, m.liPatchVersion, m.liInstanceMajorHold, ;
		m.liInstanceMinorHold, m.liInstancePatchHold
		
		llImplemented = .F.
		
		WITH THIS
		
		  ** Parameter processing branch
		  DO CASE
		
		    ** Passed array as first parameter test
		    CASE TYPE([tuArrayOrInteger], 1) == [A]
		
		      ACOPY(tuArrayOrInteger, m.la_Implemented)
		
		      liMajorVersion = IIF(VARTYPE(m.la_Implemented[1]) == [N], m.la_Implemented[1], .iInstanceMajor)
		      liMinorVersion = IIF(VARTYPE(m.la_Implemented[2]) == [N], m.la_Implemented[2], .iInstanceMinor)
		      liPatchVersion = IIF(VARTYPE(m.la_Implemented[3]) == [N], m.la_Implemented[3], .iInstancePatch)
		
		    ** Passed number as first parameter test
		    CASE TYPE([tuArrayOrInteger]) == [N]
		
		      ** If no values passed, it existed at the time when the object came into existence.
		      liPatchVersion = IIF(VARTYPE(m.tuArrayOrInteger) == [N] ;
		      AND (NOT EMPTY(m.tuArrayOrInteger)), m.tuArrayOrInteger, 0)
		
		      liMajorVersion = IIF(VARTYPE(m.tiMajorVersion) == [N] ;
		      AND (NOT EMPTY(m.tiMajorVersion)), m.tiMajorVersion, .iBuildMajor)
		
		      liMinorVersion = IIF(VARTYPE(m.tiMinorVersion) == [N] ;
		      AND (NOT EMPTY(m.tiMinorVersion)), m.tiMinorVersion, .iBuildMinor)
		
		  ENDCASE
		  ** End parameter processing branch
		
		ENDWITH
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcCaller = UPPER(GETWORDNUM(m.la_Stack(m.liStackLevel - 1, 3), 2, [.]))
		
		** Prior method either CallAccessObject or CallAssignObject test
		IF INLIST(m.lcCaller, [CALLACCESSOBJECT], [CALLASSIGNOBJECT])
		
		  ** The CallAccessObject is the important one,
		  ** the CallAssignObject is added just for completeness.
		
		  liCallingMethodLayer = 2
		
		ELSE
		
		  liCallingMethodLayer = 1
		
		ENDIF INLIST(m.lcCaller, [CALLACCESSOBJECT], [CALLASSIGNOBJECT])
		** End prior method either CallAccessObject or CallAssignObject test
		
		lcCaller = STRTRAN(m.la_Stack(m.liStackLevel - m.liCallingMethodLayer, 3), [.], [ ])
		lcObject = PROPER(LEFTC(m.lcCaller, MAX(ATCC([ ], m.lcCaller, 1) - 1, 0)))
		lcCaller = SUBSTRC(m.lcCaller, MAX(ATCC([ ], m.lcCaller, 1), 0) + 1)
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1], la_Implemented[1, 1]
		
		STORE [] TO m.la_Stack, m.la_Implemented
		
		** Came in from an Access or Assign method test
		IF INLIST(UPPER(RIGHTC(m.lcCaller, 7)), [_ACCESS], [_ASSIGN])
		
		  lcCaller = LEFTC(m.lcCaller, LENC(m.lcCaller) - 7)
		
		ENDIF INLIST(UPPER(RIGHTC(m.lcCaller, 7)), [_ACCESS], [_ASSIGN])
		** End came in from an Access or Assign method test
		
		lcPEMType = LOWER(PEMSTATUS(THIS, m.lcCaller, 3))
		
		WITH THIS
		
		  loVersioning = .oVersioning
		
		  ** Have versioning object test
		  IF TYPE([loVersioning.Name]) == T_CHARACTER ;
		  AND PEMSTATUS(m.loVersioning, [IsImplemented], 5)
		
		    WITH m.loVersioning
		
		      liInstanceMajorHold = .iInstanceMajor
		      liInstanceMinorHold = .iInstanceMinor
		      liInstancePatchHold = .iInstancePatch
		
		      .iInstanceMajor = m.liMajorVersion
		      .iInstanceMinor = m.liMinorVersion
		      .iInstancePatch = m.liPatchVersion
		
		      llImplemented = .IsImplemented()
		
		      .iInstanceMajor = m.liInstanceMajorHold 
		      .iInstanceMinor = m.liInstanceMinorHold 
		      .iInstancePatch = m.liInstancePatchHold 
		
		    ENDWITH
		
		  ENDIF TYPE([loVersioning.Name]) == T_CHARACTER ;
		  AND PEMSTATUS(m.loVersioning, [IsImplemented], 5)
		  ** End have versioning object test
		
		ENDWITH 
		
		** Not implemented test
		IF NOT m.llImplemented
		
		  llSupportsSemanticVersioning = THIS.lSupportsSemanticVersioning
		
		  ** Supports semantic versioning (v 10 or greater) test
		  IF m.llSupportsSemanticVersioning 
		
		    lcIntroducedInVersion = ALLTRIM(STR(m.liMajorVersion)) + [.] + ;
		    ALLTRIM(STR(m.liMinorVersion)) + [.] + ALLTRIM(STR(m.liPatchVersion)) 
		
		    WITH m.loVersioning
		
		      lcCurrentBuild = ALLTRIM(STR(.iBuildMajor)) + [.] + ;
		      ALLTRIM(STR(.iBuildMinor)) + [.] + ALLTRIM(STR(.iBuildPatch))
		
		    ENDWITH
		
		    lcSecondParameter = PROPER(ChMsgSvc(m.lcPEMType)) + [~] + PROPER(m.lcCaller) + [~] + ;
		    m.lcObject + [~] + m.lcIntroducedInVersion + [~] + m.lcCurrentBuild
		 
		  ELSE && 9.5.0 series 
		
		    liCurrentBuild = m.loVersioning.iBuildPatch
		
		    lcSecondParameter = PROPER(ChMsgSvc(m.lcPEMType)) + [~] + PROPER(m.lcCaller) + [~] + ;
		    m.lcObject + [~] + ALLTRIM(STR(m.liPatchVersion)) + [~] + ALLTRIM(STR(m.liCurrentBuild))
		
		  ENDIF m.llSupportsSemanticVersioning
		  ** End supports semantic versioning (v 10 or greater) test
		
		  lcErrorMessage = ChMsgSvc([Introduced after current version], m.lcSecondParameter, , THIS)
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF NOT m.llImplemented
		** End not implemented test
		
		loVersioning = NULL
		
		RETURN m.llImplemented
	ENDPROC

	PROCEDURE ispemimplemented		&& Method used to determine if the method or property being referenced has been implemented in the current version of the object.
		*==============================================================================
		* Method:            IsPEMImplemented
		* Purpose:           Method used to determine if the method or property
		*                    being referenced has been implemented in the current
		*                    version of the object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuFirstParameter -- See possibilities below.
		*                    tuSecondParameter -- See possibilities below.
		*                    tuThirdParameter -- See possibilities below.
		* Returns:           Logical, indicating implementation.
		* Date Added:        11/24/2024
		*==============================================================================
		
		** These parameters handle three different situations.
		**
		** 1) Passing a numeric representing the 9.5.0 version as the first parameter - 68
		** 2) Passing a 1 x 3 array as the first parameter holding the major/minor/patch values
		** 3) Passing three numbers representing the major/minor/patch values.
		
		LPARAMETERS tuFirstParameter AS Unknown, tuSecondParameter AS Unknown, tuThirdParameter AS Unknown
		
		LOCAL luFirstParameter AS Unknown, luSecondParameter AS Unknown, ;
		luThirdParameter AS Unknown, liParameterCount AS Integer, ;
		llImplemented AS Logical, liBuild AS Integer, liInstance AS Integer, ;
		liBuildMajor AS Integer, liBuildMinor AS Integer, liBuildPatch AS Integer, ;
		liCallingMethodLayer AS Integer, lcCaller AS Character, lcPEMType AS Character, ;
		lcObject AS Character, liStackLevel AS Integer, lcBuild AS Character, ;
		liInstanceMajor AS Integer, liInstanceMinor AS Integer, liInstancePatch AS Integer, ;
		lcInstance AS Character, lcSecondParameter AS Character, lcErrorMessage AS Character, ;
		llPatchInFirstParameter AS Logical
		
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[3, 1]
		
		STORE 0 TO m.liParameterCount, m.liBuild, m.liCallingMethodLayer, ;
		m.liInstance, m.liBuildMajor, m.liBuildMinor, m.liBuildPatch, m.liStackLevel, ;
		m.liInstanceMajor, m.liInstanceMinor, m.liInstancePatch
		
		STORE [] TO m.lcCaller, m.lcObject, m.lcInstance, m.lcBuild, m.lcPEMType, ;
		m.lcSecondParameter, m.lcErrorMessage, m.la_Stack, m.la_Parameters
		
		STORE .F. TO m.llImplemented, m.llPatchInFirstParameter
		
		** Passing an array test
		IF TYPE([tuFirstParameter(1, 1)]) = T_NUMERIC
		
		  ACOPY(m.tuFirstParameter, m.la_Parameters)
		
		ELSE 
		
		  luFirstParameter = m.tuFirstParameter
		
		ENDIF TYPE([luFirstParameter(1, 1)]) = T_NUMERIC
		** End passing an array test
		
		luSecondParameter = m.tuSecondParameter
		luThirdParameter = m.tuThirdParameter
		
		liParameterCount = PCOUNT()
		
		WITH THIS
		
		  liBuildMajor = .iBuildMajor
		  liBuildMinor = .iBuildMinor
		  liBuildPatch = .iBuildPatch
		
		  ** Parameter passing branch
		  DO CASE 
		
		    ** Passing one array test 
		    CASE TYPE([la_Parameters(1, 1)]) = T_NUMERIC ;
		    AND (ALEN(m.la_Parameters, 1) = 3) ;
		    AND m.liParameterCount = 1
		
		      ** If array passed, version assumed to be in order [9, 5, 78] or [10, 0, 1]
		
		      luFirstParameter = m.la_Parameters(1)
		      luSecondParameter = m.la_Parameters(2)
		      luThirdParameter = m.la_Parameters(3)
		
		      liInstance = (m.luFirstParameter * 1000000) + (m.luSecondParameter * 1000) + m.luThirdParameter
		
		    ** Passing one parameter branch (version 9 situation)
		    CASE m.liParameterCount = 1 ;
		    AND (VARTYPE(m.luFirstParameter) == T_NUMERIC)
		
		      luSecondParameter = .iInstanceMajor
		      luThirdParameter = .iInstanceMinor
		
		      liInstance = (m.luSecondParameter * 1000000) + (m.luThirdParameter * 1000) + m.luFirstParameter
		      llPatchInFirstParameter = .T.
		
		    ** Passing three parameters (assumed numerics) branch 
		    CASE m.liParameterCount = 3
		
		      ** If all three parameters passed, then the first parameter is the Major.
		      ** (9, 5, 78) or (10, 0, 1)
		
		      liInstance = (m.luFirstParameter * 1000000) + (m.luSecondParameter * 1000) + m.luThirdParameter
		
		  ENDCASE
		  ** End parameter passing branch
		
		  liBuild = (m.liBuildMajor * 1000000) + (m.liBuildMinor * 1000) + m.liBuildPatch
		
		  llImplemented = NOT (m.liInstance > m.liBuild)
		
		  ** Not implemented test
		  IF NOT m.llImplemented
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcCaller = UPPER(GETWORDNUM(m.la_Stack(m.liStackLevel - 1, 3), 2, [.]))
		
		    ** Prior method either CallAccessObject or CallAssignObject test
		    IF INLIST(m.lcCaller, [CALLACCESSOBJECT], [CALLASSIGNOBJECT])
		
		      ** The CallAccessObject is the important one,
		      ** the CallAssignObject is added just for completeness.
		
		      liCallingMethodLayer = 2
		
		    ELSE
		
		      liCallingMethodLayer = 1
		
		    ENDIF INLIST(m.lcCaller, [CALLACCESSOBJECT], [CALLASSIGNOBJECT])
		    ** End prior method either CallAccessObject or CallAssignObject test
		
		    lcCaller = STRTRAN(m.la_Stack(m.liStackLevel - m.liCallingMethodLayer, 3), [.], [ ])
		    lcObject = PROPER(LEFTC(m.lcCaller, MAX(ATCC([ ], m.lcCaller, 1) - 1, 0)))
		    lcCaller = SUBSTRC(m.lcCaller, MAX(ATCC([ ], m.lcCaller, 1), 0) + 1)
		
		    ** Use three dot notation test
		    IF m.luSecondParameter = 9
		
		      lcInstance = [9.] + ALLTRIM(STR(m.luThirdParameter)) + [.0.] + ALLTRIM(STR(m.luFirstParameter))
		
		    ELSE && two dot notation 
		
		      ** Passed one numeric parameter test
		      IF m.llPatchInFirstParameter
		
		        lcInstance = ALLTRIM(STR(m.luSecondParameter)) + ;
		        [.] + ALLTRIM(STR(m.luThirdParameter)) + [.] + ;
		        ALLTRIM(STR(m.luFirstParameter))
		
		      ELSE
		
		        lcInstance = ALLTRIM(STR(m.luFirstParameter)) + [.] + ;
		        ALLTRIM(STR(m.luSecondParameter)) + [.] + ALLTRIM(STR(m.luThirdParameter))
		
		      ENDIF m.llPatchInFirstParameter
		      ** End passed one numeric parameter test
		
		    ENDIF m.luSecondParameter = 9
		    ** End use three dot notation test
		
		    ** Use three dot notation test
		    IF m.liBuildMajor = 9
		
		      lcBuild = [9.] + ALLTRIM(STR(m.liBuildMinor)) + [.0.] + ALLTRIM(STR(m.liBuildPatch))
		
		    ELSE && two dot notation 
		
		      lcBuild = ALLTRIM(STR(m.liBuildMajor)) + ;
		      [.] + ALLTRIM(STR(m.liBuildMinor)) + [.] + ;
		      ALLTRIM(STR(m.liBuildPatch))
		
		    ENDIF m.liBuildMajor = 9
		    ** End use three dot notation test
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcCaller, 3))
		
		    lcSecondParameter = PROPER(ChMsgSvc(m.lcPEMType)) + [~] + ;
		    PROPER(m.lcCaller) + [~] + m.lcObject + [~] + m.lcInstance + [~] + m.lcBuild
		
		    lcErrorMessage = ChMsgSvc([Introduced after current version], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF NOT m.llImplemented
		  ** End not implemented test
		
		ENDWITH
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[1, 1]
		STORE [] TO m.la_Stack, m.la_Parameters
		
		RETURN m.llImplemented 
		
	ENDPROC

	PROCEDURE ispemremoved		&& Method used to determine if a PEM has been removed from the running version of the object.
		*==============================================================================
		* Method:            IsPEMRemoved
		* Purpose:           Method used to determine if a PEM has been removed 
		*                    from the running version of the object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuFirstParameter -- See possibilities below.
		*                    tuSecondParameter -- See possibilities below.
		*                    tuThirdParameter -- See possibilities below.
		* Returns:           Logical, indicating removal.
		* Date Added:        05/02/2025
		*==============================================================================
		
		** These parameters handle two different situations.
		**
		** 1) Passing a 1 x 3 array as the first parameter holding the major/minor/patch values
		** 2) Passing three numbers representing the major/minor/patch values.
		
		LPARAMETERS tuFirstParameter AS Unknown, tuSecondParameter AS Unknown, tuThirdParameter AS Unknown
		
		LOCAL luFirstParameter AS Unknown, luSecondParameter AS Unknown, ;
		luThirdParameter AS Unknown, liParameterCount AS Integer, llRemoved AS Logical, ;
		liRemoved AS Integer, lcBuild AS Character, lcCaller AS Character, ;
		lcErrorMessage As Character, lcInstance As Character, lcObject As Character, ;
		lcPEMType As Character, lcSecondParameter As Character, liBuild As Integer, ;
		liBuildMajor As Integer, liBuildMinor As Integer, liBuildPatch As Integer, ;
		liCallingMethodLayer As Integer, liStackLevel As Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[3, 1]
		
		llRemoved = .F.
		liRemoved = 0
		
		STORE [] TO m.la_Stack, m.la_Parameters, lcBuild, lcCaller
		
		** Passing an array test
		IF TYPE([tuFirstParameter(1, 1)]) = T_NUMERIC
		
		  ACOPY(m.tuFirstParameter, m.la_Parameters)
		
		ELSE 
		
		  luFirstParameter = m.tuFirstParameter
		
		ENDIF TYPE([luFirstParameter(1, 1)]) = T_NUMERIC
		** End passing an array test
		
		luSecondParameter = m.tuSecondParameter
		luThirdParameter = m.tuThirdParameter
		
		liParameterCount = PCOUNT()
		
		WITH THIS
		
		  liBuildMajor = .iBuildMajor
		  liBuildMinor = .iBuildMinor
		  liBuildPatch = .iBuildPatch
		
		  ** Parameter passing branch
		  DO CASE 
		
		    ** Passing one array test 
		    CASE TYPE([la_Parameters(1, 1)]) = T_NUMERIC ;
		    AND (ALEN(m.la_Parameters, 1) = 3) ;
		    AND m.liParameterCount = 1
		
		      ** If array passed, version assumed to be in order [9, 5, 78] or [10, 0, 1]
		
		      luFirstParameter = m.la_Parameters(1)
		      luSecondParameter = m.la_Parameters(2)
		      luThirdParameter = m.la_Parameters(3)
		
		      liRemoved = (m.luFirstParameter * 1000000) + (m.luSecondParameter * 1000) + m.luThirdParameter
		
		    ** Passing three parameters (assumed numerics) branch 
		    CASE m.liParameterCount = 3
		
		      ** If all three parameters passed, then the first parameter is the Major.
		      ** (9, 5, 78) or (10, 0, 1)
		
		      liRemoved = (m.luFirstParameter * 1000000) + (m.luSecondParameter * 1000) + m.luThirdParameter
		
		  ENDCASE
		  ** End parameter passing branch
		
		  liBuild = (m.liBuildMajor * 1000000) + (m.liBuildMinor * 1000) + m.liBuildPatch
		
		  llRemoved = NOT (m.liBuild > m.liRemoved)
		
		  ** PEM retired test
		  IF m.llRemoved
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcCaller = UPPER(GETWORDNUM(m.la_Stack(m.liStackLevel - 1, 3), 2, [.]))
		
		    ** Prior method either CallAccessObject or CallAssignObject test
		    IF INLIST(m.lcCaller, [CALLACCESSOBJECT], [CALLASSIGNOBJECT])
		
		      ** The CallAccessObject is the important one,
		      ** the CallAssignObject is added just for completeness.
		
		      liCallingMethodLayer = 2
		
		    ELSE
		
		      liCallingMethodLayer = 1
		
		    ENDIF INLIST(m.lcCaller, [CALLACCESSOBJECT], [CALLASSIGNOBJECT])
		    ** End prior method either CallAccessObject or CallAssignObject test
		
		    lcCaller = STRTRAN(m.la_Stack(m.liStackLevel - m.liCallingMethodLayer, 3), [.], [ ])
		    lcObject = PROPER(LEFTC(m.lcCaller, MAX(ATCC([ ], m.lcCaller, 1) - 1, 0)))
		    lcCaller = SUBSTRC(m.lcCaller, MAX(ATCC([ ], m.lcCaller, 1), 0) + 1)
		
		    lcInstance = ALLTRIM(STR(m.luFirstParameter)) + [.] + ;
		    ALLTRIM(STR(m.luSecondParameter)) + [.] + ALLTRIM(STR(m.luThirdParameter))
		
		    lcBuild = ALLTRIM(STR(m.liBuildMajor)) + [.] + ;
		    ALLTRIM(STR(m.liBuildMinor)) + [.] + ALLTRIM(STR(m.liBuildPatch))
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcCaller, 3))
		
		    lcSecondParameter = PROPER(ChMsgSvc(m.lcPEMType)) + [~] + ;
		    PROPER(m.lcCaller) + [~] + m.lcObject + [~] + m.lcInstance + [~] + m.lcBuild
		
		    lcErrorMessage = ChMsgSvc([PEM Removed], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF m.llRemoved
		  ** End PEM retired test
		
		ENDWITH
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[1, 1]
		STORE [] TO m.la_Stack, m.la_Parameters
		
		RETURN m.llRemoved
	ENDPROC

	PROCEDURE isretired		&& Method used to determine if the object has been retired (decremented).
		*==============================================================================
		* Method:            IsRetired
		* Purpose:           Method used to determine if the object 
		*                    has been retired (decremented).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating retirement.
		* Date Added:        01/06/2025
		*==============================================================================
		
		LOCAL llReturn AS Logical, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		llReturn = .F.
		
		WITH THIS
		
		  loVersioning = .oVersioning
		
		  ** Have versioning object test
		  IF TYPE([loVersioning.Name]) == T_CHARACTER ;
		  AND PEMSTATUS(m.loVersioning, [lRetired], 5)
		
		    llReturn = m.loVersioning.lRetired
		
		  ENDIF TYPE([loVersioning.Name]) == T_CHARACTER ;
		  AND PEMSTATUS(m.loVersioning, [lRetired], 5)
		  ** End have versioning object test
		
		ENDWITH
		
		loVersioning = NULL
		
		RETURN m.llReturn 
	ENDPROC

	HIDDEN PROCEDURE laddeventhandler_assign		&& Assign method used to determine that an event handler will be bound to the Chilkat object.
		*==============================================================================
		* Method:            lAddEventHandler_Assign
		* Purpose:           Assign method used to determine that an event
		*                    handler will be bound to the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tlAddEventHandler, logical value used to 
		*                    determine if bit values are returned as logical.
		* Returns:           
		* Date Added:        10/20/2022
		*==============================================================================
		
		LPARAMETERS tlAddEventHandler AS Logical
		
		LOCAL llAddEventHandler AS Logical, lcMethod AS Character, liStackLevel AS Integer, ;
		lcErrorMessage AS Character, lcPEMType AS Character, lcSecondParameter AS Character, ;
		lcChilkatClass AS Character, lcEventHandlerClass AS Character, ;
		loEventHandler AS Session, loChilkat AS Object, lcEventCallbackProcedure AS Character, ;
		liBuildNumber AS Integer, lcEventPrg AS Character, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL la_Stack[1, 1]
		
		llAddEventHandler = m.tlAddEventHandler
		
		STORE [] TO m.lcMethod, m.lcErrorMessage, m.lcPEMType, m.lcSecondParameter, ;
		m.lcChilkatClass, m.lcEventHandlerClass, m.lcEventCallbackProcedure, m.lcEventPrg, m.la_Stack
		STORE NULL TO m.loEventHandler, m.loChilkat, m.loVersioning
		STORE 0 TO m.liStackLevel, m.liBuildNumber, m.liCalculatedBuildNumber
		
		WITH THIS
		
		  ** Have a good parameter test
		  IF VARTYPE(m.llAddEventHandler) == T_LOGICAL
		
		    lcChilkatClass = UPPER(.cChilkatClass)
		    lcEventHandlerClass = .cEventHandlerClass
		    loChilkat = .oChilkat
		
		    ** 
		    ** Note: Some Chilkat classes do not have a version property 
		    ** and the value is calculated. But none of these Chilkat classes 
		    ** without a version property have events.
		    ** 
		
		    ** Adding event handler test
		    IF m.llAddEventHandler
		
		      loEventHandler = .oEventHandler
		
		      ** No event handler test
		      IF (NOT TYPE([loEventHandler.Name]) == T_CHARACTER)
		
		        liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		        loVersioning = .oVersioning && should exist
		
		        ** Have versioning object test
		        IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		          ** Class with event handler test
		          IF (NOT EMPTY(m.lcChilkatClass)) ;
		          AND (INLIST(m.lcChilkatClass, [AI], [ATOM], [AUTHAZUREAD], [AUTHGOOGLE], ;
		          [BZ2], [COMPRESSION], [CRYPT2], [DKIM], [DNS], [FTP2], [GZIP], ;
		          [HTTP], [HTTPCURL], [IMAP], [JS], [MAILMAN], [MCP], [MHT], [OAUTH2], [PEM], [REST]) ;
		          OR INLIST(m.lcChilkatClass, [RSS], [SCP], [SECRETS], [SFTP], [SOCKET], ;
		          [SPIDER], [SSH], [SSHTUNNEL], [STREAM], [TAR], [TASK], ;
		          [TASKCHAIN], [TRUSTEDROOTS], [UNIXCOMPRESS], [UPLOAD], [ZIP], ;
		          [ZIPCRC], [ZIPENTRY]) ; && Cert and PrivateKey acquired event handling after version 9.5.95.
		          OR (INLIST(m.lcChilkatClass, [CERT], [PRIVATEKEY]) ;
		          AND (m.liCalculatedBuildNumber > m.loVersioning.GenerateVersionNumber(9, 5, 95))))
		
		            ** Note above: 
		
		            ** This is okay...
		            loEventHandler = CREATEOBJECT(m.lcEventHandlerClass)
		
		            ** Have a good event handler test
		            IF TYPE([loEventHandler.Name]) == T_CHARACTER
		
		              .oEventHandler = m.loEventHandler
		
		            ENDIF TYPE([loEventHandler.Name]) == T_CHARACTER
		            ** End have a good event handler test
		
		          ELSE
		
		            llAddEventHandler = .F. && can't do it, no handler.
		
		          ENDIF (NOT EMPTY(m.lcChilkatClass)) ;
		          AND (INLIST(m.lcChilkatClass, [AI], [ATOM], [AUTHAZUREAD], [AUTHGOOGLE], ;
		          [BZ2], [COMPRESSION], [CRYPT2], [DKIM], [DNS], [FTP2], [GZIP], ;
		          [HTTP], [HTTPCURL], [IMAP], [JS], [MAILMAN], [MHT], [OAUTH2], [PEM], [REST]) ;
		          OR INLIST(m.lcChilkatClass, [RSS], [SCP], [SECRETS], [SFTP], [SOCKET], ;
		          [SPIDER], [SSH], [SSHTUNNEL], [STREAM], [TAR], [TASK], ;
		          [TASKCHAIN], [TRUSTEDROOTS], [UNIXCOMPRESS], [UPLOAD], [ZIP], ;
		          [ZIPCRC], [ZIPENTRY]) ; && Cert and PrivateKey acquired event handling after version 9.5.95.
		          OR (INLIST(m.lcChilkatClass, [CERT], [PRIVATEKEY]) ;
		          AND (m.liCalculatedBuildNumber > m.loVersioning.GenerateVersionNumber(9, 5, 95))))
		          ** End class with event handler test
		
		        ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		        ** End have versioning object test
		
		      ENDIF (NOT TYPE([loEventHandler.Name]) == T_CHARACTER)
		      ** End no event handler test
		
		      ** Have a good event handler test
		      IF NOT ISNULL(m.loEventHandler) ;
		      AND (VARTYPE(m.loEventHandler.Name) == T_CHARACTER)
		
		        ** Chiklat callback program processing branch
		        DO CASE
		        
		          CASE m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 52)
		
		            lcEventPrg = [ChilkatVFPEventCallbacksPreV52.PRG]
		
		          CASE m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 58)
		
		            lcEventPrg = [ChilkatVFPEventCallbacksPreV58.PRG]
		
		          CASE m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(10, 0, 0)
		
		            lcEventPrg = [ChilkatVFPEventCallbacksV58.PRG]
		
		          OTHERWISE
		
		            ** Version 10 or greater
		            lcEventPrg = [ChilkatVFPEventCallbacks.PRG]
		  
		        ENDCASE
		        ** End Chiklat callback program processing branch
		
		        _vfp.AutoYield = .T. && must do this or it simply doesn't work...
		
		        lcEventCallbackProcedure = .cChilkatClass + [EventCallback]
		
		        DO (m.lcEventCallbackProcedure) IN (m.lcEventPrg) WITH THIS
		
		      ENDIF NOT ISNULL(m.loEventHandler) ;
		      AND (VARTYPE(m.loEventHandler.Name) == T_CHARACTER)
		      ** End have a good event handler test
		
		    ELSE
		
		      ** Event handler existence test
		      IF TYPE([.oEventHandler.Name]) == T_CHARACTER
		
		        EVENTHANDLER(m.loChilkat, THIS, .T.) && unbind them...
		
		      ENDIF TYPE([.oEventHandler.Name]) == T_CHARACTER
		      ** End event handler existence test
		
		    ENDIF m.llAddEventHandler
		    ** End adding event handler test
		
		    .lAddEventHandler = m.llAddEventHandler
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = lcProperty + [~] + m.lcPEMType
		
		    lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF VARTYPE(m.llAddEventHandler) == T_LOGICAL
		  ** End have a good parameter test
		
		ENDWITH
		
		STORE NULL TO m.loEventHandler, m.loChilkat, m.loVersioning
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([Versioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test  
	ENDPROC

	PROCEDURE logicaltobit		&& Method run to covert a logical value to bit.
		*==============================================================================
		* Method:            LogicalToBit
		* Purpose:           Method run to covert a logical value to bit.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, the value to convert
		* Returns:           
		* Date Added:        03/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL luValue AS Unknown, lcClass AS Character, lcErrorMessage AS Character, ;
		lcMethod AS Character, liStackLevel AS Integer, lcPEMType AS Character, ;
		lcSecondParameter AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcClass, m.lcErrorMessage, m.lcMethod, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		luValue = m.tuValue
		
		** Correct type test
		IF INLIST(VARTYPE(m.luValue), T_LOGICAL, T_NUMERIC)
		
		  ** Logical value test
		  IF VARTYPE(m.luValue) == T_LOGICAL
		
		    luValue = IIF(m.luValue, 1, 0)
		
		  ELSE
		
		    ** It's numeric, assume it's set to 0/1 for now...
		
		  ENDIF VARTYPE(m.luValue) == T_LOGICAL
		  ** End logical value test
		
		ELSE
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		
		  ** Redefine when not in use.
		  LOCAL ARRAY la_Stack[1, 1]
		  la_Stack[1, 1] = []
		
		  lcClass = PROPER(LEFTC(m.lcMethod, MAX(AT_C([.], m.lcMethod) - 1, 0)))
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		  lcSecondParameter = m.lcClass + [ ] + m.lcPEMType + [~] + m.lcMethod
		
		  lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		  THIS.ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF INLIST(VARTYPE(m.luValue), T_LOGICAL, T_NUMERIC)
		** End correct type and value test
		
		RETURN m.luValue
		
	ENDPROC

	HIDDEN PROCEDURE lreturnbitaslogical_assign		&& Assign method used to determine that bit values are returned as a Visual Foxpro logical value.
		*==============================================================================
		* Method:            lReturnBitAsLogical_Assign
		* Purpose:           Assign method used to determine that bit values 
		*                    are returned as a Visual Foxpro logical value.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tlReturnBitAsLogical, logical value used to 
		*                    determine if bit values are returned as logical.
		* Returns:           
		* Date Added:        01/06/2022
		* Notes:             We want to run the code every time since the 
		*                    referenced Chilkat object could vary.
		*==============================================================================
		
		LPARAMETERS tlReturnBitAsLogical AS Logical
		
		LOCAL llReturnBitAsLogical AS Logical, lcMethod AS Character, liStackLevel AS Integer, ;
		lcErrorMessage AS Character, lcPEMType AS Character, lcSecondParameter AS Character
		
		LOCAL la_Stack[1, 1]
		
		llReturnBitAsLogical = m.tlReturnBitAsLogical
		
		STORE [] TO m.lcMethod, m.lcErrorMessage, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		WITH THIS
		
		  ** Have a good parameter test
		  IF VARTYPE(m.tlReturnBitAsLogical) == T_LOGICAL
		
		    .lReturnBitAsLogical = m.llReturnBitAsLogical
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = lcProperty + [~] + m.lcPEMType
		
		    lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF VARTYPE(m.tlReturnBitAsLogical) == T_LOGICAL
		  ** End have a good parameter test
		
		ENDWITH
		
		RETURN
		
	ENDPROC

	HIDDEN PROCEDURE lsupportssemanticversioning_access		&& Access method used to retrieve the lSupportsSemanticVersioning property, generated from the Version number of the Chilkat object.
		*==============================================================================
		* Method:            lSupportsSemanticVersioning_Access
		* Purpose:           Access method used to retrieve the lSupportsSemanticVersioning property, 
		*                    generated from the Version number of the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.lSupportsSemanticVersioning
		* Date Added:        10/25/2024
		*==============================================================================
		
		LOCAL llSupportsSemanticVersioning AS Logical, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		llSupportsSemanticVersioning = .F.
		
		WITH THIS
		
		  loVersioning = .oVersioning
		
		  ** Have versioning object with matching property test
		  IF TYPE([loVersioning.Name]) == T_CHARACTER ;
		  AND PEMSTATUS(m.loVersioning, [lSupportsSemanticVersioning], 5) 
		
		    STORE m.loVersioning.lSupportsSemanticVersioning TO ;
		    llSupportsSemanticVersioning, .lSupportsSemanticVersioning 
		
		  ELSE
		
		    llSupportsSemanticVersioning = .F.
		
		  ENDIF TYPE([loVersioning.Name]) == T_CHARACTER ;
		  AND PEMSTATUS(m.loVersioning, [lSupportsSemanticVersioning], 5)
		  ** End have versioning object with matching property test
		
		ENDWITH
		
		loVersioning = NULL
		
		RETURN m.llSupportsSemanticVersioning
	ENDPROC

	HIDDEN PROCEDURE lsupportssemanticversioning_assign		&& Assign method used to hold the lSupportsSemanticVersioning property, generated from the Version number of the Chilkat object.
		*==============================================================================
		* Method:            lSupportsSemanticVersioning_Assign
		* Purpose:           Assign method used to retrieve the lSupportsSemanticVersioning property, 
		*                    generated from the Version number of the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.lSupportsSemanticVersioning
		* Date Added:        10/04/2024
		*==============================================================================
		
		LPARAMETERS tlSupportsSemanticVersioning AS Character
		
		LOCAL llSupportsSemanticVersioning AS Character, liStackLevel AS Integer
		
		LOCAL ARRAY la_Stack[1]
		
		STORE 0 TO m.llSupportsSemanticVersioning, m.liStackLevel
		
		llSupportsSemanticVersioning = m.tlSupportsSemanticVersioning
		liStackLevel = ASTACKINFO(la_Stack)
		
		** Have a good value coming from the Init in Chilkat VFP library test
		IF VARTYPE(m.llSupportsSemanticVersioning) == T_CHARACTER ;
		AND UPPER(RIGHTC(m.la_Stack(m.liStackLevel - 1, 3), 19)) == [LSUPPORTSSEMANTICVERSIONING_ACCESS]
		
		  THIS.lSupportsSemanticVersioning = m.llSupportsSemanticVersioning
		
		ENDIF VARTYPE(m.llSupportsSemanticVersioning) == T_CHARACTER ;
		AND UPPER(RIGHTC(m.la_Stack(m.liStackLevel - 1, 3), 19)) == [LSUPPORTSSEMANTICVERSIONING_ACCESS]
		** End have a good value coming from the Init in Chilkat VFP library test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		RETURN THIS.lSupportsSemanticVersioning
	ENDPROC

	PROCEDURE missingobjecterror		&& Error method run for when there is a missing Chilkat object when running a method.
		*==============================================================================
		* Method:            MissingObjectError
		* Purpose:           Error method run for when there is a missing 
		*                    Chilkat object when running a method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper, the VFP Chilkat Wrapper object.
		* Returns:           
		* Date Added:        05/16/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcMethod AS Character, ;
		lcPEMType AS Character, lcSecondParameter AS Character, liStackLevel AS Integer, ;
		lcErrorMessage AS Character
		
		LOCAL ARRAY la_Stack[1]
		
		loChilkatWrapper = m.toChilkatWrapper
		
		STORE [] TO m.lcMethod, m.lcPEMType, m.lcSecondParameter, m.lcErrorMessage, m.la_Stack
		liStackLevel = 0
		
		WITH m.loChilkatWrapper
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel - 1, 3), [.], [ ]))
		  lcPEMType = LOWER(PEMSTATUS(THIS, GETWORDNUM(m.lcMethod, 2), 3))
		  lcSecondParameter = [loChilkatObject] + [~] + m.lcMethod + [~] + m.lcPEMType
		
		  lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		  .ProcessErrorMessage(m.lcErrorMessage, m.loChilkatWrapper)
		
		ENDWITH
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loEventHandler = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE oeventhandler_assign		&& Assign method used to hold a reference to the event handler object.
		*==============================================================================
		* Method:            oEventHandler_Assign
		* Purpose:           Assign method used to hold a reference to the MsgSvc object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toEventHandler, the MsgSvc object, or NULL
		* Returns:           
		* Date Added:        03/14/2022
		*==============================================================================
		
		LPARAMETERS toEventHandler AS [iBaseEventHandler OF ChilkatVFP.VCX]
		
		LOCAL loEventHandler AS [iBaseEventHandler OF ChilkatVFP.VCX], lcErrorMessage AS Character, ;
		lcPEMType AS Character, lcSecondParameter AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		loEventHandler = m.toEventHandler
		
		WITH THIS
		
		  ** Parameter validation test
		  IF ISNULL(m.loEventHandler) ;
		  OR TYPE([loEventHandler.Name]) == T_CHARACTER
		
		    .oEventHandler = m.loEventHandler
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		
		    lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF ISNULL(m.loEventHandler) ;
		  OR TYPE([loEventHandler.Name]) == T_CHARACTER
		  ** End parameter validation test
		
		ENDWITH
		
		loEventHandler = NULL
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loEventHandler = NEWOBJECT([iBaseEventHandler], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test 
	ENDPROC

	HIDDEN PROCEDURE omsgsvc_access		&& Access method used to retrieve a reference to the MsgSvc object.
		*==============================================================================
		* Method:            oMsgSvc_Access
		* Purpose:           Access method used to retrieve a reference to the Chilkat MsgSvc object.
		* Author:            Bill Anderson
		* Parameters:        
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Returns:           .oMsgSvc, the MsgSvc object, or NULL.
		* Date Added:        01/04/2022
		* Notes:             Don't instantiate the object if we're sitting in the Destroy method.
		*==============================================================================
		
		LOCAL loMsgSvc AS [cMsgSvc OF cAbstractDirector], lcErrorMessage AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcPEMType AS Character, lcSecondParameter AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcProperty, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		WITH THIS
		
		  loMsgSvc = .oMsgSvc
		
		  ** Object doesn't exist test
		  IF ISNULL(m.loMsgSvc) ;
		  OR TYPE([loMsgSvc.Name]) # T_CHARACTER
		
		    ASTACKINFO(la_Stack)
		
		    ** Not in Destroy method test
		    IF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		
		      loMsgSvc = CREATEOBJECT([cMsgSvc])
		 
		      ** Problems with instantiation test
		      IF TYPE([loMsgSvc.Name]) # T_CHARACTER
		
		        liStackLevel = ASTACKINFO(la_Stack)
		        lcMethod = m.la_Stack(m.liStackLevel, 3)
		        lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		        lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		        lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		        lcSecondParameter = m.lcProperty + [~] + m.lcMethod + [~] + m.lcPEMType
		
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF TYPE([loMsgSvc.Name]) # T_CHARACTER
		      ** End problems with instantiation test
		
		    ENDIF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		    ** End not in Destroy method test
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.loMsgSvc) ;
		  OR TYPE([loMsgSvc.Name]) # T_CHARACTER
		  ** End object doesn't exist test
		
		  .oMsgSvc = m.loMsgSvc
		
		ENDWITH
		
		loMsgSvc = NULL
		
		RETURN THIS.oMsgSvc
		
		** Design time IntelliSense test
		#IF .F.
		
		  loMsgSvc = NEWOBJECT([cMsgSvc], [ChMsgSvc.PRG])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE omsgsvc_assign		&& Assign method used to hold a reference to the MsgSvc object.
		*==============================================================================
		* Method:            oMsgSvc_Assign
		* Purpose:           Assign method used to hold a reference to the MsgSvc object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toMsgSvc, the MsgSvc object, or NULL
		* Returns:           
