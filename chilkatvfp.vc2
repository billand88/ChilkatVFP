	PROCEDURE endcompressbytesenc		&& Must be callled to finalize a compression stream. Returns any remaining (buffered) compressed data. (See BeginCompressBytesENC) Returns Nothing on failure.
		*==============================================================================
		* Method:            EndCompressBytesENC
		* Purpose:           Must be callled to finalize a compression stream.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Encoded compressed character data.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Must be callled to finalize a compression stream. 
		** Returns any remaining (buffered) compressed data.
		** 
		** (See BeginCompressBytesENC)
		**
		** Fix for version 77: When compressing in chunks, if the EncodingMode is base64, 
		** the final bit of data was not emitted in EndCompressBytesENC. 
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, lcCompressedData AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcCompressedData = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcCompressedData = m.loChilkatObject.EndCompressBytesENC()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcCompressedData
		
