	ENDPROC

	PROCEDURE isnocompressextension		&& Returns 1 if the fileExtension is contained in the set of "no compress" extensions, otherwise returns 0. (See the documentation for the AddNoCompressExtension method.) The fileExtension may be passed with or without the ".".
		*==============================================================================
		* Method:            IsNoCompressionExtension
		* Purpose:           Returns 1 if the fileExtension is contained 
		*                    in the set of "no compress" extensions, otherwise returns 0.
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileExtension -- the file extension to test.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Returns 1 if the fileExtension is contained in the set of "no compress" extensions, 
		** otherwise returns 0. (See the documentation for the AddNoCompressExtension method.) 
		** The fileExtension may be passed with or without the ".". 
		** For example, both ".jpg" and "jpg" are acceptable.
		**
		
		LPARAMETERS tcFileExtension AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.IsNoCompressionExtension(m.tcFileExtension) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

