	PROCEDURE sortbyattribute		&& Sorts the direct child nodes by the value of a specified attribute.
		*==============================================================================
		* Method:            SortByAttribute
		* Purpose:           Sorts the direct child nodes by the value of a specified attribute.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAttributeName -- the attribute name to sort by.
		*                    tuAscending -- whether or not to use ascending sort.
		* Returns:           
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Sorts the direct child nodes by the value of a specified attribute.
		**
		
		LPARAMETERS tcAttributeName AS Character, tuAscending AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, liAscending AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liAscending = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liAscending = .LogicalToBit(m.tuAscending)
		
		    TRY
		
		      m.loChilkatObject.SortByAttribute(m.tcAttributeName, m.liAscending)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
