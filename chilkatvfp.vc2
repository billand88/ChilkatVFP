DEFINE CLASS javakeystore AS ibasechilkat OF "chilkatvfp.vcx" 		&& API to read, write, access, and update Java key stores (JKS format). This class also supports the JCEKS format starting in Chilkat v9.5.0.66.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addpfx		&& Introduced in version 9.5.0.44. Adds the contents of a PFX or PKCS #12 (.p12) to the Java keystore object. One JKS entry per private key found in the PKCS12 is added. One JKS entry per private key found in the PKCS12 is added.
		*m: addprivatekey		&& Introduced in version 9.5.0.44. Adds a private key entry to the JKS. Both the private key and certificate chain are obtained from the certificate object that is passed in the 1st argument.
		*m: addsecretkey		&& Introduced in version 9.5.0.66. Adds a secret (symmetric) key entry to the JKS. This adds a symmetric key, which is simply a number of binary bytes (such as 16 bytes for a 128-bit AES key).
		*m: addtrustedcert		&& Introduced in version 9.5.0.44. Adds a trusted certificate to the Java keystore object. Returns 1 for success, 0 for failure.
		*m: certchainat		&& Introduced in version 11.0.0. Returns in certChain the certificate chain for the Nth private key in the keystore, where the first private key is at index 0. Returns 1 for success, 0 for failure.
		*m: certchainof		&& Introduced in version 11.0.0. Returns in certChain the certificate chain for the specified private key alias. Returns 1 for success, 0 for failure.
		*m: changepassword		&& Introduced in version 9.5.0.44. Changes the password for a private key. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat JavaKeyStore DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugFilePath property.
		*m: findcertchain		&& Introduced in version 9.5.0.44. Finds and returns the certificate chain for the private key with the specified alias. Returns Nothing on failure.
		*m: findprivatekey		&& Introduced in version 9.5.0.44. Finds and returns the private key with the specified alias. Returns Nothing on failure
		*m: findtrustedcert		&& Introduced in version 9.5.0.44. Finds and returns the trusted certificate with the specified alias. Returns Nothing on failure
		*m: getcertchain		&& Introduced in version 9.5.0.44. Returns the certificate chain associated with the Nth private key contained within the keystore. The 1st private key is at index 0. Returns Nothing on failure.
		*m: getprivatekey		&& Introduced in version 9.5.0.44. Returns the Nth private key contained within the keystore. The 1st private key is at index 0. Returns Nothing on failure.
		*m: getprivatekeyalias		&& Introduced in version 9.5.0.44. Returns the Nth private key alias contained within the keystore. The 1st private key is at index 0. Returns Nothing on failure.
		*m: getsecretkey		&& Introduced in version 9.5.0.66. Returns the Nth secret key contained within the keystore. The 1st secret key is at index 0. The bytes of the secret key are returned in the specified encoding. (such as hex, base64, base64url, etc.)
		*m: getsecretkeyalias		&& Introduced in version 9.5.0.66. Returns the Nth secret key alias contained within the keystore. The 1st secret key is at index 0. Returns Nothing on failure.
		*m: gettrustedcert		&& Introduced in version 9.5.0.44. Returns the Nth trusted certificate contained within the keystore. The 1st certificate is at index 0. Returns Nothing on failure.
		*m: gettrustedcertalias		&& Introduced in version 9.5.0.44. Returns the Nth trusted certificate alias contained within the keystore. The 1st certificate is at index 0. Returns Nothing on failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat JavaKeyStore LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat JavaKeyStore LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat JavaKeyStore LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat JavaKeyStore LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat JavaKeyStore LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat JavaKeyStore LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat JavaKeyStore LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadbd		&& Introduced in version 9.5.0.77. Loads a Java keystore from the contents of bd.
		*m: loadbinary		&& Introduced in version 9.5.0.44. Loads a Java keystore from in-memory byte data. Returns 1 for success, 0 for failure.
		*m: loadencoded		&& Introduced in version 9.5.0.44. Loads a Java keystore from an encoded string (such as base64, hex, etc.) Returns 1 for success, 0 for failure.
		*m: loadfile		&& Introduced in version 9.5.0.44. Loads a Java keystore from a file. Returns 1 for success, 0 for failure.
		*m: loadjwkset		&& Introduced in version 9.5.0.66. Loads the Java KeyStore from a JSON Web Key (JWK) Set. Returns 1 for success, 0 for failure.
		*m: numprivatekeys_access		&& Access method used to retrieve the Chilkat JavaKeyStore NumPrivateKeys property.
		*m: numprivatekeys_assign		&& Assign method used to hold a reference to the NumPrivateKeys property.
		*m: numsecretkeys_access		&& Access method used to retrieve the Chilkat JavaKeyStore NumSecretKeys property.
		*m: numsecretkeys_assign		&& Assign method used to hold a reference to the NumSecretKeys property.
		*m: numtrustedcerts_access		&& Access method used to retrieve the Chilkat JavaKeyStore NumTrustedCerts property.
		*m: numtrustedcerts_assign		&& Assign method used to hold a reference to the NumTrustedCerts property.
		*m: privatekeyat		&& Introduced in version 11.0.0. Returns in privKey the private key at index in the keystore, where the first key is at index 0. Returns 1 for success, 0 for failure.
		*m: privatekeyof		&& Introduced in version 11.0.0. Returns in privKey the private key associated with the given alias. Returns 1 for success, 0 for failure.
		*m: removeentry		&& Introduced in version 9.5.0.44. Removes the Nth trusted certificate or private key entry from the keystore.
		*m: requirecompletechain_access		&& Access method used to retrieve the Chilkat JavaKeyStore RequireCompleteChain property.
		*m: requirecompletechain_assign		&& Assign method used to hold a reference to the RequireCompleteChain property.
		*m: setalias		&& Introduced in version 9.5.0.44. Sets the alias name for a trusted certificate or private key entry. The entryType indicates whether it is a trusted root or private key entry (1 = trusted certificate entry, 2 = private key entry).
		*m: tobd		&& Introduced in version 11.0.0. Writes the key store to password. The bd is used for the keyed hash of the entire JKS file. Returns 1 for success, 0 for failure.
		*m: tobinary		&& Introduced in version 9.5.0.44. Writes the key store to in-memory bytes. The password is used for the keyed hash of the entire JKS file.
		*m: toencodedstring		&& Introduced in version 9.5.0.44. Writes the key store to an encoded string. The encoding can be any encoding such as "base64" or "hex". The password is used for the keyed hash of the entire JKS file.
		*m: tofile		&& Introduced in version 9.5.0.44. Writes the key store to a file. The password is used for the keyed hash of the entire JKS file.
		*m: tojwkset		&& Introduced in version 9.5.0.66. Returns the private keys in JSON JWK Set format. The JWK identifier (kid) will be set from the key alias in the store. Returns 1 for success, 0 for failure.
		*m: topem		&& Introduced in version 9.5.0.49. Returns the Java KeyStore as a Pem object. Returns Nothing on failure
		*m: topemobj		&& Introduced in version 11.0.0. Returns the Java KeyStore as a Pem object in pemObj.
		*m: topfx		&& Introduced in version 9.5.0.49. Returns the Java KeyStore as a Pfx object. Returns Nothing on failure.
		*m: topfxobj		&& Introduced in version 11.0.0. Returns the Java KeyStore as a Pfx object in pfxObj. Returns 1 for success, 0 for failure.
		*m: trustedcertat		&& Introduced in version 11.0.0. Returns the Nth trusted certificate from the keystore in cert, with the 1st certificate at index 0. Returns 1 for success, 0 for failure.
		*m: trustedcertof		&& Introduced in version 11.0.0. Finds and returns in cert the trusted certificate with the specified alias. Returns 1 for success, 0 for failure.
		*m: unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*m: usecertvault		&& Introduced in version 9.5.0.44. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates for help in building certificate chains to a root certificate. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat JavaKeyStore VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifykeyeddigest_access		&& Access method used to retrieve the Chilkat JavaKeyStore VerifyKeyedDigest property.
		*m: verifykeyeddigest_assign		&& Assign method used to hold a reference to the VerifyKeyedDigest property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numprivatekeys		&& Introduced in version 9.5.0.44. The number of private keys contained within the keystore. Each private key has an alias and certificate chain associated with it.
		*p: numsecretkeys		&& Introduced in version 9.5.0.66. The number of secret keys (such as AES keys) contained within the keystore. Each secret key can have an alias associated with it.
		*p: numtrustedcerts		&& Introduced in version 9.5.0.44. The number of trusted certificates contained within the keystore. Each certificate has an alias (identifying string) associated with it.
		*p: requirecompletechain		&& Introduced in version 9.5.0.44. If 1, then adding a private key to the JKS only succeeds if the certificate chain can be completed to the root certificate. A root certificate is either a trusted CA root or a self-signed certificate.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: verifykeyeddigest		&& Introduced in version 9.5.0.44. If 1, then the keystore's keyed digest is required to pass validation (password required) for any of the load methods (such as LoadFile, LoadBinary, or LoadEncoded).
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = JavaKeyStore
		debuglogfilepath = 
		iinstancepatch = 44
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "javakeystore"
		numprivatekeys = 0
		numsecretkeys = 0
		numtrustedcerts = 0
		requirecompletechain = 1
		verboselogging = 0
		verifykeyeddigest = 1
	*</PropValue>
	
	PROCEDURE addpfx		&& Introduced in version 9.5.0.44. Adds the contents of a PFX or PKCS #12 (.p12) to the Java keystore object. One JKS entry per private key found in the PKCS12 is added. One JKS entry per private key found in the PKCS12 is added.
		*==============================================================================
		* Method:            AddPFX
		* Purpose:           Adds the contents of a PFX or PKCS #12 to the Java keystore object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPFX, a Chilkat PFX object.
		*                    tcAlias, the applied or derived alias.
		*                    tcPassword, the PFX password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Adds the contents of a PFX or PKCS #12 (.p12) to the Java keystore object. 
		** One JKS entry per private key found in the PKCS12 is added. 
		** The certs found within the PCKS12 are used to build 
		** the certificate chains for each private key. (A typical PFX file contains 
		** a single private key along with its associated certificate, 
		** and the certificates in the chain of authentication to the root CA cert.)
		** 
		** This method does not add trusted certificate entries to the JKS.
		** 
		** The specified alias is applied to the 1st private key found. 
		** If the alias is empty, then the alias is obtained from the cert/PFX 
		** in the following order of preference:
		** 
		**   Certificate's subject common name
		**   Certificate's subject email address
		**   Certificate's friendly name found in the PKCS9 attributes of the PKCS12
		**   Certificate's serial number
		** 
		** If multiple private keys are found in the PKCS12, then all but the first 
		** will automaticallly be assigned aliases using the preference just described.
		** 
		** The UseCertVault method may be called to provide additional certificates 
		** for the automatic construction of the certificate chains. 
		** If the RequireCompleteChain property is set to 1, 
		** then this method will fail if any certificate chain is not completed to the root. 
		** The TrustedRoots class may be used to provide a source for obtaining trusted CA roots 
		** if these are not already present within the PKCS12.
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatPFX AS CHILKAT_PFX_COM_CALL, ;
		tcAlias AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JAVAKEYSTORE_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterPfx AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPfx AS CHILKAT_PFX_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterPfx, m.loChilkatPfx
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPfx = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPfx)
		
		      loChilkatPfx = m.loParkParameterPfx.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddPFX(m.loChilkatPfx, m.tcAlias, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPfx = ;
		      m.loParkParameterPfx.SetObject(m.toChilkatPfx, m.loChilkatPfx)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPfx, m.loChilkatPfx
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  toChilkatPFX = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loParkParameterPfx = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPfx = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addprivatekey		&& Introduced in version 9.5.0.44. Adds a private key entry to the JKS. Both the private key and certificate chain are obtained from the certificate object that is passed in the 1st argument.
		*==============================================================================
		* Method:            AddPrivateKey
		* Purpose:           Adds a private key entry to the JKS.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tcAlias, the applied or derived alias.
		*                    tcPassword, the PFX password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Adds a private key entry to the JKS. Both the private key and certificate chain 
		** are obtained from the certificate object that is passed in the 1st argument.
		**
		** If the alias is empty, then the alias is automatically chosen based 
		** on the certificate's information, in the following order of preference:
		** 
		**   1) Certificate's subject common name
		**   2) Certificate's subject email address
		**   3) Certificate's serial number
		**
		** The UseCertVault method may be called to provide additional certificates 
		** for the automatic construction of the certificate chains. 
		** If the RequireCompleteChain property is set to 1, 
		** then this method will fail if the certificate chain is not completed to the root. 
		** The TrustedRoots class may be used to provide a source for obtaining trusted CA roots.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		tcAlias AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JAVAKEYSTORE_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddPrivateKey(m.loChilkatCert, m.tcAlias, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addsecretkey		&& Introduced in version 9.5.0.66. Adds a secret (symmetric) key entry to the JKS. This adds a symmetric key, which is simply a number of binary bytes (such as 16 bytes for a 128-bit AES key).
		*==============================================================================
		* Method:            AddSecretKey
		* Purpose:           Adds a secret (symmetric) key entry to the JKS.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedKeyBytes, the symmetric key bytes.
		*                    tcEncoding, the encoded key bytes encoding.
		*                    tcAlgorithm, the symmetric key bytes algorithm.
		*                    tcAlias, the alias used to encrypt the key bytes.
		*                    tcPassword, the secret key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Adds a secret (symmetric) key entry to the JKS. This adds a symmetric key, 
		** which is simply a number of binary bytes (such as 16 bytes for a 128-bit AES key). 
		** The encodedKeyBytes provides the actual bytes of the symmetric key, 
		** in an encoded string form. The encoding indicates the encoding of encodedKeyBytes 
		** (such as "base64", "hex", "base64url", etc.) The algorithm describes the symmetric algorithm, 
		** such as "AES". The alias is the password used to seal (encrypt) the key bytes.
		** 
		** Note: The algorithm describes the usage of the encodedKeyBytes. 
		** For example, if encodedKeyBytes contains the 16 bytes of a 128-bit AES key, 
		** then algorithm should be set to "AES". The actual encryption algorithm used 
		** to seal the key within the JCEKS is PBEWithMD5AndTripleDES, 
		** which is part of the JCEKS specification.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcEncodedKeyBytes AS Character, tcEncoding AS Character, ;
		tcAlgorithm AS Character, tcAlias AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JAVAKEYSTORE_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddSecretKey(m.tcEncodedKeyBytes, m.tcEncoding, ;
		        m.tcAlgorithm, m.tcAlias, m.tcPassword) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addtrustedcert		&& Introduced in version 9.5.0.44. Adds a trusted certificate to the Java keystore object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddTrustedCert
		* Purpose:           Adds a trusted certificate to the Java keystore object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tcAlias, the applied or derived alias.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Adds a trusted certificate to the Java keystore object.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
