	PROCEDURE tobeadded		&& This event fires during the AppendFiles and AppendFilesEx method calls. It is called just before each file is to be added. The skip output-only argument may be set to 1 to prevent the file from being added.
		*==============================================================================
		* Method:            ToBeAdded
		* Purpose:           This event fires during the AppendFiles and AppendFilesEx method calls.
		*                    It is called just before each file is to be added. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file to be added.
		*                    tiFileSize, the size of the file to be added.
		*                    tiSkip, the skip setting.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** This event fires during the AppendFiles and AppendFilesEx method calls. 
		** It is called just before each file is to be added. 
		** The skip output-only argument may be set to 1 to prevent the file from being added.
		**
		
		LPARAMETERS tcPath AS Character, tiFileSize AS Integer, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liFileSize AS Integer, liSkip AS Integer
		
		lcPath = m.tcPath
		liFileSize = m.tiFileSize
		liSkip = m.tiSkip
		
		*!*  
		*!*  ? [ToBeAdded Event!] 
		*!*  ? [ToBeAdded: File Path = ] + lcPath
		*!*  ? [File Size = ] + STR(liFileSize)
		*!*  ? [Skip = ] + STR(liSkip)
		*!*  
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liSkip = 0
		
		    .ToBeAdded_Pre(m.lcPath, m.liFileSize, m.liSkip)
		
		    ** OK to continue test
		    IF m.liSkip = 0
		
		      .ToBeAdded_Process(m.lcPath, m.liFileSize, m.liSkip)
		
		      ** OK to continue test
		      IF m.liSkip = 0
		
		        .ToBeAdded_Post(m.lcPath, m.liFileSize, m.liSkip)
		
		      ENDIF m.liSkip = 0
		      ** End OK to continue test
		
		    ENDIF m.liSkip = 0
		    ** End OK to continue test
		
		  ENDIF m.liSkip = 0
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiFileSize = m.liFileSize
		tiSkip = m.liSkip
		
		RETURN
	ENDPROC

