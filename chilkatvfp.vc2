	PROCEDURE writezip		&& Saves the Zip to a file and implictly re-opens it so further operations can continue. Use WriteZipAndClose to write and close the Zip.
		*==============================================================================
		* Method:            WriteZip
		* Purpose:           Saves the Zip to a file 
		*                    and implictly re-opens it so further operations can continue.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Saves the Zip to a file and implictly re-opens it so further operations can continue. 
		** Use WriteZipAndClose to write and close the Zip. 
		** There is no limitation on the size of files that may be contained 
		** within a .zip, the total number of files in a .zip, or the total size of a .zip. 
		** If necessary, WriteZip will use the ZIP64 file format extensions 
		** when 4GB or file count limitations of the old zip file format are exceeded.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.WriteZip() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE writezipandclose		&& Saves the Zip to a file and closes it. On return, the Zip object will be in the state as if NewZip had been called.
		*==============================================================================
