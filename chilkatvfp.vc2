	PROCEDURE writefiletext		&& Appends character data to an open file. The handle is a file handle returned by the OpenFile method. charset is a character encoding and is typically set to values such as "ansi", "utf-8", "windows-1252", etc.
		*==============================================================================
		* Method:            WriteFileText
		* Purpose:           Appends character data to an open file. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		*                    tcCharset, the character set of the text to write
		*                    tcText, the text to write
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Appends character data to an open file. 
		** The handle is a file handle returned by the OpenFile method. 
		** charset is a character encoding and is typically 
		** set to values such as "ansi", "utf-8", "windows-1252", etc. 
		** A list of supported character encodings is found on this page: Supported Charsets.
		**
		** Note: It is necessary to specify the character encoding 
		** because in many programming languages, strings are represented as Unicode 
		** (2 bytes/char) and in most cases one does not wish to write Unicode chars to a text file 
		** (although it is possible by setting charset = "Unicode").
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHandle AS Character, tcCharset AS Character, tcText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.WriteFileText(m.tcHandle, m.tcCharset, m.tcText) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE writefiletext32		&& Writes character data to an open file at a specific offset from the beginning of the file. The handle is a file handle returned by the OpenFile method.
		*==============================================================================
		* Method:            WriteFileText32
		* Purpose:           Writes character data to an open file 
		*                    at a specific offset from the beginning of the file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		*                    tiByteOffset, the offset from the beginning of the file
		*                    tcCharset, the character set of the file.
		*                    tcText, the text to write
		* Returns:           The character bytes from a specific file.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Writes character data to an open file at a specific offset 
		** from the beginning of the file. 
		** The handle is a file handle returned by the OpenFile method. 
		** charset is a character encoding and is typically set to values 
		** such as "ansi", "utf-8", "windows-1252", etc. 
		** A list of supported character encodings is found on this page: Supported Charsets.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHandle AS Character, tiByteOffset AS Integer, ;
		tcCharset AS Character, tcText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.WriteFileText32(m.tcHandle, m.tiByteOffset, m.tcCharset, m.tcText) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

