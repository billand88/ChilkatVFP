	PROCEDURE geteml		&& Creates EML from a web page or HTML file, and returns the EML (MIME) message data as a string. Returns Nothing on failure
		*==============================================================================
		* Method:            GetEML
		* Purpose:           Creates EML from a web page or HTML file, 
		*                    and returns the EML (MIME) message data as a string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURLOrHTMLPath, the URL or HTML file path.
		* Returns:           The EML message as a string.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Creates EML from a web page or HTML file, and returns the EML (MIME) message data as a string.
		**
		** Fixed in Version 58: Chilkat hangs with specific HTML on calling this method. 
		** The problem had to do with infinite recursion: The CSS that is downloaded itself contained 
		** an import for the same CSS (or indirectly contained an import for a CSS 
		** that then contained an import for a CSS that was previously downloaded, causing a loop).
		** 
		** Fixed in Version 59: MS-Word html files with %20 in file paths needed to be replaced with SPACE chars.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURLOrHTMLPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, ;
		loException AS Exception, lcEML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEML = m.loChilkatObject.GetEML(m.tcURLOrHTMLPath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

