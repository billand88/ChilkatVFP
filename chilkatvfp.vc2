	PROCEDURE addfileforupload		&& Adds a file to an upload request. To create a file upload request, set the ContentType property = "multipart/form-data" and then call AddFileForUpload, AddBytesForUpload, or AddStringForUpload for each file to be uploaded.
		*==============================================================================
		* Method:            AddFileForUpload
		* Purpose:           Adds a file to an upload request.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName -- arbitrary name
		*                    tcFilePath -- the path to the file to upload.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Adds a file to an upload request. To create a file upload request, 
		** set the ContentType property = "multipart/form-data" 
		** and then call AddFileForUpload, AddBytesForUpload, or AddStringForUpload 
		** for each file to be uploaded. This method does not read the file into memory. 
		** When the upload occurs, the data is streamed directly from the file, 
		** thus allowing for very large files to be uploaded without consuming large amounts of memory.
		**
		** name is an arbitrary name. (In HTML, it is the form field name of the input tag.)
		**
		** filePath is the path to an existing file in the local filesystem.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcName AS Character, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddFileForUpload(m.tcName, m.tcFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

