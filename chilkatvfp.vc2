	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat RSS VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/27/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS scard AS ibasechilkat OF "chilkatvfp.vcx" 		&& A wrapper around the Resource Manager API of the PC/SC architecture for smart cards. On Windows it is a wrapper around the WinSCard functions implemented in the winscard.dll. This class is introduced in Chilkat v9.5.0.87.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: activeprotocol_access		&& Access method used to retrieve the Chilkat SCard ActiveProtocol property.
		*m: activeprotocol_assign		&& Assign method used to hold a reference to the ActiveProtocol property.
		*m: begintransaction		&& Introduced in version 9.50.87. Establishes a temporary exclusive access mode for doing a series of commands in a transaction. Returns 1 for success, 0 for failure.
		*m: cardatr_access		&& Access method used to retrieve the Chilkat SCard CardATR property.
		*m: cardatr_assign		&& Assign method used to hold a reference to the CardATR property.
		*m: checkstatus		&& Introduced in version 9.50.87. Check the current status of the currently connected reader. Calling this method updates the ReaderStatus, ActiveProtocol, and CardAtr properties.
		*m: connect		&& Introduced in version 9.50.87. Establish a connection to a reader. The reader is the name of a reader returned from ListReaders. The shareMode can be "shared", "exclusive", or "direct".
		*m: connectedreader_access		&& Access method used to retrieve the Chilkat SCard ConnectedReader property.
		*m: connectedreader_assign		&& Assign method used to hold a reference to the ConnectedReader property.
		*m: context_access		&& Access method used to retrieve the Chilkat SCard Context property.
		*m: context_assign		&& Assign method used to hold a reference to the Context property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SCard DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: disconnect		&& Introduced in version 9.50.87. Terminates a connection with a reader. Returns 1 for success, 0 for failure.
		*m: endtransaction		&& Introduced in version 9.50.87. Ends a previously begun transaction. The disposition is the action to be taken on the reader, and can be "leave" which is to do nothing, "reset", "unpower", or "eject". Returns 1 for success, 0 for failure.
		*m: establishcontext		&& Introduced in version 9.5.0.87. Creates an Application Context to the PC/SC Resource Manager. This must be the first WinSCard function called in a PC/SC application. The scope can be "user" or "system".
		*m: findsmartcards		&& Introduced in version 9.50.87. Returns JSON containing information about the smartcards currently inserted into readers. Returns 1 for success, 0 for failure.
		*m: getattrib		&& Introduced in version 9.50.87. Get an attribute from the IFD Handler (reader driver).
		*m: getattribstr		&& Introduced in version 9.50.87. Get a string typed attribute from the IFD Handler (reader driver). The attr can be one of the following, but should be limited to the particular attributes that return string values.
		*m: getattribuint		&& Introduced in version 9.50.87. Get an unsigned integer typed attribute from the IFD Handler (reader driver). The attr can be one of the following, but should be limited to the particular attributes that return unsigned integer values.
		*m: getstatuschange		&& Introduced in version 9.50.87. Blocks execution until the current availability of the cards in a specific set of readers changes. This function receives a list of reader names in stReaderNames.
		*m: getstatuschangeasync		&& Introduced in version 9.50.87. Creates an asynchronous task to call the GetStatusChange method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getstatuschangecancel		&& Introduced in version 9.50.87. Cancels an ongoing GetStatusChange method call. This would be called from a separate thread in your application if GetStatusChange was called synchronously. Returns 1 for success, 0 for failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SCard LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat SCard LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat SCard LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat SCard LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SCard LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SCard LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SCard LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: listreadergroups		&& Introduced in version 9.50.87. Returns a list of currently available reader groups on the system. The reader groups are returned in readerGroups. Returns 1 for success, 0 for failure.
		*m: listreaders		&& Introduced in version 9.50.87. Returns a list of currently available readers on the system. Returns 1 for success, 0 for failure.
		*m: pcsclibpath_access		&& Access method used to retrieve the Chilkat SCard PCSCLibPath property.
		*m: pcsclibpath_assign		&& Assign method used to hold a reference to the PCSCLibPath property.
		*m: readerstatus_access		&& Access method used to retrieve the Chilkat SCard ReaderStatus property.
		*m: readerstatus_assign		&& Assign method used to hold a reference to the ReaderStatus property.
		*m: reconnect		&& Introduced in version 9.50.87. Reestablishes a connection to a reader that was previously connected to using Connect(). In a multi application environment it is possible for an application to reset the card in shared mode.
		*m: releasecontext		&& Introduced in version 9.50.87. Destroys a communication context to the PC/SC Resource Manager. This must be the last function called in a PC/SC application. Returns 1 for success, 0 for failure.
		*m: scarderror_access		&& Access method used to retrieve the Chilkat SCard SCardError property.
		*m: scarderror_assign		&& Assign method used to hold a reference to the SCardError property.
		*m: sendcontrol		&& Introduced in version 9.50.87. Sends a command directly to the IFD Handler (reader driver) to be processed by the reader.
		*m: sendcontrolhex		&& Introduced in version 9.50.87. Sends a command directly to the IFD Handler (reader driver) to be processed by the reader.
		*m: transmit		&& Introduced in version 9.50.87. Sends an APDU to the smart card contained in the currently connected reader. The protocol can be "T0", "T1", or "raw". The APDU to be sent is contained in bdSend.  The response from the card is contained in bdRecv.
		*m: transmithex		&& Introduced in version 9.50.87. Sends an APDU to the smart card contained in the currently connected reader. The protocol can be "T0", "T1", or "raw". The APDU (in hexadecimal) to be sent is passed in apduHex.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat SCard VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: activeprotocol		&& Introduced in version 9.50.87. The name of the active protocol if connected smart card reader, or an empty string if not connected. Possible values are "T0", "T1", "raw", "undefined", or "" if not connected to a reader.
		*p: cardatr		&& Introduced in version 9.50.87. This is the Current ATR of a card in the connected reader.
		*p: connectedreader		&& Introduced in version 9.50.87. The name of the currently connected smart card reader, or an empty string if not connected.
		*p: context		&& Introduced in version 9.50.87. Contains the string "user" or "system" if this object has established a context (by calling EstablishContext). Contains the empty string if no context is established.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: pcsclibpath		&& Introduced in version 9.50.87. For Linux systems only. Specifies the full path of the libpcsclite.so shared lib. This property should only be used if the libpcsclite.so is in a non-standard location or if Chilkat cannot automatically located it.
		*p: readerstatus		&& Introduced in version 9.50.87. The current status of the connected reader.
		*p: scarderror		&& Introduced in version 9.50.87. The last error returned by an underlying PC/SC function.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		activeprotocol = 
		cardatr = 
		cchilkatclass = SCard
		ceventhandlerclass = iBaseEventHandler
		connectedreader = 
		context = 
		debuglogfilepath = 
		iinstancepatch = 87
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "scard"
		pcsclibpath = 
		readerstatus = 
		scarderror = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE activeprotocol_access		&& Access method used to retrieve the Chilkat SCard ActiveProtocol property.
		*==============================================================================
		* Method:            ActiveProtocol_Access
		* Purpose:           Access method used to retrieve 
		*                    the ActiveProtocol property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ActiveProtocol
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** The name of the active protocol if connected smart card reader, 
		** or an empty string if not connected. Possible values are "T0", 
		** "T1", "raw", "undefined", or "" if not connected to a reader.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

