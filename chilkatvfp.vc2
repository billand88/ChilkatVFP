	HIDDEN PROCEDURE readtimeoutms_access		&& Access method used to retrieve the Chilkat Stream ReadTimeoutMs property.
		*==============================================================================
		* Method:            ReadTimeoutMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Stream ReadTimeoutMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReadTimeoutMs
		* Date Added:        06/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** The maximum number of seconds to wait while reading. 
		** The default value is 30 seconds (i.e. 30000ms). A value of 0 indicates a poll. 
		** (A polling read is to return with a timeout if no data is immediately available.)
		** 
		** Important: For most Chilkat timeout related properties, a value of 0 
		** indicates an infinite timeout. For this property, a value of 0 indicates a poll. 
		** If setting a timeout related property (or method argument) to zero, 
		** be sure to understand if 0 means "wait forever" or "poll".
		** 
		** The timeout value is not a total timeout. It is the maximum time to wait 
		** while no additional data is forthcoming.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE readtimeoutms_assign		&& Assign method used to hold a reference to the ReadTimeoutMs property.
		*==============================================================================
		* Method:            ReadTimeoutMs_Assign
		* Purpose:           Assign method used to hold a reference to the ReadTimeoutMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ReadTimeoutMs property.
		* Returns:           
		* Date Added:        06/13/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE readtocrlf		&& Introduced in version 9.5.0.56. Reads the stream until a CRLF is received. If no data is immediately available, it waits up to ReadTimeoutMs milliseconds for data to arrive. The data is returned as a string.
		*==============================================================================
		* Method:            ReadToCRLF
		* Purpose:           Reads the stream until a CRLF is received. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The stream string
		* Date Added:        06/14/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Reads the stream until a CRLF is received. If no data is immediately available, 
		** it waits up to ReadTimeoutMs milliseconds for data to arrive. 
		** The data is returned as a string. The incoming bytes are interpreted according 
		** to the StringCharset property. For example, if utf-8 bytes are expected, 
		** then StringCharset should be set to "utf-8" prior to calling ReadString.
		** 
		** Note: If the end-of-stream is reached prior to receiving the CRLF, 
		** then the remaining data is returned, and the ReadFailReason property will be set to 3 
		** (to indicate end-of-file). This is the only case where as string would be returned 
		** that does not end with CRLF.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_STREAM_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcString = []
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcString = m.loChilkatObject.ReadToCRLF()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

