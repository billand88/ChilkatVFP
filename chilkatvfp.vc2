	PROCEDURE setextensionrequest		&& Introduced in version 9.5.0.91. Adds a 1.2.840.113549.1.9.14 extensionRequest to the CSR. The extensionReqXml contains the ASN.1 in XML format of the extension request to be added. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetExtensionRequest
		* Purpose:           Adds a 1.2.840.113549.1.9.14 extensionRequest to the CSR.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML, a Chilkat XML object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		**
		** Adds a 1.2.840.113549.1.9.14 extensionRequest to the CSR. 
		** The extensionReqXml contains the ASN.1 in XML format 
		** of the extension request to be added.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CSR_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		llImplemented = .F.
		liIntroducedInBuild = 91
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterXml = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		      loChilkatXml = m.loParkParameterXml.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetExtensionRequest(m.loChilkatXML) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatXml = ;
		      m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSR_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsubjectfield		&& Introduced in version 9.5.0.65. Sets a subject field by OID, such as "2.5.4.9". See http://www.alvestrand.no/objectid/2.5.4.html for OID values and meanings. The asnType can be "UTF8String", "IA5String", or "PrintableString".
		*==============================================================================
		* Method:            SetSubjectField
		* Purpose:           Sets a subject field by OID, such as "2.5.4.9".
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOID, the OID value to reference.
		*                    tcValue, the value to set.
		*                    tcASNType, the ASN type.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Sets a subject field by OID, such as "2.5.4.9". 
		** See http://www.alvestrand.no/objectid/2.5.4.html for OID values and meanings.
		** 
		** The asnType can be "UTF8String", "IA5String", or "PrintableString". 
		** If you have no specific requirement, or don't know, choose "UTF8String".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcOID AS Character, tcValue AS Character, tcASNType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CSR_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetSubjectField(m.tcOID, ;
		        m.tcValue, m.tcASNType) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE state_access		&& Access method used to retrieve the Chilkat CSR State property.
		*==============================================================================
		* Method:            State_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSR State property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.State
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.65
		**
		** The state or province for the certificate to be generated.
		** 
		** It is the value for "S" (or "ST") in the certificate's Subject's distinguished name (DN).
		** (This is the value for OID "2.5.4.8")
		** 
		** This property is optional. It may left empty.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 65
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE state_assign		&& Assign method used to hold a reference to the State property.
		*==============================================================================
		* Method:            State_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat CSR State property.
		* Author:            Bill Anderson
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the State property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 65
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat CSR VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 65
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE verifycsr		&& Introduced in version 9.5.0.83. Verify the signature in the CSR. Return 1 if the signature is valid. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            VerifyCSR
		* Purpose:           Verify the signature in the CSR.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Verify the signature in the CSR. Return 1 if the signature is valid.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_CSR_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.VerifyCSR() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS csv AS ibasechilkat OF "chilkatvfp.vcx" 		&& A class for reading and updating CSV files. Provides methods for accessing cell contents by name or index, updating cells, reading and setting column names, etc.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: autotrim_access		&& Access method used to retrieve the Chilkat CSV AutoTrim property.
		*m: autotrim_assign		&& Assign method used to hold a reference to the AutoTrim property.
		*m: crlf_access		&& Access method used to retrieve the Chilkat CSV CRLF property.
		*m: crlf_assign		&& Assign method used to hold a reference to the CRLF property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat CSV DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deletecolumn		&& Deletes the Nth column. (The 1st column is at index 0.) Returns 1 for success, 0 for failure.
		*m: deletecolumnbyname		&& Deletes a column specified by name. Returns 1 for success, 0 for failure.
		*m: deleterow		&& Deletes the entire Nth row. (The 1st row is at index 0.) Returns 1 for success, 0 for failure.
		*m: delimiter_access		&& Access method used to retrieve the Chilkat CSV Delimiter property.
		*m: delimiter_assign		&& Assign method used to hold a reference to the Delimiter property.
		*m: enablequotes_access		&& Access method used to retrieve the Chilkat CSV EnableQuotes property.
		*m: enablequotes_assign		&& Assign method used to hold a reference to the EnableQuotes property.
		*m: escapebackslash_access		&& Access method used to retrieve the Chilkat CSV EscapeBackslash property.
		*m: escapebackslash_assign		&& Assign method used to hold a reference to the EscaoeBackslash property.
		*m: getcell		&& Returns the contents of the cell at row, col. Indexing begins at 0. (The topmost/leftmost cell is at 0,0) Returns Nothing on failure
		*m: getcellbyname		&& The same as GetCell, but the column is specified by name instead of by index. Returns Nothing on failure
		*m: getcolumnname		&& Returns the name of the Nth column. Returns Nothing on failure
		*m: getindex		&& Returns the column index for a given column.
		*m: getnumcols		&& Returns the number of columns for a specific row. If the row is larger than the number of rows in the CSV, a zero is returned.
		*m: hascolumnnames_access		&& Access method used to retrieve the Chilkat CSV HasColumnNames property.
		*m: hascolumnnames_assign		&& Assign method used to hold a reference to the HasColumnNames property.
		*m: insertcolumn		&& Introduced in version 9.5.0.89. Inserts a new and empty column before the Nth column. (The 1st column is at index 0.) Returns 1 for success, 0 for failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat CSV LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat CSV LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat CSV LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat CSV LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat CSV LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat CSV LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat CSV LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadfile		&& Loads a CSV from a file. It is assumed that the CSV file contains ANSI characters. Returns 1 for success, 0 for failure.
		*m: loadfile2		&& Loads a CSV from a file. The charset specifies the character encoding of the CSV file. A list of supported character encodings may be found on this page: Supported Charsets. Returns 1 for success, 0 for failure.
		*m: loadfromstring		&& Loads a CSV document from an in-memory string variable. Returns 1 for success, 0 for failure.
		*m: numcolumns_access		&& Access method used to retrieve the Chilkat CSV NumColumns property.
		*m: numcolumns_assign		&& Assign method used to hold a reference to the NumColumns property.
		*m: numrows_access		&& Access method used to retrieve the Chilkat CSV NumRows property.
		*m: numrows_assign		&& Assign method used to hold a reference to the NumRows property.
		*m: rowmatches		&& Compares the contents of an entire row to a wildcarded match pattern where "*" can be used any number of times to match 0 or more of any character. Returns 1 if a match was found, otherwise returns 0.
		*m: savefile		&& Saves a CSV to a file. The output file is written using the ANSI character encoding. Returns 1 for success, 0 for failure.
		*m: savefile2		&& Saves a CSV to a file. The charset specifies the character encoding to use for the CSV file. The text data is converted to this charset when saving. A list of supported character encodings may be found on this page: Supported Charsets.
		*m: savetosb		&& Introduced in version 9.5.0.93. Clears the contents of sb and writes the entire CSV into sb. Returns 1 for success, 0 for failure.
		*m: savetostring		&& Returns the entire CSV as a string. Returns Nothing on failure
		*m: setcell		&& Sets the contents for a single cell in the CSV. The content may include any characters including CRLF's, double-quotes, and the delimiter character. The Save* methods automatically double-quote fields with special chars when saving.
		*m: setcellbyname		&& The same as SetCell, except the column is specified by name instead of by index. Returns 1 for success, 0 for failure.
		*m: setcolumnname		&& Sets the name of the Nth column. The first column is at index 0. This method would only return 0 if an invalid index is passed (such as a negative number). Returns 1 for success, 0 for failure.
		*m: sortbycolumn		&& Sorts the rows in the CSV by the contents of a specific column. If ascending is 1, the sort is in ascending order, otherwise descending order. If caseSensitive is 1 then the sorting is case sensitive. Returns 1 for success, 0 for failure.
		*m: sortbycolumnindex		&& Introduced in version 9.5.0.83. Sorts the rows in the CSV by the contents of a specific column index. If ascending is 1, the sort is in ascending order, otherwise descending order. If caseSensitive is 1 then the sorting is case sensitive.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat CSV UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat CSV VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: xlsxdateformat_access		&& Access method used to retrieve the Chilkat CSV XLSXDateFormat property.
		*m: xlsxdateformat_assign		&& Assign method used to hold a reference to the XLSXDateFormat property.
		*m: xlsxgetsheets		&& Introduced in version 11.3.0. Returns the names of the sheets contained in the Excel spreadsheet. The xlsx is the Zip object containing the already opened .xlsx file. Returns 1 for success, 0 for failure.
		*m: xlsxloadsheet		&& Introduced in version 11.3.0. Loads the named sheet in the Excel spreadsheet into this CSV object. The zip is the Zip object containing the already opened .xlsx file. Returns 1 for success, 0 for failure.
		*p: autotrim		&& If 1, then the strings returned by GetCell and GetCellByName are auto-trimmed of whitespace from both ends.
		*p: crlf		&& If 1, then CRLF line endings are used when saving the CSV to a file or to a string (i.e. for the methods SaveFile, SaveFile2, SaveToString). If 0 then bare LF line-endings are used.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: delimiter		&& The character that separates fields in a record. It is a comma by default. If the Delimiter property is not explicitly set, the CSV component will detect the delimiter when loading a CSV.
		*p: enablequotes		&& Introduced in version 9.5.0.71.If 1, then the double-quote characters cause the quoted content, including CR's, LF's, and delimiter chars to be treated as normal text when reading/writing CSVs. The default is 1.
		*p: escapebackslash		&& Introduced in version 9.5.0.44. If 1, then the backslash character is treated as an escape character when reading/writing CSVs. The default is 0.
		*p: hascolumnnames		&& Set to 1 prior to loading a CSV if the 1st record contains column names. This allows the CSV parser to correctly load the column names and not treat them as data.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcolumns		&& The number of columns in the 1st row, which may be the row containing column names if HasColumnNames is 1.
		*p: numrows		&& The number of data rows. If the CSV has column names, the 1st row is not included in the count. Also, empty lines containing only whitespace characters that follow the last non-empty row are not included.
		*p: uncommonoptions		&& Introduced in version 9.5.0.88. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: xlsxdateformat		&& Introduced in version 11.3.0. The standard date format to use when converting Excel (.xlsx) spreadsheets to CSV. The default is "mm-dd-yy", but can be changed to "d/m/yyyy", or "m/d/yyyy", etc.
	*</DefinedPropArrayMethod>

	*<PropValue>
		autotrim = 0
		cchilkatclass = Csv
		crlf = 1
		debuglogfilepath = 
		delimiter = ,
		enablequotes = 1
		escapebackslash = 0
		hascolumnnames = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "csv"
		numcolumns = 0
		numrows = 0
		uncommonoptions = 
		verboselogging = 0
		xlsxdateformat = mm-dd-yy
	*</PropValue>
	
	HIDDEN PROCEDURE autotrim_access		&& Access method used to retrieve the Chilkat CSV AutoTrim property.
		*==============================================================================
		* Method:            AutoTrim_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSV AutoTrim property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoTrim
		* Date Added:        05/25/2022
		*==============================================================================
		
		**
		** If 1, then the strings returned by GetCell and GetCellByName 
		** are auto-trimmed of whitespace from both ends.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autotrim_assign		&& Assign method used to hold a reference to the AutoTrim property.
		*==============================================================================
		* Method:            AutoTrim_Assign
		* Purpose:           Assign method used to hold a reference to the AutoTrim property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoTrim property.
		* Returns:           
		* Date Added:        05/25/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 96
		
		  Added the UncommonOptions keywords “QuotedCells” and “QuotedColumnNames” 
		  to force double-quoted cells and column names when emitting CSV to a file or string buffer.
		
		** Version 93
		
		  Found that for CSV’s using utf-8, the utf-8 BOM (byte order mark) must be present
		  for Microsoft Excel to recognize the utf-8 encoding.
		  Added an uncommon option to tell Chilkat to emit the BOM:
		
		    csv.UncommonOptions("EMIT_BOM")
		
		** Version 89
		
		  When the Delimiter property is updated, the old delimiter will be replaced
		  with the new delimiter in all rows of the CSV.  The provides the ability
		  to convert a CSV to use a different delimiter, such as converting from comma to semicolon.
		
		  Added the InsertColumn method.
		
		** Version 83
		
		  Added the SortByColumnIndex method.
		
		** Version 82
		
		  GetNumCols(rowIndex) returned a cached row count after a row is deleted by DeleteRow.
		
		** Version 71
		
		  Added property EnableQuotes such if set to False/0,
		  causes the parser to not treat double-quotes chars as special.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 62
		
		  Minor CSV fix where the last line in a CSV file was inadvertently being trimmed of whitespace on both ends.
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		 (FIXED) Csv.WriteFile2 did not work with utf-16.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 51
		
		  Fixed problems relating to empty cells, such as when setting the 1st column in a new row to an empty string.
		
		** Version 48
		
		  When writing CSV’s, the inner LF, CRLF, etc. of a row will now remain unmodified.
		  The Crlf property controls the line-endings for each entire row,
		  but should have no effect (and cause no changes) of LF / CRLF usage within any given cell.
		
		** Version 44
		
		  In the CSV API, the exact line-endings, such as CRLF or bare-LF, are now preserved within each cell.
		  However, the line-endings used at end of each entire row are still controlled by the Crlf property.
		
		  Added the Csv.EscapeBackslash property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE crlf_access		&& Access method used to retrieve the Chilkat CSV CRLF property.
		*==============================================================================
		* Method:            CRLF_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSV CRLF property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CRLF
		* Date Added:        05/25/2022
		*==============================================================================
		
		**
		** If 1, then CRLF line endings are used when saving the CSV to a file 
		** or to a string (i.e. for the methods SaveFile, SaveFile2, SaveToString). 
		** If 0 then bare LF line-endings are used.
		**
		** Change for Version 44: In the CSV API, the exact line-endings, such as CRLF or bare-LF, 
		** are now preserved within each cell. However, the line-endings used at end 
		** of each entire row are still controlled by this property.
		**
		** Enhancement for Version 48: When writing CSV’s, the inner LF, CRLF, etc. of a row 
		** will now remain unmodified. This property controls the line-endings for each entire row, 
		** but should have no effect (and cause no changes) of LF / CRLF usage within any given cell.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE crlf_assign		&& Assign method used to hold a reference to the CRLF property.
		*==============================================================================
		* Method:            CRLF_Assign
		* Purpose:           Assign method used to hold a reference to the CRLF property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the CRLF property.
		* Returns:           
		* Date Added:        05/25/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat CSV DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSV DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        05/25/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
