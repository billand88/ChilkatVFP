	HIDDEN PROCEDURE readonly_access		&& Access method used to retrieve the Chilkat CreateCS ReadOnly property.
		*==============================================================================
		* Method:            ReadOnly_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CreateCS ReadOnly property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReadOnly
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Determines whether certificate stores are opened with read-only or read/write permissions. 
		** Only applies to methods such as OpenCurrentUserStore, 
		** where the a readOnly parameter is not present.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE readonly_assign		&& Assign method used to hold a reference to the ReadOnly property.
		*==============================================================================
		* Method:            ReadOnly_Assign
		* Purpose:           Assign method used to hold a reference to the ReadOnly property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the ReadOnly property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat CreateCS VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS crypt2 AS ibasechilkat OF "chilkatvfp.vcx" 		&& Chilkat encryption component.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat Crypt2 AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: addencryptcert		&& Adds a certificate to be used for public-key encryption. (To use public-key encryption with digital certificates, set the CryptAlgorithm property = "pki".) To encrypt with more than one certificate, call AddEncryptCert once per certificate.
		*m: addpfxsourcebd		&& Introduced in version 11.0.0. Adds a PFX file to the object's list of sources for locating certificates and private keys during decryption or signing. To add multiple PFX sources, call this method for each file.
		*m: addpfxsourcedata		&& Adds a PFX to the object's internal list of sources to be searched for certificates and private keys when decrypting. Multiple PFX sources can be added by calling this method once for each.
		*m: addpfxsourcefile		&& Adds a PFX file to the object's internal list of sources to be searched for certificates and private keys when decrypting. Multiple PFX files can be added by calling this method once for each.
		*m: addsigningcert		&& Introduced in version 9.5.0.83. Adds a certificate to be used for signing. To sign with more than one certificate, call AddSigningCert once per certificate. Note: This method was added in v9.5.0.83.
		*m: aeskeyunwrap		&& Introduced in version 9.5.0.66. Implements the AES Key Wrap Algorithm (RFC 3394) for unwrapping. The kek is the Key Encryption Key (the AES key used to unwrap the wrappedKeyData).
		*m: aeskeyunwrapwithpadding		&& Introduced in version 9.5.0.96. Implements the AES Key Wrap with Padding Algorithm (RFC 5649) for unwrapping. The kek is the Key Encryption Key (the AES key used to unwrap the wrappedKeyData).
		*m: aeskeywrap		&& Introduced in version 9.5.0.66. Implements the AES Key Wrap Algorithm (RFC 3394). The kek is the Key Encryption Key (the AES key used to encrypt the keyData).
		*m: aeskeywrapwithpadding		&& Introduced in version 9.5.0.96. Implements the AES Key Wrap with Padding Algorithm (RFC 5649). The kek is the Key Encryption Key (the AES key used to encrypt the keyData).
		*m: argon2derivekey		&& Introduced in version 11.6.0. Derives a key from a password using Argon2, the memory-hard key derivation function specified in RFC 9106. Returns 1 for success, 0 for failure.
		*m: argon2hashpassword		&& Introduced in version 11.6.0. Hashes a password using Argon2 (RFC 9106) and returns the result as a PHC format string, such as $argon2id$v=19$m=65536,t=3,p=1$c29tZXJhbmRvbXNhbHQ$3fJ7v1qKcVJ0lHqXjBQZ8mYm3sNTfSPRt0bqDl9kEyM. Returns Nothing on failure.
		*m: argon2verifypassword		&& Introduced in version 11.6.0. Verifies password against a PHC format Argon2 hash string previously produced by Argon2HashPassword (or by any other RFC 9106 implementation).
		*m: bcrypthash		&& Introduced in version 9.5.0.65. Computes and returns a bcrypt hash of the password. The number of rounds of hashing is determined by the BCryptWorkFactor property.
		*m: bcryptverify		&& Introduced in version 9.5.0.65. Verifies the password against a previously computed BCrypt hash. Returns 1 if the password matches the bcryptHash. Returns 0 if the password does not match. Returns 1 for success, 0 for failure.
		*m: bcryptworkfactor_access		&& Access method used to retrieve the Chilkat Crypt2 BCryptWorkFactor property.
		*m: bcryptworkfactor_assign		&& Assign method used to hold a reference to the BCryptWorkFactor property.
		*m: blocksize_access		&& Access method used to retrieve the Chilkat Crypt2 BlockSize property.
		*m: blocksize_assign		&& Assign method used to hold a reference to the BlockSize property.
		*m: bytestostring		&& Utility method to convert bytes to a string -- interpreting the bytes according to the charset specified. Returns Nothing on failure
		*m: byteswap4321		&& Convenience method for byte swapping between little-endian byte ordering and big-endian byte ordering. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: byteswapondecrypt_access		&& Access method used to retrieve the Chilkat Crypt2 ByteSwapOnDecrypt property.
		*m: byteswapondecrypt_assign		&& Assign method used to hold a reference to the ByteSwapOnDecrypt property.
		*m: cadesenabled_access		&& Access method used to retrieve the Chilkat Crypt2 CadesEnabled property.
		*m: cadesenabled_assign		&& Assign method used to hold a reference to the CadesEnabled property.
		*m: cadessigpolicyhash_access		&& Access method used to retrieve the Chilkat Crypt2 CadesSigPolicyHash property.
		*m: cadessigpolicyhash_assign		&& Assign method used to hold a reference to the CadesSigPolicyHash property.
		*m: cadessigpolicyid_access		&& Access method used to retrieve the Chilkat Crypt2 CadesSigPolicyID property.
		*m: cadessigpolicyid_assign		&& Assign method used to hold a reference to the CadesSigPolicyID property.
		*m: cadessigpolicyuri_access		&& Access method used to retrieve the Chilkat Crypt2 CadesSigPolicyURI property.
		*m: cadessigpolicyuri_assign		&& Assign method used to hold a reference to the CadesSigPolicyURI property.
		*m: charset_access		&& Access method used to retrieve the Chilkat Crypt2 Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: ciphermode_access		&& Access method used to retrieve the Chilkat Crypt2 CipherMode property.
		*m: ciphermode_assign		&& Assign method used to hold a reference to the CipherMode property.
		*m: ckdecryptfile		&& File-to-file decryption. There is no limit to the size of the file that can be decrypted because the component will operate in streaming mode internally. Returns 1 for success, 0 for failure.
		*m: ckdecryptfileasync		&& Creates an asynchronous task to call the CkDecryptFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: ckencryptfile		&& File-to-file encryption. There is no limit to the size of the file that can be encrypted because the component will operate in streaming mode internally. Returns 1 for success, 0 for failure.
		*m: ckencryptfileasync		&& Creates an asynchronous task to call the CkEncryptFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: clearencryptcerts		&& Clears the internal list of digital certificates to be used for public-key encryption.
		*m: clearsigningcerts		&& Introduced in version 9.5.0.83. Clears the set of certificates to be used in signing. Returns 1 for success, 0 for failure.
		*m: cmsoptions_access		&& Access method used to retrieve the Chilkat Crypt2 CMSOptions property.
		*m: cmsoptions_assign		&& Assign method used to hold a reference to the CMSOptions property.
		*m: compressbytes		&& Bzip2 compresses a byte array and returns the compressed bytes. This is a legacy method that should not be used in new development.
		*m: compressbytesenc		&& Same as CompressBytes, except an encoded string is returned. The output encoding is specified by the EncodingMode property. Returns Nothing on failure.
		*m: compressionalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 CompressionAlgorithm property.
		*m: compressionalgorithm_assign		&& Assign method used to hold a reference to the CompressionAlgorithm property.
		*m: compressstring		&& Compresses a string and returns the compressed bytes. Prior to compressing, the string is converted to a byte representation such as utf-8, utf-16, etc. as determined by the Charset property.
		*m: compressstringenc		&& Compresses a string and returns the encoded compressed bytes. Prior to compressing, the string is converted to a byte representation such as utf-8, utf-16, etc. as determined by the Charset property.
		*m: cosign		&& Introduced in version 9.5.0.89. Co-sign's an existing CMS signature. bdIn contains the existing CMS signature. If successful, cert is the output co-signed CMS signature. Returns 1 for success, 0 for failure.
		*m: crcbd		&& Introduced in version 11.0.0. Computes a CRC for data contained in crcAlg, which can be either crc-32 used in the Zip file format, or crc8 for the CRC8 algorithm.
		*m: crcbytes		&& Introduced in version 9.5.0.38. Calculates a CRC for in-memory byte data. To compute the CRC used in the Zip file format, pass "CRC-32" (or CRC32, case insensitive) for the crcAlg.
		*m: crcfile		&& Introduced in version 9.5.0.38. Calculates a CRC for the contents of a file. To compute the CRC used in the Zip file format, pass "CRC-32" for the crcAlg.
		*m: crcfileasync		&& Introduced in version 9.5.0.38. Creates an asynchronous task to call the CrcFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: createdetachedsignature		&& Digitally signs a file and writes the digital signature to a separate output file (a PKCS#7 signature file). The input file (inFilePath) is unmodified.
		*m: createp7m		&& Digitally signs a file and creates a .p7m (PKCS #7 Message) file that contains both the signature and original file content. The input file (inFilename) is unmodified.
		*m: createp7masync		&& Creates an asynchronous task to call the CreateP7M method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: createp7s		&& Digitally signs a file and creates a .p7s (PKCS #7 Signature) signature file. The input file (inFilename) is unmodified. The output file (p7sPath) contains only the signature and not the original data.
		*m: createp7sasync		&& Creates an asynchronous task to call the CreateP7S method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: cryptalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 CryptAlgorithm property.
		*m: cryptalgorithm_assign		&& Assign method used to hold a reference to the CryptAlgorithm property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Crypt2 DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: decode		&& Decode binary data from an encoded string.
		*m: decodestring		&& Decodes from an encoding back to the original string.
		*m: decryptbd		&& Introduced in version 9.5.0.67. In-place decrypts the contents of bd. The minimal set of properties that should be set before decrypting are: CryptAlgorithm, SecretKey.
		*m: decryptbytes		&& Decrypts a byte array and returns the unencrypted byte array. The property settings used when encrypting the data must match the settings when decrypting.
		*m: decryptbytesenc		&& Decrypts string-encoded encrypted data and returns the unencrypted byte array. Data encrypted with EncryptBytesENC can be decrypted with this method.
		*m: decryptencoded		&& Encrypted data is passed to this method as an encoded string (base64, hex, etc.). This method first decodes the input data according to the EncodingMode property setting.
		*m: decryptsb		&& Introduced in version 9.5.0.67. Decrypts the contents of bdIn to sbOut. The decrypted string is appended to sbOut. The minimal set of properties that should be set before ecrypting are: CryptAlgorithm, SecretKey.
		*m: decryptsecureenc		&& Introduced in version 9.5.0.71. Identical to DecryptStringENC, except the decrypts the cipherText and appends the decrypted string to the secureStr. Returns 1 for success, 0 for failure.
		*m: decryptstream		&& Introduced in version 9.5.0.56. Decrypts a stream. Internally, the strm's source is read, decrypted, and the decrypted data written to the strm's sink. It does this in streaming fashion.
		*m: decryptstreamasync		&& Introduced in version 9.5.0.56. Creates an asynchronous task to call the DecryptStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decryptstring		&& The reverse of EncryptString. Decrypts encrypted byte data and returns the original string. The property settings used when encrypting the string must match the settings when decrypting.
		*m: decryptstringenc		&& The reverse of EncryptStringENC. Decrypts string-encoded encrypted data and returns the original string. The property settings used when encrypting the string must match the settings when decrypting.
		*m: encode		&& Encode binary data to base64, hex, quoted-printable, or URL-encoding.
		*m: encodeint		&& Introduced in version 9.5.0.77. Encodes an integer to N bytes and returns in the specified encoding. If littleEndian is 1, then little endian byte ordering is used. Otherwise big-endian byte order is used. Returns Nothing on failure.
		*m: encodestring		&& Encodes a string.
		*m: encodingmode_access		&& Access method used to retrieve the Chilkat Crypt2 EncodingMode property.
		*m: encodingmode_assign		&& Assign method used to hold a reference to the EncodingMode property.
		*m: encryptbd		&& Introduced in version 9.5.0.67. In-place encrypts the contents of bd. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey.
		*m: encryptbytes		&& Encrypts a byte array. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey.
		*m: encryptbytesenc		&& Encrypts a byte array and returns the encrypted data as an encoded (printable) string.
		*m: encryptencoded		&& The input string is first decoded according to the encoding algorithm specified by the EncodingMode property (such as base64, hex, etc.) It is then encrypted according to the encryption algorithm specified by CryptAlgorithm.
		*m: encryptsb		&& Introduced in version 9.5.0.67. Encrypts the contents of sbIn to bdOut.
		*m: encryptsecureenc		&& Introduced in version 9.5.0.71. Identical to EncryptStringENC, except the clear-text contained within the secureStr is encrypted and returned. Returns Nothing on failure.
		*m: encryptstream		&& Introduced in version 9.5.0.56. Encrypts a stream. Internally, the strm's source is read, encrypted, and the encrypted data written to the strm's sink. It does this in streaming fashion.
		*m: encryptstreamasync		&& Introduced in version 9.5.0.56. Creates an asynchronous task to call the EncryptStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: encryptstring		&& Encrypts a string and returns the encrypted data as a byte array. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey, Charset.
		*m: encryptstringenc		&& Encrypts a string and returns the encrypted data as an encoded (printable) string. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey, Charset, and EncodingMode.
		*m: firstchunk_access		&& Access method used to retrieve the Chilkat Crypt2 FirstChunk property.
		*m: firstchunk_assign		&& Assign method used to hold a reference to the FirstChunk property.
		*m: genencodedsecretkey		&& Identical to the GenerateSecretKey method, except it returns the binary secret key as a string encoded according to encoding, which may be "base64", "hex", "url", etc. Please see the documentation for GenerateSecretKey for more information.
		*m: generatesecretkey		&& Hashes a string to a byte array that has the same number of bits as the current value of the KeyLength property. For example, if KeyLength is equal to 128 bits, then a 16-byte array is returned.
		*m: generateuuid		&& Introduced in version 9.5.0.55. Generates a random UUID string having standard UUID format, such as "de305d54-75b4-431b-adb2-eb6b9e546014". Note: This generates a "version 4 UUID" using random byte values. See RFC 4122. Returns Nothing on failure.
		*m: genrandombytesenc		&& Generates numBytes random bytes and returns them as an encoded string. The encoding, such as base64, hex, etc. is controlled by the EncodingMode property. Returns Nothing on failure.
		*m: getdecryptcert		&& Introduced in version 9.5.0.46. Returns the last certificate used for public-key decryption. Returns Nothing on failure
		*m: getencodedaad		&& Introduced in version 9.5.0.55. Returns the authenticated additional data as an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", or "url".
		*m: getencodedauthtag		&& Introduced in version 9.5.0.55. Returns the authentication tag as an encoded string. The encoding argument may be set to any of the following strings: "base64", "hex", "quoted-printable", or "url"
		*m: getencodediv		&& Returns the initialization vector as an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", or "url". Returns Nothing on failure.
		*m: getencodedkey		&& Returns the secret key as an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", or "url". Returns Nothing on failure.
		*m: getencodedsalt		&& Returns the password-based encryption (PBE) salt bytes as an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", or "url". Returns Nothing on failure.
		*m: getlastcert		&& Returns the last certificate used when verifying a signature. This method is decremented. Applications should instead call GetSignerCert with an index of 0. Returns Nothing on failure.
		*m: getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData.
		*m: getsignaturesigningtime		&& Undocumented method! This method can be called after a digital signature is verified to retrieve the signing time of the Nth certificate used for signing. The 1st certificate/signing time is at index 0.
		*m: getsignaturesigningtimestr		&& The same as GetSignatureSigningTime, except the date/time is returned in RFC822 string format. Returns Nothing on failure
		*m: getsignedattributes		&& Introduced in version 9.5.0.75. Extracts the signed (authenticated) attributes for the Nth signer. In most cases, a signature has only one signer, and the signerIndex should equal 0 to specify the 1st (and only) signer.
		*m: getsignercert		&& Gets the Nth certificate used for signing. This method can be called after verifying a digital signature to get the signer certs. The 1st certificate is at index 0. The NumSignerCerts property contains the total number of signing certificates.
		*m: getsignercertchain		&& Introduced in version 9.5.0.40. Returns the full certificate chain for the Nth certificate used to for signing. Indexing begins at 0. Returns Nothing on failure
		*m: hashalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 HashAlgorithm property.
		*m: hashalgorithm_assign		&& Assign method used to hold a reference to the HashAlgorithm property.
		*m: hashbdenc		&& Introduced in version 9.5.0.66. Hashes the the bytes contained in bd and returns the hash as an encoded string. The hash algorithm is specified by the HashAlgorithm property.
		*m: hashbeginbytes		&& Begin hashing a byte stream. Call this method to hash the 1st chunk. Additional chunks are hashed by calling HashMoreBytes 0 or more times followed by a final call to HashFinal (or HashFinalENC) to retrieve the result.
		*m: hashbeginstring		&& Begin hashing a text stream. Call this method to hash the 1st chunk. Additional chunks are hashed by calling HashMoreString 0 or more times followed by a final call to HashFinal (or HashFinalENC) to retrieve the result.
		*m: hashbytes		&& Hashes a byte array. The hash algorithm is specified by the HashAlgorithm property, The encoding is controlled by the EncodingMode property, which can be set to "base64", "hex", "base64url", or any of the encodings listed at the link below.
		*m: hashbytesenc		&& Hashes a byte array and returns the hash as an encoded string. The hash algorithm is specified by the HashAlgorithm property.
		*m: hashchunkbd		&& Introduced in version 11.1.0. Start or continue hashing data in chunks. Set firstChunk to 1 for the first chunk, and 0 for subsequent chunks. Finish by calling HashFinalENC to obtain the result. Returns 1 for success, 0 for failure.
		*m: hashfile		&& Hashes a file and returns the hash bytes. The hash algorithm is specified by the HashAlgorithm property, Any size file may be hashed because the file is hashed internally in streaming mode (keeping memory usage low and constant).
		*m: hashfileasync		&& Creates an asynchronous task to call the HashFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: hashfileenc		&& Hashes a file and returns the hash as an encoded string. The hash algorithm is specified by the HashAlgorithm property,
		*m: hashfileencasync		&& Creates an asynchronous task to call the HashFileENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: hashfinal		&& Finalizes a multi-step hash computation and returns the hash bytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: hashfinalenc		&& Finalizes a multi-step hash computation and returns the hash bytes encoded according to the EncodingMode property setting. Returns Nothing on failure.
		*m: hashmorebytes		&& Introduced in version 9.5.0.82. Adds more bytes to the hash currently under computation. (See HashBeginBytes) Returns 1 for success, 0 for failure.
		*m: hashmorestring		&& Adds more text to the hash currently under computation. (See HashBeginString) Returns 1 for success, 0 for failure.
		*m: hashstring		&& Hashes a string and returns a binary hash. The hash algorithm is specified by the HashAlgorithm property, The Charset property controls the character encoding of the string that is hashed.
		*m: hashstringenc		&& Hashes a string and returns the hash bytes as an encoded string.
		*m: hassignaturesigningtime		&& This method can be called after a digital signature has been verified by one of the Verify* methods.
		*m: havalrounds_access		&& Access method used to retrieve the Chilkat Crypt2 HAVALRounds property.
		*m: havalrounds_assign		&& Assign method used to hold a reference to the HAVALRounds property.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat Crypt2 HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: hmacbytes		&& Undocumented method! Computes a keyed-Hash Message Authentication Code (HMAC or KHMAC), which is a type of message authentication code (MAC) calculated using a specific algorithm involving a cryptographic hash function in combination with a secret key.
		*m: hmacbytesenc		&& Undocumented method! Computes an HMAC using a secret key and hash algorithm. The result is encoded to a string using the encoding (base64, hex, etc.) specified by the EncodingMode property.
		*m: hmacstring		&& Undocumented method! Computes an HMAC using a secret key and hash algorithm.The secret key is set by calling one of the following methods prior to calling this method: SetHmacKeyBytes, SetHmacKeyEncoded, or SetHmacKeyString.
		*m: hmacstringenc		&& Undocumented method! Computes an HMAC using a secret key and hash algorithm. The result is encoded to a string using the encoding (base64, hex, etc.) specified by the EncodingMode property.
		*m: hotp		&& Introduced in version 9.5.0.77. Implements RFC 4226: HOTP: An HMAC-Based One-Time Password Algorithm.
		*m: includecertchain_access		&& Access method used to retrieve the Chilkat Crypt2 IncludeCertChain property.
		*m: includecertchain_assign		&& Assign method used to hold a reference to the IncludeCertChain property.
		*m: inflatebytes		&& Decompresses data that was compressed with CompressBytes.
		*m: inflatebytesenc		&& The opposite of CompressBytesENC. The EncodingMode and CompressionAlgorithm properties should match what was used when compressing. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: inflatestring		&& The opposite of CompressString. The Charset and CompressionAlgorithm properties should match what was used when compressing. Returns Nothing on failure
		*m: inflatestringenc		&& The opposite of CompressStringENC. The Charset, EncodingMode, and CompressionAlgorithm properties should match what was used when compressing. Returns Nothing on failure.
		*m: initialcount_access		&& Access method used to retrieve the Chilkat Crypt2 IncludeCount property.
		*m: initialcount_assign		&& Assign method used to hold a reference to the IncludeCount property.
		*m: isunlocked		&& Undocumented methiod! Returns true if the component is unlocked.
		*m: iterationcount_access		&& Access method used to retrieve the Chilkat Crypt2 IterationCount property.
		*m: iterationcount_assign		&& Assign method used to hold a reference to the IterationCount property.
		*m: iv_access		&& Access method used to retrieve the Chilkat Crypt2 IV property.
		*m: iv_assign		&& Assign method used to hold a reference to the IV property.
		*m: keylength_access		&& Access method used to retrieve the Chilkat Crypt2 KeyLength property.
		*m: keylength_assign		&& Assign method used to hold a reference to the KeyLength property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Crypt2 LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastchunk_access		&& Access method used to retrieve the Chilkat Crypt2 LastChunk property.
		*m: lastchunk_assign		&& Assign method used to hold a reference to the LastChunk property.
		*m: lastdecryptcert		&& Introduced in version 11.0.0. Returns in cert the last certificate used for public-key decryption. Returns 1 for success, 0 for failure.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Crypt2 LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Crypt2 LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Crypt2 LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastjsondata		&& Introduced in version 9.5.0.70. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Crypt2 LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastsignercert		&& Introduced in version 11.0.0. Returns the Nth certificate used for signing in cert. This method can be called after verifying a digital signature to get the signer certs. The 1st certificate is at index 0. Returns 1 for success, 0 for failure.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Crypt2 LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Crypt2 LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: macalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 MACAlgorithm property.
		*m: macalgorithm_assign		&& Assign method used to hold a reference to the MACAlgorithm property.
		*m: macbdenc		&& Introduced in version 9.5.0.66. Computes a Message Authentication Code on the bytes contained in bd, using the MAC algorithm specified in the MacAlgorithm property.
		*m: macbytes		&& Introduced in version 9.5.0.55. Computes a Message Authentication Code using the MAC algorithm specified in the MacAlgorithm property. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: macbytesenc		&& Computes a Message Authentication Code using the MAC algorithm specified in the MacAlgorithm property. The result is encoded to a string using the encoding (base64, hex, etc.) specified by the EncodingMode property.
		*m: macstring		&& Introduced in version 9.5.0.55. Computes a Message Authentication Code using the MAC algorithm specified in the MacAlgorithm property. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: macstringenc		&& Introduced in version 9.5.0.55. Computes a Message Authentication Code using the MAC algorithm specified in the MacAlgorithm property. The result is encoded to a string using the encoding (base64, hex, etc.) specified by the EncodingMode property.
		*m: mysqlaesdecrypt		&& Matches MySQL's AES_DECRYPT function. strEncryptedHex is a hex-encoded string of the AES encrypted data. The return value is the original unencrypted string. Returns Nothing on failure.
		*m: mysqlaesencrypt		&& Matches MySQL's AES_ENCRYPT function. The return value is a hex-encoded string of the encrypted data. The equivalent call in MySQL would look like this: HEX(AES_ENCRYPT('The quick brown fox jumps over the lazy dog','password')) Returns Nothing on failure.
		*m: numsignercerts_access		&& Access method used to retrieve the Chilkat Crypt2 NumSignerCerts property.
		*m: numsignercerts_assign		&& Assign method used to hold a reference to the NumSignerCerts property.
		*m: oaephash_access		&& Access method used to retrieve the Chilkat Crypt2 OAEPHash property.
		*m: oaephash_assign		&& Assign method used to hold a reference to the OAEPHash property.
		*m: oaepmgfhash_access		&& Access method used to retrieve the Chilkat Crypt2 OAEPMGFHash property.
		*m: oaepmgfhash_assign		&& Assign method used to hold a reference to the OAEPMGFHash property.
		*m: oaeppadding_access		&& Access method used to retrieve the Chilkat Crypt2 OAEPPadding property.
		*m: oaeppadding_assign		&& Assign method used to hold a reference to the OAEPPadding property.
		*m: opaquesignbd		&& Introduced in version 9.5.0.67. In-place signs the contents of bd. The contents of bd is replaced with the PKCS7/CMS format signature that embeds the data that was signed. Returns 1 for success, 0 for failure.
		*m: opaquesignbdasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the OpaqueSignBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: opaquesignbytes		&& Digitally signs a byte array and returns a PKCS7/CMS format signature. This is a signature that contains both the original data as well as the signature. A certificate must be set by calling SetSigningCert prior to calling this method.
		*m: opaquesignbytesasync		&& Creates an asynchronous task to call the OpaqueSignBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: opaquesignbytesenc		&& Digitally signs a byte array and returns a PKCS7/CMS format signature in encoded string format (such as Base64 or hex). This is a signature that contains both the original data as well as the signature.
		*m: opaquesignbytesencasync		&& Creates an asynchronous task to call the OpaqueSignBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: opaquesignstring		&& Digitally signs a string and returns a PKCS7/CMS format signature. This is a signature that contains both the original data as well as the signature. A certificate must be set by calling SetSigningCert prior to calling this method.
		*m: opaquesignstringasync		&& Creates an asynchronous task to call the OpaqueSignString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: opaquesignstringenc		&& Digitally signs a string and returns a PKCS7/CMS format signature in encoded string format (such as base64 or hex). This is a signature that contains both the original data as well as the signature.
		*m: opaquesignstringencasync		&& Creates an asynchronous task to call the OpaqueSignStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: opaqueverifybd		&& Introduced in version 9.5.0.67. In-place verifies and unwraps the PKCS7/CMS contents of bd. If the signature is verified, the contents of bd will be replaced with the original data, and the method returns 1.
		*m: opaqueverifybytes		&& Verifies an opaque signature and returns the original data. If the signature verification fails, the returned data will be 0 bytes in length.
		*m: opaqueverifybytesenc		&& Verifies an opaque signature (encoded in string form) and returns the original data. If the signature verification fails, the returned data will be 0 bytes in length.
		*m: opaqueverifystring		&& Verifies an opaque signature and returns the original string. If the signature verification fails, the returned string will be 0 characters in length.
		*m: opaqueverifystringenc		&& Verifies an opaque signature (encoded in string form) and returns the original data string. If the signature verification fails, the returned string will be 0 characters in length.
		*m: paddingscheme_access		&& Access method used to retrieve the Chilkat Crypt2 PaddingScheme property.
		*m: paddingscheme_assign		&& Assign method used to hold a reference to the PaddingScheme property.
		*m: pbesalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 PBESAlgorithm property.
		*m: pbesalgorithm_assign		&& Assign method used to hold a reference to the PBESAlgorithm property.
		*m: pbespassword_access		&& Access method used to retrieve the Chilkat Crypt2 PBESPassword property.
		*m: pbespassword_assign		&& Assign method used to hold a reference to the PBESPassword property.
		*m: pbkdf1		&& Implements the PBKDF1 algorithm (Password Based Key Derivation Function #1). The password is converted to the character encoding represented by charset before being passed (internally) to the key derivation function.
		*m: pbkdf2		&& Implements the PBKDF2 algorithm (Password Based Key Derivation Function #2). The password is converted to the character encoding represented by charset before being passed (internally) to the key derivation function.
		*m: pkcs7cryptalg_access		&& Access method used to retrieve the Chilkat Crypt2 PKCS7CryptAlg property.
		*m: pkcs7cryptalg_assign		&& Assign method used to hold a reference to the PKCS7CryptAlg property.
		*m: pkcs7extractdigest		&& Undocumented method! Extracts the signature digest contained within a PKCS7 signature. The PKCS7 is passed in the encoding determined by the EncodingMode property (such as base64, hex, etc.) an the signature digest is returned in the same encoding.
		*m: randomizeiv		&& Sets the initialization vector to a random value.
		*m: randomizekey		&& Sets the secret key to a random value.
		*m: rc2effectivekeylength_access		&& Access method used to retrieve the Chilkat Crypt2 RC2EffectiveKeyLength property.
		*m: rc2effectivekeylength_assign		&& Assign method used to hold a reference to the RC2EffectiveKeyLength property.
		*m: readfile		&& Convenience method to read an entire file and return as a byte array. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: reencode		&& Provides a means for converting from one encoding to another (such as base64 to hex). This is helpful for programming environments where byte arrays are a real pain-in-the-***.
		*m: salt_access		&& Access method used to retrieve the Chilkat Crypt2 Salt property.
		*m: salt_assign		&& Assign method used to hold a reference to the Salt property.
		*m: secretkey_access		&& Access method used to retrieve the Chilkat Crypt2 SecretKey property.
		*m: secretkey_assign		&& Assign method used to hold a reference to the SecretKey property.
		*m: setdecryptcert		&& Sets the digital certificate to be used for decryption when the CryptAlgorithm property is set to "PKI". A private key is required for decryption.
		*m: setdecryptcert2		&& Sets the digital certificate to be used for decryption when the CryptAlgorithm property is set to "PKI". The private key is supplied in the 2nd argument to this method, so there is no requirement
		*m: setencodedaad		&& Introduced in version 9.5.0.55. Sets the authenticated additional data from an encoded string. The authenticated additional data (AAD), if any, is used in authenticated encryption modes such as GCM.
		*m: setencodedauthtag		&& Introduced in version 9.5.0.55. Sets the expected authenticated tag from an encoded string. The authenticated tag is used in authenticated encryption modes such as GCM.
		*m: setencodediv		&& Sets the initialization vector from an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", "ascii", or "url".
		*m: setencodedkey		&& Sets the secret key from an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", "ascii", or "url".
		*m: setencodedsalt		&& Sets the password-based encryption (PBE) salt bytes from an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", "ascii", or "url".
		*m: setencryptcert		&& Tells the encryption library to use a specific digital certificate for public-key encryption. To encrypt with multiple certificates, call AddEncryptCert once for each certificate.
		*m: sethmackeybytes		&& Undocumented method! Sets the HMAC key to be used for one of the HMAC methods. Note: If using Chilkat v9.5.0.55 or later, update your programs to use SetMacKeyBytes instead.
		*m: sethmackeyencoded		&& Undocumented method! Sets the secret key to be used for one of the HMAC methods. The encoding can be set to any of the following strings: "base64", "hex", "quoted-printable", or "url".
		*m: sethmackeystring		&& Undocumented method! Sets the MAC key to be used for one of the HMAC methods. Note: If using Chilkat v9.5.0.55 or later, update your programs to use SetMacKeyString instead.
		*m: setmackeybytes		&& Introduced in version 9.5.0.55. Sets the MAC key to be used for one of the Mac methods. Returns 1 for success, 0 for failure.
		*m: setmackeyencoded		&& Introduced in version 9.5.0.55. Sets the MAC key to be used for one of the Mac methods. The encoding can be set to any of the following strings: "base64", "hex", "quoted-printable", or "url". Returns 1 for success, 0 for failure.
		*m: setmackeystring		&& Introduced in version 9.5.0.55. Sets the MAC key to be used for one of the Mac methods. Returns 1 for success, 0 for failure.
		*m: setsecretkeyviapassword		&& Accepts a password string and (internally) generates a binary secret key of the appropriate bit length and sets the SecretKey property.
		*m: setsigningcert		&& Specifies a certificate to be used when creating PKCS7 digital signatures. Signing requires both a certificate and private key.
		*m: setsigningcert2		&& Specifies a digital certificate and private key to be used for creating PKCS7 digital signatures. Returns 1 for success, 0 for failure.
		*m: settsahttpobj		&& Sets the timestamp authority (TSA) options for cases where a CAdES-T signature is to be created. The http is used to send the requests, and it allows for connection related settings and timeouts to be set.
		*m: setverifycert		&& Sets the digital certificate to be used in verifying a signature. Returns 1 for success, 0 for failure.
		*m: shorten		&& Chops N bytes from the end of a byte array. Accepts a Variant, which could be anything (internally) but always returns a Variant containing a byte array. Returns a zero-length byte array (as a Variant) on failure.
		*m: signbdenc		&& Introduced in version 9.5.0.67. Digitally signs the contents of dataToSign and returns the detached digital signature in an encoded string (according to the EncodingMode property setting). Returns Nothing on failure
		*m: signbdencasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the SignBdENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: signbytes		&& Digitally signs a byte array and returns the detached digital signature. A certificate must be set by calling SetSigningCert prior to calling this method. Returns a zero-length byte array (as a Variant) on failure.
		*m: signbytesasync		&& Creates an asynchronous task to call the SignBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: signbytesenc		&& Digitally signs a byte array and returns the detached digital signature encoded as a printable string. A certificate must be set by calling SetSigningCert prior to calling this method.
		*m: signbytesencasync		&& Creates an asynchronous task to call the SignBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: signhashenc		&& Introduced in version 9.5.0.90. Digitally signs a hash and returns the PKCS7 detached digital signature as an encoded string. The hash to be signed is passed in encodedHash.
		*m: signhashencasync		&& Introduced in version 9.5.0.90. Creates an asynchronous task to call the SignHashENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: signingalg_access		&& Access method used to retrieve the Chilkat Crypt2 SigningAlg property.
		*m: signingalg_assign		&& Assign method used to hold a reference to the SigningAlg property.
		*m: signingattributes_access		&& Access method used to retrieve the Chilkat Crypt2 SigningAttributes  property.
		*m: signingattributes_assign		&& Assign method used to hold a reference to the SigningAttributes property.
		*m: signsbenc		&& Introduced in version 9.5.0.67. Digitally signs a the contents of sb and returns the PKCS7 detached digital signature as an encoded string according to the EncodingMode property setting. Returns Nothing on failure
		*m: signsbencasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the SignSbENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: signstring		&& Digitally signs a string and returns the detached digital signature. A certificate must be set by calling SetSigningCert prior to calling this method. The Charset property controls the character encoding of the string that is signed.
		*m: signstringasync		&& Creates an asynchronous task to call the SignString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: signstringenc		&& Digitally signs a string and returns the PKCS7 detached digital signature as an encoded string. A certificate must be set by calling SetSigningCert prior to calling this method.
		*m: signstringencasync		&& Creates an asynchronous task to call the SignStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: stringtobytes		&& Convert a string to a byte array where the characters are encoded according to the charset specified. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: totp		&& Introduced in version 9.5.0.77. Implements RFC 6238: TOTP: Time-Based One-Time Password Algorithm.
		*m: trimendingwith		&& Trim a string ending with a specific substring until the string no longer ends with that substring. Returns Nothing on failure.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat Crypt2 UncommonOptions  property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented method! Unlocks the component. This must be called once prior to calling any other method.
		*m: usecertvault		&& Introduced in version 9.5.0.40. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*m: uufilename_access		&& Access method used to retrieve the Chilkat Crypt2 UUFileName  property.
		*m: uufilename_assign		&& Assign method used to hold a reference to the UUFileName property.
		*m: uumode_access		&& Access method used to retrieve the Chilkat Crypt2 UUMode property.
		*m: uumode_assign		&& Assign method used to hold a reference to the UUMode property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Crypt2 VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifybdenc		&& Introduced in version 9.5.0.67. Verifies a digital signature against the original data contained in data. Returns 1 if the signature is verified.
		*m: verifybytes		&& Verifies a byte array against a digital signature and returns true if the byte array is unaltered. Note: The signer certificates can be retrieved after any Verify* method call by using the NumSignerCerts property and the GetSignerCert method.
		*m: verifybytesenc		&& Verifies a byte array against a string-encoded digital signature and returns true if the byte array is unaltered. This method can be used to verify a signature produced by SignBytesENC.
		*m: verifydetachedsignature		&& Verifies a .p7s (PKCS #7 Signature) against the original file (or exact copy of it). If the inFilename has not been modified, the return value is 1, otherwise it is 0. This method is equivalent to VerifyP7S.
		*m: verifyp7m		&& Verifies a .p7m file and extracts the original file from the .p7m. Returns 1 if the signature is valid and the contents are unchanged. Otherwise returns 0.
		*m: verifyp7s		&& Verifies a .p7s (PKCS #7 Signature) against the original file (or exact copy of it). If the inFilename has not been modified, the return value is 1, otherwise it is 0.
		*m: verifysbenc		&& Introduced in version 9.5.0.67. Verifies a digital signature against the original data contained in sb. Returns 1 if the signature is verified.
		*m: verifystring		&& Verifies a string against a binary digital signature and returns true if the string is unaltered. This method can be used to verify a signature produced by SignString.
		*m: verifystringenc		&& Verifies a string against a string-encoded digital signature and returns true if the string is unaltered. This method can be used to verify a signature produced by SignStringENC.
		*m: writefile		&& Convenience method to write an entire byte array to a file. Returns 1 for success, 0 for failure.
		*m: xtssetdataunitnumber		&& Introduced in version 9.5.0.91. Sets the XTS-AES mode data unit number. The data unit number is a 64-bit unsigned integer. It is passed in as two 32-bit unsigned integers representing the high and low 32-bits.
		*m: xtssetencodedtweakkey		&& Introduced in version 9.5.0.91. Sets the XTS-AES mode tweak key from an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", "ascii", or "url".
		*m: xtssetencodedtweakvalue		&& Introduced in version 9.5.0.91. Sets the XTS-AES mode tweak value from an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", "ascii", or "url".
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: bcryptworkfactor		&& Introduced in version 9.5.0.65. The BCrypt work factor to be used for the BCryptHash and BCryptVerify. This is the log2 of the number of rounds of hashing to apply. For example, if the work (cost) factor is 12, then 2^12 rounds of hashing are applied.
		*p: blocksize		&& The block-size (in bytes) of the selected encryption algorithm. For example, if the CryptAlgorithm property is set to "aes", the BlockSize property is automatically set to 16. The block-size for the ARC4 streaming encryption algorithm is 1.
		*p: byteswapondecrypt		&& Undocumented property! It is assumed that setting this value to 1 will byte swap upon decryption, See ByteSwap4321 method.
		*p: cadesenabled		&& Applies to all methods that create PKCS7 signatures. To create a CAdES-BES signature, set this property equal to 1. The default value of this property is 0.
		*p: cadessigpolicyhash		&& This is the base64 hash of the policy document located at the CadesSigPolicyUri. You can use either the SHA256 or SHA1 hash. Note: This property applies to all methods that create PKCS7 signatures.
		*p: cadessigpolicyid		&& See the description for the CadesSigPolicyHash property above.
		*p: cadessigpolicyuri		&& See the description for the CadesSigPolicyHash property above.
		*p: charset		&& Controls the character encoding of the text encrypted, signed, hashed or compressed. This property is relevant wherever strings are used as inputs or outputs. This property defaults to the ANSI charset of the computer.
		*p: ciphermode		&& Controls the cipher mode for block encryption algorithms (AES, Blowfish,TwoFish, DES, 3DES, RC2). Possible values are "CBC" (the default) , "ECB", "CTR", "OFB", "GCM", and "CFB".
		*p: cmsoptions		&& Introduced in version 9.5.0.78. A JSON string for controlling extra CMS (PKCS7) signature and validation options.
		*p: compressionalgorithm		&& Undocumented property! This property is decremented. The only possible value is "BZIP2". The compression functionality in Crypt2 is legacy and existed long before the general compression functionality that is currently offered in Chilkat.Compression.
		*p: cryptalgorithm		&& Selects the encryption algorithm for encrypting and decrypting. Possible values are: "chacha20", "pki", "aes", "blowfish2", "des", "3des", "rc2", "arc4", "twofish", "pbes1" and "pbes2".
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: encodingmode		&& Controls the encoding of binary data to a printable string for many methods.
		*p: firstchunk		&& Chilkat Crypt2 provides the ability to feed the encryption/decryption methods with chunks of data. This allows a large amount of data, or a data stream, to be fed piecemeal for encrypting or decrypting.
		*p: hashalgorithm		&& Selects the hash algorithm used by methods that create hashes. The valid choices are "sha1", "sha256", "sha384", "sha512", "sha3-224", "sha3-256", "sha3-384", "sha3-512", "md2", "md5", "haval", "ripemd128", "ripemd160","ripemd256", or "ripemd320".
		*p: havalrounds		&& Applies to the HAVAL hash algorithm only and must be set to the integer value 3, 4, or 5. The default value is 3.
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort some methods call prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: includecertchain		&& Only applies when creating digital signatures. If 1 (the default), then additional certificates (if any) in the chain of authentication are included in the PKCS7 digital signature.
		*p: initialcount		&& Introduced in version 9.5.0.55. The initial counter for the ChaCha20 encryption algorithm. The default value is 0.
		*p: iterationcount		&& Iteration count to be used with password-based encryption (PBE). Password-based encryption is defined in the PKCS5 Password-Based Cryptography Standard at http://www.rsa.com/rsalabs/node.asp?id=2127
		*p: iv		&& The initialization vector to be used with symmetric encryption algorithms (AES, Blowfish, Twofish, etc.). If left unset, no initialization vector is used.
		*p: keylength		&& The key length in bits for symmetric encryption algorithms. The default value is 256.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastchunk		&& See the description for the FirstChunk property
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: macalgorithm		&& Introduced in version 9.5.0.55. Selects the MAC algorithm to be used for any of the Mac methods, such as MacStringENC, MacBytes, etc. The default value is "hmac". Possible values are "hmac" and "poly1305".
		*p: numsignercerts		&& This property is set when a digital signature is verified. It contains the number of signer certificates. Each signing certificate can be retrieved by calling the GetSignerCert method, passing an index from 0 to NumSignerCerts-1.
		*p: oaephash		&& Introduced in version 9.5.0.67. Selects the hash algorithm for use within OAEP padding when encrypting using "pki" with RSAES-OAEP. The valid choices are "sha1", "sha256", "sha384", "sha512",
		*p: oaepmgfhash		&& Introduced in version 9.5.0.71. Selects the MGF hash algorithm for use within OAEP padding when encrypting using "pki" with RSAES-OAEP. The valid choices are "sha1", "sha256", "sha384", "sha512", The default is "sha1".
		*p: oaeppadding		&& Introduced in version 9.5.0.67. Selects the RSA encryption scheme when encrypting using "pki" (with a certificate and private key). The default value is 0, which selects RSAES_PKCS1-V1_5. If set to 1, then RSAES_OAEP is used.
		*p: paddingscheme		&& The padding scheme used by block encryption algorithms such as AES (Rijndael), Blowfish, Twofish, RC2, DES, 3DES, etc. Block encryption algorithms pad encrypted data to a multiple of algorithm's block size. The default value of this property is 0.
		*p: pbesalgorithm		&& If the CryptAlgorithm property is set to "pbes1" or "pbes2", this property specifies the underlying encryption algorithm to be used with password-based encryption (PBE).
		*p: pbespassword		&& The password to be used with password-based encryption (PBE). Password-based encryption is defined in the PKCS5 Password-Based Cryptography Standard at http://www.rsa.com/rsalabs/node.asp?id=2127
		*p: pkcs7cryptalg		&& When the CryptAlgorithm property is "PKI" to select PKCS7 public-key encryption, this selects the underlying symmetric encryption algorithm. Possible values are: "aes", "des", "3des", and "rc2". The default value is "aes".
		*p: rc2effectivekeylength		&& The effective key length (in bits) for the RC2 encryption algorithm. When RC2 is used, both the KeyLength and Rc2EffectiveKeyLength properties should be set. For RC2, both should be between 8 and 1024 (inclusive). The default value is 128.
		*p: salt		&& The salt to be used with password-based encryption (PBE). Password-based encryption is defined in the PKCS5 Password-Based Cryptography Standard at http://www.rsa.com/rsalabs/node.asp?id=2127.
		*p: secretkey		&& The binary secret key used for symmetric encryption (Aes, Blowfish, Twofish, ChaCha20, ARC4, 3DES, RC2, etc.). The secret key must be identical for decryption to succeed. The length in bytes of the SecretKey must equal the KeyLength/8.
		*p: signingalg		&& Introduced in version 9.5.0.67. This property selects the signature algorithm for the OpaqueSign*, Sign*, and CreateDetachedSignature, CreateP7M, and CreateP7S methods. The default value is "PKCS1-v1_5".
		*p: signingattributes		&& Introduced in version 9.5.0.75. Contains JSON to specify the authenticated (signed) attributes or unauthenticated (unsigned) attributes that are to be included in CMS signatures.
		*p: uncommonoptions		&& Introduced in version 9.5.0.83. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: uufilename		&& When UU encoding, this is the filename to be embedded in UU encoded output. The default is "file.dat". When UU decoding, this is the filename found in the UU encoded input.
		*p: uumode		&& When UU encoding, this is the file permissions mode to be embedded in UU encoded output. The default is "644". When UU decoding, this property is set to the mode found in the UU encoded input.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		bcryptworkfactor = 10
		blocksize = 0
		byteswapondecrypt = 0
		cadesenabled = 0
		cadessigpolicyhash = 
		cadessigpolicyid = 
		cadessigpolicyuri = 
		cchilkatclass = Crypt2
		ceventhandlerclass = iBaseEventHandler
		charset = 
		ciphermode = CBC
		cmsoptions = 
		compressionalgorithm = 
		cryptalgorithm = aes
		debuglogfilepath = 
		encodingmode = base64
		firstchunk = 1
		hashalgorithm = sha256
		havalrounds = 3
		heartbeatms = 0
		includecertchain = 1
		initialcount = 0
		iterationcount = 1024
		iv = .NULL.
		keylength = 256
		lastbinaryresult = .NULL.
		lastchunk = 0
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		macalgorithm = hmac
		Name = "crypt2"
		numsignercerts = 0
		oaephash = sha256
		oaepmgfhash = sha1
		oaeppadding = 0
		paddingscheme = 0
		pbesalgorithm = 
		pbespassword = 
		pkcs7cryptalg = aes
		rc2effectivekeylength = 128
		salt = .NULL.
		secretkey = .NULL.
		signingalg = PKCS1-v1_5
		signingattributes = 
		uncommonoptions = 
		uufilename = file.dat
		uumode = 644
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat Crypt2 AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly 
		** (i.e.have no length file operations or network communications) are not affected. 
		** If no method is running, then this property is automatically reset to 0 
		** when the next method is called. 
		** When the abort occurs, this property is reset to 0. 
		** Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE addencryptcert		&& Adds a certificate to be used for public-key encryption. (To use public-key encryption with digital certificates, set the CryptAlgorithm property = "pki".) To encrypt with more than one certificate, call AddEncryptCert once per certificate.
		*==============================================================================
		* Method:            AddEncryptCert
		* Purpose:           Adds a certificate to be used for public-key encryption.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Adds a certificate to be used for public-key encryption. 
		** (To use public-key encryption with digital certificates, 
		** set the CryptAlgorithm property = "pki".) 
		** To encrypt with more than one certificate, call AddEncryptCert once per certificate.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      m.loChilkatObject.AddEncryptCert(m.loChilkatCert)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addpfxsourcebd		&& Introduced in version 11.0.0. Adds a PFX file to the object's list of sources for locating certificates and private keys during decryption or signing. To add multiple PFX sources, call this method for each file.
		*==============================================================================
		* Method:            AddPfxSourceBd
		* Purpose:           Adds a PFX file to the object's list of sources for locating 
		*                    certificates and private keys during decryption or signing. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		*                    lcPassword, the password
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Adds a PFX file to the object's list of sources for locating certificates 
		** and private keys during decryption or signing. 
		** To add multiple PFX sources, call this method for each file. 
		** bd should contain the bytes of a PFX file (also known as PKCS12 or .p12).
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData  
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddPfxSourceBd(m.loChilkatBinData, ;
		        m.tcPassword) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addpfxsourcedata		&& Adds a PFX to the object's internal list of sources to be searched for certificates and private keys when decrypting. Multiple PFX sources can be added by calling this method once for each.
		*==============================================================================
		* Method:            AddPFXSourceData
		* Purpose:           Adds a PFX to the object's internal list of sources to be searched 
		*                    for certificates and private keys when decrypting.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPFXBytes -- contains the bytes of a PFX file
		*                    tcPassword -- the password to the PFX file
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Adds a PFX to the object's internal list of sources to be searched 
		** for certificates and private keys when decrypting. 
		** Multiple PFX sources can be added by calling this method once for each. 
		** (On the Windows operating system, 
		** the registry-based certificate stores are also automatically searched, 
		** so it is commonly not required to explicitly add PFX sources.)
		**
		** The pfxBytes contains the bytes of a PFX file (also known as PKCS12 or .p12).
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqPFXBytes AS VarBinary, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddPFXSourceData(m.tqPFXBytes, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

