	PROCEDURE savebodybinary		&& Saves the body of the HTTP response to a file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SaveBodyBinary
		* Purpose:           Saves the body of the HTTP response to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to save the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/02/2022
		*==============================================================================
		
		**
		** Saves the body of the HTTP response to a file.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTPRESPONSE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SaveBodyBinary(m.tcFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE savebodytext		&& Saves the HTTP response body to a file. This method provides control over CRLF vs bare-LF line-endings. If bCrlf is 1, then line endings are automatically converted to CRLF if necessary.
		*==============================================================================
		* Method:            SaveBodyText
		* Purpose:           Saves the HTTP response body to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuCRLF, whether or not to use CRLF/LF at end of line.
		*                    tcFilePath, the path to save the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/02/2022
		*==============================================================================
		
		**
		** Saves the HTTP response body to a file. 
		** This method provides control over CRLF vs bare-LF line-endings. 
		** If bCrlf is 1, then line endings are automatically converted to CRLF if necessary. 
		** If bCrlf is 0, then line-endings are automatically converted 
		** to bare-LF's (Unix style) if necessary.
		** 
		** To save the HTTP response body exactly as-is (with no line-ending manipulation), 
		** then call SaveBodyBinary.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuCRLF AS Unknown, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTPRESPONSE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liCRLF AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCRLF
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCRLF = .LogicalToBit(m.tuCRLF)
		
		    TRY
		
		      STORE m.loChilkatObject.SaveBodyText(m.liCRLF, m.tcFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

