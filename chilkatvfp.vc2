	PROCEDURE loadrsader		&& Undocumented method! This method is decremented. Decremented methods will be removed at some point in the future. Applications should instead call LoadPkcs1. oads a private key from in-memory RSA PKCS#1 DER byte data.
		*==============================================================================
		* Method:            LoadRSADER
		* Purpose:           Undocumented method! This method is decremented. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPKCS1PrivateKey -- the PKCS1 private key
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Undocumented method! 
		**
		** This method is decremented. Decremented methods will be removed at some point in the future. 
		** Applications should instead call LoadPkcs1. 
		** Loads a private key from in-memory RSA PKCS#1 DER byte data.
		**
		** Applications should instead call LoadPkcs1.
		**
		** For those requiring a deeper understanding, the PKCS1 contains ASN.1 in DER
		** encoding with the following structure:
		**
		**   RSAPrivateKey ::= SEQUENCE {
		**     version           Version,
		**     modulus           INTEGER,  -- n
		**     publicExponent    INTEGER,  -- e
		**     privateExponent   INTEGER,  -- d
		**     prime1            INTEGER,  -- p
		**     prime2            INTEGER,  -- q
		**     exponent1         INTEGER,  -- d mod (p-1)
		**     exponent2         INTEGER,  -- d mod (q-1)
		**     coefficient       INTEGER,  -- (inverse of q) mod p
		**     otherPrimeInfos   OtherPrimeInfos OPTIONAL
		**   }
		**  
		** Note: Each of the private key Load* methods willl auto-recognize the content and
		** will parse appropriately. The private key should be successfully loaded even
		** when the wrong format data is passed to the wrong method.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		**
		
		LPARAMETERS tqPKCS1PrivateKey AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.LoadRSADER(m.tqPKCS1PrivateKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

