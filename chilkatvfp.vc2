	PROCEDURE fetchsequence		&& Downloads email for a range of sequence numbers. The 1st email in a mailbox is always at sequence number 1. The total number of emails in the currently selected mailbox is available in the NumMessages property.
		*==============================================================================
		* Method:            FetchSequence
		* Purpose:           Downloads email for a range of sequence numbers.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiStartingSequence -- the starting sequence number.
		*                    tiMessages -- the number of messages to fetch
		* Returns:           Chilkat EMail Bundle object, or NULL
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Downloads email for a range of sequence numbers. The 1st email in a mailbox 
		** is always at sequence number 1. The total number of emails 
		** in the currently selected mailbox is available in the NumMessages property. 
		** If the numMessages is too large, the method will still succeed, 
		** but will return a bundle of emails from startSeqNum 
		** to the last email in the mailbox.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiStartingSequence AS Integer, tiMessages AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmailBundle
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatEmailBundle = ;
		      m.loChilkatObject.FetchSequence(m.tiStartingSequence, m.tiMessages)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmailBundle
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatEmailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

