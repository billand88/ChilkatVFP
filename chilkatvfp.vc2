	PROCEDURE uncompressmemory		&& Uncompresses from an in-memory image of a .Z file directly into memory. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            UncompressMemory
		* Purpose:           Uncompresses from an in-memory image of a .Z file directly into memory.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqInMemoryImage -- the binary in-memory image to uncompress
		* Returns:           An in-memory image of a .Z file.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Uncompresses from an in-memory image of a .Z file directly into memory. 
		** (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.)
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tqInMemoryImage AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_UNIXCOMPRESS_COM_CALL, ;
		loException AS Exception, lqInMemoryData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqInMemoryImage
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqInMemoryData = ;
		      m.loChilkatObject.UncompressMemory(m.tqInMemoryImage)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqInMemoryData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UNIXCOMPRESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE uncompressmemtofile		&& Uncompresses from an in-memory image of a .Z file to a file. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UncompressMemToFile
		* Purpose:           Uncompresses from an in-memory image of a .Z file to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqInMemoryImage -- the binary in-memory image to compress
		*                    tcDestinationFilePath, the path to the compressed file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Uncompresses from an in-memory image of a .Z file to a file. 
		** (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.)
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqInMemoryImage AS VarBinary, tcDestinationFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_UNIXCOMPRESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.UncompressMemToFile(m.tqInMemoryImage, ;
		      m.tcDestinationFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UNIXCOMPRESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE uncompressstring		&& Uncompresses from an in-memory image of a .Z file directly to a string. The charset specifies the character encoding used to interpret the bytes resulting from the decompression.
		*==============================================================================
