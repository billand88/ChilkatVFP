	PROCEDURE s3_uploadfileasync		&& Creates an asynchronous task to call the S3_UploadFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            S3_UploadFileAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    S3_UploadFile method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalFilePath -- the path to the local file.
		*                    tcContentType -- the content type of the binary data
		*                    tcBucketPath -- the path to the Amazon bucket
		*                    tcObjectName -- the object within the bucket path to append to.
		* Returns:           Chilkat Task object or NULL
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the S3_UploadFile method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Fixed for Version 66: Fixed AWS Signature V4 issues 
		** for some cases when query params are used with S3.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed in Version 69: Fixed problems with pre-signing URLs having to do with 
		** 8bit non-us-ascii chars in the filename, or “.” chars in the bucket name.
		**
		** Fixed in Version 75: Fixed problems with non-us-ascii chars in x-amz-meta-* headers
		**
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Fixed in version 11.2.0: When using a session token, Chilkat will automatically 
		** include the "x-amz-security-token" header with the value of the 
		** AwsSessionToken property for the request sent by S2_UploadFile.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLocalFilePath AS Character, tcContentType AS Character, ;
		tcBucketPath AS Character, tcObjectName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.S3_UploadFileAsync(;
		        m.tcLocalFilePath, m.tcContentType, m.tcBucketPath, m.tcObjectName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE s3_uploadstring		&& Uploads an in-memory string to the Amazon S3 service. This is the same as UploadFile, except that the file contents are from an in-memory string instead of a local file.
		*==============================================================================
		* Method:            S3_UploadString
		* Purpose:           Uploads an in-memory string to the Amazon S3 service.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcObjectContent -- the string to upload.
		*                    tcContentType -- the content type of the binary data
		*                    tcBucketPath -- the path to the Amazon bucket
		*                    tcObjectName -- the object within the bucket path to append to.
		* Returns:           Numeric
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Uploads an in-memory string to the Amazon S3 service. 
		** This is the same as UploadFile, except that 
		** the file contents are from an in-memory string instead of a local file. 
		** Internal to this method, the objectContent is 
		** converted to the character encoding specified by charset prior to uploading.
		**
		** Note: x-amz-* headers, including metadata, can be added to any S3 request 
		** by adding each header with a call to SetRequestHeader. 
		** This applies to all S3 methods, even if not explicitly stated.
		**
		** Note: If the bucket is in a region different than us-east-1, 
		** makes sure to set the AwsEndpoint property to the correct region, such as "eu-central-1". 
		** Also, if using an S3 compatible service such as Wasabi, always set the AwsEndpoint property. 
		** For example: "s3.wasabisys.com", "s3.eu-central-1.wasabisys.com".
		**
		** Fixed for Version 66: Fixed AWS Signature V4 issues 
		** for some cases when query params are used with S3.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed in Version 69: Fixed problems with pre-signing URLs having to do with 
		** 8bit non-us-ascii chars in the filename, or “.” chars in the bucket name.
		**
		** Fixed in Version 75: Fixed problems with non-us-ascii chars in x-amz-meta-* headers
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcObjectContent AS Character, tcContentType AS Character, ;
		tcBucketPath AS Character, tcObjectName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.S3_UploadString(m.tcObjectContent, ;
		      m.tcContentType, m.tcBucketPath, m.tcObjectName) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

