	PROCEDURE asnbodytoxml		&& When the body of a MIME part contains PKCS7 (ASN.1 in DER format, base64-encoded), this method can be used to convert the ASN.1 to an XML format for inspection.
		*==============================================================================
		* Method:            AsnBodyToXML
		* Purpose:           When the body of a MIME part contains PKCS7, this method 
		*                    can be used to convert the ASN.1 to an XML format for inspection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           XML
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** When the body of a MIME part contains PKCS7 (ASN.1 in DER format, base64-encoded), 
		** this method can be used to convert the ASN.1 to an XML format for inspection. 
		** Here is an example of how an ASN.1 body might look:
		** 
		**   Content-Type: application/x-pkcs7-mime;
		**     name="smime.p7m"; smime-type="signed-data"
		**   Content-Transfer-Encoding: base64
		**   Content-Disposition: attachment; filename="smime.p7m"
		** 
		**   MIIXXAYJKoZIhvcNAQcCoIIXTTCCF0kCAQExCzAJBgUrDgMCGgUAMFoGCSqGSIb3DQEHAaBNBEtD
		**   b250ZW50LVR5cGU6IHRleHQvcGxhaW4NCkNvbnRlbnQtVHJhbnNmZXItRW5jb2Rpbmc6IDdiaXQN
		**   Cg0KdGhpcyBpcyBhIHRlc3SgghI/MIIE3jCCA8agAwIBAgICAwEwDQYJKoZIhvcNAQEFBQAwYzEL
		**   ...
		** 
		** The XML produced would look something like this:
		** 
		**   <?xml version="1.0" encoding="utf-8" ?>
		**   <sequence>
		**       <oid>1.2.840.113549.1.7.2</oid>
		**       <contextSpecific tag="0" constructed="1">
		**           <sequence>
		**               <int>01</int>
		**               <set>
		**                   <sequence>
		**                       <oid>1.3.14.3.2.26</oid>
		**                       <null />
		**                   </sequence>
		**               </set>
		**               <sequence>
		**                   <oid>1.2.840.113549.1.7.1</oid>
		**                   <contextSpecific tag="0" constructed="1">
		**   ...
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXML = m.loChilkatObject.AsnBodyToXML()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE boundary_access		&& Access method used to retrieve the Chilkat MIME Boundary property.
		*==============================================================================
		* Method:            Boundary_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME Boundary property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Boundary
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** The boundary string for a multipart MIME message.
		** 
		** It is the value of the boundary attribute of the Content-Type header field. 
		** For example, if the Content-Type header is this:
		** 
		**   Content-Type: multipart/mixed; boundary="------------080707010302060306060800"
		** 
		** then the value of the Boundary property is "------------080707010302060306060800".
		** 
		** When building multipart MIME messages, the boundary is automatically generated 
		** by methods such as NewMultipartMixed, to be a unique and random string, 
		** so explicitly setting the boundary is usually not necessary.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE boundary_assign		&& Assign method used to hold a reference to the Boundary property.
		*==============================================================================
		* Method:            Boundary_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME Boundary property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Boundary property.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE charset_access		&& Access method used to retrieve the Chilkat MIME Charset property.
		*==============================================================================
		* Method:            Charset_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Charset
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** The value of the "charset" attribute of the Content-Type header field. 
		** For example, if the Content-Type header is this:
		** 
		**   Content-Type: text/plain; charset="iso-8859-1"
		** 
		** then the value of the Charset property is "iso-8859-1".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE charset_assign		&& Assign method used to hold a reference to the Charset property.
		*==============================================================================
		* Method:            Charset_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Charset property.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  Convert8Bit — MIME parts using Content-Transfer-Encoding: 
		  8bit or binary are now correctly converted to Base64, keeping the serialized MIME, 
		  child Encoding properties, and headers consistent.
		
		  UrlEncodeBody — URL-encoded text now replaces the existing body instead 
		  of being appended; invalid charset names no longer duplicate the body.
		
		  RemovePart — an out-of-range index returns false and leaves the tree unchanged.
		
		  SetBodyFromEncoded — improved validation; rejects malformed data 
		  and unsupported encodings, preserving existing content on failure.
		
		  PartsToFiles — the returned StringTable now contains the actual sanitized paths, 
		  and no nonexistent paths are added when extraction fails.
		
		** Version 11.4.0
		
		  Added the GetDecryptCertInfo method to make it possible to get information 
		  about the certificate(s) required to decrypt an enveloped-data MIME.
		
		  aes-gcm / smime-type=”authEnveloped-data” — When the Pkcs7CryptAlg property is set to aes-gcm, 
		  the encrypted email should use the Content-Type header smime-type=authEnveloped-data 
		  rather than smime-type=enveloped-data. This issue has been fixed.
		
		** Version 11.0.0
		
		  Removed the UnlockComponent method.
		
		  Removed the IsUnlocked method.
		
		  SigningHashAlg property now defaults to sha256.
		
		  Added the NumDecryptCerts property.
		
		  Added the PfxSourceBd, LastDecryptCert, LastSignerCert, 
		  PartAt, PartsToFiles and SetBodyBd methods.
		
		  Decremented the NumEncryptCerts property.
		  
		  Decremented the ExtractPartsToFiles, FindIssuer, 
		  GetEncryptCert, GetPart, GetSignerCert, GetSignerCertChain
		  and LastJsonData methods.
		
		** Version 10.0.0
		
		  Added the ability to create and verify AES-GCM authEnvelopedData. 
		  This applies to anything doing CMS/PKCS7 encryption, but was needed for S/MIME email.
		
		** Version 99
		
		  Chilkat’s internal ASN.1 decoder needed an update to correctly handle 
		  0-length ASN.1 bit strings (which is something not normally encountered).
		
		** Version 95
		
		  Mime bodies having the content types application/vnd.openxmlformats-officedocument.wordprocessingml.document
		  did not get decoded correctly.
		
		** Version 89
		
		  Fixed a problem with decrypting messages that used AES-GCM with a certificate
		  having a non-exportable private key (such that Microsoft CNG is needed internally).
		
		** Version 77
		
		  The IsEncrypted() method would return True for enveloped signed data
		  if the “smime-type=signed-data;” was missing in the Content-Type,
		  even if the optional ” protocol=”application/x-pkcs7-signature”;” was present.
		  Likewise, when IsEncrypted() returned incorrectly True, then IsSigned() would return incorrectly False.
		
		** Version 75
		
		  Added the ability to open .pfx/.p12 files where two different passwords are required:
		  one for integrity and the other for the private keys.
		  See the example at https://www.example-code.com/csharp/pfx_multiple_passwords.asp
		
		** Version 73
		
		  Binary MIME with null bytes in some bodies became corrupted
		  because 0 bytes were replaced with SPACE chars. This is fixed.
		
		  Fixed: The “micalg” attribute incorrectly remained in the Content-Type header field
		  for the encrypted MIME part when the email is also signed.
		
		  Added more internal flexibility for handling mixtures of CRLF and bare-LF line endings.
		
		  Fixed an extremely rare issue where a digital signature verification failed but should’ve been successful.
		
		** Version 72
		
		  Fixed certain cases where creating PKCS7 signatures embedded the same certificate twice.
		
		** Version 71
		
		  Added the OapeMgfHash property to the Email, Crypt2, Mime, and Rsa classes.
		
		** Version 70
		
		  In very rare cases, the internal ASN.1 for a part of the PKCS7 signature
		  used something called a “t61” string. Chilkat now handles it correctly.
		
		** Version 69
		
		  When a message contained 8bit message/rfc822 parts,
		  the GetMime method did not properly emit the MIME. This was fixed.
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		  Fixed an issue with automatically locating pre-installed Windows certificates
		  (for encryption) when the email address stored within the certificate used uppercase letters.
		
		** Version 67
		
		  Added the GetBodyBd method.
		
		  Added the OaepPadding and OaepHash properties.
		
		  Added RSASSA-PSS and RSAES-OAEP capabilities for signed and encrypted email.
		  This was spurred by customer needs to satisfy new requirements in Germany
		  that apparently go into effect on 1-June-2017 regarding email signatures and encryption.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 62
		
		  Note: One use of BinData and StringBuilder is in use of new methods ending in “Sb” and “Bd”.
		  These methods are for returning or passing text or binary data, especially large amounts of text or data.
		  For example, imagine one Chilkat method is used to retrieve a large amount of data,
		  and then that data is passed to another Chilkat method. A large waste of time and memory is consumed
		  in returning the string (or binary bytes) to the programming language,
		  and then immediately passing it back to Chilkat.
		  If it is .NET, then the data must be marshaled from unmanaged to managed, and then,
		  to pass back to Chilkat it is marshaled from managed to unmanaged.
		  The same applies when using the ActiveX (with BSTR’s and Variants).
		  By retrieving results directly into a BinData or StringBuilder,
		  and then passing the data by passing the object, the data stays on the native side.
		  For example, the new Rest.ReadRespSb method reads the REST response directly in to a StringBuilder.
		  If it is JSON, this can be loaded directly into a JsonObject via the JsonObject.LoadSb
		  In the future, new “Sb” and “Bd” methods will be added in places
		  where large amounts of data are likely to be encountered
		  This will create pathways allowing data to stay native as much as possible.
		  Version 9.5.0.62 adds the following initial set of Sb/Bd methods:
		
		    JsonObject.LoadSb
		    JsonObject.EmitSb
		    Xml.LoadSb
		    Xml.GetXmlSb
		
		    Email.GetMimeBd
		    Email.GetMimeSb
		    Email.SetFromMimeSb
		    Email.SetFromMimeBd
		
		    Mime.LoadMimeSb
		    Mime.LoadMimeBd
		    Mime.GetMimeSb
		    Mime.GetMimeBd
		    MailMan.RenderToMimeBd
		    MailMan.RenderToMimeSb
		    Rest.FullRequestSb
		    Rest.ReadRespSb
		    Rest.SendReqSb
		    Rest.SetMultipartBodySb
		    Rest.AddQueryParam
		    Rest.ReadRespBd
		    Rest.SendReqBd
		    Rest.SetMultipartBodyBd
		    Imap.FetchAttachmentSb
		    Imap.FetchAttachmentBd
		    Imap.AppendMimeWithFlagsSb
		    SFtp.UploadSb
		    SFtp.DownloadSb
		    SFtp.UploadBd
		    SFtp.DownloadBd
		    Ftp2.GetFileSb
		    Ftp2.GetFileBd
		
		    Ftp2.PutFileSb
		    Ftp2.PutFileBd
		
		** Version 59
		
		  Fixed: When a cert doesn’t have the Issuer CN,
		  the encrypted message could not be decrypted using Chilkat library,
		  even though the cert does have subject key id.
		
		  Fixed problems where the values in address related header fields were not returned Q/B decoded.
		  (For example, the value returned by the GetHeaderField method should be Q/B decoded.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 56
		
		  The default value of the Pkcs7CryptAlg was changed from “RC2” to “AES”.
		
		  Fixed: Removed “email address cleaning” from CkMime. The MIME header
		  was run through email-specific processing logic to clean/ensure well formatted email addresses.
		  This should not have been done for the general-purpose MIME API.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 48
		
		  Issues relating to MIME header continuation lines when saving to/from XML format were fixed.
		
		  The Mime.EncryptN method now sets the smime-type sub-header field.
		  For example: Content-Type: application/pkcs7-mime; smime-type=enveloped-data; name=smime.p7m
		
		  Bare CR’s or LF’s in quoted-printable/Base64 email bodies (non-encoded) auto-converted to CRLF
		  (for compliance to RFC 2822). This does NOT change the actual content of the email bodies.
		
		  (Internal MIME parsing fix.) When an email is received that uses star-encoding,
		  if a single char was multi-byte and the bytes were split across two lines, then Chilkat did not decode properly.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		** Version 41
		
		  Fixes relating to the use of the hz-gb-2312 charset in email and MIME.
		
		** Version 40
		
		  Review the online reference documentation for new methods or properties
		  for Ftp2, TrustedRoots, Rsa, Mime, Cert, Email, Imap, MailMan, Crypt2,
		  Http, Zip, Pfx, XmlCertVault, CertChain, and Upload.
		  New entries are clearly marked by the version in which they are introduced.
		
		** Version 37
		
		  It was found that in some cases, OpenSSL may produce MIME with a mixture
		  of both bare-LF line-endings and CRLF line-endings.
		  MIME documents *should* always use CRLF line endings.
		  The mixing of both line-ending types in a single MIME document caused
		  the LoadMimeBytes method to skip past the end of the top-level header
		  (terminated by a double bare-LF) and instead find the end of the 2nd header,
		  which was properly terminated by a double CRLF.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE clearencryptcerts		&& Clears the internal list of certificates added by previous calls to the AddEncryptCert method. (See the EncryptN method for information about encrypting using multiple certificates.)
		*==============================================================================
		* Method:            ClearEncryptCerts
		* Purpose:           Clears the internal list of certificates added 
		*                    by previous calls to the AddEncryptCert method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Clears the internal list of certificates added by previous calls 
		** to the AddEncryptCert method. (See the EncryptN method for information 
		** about encrypting using multiple certificates.)
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.ClearEncryptCerts()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE cmsoptions_access		&& Access method used to retrieve the Chilkat MIME CMSOptions property.
		*==============================================================================
		* Method:            CMSOptions_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME CMSOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CMSOptions
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.78
		**
		** A JSON string for controlling extra CMS (PKCS7) signature and validation options.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 78
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE cmsoptions_assign		&& Assign method used to hold a reference to the CMSOptions property.
		*==============================================================================
		* Method:            CMSOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME CMSOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CMSOptions property.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 78
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE containsencryptedparts		&& Returns 1 if the MIME message contains encrypted parts.
		*==============================================================================
		* Method:            ContainsEncryptedParts
		* Purpose:           Returns 1 if the MIME message contains encrypted parts.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Returns 1 if the MIME message contains encrypted parts.
		** 
		** Note: This method examines the MIME as-is. 
		** If UnwrapSecurity is called and it is successful, 
		** then the MIME should no longer contain encrypted parts, and this method would return 0.
		** 
		** Note: If a signed MIME message is then encrypted, 
		** then it is not possible to know that the MIME is both encrypted 
		** and signed until UnwrapSecurity is called. 
		** (In other words, it is not possible to know the contents 
		** of the encrypted MIME until it is decrypted.) 
		** Therefore, the ContainsSignedParts method would return 0.
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ContainsEncryptedParts() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE containssignedparts		&& Returns 1 if the MIME message contains signed parts. Note: This method examines the MIME as-is. If UnwrapSecurity is called and it is successful, then the MIME should no longer contain signed parts, and this method would return 0.
		*==============================================================================
		* Method:            ContainsSignedParts
		* Purpose:           Returns 1 if the MIME message contains encrypted parts.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Returns 1 if the MIME message contains signed parts.
		**
		** Note: This method examines the MIME as-is. 
		** If UnwrapSecurity is called and it is successful, 
		** then the MIME should no longer contain signed parts, and this method would return 0.
		** 
		** Note: If a signed MIME message is then encrypted, 
		** then it is not possible to know that the MIME is both encrypted 
		** and signed until UnwrapSecurity is called. (In other words, 
		** it is not possible to know the contents of the encrypted MIME until it is decrypted.) 
		** Therefore, the ContainsSignedParts method would return 0.
		** 
		** Note: The same concept also applies to opaque signatures, 
		** such as with the MIME produced by calling ConvertToSigned.
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ContainsSignedParts() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE contenttype_access		&& Access method used to retrieve the Chilkat MIME ContentType property.
		*==============================================================================
		* Method:            ContentType_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME ContentType property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ContentType
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** The MIME content type, such as "text/plain", "text/html", 
		** "image/gif", "multipart/alternative", "multipart/mixed", etc.
		**
		** It is the value of the Content-Type header field, excluding any attributes. 
		** For example, if the Content-Type header is this:
		** 
		**   Content-Type: multipart/mixed; boundary="------------080707010302060306060800"
		** 
		** then the value of the ContentType property is "multipart/mixed".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE contenttype_assign		&& Assign method used to hold a reference to the ContentType property.
		*==============================================================================
		* Method:            ContentType_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME ContentType property.
		* Author:            Bill Anderson
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ContentType property.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE convert8bit		&& Changes the content-transfer-encoding to "base64" for all 8bit or binary MIME subparts. This allows for the MIME to be exported as a string via the GetMime method.
		*==============================================================================
		* Method:            Convert8Bit
		* Purpose:           Changes the content-transfer-encoding to "base64" 
		*                    for all 8bit or binary MIME subparts.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Changes the content-transfer-encoding to "base64" for all 8bit or binary MIME subparts. 
		** This allows for the MIME to be exported as a string via the GetMime method.
		**
		** Fixed for Version 11.6.0: Convert8Bit — MIME parts using Content-Transfer-Encoding: 
		** 8bit or binary are now correctly converted to Base64, keeping the serialized MIME, 
		** child Encoding properties, and headers consistent.
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.Convert8Bit()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE converttomultipartalt		&& Converts existing MIME to a multipart/alternative. This is accomplished by creating a new outermost multipart/alternative MIME part. The existing MIME is moved into the 1st (and only) sub-part of the new multipart/alternative enclosure.
		*==============================================================================
		* Method:            ConvertToMultiPartAlt
		* Purpose:           Converts existing MIME to a multipart/alternative.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Converts existing MIME to a multipart/alternative. 
		** This is accomplished by creating a new outermost multipart/alternative MIME part. 
		** The existing MIME is moved into the 1st (and only) 
		** sub-part of the new multipart/alternative enclosure. 
		** Header fields from the original top-level MIME part are transferred 
		** to the new top-level multipart/alternative header, except for Content-Type, 
		** Content-Transfer-Encoding, and Content-Disposition. 
		** For example, the following simple plain-text MIME is converted as follows:
		**
		** Original:
		** 
		**   MIME-Version: 1.0
		**   Date: Sun, 11 Aug 2013 11:18:44 -0500
		**   Message-ID: <D105FA9A2B5F34E253C6E255D58247D26F8BD724@CHILKAT13>
		**   Content-Type: text/plain
		**   Content-Transfer-Encoding: quoted-printable
		**   X-Priority: 3 (Normal)
		**   Subject: this is the subject.
		**   From: "Chilkat Software" <support@chilkatsoft.com>
		**   To: "Chilkat Sales" <sales@chilkatsoft.com>
		** 
		**   This is the plain-text body.
		** 
		** After Converting:
		** 
		**   MIME-Version: 1.0
		**   Date: Sun, 11 Aug 2013 11:18:44 -0500
		**   Message-ID: <D105FA9A2B5F34E253C6E255D58247D26F8BD724@CHILKAT13>
		**   X-Priority: 3 (Normal)
		**   Subject: this is the subject.
		**   From: "Chilkat Software" <support@chilkatsoft.com>
		**   To: "Chilkat Sales" <sales@chilkatsoft.com>
		**   Content-Type: multipart/alternative;
		**     boundary="------------040101040804050401050400_.ALT"
		** 
		**   --------------040101040804050401050400_.ALT
		**   Content-Type: text/plain
		**   Content-Transfer-Encoding: quoted-printable
		** 
		**   This is the plain-text body.
		**   --------------040101040804050401050400_.ALT--
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ConvertToMultiPartAlt() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

