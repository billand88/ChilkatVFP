		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcCertExtensionData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getextensionasxml		&& Introduced in version 9.5.0.49. Returns the certificate extension data in XML format (converted from ASN.1). The oid is an OID, such as the ones listed here: http://www.alvestrand.no/objectid/2.5.29.html
		*==============================================================================
		* Method:            GetExtensionAsXML
		* Purpose:           Returns the certificate extension data in XML format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOID, an object identifier.
		* Returns:           The certificate extension data
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Returns the certificate extension data in XML format (converted from ASN.1). 
		** The oid is an OID, such as the ones listed here: http://www.alvestrand.no/objectid/2.5.29.html
		**
		** Note: In many cases, the data within the XML is returned base64 encoded. 
		** An application may need to take one further step to base64 decode 
		** the information contained within the XML.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcOID AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
