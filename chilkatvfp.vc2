DEFINE CLASS httpeventhandler AS ibaseeventhandler OF "chilkatvfp.vcx" 		&& Event Handler for the ChilkatVFP object associated with the HTTP class.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: beginreceive		&& This event is fired just before beginning to read the HTTP response.
		*m: beginreceive_post		&& Template BeginReceive post-processing method.
		*m: beginreceive_pre		&& Template BeginReceive pre-processing method.
		*m: beginreceive_process		&& Template BeginReceive processing method.
		*m: beginsend		&& This event is fired just before the HTTP request is about to be sent.
		*m: beginsend_post		&& Template BeginSend post-processing method.
		*m: beginsend_pre		&& Template BeginSend pre-processing method.
		*m: beginsend_process		&& Template BeginSend processing method.
		*m: endreceive		&& This event is fired after the complete HTTP response has been received.
		*m: endreceive_post		&& Template EndReceive post-processing method.
		*m: endreceive_pre		&& Template EndReceive pre-processing method.
		*m: endreceive_process		&& Template EndReceive processing method.
		*m: endsend		&& This event is fired after the complete HTTP request has been sent.
		*m: endsend_post		&& Template EndSend post-processing method.
		*m: endsend_pre		&& Template EndSend pre-processing method.
		*m: endsend_process		&& Template EndSend processing method.
		*m: httpchunked		&& Called when the received response is in chunked format.
		*m: httpchunked_post		&& Template HTTPChunked post-processing method.
		*m: httpchunked_pre		&& Template HTTPChunked pre-processing method.
		*m: httpchunked_process		&& Template HTTPChunked processing method.
		*m: httpredirect		&& Called for each redirect that is followed. The abort may be set to 1 to abort the HTTP request.
		*m: httpredirect_post		&& Template HTTPRedirect post-processing method.
		*m: httpredirect_pre		&& Template HTTPRedirect pre-processing method.
		*m: httpredirect_process		&& Template HTTPRedirect processing method.
		*m: receiverate		&& Periodicallly called with information about the download performance (i.e. the receiving of the HTTP response). The byteCount is the cumulative number of bytes downloaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*m: receiverate_post		&& Template ReceiveRate post-processing method.
		*m: receiverate_pre		&& Template ReceiveRate pre-processing method.
		*m: receiverate_process		&& Template ReceiveRate processing method.
		*m: sendrate		&& Called periodically with upload progress information: The byteCount is the cumulative number of bytes uploaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*m: sendrate_post		&& Template SendRate post-processing method.
		*m: sendrate_pre		&& Template SendRate pre-processing method.
		*m: sendrate_process		&& Template SendRate processing method.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "httpeventhandler"
	*</PropValue>
	
	PROCEDURE beginreceive		&& This event is fired just before beginning to read the HTTP response.
		*==============================================================================
		* Method:            BeginReceive
		* Purpose:           This event is fired just before beginning to read the HTTP response.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** This event is fired just before beginning to read the HTTP response.
		**
		
		LOCAL llReturn AS Logical
		
		llReturn = .T.
		
		*!*  ? [BeginReceive Event!]
		
		WITH THIS
		
		  llReturn = .BeginReceive_Pre()
		
		  ** OK to continue test
		  IF m.llReturn
		
		    llReturn = .BeginReceive_Process()
		
		    ** OK to continue test
		    IF m.llReturn
		
		      llReturn = .BeginReceive_Post()
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		RETURN
	ENDPROC

