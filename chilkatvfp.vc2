		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DKIM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE verifydomainkeysignatureasync		&& Undocumented method! Creates an asynchronous task to call the VerifyDomainKeySignature method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            VerifyDomainKeySignatureAsync
		* Purpose:           Undocumented method! Creates an asynchronous task to call 
		*                    the VerifyDomainKeySignature method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the signature array value.
		*                    tqMIMEData, the MIME data to verify.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Undocumented method! 
		** 
		** Creates an asynchronous task to call the VerifyDomainKeySignature method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer, tqMIMEData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_DKIM_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
