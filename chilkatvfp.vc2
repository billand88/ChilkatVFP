	HIDDEN PROCEDURE x509type_access		&& Access method used to retrieve the Chilkat XMLDSigGen X509Type property.
		*==============================================================================
		* Method:            X509Type_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XMLDSigGen X509Type property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.X509Type
		* Date Added:        07/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Specifies the kind of X.509 certificate information is provided 
		** in the KeyInfo element when the KeyInfoType equals "X509Data". Possible values are:
		** 
		**   Certificate
		**   CertChain
		**   IssuerSerial
		**   SubjectName
		**   SKI
		** 
		** The default value is "Certificate".
		** 
		** Note: This property can be set to a comma-separated list of the keywords above. 
		** For example, If set to "SubjectName,Certificate", then both the X509SubjectName 
		** and X509Certificate parts will be added to the KeyInfo.
		** 
		** If Certificate, then the KeyInfo will contain the base64 encoded X.509v3 certificate.
		** 
		** If CertChain, then the KeyInfo will contain the base64 encoded X.509v3 
		** certificate as well as any certificates available 
		** in the chain of authentication to the root cert.
		** 
		** If IssuerSerial, then the KeyInfo will contain the X.509 issuer's distinguished name 
		** and the signing certificate's serial number.
		** 
		** If SubjectName, then the KeyInfo will contain the X.509 subject distinguished name.
		** 
		** If SKI, then the KeyInfo will contain the base64 encoded value 
		** of the cert's X.509 SubjectKeyIdentifier extension.
		**
		** Fix for version 85: Fixed problem when the property includes “SubjectName” 
		** AND the signing certificate has a subject name that includes the ‘&’ char. 
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 69
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE x509type_assign		&& Assign method used to hold a reference to the X509Type property.
		*==============================================================================
		* Method:            X509Type_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat XMLDSigGen X509Type property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the X509Type property.
		* Returns:           
		* Date Added:        07/05/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 69
		
		lcValidationMethod = [X509Type]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS xmp AS ibasechilkat OF "chilkatvfp.vcx" 		&& Chilkat XMP is a software component (SDK, toolkit, library, etc) for accessing, manipulating, and adding XMP metadata to JPEG and TIFF files.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addarray		&& Adds or replaces an XMP property array. The XMP metadata to be updated is contained in the XML object passed in the 1st argument. The 2nd argument specifies the array type, which can be "bag", "seq", or "alt".
		*m: addnsmapping		&& Adds a namespace to URI mapping. When a property is added via AddSimpleString or any of the other methods, the property name is namespace qualified.
		*m: addsimpledate		&& Undocumented method!
		*m: addsimpleint		&& Adds or updates an XMP integer property. The XMP metadata to be updated is contained in the XML object passed in the 1st argument. The property name should be prefixed with the namespace, such as "tiff:XResolution".
		*m: addsimplestr		&& Adds or updates a simple XMP string property. The XMP metadata to be updated is contained in the XML object passed in the 1st argument. The property name should be prefixed with the namespace, such as "photoshop:Credit".
		*m: addstructprop		&& Adds or updates an XMP structured property value. The XMP metadata to be updated is contained in the XML object passed in the 1st argument. The structure name should be prefixed with the namespace, such as "Iptc4xmpCore:CreatorContactInfo".
		*m: append		&& Appends a new XMP metadata file to the XMP object.
		*m: datetostring		&& Undocumented method! Accepts a VFP DateTime value.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat XMP DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getarray		&& Finds and returns an XMP array property. The property name should be prefixed with the namespace, such as "dc:subject". Returns Nothing on failure.
		*m: getembedded		&& Returns the Nth embedded XMP document as a Chilkat XML object. Returns Nothing on failure.
		*m: getproperty		&& To be documented soon...Returns Nothing on failure.
		*m: getsimpledate		&& Undocumented method!
		*m: getsimpleint		&& Finds and returns an XMP integer property. The property name should be prefixed with the namespace, such as "tiff:ResolutionUnit".
		*m: getsimplestr		&& Finds and returns an XMP simple string property. The property name should be prefixed with the namespace, such as "photoshop:Source". Returns Nothing on failure.
		*m: getstructpropnames		&& Returns the property names used by an exsting structure within an XMP document. The contents of the structure can be retrieved by calling GetStructValue for each property name returned by GetStructPropNames. Returns Nothing on failure.
		*m: getstructvalue		&& Returns the value of a single item within an XMP structure property. Property names should always be prefixed with the namespace. Returns Nothing on failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat XMP LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat XMP LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat XMP LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat XMP LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat XMP LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat XMP LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat XMP LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadappfile		&& Loads a TIFF or JPG file into the XMP object.
		*m: loadfrombuffer		&& Loads a JPG or TIFF from an byte buffer containing the image file data.
		*m: newxmp		&& Creates and returns a new/empty XMP metadata document as a Chilkat XML object. Returns Nothing on failure.
		*m: numembedded_access		&& Access method used to retrieve the Chilkat XMP NumEmbedded property.
		*m: numembedded_assign		&& Assign method used to hold a reference to the NumEmbedded property.
		*m: removeallembedded		&& Removes all XMP metadata documents from an XMP object. After calling this method, call SaveAppFile to rewrite the JPG or TIFF file with the XMP metadata removed. Returns 1 for success, 0 for failure.
		*m: removearray		&& Removes an XMP array property from the XMP document.
		*m: removeembedded		&& Removes a single XMP metadata document from the JPG or TIFF file. Call SaveAppFile to persist the changes to disk. Returns 1 for success, 0 for failure.
		*m: removensmapping		&& Removes a namespace-to-URI mapping.
		*m: removesimple		&& Removes a simple XMP property from the XMP document.
		*m: removestruct		&& Removes an XMP structure property from the XMP document.
		*m: removestructprop		&& Removes a single member from an XMP structured property.
		*m: saveappfile		&& Persists all changes made to the XMP document(s) by saving the XMP object to a file. Changes made by adding, updating, or removing properties are not persisted to the filesystem until this is called.
		*m: savetobuffer		&& Saves a JPG or TIFF image with updated XMP to a byte buffer. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: stringtodate		&& Undocumented method! Probably accepts a RFC822 date/time string and returns a VFP DateTime value.
		*m: structinnerdescrip_access		&& Access method used to retrieve the Chilkat XMP StructInnerDescrip property.
		*m: structinnerdescrip_assign		&& Assign method used to hold a reference to the StructInnerDescrip property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat XMP UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat XMP VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numembedded		&& The number of XMP metadata documents found within the JPG or TIFF file loaded by LoadAppFile.
		*p: structinnerdescrip		&& Determines whether structures are stored with rdf:parseType="Resource", or within an "rdf:Description" sub-node.
		*p: uncommonoptions		&& Introduced in version 9.5.0.80. A property to be used for future uncommon needs. The default value is the empty string.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Xmp
		debuglogfilepath = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "xmp"
		numembedded = 0
		structinnerdescrip = 1
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addarray		&& Adds or replaces an XMP property array. The XMP metadata to be updated is contained in the XML object passed in the 1st argument. The 2nd argument specifies the array type, which can be "bag", "seq", or "alt".
		*==============================================================================
		* Method:            AddArray
		* Purpose:           Adds or replaces an XMP property array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML -- a Chilkat XML object.
		*                    tcArrayType -- the mailbox name to receive the message.
		*                    tcPropertyName -- the property name to add.
		*                    toChilkatStringArray -- a Chilkat String Array object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/04/2022
		*==============================================================================
		
		**
		** Adds or replaces an XMP property array. The XMP metadata to be updated 
		** is contained in the XML object passed in the 1st argument. 
		** The 2nd argument specifies the array type, which can be "bag", "seq", or "alt". 
		** The property name should be prefixed with the namespace, such as "dc:subject".
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL, tcArrayType AS Character, ;
		tcPropertyName AS Character, toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XMP_COM_CALL, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, liReturn AS Integer, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddArray(m.loChilkatXML, m.tcArrayType, ;
		      m.tcPropertyName, m.loChilkatStringArray) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		    toChilkatStringArray = m.loParkParameterStringArray.SetObject(;
		    m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMP_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addnsmapping		&& Adds a namespace to URI mapping. When a property is added via AddSimpleString or any of the other methods, the property name is namespace qualified.
		*==============================================================================
		* Method:            AddNsMapping
		* Purpose:           Adds a namespace to URI mapping.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcNameSpace -- the namespace to add.
		*                    tcURI -- which URI to add the namespace.
		* Returns:           
		* Date Added:        07/04/2022
		*==============================================================================
		
		**
		** Adds a namespace to URI mapping. 
		** When a property is added via AddSimpleString or any of the other methods, 
		** the property name is namespace qualified. When adding the first property in a namespace, 
		** the rdf:Description is automatically added 
		** and the URI is obtained from the namespace-to-URI mappings. 
		** The standard (and commonly used) namespace mappings are defined by default. 
		** This is only used if the namespace is custom or not already handled.
		**
		
		LPARAMETERS tcNameSpace AS Character, tcURI AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMP_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddNsMapping(m.tcNameSpace, m.tcURI)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

