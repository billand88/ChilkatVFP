		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer, ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[24, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have a word to validate test (should be true)
		  IF m.liWords = 1
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = STRTRAN(m.lcValue, [ ])
		
		          la_Values[1, 1] = [BASE64]
		          la_Values[1, 2] = 0
		          la_Values[2, 1] = [MODBASE64]
		          la_Values[2, 2] = 0
		          la_Values[3, 1] = [BASE64URL]
		          la_Values[3, 2] = .GenerateVersionNumber(9, 5, 56)
		          la_Values[4, 1] = [BASE32]
		          la_Values[4, 2] = 0
		          la_Values[5, 1] = [BASE58]
		          la_Values[5, 2] = .GenerateVersionNumber(9, 5, 49)
		          la_Values[6, 1] = [UU]
		          la_Values[6, 2] = 0
		          la_Values[7, 1] = [QP]
		          la_Values[7, 2] = 0
		          la_Values[8, 1] = [URL]
		          la_Values[8, 2] = 0
		          la_Values[9, 1] = [HEX]
		          la_Values[9, 2] = 0
		          la_Values[10, 1] = [Q]
		          la_Values[10, 2] = 0
		          la_Values[11, 1] = [B]
		          la_Values[11, 2] = 0
		          la_Values[12, 1] = [URL_OAUTH]
		          la_Values[12, 2] = 0
		          la_Values[12, 1] = [URL_RFC1738]
		          la_Values[12, 2] = 0
		          la_Values[13, 1] = [URL_RFC2396]
		          la_Values[13, 2] = 0
		          la_Values[14, 1] = [URL_RFC3986]
		          la_Values[14, 2] = 0
		          la_Values[15, 1] = [FINGERPRINT]
		          la_Values[15, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[16, 1] = [DECIMAL]
		          la_Values[16, 2] = .GenerateVersionNumber(9, 5, 55)
		          la_Values[17, 1] = [ASCII85]
		          la_Values[17, 2] = .GenerateVersionNumber(9, 5, 79)
		          la_Values[18, 1] = [BASE45]
		          la_Values[18, 2] = .GenerateVersionNumber(9, 5, 99)
		          la_Values[19, 1] = [BASE64_MIME]
		          la_Values[19, 2] = .GenerateVersionNumber(9, 5, 67)
		          la_Values[20, 1] = [BASE62]
		          la_Values[20, 2] = .GenerateVersionNumber(11, 2, 0)
		          la_Values[21, 1] = [HEX_LOWER]
		          la_Values[21, 2] = 0
		          la_Values[22, 1] = [EDA]
		          la_Values[22, 2] = 0
		          la_Values[23, 1] = [JSON]
		          la_Values[23, 2] = 0
		          la_Values[24, 1] = [DECLIST]
		          la_Values[24, 2] = 0
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End walk through words loop
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords = 1
		  ** End have a word to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encodingmode_ntlm		&& Method run to validate the data for the NTLM EncodingMode property.
		*==============================================================================
		* Method:            EncodingMode_NTLM
		* Purpose:           Method run to validate the data for the EncodingMode_NTLM property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER) ;
		AND INLIST(UPPER(ALLTRIM(m.lcValue)), [BASE64], [MODBASE64], [BASE32], [UU], [QP], ;
		[URL], [HEX], [Q], [B], [URL_OATH], [URL_RFC1738], [URL_RFC2396], [URL_RFC3986])
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE encryption		&& Method run to validate the data for the Encryption property.
		*==============================================================================
		* Method:            Encryption
		* Purpose:           Method run to validate the data for the Encryption property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		liValue AS Integer, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		liValue = m.tiValue
		
		llValidated = (VARTYPE(m.liValue) == T_INTEGER) ;
		AND BETWEEN(m.liValue, 0, 4)
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE encryptkeylength		&& Method run to validate the data for the EncryptKeyLength property.
		*==============================================================================
		* Method:            EncryptKeyLength
		* Purpose:           Method run to validate the data for the EncryptKeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		liValue AS Integer, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		liValue = m.tiValue
		
		llValidated = (VARTYPE(m.liValue) == T_INTEGER) ;
		AND INLIST(m.liValue, 128, 192, 256)
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE forcecipher		&& Method run to validate the data for the ForceCipher property.
		*==============================================================================
		* Method:            ForceCipher
		* Purpose:           Method run to validate the data for the ForceCipher property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/18/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER) ;
		AND (EMPTY(m.lcValue) ;
		OR INLIST(UPPER(ALLTRIM(m.lcValue)), [AES256-CTR], [AES128-CTR], [AES256-CBC], [AES128-CBC], ;
		[TWOFISH256-CBC], [TWOFISH128-CBC], [BLOWFISH128-CBC], [3DES-CBC], [ARCFOUR128], [ARCFOUR256]))
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE forceportipaddress		&& Method run to validate the data for the ForcePortIPAddress property.
		*==============================================================================
		* Method:            ForcePortIPAddress
		* Purpose:           Method run to validate the data for the ForcePortIPAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/18/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical, liCalculatedBuildNumber AS Integer
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = .T.
		
		WITH m.loChilkatWrapper
		
		  liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		  loVersioning = .oVersioning
		
		  ** Have versioning object test
		  IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		    WITH m.loVersioning
		
		      ** Binding prefix and before it was implemented test
		      IF LEFTC(m.lcValue, 5) == [BIND-] ;
		      AND m.liCalculatedBuildNumber < .GenerateVersionNumber(9, 5, 58)
		
		        llValidated = .F.
		
		      ENDIF LEFTC(m.lcValue, 5) == [BIND-] ;
		      AND m.liCalculatedBuildNumber < .GenerateVersionNumber(9, 5, 58)
		      ** End binding prefix and before it was implemented test
		
		    ENDWITH 
		
		  ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		  ** End have versioning object test
		
		ENDWITH
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE fromcharset		&& Method run to validate the data for the FromCharset property.
