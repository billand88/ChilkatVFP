	PROCEDURE fetchchunk		&& Fetches a chunk of emails starting at a specific sequence number. A bundle of fetched emails is returned. The last two arguments are message sets that are updated with the ids of messages successfully/unsuccessfully fetched.
		*==============================================================================
		* Method:            FetchChunk
		* Purpose:           Fetches a chunk of emails starting at a specific sequence number.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiStartingSequence -- the starting sequence number.
		*                    tiCount -- the number of emails to fetch
		*                    toChilkatMessageSetFailed -- a Chilkat Message Set object.
		*                    toChilkatMessageSetFetched -- a Chilkat Message Set object.
		* Returns:           Chilkat EMail Bundle object, or NULL
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Fetches a chunk of emails starting at a specific sequence number. 
		** A bundle of fetched emails is returned. The last two arguments 
		** are message sets that are updated with the ids of messages 
		** successfully/unsuccessfully fetched.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiStartingSequence AS Integer, tiCount AS Integer, ;
		toChilkatMessageSetFailed AS CHILKAT_MESSAGESET_COM_CALL, ;
		toChilkatMessageSetFetched AS CHILKAT_MESSAGESET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loParkParameterMessageSetFailed AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMessageSetFailed AS CHILKAT_MESSAGESET_COM_CALL, ;
		loParkParameterMessageSetFetched AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMessageSetFetched AS CHILKAT_MESSAGESET_COM_CALL, ;
		loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmailBundle, ;
		m.loParkParameterMessageSetFailed, m.loChilkatMessageSetFailed, ;
		m.loParkParameterMessageSetFetched, m.loChilkatMessageSetFetched
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterMessageSetFailed = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSetFailed)
		
		    loParkParameterMessageSetFetched = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSetFetched)
		
		    loChilkatMessageSetFailed = m.loParkParameterMessageSetFailed.GetObject()
		    loChilkatMessageSetFetched = m.loParkParameterMessageSetFetched.GetObject()
		
		    TRY
		
		      loChilkatEmailBundle = m.loChilkatObject.FetchChunk(m.tiStartingSequence, ;
		      m.tiCount, m.loChilkatMessageSetFailed, m.loChilkatMessageSetFetched)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatMessageSetFailed = m.loParkParameterMessageSetFailed.SetObject(;
		    m.toChilkatMessageSetFailed, m.loChilkatMessageSetFailed)
		
		    toChilkatMessageSetFetched = m.loParkParameterMessageSetFetched.SetObject(;
		    m.toChilkatMessageSetFetched, m.loChilkatMessageSetFetched)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSetFailed, m.loChilkatMessageSetFailed, ;
		m.loParkParameterMessageSetFetched, m.loChilkatMessageSetFetched
		
		RETURN m.loChilkatEmailBundle
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMessageSetFailed = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  toChilkatMessageSetFetched = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loParkParameterMessageSetFailed = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSetFailed = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loParkParameterMessageSetFetched = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSetFetched = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loChilkatEmailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE fetchchunk2		&& Introduced in version 11.0.0. Downloads a range of full emails based on a starting sequence number (seqnum) and count. The failed sequence numbers are recorded in failedSet. The fetched sequence numbers are recorded in fetchedSet.
		*==============================================================================
		* Method:            FetchChunk2
		* Purpose:           Downloads a range of full emails based on 
		*                    a starting sequence number (seqnum) and count.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiSequenceNumber -- the sequence number to start fetching.
		*                    tiCount -- the number of emails to retrieve.
		*                    toMessageSetFailed -- a Chilkat Message Set object.
		*                    toMessageSetFetched -- a Chilkat Message Set object.
		*                    toEmailBundle -- a Chilkat EmailBundle object 
		*                    to hold the retrieved set of records.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Downloads a range of full emails based on a starting sequence number (seqnum) and count. 
		** The failed sequence numbers are recorded in failedSet. 
		** The fetched sequence numbers are recorded in fetchedSet. 
		** The downloaded emails are returned in bundle.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiSequenceNumber AS Integer, tiCount AS Integer, ;
		toMessageSetFailed AS CHILKAT_MESSAGESET_COM_CALL, toMessageSetFetched AS CHILKAT_MESSAGESET_COM_CALL, ;
		toEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterMessageSetFailed AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterMessageSetFetched AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterEmailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loMessageSetFailed AS CHILKAT_MESSAGESET_COM_CALL, loMessageSetFetched AS CHILKAT_MESSAGESET_COM_CALL, ;
		loEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSetFailed, m.loParkParameterMessageSetFetched, ;
		m.loMessageSetFailed, m.loMessageSetFetched, ;
		m.loParkParameterEmailBundle, m.loEmailBundle
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterMessageSetFailed = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toMessageSetFailed)
		
		      loMessageSetFailed = m.loParkParameterMessageSetFailed.GetObject()
		
		      loParkParameterMessageSetFetched = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toMessageSetFetched)
		
		      loMessageSetFetched = m.loParkParameterMessageSetFetched.GetObject()
		
		      loParkParameterEmailBundle = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toEmailBundle)
		
		      loEmailBundle = m.loParkParameterEmailBundle.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FetchChunk2(m.tiSequenceNumber, ;
		        m.tiCount, m.loMessageSetFailed, m.loMessageSetFetched, ;
		        loEmailBundle) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toMessageSetFailed = ;
		      m.loParkParameterMessageSetFailed.SetObject(m.toMessageSetFailed, m.loMessageSetFailed)
		
		      toMessageSetFetched = ;
		      m.loParkParameterMessageSetFetched.SetObject(m.toMessageSetFetched, m.loMessageSetFetched)
		
		      toEmailBundle = ;
		      m.loParkParameterEmailBundle.SetObject(m.toEmailBundle, m.loEmailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSetFailed, m.loMessageSetFailed, ;
		m.loParkParameterMessageSetFetched, m.loMessageSetFetched, ;
		m.loParkParameterEmailBundle, m.loEmailBundle 
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toMessageSetFailed  = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  toMessageSetFetched  = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  toEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterMessageSetFailed = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterMessageSetFetched = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterEmailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loMessageSetFailed = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loMessageSetFetched = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

