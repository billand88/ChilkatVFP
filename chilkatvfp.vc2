	PROCEDURE hasrequestheader		&& Returns true if the specified header field is defined such that it will be sent with all GET requests issued by the QuickGet and QuickGetStr methods.
		*==============================================================================
		* Method:            HasRequestHeader
		* Purpose:           Returns true if the specified header field is defined such that 
		*                    it will be sent with all GET requests issued 
		*                    by the QuickGet and QuickGetStr methods.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeaderName -- the header name to check if set with GET requests.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Returns true if the specified header field is defined such that 
		** it will be sent with all GET requests issued by the QuickGet and QuickGetStr methods.
		**
		
		LPARAMETERS tcHeaderName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.HasRequestHeader(m.tcHeaderName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat HTTP HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** This property is only valid in programming environment 
		** and languages that allow for event callbacks.
		**
		** Specifies the time interval in milliseconds between AbortCheck events. 
		** A value of 0 (the default) indicate that no AbortCheck events will fire. 
		** Any HTTP operation can be aborted via the AbortCheck event.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold a reference to the HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the HeartbeatMs property.
		* Returns:           
		* Date Added:        01/27/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [HeartbeatMs]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE httpbd		&& Introduced in version 11.0.0. Sends an HTTP request to url using the specified HTTP verb (e.g., POST, PUT, PATCH). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            HttpBd
		* Purpose:           Sends an HTTP request to url using the specified HTTP verb (e.g., POST, PUT, PATCH).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb -- the verb for the HTTP request.
		*                    tcURL -- the URL to retrieve.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		*                    tcContentType -- sets the content type header information.
		*                    toChilkatHTTPRequest -- a Chilkat HTTP Request object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Sends an HTTP request to url using the specified HTTP verb (e.g., POST, PUT, PATCH). 
		** The body of the request is defined by bd, and the Content-Type header is set by contentType, 
		** with possible values like application/octet-stream, application/pdf, image/jpeg, or application/zip.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		tcContentType AS Character, toChilkatHTTPRequest AS CHILKAT_HTTPREQUEST_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterHttpRequest AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, loChilkatHttpRequest AS CHILKAT_HTTPREQUEST_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData, ;
		m.loParkParameterHttpRequest, m.loChilkatHttpRequest
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      loParkParameterHttpRequest = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHttpRequest)
		
