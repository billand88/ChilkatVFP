	HIDDEN PROCEDURE ignoreaccessdenied_access		&& Access method used to retrieve the Chilkat ZIP IgnoreAccessDenied property.
		*==============================================================================
		* Method:            IgnoreAccessDenied_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP IgnoreAccessDenied property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IgnoreAccessDenied
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** If 1, then files that cannot be read due to "access denied" 
		** (i.e. a file permission error) will be ignored 
		** and the call to WriteZip, WriteZipAndClose, WriteExe, etc. 
		** will return a success status. 
		** If 0, then the "access denied" filesystem errors are not ignored 
		** and any occurrence will cause the zip writing to fail. 
		** The default value is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE ignoreaccessdenied_assign		&& Assign method used to hold a reference to the IgnoreAccessDenied property.
		*==============================================================================
		* Method:            IgnoreAccessDenied_Assign
