	PROCEDURE loadpemfile		&& Loads the certificates contained within a PEM formatted file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadPEMFile
		* Purpose:           Loads the certificates contained within a PEM formatted file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMFilePath, the path to the PEM file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Loads the certificates contained within a PEM formatted file.
		**
		** Fixed for Version 58: Fixed a memory leak in this method.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPEMFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadPEMFile(m.tcPEMFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpemstr		&& Loads the certificates contained within an in-memory PEM formatted string. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadPEMStr
		* Purpose:           Loads the certificates contained within an in-memory PEM formatted string.
		* Author:            Bill Anderson
