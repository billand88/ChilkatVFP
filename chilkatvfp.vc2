	PROCEDURE getcurrentstate		&& Introduced in version 9.5.0.65. Returns the current state of existing tunnels in an XML string. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetCurrentState
		* Purpose:           Returns the current state of existing tunnels in an XML string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           XML string with the current state.
		* Date Added:        07/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Returns the current state of existing tunnels in an XML string.
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_SSHTUNNEL_COM_CALL, loException AS Exception, ;
		lcCurrentState AS Character, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical, lcCurrentState AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcCurrentState = []
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcCurrentState = m.loChilkatObject.GetCurrentState()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcCurrentState
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE hostkeyfingerprint_access		&& Access method used to retrieve the Chilkat SSHTunnel HostKeyFingerprint property.
		*==============================================================================
		* Method:            HostKeyFingerprint_Access
		* Purpose:           Access method used to retrieve 
		*                    the HostKeyFingerprint property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HostKeyFingerprint
		* Date Added:        07/07/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.56
		**
		** Set after connecting to an SSH server. The format of the fingerprint looks like this:
		** "ssh-rsa 1024 68:ff:d1:4e:6c:ff:d7:b0:d6:58:73:85:07:bc:2e:d5"
		**
		** Enhancement for Version 83: Improved support for Ed25519 private keys.
		**
		** Fixed for version 91: Fixed the property for cases where the SSH server’s host key is ED25519.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE hostkeyfingerprint_assign		&& Assign method used to hold a reference to the HostKeyFingerprint property.
		*==============================================================================
		* Method:            HostKeyFingerprint_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the HostKeyFingerprint property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the HostKeyFingerprint property.
		* Returns:           
		* Date Added:        07/07/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE httpproxyauthmethod_access		&& Access method used to retrieve the Chilkat SSHTunnel HTTPProxyAuthMethod property.
		*==============================================================================
		* Method:            HTTPProxyAuthMethod_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSHTunnel HTTPProxyAuthMethod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HTTPProxyAuthMethod
		* Date Added:        07/07/2022
		*==============================================================================
		
		**
		** If an HTTP proxy requiring authentication is to be used, 
		** set this property to the HTTP proxy authentication method name. 
		** Valid choices are "Basic" or "NTLM".
		**
		** Note: This is for the outbound connection to the SSH server. 
		** It is used when the outbound connection to the SSH server 
		** must go through an HTTP proxy.
		**
		** Fixed in Version 51: Fixed issues related to using 
		** HTTP proxies for non-HTTP protocols where SSL/TLS is not used.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE httpproxyauthmethod_assign		&& Assign method used to hold a reference to the HTTPProxyAuthMethod property.
		*==============================================================================
		* Method:            HTTPProxyAuthMethod_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SSHTunnel HTTPProxyAuthMethod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
