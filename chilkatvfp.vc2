	PROCEDURE serialize		&& Serializes the date/time to a us-ascii string that can be imported at a later time via the DeSerialize method. The format of the string returned by this method is not intended to match any published standard.
		*==============================================================================
		* Method:            Serialize
		* Purpose:           Loads the date/time with a string having the format 
		*                    as produced by the Serialize method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The serialized date string.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Serializes the date/time to a us-ascii string that can be imported 
		** at a later time via the DeSerialize method. The format of the string returned 
		** by this method is not intended to match any published standard. 
		** It is formatted to a string with SPACE separated integers containing 
		** (in this order) year, month, day, hour, minutes, seconds, 
		** and a UTC flag having the value of 1/0.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_DTOBJ_COM_CALL, ;
		loException AS Exception, lcSerializedDate AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcSerializedDate = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcSerializedDate = m.loChilkatObject.Serialize()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcSerializedDate
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DTOBJ_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE structtmmonth_access		&& Access method used to retrieve the Chilkat DtObj StructTmMonth property.
		*==============================================================================
		* Method:            StructTmMonth_Access
		* Purpose:           Access method used to retrieve 
