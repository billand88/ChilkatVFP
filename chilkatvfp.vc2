		* Date Added:        05/02/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [CompressionLevel]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE compressionmethod_access		&& Access method used to retrieve the Chilkat ZIPEntry CompressedMethod property.
		*==============================================================================
		* Method:            CompressionMethod_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP CompressionMethod property.
		* Author:            Bill Anderson
