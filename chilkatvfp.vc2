	PROCEDURE nlstxml		&& Sends an NLST command to the FTP server and returns the results in XML format. The NLST command returns a list of filenames in the given directory (matching the pattern).
		*==============================================================================
		* Method:            NLSTXML
		* Purpose:           Sends an NLST command to the FTP server 
		*                    and returns the results in XML format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteDirectoryPattern -- the remote directory pattern.
		* Returns:           Character
		* Date Added:        03/04/2022
		*==============================================================================
		
		**
		** Sends an NLST command to the FTP server and returns the results in XML format. 
		** The NLST command returns a list of filenames in the given directory (matching the pattern). 
		** The remoteDirPattern should be a pattern such as "*", "*.*", "*.txt", "subDir/*.xml", etc.
		**
		** The format of the XML returned is:
		**
		** <nlst>
		** <e>filename_or_dir_1</e>
		** <e>filename_or_dir_2</e>
		** <e>filename_or_dir_3</e>
		** <e>filename_or_dir_4</e>
		** ...
		** </nlst>
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemoteDirectoryPattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXML = m.loChilkatObject.NLSTXML(m.tcRemoteDirectoryPattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

