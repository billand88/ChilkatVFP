		**         <ds:X509Data>
		**            <ds:X509SubjectName>CERTIFICADO DE ABC</ds:X509SubjectName>
		**            <ds:X509Certificate>MIIITTCC....fIsIZeZOeQ=</ds:X509Certificate>
		**         </ds:X509Data>
		**      </ds:KeyInfo>
		**   ...
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
