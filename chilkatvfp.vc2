	PROCEDURE getalluids		&& Returns a message set object containing all the UIDs in the currently selected mailbox. A NULL object reference is returned on failure. Returns Nothing on failure
		*==============================================================================
		* Method:            GetAllUIDs
		* Purpose:           Returns a message set object containing 
		*                    all the UIDs in the currently selected mailbox.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat Message Set object, or NULL
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Returns a message set object containing all the UIDs 
		** in the currently selected mailbox. 
		** A NULL object reference is returned on failure.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatMessageSet
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatMessageSet = m.loChilkatObject.GetAllUIDs()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
