	PROCEDURE savebinarycontent		&& Saves a node's binary content to a file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SaveBinaryConttent
		* Purpose:           Saves a node's binary content to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the attribute name to search for.
		*                    tuUnZip -- determines whether or not unzipping is needed.
		*                    tuAESDecryption -- determines if AES encryption was used.
		*                    tcPassword -- the attribute value to search for.
		* Returns:           Returns the number of style sheets removed.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Saves a node's binary content to a file.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFileName AS Character, tuUnZip AS Unknown, ;
		tuAESDecryption AS Unknown, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liUnZip AS Integer, ;
		liAESDecryption AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUnZip, m.liAESDecryption
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUnZip = .LogicalToBit(m.tuUnZip)
		    liAESDecryption = .LogicalToBit(m.tuAESDecryption)
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.SaveBinaryConttent(m.tcFileName, m.liUnZip, ;
		      m.liAESDecryption, m.tcPassword) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

