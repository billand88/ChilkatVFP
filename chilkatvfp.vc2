		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.OpenFileAsync(m.tcRemotePath, m.tcFileAccess, m.tcCreateDisposition)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE passwordchangerequested_access		&& Access method used to retrieve the Chilkat SFTP PasswordChangeRequested property.
		*==============================================================================
		* Method:            PasswordChangeRequested_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP PasswordChangeRequested property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PasswordChangeRequested
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Set by the AuthenticatePw and AuthenticatePwPk methods. 
		** If the authenticate method returns a failed status, 
		** and this property is set to 1, 
		** then it indicates the server requested a password change. 
		** In this case, re-call the authenticate method, 
		** but provide both the old and new passwords in the following format, 
		** where vertical bar characters encapsulate the old and new passwords:
		**
		** |oldPassword|newPassword|
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE passwordchangerequested_assign		&& Assign method used to hold a reference to the PasswordChangeRequested property.
		*==============================================================================
		* Method:            PasswordChangeRequested_Assign
		* Purpose:           Assign method used to hold a reference 
		*                    to the PasswordChangeRequested property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PasswordChangeRequested property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE percentdonescale_access		&& Access method used to retrieve the Chilkat SFTP PercentDoneScale property.
		*==============================================================================
		* Method:            PercentDoneScale_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP PercentDoneScale property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PercentDoneScale
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** This property is only valid in programming environment and languages that allow for event callbacks.
		**
		** Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks. 
		** The defaut value of 100 means that at most 100 event PercentDone callbacks will occur 
		** in a method that (1) is event enabled and (2) is such that it is possible 
		** to measure progress as a percentage completed. This property may be set to larger numbers 
		** to get more fine-grained PercentDone callbacks. For example, setting this property equal 
		** to 1000 will provide callbacks with .1 percent granularity. 
		** For example, a value of 453 would indicate 45.3% competed. 
		** This property is clamped to a minimum value of 10, and a maximum value of 100000.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*==============================================================================
		* Method:            PercentDoneScale_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat SFTP PercentDoneScale property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the PercentDoneScale property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = [PercentDoneScale]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE preferipv6_access		&& Access method used to retrieve the Chilkat SFTP PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PreferIPV6
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** If 1, then use IPv6 over IPv4 when both are supported for a particular domain. 
		** The default value of this property is 0, which will choose IPv4 over IPv6.
		**
		** Enhancement for version 70: Added internal re-try functionality 
		** to cope with various situations for IPv4-only and IPv6-only networks.
		**
		** (Note: Chilkat was updated in v9.5.0.97 to enable "dual-stack" support, 
		** where a server can handle both IPv6 and IPv4 traffic using a single socket. 
		** Prior to v9.5.0.97, setting this property to 1 
		** had the effect that only IPv6 connections could be accepted.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Assign
		* Purpose:           Assign method used to hold a reference to the PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PreferIPV6 property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE preservedate_access		&& Access method used to retrieve the Chilkat SFTP PreserveDate property.
		*==============================================================================
		* Method:            PreserveDate_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP PreserveDate property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PreserveDate
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** If 1, then the file last-modified and create date/time will be preserved 
		** for downloaded and uploaded files. The default value is 0.
		**
		** Note: Prior to version 9.5.0.40, this property only applied to downloads. 
		** Starting in v9.5.0.40, it also applies to the UploadFileByName method.
		** 
		** It does not apply to uploads or downloads where the remote file is opened 
		** to obtain a handle, the data is uploaded/downloaded, and then the handle is closed.
		** 
		** The last-mod date/times are always preserved 
		** in the SyncTreeDownload and SyncTreeUpload methods.
		**
		** Enhancement for Version 41: Improved SFTP behavior when the this property is turned on. 
		** Some SSH/SFTP servers did not allow for setting the last-mod date/time 
		** using an open file handle until the file is actually closed. 
		** Internally, Chilkat automatically handles this problem by setting 
		** the last-mod date/time after the file is closed using the remote file path.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE preservedate_assign		&& Assign method used to hold a reference to the PreserveDate property.
		*==============================================================================
		* Method:            PreserveDate_Assign
		* Purpose:           Assign method used to hold a reference to the PreserveDate property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PreserveDate property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE protocolversion_access		&& Access method used to retrieve the Chilkat SFTP ProtocolVersion property.
		*==============================================================================
		* Method:            ProtocolVersion_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP ProtocolVersion property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ProtocolVersion
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** The negotiated SFTP protocol version, which should be a value between 3 and 6 inclusive. 
		** When the InitializeSftp method is called, the Chilkat SFTP client 
		** sends it's highest supported protocol version to the server, 
		** and the server sends it's SFTP protocol version in response. 
		** The negotiated protocol (i.e. the protocol version used for the session) 
		** is the lower of the two numbers. 
		** If the SFTP server's protocol version is lower than 6, 
		** some file date/attributes are not supported because 
		** they are not supported by the earlier protocol version. 
		** These exceptions are noted throughout the reference documentation.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE protocolversion_assign		&& Assign method used to hold a reference to the ProtocolVersion property.
		*==============================================================================
		* Method:            ProtocolVersion_Assign
		* Purpose:           Assign method used to hold a reference to the ProtocolVersion property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ProtocolVersion property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE readdir		&& Reads the contents of a directory and returns the directory listing (as an object). The handle returned by OpenDir should be passed to this method. Returns Nothing on failure
		*==============================================================================
		* Method:            ReadDir
		* Purpose:           Reads the contents of a directory and returns the directory listing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile().
		* Returns:           toSFtpDir, a Chilkat SFTP Directory object.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Reads the contents of a directory and returns the directory listing (as an object). 
		** The handle returned by OpenDir should be passed to this method.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHandle AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, loSFtpDir AS CHILKAT_SFTPDIR_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loSFtpDir
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loSFtpDir = m.loChilkatObject.ReadDir(m.tcHandle)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loSFtpDir
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loSFtpDir = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readdirasync		&& Creates an asynchronous task to call the ReadDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.). Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            ReadDirAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the ReadDir method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the ReadDir method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHandle AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.ReadDirAsync(m.tcHandle)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readdirlisting		&& Introduced in version 11.0.0. Reads the contents of a directory and returns the directory listing in dirObj. The handle returned by OpenDir should be passed to this method. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ReadDirListing
		* Purpose:           Reads the contents of a directory 
		*                    and returns the directory listing in dirObj. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryHandle -- the path to the remote file.
		*                    toChilkatSftpDir, a Chilkat Sftp Directory object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Reads the contents of a directory and returns the directory listing in dirObj. 
		** The handle returned by OpenDir should be passed to this method.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcDirectoryHandle AS Character, toChilkatSftpDir AS CHILKAT_SFTPDIR_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterSftpDir AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSftpDir AS CHILKAT_SFTPDIR_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSftpDir, m.loChilkatSftpDir
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSftpDir = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSftpDir)
		
		      loChilkatSftpDir = m.loParkParameterSftpDir.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ReadDirListing(m.tcDirectoryHandle, m.loChilkatSftpDir) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSftpDir = ;
		      m.loParkParameterSftpDir.SetObject(m.toChilkatSftpDir, m.loChilkatSftpDir)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSftpDir, m.loChilkatSftpDir
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatSftpDir = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loParkParameterSftpDir = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSftpDir = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

