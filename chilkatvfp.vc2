	PROCEDURE fetchemail		&& Introduced in version 11.0.0. Downloads an email or its header based on provided arguments. If headerOnly is 1, only the email header is downloaded. The email is identified by msgId, which can be either a UID or sequence number.
		*==============================================================================
		* Method:            FetchEmail
		* Purpose:           Downloads an email or its header based on provided arguments.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuHeaderOnly -- whether or not to download just the header.
		*                    tiMessageID -- the starting message ID number.
		*                    tuUID -- whether or not the message ID is a UID.
		*                    toChilkatEMail -- a Chilkat Email object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Downloads an email or its header based on provided arguments. 
		** If headerOnly is 1, only the email header is downloaded. 
		** The email is identified by msgId, which can be either a UID or sequence number. 
		** bUid determines the type: if 1, msgId is a UID; otherwise, it's a sequence number. 
		** The result is stored in email. If downloading the full email and AutoDownloadAttachments is 1, 
		** attachments are included.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuHeaderOnly AS Unknown, tiMessageID AS Integer, ;
		tuUID AS Unknown, toChilkatEMail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterEMail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMail AS CHILKAT_EMAIL_COM_CALL, llImplemented AS Logical, ;
		liHeaderOnly AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liHeaderOnly, m.liUID
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMail, m.loChilkatEMail
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liHeaderOnly = .LogicalToBit(m.tuHeaderOnly)
		      liUID = .LogicalToBit(m.tuUID)
		
		      loParkParameterEMail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMail)
		
		      loChilkatEMail = m.loParkParameterEMail.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FetchEmail(m.liHeaderOnly, ;
		        m.tiMessageID, m.liUID, m.loChilkatEMail) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEMail = m.loParkParameterEMail.SetObject(;
		      m.toChilkatEMail, m.loChilkatEMail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMail, m.loChilkatEMail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEMail  = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEMail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEMail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE fetchemailasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchEmail method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*==============================================================================
