	PROCEDURE loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadTaskCaller
		* Purpose:           Loads the caller of the task's async method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTask, a Chilkat Task object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Loads the caller of the task's async method.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatTask AS [Chilkat_9_5_0.Task]
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Rss], loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterTask AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTask AS [Chilkat_9_5_0.Task], liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn  
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTask = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTask)
		
		      loChilkatTask = m.loParkParameterTask.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadTaskCaller(m.loChilkatTask) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTask = ;
		      m.loParkParameterTask.SetObject(m.toChilkatTask, m.loChilkatTask)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Rss])
		  toChilkatTask = NEWOBJECT([Chilkat_9_5_0.Task])
		  loParkParameterTask = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTask = NEWOBJECT([Chilkat_9_5_0.Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE mgetattr		&& Get an attribute value for the Nth sub-element having a specific tag. As an example, an RSS item may have several "category" sub-elements.  To get the value of the "domain" attribute for the 3rd category, call MGetAttr("category",2,"domain").
		*==============================================================================
		* Method:            MGetAttr
		* Purpose:           Get an attribute value for the Nth sub-element having a specific tag.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTag -- the tag to match.
		*                    tiIndex -- the category index value.
		*                    tcAttributeName -- the attribute name to match.
		* Returns:           The string value at the location.
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** Get an attribute value for the Nth sub-element having a specific tag. 
		** As an example, an RSS item may have several "category" sub-elements. 
		** To get the value of the "domain" attribute for the 3rd category, 
		** call MGetAttr("category",2,"domain").
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTag AS Character, ;
		tiIndex AS Integer, tcAttributeName AS Character
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Rss], ;
		loException AS Exception, lcValue AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcValue = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcValue = ;
		      m.loChilkatObject.MGetAttr(m.tcTag, m.tiIndex, m.tcAttributeName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Rss])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

