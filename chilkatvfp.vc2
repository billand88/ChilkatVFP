	ENDPROC

	PROCEDURE settokenparam		&& Introduced in version 9.5.0.65. Adds a token parameter name/value. This is a value that is included in the string to sign, and is also included as a parameter in the Authorization header. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetTokenParam
		* Purpose:           Adds a token parameter name/value.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcParameterName, the parameter name.
		*                    tcAuthorizationName, the authorization name.
		*                    tcParameterValue, the parameter value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Adds a token parameter name/value. This is a value that is included 
		** in the string to sign, and is also included as a parameter in the Authorization header.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcParameterName AS Character, ;
		tcAuthorizationName AS Character, tcParameterValue AS Character
		
		LOCAL loChilkatObject AS [CHILKAT_AUTHAZURESAS_COM_CALL], ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetTokenParam(m.tcParameterName, ;
		        m.tcAuthorizationName, m.tcParameterValue) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([CHILKAT_AUTHAZURESAS_COM_CALL])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
