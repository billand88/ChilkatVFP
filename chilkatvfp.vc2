	PROCEDURE fetchattachment		&& Downloads one of an email's attachments and saves it to a file.
		*==============================================================================
		* Method:            FetchAttachment
		* Purpose:           Downloads one of an email's attachments and saves it to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail -- a Chilkat Email object.
		*                    tiAttachIndex -- the attachment index.
		*                    tcSaveToPath -- the path to save the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Downloads one of an email's attachments and saves it to a file. 
		** If the emailObject already contains the full email (including the attachments), 
		** then no communication with the IMAP server is necessary 
		** because the attachment data is already contained within the emailObject. 
		** In this case, the attachment is simply extracted and saved to saveToPath. 
		** (As with all Chilkat methods, indexing begins at 0. 
		** The 1st attachment is at attachmentIndex 0.)
		**
		** Additional Notes:
		**
		** If the AutoDownloadAttachments property is set to 0, 
		** then emails downloaded via any of the Fetch* methods will not include attachments.
		**
		** Note: "related" items are not considered attachments and are downloaded. 
		** These are images, style sheets, etc. that are embedded within the HTML body of an email.
		**
		** Also: All signed and/or encrypted emails must be downloaded in full.
		**
		** When an email is downloaded without attachments, the attachment information 
		** is included in header fields. The header fields have names beginning with "ckx-imap-". 
		** The attachment information can be obtained via the following methods:
		** 
		** imap.GetMailNumAttach
		** imap.GetMailAttachFilename
		** imap.GetMailAttachSize
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		tiAttachIndex AS Integer, tcSaveToPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.FetchAttachment(m.loChilkatEmail, ;
		      m.tiAttachIndex, m.tcSaveToPath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

