	PROCEDURE dnscacheclear		&& Clears the Chilkat-wide in-memory hostname-to-IP address DNS cache. Chilkat automatically maintains this in-memory cache to prevent redundant DNS lookups.
		*==============================================================================
		* Method:            DNSCacheClear
		* Purpose:           Clears the Chilkat-wide in-memory hostname-to-IP address DNS cache.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.38
		**
		** Clears the Chilkat-wide in-memory hostname-to-IP address DNS cache. 
		** Chilkat automatically maintains this in-memory cache to prevent redundant DNS lookups. 
		** If the TTL on the DNS A records being accessed 
		** are short and/or these DNS records change frequently, 
		** then this method can be called clear the internal cache. 
		** Note: The DNS cache is used/shared among all Chilkat objects in a program, 
		** and clearing the cache affects all Chilkat objects.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 38
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.DNSCacheClear() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE download		&& Retrieves the content at a URL and saves to a file. All content is saved in streaming mode such that the memory footprint is small and steady. HTTPS is fully supported, as it is with all the methods of this class. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Download
		* Purpose:           Retrieves the content at a URL and saves to a file. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to retrieve the content.
		*                    tcLocalFilePath -- the path to save the download.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** Retrieves the content at a URL and saves to a file. 
		** All content is saved in streaming mode such that the memory footprint is small and steady. 
		** HTTPS is fully supported, as it is with all the methods of this class.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURL AS Character, tcLocalFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.Download(m.tcURL, m.tcLocalFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE downloadappend		&& Same as the Download method, but the output file is open for append. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DownloadAppend
		* Purpose:           Same as the Download method, but the output file is open for append.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to retrieve the content.
		*                    tcLocalFilePath -- the path to save the download.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** Same as the Download method, but the output file is open for append.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed in version 95: It was overwriting rather than appending as it should have.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURL AS Character, tcLocalFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DownloadAppend(m.tcURL, m.tcLocalFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

