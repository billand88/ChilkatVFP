		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE importcert		&& Introduced in version 9.5.0.87. Imports a certificate with its private key onto the smart card.
		*==============================================================================
		* Method:            ImportCert
		* Purpose:           Imports a certificate with its private key onto the smart card.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tiIndex, the key container index value.
		*                    tcKeySpec, the key specification.
		*                    tcPINID, the PIN ID value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Imports a certificate with its private key onto the smart card. 
		** The cert must have an accessible private key, 
		** such as will be the case if the cert was loaded from a .pfx/.p12, 
		** or if the cert was loaded from a Windows certificate store 
		** where the private key exists (and can be exported from the Windows certificate store).
		** 
		** The containerIndex is the container index. It can range from 0 to the MaxContainers-1.
		** 
		** The keySpec can be "sig" or "kex" to specify either the "signature" 
		** or "key exchange" location within the container.
		** 
		** The pinId can be "user", or "3" through "7". (It is typically "user".)
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		tiIndex AS Integer, tcKeySpec AS Character, tcPINID AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], liReturn AS Integer, ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ImportCert(m.loChilkatCert, ;
		        m.tiIndex, m.tcKeySpec, m.tcPINID) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE importkey		&& Introduced in version 9.5.0.87. Imports a key to be stored in either the "signature" or "key exchange" location within a key container. Creates the key container if it does not already exist. Otherwise replaces the specified key in the key container.
		*==============================================================================
		* Method:            ImportKey
		* Purpose:           Imports a key to be stored in either the "signature" 
		*                    or "key exchange" location within a key container.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the key container index value.
		*                    tcKeySpec, the key specification.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		*                    tcPINID, the PIN ID value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Imports a key to be stored in either the "signature" or "key exchange" location 
		** within a key container. Creates the key container if it does not already exist. 
		** Otherwise replaces the specified key in the key container.
		** 
		** The containerIndex is the container index. It can range from 0 to the MaxContainers-1.
		** 
		** The keySpec can be "sig" or "kex" to specify either the "signature" 
		** or "key exchange" location within the container.
		** 
		** The pinId can be "user", or "3" through "7". (It is typically "user".)
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tcKeySpec AS Character, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, tcPINID AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter AS ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ImportKey(m.tiIndex, m.tcKeySpec, ;
		        m.loChilkatPrivateKey, m.tcPINID) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87 && 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLastBinaryResult, the last binary result.
		* Returns:           
		* Date Added:        07/09/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		lcValidationMethod = []
		lcMethodToCall = [VariantReadOnly]
		
		THIS.CallAssignObject(m.tqValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE lasterrorhtml_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastErrorHTML property.
		*==============================================================================
		* Method:            LastErrorHTML_Access
