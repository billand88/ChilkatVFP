	PROCEDURE fetchuidlsetasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchUidlSet method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            FetchUidlAsync
		* Purpose:           Creates an asynchronous task to call the FetchUidl method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringTable -- a Chilkat String Table object.
		*                    tuHeadersOnly -- whether or not to download just the header.
		*                    tiNumBodyLines -- the number of body lines to download.
		*                    toChilkatEMailBundle -- a Chilkat EmailBundle object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Creates an asynchronous task to call the FetchUidl method with the arguments provided.
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Fixed for Version 11.6.0: Fixed a crash bug.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatStringTable AS Unknown, tuHeadersOnly AS Unknown, ;
		tiNumBodyLines AS Integer, toChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, liHeadersOnly AS Integer, ;
		loException AS Exception, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, ;
		loParkParameterEMailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		m.liHeadersOnly  = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liHeadersOnly = .LogicalToBit(m.tuHeadersOnly)
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		
		      loParkParameterEMailBundle = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMailBundle)
		
		      loChilkatEMailBundle = m.loParkParameterEMailBundle.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.FetchUidlAsync(m.loChilkatStringTable, ;
		        m.liHeadersOnly, m.tiNumBodyLines, m.loChilkatEMailBundle)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = m.loParkParameterStringTable.SetObject(;
		      m.toChilkatStringTable, m.loChilkatStringTable)
		
		      toChilkatEMailBundle = m.loParkParameterEMailBundle.SetObject(;
		      m.toChilkatEMailBundle, m.loChilkatEMailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatStringTable  = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  toChilkatEMailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterEMailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEMailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loChilkatTask = NEWOBJECT([Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	HIDDEN PROCEDURE filter_access		&& Access method used to retrieve the Chilkat MailMan Filter property.
		*==============================================================================
		* Method:            Filter_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan Filter property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Filter
		* Date Added:        01/07/2022
		*==============================================================================
		
		**
		** An expression that is applied to any of the following method calls when present: 
		** LoadXmlFile, LoadXmlString, LoadMbx, CopyMail, and TransferMail. 
		** For these methods, only the emails that match the filter's expression
		** are returned in the email bundle. In the case of TransferMail, only the 
		** matching emails are removed from the mail server. 
		** The filter allows any header field, or the body, to be checked.
		**
		** Here are some examples of expressions:
		** 
		** Body like "mortgage rates*". 
		** Subject contains "update" and From contains "chilkat" 
		** To = "info@chilkatsoft.com" 
		** 
		** Here are the general rules for forming filter expressions:
		** 
		** Any MIME header field name can be used, case is insensitive. 
		** Literal strings are double-quoted, and case is insensitive. 
		** The "*" wildcard matches 0 or more occurrences of any character. 
		** Parentheses can be used to control precedence. 
		** The logical operators are: AND, OR, NOT (case insensitive) 
		** Comparison operators are: =, <, >, <=, >=, <> 
		** String comparison operators are: CONTAINS, LIKE (case insensitive)
		**
		**
		** The MailMan.Filter POP3 property
		**
		** This property often causes confusion. When set, perhaps to a string such as 
		** "subject contains \"Hello\"", you would expect that only messages containing 
		** "Hello" in the subject are downloaded. However, the POP3 protocol does not provide 
		** functionality to download messages based on criteria. 
		** POP3 is a very simple protocol that allows for downloading email 
		** by message number, and nothing else. Therefore, calling a method such as 
		** MailMan.CopyMail will still download all emails. 
		** The Filter property however, controls which emails are included in the 
		** EmailBundle returned by CopyMail. Non-matching emails are discarded.
		**
		** That seems dumb — why include a Filter property at all?
		**
		** Let’s say you have a mailbox containing a large number of emails. 
		** You might call GetAllHeaders, with the Filter property set. 
		** The headers for all email in the mailbox are downloaded, but only those matching the 
		** Filter are included in the EmailBundle. The advantage is that with GetAllHeaders, 
		** far less data is downloaded (only the headers), and with the Filter property, 
		** there is less processing (fewer emails objects need to be constructed and added to the bundle).
		**
		** Once you have the EmailBundle, you can get the set of UIDLs by calling EmailBundle.GetUidls. 
		** This can then be passed to MailMan.FetchMultiple to download the full emails 
		** for the specific set of UIDLs.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE filter_assign		&& Assign method used to hold a reference to the Filter property.
		*==============================================================================
		* Method:            Filter_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MailMan Filter property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Filter property.
		* Returns:           
		* Date Added:        01/07/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE getallheaders		&& Returns all the emails from the POP3 server, but only the first numBodyLines lines of the body. Attachments are not returned.
		*==============================================================================
		* Method:            GetAllHeaders
		* Purpose:           Returns all the emails from the POP3 server, 
		*                    but only the first numBodyLines lines of the body.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiBodyLines -- the number of email body lines to return.
		* Returns:           Chilkat Email Bundle Object, or NULL
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** Returns all the emails from the POP3 server, but only the first numBodyLines lines of the body. 
		** Attachments are not returned. The emails returned in the bundle are valid email objects, 
		** the only difference is that the body is truncated to include only the top numBodyLines lines, 
		** and the attachments will be missing.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiBodyLines AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmailBundle
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatEmailBundle = m.loChilkatObject.GetAllHeaders(m.tiBodyLines)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmailBundle
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

