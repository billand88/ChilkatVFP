	PROCEDURE algorithm_compression		&& Method run to validate the data for the Compression Algorithm property.
		*==============================================================================
		* Method:            Algorithm
		* Purpose:           Method run to validate the data for the EdDSA Algorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER ;
		AND (NOT EMPTY(m.lcValue)) ;
		AND INLIST(UPPER(ALLTRIM(m.lcValue)), [PPMD], [DEFLATE], [ZLIB], [BZIP2], [LZW]))
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE algorithm_eddsa		&& Method run to validate the data for the EdDSA Algorithm property.
		*==============================================================================
		* Method:            Algorithm
		* Purpose:           Method run to validate the data for the EdDSA Algorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        07/21/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER ;
		AND (NOT EMPTY(m.lcValue)) ;
		AND INLIST(UPPER(ALLTRIM(m.lcValue)), [ED25519], [ED25519PH], [ED25519CTX]))
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE apispec
		*==============================================================================
		* Method:            APISpec
		* Purpose:           Method run to validate the data for the AI APISpec property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        11/03/2025
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer, ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[4, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have words to validate test (should be true)
		  IF m.liWords > 0
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = STRTRAN(m.lcValue, [ ])
		
		          la_Values[1, 1] = [CHATCOMPLETIONS]
		          la_Values[1, 2] = .GenerateVersionNumber(11, 3, 0)
		          la_Values[2, 1] = [RESPONSES]
		          la_Values[2, 2] = .GenerateVersionNumber(11, 3, 0)
		          la_Values[3, 1] = [GEMINI]
		          la_Values[3, 2] = .GenerateVersionNumber(11, 3, 0)
		          la_Values[4, 1] = [ANTHROPIC]
		          la_Values[4, 2] = .GenerateVersionNumber(11, 3, 0)
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End walk through words loop
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords > 0
		  ** End have words to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ask		&& Method run to validate the data for the AI Ask property.
		*==============================================================================
		* Method:            Ask
		* Purpose:           Method run to validate the data for the AI Ask property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        11/03/2025
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer, ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[1, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have words to validate test (should be true)
		  IF m.liWords > 0
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = STRTRAN(m.lcValue, [ ])
		
		          la_Values[1, 1] = [TEXT]
		          la_Values[1, 2] = .GenerateVersionNumber(11, 2, 0)
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End walk through words loop
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords > 0
		  ** End have words to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE authmethod		&& Method run to validate the data for the AuthMethod property.
		*==============================================================================
		* Method:            AuthMethod
		* Purpose:           Method run to validate the data for 
		*                    the IMAP AuthMethod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer, ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[5, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have a word to validate test (should be true)
		  IF m.liWords = 1
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = UPPER(STRTRAN(m.lcValue, [ ]))
		
		          la_Values[1, 1] = [XOAUTH2]
		          la_Values[1, 2] = .GenerateVersionNumber(9, 5, 44)
		          la_Values[2, 1] = [CRAM-MD5]
		          la_Values[2, 2] = 0
		          la_Values[3, 1] = [NTLM]
		          la_Values[3, 2] = 0
		          la_Values[4, 1] = [PLAIN]
		          la_Values[4, 2] = 0
		          la_Values[5, 1] = [LOGIN]
		          la_Values[5, 2] = 0
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End have words to validate test (should be true)
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords = 1
		  ** End have a word to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE awssignatureversion		&& Method run to validate the data for the AWSSignatureVersion property.
		*==============================================================================
		* Method:            AWSSignatureVersion
		* Purpose:           Method run to validate the data for the AWSSignatureVersion property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/17/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		liValue AS Integer, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		liValue = m.tiValue
		
		llValidated = (VARTYPE(m.liValue) == T_INTEGER) ;
		AND INLIST(m.liValue, 2, 4)
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE awssubresources		&& Method run to validate the data for the AWSSubResources property.
		*==============================================================================
		* Method:            AWSSubResources
		* Purpose:           Method run to validate the data for the AWSSubResources property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/17/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer ;
		liWords AS Integer, li AS Integer, lcWord AS Character
		
		LOCAL ARRAY la_Values[14]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [&])
		
		  ** Have words to validate test (should be true)
		  IF m.liWords = 1
		
		    ** Get rid of the spaces in the words...
		    lcValue = UPPER(STRTRAN(m.lcValue, [ ]))
		
		    la_Values[1] = [ACL]
		    la_Values[2] = [LOCATION]
		    la_Values[3] = [LOGGING]
		    la_Values[4] = [NOTIFICATION]
		    la_Values[5] = [PARTNUMBER]
		    la_Values[6] = [POLICY]
		    la_Values[7] = [REQUESTPAYMENT]
		    la_Values[8] = [TORRENT]
		    la_Values[9] = [UPLOADID]
		    la_Values[10] = [UPLOADS]
		    la_Values[11] = [VERSIONID]
		    la_Values[12] = [VERSIONING]
		    la_Values[13] = [VERSIONS]
		    la_Values[14] = [WEBSITE]
		
		    ** Assume it's validated...
		    ** If we have an issue just kick it back to .F.
		    llValidated = .T. 
		
		    ** Walk through words loop
		    FOR li = 1 TO m.liWords
		
		      lcWord = GETWORDNUM(m.lcValue, m.li, [&])
		
		      ** Keyword/value pair test
		      IF [=] $ m.lcWord
		
		        ** Just validate the keyword and ignore the value...
		        lcWord = LEFTC(m.lcWord, ATCC([=], m.lcWord) - 1)
		
		      ENDIF [=] $ m.lcWord
		      ** Keyword/value pair test
		
		      liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		      ** No word match test
		      IF m.liMatch = 0
		
		        llValidated = .F.
		        EXIT
		
		      ENDIF m.liMatch = 0
		      ** End word match test
		
		    ENDFOR m.li = 1 TO m.liWords
		    ** End walk through words loop
		
		  ENDIF m.liWords = 1
		  ** End have words to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE bcryptworkfactor		&& Method run to validate the data for the BCryptWorkFactor property.
		*==============================================================================
		* Method:            BCryptWorkFactor
		* Purpose:           Method run to validate the data for the BCryptWorkFactor property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		liValue AS Integer, llValidated AS Logical
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		liValue = m.tiValue
		
		llValidated = (VARTYPE(m.liValue) == T_INTEGER) ;
		AND BETWEEN(m.liValue, 4, 31)
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
		
	ENDPROC

	PROCEDURE behaviors		&& Method run to validate the data for the Behaviors property.
		*==============================================================================
		* Method:            Behaviors
		* Purpose:           Method run to validate the data for 
		*                    the XMLDSigGen Behaviors property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/18/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[22, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have words to validate test (should be true)
		  IF m.liWords > 0
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = UPPER(STRTRAN(m.lcValue, [ ]))
		
		          la_Values[1, 1] = [ATTRIBUTESORTINGBUG]
		          la_Values[1, 2] = .GenerateVersionNumber(9, 5, 79)
		          la_Values[2, 1] = [FORCEADDENVELOPEDSIGNATURETRANSFORM]
		          la_Values[2, 2] = .GenerateVersionNumber(9, 5, 70)
		          la_Values[3, 1] = [NOENVELOPEDSIGNATURETRANSFORM]
		          la_Values[3, 2] = .GenerateVersionNumber(9, 5, 82)
		          la_Values[4, 1] = [ENVELOPEDTRANSFORMFIRST]
		          la_Values[4, 2] = .GenerateVersionNumber(9, 5, 87)
		          la_Values[5, 1] = [EBXMLTRANSFORM]
		          la_Values[5, 2] = .GenerateVersionNumber(9, 5, 73)
		          la_Values[6, 1] = [TRANSFORMSIGNAGUREXPATH]
		          la_Values[6, 2] = .GenerateVersionNumber(9, 5, 75)
		          la_Values[7, 1] = [COMPACTSIGNEDXML]
		          la_Values[7, 2] = .GenerateVersionNumber(9, 5, 73)
		          la_Values[8, 1] = [INDENTEDSIGNATURE]
		          la_Values[8, 2] = .GenerateVersionNumber(9, 5, 73)
		          la_Values[9, 1] = [FULLLOCALSIGNINGTIME]
		          la_Values[9, 2] = .GenerateVersionNumber(9, 5, 76)
		          la_Values[10, 1] = [DNREVERSEORDER]
		          la_Values[10, 2] = .GenerateVersionNumber(9, 5, 77)
		          la_Values[11, 1] = [ISSUERSERIALHEX]
		          la_Values[11, 2] = .GenerateVersionNumber(9, 5, 77)
		          la_Values[12, 1] = [ISSUERSERIALHEXLOWER]
		          la_Values[12, 2] = .GenerateVersionNumber(9, 5, 77)
		          la_Values[13, 1] = [SIGNINGTIMEADJUST-]
		          la_Values[13, 2] = .GenerateVersionNumber(9, 5, 80)
		          la_Values[14, 1] = [SIGNINGTIMEADJUST+]
		          la_Values[14, 2] = .GenerateVersionNumber(9, 5, 88)
		          la_Values[15, 1] = [UBLDOCUMENTSIGNATURES]
		          la_Values[15, 2] = .GenerateVersionNumber(9, 5, 70)
		          la_Values[16, 1] = [SIGNEXISTINGSIGNATURES]
		          la_Values[16, 2] = .GenerateVersionNumber(9, 5, 70)
		          la_Values[17, 1] = [NOTIMESTAMPBIAS]
		          la_Values[17, 2] = .GenerateVersionNumber(9, 5, 96)
		          la_Values[18, 1] = [BASE64CRENTITY]
		          la_Values[18, 2] = .GenerateVersionNumber(9, 5, 70)
		          la_Values[19, 1] = [BASE64CR13ENTITY]
		          la_Values[19, 2] = .GenerateVersionNumber(9, 5, 70)
		          la_Values[20, 1] = [BASE64MULTILINE]
		          la_Values[20, 2] = .GenerateVersionNumber(9, 5, 70)
		          la_Values[21, 1] = [LOCALSIGNINGTIME]
		          la_Values[21, 2] = .GenerateVersionNumber(9, 5, 76)
		          la_Values[22, 1] = [NOREPLACESIGNINGTIME]
		          la_Values[22, 2] = .GenerateVersionNumber(9, 5, 70)
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End walk through words loop
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords > 0
		  ** End have words to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
		
	ENDPROC

