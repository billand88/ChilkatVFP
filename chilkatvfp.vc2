	PROCEDURE getreceivedtexts		&& The same as GetReceivedText, except only the text up to and including substr is returned. The text returned is removed from the internal receive buffer.
		*==============================================================================
		* Method:            GetReceivedTextS
		* Purpose:           The same as GetReceivedText, 
		*                    except only the text up to and including substr is returned.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		*                    tcCharset, the character set 
		*                    of the data through the channel.
		* Returns:           The received text substring.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** The same as GetReceivedText, except only the text up to and including substr is returned. 
		** The text returned is removed from the internal receive buffer. 
		** If the substr was not found in the internal receive buffer, 
		** an empty string is returned and the internal receive buffer is not modified.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiChannel AS Integer, tcSubstring AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, ;
		loException AS Exception, lcReceivedTextSubString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcReceivedTextSubString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcReceivedTextSubString = ;
		      m.loChilkatObject.GetReceivedTextS(m.tiChannel, m.tcSubstring, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReceivedTextSubString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat SSH HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** This is the number of milliseconds between each AbortCheck event callback. 
		** The AbortCheck callback allows an application 
		** to abort any SSH operation prior to completion. 
		** If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the SSH HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold a reference to the HeartbeatMs property.
