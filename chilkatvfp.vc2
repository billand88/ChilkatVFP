		sslprotocol = 
		tlspinset = 
		totaluploadsize = 0
		uploadinprogress = 0
		uploadsuccess = 0
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat Upload AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Upload AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        06/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE abortupload		&& May be called during an asynchronous upload to abort.
		*==============================================================================
		* Method:            AbortUpload
		* Purpose:           May be called during an asynchronous upload to abort.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** May be called during an asynchronous upload to abort.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_UPLOAD_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AbortUpload()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UPLOAD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE addcustomheader		&& Adds a custom HTTP header to the HTTP upload.
		*==============================================================================
		* Method:            AddCustomHeader
		* Purpose:           Adds a custom HTTP header to the HTTP upload.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeaderName -- the header name to add
		*                    tcHeaderValue -- the header value to add
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		**
		** Adds a custom HTTP header to the HTTP upload.
		** 
		
		LPARAMETERS tcHeaderName AS Character, tcHeaderValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_UPLOAD_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddCustomHeader(m.tcHeaderName, m.tcHeaderValue)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UPLOAD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE addfilereference		&& Adds a file to the list of files to be uploaded in the next call to BlockingUpload, BeginUpload, or UploadToMemory. To upload more than one file, call this method once for each file to be uploaded.
		*==============================================================================
		* Method:            AddFileReference
		* Purpose:           Adds a file to the list of files to be uploaded in the next call 
		*                    to BlockingUpload, BeginUpload, or UploadToMemory.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName -- the descriptive name of the file.
		*                    tcFileName -- the file name to upload.
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		**
		** Adds a file to the list of files to be uploaded in the next call 
		** to BlockingUpload, BeginUpload, or UploadToMemory. 
		** To upload more than one file, call this method once for each file to be uploaded.
		** 
		
		LPARAMETERS tcName AS Character, tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_UPLOAD_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddFileReference(m.tcName, m.tcFileName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UPLOAD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
		
		
		
		
		
		
	ENDPROC

