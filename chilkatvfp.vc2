	PROCEDURE initializesftp		&& Intializes the SFTP subsystem. This should be called after connecting and authenticating.
		*==============================================================================
		* Method:            InitializeSFTP
		* Purpose:           Intializes the SFTP subsystem.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Intializes the SFTP subsystem. This should be called after connecting and authenticating. 
		** An SFTP session always begins by first calling Connect to connect to the SSH server, 
		** then calling either AuthenticatePw or AuthenticatePk to login, 
		** and finally calling InitializeSftp.
		**
		** Important: When reporting problems, please send the full contents 
		** of the LastErrorText property to support@chilkatsoft.com.
		**
		** If this method fails, the reason may be present in the InitializeFailCode 
		** and InitializeFailReason properties (assuming the failure occurred 
		** when trying to open the SFTP session channel).
		**
		** Fix for version 77: Fixed a problem in this method for some servers. 
		** The method would timeout and fail. It was caused when a server sent unanticipated 
		** “extended data”, which was incorrectly processed as a response to a different message.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.InitializeSFTP() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE initializesftpasync		&& Creates an asynchronous task to call the InitializeSftp method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            InitializeSFTPAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    InitializeSFTP method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/20/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the InitializeSFTP method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Fix for version 77: Fixed a problem in this method for some servers. 
		** The method would timeout and fail. It was caused when a server sent unanticipated 
		** “extended data”, which was incorrectly processed as a response to a different message.
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.InitializeSFTPAsync()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE isconnected_access		&& Access method used to retrieve the Chilkat SFTP IsConnected property.
		*==============================================================================
		* Method:            IsConnected_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP IsConnected property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IsConnected
		* Date Added:        04/19/2022
		*==============================================================================
		
		** Returns 1 if connected to the SSH server. 
		** Note: This does not mean authentication has happened or InitializeSftp has already succeeded. 
		** It only means that the connection has been established by calling Connect.
		**
		** Understanding the IsConnected property: The IsConnected property is the last known state 
		** of the TCP connection (either connected or disconnected). 
		** This requires some explanation because most developer 
		** have incorrect assumptions about TCP connections.
		**
		** If a TCP connection is established, and neither side is reading or writing the socket 
		** (i.e. both sides are doing nothing), then you can disconnect the network cable 
		** from the computer for any length of time, and then re-connect, 
		** and the TCP connection is not affected.
		**
		** A TCP connection only becomes disconnected when an attempt is made to read/write 
		** while a network problem exists. If no attempts to read/write occur, 
		** a network problem may arise and then become resolved without affecting the TCP connection.
		**
		** If the peer chooses to close its side of the TCP connection, 
		** your application won't magically know about it until you try to do something 
		** with the TCP socket (such as read or write).
		**
		** A Chilkat API property (as opposed to a method) CANNOT and should not do something 
		** that would cause an application to timeout, hang, etc. 
		** Therefore, it is not appropriate for the IsConnected property to attempt 
		** any kind of socket operation (read/write/peek) on the socket. 
		** It simply returns the last known state of the connection. 
		** It may very well be that your network cable is unplugged and IsConnected returns 1 
		** because technically, if neither peer is trying to read/write, 
		** the network cable could be plugged back in without affecting the connection. 
		** IsConnected could also return 1 if the peer has already closed its side of the connection, 
		** because the state of the connection is only updated after trying to read/write/peek.
		**
		** To truly know the current connected state (as opposed to the last known connection state), 
		** your application should attempt a network operation that is appropriate to the protocol. 
		** For SFTP, an application could call SendIgnore, and then check IsConnected.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

