	HIDDEN PROCEDURE numparts_access		&& Access method used to retrieve the Chilkat MIME NumParts property.
		*==============================================================================
		* Method:            NumParts_Access
		* Purpose:           Access method used to retrieve 
		*                    the NumParts property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumParts
		* Date Added:        06/25/2022
		*==============================================================================
		
		** 
		** MIME messages are composed of parts in a tree structure. 
		** The NumParts property contains the number of direct children. 
		** To traverse an entire MIME tree, one would recursively descend 
		** the tree structure by iterating from 0 to NumParts-1, 
		** calling GetPart to get each direct child MIME object. 
		** The traversal would continue by iterating over each child's parts, and so on.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE numparts_assign		&& Assign method used to hold a reference to the NumParts property.
