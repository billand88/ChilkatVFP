	PROCEDURE skippedforunzip		&& This event fires during method calls that unzip a zip archive. It is called for each file that was skipped for some reason (such as for when UnzipNewer or UnzipMatching is called).
		*==============================================================================
		* Method:            SkippedForUnzip
		* Purpose:           This event fires during method calls that unzip a zip archive.
		*                    It is called for each file that was skipped for some reason.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file to be unzipped.
		*                    tiCompressedFileSize, the size of the compressed file to be unzipped. 
		*                    tiFileSize, the size of the file to be unzipped.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** This event fires during method calls that unzip a zip archive. 
		** It is called for each file that was skipped for some reason 
		** (such as for when UnzipNewer or UnzipMatching is called).
		**
		
		LPARAMETERS tcPath AS Character, ;
		tiCompressedFileSize AS Integer, tiFileSize AS Integer
		
		LOCAL lcPath AS Character, llReturn AS Logical, ;
		liCompressedFileSize AS Integer, liFileSize AS Integer
		
		lcPath = m.tcPath
		liCompressedFileSize = m.tiCompressedFileSize 
		liFileSize = m.tiFileSize
		
		*!*  
		*!*  ? [SkippedForUnzip Event!] 
		*!*  ? [SkippedForUnzip: File Path = ] + lcPath
		*!*  ? [File Compressed Size = ] + STR(liCompressedFileSize)
		*!*  ? [File Size = ] + STR(liFileSize)
		*!*  
		
		WITH THIS
		
		  llReturn = .SkippedForUnzip_Pre(m.lcPath, m.liCompressedFileSize, m.liFileSize)
		
		  ** OK to continue test
		  IF m.llReturn 
		
		    llReturn = .SkippedForUnzip_Process(m.lcPath, m.liCompressedFileSize, m.liFileSize)
		
		    ** OK to continue test
		    IF m.llReturn 
		
		      llReturn = .SkippedForUnzip_Post(m.lcPath, m.liCompressedFileSize, m.liFileSize)
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiCompressedFileSize = m.liCompressedFileSize
		tiFileSize = m.liFileSize
		
		RETURN
	ENDPROC

	PROCEDURE skippedforunzip_post		&& Template SkippedForUnzip post-processing method.
		*==============================================================================
		* Method:            SkippedForUnzip_Post
