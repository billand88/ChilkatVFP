		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getspkifingerprint		&& Introduced in version 9.5.0.55. Returns the SPKI Fingerprint suitable for use in pinning. (See RFC 7469.)
		*==============================================================================
		* Method:            GetSPKIFingerprint
		* Purpose:           Returns the SPKI Fingerprint suitable for use in pinning. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHashAlgorithm, the hash algorithm.
		*                    tcEncoding, the encoding of the algorithm.
		* Returns:           The certificate extension data
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** Returns the SPKI Fingerprint suitable for use in pinning. (See RFC 7469.) 
		** An SPKI Fingerprint is defined as the output of a known cryptographic 
		** hash algorithm whose input is the DER-encoded ASN.1 representation 
		** of the Subject Public Key Info (SPKI) of an X.509 certificate. 
		** The hashAlg specifies the hash algorithm and may be "sha256", 
		** "sha384", "sha512", "sha1", "md2", "md5", "haval", "ripemd128", 
		** "ripemd160","ripemd256", or "ripemd320". The encoding specifies the encoding, 
		** and may be "base64", "hex", or any of the encoding modes specified 
		** in the article at the link below.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement to Version 95: Added support for SHA224 
		** in all places where a hash algorithm might be specified.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcHashAlgorithm AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, lcSPKIFingerprint AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcSPKIFingerprint = []
		llImplemented = .F.
		liIntroducedInBuild = 55
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcSPKIFingerprint = ;
		        m.loChilkatObject.GetSPKIFingerprint(m.tcHashAlgorithm, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcSPKIFingerprint
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

