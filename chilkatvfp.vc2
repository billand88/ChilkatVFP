	PROCEDURE walmartsignature		&& Introduced in version 9.5.0.67. Generates a Walmart authentication signature for Walmart REST API calls. Returns a JSON string that contains both the WM_SEC_AUTH_SIGNATURE and WM_SEC.TIMESTAMP. Returns Nothing on failure.
		*==============================================================================
		* Method:            WalmartSignature
		* Purpose:           Generates a Walmart authentication signature for Walmart REST API calls.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRequestURL -- the Request URL.
		*                    tcConsumerID -- the consumer ID.
		*                    tcPrivateKey -- the private key.
		*                    tcRequestMethod -- the request method to call.
		* Returns:           The JSON string.
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** Generates a Walmart authentication signature for Walmart REST API calls. 
		** Returns a JSON string that contains both the WM_SEC_AUTH_SIGNATURE and WM_SEC.TIMESTAMP.
		**
		** Fixed for version 75: Fixed this method for POST/PUT operations.
		** 
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tcRequestURL AS Character, tcConsumerID AS Character. ;
		tcPrivateKey AS Character, tcRequestMethod AS Character
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.AuthUtil], ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcJSONString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcJSONString = []
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcJSONString = m.loChilkatObject.WalmartSignature(;
		        m.tcRequestURL, m.tcConsumerID, tcPrivateKey, m.tcRequestMethod)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcJSONString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.AuthUtil])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS base AS custom 		&& Base custom object.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: displayerrormessage		&& Method run to display the error message.
		*m: processerrormessage		&& Method run to process an error message.
		*m: release		&& Method run to cleanly release an object.
		*p: cversion		&& Property used to hold the version number of the project. Unused at this time.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cversion = 1.57
		Name = "base"
	*</PropValue>
	
	PROCEDURE displayerrormessage		&& Method run to display the error message.
		*==============================================================================
		* Method:            DisplayErrorMessage
		* Purpose:           Method run to display the error message.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcErrorMessage -- the error message to display
		* Returns:           
		* Date Added:        02/07/2022
		*==============================================================================
		
		LPARAMETERS tcErrorMessage AS Character
		
		LOCAL lcErrorMessage AS Character
		
		lcErrorMessage = m.tcErrorMessage
		
		** Good variable type test
		IF VARTYPE(m.lcErrorMessage) = T_CHARACTER
		
		  DEBUGOUT m.lcErrorMessage
		  ERROR m.lcErrorMessage
		
		ENDIF VARTYPE(m.lcErrorMessage) = T_CHARACTER
		** End variable processing test
		
		RETURN
	ENDPROC

	PROCEDURE processerrormessage		&& Method run to process an error message.
		*==============================================================================
		* Method:            ProcessErrorMessage
		* Purpose:           Method run to process an error message.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcErrorMessage -- the error message.
		*                    toSubClass -- the Visual Foxpro Chilkat object.
		* Returns:           
		* Date Added:        02/07/2022
		*==============================================================================
		
		LPARAMETERS tcErrorMessage AS Character, toSubClass AS Custom
		
		LOCAL lcErrorMessage AS Character, loSubClass AS Custom
		
		lcErrorMessage = m.tcErrorMessage
		loSubClass = m.toSubClass
		
		** This method is written to be overridden. The subclassed object
		** is unused in this method but available if need be. 02/07/2022 WAA
		
		** Have a good error message test
		IF VARTYPE(m.lcErrorMessage) == T_CHARACTER ;
		AND (NOT EMPTY(m.lcErrorMessage))
		
		  THIS.DisplayErrorMessage(m.lcErrorMessage)
		
		ENDIF VARTYPE(m.lcErrorMessage) == T_CHARACTER ;
		AND (NOT EMPTY(m.lcErrorMessage))
		** End have a good error message test
		
		loSubClass = NULL
		
		RETURN
	ENDPROC

	PROCEDURE release		&& Method run to cleanly release an object.
		*==============================================================================
		* Method:            Release
		* Purpose:           Method run to cleanly release an object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/04/2022
		*==============================================================================
		
		** Parent object exists test
		IF TYPE([THIS.Parent.Name]) == T_CHARACTER
		
		  THIS.Parent.RemoveObject(THIS.Name)
		
		ELSE
		
		  RELEASE THIS
		
		ENDIF TYPE([THIS.Parent.Name]) == T_CHARACTER
		** End parent object exists test
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS basechilkat AS ibase OF "chilkatvfp.vcx" 		&& Template ChilkatVFP class with properties/methods that span all Chilkat objects.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: bittological		&& Method run to covert a bit value to logical.
		*m: callaccessobject		&& Method run from property access methods to run generic property type methods from the Process_Access object.
		*m: callassignobject		&& Method run from property assign methods to run generic property type methods from the Process_Assign object.
		*m: calltochilkaterror		&& Method run when the call to Chilkat's method fails for some reason.
		*m: cchilkatclass_assign		&& Assign method used to retrieve the cChilkatClass property.
		*m: ceventhandlerclass_assign		&& Assign method used to determine that the event handler class is returned as a character value.
		*m: chilkatchangelog		&& Documentation method used to hold the Chilkat class changes per release version.
		*m: getchilkatobject		&& Method run to retrieve or create the Chilkat object.
		*m: getimpladdrstr_access		&& Access method used to retrieve the GetImplAddrStr property.
		*m: getimpladdrstr_assign		&& Assign method used to hold the GetImplAddrStr property of the referenced Chilkat object.
		*m: icalculatedbuildnumber_access		&& Access method used to retrieve the iCalculatedBuildNumber property.
		*m: iinstancemajor_assign		&& Assign method used to hold the iInstanceMajor property.
		*m: iinstanceminor_assign		&& Assign method used to hold the iInstanceMinor property.
		*m: iinstancepatch_assign		&& Assign method used to hold the iInstancePatch property.
		*m: initializemsgsvc		&& Method run to initialize MsgSvc.
		*m: init_post		&& Method used to run a post-initialization process.
		*m: iretirementmajor_assign		&& Assign method used to retrieve the IRetirementMajor property.
		*m: iretirementminor_assign		&& Assign method used to retrieve the iRetirementMinor property.
		*m: iretirementpatch_assign		&& Assign method used to retrieve the iRetirementPatch property.
		*m: isimplemented		&& Method used to determine if the class being referenced has been implemented in the current version of the object.
		*m: ispemimplemented		&& Method used to determine if the method or property being referenced has been implemented in the current version of the object.
		*m: ispemremoved		&& Method used to determine if a PEM has been removed from the running version of the object.
		*m: isretired		&& Method used to determine if the object has been retired (decremented).
		*m: laddeventhandler_assign		&& Assign method used to determine that an event handler will be bound to the Chilkat object.
		*m: logicaltobit		&& Method run to covert a logical value to bit.
		*m: lreturnbitaslogical_assign		&& Assign method used to determine that bit values are returned as a Visual Foxpro logical value.
		*m: lsupportssemanticversioning_access		&& Access method used to retrieve the lSupportsSemanticVersioning property, generated from the Version number of the Chilkat object.
		*m: lsupportssemanticversioning_assign		&& Assign method used to hold the lSupportsSemanticVersioning property, generated from the Version number of the Chilkat object.
		*m: missingobjecterror		&& Error method run for when there is a missing Chilkat object when running a method.
		*m: oeventhandler_assign		&& Assign method used to hold a reference to the event handler object.
		*m: omsgsvc_access		&& Access method used to retrieve a reference to the MsgSvc object.
		*m: omsgsvc_assign		&& Assign method used to hold a reference to the MsgSvc object.
		*m: oversioning_access		&& Access method used to retrieve a reference to the Chilkat Versioning object.
		*m: oversioning_assign		&& Assign method used to hold a reference to the Versioning object.
		*m: version_access		&& Access method used to retrieve the Version property of the referenced Chilkat object.
		*m: version_assign		&& Assign method used to hold the Version property of the referenced Chilkat object.
		*p: cchilkatclass		&& The Chilkat class name.
		*p: cchilkatobjectprefix		&& The Chilkat prefix as part of the Chilkat object name to instantiate.
		*p: cchilkatproperty		&& Property used to set the Chilkat property name if it differs from the Visual Foxpro property name.
		*p: ceventhandlerclass		&& The class name of the event handler, if relevant.
		*p: cmsgsvclanguage		&& Property used to hold the name of the language used for MsgSvc dialogs. Currently supports the value of Original (English), French, German, Spanish and Test.
		*p: cscratch		&& Scratch character variable.
		*p: getimpladdrstr		&& Undocumented property! It looks like a memory address to the specific class.
		*p: ibuildmajor		&& Property used to hold the major version of the running Chilkat version for this object.
		*p: ibuildminor		&& Property used to hold the minor version of the running Chilkat version for this object.
		*p: ibuildpatch		&& Property used to hold the patch version of the running Chilkat version for this object.
		*p: icalculatedbuildnumber		&& Method used to generate a build number that can be used for comparisons.
		*p: iinstancemajor		&& Property used to hold the major version number of when the Chilkat object existed.
		*p: iinstanceminor		&& Property used to hold the minor version number of when the Chilkat object existed.
		*p: iinstancepatch		&& Property used to hold the patch version number of when the Chilkat object existed.
		*p: iretirementmajor		&& Property used to hold the major version number of when the Chilkat object is retired, if ever.
		*p: iretirementminor		&& Property used to hold the minor version number of when the Chilkat object is retired, if ever.
		*p: iretirementpatch		&& Property used to hold the patch version number of when the Chilkat object is retired, if ever.
		*p: laddeventhandler		&& Logical property used to determine if the Chilkat object (oChilkat) will add an event handler, if relevant.
		*p: lreturnbitaslogical		&& Property used to determine that bit values are returned as a Visual Foxpro logical value.
		*p: lsupportssemanticversioning		&& Logical property used to determine if the Chilkat object supports semantic versioning.
		*p: ochilkat		&& The reference to the actual Chilkat object.
		*p: oeventhandler		&& Object property used to hold a reference to the Chilkat event handler, if relevant.
		*p: omsgsvc		&& Object property used to hold a references to the MsgSvc object.
		*p: oprocess_access		&& Access method used to retrieve the oProcess property.
		*p: oprocess_assign		&& Assign method used to hold the oProcess property of the referenced Chilkat object.
		*p: oversioning		&& Object property used to handle versioning calculations.
		*p: qscratch		&& Scratch VarBinary variable.
		*p: version		&& Version of the component/library, such as "9.5.0.63"
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = 
		cchilkatobjectprefix = 
		cchilkatproperty = 
		ceventhandlerclass = 
		cmsgsvclanguage = Original
		cscratch = 
		getimpladdrstr = 
		ibuildmajor = 0
		ibuildminor = 0
		ibuildpatch = 0
		icalculatedbuildnumber = 0
		iinstancemajor = 9
		iinstanceminor = 5
		iinstancepatch = 0
		iretirementmajor = 0
		iretirementminor = 0
		iretirementpatch = 0
		laddeventhandler = .F.
		lreturnbitaslogical = .F.
		lsupportssemanticversioning = .F.
		Name = "basechilkat"
		ochilkat = .NULL.
		oeventhandler = .NULL.
		omsgsvc = .NULL.
		oprocess_access = .NULL.
		oprocess_assign = .NULL.
		oversioning = .NULL.
		qscratch = .NULL.
		version = 
	*</PropValue>
	
	PROCEDURE bittological		&& Method run to covert a bit value to logical.
		*==============================================================================
		* Method:            BitToLogical
		* Purpose:           Method run to covert a bit value to logical.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, the value to convert
		* Returns:           
		* Date Added:        02/04/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL luValue AS Unknown, lcClass AS Character, lcErrorMessage AS Character, ;
		lcMethod AS Character, liStackLevel AS Integer, lcPEMType AS Character, ;
		lcSecondParameter AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcClass, m.lcErrorMessage, m.lcMethod, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		luValue = m.tuValue
		
		WITH THIS
		
		  ** Correct type and value test
		  IF VARTYPE(m.luValue) == T_INTEGER ;
		  AND INLIST(m.luValue, 0, 1)
		
		    ** Return logicals test
		    IF .lReturnBitAsLogical
		
		      luValue = (m.luValue = 1)
		
		    ENDIF .lReturnBitAsLogical
		    ** End return logicals test
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		    lcClass = PROPER(LEFTC(m.lcMethod, MAX(AT_C([.], m.lcMethod) - 1, 0)))
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = m.lcClass + [ ] + m.lcPEMType + [~] + m.lcMethod
		
		    ** Incorrect type test
		    IF VARTYPE(m.luValue) # T_INTEGER
		
		      lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		
		    ELSE  && integer, but not a 0 nor a 1
		
		      lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		    ENDIF VARTYPE(m.luValue) # T_INTEGER
		    ** End incorrect type test
		
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF VARTYPE(m.luValue) == T_INTEGER ;
		  AND INLIST(m.luValue, 0, 1)
		  ** End correct type and value test
		
		ENDWITH
		
		RETURN m.luValue
		
	ENDPROC

	PROCEDURE callaccessobject		&& Method run from property access methods to run generic property type methods from the Process_Access object.
		*==============================================================================
		* Method:            CallAccessObject
		* Purpose:           Method run from property access methods to run generic
		*                    property type methods from the Process_Access object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMethodToCall -- the Access method to call
		*                    tuIntroducedInBuild -- Numeric/Array representing
		*                    the build of the access method being called.
		* Returns:           The property being evaluated.
		* Date Added:        04/01/2022
		*==============================================================================
		
		*!*  LPARAMETERS tcMethodToCall AS Character, tiIntroducedInBuild AS Integer
		LPARAMETERS tcMethodToCall AS Character, tuIntroducedInBuild AS Unknown
		
		LOCAL loProcess_Access AS [iProcess_Access OF ChilkatVFP.VCX], liStackLevel AS Integer, ;
		lcCaller AS Character, lcMethodToCall AS Character, lcMethod AS Character, ;
		llMethodOnAccessObjectExists AS Logical, lcSecondParameter AS Character, ;
		lcProperty AS Character, lcPEMType AS Character, llIsImplemented AS Logical, ;
		lcObject AS Character, lcErrorMessage AS Character, luIntroducedInBuild AS Unknown
		
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[3, 1]
		
		STORE [] TO m.lcMethod, m.lcMethodToCall, m.lcSecondParameter, m.lcObject, ;
		m.lcCaller, m.lcPEMType, m.lcErrorMessage, m.lcMethod, m.la_Stack, m.la_Parameters
		STORE .F. TO m.llMethodOnAccessObjectExists, m.llIsImplemented
		
		** Passing an array test
		IF TYPE([tuIntroducedInBuild(1, 1)]) = T_NUMERIC
		
		  ACOPY(m.tuIntroducedInBuild, m.la_Parameters)
		
		ENDIF TYPE([luFirstParameter(1, 1)]) = T_NUMERIC
		** End passing an array test
		
		loProcess_Access = NULL
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcCaller = m.la_Stack(m.liStackLevel - IIF(m.liStackLevel > 1, 1, 0), 3)
		lcObject = PROPER(LEFTC(m.lcCaller, MAX(AT_C([.], m.lcCaller, 1) - 1, 0))) && added
		lcCaller = PROPER(SUBSTRC(m.lcCaller, AT_C([.], m.lcCaller) + 1))
		
		** Came in from an Access method test (should be true)
		IF UPPER(RIGHTC(m.lcCaller, 7)) == [_ACCESS]
		
		  lcCaller = LEFTC(m.lcCaller, LENC(m.lcCaller) - 7)
		
		ENDIF UPPER(RIGHTC(m.lcCaller, 7)) == [_ACCESS]
		** End came in from an Access method test (should be true)
		
		lcPEMType = LOWER(PEMSTATUS(THIS, m.lcCaller, 3))
		
		lcMethodToCall = m.tcMethodToCall
		luIntroducedInBuild = m.tuIntroducedInBuild
		
		WITH THIS
		
		  lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		  loProcess_Access = .oProcess_Access
		
		  ** Have a good object test
		  IF TYPE([loProcess_Access.Name]) == T_CHARACTER
		
		    llMethodOnAccessObjectExists = PEMSTATUS(m.loProcess_Access, [CallChilkat], 5)
		
		    ** Property exists on access object test
		    IF m.llMethodOnAccessObjectExists
		
		      ** Parameter processing branch
		      DO CASE
		
		        ** Passed nothing or zero test
		        CASE PCOUNT() = 1 ;
		        OR (VARTYPE(m.luIntroducedInBuild) = T_NUMERIC AND m.luIntroducedInBuild = 0)
		
		          llIsImplemented = .T.
		
		        ** Have an array test
		        CASE TYPE([la_Parameters(3)]) = T_NUMERIC
		
		          ** Nothing to do, pass it through...
		          llIsImplemented = .IsPEMImplemented(@m.la_Parameters)
		
		        ** Passed a non-zero test (shouldn't occur any more)
		        CASE VARTYPE(m.luIntroducedInBuild) = T_NUMERIC AND m.luIntroducedInBuild # 0
		
		          llIsImplemented = .IsPEMImplemented(@m.luIntroducedInBuild)
		
		      ENDCASE
		      ** End parameter processing branch
		
		      ** Property is implemented test (meaning, it really exists)
		      IF m.llIsImplemented
		
		        m.loProcess_Access.CallChilkat(THIS, m.lcMethodToCall)
		
		      ENDIF m.llIsImplemented
		      ** End property is implemented test (meaning, it really exists)
		
		    ELSE
		
		      lcErrorMessage = ChMsgSvc([Missing object method], m.lcSecondParameter, , THIS)
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF m.llMethodOnAccessObjectExists
		    ** End property exists on access object test
		
		  ELSE
		
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF TYPE([loProcess_Access.Name]) == T_CHARACTER
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO loProcess_Access, luIntroducedInBuild
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[1, 1]
		STORE [] TO m.la_Stack, m.la_Parameters
		
		RETURN EVALUATE([THIS.] + m.lcCaller)
		
		** Design time IntelliSense test
		#IF .F.
		
		  loProcess_Access = NEWOBJECT([iProcess_Access], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE callassignobject		&& Method run from property assign methods to run generic property type methods from the Process_Assign object.
		*==============================================================================
		* Method:            CallAssignObject
		* Purpose:           Method run from property assign methods to run generic
		*                    property type methods from the Process_Assign object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, the value to assign
		*                    tcMethodToCall, the assign method to call
		*                    tcValidationMethod - the validation method (if relevant)
		*                    for the assigned property.
		*                    tuIntroducedInBuild, Numeric/Array representing
		*                    the build of the assign method being called.
		* Returns:           The property being evaluated
		* Date Added:        04/11/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown, tcMethodToCall AS Character, ;
		tcValidationMethod AS Character, tuIntroducedInBuild AS Unknown
		
		LOCAL loProcess_Assign AS [iProcess_Assign OF ChilkatVFP.VCX], liStackLevel AS Integer, ;
		lcMethod AS Character, lcMethodToCall AS Character, lcProperty AS Character, ;
		llMethodOnAssignObjectExists AS Logical, lcSecondParameter AS Character, ;
		luValue AS Unknown, lcPEMType AS Character, lcValidationMethod AS Character, ;
		liIntroducedInBuild AS Integer, llIsImplemented AS Logical, ;
		lcErrorMessage AS Character, luIntroducedInBuild AS Unknown
		
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[3, 1]
		
		STORE [] TO m.lcMethod, m.lcMethodToCall, m.lcSecondParameter, ;
		m.lcProperty, m.lcPEMType, m.lcValidationMethod, ;
		m.lcErrorMessage, m.la_Stack, m.la_Parameters
		STORE .F. TO m.llMethodOnAssignObjectExists, m.llIsImplemented
		
		** "Park" the parameters
		luValue = m.tuValue
		lcMethodToCall = m.tcMethodToCall
		lcValidationMethod = m.tcValidationMethod
		luIntroducedInBuild = m.tuIntroducedInBuild
		
		loProcess_Assign = NULL
		liStackLevel = ASTACKINFO(la_Stack)
		
		** Passing an array test
		IF TYPE([tuIntroducedInBuild(1, 1)]) = T_NUMERIC
		
		  ACOPY(m.tuIntroducedInBuild, m.la_Parameters)
		
		ENDIF TYPE([luFirstParameter(1, 1)]) = T_NUMERIC
		** End passing an array test
		
		lcMethod = m.la_Stack(m.liStackLevel - IIF(m.liStackLevel > 1, 1, 0), 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		WITH THIS
		
		  lcSecondParameter = [loProcess_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		  loProcess_Assign = .oProcess_Assign
		
		  ** Have a good object test
		  IF TYPE([loProcess_Assign.Name]) == T_CHARACTER
		
		    llMethodOnAssignObjectExists = PEMSTATUS(m.loProcess_Assign, [CallChilkat], 5)
		
		    ** Property exists on assign object test
		    IF m.llMethodOnAssignObjectExists
		
		      ** Parameter processing branch
		      DO CASE
		
		        ** Passed nothing or zero test
		        CASE PCOUNT() = 3 ;
		        OR (VARTYPE(m.luIntroducedInBuild) = T_NUMERIC AND m.luIntroducedInBuild = 0) 
		
		          llIsImplemented = .T.
		
		        ** Have an array test
		        CASE TYPE([la_Parameters(3)]) = T_NUMERIC
		
		          ** Nothing to do, pass it through...
		          llIsImplemented = .IsPEMImplemented(@m.la_Parameters)
		
		        ** Passed a non-zero test (shouldn't occur any more)
		        CASE VARTYPE(m.luIntroducedInBuild) = T_NUMERIC AND m.luIntroducedInBuild # 0
		
		          llIsImplemented = .IsPEMImplemented(@m.luIntroducedInBuild)
		
		      ENDCASE
		      ** End parameter processing branch
		
		      ** Property is implemented test (meaning, it really exists)
		      IF m.llIsImplemented
		
		        m.loProcess_Assign.CallChilkat(m.luValue, THIS, m.lcMethodToCall, m.lcValidationMethod)
		
		      ENDIF m.llIsImplemented
		      ** End property is implemented test (meaning, it really exists)
		
		    ELSE
		
		      lcErrorMessage = ChMsgSvc([Missing object method], m.lcSecondParameter, , THIS)
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF m.llMethodOnAssignObjectExists
		    ** End property exists on assign object test
		
		  ELSE
		
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF TYPE([loProcess_Assign.Name]) == T_CHARACTER
		  ** End have a good object test
		
		ENDWITH
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1], la_Parameters[1, 1]
		STORE [] TO m.la_Stack, m.la_Parameters
		
		STORE NULL TO loProcess_Access, luIntroducedInBuild
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
		** Design time IntelliSense test
		#IF .F.
		
		  loProcess_Assign = NEWOBJECT([iProcess_Assign], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE calltochilkaterror		&& Method run when the call to Chilkat's method fails for some reason.
		*==============================================================================
		* Method:            CallToChilkatError
		* Purpose:           Method run when the call to Chilkat's method fails for some reason.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/15/2022
		*==============================================================================
		
		LPARAMETERS toException AS Exception, toVFPChilkat AS Custom
		
		LOCAL loException AS Exception, loVFPChilkat AS Custom, liStackLevel AS Integer, ;
		lcMethod AS Character, lcClass AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		loException = m.toException
		loVFPChilkat = m.toVFPChilkat
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel - 1, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		lcClass = m.loVFPChilkat.Class
		
		MESSAGEBOX(m.loException.Message, 16, [Error in ] + PROPER(m.lcClass) + [ ] + PROPER(m.lcMethod) + [ method!])
		
		STORE NULL TO m.loException, m.loVFPChilkat
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE cchilkatclass_assign		&& Assign method used to retrieve the cChilkatClass property.
		*==============================================================================
		* Method:            cChilkatClass_Assign
		* Purpose:           Assign method used to retrieve the cChilkatClass property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.cChilkatClass
		* Date Added:        08/28/2022
		*==============================================================================
		
		LPARAMETERS tcChilkatClass AS Character
		
		** Ignore any passed value.
		** In other words, the property is in effect read-only.
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE ceventhandlerclass_assign		&& Assign method used to determine that the event handler class is returned as a character value.
		*==============================================================================
		* Method:            cEventHandlerClass_Assign
		* Purpose:           Assign method used to determine that the event handler
		*                    class is returned as a character value.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEventHandlerClass, character value 
		*                    used to hold the reference to the event handler class.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tcEventHandlerClass AS Logical
		
		LOCAL lcEventHandlerClass AS Logical, lcMethod AS Character, liStackLevel AS Integer, ;
		lcErrorMessage AS Character, lcPEMType AS Character, lcSecondParameter AS Character
		
		LOCAL la_Stack[1, 1]
		
		lcEventHandlerClass = m.tcEventHandlerClass
		
		STORE [] TO m.lcMethod, m.lcErrorMessage, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		WITH THIS
		
		  ** Have a good parameter test
		  IF VARTYPE(m.tcEventHandlerClass) == T_CHARACTER
		
		    .cEventHandlerClass = m.lcEventHandlerClass
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = lcProperty + [~] + m.lcPEMType
		
		    lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF VARTYPE(m.tcEventHandlerClass) == T_CHARACTER
		  ** End have a good parameter test
		
		ENDWITH
		
		RETURN
		
	ENDPROC

	PROCEDURE chilkatchangelog		&& Documentation method used to hold the Chilkat class changes per release version.
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		RETURN
	ENDPROC

	PROCEDURE Destroy
		*==============================================================================
		* Method:            Destroy
		* Purpose:           Occurs when an object is released.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		WITH THIS
		
		  ** Have a good object test
		  IF TYPE([.oEventHandler.Name]) == T_CHARACTER
		
		    EVENTHANDLER(.oChilkat, THIS, .T.) && unbind it...
		    .oEventHandler.Release()
		
		  ENDIF TYPE([.oEventHandler.Name]) == T_CHARACTER
		  ** End have a good object test
		
		  ** Have a good object test
		  IF TYPE([.oProcess_Access.Name]) == T_CHARACTER
		
		    ** Have a Release method test
		    IF PEMSTATUS(.oProcess_Access, [Release], 5)
		
		      .oProcess_Access.Release()
		
		    ENDIF PEMSTATUS(.oProcess_Access, [Release], 5)
		    ** End have a Release method test
		
		  ENDIF TYPE([.oProcess_Access.Name]) == T_CHARACTER
		  ** End have a good object test
		
		  ** Have a good object test
		  IF TYPE([.oProcess_Assign.Name]) == T_CHARACTER
		
		    ** Have a Release method test
		    IF PEMSTATUS(.oProcess_Assign, [Release], 5)
		
		      .oProcess_Assign.Release()
		
		    ENDIF PEMSTATUS(.oProcess_Assign, [Release], 5)
		    ** End have a Release method test
		
		  ENDIF TYPE([.oProcess_Assign.Name]) == T_CHARACTER
		  ** End have a good object test
		
		  ** Have a good object test
		  IF TYPE([.oMsgSvc.Name]) == T_CHARACTER
		
		    ** Have a Release method test
		    IF PEMSTATUS(.oMsgSvc, [Release], 5)
		
		      .oMsgSvc.Release()
		
		    ENDIF PEMSTATUS(.oMsgSvc, [Release], 5)
		    ** End have a Release method test
		
		  ENDIF TYPE([.oMsgSvc.Name]) == T_CHARACTER
		  ** End have a good object test
		
		  ** Have a good object test
		  IF TYPE([.oVersioning.Name]) == T_CHARACTER
		
		    ** Have a Release method test
		    IF PEMSTATUS(.oVersioning, [Release], 5)
		
		      .oVersioning.Release()
		
		    ENDIF PEMSTATUS(.oVersioning, [Release], 5)
		    ** End have a Release method test
		
		  ENDIF TYPE([.oVersioning.Name]) == T_CHARACTER
		  ** End have a good object test
		
		  STORE NULL TO .oProcess_Access, .oProcess_Assign, .oVersioning, ;
		  .oEventHandler, .oChilkat, .oMsgSvc, .qScratch, .cScratch
		
		ENDWITH
		
		USE IN SELECT([MsgSvc])
		
		RETURN DODEFAULT()
	ENDPROC

	PROCEDURE getchilkatobject		&& Method run to retrieve or create the Chilkat object.
		*==============================================================================
		* Method:            GetChilkatObject
		* Purpose:           Method run to retrieve or create the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcChilkatClass, the name of the Chilkat class.
		* Returns:           THIS.oChilkat
		* Date Added:        02/02/2022
		*==============================================================================
		
		LPARAMETERS tcChilkatClass AS Character
		
		LOCAL loChilkat AS Object, lcErrorMessage AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcPEMType AS Character, lcSecondParameter AS Character, ;
		lcChilkatClass AS Character, lcChilkatObject AS Character, lcSetClassLib AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcChilkatClass, m.lcSetClassLib, ;
		m.lcProperty, m.lcPEMType, m.lcChilkatObject, m.lcSecondParameter, m.la_Stack
		
		liStackLevel = 0
		loChilkat = NULL
		
		** "Park" the parameter.
		lcChilkatClass = m.tcChilkatClass
		
		WITH THIS
		
		  loChilkat = .oChilkat
		
		  ** Object doesn't exist test
		  IF ISNULL(m.loChilkat)
		
		    ASTACKINFO(la_Stack)
		
		    ** Not in Destroy method test
		    IF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		
		      lcChilkatObject = THIS.cChilkatObjectPrefix + [.] + m.lcChilkatClass 
		
		      loChilkat = CREATEOBJECT(m.lcChilkatObject)
		
		      ** Problems with instantiation test
		      IF TYPE([loChilkat.Version]) # T_CHARACTER ;
		      AND (NOT INLIST(UPPER(m.lcChilkatClass), ;
		      [BINDATA], [CKSTRING], [SFTPDIR], [SFTPFILE], [STRINGBUILDER], [HASHTABLE], ;
		      [SECURESTRING], [SERVERSENTEVENT], [MAILBOXES], [MESSAGESET], [URL]))
		
		        liStackLevel = ASTACKINFO(la_Stack)
		        lcMethod = m.la_Stack(m.liStackLevel, 3)
		        lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		        ** Came in from an Access or Assign method test
		        IF INLIST(UPPER(RIGHTC(m.lcMethod, 7)), [_ACCESS], [_ASSIGN])
		
		          lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		        ELSE
		
		          lcProperty = []
		
		        ENDIF INLIST(UPPER(RIGHTC(m.lcMethod, 7)), [_ACCESS], [_ASSIGN])
		        ** End came in from an Access or Assign method test
		
		        lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		        lcSecondParameter = m.lcProperty + [~] + m.lcMethod + [~] + m.lcPEMType
		
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF TYPE([loChilkat.Version]) # T_CHARACTER ;
		      AND (NOT INLIST(UPPER(m.lcChilkatClass), ;
		      [BINDATA], [CKSTRING], [SFTPDIR], [SFTPFILE], [STRINGBUILDER], [HASHTABLE], ;
		      [SECURESTRING], [SERVERSENTEVENT], [MAILBOXES], [MESSAGESET], [URL]))
		      ** End problems with instantiation test
		
		    ENDIF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		    ** End not in Destroy method test
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.loChilkat)
		  ** End object doesn't exist or version property doesn't exist (except CkString) test
		
		  .oChilkat = m.loChilkat
		
		ENDWITH
		
		loChilkat = NULL
		
		RETURN THIS.oChilkat
		
	ENDPROC

	HIDDEN PROCEDURE getimpladdrstr_access		&& Access method used to retrieve the GetImplAddrStr property.
		*==============================================================================
		* Method:            GetImplAddrStr_Access
		* Purpose:           Access method used to retrieve 
		*                    the GetImplAddrStr property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Undocumented property! It looks like a memory address to the specific class.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE getimpladdrstr_assign		&& Assign method used to hold the GetImplAddrStr property of the referenced Chilkat object.
		*==============================================================================
		* Method:            GetImplAddrStr_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat GetImplAddrStr property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the GetImplAddrStr property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE icalculatedbuildnumber_access		&& Access method used to retrieve the iCalculatedBuildNumber property.
		*==============================================================================
		* Method:            iCalculatedBuildNumber_Access
		* Purpose:           Access method used to retrieve the iCalculatedBuildNumber property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The calculated Chilkat build number, or 0.
		* Date Added:        12/06/2024
		* Notes:             
		*==============================================================================
		
		LOCAL loVersioning AS [iVersioning Of ChilkatVFP.VCX], liCalculatedBuildNumber AS Integer, ;
		lcErrorMessage AS Character, liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcPEMType AS Character, lcSecondParameter AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcProperty, ;
		m.lcPEMType, m.lcSecondParameter, m.la_Stack
		STORE 0 TO m.liCalculatedBuildNumber, m.liStackLevel
		
		WITH THIS
		
		  liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		  ** Build number not set test
		  IF m.liCalculatedBuildNumber = 0 ;
		  OR VARTYPE(m.liCalculatedBuildNumber) # T_INTEGER
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    ** Not in Destroy method test
		    IF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		
		      loVersioning = .oVersioning
		 
		      ** Problems with instantiation test
		      IF TYPE([loVersioning.Name]) # T_CHARACTER
		
		        lcMethod = m.la_Stack(m.liStackLevel, 3)
		        lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		        lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		        lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		        lcSecondParameter = m.lcProperty + [~] + m.lcMethod + [~] + m.lcPEMType
		
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ELSE
		
		        liCalculatedBuildNumber = m.loVersioning.GenerateVersionNumber([Build])
		
		      ENDIF TYPE([loVersioning.Name]) # T_CHARACTER
		      ** End problems with instantiation test
		
		    ENDIF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		    ** End not in Destroy method test
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.liCalculatedBuildNumber) ;
		  OR VARTYPE(m.liCalculatedBuildNumber) # T_INTEGER
		  ** End build number not set test
		
		  .iCalculatedBuildNumber = m.liCalculatedBuildNumber
		
		ENDWITH
		
		loVersioning = NULL
		
		RETURN THIS.iCalculatedBuildNumber
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

