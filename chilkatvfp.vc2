		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ForTimeStamping
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** 1 if this certificate can be used for time stamping, otherwise 0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE fortimestamping_assign		&& Assign method used to hold a reference to the ForTimeStamping property.
		*==============================================================================
		* Method:            ForTimeStamping_Assign
		* Purpose:           Assign method used to hold a reference to the ForTimeStamping property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the ForTimeStamping property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE getcertchain		&& Introduced in version 9.5.0.40. Returns a certficate chain object containing all the certificates (including this one), in the chain of authentication to the trusted root (if possible).
		*==============================================================================
		* Method:            GetCertChain
		* Purpose:           Returns a certficate chain object containing all the certificates.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat Certificate Chain object.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Returns a certficate chain object containing all the certificates 
		** (including this one), in the chain of authentication to the trusted root 
		** (if possible). If this certificate object was loaded from a PFX, 
		** then the certiicates contained in the PFX are automatically available 
		** for building the certificate chain. The UseCertVault method can be called 
		** to provide additional certificates that might be required to build the cert chain. 
		** Finally, the TrustedRoots object can be used to provide 
		** a way of making trusted root certificates available.
		** 
		** Note: Prior to v9.5.0.50, this method would fail if the certificate chain 
		** could not be completed to the root. Starting in v9.5.0.50, the incomplete 
		** certificate chain will be returned. The certificate chain's ReachesRoot property 
		** can be examined to see if the chain was completed to the root.
		** 
		** On Windows systems, the registry-based certificate stores 
		** are automatically consulted if needed to locate intermediate 
		** or root certificates in the chain. Chilkat searches certificate stores 
		** in the following order. See System Store Locations for more information.
		**
		**   1) Current-User "CA" Certificate Store
		**   2) Local-Machine "CA" Certificate Store
		**   3) Current-User "Root" Certificate Store
		**   4) Local-Machine "Root" Certificate Store
		**   5) Current-User "MY" Certificate Store
		**   6) Local-Machine "MY" Certificate Store
		**   7) Current-User "ADDRESSBOOK" Certificate Store (if it exists)
		**   8) Local-Machine "ADDRESSBOOK" Certificate Store (if it exists)
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loChilkatCertChain AS CHILKAT_CERTCHAIN_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCertChain
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatCertChain = m.loChilkatObject.GetCertChain()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCertChain
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatCertChain = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getencoded		&& Returns a base64 encoded string representation of the certificate's binary DER format, which can be passed to SetFromEncoded to recreate the certificate object. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetEncoded
		* Purpose:           Returns a base64 encoded string representation 
		*                    of the certificate's binary DER format.
		* Author:            Bill Anderson
