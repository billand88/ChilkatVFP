	ENDPROC

	PROCEDURE pop3beginsession		&& Call to explicitly begin a POP3 session. It is not necessary to call this method because any method requiring an established POP3 session will automatically connect and login if a session is not already open.
		*==============================================================================
		* Method:            POP3BeginSession
		* Purpose:           Call to explicitly begin a POP3 session.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/18/2022
		*==============================================================================
		
		**
		** Call to explicitly begin a POP3 session. 
		** It is not necessary to call this method because any method 
		** requiring an established POP3 session will automatically connect 
		** and login if a session is not already open.
		**
		** Important: All TCP-based Internet communications, regardless of the protocol 
		** (such as HTTP, FTP, SSH, IMAP, POP3, SMTP, etc.), and regardless of SSL/TLS, 
		** begin with establishing a TCP connection to a remote host:port. 
		** External security-related infrastructure such as software firewalls 
		** (Windows Firewall), hardware firewalls, anti-virus, at either source or destination 
		** (or both) can block the connection. 
		** If the connection fails, make sure to check all potential external causes of blockage.
		** 
		** Fixed for Version 53: A fix was made for some sitatuions 
		** where a server immediately wishes to renegotiate after connecting.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.POP3BeginSession() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  ** Process successful test
		  IF m.liReturn = 1
		
		    .AutoFixSettings()
		
		  ENDIF m.liReturn = 1
		  ** End process successful test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE pop3beginsessionasync		&& Creates an asynchronous task to call the Pop3BeginSession method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            POP3BeginSessionAsync
		* Purpose:           Creates an asynchronous task to call the 
