	PROCEDURE receivebytesenc		&& The same as ReceiveBytes, except the bytes are returned in encoded string form according to encodingAlg.
		*==============================================================================
		* Method:            ReceiveBytesENC
		* Purpose:           The same as ReceiveBytes, except the bytes are returned 
		*                    in encoded string form according to encodingAlg.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncoding -- the encoding algorithm.
		* Returns:           The received bytes.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** The same as ReceiveBytes, except the bytes are returned in encoded string 
		** form according to encodingAlg. The encodingAlg can be "Base64", "modBase64", 
		** "Base32", "UU", "QP" (for quoted-printable), "URL" (for url-encoding), 
		** "Hex", "Q", "B", "url_oath", "url_rfc1738", "url_rfc2396", or "url_rfc3986".
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, lcEncoded AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncoded = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncoded = m.loChilkatObject.ReceiveBytesENC(m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncoded
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

