		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName, the name of the member array.
		*                    tuValue, the boolean value to append.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Appends a new boolean member. (This is the same as passing -1 to the AddBoolAt method.)
		**
		** Important: The name is the member name. It is not a JSON path. 
		** To append (or update) using a JSON path, call UpdateBool instead.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcName AS Character, tuValue AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, liValue AS Integer, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liValue, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liValue = .LogicalToBit(m.tuValue)
		
		      TRY
		
		        STORE m.loChilkatObject.AppendBool(m.tcName, m.liValue) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
