		** 
		** The currently selected CSP. To select another CSP, simply set this property 
		** to the name of the CSP, such as "Microsoft Enhanced Cryptographic Provider v1.0". 
		** If the CSP is not available on your machine, the property value will not change. 
		** The initial and default value for this property is 
		** "Microsoft Base Cryptographic Provider v1.0".
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
