		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE extractchildbyname		&& Removes and returns the first child node at the specified tag or tag path. The attrName and attrValue may be empty, in which case the first child matching the tag is removed and returned.
		*==============================================================================
		* Method:            ExtractChildByName
		* Purpose:           Removes and returns the first child node at the specified tag or tag path.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTagPath -- the tag path to search
		*                    tcAttribute -- the attribute to search
		*                    tcAttributeValue -- the attribute value to search.
		* Returns:           loChilkatXML, a Chilkat XML object.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Removes and returns the first child node at the specified tag or tag path. 
		** The attrName and attrValue may be empty, 
		** in which case the first child matching the tag is removed and returned. 
		** If attrName is specified, then the first child having a tag equal to tagPath, 
		** and an attribute with attrName is returned. 
		** If attrValue is also specified, then only a child having a tag equal to tagPath, 
		** and an attribute named attrName, with a value equal to attrValue is returned.
		** 
		** Beginning in version 9.5.0.64, the tagPath can be a tag path. 
		** A tag path is a series of tags separated by vertical bar characters. 
		** For example: "tagA|tagB|tagC".
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTagPath AS Character, ;
		tcAttribute AS Character, tcAttributeValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, loChilkatXML AS CHILKAT_XML_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatXML
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatXML = ;
		      m.loChilkatObject.ExtractChildByName(m.tcTagPath, m.tcAttribute, m.tcAttributeValue)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

