	PROCEDURE postjson3		&& The same as PostJson2,except a JSON object is passed in for the request body. Returns Nothing on failure
		*==============================================================================
		* Method:            PostJSON3
		* Purpose:           The same as PostJson2, 
		*                    except a JSON object is passed in for the request body.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to post the content.
		*                    tcContentType -- the content type of the post.
		*                    toChilkatJSONObject -- the JSON text to post.
		* Returns:           Chilkat HTTP Response object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.68
		**
		** The same as PostJson2, except a JSON object is passed in for the request body.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character, tcContentType AS Character, ;
		toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatHTTPResponse, m.loParkParameterJsonObject, m.loChilkatJsonObject 
		
		llImplemented = .F.
		liIntroducedInBuild = 68
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        loChilkatHTTPResponse = ;
		        m.loChilkatObject.PostJSON3(m.tcURL, m.tcContentType, m.loChilkatJsonObject)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
