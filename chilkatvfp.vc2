		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 94
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE numreceivedclientcerts_access		&& Access method used to retrieve the Chilkat Socket NumReceivedClientCerts property.
		*==============================================================================
		* Method:            NumReceivedClientCerts_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket NumReceivedClientCerts property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumReceivedClientCerts
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** If the socket is the server-side of an SSL/TLS connection, 
		** the property represents the number of client-side certificates received 
		** during the SSL/TLS handshake (i.e. connection process). 
		** Each client-side cert may be retrieved by calling the GetReceivedClientCert method 
		** and passing an integer index value from 0 to N-1, where N is the number of client certs received.
		**
		** Note: A client only sends a certificate if 2-way SSL/TLS is required. 
		** In other words, if the server demands a certificate from the client.
		** 
		** Important: This property should be examined on the socket object 
		** that is returned by AcceptNextConnection.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

