		*==============================================================================
		
		**
		** Duplicates OpenSSL's rsautl utility for verifying RSA signatures 
		** and recovering the original data. Input data consists of the raw signature bytes 
		** and returns the original string.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tqBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, lcOriginalData AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcOriginalData = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcOriginalData = m.loChilkatObject.OpenSslVerifyString(m.tqBytes)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcOriginalData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE opensslverifystringenc		&& Duplicates OpenSSL's rsautl utility for verifying RSA signatures and recovering the original data. Input data is a signature string encoded according to the EncodingMode property (base64, hex, etc.). Returns the original string.
		*==============================================================================
