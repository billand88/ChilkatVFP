	PROCEDURE authenticatesecpwpk		&& Introduced in version 9.5.0.71. The same as AuthenticatePwPk, but the login and password are passed in secure string objects. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AuthenticateSecPwPK
		* Purpose:           The same as AuthenticatePw, except the login 
		*                    and passwords strings are passed in secure string objects.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSecureStringUserName, 
		*                    a Chilkat Secure String object holding the user name.
		*                    toChilkatSecureStringPassword, 
		*                    a Chilkat Secure String object holding the password.
		*                    toChilkatSshKey, a Chilkat SSH Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** The same as AuthenticatePwPk, except the login and passwords strings
		** are passed in secure string objects.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSecureStringUserName AS CHILKAT_SECURESTRING_COM_CALL, ;
		toChilkatSecureStringPassword AS CHILKAT_SECURESTRING_COM_CALL, ;
		toChilkatSshKey AS CHILKAT_SSHKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterSecureStringUserName AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureStringUserName AS CHILKAT_SECURESTRING_COM_CALL, ;
		loParkParameterSecureStringPassword AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureStringPassword AS CHILKAT_SECURESTRING_COM_CALL, ;
		loParkParameterSshKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSshKey AS CHILKAT_SSHKEY_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureStringUserName, m.loChilkatSecureStringUserName, ;
		m.loParkParameterSecureStringPassword, m.loChilkatSecureStringPassword, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSecureStringUserName = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureStringUserName)
		
		      loParkParameterSecureStringPassword = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureStringPassword)
		
		      loParkParameterSshKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSshKey)
		
		      loChilkatSecureStringUserName = m.loParkParameterSecureStringUserName.GetObject()
		      loChilkatSecureStringPassword = m.loParkParameterSecureStringPassword.GetObject()
		      loChilkatSshKey = m.loParkParameterSshKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AuthenticateSecPwPK(m.loChilkatSecureStringUserName, ;
		        m.loChilkatSecureStringPassword, m.loChilkatSshKey) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSecureStringUserName = m.loParkParameterSecureStringUserName.SetObject(;
		      m.toChilkatSecureStringUserName, m.loChilkatSecureStringUserName)
		
		      toChilkatSecureStringPassword = m.loParkParameterSecureStringPassword.SetObject(;
		      m.toChilkatSecureStringPassword, m.loChilkatSecureStringPassword)
		
		      toChilkatSshKey = m.loParkParameterSshKey.SetObject(m.toChilkatSshKey, m.loChilkatSshKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureStringUserName, m.loChilkatSecureStringUserName, ;
		m.loParkParameterSecureStringPassword, m.loChilkatSecureStringPassword, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatSecureStringUserName = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatSecureStringPassword = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loParkParameterSecureStringUserName = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterSecureStringPassword = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterSshKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureStringUserName = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loChilkatSecureStringPassword = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

