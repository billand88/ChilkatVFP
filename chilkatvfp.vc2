	PROCEDURE getdirroot		&& Returns the value of the Nth directory root.
		*==============================================================================
		* Method:            GetDirRoot
		* Purpose:           Returns the value of the Nth directory root.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the directory index.
		* Returns:           The directory root.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Returns the value of the Nth directory root. 
		** For example, if an application calls AddDirRoot twice, 
		** then the NumDirRoots property would have a value of 2, 
		** and GetDirRoot(0) would return the path passed to AddDirRoot in the 1st call, 
		** and GetDirRoot(1) would return the directory path in the 2nd call to AddDirRoot.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, ;
		loException AS Exception, lcDirectoryRoot AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcDirectoryRoot = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcDirectoryRoot = m.loChilkatObject.GetDirRoot(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcDirectoryRoot
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

