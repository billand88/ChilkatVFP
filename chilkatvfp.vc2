	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat PublicKey VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/20/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/20/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS rest AS ibasechilkat OF "chilkatvfp.vcx" 		&& API for implementing RESTful Web API's.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addheader		&& Introduced in version 9.5.0.58. Adds an HTTP request header. If the header field already exists, then it is replaced. Returns 1 for success, 0 for failure.
		*m: addmwssignature		&& Introduced in version 9.5.0.66. Computes the Amazon MWS signature using the mwsSecretKey and adds the "Signature" parameter to the request. This method should be called for all Amazon Marketplace Web Service (Amazon MWS) HTTP requests.
		*m: addpathparam		&& Introduced in version 9.5.0.70. Adds or replaces a path parameter. A path parameter is a string that will be replaced in any uriPath string passed to a method.
		*m: addqueryparam		&& Introduced in version 9.5.0.58. Adds a query parameter. If the query parameter already exists, then it is replaced. Returns 1 for success, 0 for failure.
		*m: addqueryparams		&& Introduced in version 9.5.0.58. Adds the query parameters from the queryString. The queryString is a query string of the format field1=value1&field2=value2&field3=value3... where each value is URL encoded. Returns 1 for success, 0 for failure.
		*m: addqueryparamsb		&& Introduced in version 9.5.0.62. Adds a query parameter. If the query parameter already exists, then it is replaced. The parameter value is passed in a StringBuilder object. Returns 1 for success, 0 for failure.
		*m: allowheaderfolding_access		&& Access method used to retrieve the Chilkat Rest AllowHeaderFolding property.
		*m: allowheaderfolding_assign		&& Assign method used to hold a reference to the AllowHeaderFolding property.
		*m: allowheaderqb_access		&& Access method used to retrieve the Chilkat Rest AllowHeaderQB property.
		*m: allowheaderqb_assign		&& Assign method used to hold a reference to the AllowHeaderQB property.
		*m: authorization_access		&& Access method used to retrieve the Chilkat Rest Authorization property.
		*m: authorization_assign		&& Assign method used to hold a reference to the Authorization property.
		*m: clearallheaders		&& Introduced in version 9.5.0.58. Removes all HTTP request headers. Returns 1 for success, 0 for failure.
		*m: clearallparts		&& Introduced in version 9.5.0.64. Removes all sub-parts from a request. This is useful when preparing the REST object to send a new request after a multipart request has just been sent. Returns 1 for success, 0 for failure.
		*m: clearallpathparams		&& Introduced in version 9.5.0.70. Clears all path parameters. Returns 1 for success, 0 for failure
		*m: clearallqueryparams		&& Introduced in version 9.5.0.58. Clears all query parameters. Returns 1 for success, 0 for failure.
		*m: clearauth		&& Introduced in version 9.5.0.69. Clears all authentication settings. Returns 1 for success, 0 for failure.
		*m: clearresponsebodystream		&& Introduced in version 9.5.0.58. Clears the response body stream.
		*m: connect		&& Introduced in version 9.5.0.58. Establishes an initial connection to a REST server. The hostname can be a domain name or an IP address. Both IPv4 and IPv6 addresses are supported. The port is the port, which is typically 80 or 443.
		*m: connectasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: connectfailreason_access		&& Access method used to retrieve the Chilkat Rest ConnectFailReason property.
		*m: connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*m: connecttimeoutms_access		&& Access method used to retrieve the Chilkat Rest ConnectTimeoutMs property.
		*m: connecttimeoutms_assign		&& Assign method used to hold a reference to the ConnectTimeoutMs property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Rest DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: debugmode_access		&& Access method used to retrieve the Chilkat Rest DebugMode property.
		*m: debugmode_assign		&& Assign method used to hold a reference to the DebugMode property.
		*m: disconnect		&& Introduced in version 9.5.0.58. Closes the connection with the HTTP server if one is open. This method can be called to ensure the connection is closed. The maxWaitMs is the maximum time in milliseconds to wait for a clean close.
		*m: disconnectasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the Disconnect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat Rest EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: fullrequestbd		&& Introduced in version 9.5.0.64. Sends a complete REST request (header + binary body) and receives the full response. The binary body of the request is passed in binData.
		*m: fullrequestbdasync		&& Introduced in version 9.5.0.64. Creates an asynchronous task to call the FullRequestBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: fullrequestbinary		&& Introduced in version 9.5.0.58. Sends a complete REST request (header + body) and receives the full response. It is assumed that the request body is binary, and the response body is a string (such as JSON or XML).
		*m: fullrequestbinaryasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the FullRequestBinary method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fullrequestformurlencoded		&& Introduced in version 9.5.0.58. Sends a complete application/x-www-form-urlencoded HTTP request and receives the full response. The request body is composed of the URL encoded query params.
		*m: fullrequestformurlencodedasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the FullRequestFormUrlEncoded method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fullrequestmultipart		&& Introduced in version 9.5.0.58. Sends a complete multipart REST request (header + multipart body) and receives the full response. It is assumed that the response body is a string (such as JSON or XML). The response body is returned.
		*m: fullrequestmultipartasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the FullRequestMultipart method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fullrequestnobody		&& Introduced in version 9.5.0.58. Sends a complete REST request and receives the full response. It is assumed that the response body is a string (such as JSON or XML). The response body is returned.
		*m: fullrequestnobodyasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the FullRequestNoBody method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fullrequestnobodybd		&& Introduced in version 9.5.0.64. The same as FullRequestNoBody, except returns the response body in the binData. This method is useful for downloading binary files. IMPORTANT: The uriPath argument should be just the path part of the URL.
		*m: fullrequestnobodybdasync		&& Introduced in version 9.5.0.64. Creates an asynchronous task to call the FullRequestNoBodyBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fullrequestnobodysb		&& Introduced in version 9.5.0.64. The same as FullRequestNoBody, except returns the response body in the sb. IMPORTANT: The uriPath argument should be just the path part of the URL.
		*m: fullrequestnobodysbasync		&& Introduced in version 9.5.0.64. Creates an asynchronous task to call the FullRequestNoBodySb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fullrequestsb		&& Introduced in version 9.5.0.62. Sends a complete REST request (header + body string) and receives the full response. The body of the request is passed in requestBody.
		*m: fullrequestsbasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the FullRequestSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: fullrequeststream		&& Introduced in version 9.5.0.58. Sends a complete REST request and receives the full response. It is assumed that the response body is a string (such as JSON or XML). The response body is returned.
		*m: fullrequeststreamasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the FullRequestStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fullrequeststring		&& Introduced in version 9.5.0.58. Sends a complete REST request (header + body string) and receives the full response. It is assumed that both the request and response bodies are strings (such as JSON or XML). The response body is returned.
		*m: fullrequeststringasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the FullRequestString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastdebugrequest		&& Introduced in version 9.5.0.77. Returns the fully composed HTTP request that would've been sent had the DebugMode been turned off. The request is returned in bd. Returns 1 for success, 0 for failure.
		*m: getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called on this object instance. For many methods, there is no information.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat Rest HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: host_access		&& Access method used to retrieve the Chilkat Rest Host property.
		*m: host_assign		&& Assign method used to hold a reference to the Host property.
		*m: idletimeoutms_access		&& Access method used to retrieve the Chilkat Rest IdleTimeoutMs property.
		*m: idletimeoutms_assign		&& Assign method used to hold a reference to the IdleTimeoutMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Rest LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Rest LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Rest LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Rest LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastjsondata		&& Introduced in version 9.5.0.79. Provides information about what transpired in the last method called on this object instance. For many methods, there is no information.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Rest LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastredirecturl_access		&& Access method used to retrieve the Chilkat Rest LastRedirectURL property.
		*m: lastredirecturl_assign		&& Assign method used to hold a reference to the LastRedirectURL property.
		*m: lastrequestheader_access		&& Access method used to retrieve the Chilkat Rest LastRequestHeader property.
		*m: lastrequestheader_assign		&& Assign method used to hold a reference to the LastRequestHeader property.
		*m: lastrequeststartline_access		&& Access method used to retrieve the Chilkat Rest LastRequestStartLine property.
		*m: lastrequeststartline_assign		&& Assign method used to hold a reference to the LastRequestStartLine property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Rest LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Rest LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: numresponseheaders_access		&& Access method used to retrieve the Chilkat Rest NumResponseHeaders property.
		*m: numresponseheaders_assign		&& Assign method used to hold a reference to the NumResponseHeaders property.
		*m: partselector_access		&& Access method used to retrieve the Chilkat Rest PartSelector property.
		*m: partselector_assign		&& Assign method used to hold a reference to the PartSelector property.
		*m: percentdoneonsend_access		&& Access method used to retrieve the Chilkat Rest PercentDoneOnSend property.
		*m: percentdoneonsend_assign		&& Assign method used to hold a reference to the PercentDoneOnSend property.
		*m: readrespbd		&& Introduced in version 9.5.0.62. Reads the response body.
		*m: readrespbdasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the ReadRespBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: readrespbodybinary		&& Introduced in version 9.5.0.58. Reads the response body.
		*m: readrespbodybinaryasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the ReadRespBodyBinary method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: readrespbodystream		&& Introduced in version 9.5.0.58. Reads the response body to the stream. If autoSetStreamCharset is 1, then the stream's StringCharset property will automatically get set based on the charset, if any, indicated in the response header
		*m: readrespbodystreamasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the ReadRespBodyStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: readrespbodystring		&& Introduced in version 9.5.0.58. Reads the response body.
		*m: readrespbodystringasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the ReadRespBodyString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: readresponseheader		&& Introduced in version 9.5.0.58. Reads the HTTP response header. If the HTTP response includes a body, then the application must call the desired method to read the response body.
		*m: readresponseheaderasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the ReadResponseHeader method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: readrespsb		&& Introduced in version 9.5.0.62. Reads the response body.
		*m: readrespsbasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the ReadRespSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: redirecturl		&& Introduced in version 9.5.0.58. If the response was a redirect and contains a Location header field, this method returns the redirect URL. Returns Nothing on failure.
		*m: removeheader		&& Introduced in version 9.5.0.58. Removes all headers having the given name. Returns 1 for success, 0 for failure.
		*m: removequeryparam		&& Introduced in version 9.5.0.58. Removes all query params having the given name. Returns 1 for success, 0 for failure.
		*m: responsehdrbyname		&& Introduced in version 9.5.0.58. Returns the value of the response header indicated by name. Returns Nothing on failure
		*m: responsehdrname		&& Introduced in version 9.5.0.58. Returns the name of the Nth response header field. (Chilkat always uses 0-based indexing. The first header field is at index 0.) Returns Nothing on failure.
		*m: responsehdrvalue		&& Introduced in version 9.5.0.58. Returns the value of the Nth response header field. (Chilkat always uses 0-based indexing. The first header field is at index 0.) Returns Nothing on failure.
		*m: responseheader_access		&& Access method used to retrieve the Chilkat Rest ResponseHeader property.
		*m: responseheader_assign		&& Assign method used to hold a reference to the ResponseHeader property.
		*m: responsestatuscode_access		&& Access method used to retrieve the Chilkat Rest ResponseStatusCode property.
		*m: responsestatuscode_assign		&& Assign method used to hold a reference to the ResponseStatusCode property.
		*m: responsestatustext_access		&& Access method used to retrieve the Chilkat Rest ResponseStatusText property.
		*m: responsestatustext_assign		&& Assign method used to hold a reference to the ResponseStatusText property.
		*m: sendreqbd		&& Introduced in version 9.5.0.62. Sends a REST request that cotnains a binary body. The httpVerb is the HTTP verb (also known as the HTTP method), such as "PUT". The uriPath is the path of the resource URI.
		*m: sendreqbdasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the SendReqBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendreqbinarybody		&& Introduced in version 9.5.0.58. Sends a REST request that cotnains a binary body. The httpVerb is the HTTP verb (also known as the HTTP method), such as "PUT".
		*m: sendreqbinarybodyasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the SendReqBinaryBody method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqformurlencoded		&& Introduced in version 9.5.0.58. Sends an application/x-www-form-urlencoded HTTP request where the body is composed of the URL encoded query params. The httpVerb is the HTTP verb (also known as the HTTP method), such as "POST".
		*m: sendreqformurlencodedasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the SendReqFormUrlEncoded method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqmultipart		&& Introduced in version 9.5.0.58. Sends a multipart REST request. The httpVerb is the HTTP verb (also known as the HTTP method), such as "GET". The uriPath is the path of the resource URI.
		*m: sendreqmultipartasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the SendReqMultipart method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendreqnobody		&& Introduced in version 9.5.0.58. Sends a REST request that cotnains no body. The httpVerb is the HTTP verb (also known as the HTTP method), such as "GET". The uriPath is the path of the resource URI.
		*m: sendreqnobodyasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the SendReqNoBody method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendreqsb		&& Introduced in version 9.5.0.62. Sends a REST request that cotnains a text body, such as XML or JSON. The httpVerb is the HTTP verb (also known as the HTTP method), such as "PUT". The uriPath is the path of the resource URI.
		*m: sendreqsbasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the SendReqSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendreqstreambody		&& ntroduced in version 9.5.0.58. Sends a REST request that cotnains a binary or text body that is obtained by reading from the stream. The httpVerb is the HTTP verb (also known as the HTTP method), such as "PUT".
		*m: sendreqstreambodyasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the SendReqStreamBody method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqstringbody		&& Introduced in version 9.5.0.58. Sends a REST request that cotnains a text body, such as XML or JSON. The httpVerb is the HTTP verb (also known as the HTTP method), such as "PUT".
		*m: sendreqstringbodyasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the SendReqStringBody method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread
		*m: setauthaws		&& Introduced in version 9.5.0.58. Sets the authorization service provider for Amazon AWS REST requests. An application that sets an AWS authentication provider need not explicitly set the Authorization property.
		*m: setauthazuread		&& Introduced in version 9.5.0.58. Sets the Azure AD (Active Directory) authorization service provider. Returns 1 for success, 0 for failure.
		*m: setauthazuresas		&& Introduced in version 9.5.0.65. Provides the information for Azure SAS (Shared Access Signature) authorization. Calling this method will cause the "Authorization: SharedAccessSignature ..." header to be automatically added to all requests.
		*m: setauthazurestorage		&& Introduced in version 9.5.0.58. Sets the authorization service provider for Azure Storage Service requests. Returns 1 for success, 0 for failure.
		*m: setauthbasic		&& Introduced in version 9.5.0.58. Sets the username and password to be used for Basic authentication. This method should be called when Basic authentication is required. It should only be used with secure SSL/TLS connections.
		*m: setauthbasicsecure		&& Introduced in version 9.5.0.71. The same as SetAuthBasic, but provides a more secure means for passing the arguments as secure string objects. Returns 1 for success, 0 for failure.
		*m: setauthgoogle		&& Introduced in version 9.5.0.58. Sets the authorization service provider for Google API requests. Returns 1 for success, 0 for failure.
		*m: setauthoauth1		&& Introduced in version 9.5.0.58. Sets the authentication provider for REST API requests needing OAuth 1.0 (and OAuth 1.0a) authentication. If useQueryParams is 1, then the OAuth1 authentication information and signature is passed in query parameters.
		*m: setauthoauth2		&& Introduced in version 9.5.0.59. Causes the "Authorization: Bearer <access_token>" header to be added to each request.
		*m: setmultipartbodybd		&& Introduced in version 9.5.0.62. Only used for multipart requests. Sets the binary content of the multipart body indicated by the PartSelector. Returns 1 for success, 0 for failure.
		*m: setmultipartbodybinary		&& Introduced in version 9.5.0.58. Only used for multipart requests. Sets the binary content of the multipart body indicated by the PartSelector. Returns 1 for success, 0 for failure.
		*m: setmultipartbodysb		&& Introduced in version 9.5.0.62. Only used for multipart requests. Sets the text content of the multipart body indicated by the PartSelector. Returns 1 for success, 0 for failure.
		*m: setmultipartbodystream		&& Introduced in version 9.5.0.58. Only used for multipart requests. Sets the stream source of the multipart body indicated by the PartSelector. Returns 1 for success, 0 for failure.
		*m: setmultipartbodystring		&& Introduced in version 9.5.0.58. Only used for multipart requests. Sets the text content of the multipart body indicated by the PartSelector. Returns 1 for success, 0 for failure.
		*m: setresponsebodystream		&& Introduced in version 9.5.0.58. Only applies to the Full* methods, such as FullRequestNoBody, FullRequestBinary, FullRequestStream, etc.
		*m: streamnonchunked_access		&& Access method used to retrieve the Chilkat Rest StreamNotChunked property.
		*m: streamnonchunked_assign		&& Assign method used to hold a reference to the StreamNotChunked property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat Rest UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: useconnection		&& Introduced in version 9.5.0.58. Sets the connection to be used for sending the REST request. The connection should be an already-connected socket.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Rest VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: allowheaderfolding		&& Introduced in version 9.5.0.63. If this property is set to 0, then no MIME header folding will be automatically applied to any request header. The default is 1.
		*p: allowheaderqb		&& Introduced in version 9.5.0.59. Controls whether non us-ascii HTTP request headers are automatically Q/B encoded. The default value is 1.
		*p: authorization		&& Introduced in version 9.5.0.58. The value of the Authorization HTTP request header (if needed).
		*p: connectfailreason		&& Introduced in version 9.5.0.58. If the Connect method fails, this property can be checked to determine the reason for failure.
		*p: connecttimeoutms		&& The maximum amount of time to wait for the connection to be accepted by the HTTP server. Note: Suprisingly, this property was forgotten and not added until Chilkat v9.5.0.71.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: debugmode		&& Introduced in version 9.5.0.77. If 1 then all calls to Send* or FullRequest* methods will not actually send a request. Instead, the request will be written to a memory buffer which can then be retrieved by calling GetLastDebugRequest.
		*p: enablesecrets		&& Introduced in version 11.5.0. This property that automatic resolution of credentials from the operating system’s secure storage.The default value is 0
		*p: heartbeatms		&& Introduced in version 9.5.0.58. This property is only valid in programming environment and languages that allow for event callbacks. Specifies the time interval in milliseconds between AbortCheck events.
		*p: host		&& Introduced in version 9.5.0.58. The value of the Host HTTP request header.
		*p: idletimeoutms		&& Introduced in version 9.5.0.58. The maximum amount of time to wait for additional incoming data when receiving, or the max time to wait to send additional data. The default value is 30000 (30 seconds). This is not an overall max timeout.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: lastredirecturl		&& Introduced in version 11.0.0. This property holds the redirect URL from the most recent response. If the last response was not a redirect, the property is empty. The redirect URL corresponds to the Location header in the HTTP response.
		*p: lastrequestheader		&& Introduced in version 9.5.0.58. The full MIME header (not including the HTTP start line which contains the status code and status text), of the last request sent.
		*p: lastrequeststartline		&& Introduced in version 9.5.0.58. The full start line of the last request sent. (The start line begins with the HTTP verb, such as GET, POST, etc., is followed by the URI path, and ends with the HTTP version.)
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numresponseheaders		&& Introduced in version 9.5.0.58. The number of response header fields. The first response header field is at index 0.
		*p: partselector		&& Introduced in version 9.5.0.58. Only used for multipart requests. Selects the target MIME part for calls to AddHeader, RemoveHeader, SetMultipartBodyBinary, SetMultipartBodyString, SetMultipartBodyStream, etc.
		*p: percentdoneonsend		&& Introduced in version 9.5.0.58. This property only applies to the FullRequest* methods, which are methods that both send an HTTP request and receive the response. (It also only applies to programming languages that support event callbacks.)
		*p: responseheader		&& Introduced in version 9.5.0.58. The full response MIME header (not including the HTTP start line which contains the status code and status text).
		*p: responsestatuscode		&& Introduced in version 9.5.0.58. The response status code.
		*p: responsestatustext		&& Introduced in version 9.5.0.58. The status message corresponding to the response status code.
		*p: streamnonchunked		&& Introduced in version 9.5.0.58. If 1, then methods that upload data are sent non-chunked if possible.
		*p: uncommonoptions		&& Introduced in version 9.5.0.80. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		allowheaderfolding = 1
		allowheaderqb = 1
		authorization = 
		cchilkatclass = Rest
		ceventhandlerclass = iBaseEventHandler
		connectfailreason = 0
		connecttimeoutms = 0
		debuglogfilepath = 
		debugmode = 0
		enablesecrets = 0
		heartbeatms = 0
		host = 
		idletimeoutms = 30000
		iinstancepatch = 58
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		lastredirecturl = 
		lastrequestheader = 
		lastrequeststartline = 
		laststringresult = 
		laststringresultlen = 0
		Name = "rest"
		numresponseheaders = 0
		partselector = 
		percentdoneonsend = 0
		responseheader = 
		responsestatuscode = 0
		responsestatustext = 
		streamnonchunked = 1
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addheader		&& Introduced in version 9.5.0.58. Adds an HTTP request header. If the header field already exists, then it is replaced. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddHeader
		* Purpose:           Adds an HTTP request header.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName, the header name.
		*                    tcValue, the header value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Adds an HTTP request header. If the header field already exists, then it is replaced.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcName AS Character, tcValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddHeader(m.tcName, m.tcValue) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addmwssignature		&& Introduced in version 9.5.0.66. Computes the Amazon MWS signature using the mwsSecretKey and adds the "Signature" parameter to the request. This method should be called for all Amazon Marketplace Web Service (Amazon MWS) HTTP requests.
		*==============================================================================
		* Method:            AddMWSSignature
		* Purpose:           Computes the Amazon MWS signature using the mwsSecretKey 
		*                    and adds the "Signature" parameter to the request.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHTTPVerb, an HTTP action.
		*                    tcURLPath, the URL path.
		*                    tcDomain, the AWS domain to connect to.
		*                    tcSecretKey, the AWS secret key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Computes the Amazon MWS signature using the mwsSecretKey 
		** and adds the "Signature" parameter to the request. 
		** This method should be called for all Amazon Marketplace Web Service 
		** (Amazon MWS) HTTP requests. 
		** It should be called after all request parameters have been added.
		**
		** Fixed in version 69: This method did not compute the signature 
		** properly when a query param value contained a “/” char. 
		** 
		** Important: The Chilkat v9.5.0.75 release accidentally breaks Amazon MWS 
		** (not AWS) authentication. If you need MWS with 9.5.0.75, 
		** send email to support@chilkatsoft.com for a hotfix, or revert back to v9.5.0.73, 
		** or update to a version after 9.5.0.75.
		** 
		** The domain should be the domain of the request, such as one of the following:
		** 
		** mws.amazonservices.com
		** mws-eu.amazonservices.com
		** mws.amazonservices.in
		** mws.amazonservices.com.cn
		** mws.amazonservices.jp
		** 
		** The httpVerb should be the HTTP verb, such as "GET", "POST", etc. 
		** The uriPath is the URI path, such as "/Feeds/2009-01-01". 
		** In general, the httpVerb and uriPath should be identical 
		** to the 1st two args passed to methods such as FullRequestFormUrlEncoded.
		** 
		** Note: This method also automatically adds or replaces 
		** the existing Timestamp parameter to the current system date/time.
		**
		** Fixed in Version 75: 
		** Fixed problems with non-us-ascii chars in x-amz-meta-* headers
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHTTPVerb AS Character, tcURLPath AS Character, ;
		tcDomain AS Character, tcSecretKey AS Character
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddMWSSignature(m.tcHTTPVerb, ;
		        m.tcURLPath, m.tcDomain, m.tcSecretKey) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addpathparam		&& Introduced in version 9.5.0.70. Adds or replaces a path parameter. A path parameter is a string that will be replaced in any uriPath string passed to a method.
