		RETURN
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat PKCS11 UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PKCS11 UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        07/09/2024
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.99
		** 
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string. 
		** It can be set to a list of one or more of the following comma separated keywords:
		**
		** Pkcs11DiscoverSkipTokenInfo - Introduced in v9.5.0.99. Applies to the Discover method. 
		** If this keyword is present, then Discover will only return the slot information 
		** and will not make potentially time-consuming calls to get TokenInfo or information about supported mechanisms.
		**
		** Pkcs11DiscoverSkipMechanisms - Introduced in v9.5.0.99. Applies to the Discover method. 
		** If this keyword is present, then Discover will get slot and token info, 
		** but will not make potentially time-consuming calls to get information about supported mechanisms.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 99
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UnCommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PKCS11 UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        07/09/2024
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 99
		
		lcValidationMethod = [UncommonOptions_Pkcs11]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat PKCS11 VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 88
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS privatekey AS ibasechilkat OF "chilkatvfp.vcx" 		&& Contains an RSA, DSA, or ECC private key. Provides methods for importing and exporting to/from PEM, DER, PKCS8, PKCS1, PVK, and XML formats. Private keys can be imported/exported to both memory and files.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: bitlength_access		&& Access method used to retrieve the Chilkat PrivateKey BitLength property.
		*m: bitlength_assign		&& Assign method used to hold a reference to the BitLength property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat PrivateKey DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getjwk		&& Introduced in version 9.5.0.66. Gets the private key in JWK (JSON Web Key) format.
		*m: getjwkthumbprint		&& Introduced in version 9.5.0.66. Returns the JWK thumbprint for the private key. This is the thumbprint of the JSON Web Key (JWK) as per RFC 7638. Returns Nothing on failure
		*m: getpkcs1		&& Introduced in version 9.5.0.58. Gets the private key in unencrypted binary DER format, preferring PKCS1 if possible.
		*m: getpkcs1enc		&& Introduced in version 9.5.0.52. Gets the private key in unencrypted binary DER format, preferring PKCS1 if possible, and returns in an encoded string, as specified by the encoding argument.
		*m: getpkcs1pem		&& Introduced in version 9.5.0.58. Gets the private key in non-encrypted PEM format, preferring PKCS1 over PKCS8 if possible for the key type.
		*m: getpkcs8		&& Gets the private key in unencrypted PKCS8 format.
		*m: getpkcs8enc		&& Introduced in version 9.5.0.52. Gets the private key in unencrypted PKCS8 format and returned in an encoded string, as specified by the encoding argument. Returns Nothing on failure.
		*m: getpkcs8encrypted		&& Writes the private key to password-protected PKCS8 format. The Pkcs8EncryptAlg property controls the encryption algorithm used to encrypt. Returns a zero-length byte array (as a Variant) on failure.
		*m: getpkcs8encryptedenc		&& Introduced in version 9.5.0.52. Writes the private key to password-protected PKCS8 format and returns as an encoded string as specified by the encoding argument. The Pkcs8EncryptAlg property controls the encryption algorithm used to encrypt.
		*m: getpkcs8encryptedpem		&& Writes the private key to password-protected PKCS8 PEM format. The Pkcs8EncryptAlg property controls the encryption algorithm used to encrypt. Returns Nothing on failure
		*m: getpkcs8pem		&& Gets the private key in PKCS8 PEM format. Returns Nothing on failure
		*m: getpkcsbd		&& Introduced in version 11.0.0. Retrieves the private key in binary DER format. If pkcs1 is 1, it uses the PKCS1 format; if 0, it uses the PKCS8 format. Returns 1 for success, 0 for failure.
		*m: getpublickey		&& Introduced in version 9.5.0.52. Returns the public key portion of the private key as a public key object. Returns Nothing on failure.
		*m: getrawhex		&& Introduced in version 9.5.0.83. Returns the private key in raw hex format (lowercase). The public key is written to pubKey. Ed25519 private and public keys are 32-byte each (64 chars in hex format). The length of an EC key depends on the curve.
		*m: getrsader		&& Undocumented method! Gets the private key in PKCS1 DER format. This method is decremented and is replaced by the GetPkcs1 method (given that this object may contain a non-RSA key).
		*m: getrsapem		&& Undocumented method! Gets the private key in PKCS1 PEM format. This method is decremented and is replaced by the GetPkcs1Pem and GetPkcs8Pem methods (given that this object may contain a non-RSA key).
		*m: getxml		&& Returns the private key in XML format. The private key is returned unencrypted and the parts are base64 encoded.
		*m: keytype_access		&& Access method used to retrieve the Chilkat PrivateKey KeyType property.
		*m: keytype_assign		&& Assign method used to hold a reference to the KeyType property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat PrivateKey LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat PrivateKey LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat PrivateKey LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorTest property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat PrivateKey LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat PrivateKey LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat PrivateKey LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat PrivateKey LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadanyformat		&& Introduced in version 9.5.0.75. Loads a private key from any format (PKCS1, PKCS8, PEM, JWK, PVK, etc.). The contents of the key (binary or text) is passed in privKeyData. The password is optional and should be specified if needed.
		*m: loadanyformatfile		&& Introduced in version 9.5.0.83. Loads a private key from a file in any format (PKCS1, PKCS8, PEM, JWK, PVK, etc.). The password is optional and should be specified if needed. Returns 1 for success, 0 for failure.
		*m: loaded25519		&& Introduced in version 9.5.0.83. Loads the private key object with an ed25519 key pair. The privKey is the 32-byte private key as a hex string. The pubKey is the 32-byte public key as a hex string.
		*m: loadencryptedpem		&& Loads the private key from an in-memory encrypted PEM string
		*m: loadencryptedpemfile		&& Loads a private key from an encrypted PEM file. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately
		*m: loadjwk		&& Introduced in version 9.5.0.66. Loads a private key from an JWK (JSON Web Key) string.
		*m: loadpem		&& Loads the private key from an in-memory PEM string. If the PEM contains an encrypted private key, then the LoadEncryptedPem method should instead be called.
		*m: loadpemfile		&& Loads a private key from a PEM file. Returns 1 for success, 0 for failure.
		*m: loadpkcs1		&& Introduced in version 9.5.0.58. Loads an RSA, ECC, or DSA private key from binary DER. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately.
		*m: loadpkcs1file		&& Introduced in version 9.5.0.58. Loads a private key from a PKCS1 file. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately.
		*m: loadpkcs8		&& Loads a private key from in-memory PKCS8 byte data.
		*m: loadpkcs8encrypted		&& Loads a private key from in-memory password-protected PKCS8 byte data.
		*m: loadpkcs8encryptedfile		&& Loads a private key from an encrypted PKCS8 file. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately.
		*m: loadpkcs8file		&& Loads a private key from a PKCS8 file. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately. The private key should be successfully loaded even when the wrong format data is passed to the wrong method.
		*m: loadpvk		&& Loads a private key from in-memory PVK byte data. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately.
		*m: loadpvkfile		&& Loads a private key from a PVK format file. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately.
		*m: loadrsader		&& Undocumented method! This method is decremented. Decremented methods will be removed at some point in the future. Applications should instead call LoadPkcs1. oads a private key from in-memory RSA PKCS#1 DER byte data.
		*m: loadrsaderfile		&& Undocumented method! This method is decremented. Decremented methods will be removed at some point in the future. Applications should instead call LoadPkcs1File. Loads a private key from an RSA DER format file.
		*m: loadxml		&& Loads a private key from an XML string.
		*m: loadxmlfile		&& Loads a private key from an XML file. Note: Each of the private key Load* methods willl auto-recognize the content and will parse appropriately.
		*m: pkcs8encryptalg_access		&& Access method used to retrieve the Chilkat PrivateKey PKCS8EncryptAlg property
		*m: pkcs8encryptalg_assign		&& Assign method used to hold a reference to the PKCS8EncryptAlg property.
		*m: savepemfile		&& Introduced in version 9.5.0.58. Saves the private key to an unencrypted PKCS1 PEM format file. Returns 1 for success, 0 for failure.
		*m: savepkcs1file		&& Introduced in version 9.5.0.58. Saves the private key to an unencrypted binary PKCS1 format file. Returns 1 for success, 0 for failure.
		*m: savepkcs8encryptedfile		&& Saves the private key to a password-protected PKCS8 format file. The Pkcs8EncryptAlg property controls the encryption algorithm used to encrypt. Returns 1 for success, 0 for failure.
		*m: savepkcs8encryptedpemfile		&& Saves the private key to a password-protected PKCS8 PEM format file. The Pkcs8EncryptAlg property controls the encryption algorithm used to encrypt. Returns 1 for success, 0 for failure.
		*m: savepkcs8file		&& Saves the private key to an unencrypted binary PKCS8 format file. Returns 1 for success, 0 for failure.
		*m: savepkcs8pemfile		&& Saves the private key to a PKCS8 PEM format file. Returns 1 for success, 0 for failure.
		*m: saversaderfile		&& Undocumented function! This method is decremented and applications should instead call SavePkcs1File. Saves the private key to a binary PKCS1 DER format file.
		*m: savexmlfile		&& Saves the private key to an XML file. Returns 1 for success, 0 for failure.
		*m: topublickey		&& Introduced in version 11.0.0. Returns in pubKey the public key portion of the private key. Returns 1 for success, 0 for failure.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat PrivateKey UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: uploadtocloud		&& Introduced in version 9.5.0.96. This is an open-ended method to accomodate uploading the private key to a cloud service, such as AWS KMS, or Azure Key Vault. Returns 1 for success, 0 for failure.
		*m: uploadtocloudasync		&& Introduced in version 9.5.0.96. Creates an asynchronous task to call the UploadToCloud method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat PrivateKey VerboseLogging property
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: bitlength		&& Introduced in version 9.5.0.49. The bit length (strength) of the private key.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: keytype		&& Introduced in version 9.5.0.52. The type of private key. Can be "empty", "rsa", "dsa", "ecc" (i.e. ECDSA), or "ed25519".
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: pkcs8encryptalg		&& Introduced in version 9.5.0.49. The encryption algorithm to be used when exporting the key to encrypted PKCS8. The default value is "3des". Possible choices also include "aes128", "aes192", and "aes256".
		*p: uncommonoptions		&& Introduced in version 9.5.0.96. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		bitlength = 0
		cchilkatclass = PrivateKey
		debuglogfilepath = 
		keytype = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "privatekey"
		pkcs8encryptalg = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE AddObject
		LPARAMETERS cName, cClass
	ENDPROC

	HIDDEN PROCEDURE bitlength_access		&& Access method used to retrieve the Chilkat PrivateKey BitLength property.
		 *==============================================================================
		* Method:            BitLength_Access
		* Purpose:           Access method used to retrieve the Chilkat PrivateKey BitLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BitLength
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** The bit length (strength) of the private key.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE bitlength_assign		&& Assign method used to hold a reference to the BitLength property.
		*==============================================================================
		* Method:            BitLength_Assign
		* Purpose:           Assign method used to hold 
		*                    the BitLength property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the BitLength property.
		* Returns:           
		* Date Added:        06/21/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  SavePemFile and SavePkcs8PemFile, which had been reversed — 
		  SavePemFile now writes the traditional representation, 
		  SavePkcs8PemFile writes PKCS #8.
		
		  Ed25519 DER/PEM export now uses the correct OID 1.3.101.112 (was sometimes the X25519 OID 1.3.101.110).
		
		  Ed25519 XML from GetXml now loads successfully.
		
		  JWK validation: an unsupported kty now fails instead of silently leaving the object empty.
		
		  GetJwkThumbprint: unsupported/empty hash algorithm now fails instead of silently using SHA-1.
		
		  Pkcs8EncryptAlg: names normalized consistently; unsupported/empty resets to the default 3des.
		
		  EC PEM labeling corrected (EC PRIVATE KEY, PRIVATE KEY, or ENCRYPTED PRIVATE KEY) 
		  so the label agrees with the DER structure.
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 11.0.0
		
		  Added the GetPkcsBd and ToPublicKey methods.
		
		  Decremented the GetPublicKey method.
		
		** Version 99
		
		  Chilkat’s internal ASN.1 decoder needed an update to correctly handle 
		  0-length ASN.1 bit strings (which is something not normally encountered).
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 96
		
		  Added the UploadToCloud method to make it easy to upload a private key to various cloud services.
		  The design allows for the easy expansion to support other cloud services.
		  (Let us know if you have suggestions.)
		
		** Version 95
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		** Version 83
		
		  Added the SHA3 hash algorithms: sha3-224, sha3-256, sha3-384, sha3-512.
		  The SHA3 hash algorithms may generally be used in any property or method
		  of any Chilkat class where a hash algorithm is specified.
		
		  Added the LoadEd25519 method to load an ed25519 private key from two 32-byte hex strings.
		
		  Improved support for ECDSA certs.
		
		  Improved support for Ed25519 private keys.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 78
		
		  Fixed a problem reading the PEM output (Encrypted Private Key) produced by this OpenSSL command:
		  pkcs12 -in sample.p12 -passin pass:test123 –passout pass:test1234 -out sampleKey.pem
		
		** Version 76
		
		  The LoadAnyFormat method now has the ability to load a hexadecimal raw ECDSA key.
		
		** Version 75
		
		  Added the LoadAnyFormat method to load a private key from any text or binary format.
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 73
		
		  Fixed: The GetPkcs8Pem method (for ECC keys) was returning PKCS1 but should’ve been returning PKCS8.
		
		** Version 72
		
		  Fixed a problem in loading certain (seldom encountered) types of private keys.
		  Specifically, keys using PBES1/RC4.
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		** Version 66
		
		  Added PublicKey.GetJwk and PrivateKey.GetJwk to get public/private keys in JSON Web Key format.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Decremented many methods and added new methods. Originally these classes were for RSA keys,
		  but have since become a classes that can contain either RSA, DSA, or ECC keys.
		  Methods with “RSA” in the name were decremented. Also, methods with confusing names were decremented
		  and replaced with methods having better names.
		
		** Version 56
		
		  Fixed: The LoadPvkFile method was not working.
		
		  Added the “base64url” encoding to the list of supported encodings.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 55
		
		  A new Chilkat encoding named “fingerprint” was added. The “fingerprint” encoding
		  is lowercase hex with each byte separated by a colon character.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 49
		
		  Added the Pkcs8EncryptAlg property.
		
		** Version 43
		
		  Fixed bug in the PrivateKey.SavePkcs8EncryptedFile method.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat PrivateKey DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PrivateKey DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/21/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PrivateKey DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        06/21/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE getjwk		&& Introduced in version 9.5.0.66. Gets the private key in JWK (JSON Web Key) format.
		*==============================================================================
		* Method:            GetJWK
		* Purpose:           Gets the private key in JWK (JSON Web Key) format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The private key in JWK format.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Gets the public key in JWK (JSON Web Key) format.
		** 
		** RSA public keys have this JWK format:
		** 
		**          {"kty":"RSA",
		**           "n":"0vx7agoebGcQ ... JzKnqDKgw",
		**           "e":"AQAB",
		**           "d":"X4cTteJY_gn4F ... 4jfcKoAC8Q",
		**           "p":"83i-7IvMGXoMX ... vn7O0nVbfs",
		**           "q":"3dfOR9cuYq-0S ... 4vIcb6yelxk",
		**           "dp":"G4sPXkc6Ya9 ... 8YeiKkTiBj0",
		**           "dq":"s9lAH9fggBso ... w494Q_cgk",
		**           "qi":"GyM_p6JrXySi ... zTKhAVRU"}
		** 
		** ECC keys have this JWK format.
		** 
		**          {"kty":"EC",
		**           "crv":"P-256",
		**           "x":"MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4",
		**           "y":"4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM",
		**           "d":"870MB6gfuTJ4HtUnUvYMyJpr5eUZNP4Bk43bVdj3eAE"}
		** 
		** Ed25519 keys (added in v9.5.0.83) have this JWK format.
		** 
		**          {"kty": "OKP",
		**          "crv": "Ed25519",
		**          "x": "SE2Kne5xt51z1eciMH2T2ftDQp96Gl6FhY6zSQujiP0",
		**          "d": "O-eRXewadF0sNyB0U9omcnt8Qg2ZmeK3WSXPYgqe570",
		**          "use": "sig"}
		** 
		** Fixed for version 11.6.0: JWK validation: an unsupported kty 
		** now fails instead of silently leaving the object empty.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcJWKFormattedKey AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcJWKFormattedKey = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcJWKFormattedKey = m.loChilkatObject.GetJWK()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcJWKFormattedKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getjwkthumbprint		&& Introduced in version 9.5.0.66. Returns the JWK thumbprint for the private key. This is the thumbprint of the JSON Web Key (JWK) as per RFC 7638. Returns Nothing on failure
		*==============================================================================
		* Method:            GetJWKThumbPrint
		* Purpose:           Returns the JWK thumbprint for the private key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHashAlgorithm, the hash algorithm
		* Returns:           The JWK thumbprint for the public key.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in Version 9.5.0.66
		** 
		** Returns the JWK thumbprint for the private key. 
		** This is the thumbprint of the JSON Web Key (JWK) as per RFC 7638.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement to Version 95: Added support for SHA224 
		** in all places where a hash algorithm might be specified.
		**
		** Fixed for Version 11.6.0: Unsupported/empty 
		** hash algorithm now fails instead of silently using SHA-1.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHashAlgorithm AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcJWKThumbPrint AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcJWKThumbPrint = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcJWKThumbPrint = m.loChilkatObject.GetJWKThumbPrint(m.tcHashAlgorithm)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcJWKThumbPrint
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getpkcs1		&& Introduced in version 9.5.0.58. Gets the private key in unencrypted binary DER format, preferring PKCS1 if possible.
		*==============================================================================
		* Method:            GetPKCS1
		* Purpose:           Gets the private key in unencrypted binary DER format, 
		*                    preferring PKCS1 if possible.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The private key in DER format.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		** 
		** Gets the private key in unencrypted binary DER format, preferring PKCS1 if possible.
		** 
		** RSA keys are returned in PKCS1 ASN.1 DER format:
		** 
		**   RSAPrivateKey ::= SEQUENCE {
		**       version           Version,
		**       modulus           INTEGER,  -- n
		**       publicExponent    INTEGER,  -- e
		**       privateExponent   INTEGER,  -- d
		**       prime1            INTEGER,  -- p
		**       prime2            INTEGER,  -- q
		**       exponent1         INTEGER,  -- d mod (p-1)
		**       exponent2         INTEGER,  -- d mod (q-1)
		**       coefficient       INTEGER,  -- (inverse of q) mod p
		**       otherPrimeInfos   OtherPrimeInfos OPTIONAL
		**   }
		** 
		** DSA keys are returned in this ASN.1 DER format:
		** 
		**   SEQUENCE(6 elem)
		**     INTEGER 0
		**     INTEGER(2048 bit) (p) 
		**     INTEGER(160 bit) (q) 
		**     INTEGER(2044 bit) (g) 
		**     INTEGER(2040 bit) (y - public key) 
		**     INTEGER(156 bit) (x - private key) 
		** 
		** ECC keys are returned in this ASN.1 DER format:
		** 
		**   (from RFC 5915)
		**   ECPrivateKey ::= SEQUENCE {
		**       version        INTEGER { ecPrivkeyVer1(1) } (ecPrivkeyVer1),
		**       privateKey     OCTET STRING,
		**       parameters [0] ECParameters {{ NamedCurve }} OPTIONAL,
		**       publicKey  [1] BIT STRING OPTIONAL (This is the ANSI X9.63 public key format.)
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		**   
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lqDERPrivateKey AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDERPrivateKey
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lqDERPrivateKey = m.loChilkatObject.GetPKCS1()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDERPrivateKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getpkcs1enc		&& Introduced in version 9.5.0.52. Gets the private key in unencrypted binary DER format, preferring PKCS1 if possible, and returns in an encoded string, as specified by the encoding argument.
		*==============================================================================
		* Method:            GetPKCS1ENC
		* Purpose:           Gets the private key in unencrypted binary DER format, 
		*                    preferring PKCS1 if possible and returns in an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncoding, the private key encoding.
		* Returns:           The private character encoded DER key.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Gets the private key in unencrypted binary DER format, 
		** preferring PKCS1 if possible, and returns in an encoded string, 
		** as specified by the encoding argument.
		**
		** RSA keys are returned in PKCS1 ASN.1 DER format:
		** 
		**   RSAPrivateKey ::= SEQUENCE {
		**       version           Version,
		**       modulus           INTEGER,  -- n
		**       publicExponent    INTEGER,  -- e
		**       privateExponent   INTEGER,  -- d
		**       prime1            INTEGER,  -- p
		**       prime2            INTEGER,  -- q
		**       exponent1         INTEGER,  -- d mod (p-1)
		**       exponent2         INTEGER,  -- d mod (q-1)
		**       coefficient       INTEGER,  -- (inverse of q) mod p
		**       otherPrimeInfos   OtherPrimeInfos OPTIONAL
		**   }
		**   
		**   DSA keys are returned in this ASN.1 DER format:
		**   
		**   SEQUENCE(6 elem)
		**       INTEGER 0
		**       INTEGER(2048 bit) (p) 
		**       INTEGER(160 bit) (q) 
		**       INTEGER(2044 bit) (g) 
		**       INTEGER(2040 bit) (y - public key) 
		**       INTEGER(156 bit) (x - private key) 
		**   ECC keys are returned in this ASN.1 DER format:
		**   
		**   (from RFC 5915)
		**   ECPrivateKey ::= SEQUENCE {
		**       version        INTEGER { ecPrivkeyVer1(1) } (ecPrivkeyVer1),
		**       privateKey     OCTET STRING,
		**       parameters [0] ECParameters {{ NamedCurve }} OPTIONAL,
		**       publicKey  [1] BIT STRING OPTIONAL (This is the ANSI X9.63 public key format.)
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcEncodedPrivateDERKey AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedPrivateDERKey = []
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcEncodedPrivateDERKey = m.loChilkatObject.GetPKCS1ENC(m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedPrivateDERKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

