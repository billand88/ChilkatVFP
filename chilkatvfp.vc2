	PROCEDURE sendstring		&& Sends a string over a connected SSL or non-SSL (TCP/IP) socket. If transmission halts for more than MaxSendIdleMs milliseconds, the send is aborted. The string is sent in the charset encoding specified by the StringCharset property.
		*==============================================================================
		* Method:            SendString
		* Purpose:           Sends a string over a connected SSL or non-SSL (TCP/IP) socket.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the string to send.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** Sends a string over a connected SSL or non-SSL (TCP/IP) socket. 
		** If transmission halts for more than MaxSendIdleMs milliseconds, the send is aborted. 
		** The string is sent in the charset encoding specified by the StringCharset property.
		** 
		** This is a blocking (synchronous) method. It returns after the string has been sent.
		**
		** Fixed for Version 56: Calling this method when a socket was already disconnected 
		** would cause a crash in some circumstances.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SendString(m.tcString) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

