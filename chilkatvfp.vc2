	PROCEDURE bencodecontent		&& Sets the node's content with 8bit data that is in a specified multibyte character encoding such as utf-8, shift-jis, big5, etc. The data is first B-encoded and the content is set to be the B-encoded string.
		*==============================================================================
		* Method:            BEncodeContent
		* Purpose:           Sets the node's content with 8bit encoded data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset -- the charset to encode with
		*                    tqData -- the data to encode.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Sets the node's content with 8bit data that is 
		** in a specified multibyte character encoding such as utf-8, shift-jis, big5, etc. 
		** The data is first B-encoded and the content is set to be the B-encoded string. 
		** For example, if called with "Big5"for the charset, 
		** you would get a string that looks something like this: "=?Big5?B?pHCtsw==?=". 
		** The data is Base64-encoded and stored between the last pair of "?" delimiters. 
		** Use the DecodeContent method to retrieve the byte data from a B encoded string.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCharset AS Character, tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.BEncodeContent(m.tcCharset, m.tqData) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE cdata_access		&& Access method used to retrieve the Chilkat XML cData property.
		*==============================================================================
		* Method:            cData_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML cData property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.cData
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** When True, causes an XML node's content to be encapsulated in a CDATA section.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE cdata_assign		&& Assign method used to hold a reference to the cData property.
		*==============================================================================
		* Method:            cData_Assign
		* Purpose:           Assign method used to hold a reference to the cData property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the cData property.
		* Returns:           
		* Date Added:        05/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE childcontentmatches		&& Return 1 if a child at the specified tagPath contains content that matches a wildcarded pattern. Otherwise returns 0.
		*==============================================================================
		* Method:            ChildContentMatches
		* Purpose:           Return 1 if a child at the specified tagPath 
		*                    contains content that matches a wildcarded pattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTagPath -- the tag path (see documentation).
		*                    tcPattern -- the pattern to match.
		*                    tuCaseSensitive -- whether or not case sensitive matching.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Return 1 if a child at the specified tagPath contains 
		** content that matches a wildcarded pattern. Otherwise returns 0.
		**
		** Beginning in version 9.5.0.64, the tagPath can be a tag path. 
		** A tag path is a series of tags separated by vertical bar characters. 
		** For example: "tagA|tagB|tagC".
		**
		
		LPARAMETERS tcTagPath AS Character, ;
		tcPattern AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liCaseSensitive AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    TRY
		
		      STORE m.loChilkatObject.ChildContentMatches(m.tcTagPath, ;
		      m.tcPattern, m.liCaseSensitive) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.1
		
		  The Strict property was left out of the Chilkat ActiveX component. This version fixes the issue.
		
		** Version 11.6.0
		
		  Chilkat’s XML and JSON parsers are deliberately tolerant: given input that is not well-formed 
		  they parse what they can, report success, and leave a partially populated document. 
		  That is the wrong behavior when a silently dropped element or member changes what the application does. 
		  Both classes now have a Strict property that closes this off.
		
		  Property  Behavior when true
		
		  Xml.Strict
		  (default false) Checks the input is well-formed XML before parsing; 
		  on failure the load fails and the object is left unchanged. 
		  Applies to LoadXml, LoadXml2, LoadSb, LoadBd, LoadXmlFile, LoadXmlFile2. 
		  (Well-formedness only, not validating.)
		
		  JsonObject.Strict
		  (default false) Validates the text against the full JSON grammar first; 
		  on failure leaves existing contents unchanged. 
		  Applies to Load, LoadSb, LoadBd, LoadFile, LoadPredefined.
		
		  Both default to false, so existing applications are unaffected. 
		  Turn Strict on for input carrying configuration, credentials, signed content, or security parameters.
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 11.1.0
		
		  Added the GetChildWithTag2 method.
		
		** Version 11.0.0
		
		  Added the SetBinaryContentBd method.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 96
		
		  The NewChild/NewChild2 methods would convert hex entities incorrectly.
		  For example, if the content passed in is “Bührmann”, the the content in the XML
		  would become “B&#252;hrmann”. This is now fixed.
		  When re-emitting the XML or saving, the content remains “ü”.
		
		  Fixed the AccumulateTagContent method. The “skipTags” argument was getting ignored.
		
		** Version 82
		
		  In attribute values: tabs, newlines, carriage returns are emitted using “&#x9;”, “&#xA;”, and “&#xD;” respectively.
		
		** Version 80
		
		  The DecodeEntities method assumed that all hex entities were 2 byte hex values.
		  It now handles 4 byte hex values such as &#x00f6; and &#x20ac;
		
		  The RemoveChild method did not remove the element if the last item in the tagPath is an array reference.
		  See https://stackoverflow.com/questions/58129782/chilkat-xml-lib-removechild-method/58139276
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 77
		
		  Added the following methods and properties:
		  GetChildAttrValue, TagUnpEquals, TagNsEquals, TagUnprefixed, and TagNsPrefix.
		
		  Fixed: LoadXml with autoTrim=false would introduce an extra leading SPACE character in the content.
		  For example: <a>{SPACE}123</a> would become <a>{SPACE}{SPACE}123</a> (where {SPACE}
		  represents a single SPACE char). This would only happen to nodes with a leading SPACE char in the content.
		  For example, <a>123</a> would be unaffected.
		
		  Added the RemoveStyleSheet method.
		
		  Added new methods: Scrub, PruneTag, and PruneAttribute.
		
		  Added new methods: LoadBd, GetXmlBd
		
		  Added the TagPath property.
		
		  Added the NextInTraversal2 method.
		
		** Version 76
		
		  For the HasChildWithTag method, if the tagPath ended with array brackets, then the method failed.
		  For example, if the tagPath was “something[i]”, then it did not work.
		  If however, the tagPath was “something[i]|another”, then it worked.
		
		  Added the IsBase64 property to both StringBuilder and Xml.
		  This allows for applications to easily check to see if the content is valid base64.
		
		  Added the GetChildContentSb method.
		
		  Fixed a particular entity encoding/decoding issue.
		
		  Fixed a crash bug in the NumChildrenHavingTag method.
		
		** Version 75
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 72
		
		  Fixed cases where “ ” was getting changed to &#xA; in round-trip load/save.
		
		  Encrypting 0 bytes for block cipher algorithms with padding
		  now results in one block of output, rather than 0 bytes.
		  (Decrypting the 16-byte block will return the original 0 bytes.)
		  This only applies to block ciphers operating in modes such as ECB, CBC, etc.
		  This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 64
		
		  Added a number of methods and properties to the Chilkat.Xml API.
		  These new methods are related to the “path” and I,J,K techniques that were found
		  to be so handy w/ the Chilkat JSON API.  (These new methods will be heavily used in the Xero examples,
		  because Xero requests and responses are in XML, and these new features greatly simplify the coding.)
		  The new methods/properties are:
		
		    EmitCompact (property)
		    I, J, K (properties)
		    UpdateAt
		    UpdateAttrAt
		    NumChildrenAt
		
		  The following methods are updated to accept either a tag or “tag path”:
		
		    NewChild2
		    NewChildInt2
		    GetChildContent
		    GetChildIntValue
		    GetChildBoolValue
		
		  many other methods are updated.  These methods will be noted in the reference documentation.
		  The 1st argument will be named “tagPath”, and a note in the documentation will indicate
		  that the 1st arg can be either a tag or tagPath, and that support for tag paths began in v9.5.0.64.
		
		  The Xml.ChilkatPath method was updated to allow for “[i]”, “[j]”, and “[k]” to be used in path strings.
		  When used, each is substituted with the current value of the I, J, and K properties.
		
		** Version 62
		
		  Note: One use of BinData and StringBuilder is in use of new methods ending in “Sb” and “Bd”.
		  These methods are for returning or passing text or binary data, especially large amounts of text or data.
		  For example, imagine one Chilkat method is used to retrieve a large amount of data,
		  and then that data is passed to another Chilkat method. A large waste of time and memory is consumed
		  in returning the string (or binary bytes) to the programming language,
		  and then immediately passing it back to Chilkat.
		  If it is .NET, then the data must be marshaled from unmanaged to managed, and then,
		  to pass back to Chilkat it is marshaled from managed to unmanaged.
		  The same applies when using the ActiveX (with BSTR’s and Variants).
		  By retrieving results directly into a BinData or StringBuilder,
		  and then passing the data by passing the object, the data stays on the native side.
		  For example, the new Rest.ReadRespSb method reads the REST response directly in to a StringBuilder.
		  If it is JSON, this can be loaded directly into a JsonObject via the JsonObject.LoadSb.
		  In the future, new “Sb” and “Bd” methods will be added in places
		  where large amounts of data are likely to be encountered.
		  This will create pathways allowing data to stay native as much as possible.
		  Version 9.5.0.62 adds the following initial set of Sb/Bd methods:
		
		    JsonObject.LoadSb
		    JsonObject.EmitSb
		    Xml.LoadSb
		    Xml.GetXmlSb
		
		    Email.GetMimeBd
		    Email.GetMimeSb
		    Email.SetFromMimeSb
		    Email.SetFromMimeBd
		
		    Mime.LoadMimeSb
		    Mime.LoadMimeBd
		    Mime.GetMimeSb
		    Mime.GetMimeBd
		    MailMan.RenderToMimeBd
		    MailMan.RenderToMimeSb
		    Rest.FullRequestSb
		    Rest.ReadRespSb
		    Rest.SendReqSb
		    Rest.SetMultipartBodySb
		    Rest.AddQueryParam
		    Rest.ReadRespBd
		    Rest.SendReqBd
		    Rest.SetMultipartBodyBd
		    Imap.FetchAttachmentSb
		    Imap.FetchAttachmentBd
		    Imap.AppendMimeWithFlagsSb
		    SFtp.UploadSb
		    SFtp.DownloadSb
		    SFtp.UploadBd
		    SFtp.DownloadBd
		    Ftp2.GetFileSb
		    Ftp2.GetFileBd
		
		    Ftp2.PutFileSb
		    Ftp2.PutFileBd
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 56
		
		   Added the “base64url” encoding to the list of supported encodings.
		   See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 55
		
		  A new Chilkat encoding named “fingerprint” was added. The “fingerprint” encoding
		  is lowercase hex with each byte separated by a colon character.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		  The AccumulateTagContent now allows an app to pass “*” or empty string to accumulate the text for any tag.
		  This is one way to implement the innerText HTML function.
		
		** Version 49
		
		  Added Base58 encoding as an additional choice for all places
		  where an encoding (such as “base64”, “hex”, etc.) can be selected.
		
		** Version 47
		
		  Fixed problem with the NewChildBefore method. The problem was that
		  indices 0 and 1 were treated the same. All higher indices were treated as idx-1.
		
		** Version 44
		
		  Added the EmitBom property to Chilkat.Xml (CkXml)
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE chilkatpath		&& Follows a series of commands to navigate through an XML document to return a piece of data or update the caller's reference to a new XML document node. Note: This method not related to the XPath (XML Path) standard in any way.
		*==============================================================================
		* Method:            ChilkatPath
		* Purpose:           Accumulates the content of all nodes having 
		*                    a specific tag into a single result string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathCommand -- the tag to search for
		* Returns:           Character
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Follows a series of commands to navigate through an XML document 
		** to return a piece of data or update the caller's reference to a new XML document node.
		** 
		** Note: This method not related to the XPath (XML Path) standard in any way.
		** 
		** The pathCmd is formatted as a series of commands separated by vertical bar characters, 
		** and terminated with a return-command:
		** 
		**     command|command|command|...|returnCommand
		** 
		** A command can be any of the following:
		** 
		** 1)  TagName -- Navigate to the 1st direct child with the given tag.
		** 2)  TagName[n] -- Navigate to the Nth direct child with the given tag.
		** 3)  ".." -- Navigate up to the parent.
		** 4)  "++" -- Navigate to the next sibling. (next/previous sibling feature added in v9.5.0.76)
		** 5)  "--" -- Navigate to the previous sibling.
		** 6)  TagName{Content} -- Navigate to the 1st direct child 
		**     with the given tag having the exact content.
		** 7)  /T/TagName -- Traverse the XML DOM tree (rooted at the caller) 
		**     and navigate to the 1st node having the given tag.
		** 8)  /C/TagName,ContentPattern -- Traverse the XML DOM tree (rooted at the caller) 
		**     and navigate to the 1st node having the given tag 
		**     with content that matches the ContentPattern. 
		**     ContentPattern may use one or more asterisk ('*") characters 
		**     to represent 0 or more of any character.
		** 9)  /C/ContentPattern -- Traverse the XML DOM tree (rooted at the caller) 
		**     and navigate to the 1st node having any tag with content that matches the ContentPattern. 
		**     ContentPattern may use one or more asterisk ('*") characters 
		**     to represent 0 or more of any character.
		** 10) /A/TagName,AttrName,AttrValuePattern -- Traverse the XML DOM tree 
		**     (rooted at the caller) and navigate to the 1st node having the given tag, 
		**     and attribute, with the attribute value that matches the AttrValuePattern. 
		**     AttrValuePattern may use one or more asterisk ('*") characters 
		**     to represent 0 or more of any character.
		** 
		** The returnCommand can be any of the following:
		** 
		** 1)  * -- Return the Content of the node.
		** 2)  (AttrName) -- Return the value of the given attribute.
		** 3)  z -- Update the caller's internal reference to be the node 
		**     (arrived at by following the series of commands). Returns an empty string.
		**
		** Enhancement in version 64: The method was updated to allow for “[i]”, “[j]”, and “[k]” 
		** to be used in path strings.  When used, each is substituted with the current value 
		** of the I, J, and K properties.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcPathCommand AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, lcReturn AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcReturn = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcReturn = m.loChilkatObject.ChilkatPath(m.tcPathCommand)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE clear		&& Removes all children, attributes, and content from the XML node. Resets the tag name to "unnamed".
		*==============================================================================
		* Method:            Clear
		* Purpose:           Removes all children, attributes, and content from the XML node. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Removes all children, attributes, and content from the XML node. 
		** Resets the tag name to "unnamed".
		**
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.Clear()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE contentint_access		&& Access method used to retrieve the Chilkat XML ContentInt property.
		*==============================================================================
		* Method:            ContentInt_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML ContentInt property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ContentInt
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Set/get the content as an integer.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE contentint_assign		&& Assign method used to hold a reference to the ContentInt property.
		*==============================================================================
		* Method:            ContentInt_Assign
		* Purpose:           Assign method used to hold a reference to the ContentInt property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ContentInt property.
		* Returns:           
		* Date Added:        05/09/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE contentmatches		&& Return true if the node's content matches a wildcarded pattern.
		*==============================================================================
		* Method:            ContentMatches
		* Purpose:           Return true if the node's content matches a wildcarded pattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPattern -- the pattern to match against.
		*                    tuCaseSensitive -- whether or not case sensitive matching.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Return true if the node's content matches a wildcarded pattern.
		**
		
		LPARAMETERS tcPattern AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liCaseSensitive AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    TRY
		
		      STORE m.loChilkatObject.ContentMatches(m.tcPattern, m.liCaseSensitive) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE content_access		&& Access method used to retrieve the Chilkat XML Content property.
		*==============================================================================
		* Method:            Content_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML Content property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Content
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** The content of the XML node. 
		** It is the text between the open and close tags, not including child nodes. For example:
		** 
		** <tag1>This is the content</tag1>
		** 
		** <tag2><child1>abc</child1><child2>abc</child2>This is the content</tag2>
		** 
		** Because the child nodes are not included, 
		** the content of "tag1" and "tag2" are both equal to "This is the content".
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE content_assign		&& Assign method used to hold a reference to the Content property.
		*==============================================================================
