	PROCEDURE appendencoded		&& Appends characters from an encoded string. The encoding may be "base64", "hex", "url", or "quoted-printable".
		*==============================================================================
		* Method:            AppendEncoded
		* Purpose:           Appends characters from an encoded string. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedString, the encoded string to append.
		*                    tcEncoding, the encoding of the string to append.
		*                    tcCharset, the charset of the string to append.
		* Returns:           
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Appends characters from an encoded string. 
		** 
		** The encoding may be "base64", "hex", "url", or "quoted-printable". 
		** For example, to append "ABC 123" from a URL-encoded string, call:
		** 
		**   strObj.AppendEncoded("ABC+123","url","iso-8859-1")
		**
		** Fix for version 78: The appendHexData method would terminate 
		** with an unnecessary LF if the passed in data was a multiple of 16.
		**
		** Fixed in version 99: Fixed a crash problem 
		** when appending hex encoded bytes to be interpreted as “gsm”.
		** 
		
		LPARAMETERS tcEncodedString AS Character, ;
		tcEncoding AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AppendEncoded(m.tcEncodedString, m.tcEncoding, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

