	PROCEDURE fetchsingle		&& Retrieves a single message from the IMAP server, including attachments if the AutoDownloadAttachments property is 1. If bUid is 1, then msgId represents a UID. If bUid is 0, then msgId represents a sequence number. Returns Nothing on failure.
		*==============================================================================
		* Method:            FetchSingle
		* Purpose:           Retrieves a single message from the IMAP server, including 
		*                    attachments if the AutoDownloadAttachments property is 1.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageID -- the message ID of the copied message.
		*                    tuUID -- whether or not the message ID is a UID.
		* Returns:           A Chilkat Email object, or NULL
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Retrieves a single message from the IMAP server, 
		** including attachments if the AutoDownloadAttachments property is 1. 
		** If bUid is 1, then msgId represents a UID. 
		** If bUid is 0, then msgId represents a sequence number.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiMessageID AS Integer, tuUID AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		loException AS Exception, loChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmail
		
		luID = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUID = .LogicalToBit(m.tuUID)
		
		    TRY
		
		      loChilkatEmail = m.loChilkatObject.FetchSingle(m.tiMessageID, m.liUID)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmail
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatEmail  = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

