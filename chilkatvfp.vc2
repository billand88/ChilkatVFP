		        m.liHeadersOnly, m.tiNumBodyLines, m.loChilkatEMailBundle)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEMailBundle = m.loParkParameterEMailBundle.SetObject(;
		      m.toChilkatEMailBundle, m.loChilkatEMailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEMailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterEMailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEMailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE fetchbymsgnum		&& Fetches an email by message number. WARNING: Be very careful if calling this method. Message numbers are specific to a POP3 session.
		*==============================================================================
		* Method:            FetchByMsgNum
		* Purpose:           Fetches an email by message number. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMsgNum -- the email message number.
		* Returns:           Chilkat Email Object, or NULL
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** Fetches an email by message number. 
		** WARNING: Be very careful if calling this method. 
		** Message numbers are specific to a POP3 session. 
		** If a maildrop has (for example) 10 messages, the message numbers will be 1, 2, 3, ... 10. 
		** If message number 1 is deleted and a new POP3 session is established, 
		** there will be 9 messages numbered 1, 2, 3, ... 9.
		**
		** IMPORTANT: A POP3 connection must first be established by either calling Pop3BeginSession 
		** explicitly, or implicitly by calling some other method that automatically establishes the session. 
		** This method will not automatically establish a new POP3 session (because if it did, 
		** the message numbers would potentially be different than what the application expects).
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiMsgNum AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, loChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      loChilkatEmail = m.loChilkatObject.FetchByMsgNum(m.tiMsgNum)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmail
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

