	PROCEDURE loadxml		&& Loads an XML document from a memory buffer and returns 1 if successful. The contents of the calling node are replaced with the root node of the XML document loaded. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadXML
		* Purpose:           Loads an XML document from a memory buffer and returns 1 if successful.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcXMLData -- the XML data to load.
		* Returns:           Returns 1 for true, 0 for false.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Loads an XML document from a memory buffer and returns 1 if successful. 
		** The contents of the calling node are replaced with the root node of the XML document loaded.
		**
		** Fix for version 77: This method with autoTrim=false would introduce an extra leading SPACE 
		** character in the content. 
		** For example: <a>{SPACE}123</a> would become <a>{SPACE}{SPACE}123</a>
		** (where {SPACE} represents a single SPACE char). 
		** This would only happen to nodes with a leading SPACE char in the content. 
		** For example, <a>123</a> would be unaffected.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcXMLData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadXML(m.tcXMLData) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

