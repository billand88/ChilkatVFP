	PROCEDURE genrsakey		&& Introduced in version 9.5.0.96. Generate an RSA key pair suitable for signing data and verifying signatures. The private key is created on the HSM (smart card or token), and the public key is returned in pubKey.
		*==============================================================================
		* Method:            GenRsaKey
		* Purpose:           Generate an RSA key pair suitable for signing data and verifying signatures.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONPublicAttrs, a Chilkat JSON object.
		*                    toChilkatJSONPrivateAttrs, a Chilkat JSON object.
		*                    toChilkatJSONOut, a Chilkat JSON object.
		*                    toChilkatPublicKey, a Chilkat Public Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		** 
		** Generate an RSA key pair suitable for signing data and verifying signatures. 
		** The private key is created on the HSM (smart card or token), 
		** and the public key is returned in pubKey. The publicAttrs and privateAttrs 
		** contain attributes for the public and private keys respectively. 
		** The PKCS11 public and private key handles are returned in jsonOut. 
		** Handles are used to reference a PKCS11 object, such as a public or private key, 
		** and are valid during the PKCS11 session. To use the key in future PKCS11 sessions, 
		** your application would need to find the object to get a new handle.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJSONPublicAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatJSONPrivateAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatJSONOut AS CHILKAT_JSONOBJECT_COM_CALL, toChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterJSONPublicAttrs AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONPublicAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterJSONPrivateAttrs AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONPrivateAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterJSONOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONOut AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterPublicKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONPublicAttrs, m.loChilkatJSONPublicAttrs, ;
		m.loParkParameterJSONPrivateAttrs, m.loChilkatJSONPrivateAttrs, ;
		m.loParkParameterJSONOut, m.loChilkatJSONOut, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONPublicAttrs = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONPublicAttrs)
		
		      loParkParameterJSONPrivateAttrs = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONPrivateAttrs)
		
		      loParkParameterJSONOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONOut)
		
		      loParkParameterPublicKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPublicKey)
		
		      loChilkatJSONPublicAttrs = m.loParkParameterJSONPublicAttrs.GetObject()
		      loChilkatJSONPrivateAttrs = m.loParkParameterJSONPrivateAttrs.GetObject()
		      loChilkatJSONOut = m.loParkParameterJSONOut.GetObject()
		      loChilkatJSONPublicKey = loParkParameterJSONPublicKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenRsaKey(m.loChilkatJSONPublicAttrs, ;
		        m.loChilkatJSONPrivateAttrs, m.loChilkatJSONOut, m.loChilkatJSONPublicKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONPublicAttrs = loParkParameterJsonObject.SetObject(;
		      toParkParameterJSONPublicAttrs, m.loParkParameterJSONPublicAttrs)
		
		      toChilkatJSONPrivateAttrs = loParkParameterJsonObject.SetObject(;
		      toParkParameterJSONPrivateAttrs, m.loParkParameterJSONPrivateAttrs)
		
		      loChilkatJSONOut = ;
		      loParkParameterJsonObject.SetObject(m.toChilkatJSONOut, m.loChilkatJSONOut)
		
		      loChilkatPublicKey = ;
		      m.loParkParameterPublicKey.SetObject(m.toChilkatPublicKey, m.loChilkatPublicKey)
		  
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONPublicAttrs, m.loChilkatJSONPublicAttrs, ;
		m.loParkParameterJSONPrivateAttrs, m.loChilkatJSONPrivateAttrs, ;
		m.loParkParameterJSONOut, m.loChilkatJSONOut, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatJSONPublicAttrs = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatJSONPrivateAttrs = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatJSONOut = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatPublicKey  = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loChilkatJSONPublicAttrs = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatJSONPrivateAttrs = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatJSONOut = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatPublicKey  = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loParkParameterJSONPublicAttrs = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterJSONPrivateAttrs = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterJSONOut = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPublicKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE gensecretkey		&& Introduced in version 9.5.0.96. Generates a symmetric encryption key. The keyType is the key type, which can be one of the following values: AES/AES/XTS/Blowfish/Twofish/ChaCha20.
		*==============================================================================
		* Method:            GenSecretKey
		* Purpose:           Generates a symmetric encryption key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyType, the kind of keys to return
		*                    toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		** 
		** Generates a symmetric encryption key. 
		** The keyType is the key type, which can be one of the following values:
		** 
		** AES
		** AES XTS
		** Blowfish
		** Twofish
		** ChaCha20
		** 
		** The jsonTemplate is a template that specifies attributes about the key to be generated. 
		** See the example at the link below.
		** 
		** The handle to the generated key is returned. A value of 0 is returned on failure.
		**
		
		LPARAMETERS tcKeyType AS Character, toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject 
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenSecretKey(m.tcKeyType, m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getcert		&& Introduced in version 9.5.0.88. Loads cert with the Nth certificate indicated by index. The 1st certificate is at index 0. The FindAllCerts method must be called beforehand to load the certs from the smart card into this object.
		*==============================================================================
		* Method:            GetCert
		* Purpose:           Loads cert with the Nth certificate indicated by index.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the certificate index value.
		*                    toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		**
		** Loads cert with the Nth certificate indicated by index. 
		** The 1st certificate is at index 0. The FindAllCerts method must be called 
		** beforehand to load the certs from the smart card into this object. 
		** After calling FindAllCerts, the NumCerts property is set 
		** and each certificate can be retrieved by calling GetCert.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiIndex AS Integer, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetCert(m.tiIndex, m.loChilkatCert) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		  
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

