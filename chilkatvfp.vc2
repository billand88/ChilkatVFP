	PROCEDURE listcerts		&& Introduced in version 9.5.0.87. Lists the certs found on the smart card. The certPart indicates the information to be returned from each certificate. Possible values are: "subjectDN", "subjectDN_withTags", "subjectCN", "serial", or "serial:issuerCN".
		*==============================================================================
		* Method:            ListCerts
		* Purpose:           Lists the certs found on the smart card.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCertPart, the certificate part.
		*                    toChilkatStringTable, a Chilkat String Table object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Lists the certs found on the smart card. The certPart indicates 
		** the information to be returned from each certificate. 
		** Possible values are: "subjectDN", "subjectDN_withTags", "subjectCN", 
		** "serial", or "serial:issuerCN". The information is returned in st.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCertPart AS Character, ;
		toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ListCerts(m.tcCertPart, m.loChilkatStringTable) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = ;
		      m.loParkParameterStringTable.SetObject(m.toChilkatStringTable, m.loChilkatStringTable)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  toChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

