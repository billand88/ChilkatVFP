	PROCEDURE applyfixups		&& Sometimes emails created by other software or systems are not formatted according to typical conventions. This method provides a means to automatically fix certain problems.
		*==============================================================================
		* Method:            ApplyFixups
		* Purpose:           This method provides a means to automatically fix certain formatting problems.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFixups, comma separated list of fixup keywords.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Sometimes emails created by other software or systems are not formatted according to typical conventions. 
		** This method provides a means to automatically fix certain problems.
		**
		** The fixups set to a comma-separated list of keywords that identify the fixups to be applied. 
		** At the moment, there is only one fixup defined ("FixRelated") as described here:
		**
		** FixRelated: Fixes the email so that HTML related items (images for example) 
		** are properly located in the email MIME structure. 
		** This prevents them from being seen as attachments.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFixups AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.ApplyFixups(m.tcFixups) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE aspunpack		&& Write an HTML’s embedded images to a temp directory. The HTML’s IMG tags are updated to reference the temp files. AspUnpack also writes an HTML file to the temp directory (for the purpose of including it in an iframe tag)
		*==============================================================================
		* Method:            ASPUnpack
		* Purpose:           Write an HTML’s embedded images to a temp directory. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPrefix -- All files saved to the tcSaveDirectory 
		*                    will have filenames that begin with this string.
		*                    tcSaveDirectory -- Path of the temp directory on the 
		*                    web server where temporary files are written.
		*                    tcRelativeURLPath -- The relative URL path to be used 
		*                    in the IMG SRC attributes of the modified HTML.
		*                    tuAutoCleanFiles -- Set to 1 to delete all files in tcSaveDirectory 
		*                    having filenames starting with prefix before saving new files. 
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Write an HTML’s embedded images to a temp directory. 
		** The HTML’s IMG tags are updated to reference the temp files. 
		** ASPUnpack also writes an HTML file to the temp directory 
		** (for the purpose of including it in an iframe tag). 
		** ASPUnpack2 returns the modified HTML as utf-8 bytes. 
		**
		** Returns 1 for success, 0 for failure.
		**
		** See https://www.chilkatsoft.com/p/p_503.asp
		**
		** See https://www.chilkatsoft.com/p/p_504.asp
		**
		** tcPrefix -- prefix (String) — All files saved to the saveDir 
		** will have filenames that begin with this string. 
		** If autoCleanFiles = 1, then all files in saveDir beginning with prefix will be deleted 
		** before AspUnpack2 writes new files. This makes it easy to keep the saveDir directory uncluttered. 
		** The prefix provides a mechanism that allows separate 
		** sessions to view different emails simultaneously without colliding.
		**
		** tcSaveDirectory (String) — Path of the temp directory on the web server 
		** where temporary files are written. 
		** Your code should either use an absolute path, or Server.MapPath. 
		** It should be a directory where the ASP worker process has permission to write and create files. 
		** Execute permissions and directory browsing permissions should be turned off.
		**
		** tcRelativeURLPath (String) — The relative URL path to be used 
		** in the IMG SRC attributes of the modified HTML. 
		** This should be the URL path from the ASP page to the files written to saveDir.
		**
		** tiAutoCleanFiles (Long) — Set to 1 to delete all files in saveDir 
		** having filenames starting with prefix before saving new files.
		**
		** Fixed for Version 49: Fixed the method.
		** 
		
		LPARAMETERS tcPrefix AS Character, tcSaveDirectory AS Character, ;
		tcRelativeURLPath AS Character, tuAutoCleanFiles AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liAutoCleanFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liAutoCleanFiles
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liAutoCleanFiles = .LogicalToBit(m.tuAutoCleanFiles)
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.ASPUnpack(m.tcPrefix, m.tcSaveDirectory, m.tcRelativeURLPath, m.liAutoCleanFiles) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE aspunpack2		&& Write an HTML’s embedded images to a temp directory. The HTML’s IMG tags are updated to reference the temp files. AspUnpack also writes an HTML file to the temp directory (for the purpose of including it in an iframe tag)
		*==============================================================================
		* Method:            ASPUnpack2
		* Purpose:           Write an HTML’s embedded images to a temp directory. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPrefix -- All files saved to the tcSaveDirectory 
		*                    will have filenames that begin with this string.
		*                    tcSaveDirectory -- Path of the temp directory on the 
		*                    web server where temporary files are written.
		*                    tcRelativeURLPath -- The relative URL path to be used 
		*                    in the IMG SRC attributes of the modified HTML.
		*                    tuAutoCleanFiles -- Set to 1 to delete all files in tcSaveDirectory 
		*                    having filenames starting with prefix before saving new files. 
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Write an HTML’s embedded images to a temp directory. 
		** The HTML’s IMG tags are updated to reference the temp files. 
		** ASPUnpack also writes an HTML file to the temp directory 
		** (for the purpose of including it in an iframe tag). 
		** ASPUnpack2 returns the modified HTML as utf-8 bytes. 
		**
		** Returns 1 for success, 0 for failure.
		**
		** See https://www.chilkatsoft.com/p/p_503.asp
		**
		** See https://www.chilkatsoft.com/p/p_504.asp
		**
		** tcPrefix -- prefix (String) — All files saved to the saveDir will have filenames that begin with this string. 
		** If autoCleanFiles = 1, then all files in saveDir beginning with prefix will be deleted 
		** before AspUnpack2 writes new files. This makes it easy to keep the saveDir directory uncluttered. 
		** The prefix provides a mechanism that allows separate 
		** sessions to view different emails simultaneously without colliding.
		**
		** tcSaveDirectory (String) — Path of the temp directory on the web server where temporary files are written. 
		** Your code should either use an absolute path, or Server.MapPath. 
		** It should be a directory where the ASP worker process has permission to write and create files. 
		** Execute permissions and directory browsing permissions should be turned off.
		**
		** tcRelativeURLPath (String) — The relative URL path to be used in the IMG SRC attributes of the modified HTML. 
		** This should be the URL path from the ASP page to the files written to saveDir.
		**
		** tiAutoCleanFiles (Long) — Set to 1 to delete all files in saveDir 
		** having filenames starting with prefix before saving new files.
		**
		** Fixed for Version 49: Fixed the method.
		** 
		
		LPARAMETERS tcPrefix AS Character, tcSaveDirectory AS Character, ;
		tcRelativeURLPath AS Character, tuAutoCleanFiles AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liAutoCleanFiles AS Integer, liReturn AS Integer, luReturn AS Unknown, ;
		lqHTML AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqHTML 
		STORE 0 TO m.liAutoCleanFiles, m.liReturn, m.luReturn 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liAutoCleanFiles = .LogicalToBit(m.tuAutoCleanFiles)
		
		    TRY
		
		      lqHTML = m.loChilkatObject.ASPUnpack2(m.tcPrefix, ;
		      m.tcSaveDirectory, m.tcRelativeURLPath, m.liAutoCleanFiles)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqHTML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE attachemail		&& Attaches copy of the email to this email object. The attached email will be encapsulated in an message/rfc822 sub-part. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AttachEmail
		* Purpose:           Attaches copy of the email to this email object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Attaches copy of the email to this email object. 
		** The attached email will be encapsulated in an message/rfc822 sub-part.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterEmail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AttachEmail(m.loChilkatEmail) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

