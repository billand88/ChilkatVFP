	PROCEDURE usessh		&& Introduced in version 9.5.0.51. Uses the SSH connection of sshConnection for the SCP transfers.
		*==============================================================================
		* Method:            UseSSH
		* Purpose:           Uses the SSH connection of sshConnection for the SCP transfers.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSSH, a Chilkat SSH object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		** 
		** Uses the SSH connection of sshConnection for the SCP transfers. 
		** All of the connection and socket related properties, proxy properites, 
		** timeout properties, session log, etc. set on the SSH object apply to the SCP methods 
		** (because internally it is the SSH object that is used to do the work of the file transfers).
		** 
		** Note: There is no UnlockComponent method in the SCP class 
		** because it is the SSH object that must be unlocked. 
		** When the SSH object is not unlocked, this method will return 0 to indicate failure.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSSH AS CHILKAT_SSH_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterSsh AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSsh AS CHILKAT_SSH_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSsh, m.loChilkatSsh
		
		llImplemented = .F.
		liIntroducedInBuild = 51
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSsh = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSsh)
		
		      loChilkatSsh = m.loParkParameterSsh.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseSSH(m.loChilkatSSH) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSsh = ;
		      m.loParkParameterSsh.SetObject(m.toChilkatSsh, m.loChilkatSsh)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSsh, m.loChilkatSsh
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCP_COM_CALL)
		  toChilkatSSH = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loParkParameterSsh = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSsh = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat SCP VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/09/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 51
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS secrets AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides a unified API for managing secrets.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: autosplit_access		&& Access method used to retrieve the Chilkat Secrets AutoSplit property.
		*m: autosplit_assign		&& Assign method used to hold a reference to the AutoSplit property.
		*m: compression_access		&& Access method used to retrieve the Chilkat Secrets Compression property.
		*m: compression_assign		&& Assign method used to hold a reference to the Compression property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Secrets DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deletesecret		&& Introduced in version 10.1.0. Deletes a secret. Cloud secrets managers will typically disable the secret and schedule the secret for deletion after some number of days. Returns 1 for success, 0 for failure.
		*m: deletesecretasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the DeleteSecret method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread
		*m: getsecretbd		&& Introduced in version 10.1.0. Fetches a binary secret and returns the content in bd. Returns 1 for success, 0 for failure.
		*m: getsecretbdasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the GetSecretBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getsecretjson		&& Introduced in version 10.1.0. Fetches a JSON secret and returns the content in jsonOut. Returns 1 for success, 0 for failure.
		*m: getsecretjsonasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the GetSecretJson method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getsecretsb		&& Introduced in version 10.1.0. Fetches a string secret and returns the content in sb. Returns 1 for success, 0 for failure.
		*m: getsecretsbasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the GetSecretSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getsecretstr		&& Introduced in version 10.1.0. Fetches a string secret and returns the content of the secret. Returns Nothing on failure
		*m: getsecretstrasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the GetSecretStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: lastbinaryresult_access		&& Access method used to retrieve the LastBinaryResult property of the referenced Chilkat object.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Secrets LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Secrets LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Secrets LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Secrets LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Secrets LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Secrets LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: listsecrets		&& Introduced in version 10.1.0. Lists secrets matching the wildcarded or exact values passed in json. The results of the query are returned in jsonOut. Returns 1 for success, 0 for failure.
		*m: listsecretsasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the ListSecrets method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: location_access		&& Access method used to retrieve the Chilkat Secrets Location property.
		*m: location_assign		&& Assign method used to hold a reference to the Location property.
		*m: secretspectojson		&& Introduced in version 11.5.0. Converts a secret specification string (secretSpec) to JSON. A secret specification string is formatted as !!part1|part2|part3|part4" where parts 3 and 4 are optional. json is the output argument.
		*m: setbootstrapsecret		&& Introduced in version 10.1.0. Accessing a cloud-based secrets manager requires authentication credentials, which cannot be stored in the manager itself. Instead, they must be securely stored locally.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat Secrets UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: updatesecretbd		&& Introduced in version 10.1.0. Creates a binary secret if it does not yet exist, or updates an existing secret. Returns 1 for success, 0 for failure.
		*m: updatesecretbdasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the UpdateSecretBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: updatesecretjson		&& Introduced in version 10.1.0. Creates a JSON secret if it does not yet exist, or updates an existing secret. The name of the secret is specified in jsonId, and the JSON content of the secret in secret. Returns 1 for success, 0 for failure.
		*m: updatesecretjsonasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the UpdateSecretJson method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: updatesecretsb		&& Introduced in version 10.1.0. Creates a string secret if it does not yet exist, or updates an existing secret. The name of the secret is specified in jsonId, and the string content of the secret in sb. Returns 1 for success, 0 for failure.
		*m: updatesecretsbasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the UpdateSecretSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: updatesecretstr		&& Introduced in version 10.1.0. Creates a string secret if it does not yet exist, or updates an existing secret. The name of the secret is specified in jsonId, and the string content of the secret in secret. Returns 1 for success, 0 for failure.
		*m: updatesecretstrasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the UpdateSecretStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Secrets VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the Secrets VerboseLogging property.
		*p: autosplit		&& Introduced in version 10.1.0. The AutoSplit property is specific to "local_manager" secrets on Windows. The Windows Credentials Manager supports a maximum of 2560 bytes per secret.
		*p: compression		&& Introduced in version 10.1.0. If set to 1, then the contents of the secret will be stored compressed. The default value of this property is 0.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Indicates whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Access method used to retrieve the Chilkat Secrets LastStringResultLen property.
		*p: location		&& Introduced in version 10.1.0. The location of the secrets. The default location is the "local_manager".
		*p: uncommonoptions		&& Introduced in version 10.1.0. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		autosplit = 1
		cchilkatclass = Secrets
		ceventhandlerclass = iBaseEventHandler
		compression = 0
		debuglogfilepath = 
		iinstancemajor = 10
		iinstanceminor = 1
		lastbinaryresult = NULL
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		location = local_manager
		Name = "secrets"
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE autosplit_access		&& Access method used to retrieve the Chilkat Secrets AutoSplit property.
		*==============================================================================
		* Method:            AutoSplit_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Secrets AutoSplit property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoSplit
		* Date Added:        12/26/2024
		*==============================================================================
		
		**  
		** Introduced in version 10.1.0
		**
		** The AutoSplit property is specific to "local_manager" secrets on Windows. 
		** The Windows Credentials Manager supports a maximum of 2560 bytes per secret. 
		** If a secret exceeds this size, it will be automatically compressed 
		** and split when created or updated, and automatically recomposed when retrieved.
		** 
		** A secret can be split into a maximum of 10 parts.
		**
		** The default value is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, ;
		m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autosplit_assign		&& Assign method used to hold a reference to the AutoSplit property.
		*==============================================================================
		* Method:            AutoSplit_Assign
		* Purpose:           Assign method used to hold a reference to the AutoSplit property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoSplit property.
		* Returns:           
		* Date Added:        12/26/2024
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild(3, 1)
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/10/2025
		*==============================================================================
		
		#IF .F.
		
		** Version 11.3.0
		
		  Starting in Chilkat version 11.3.0, if the service = "Chilkat" and the username = "unlock_code", 
		  then the secret (which is the Chilkat unlock code) can be stored and retrieved without Chilkat being unlocked. 
		
		** Version 11.2.0
		
		  Fixed the “The data exceeds the maximum size of a secret (CredentialBlob) 
		  in the Windows Credentials Manager.” error, which occurred on some older Windows systems.
		
		** Version 10.1.0
		
		  Secrets: A new class, Chilkat.Secrets, is added to v10.1.0.  
		  It provides a unified API to manage secrets in the following locations:
		
		    “local_manager” – On Windows this is the Credentials Manager. On MacOS and iOS it is the Keychain. 
		      This is not yet an option on Linux or Android.
		    “aws_secrets_manager” – AWS Secrets Manager
		    “azure_key_vault” – Azure Key Vault
		    “ibm_cloud” – IBM Cloud Secrets Manager
		    “oracle_cloud” – Oracle Cloud Secrets
		    “doppler” – Doppler Secrets
		    “memory” – In-Memory Secrets
		
		TEXT
		
		#ENDIF .F.
		
	ENDPROC

