	PROCEDURE qencodecontent		&& Sets the node's content with 8bit data that is in a specified multibyte character encoding such as utf-8, shift-jis, big5, etc. The data is first Q-encoded and the content is set to be the Q-encoded string.
		*==============================================================================
		* Method:            QEncodeContent
		* Purpose:           Sets the node's content with 8bit data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset -- the charset to encode with
		*                    tqData -- the data to encode.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Sets the node's content with 8bit data that is in a specified 
		** multibyte character encoding such as utf-8, shift-jis, big5, etc. 
		** The data is first Q-encoded and the content is set to be the Q-encoded string. 
		*** For example, if called with "gb2312"for the charset, 
		** you would get a string that looks something like this: 
		** "=?gb2312?Q?=C5=B5=BB=F9?=". Character that are not 7bit are represented 
		** as "=XX" where XX is the hexidecimal value of the byte. 
		** Use the DecodeContent method to retrieve the byte data from a Q encoded string.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCharset AS Character, tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.QEncodeContent(m.tcCharset, m.tqData) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

