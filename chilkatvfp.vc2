		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS csp AS ibasechilkat OF "chilkatvfp.vcx" 		&& Note: This class is decremented and should no longer be used. Represents a cryptographic service provider for selecting encryption, hashing, and digital signing algorithms. This class is specific to the Windows operating system.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat CSP DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: encryptalgorithmid_access		&& Access method used to retrieve the Chilkat CSP EncryptAlgorithmID property.
		*m: encryptalgorithmid_assign		&& Assign method used to hold a reference to the EnrcyptAlgorithmID property.
		*m: encryptalgorithm_access		&& Access method used to retrieve the Chilkat CSP EncryptAlgorithm property.
		*m: encryptalgorithm_assign		&& Assign method used to hold a reference to the EnrcyptAlgorithm property.
		*m: encryptnumbits_access		&& Access method used to retrieve the Chilkat CSP EncryptNumBits property.
		*m: encryptnumbits_assign		&& Assign method used to hold a reference to the EnrcyptNumBits property.
		*m: getkeycontainernames		&& Undocumented method! Assumed to do what the name suggests.
		*m: hasencryptalgorithm		&& Returns true if the currently selected CSP contains an encryption algorithm matching the name and key length. Otherwise returns false.
		*m: hashalgorithmid_access		&& Access method used to retrieve the Chilkat CSP HashAlgorithmID property.
		*m: hashalgorithmid_assign		&& Assign method used to hold a reference to the HashAlgorithmID property.
		*m: hashalgorithm_access		&& Access method used to retrieve the Chilkat CSP HashAlgorithm property.
		*m: hashalgorithm_assign		&& Assign method used to hold a reference to the HashAlgorithm property.
		*m: hashashalgorithm		&& Returns 1 if the currently selected CSP contains a hash algorithm matching the name and bit length. Otherwise returns 0
		*m: hashnumbits_access		&& Access method used to retrieve the Chilkat CSP HashNumBits property.
		*m: hashnumbits_assign		&& Assign method used to hold a reference to the HashNumBits property.
		*m: initialize		&& Intializes the Csp with the selected ProviderName.
		*m: keycontainername_access		&& Access method used to retrieve the Chilkat CSP KeyContainerName property.
		*m: keycontainername_assign		&& Assign method used to hold a reference to the KeyContainerName property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat CSP LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat CSP LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat CSP LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat CSP LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat CSP LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat CSP LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat CSP LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: machinekeyset_access		&& Access method used to retrieve the Chilkat CSP MachineKeySet property.
		*m: machinekeyset_assign		&& Assign method used to hold a reference to the MachineKeySet property.
		*m: nthencryptionalgorithm		&& Returns the name of the Nth encryption algorithm provided by the currently selected CSP. Indexing begins at 0. Returns Nothing on failure
		*m: nthencryptionnumbits		&& Returns the key-length of the currently selected encryption algorithm in the currently selected CSP.
		*m: nthhashalgorithmname		&& To be documented soon...Returns Nothing on failure
		*m: nthhashnumbits		&& Returns the bit length of the Nth hash algorithm provided by the currently selected CSP. Indexing begins at 0.
		*m: nthkeycontainername		&& Returns the Nth key container name in the currently selected CSP. Indexing begins at 0. Returns Nothing on failure
		*m: nthkeyexchangealgorithm		&& Returns the Nth key exchange algorithm provided by the currently selected CSP. Indexing begins at 0. Returns Nothing on failure
		*m: nthkeyexchangenumbits		&& Returns the bit length of the Nth key exchange algorithm provided by the currently selected CSP. Indexing begins at 0.
		*m: nthsignaturealgorithm		&& Returns the name of the Nth signature algorithm provided by the currently selected CSP. Indexing begins at 0. Returns Nothing on failure
		*m: nthsignaturenumbits		&& Returns the bit length of the Nth signature algorithm provided by the currently selected CSP. Indexing begins at 0.
		*m: numencryptalgorithms_access		&& Access method used to retrieve the Chilkat CSP NumEncryptAlgorithms property.
		*m: numencryptalgorithms_assign		&& Assign method used to hold a reference to the NumEncryptAlgorithms property.
		*m: numhashalgorithms_access		&& Access method used to retrieve the Chilkat CSP NumHashAlgorithms property.
		*m: numhashalgorithms_assign		&& Assign method used to hold a reference to the NumHashAlgorithms property.
		*m: numkeycontainers_access		&& Access method used to retrieve the Chilkat CSP NumKeyContainers property.
		*m: numkeycontainers_assign		&& Assign method used to hold a reference to the NumKeyContainers property.
		*m: numkeyexchangealgorithms_access		&& Access method used to retrieve the Chilkat CSP NumKeyExchangeAlgorithms property.
		*m: numkeyexchangealgorithms_assign		&& Assign method used to hold a reference to the NumKeyExchangeAlgorithms property.
		*m: numsignaturealgorithms_access		&& Access method used to retrieve the Chilkat CSP NumSignatureAlgorithms property.
		*m: numsignaturealgorithms_assign		&& Assign method used to hold a reference to the NumSIgnatureAlgorithms property.
		*m: providername_access		&& Access method used to retrieve the Chilkat CSP ProviderName property.
		*m: providername_assign		&& Assign method used to hold a reference to the ProviderName property.
		*m: providertype_access		&& Access method used to retrieve the Chilkat CSP ProviderType property.
		*m: providertype_assign		&& Assign method used to hold a reference to the ProviderType property.
		*m: setencryptalgorithm		&& Selects an encryption algorithm. The return value is the key-length of the algorithm. If the algorithm is not available, the return value is 0.
		*m: sethashalgorithm		&& Selects a hash algorithm. The return value is the bit-length of the algorithm. If the algorithm is not available, the return value is 0.
		*m: setprovidermicrosoftbase		&& Undocumented method! Sets the CSP to the Base Microsoft Cryptographic Provider, which is the default.
		*m: setprovidermicrosoftenhanced		&& Undocumented method! Sets the CSP to the Enhanced Microsoft Cryptographic Provider.
		*m: setprovidermicrosoftrsaaes		&& Undocumented method! Sets the CSP to the Microsoft Cryptographic RSA/AES Prototype Provider.
		*m: setprovidermicrosoftstrong		&& Undocumented method! Sets the CSP to the Strong Microsoft Cryptographic Provider.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat CSP UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat CSP VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: encryptalgorithm		&& Returns the name of the currently selected encryption algorithm in the currently selected CSP.
		*p: encryptalgorithmid		&& Returns the ID of the currently selected encryption algorithm in the currently selected CSP.
		*p: encryptnumbits		&& Returns the key-length of the currently selected encryption algorithm in the currently selected CSP.
		*p: hashalgorithm		&& Returns the name of the currently selected hash algorithm in the currently selected CSP.
		*p: hashalgorithmid		&& Returns the ID of the currently selected hash algorithm in the currently selected CSP.
		*p: hashnumbits		&& Returns the bit length of the currently selected hash algorithm in the currently selected CSP.
		*p: keycontainername		&& Undocumented property! Assumed to retrieve the key container name.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: machinekeyset		&& Undocumented property!
		*p: numencryptalgorithms		&& The number of encryption algorithms provided by the currently selected CSP.
		*p: numhashalgorithms		&& The number of hash algorithms provided by the currently selected CSP.
		*p: numkeycontainers		&& The number of key containers provided by the currently selected CSP.
		*p: numkeyexchangealgorithms		&& The number of key exchange algorithms provided by the currently selected CSP.
		*p: numsignaturealgorithms		&& The number of signature algorithms provided by the currently selected CSP.
		*p: providername		&& The currently selected CSP. To select another CSP, simply set this property to the name of the CSP, such as "Microsoft Enhanced Cryptographic Provider v1.0". If the CSP is not available on your machine, the property value will not change.
		*p: providertype		&& This is an integer representing the type of CSP. (Chilkat uses it for internal use.)
		*p: uncommonoptions		&& Introduced in version 9.5.0.83. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Csp
		debuglogfilepath = 
		encryptalgorithm = 
		encryptalgorithmid = 
		encryptnumbits = 0
		hashalgorithm = 
		hashalgorithmid = 0
		hashnumbits = 0
		iretirementmajor = 11
		keycontainername = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		machinekeyset = 0
		Name = "csp"
		numencryptalgorithms = 0
		numhashalgorithms = 0
		numkeycontainers = 0
		numkeyexchangealgorithms = 0
		numsignaturealgorithms = 0
		providername = Microsoft Base Cryptographic Provider v1.0
		providertype = 0
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		Class removed.
		
		** Version 95
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		** Version 83
		
		  Added the SHA3 hash algorithms: sha3-224, sha3-256, sha3-384, sha3-512.
		  The SHA3 hash algorithms may generally be used in any property or method
		  of any Chilkat class where a hash algorithm is specified.
		
		** Version 77
		
		  Added the GetProviders method.
		
		  Added the LoadSmartcardCert method.
		
		  Added the LoadFromSmartcard method.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat CSP DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSP DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/11/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

