	PROCEDURE deletemultiple		&& Marks multiple emails on the POP3 server for deletion. (Any email on the server having a UIDL equal to a UIDL found in uidlArray is marked for deletion.) To complete the deletion of the emails, a "QUIT" message must be sent and the POP3 session ended.
		*==============================================================================
		* Method:            DeleteMultiple
		* Purpose:           Marks multiple emails on the POP3 server for deletion. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringArray, a Chilkat String Array object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** Marks multiple emails on the POP3 server for deletion. 
		** (Any email on the server having a UIDL equal to a UIDL found in uidlArray is marked for deletion.) 
		** To complete the deletion of the emails, a "QUIT" message must be sent and the POP3 session ended. 
		** This will happen automatically when the ImmediateDelete property equals 1, which is the default. 
		** If ImmediateDelete equals 0, then the Pop3EndSession method can be called to send the "QUIT" 
		** and end the session (i.e. disconnect.)
		**
		** Note: When making multiple calls to a Delete* method, it's best to turn off ImmediateDelete, 
		** and then manually call Pop3EndSession to finalize the deletions.
		**
		** Also, any method call requiring communication with the POP3 server will automatically 
		** re-establish a session based on the current property settings.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		     loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.DeleteMultiple(m.loChilkatStringArray) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatStringArray = m.loParkParameterStringArray.SetObject(;
		    m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE deletemultipleasync		&& Creates an asynchronous task to call the DeleteMultiple method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
