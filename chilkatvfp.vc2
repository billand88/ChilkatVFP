	PROCEDURE strcomp		&& Lexicographically compares two strings. Returns 0 if both strings are equal.
		*==============================================================================
		* Method:            StrComp
		* Purpose:           Lexicographically compares two strings.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the string to compare.
		*                    tuCaseSensitive, whether or not the search is case sensitive.
		* Returns:           The comparison status value.
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Lexicographically compares two strings. Returns 0 if both strings are equal. 
		** A value greater than zero indicates that the first character 
		** that does not match has a greater value in the caller's string than in str; 
		** And a value less than zero indicates the opposite.
		** 
		
		LPARAMETERS tcString AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, liComparisonStatus AS Integer, ;
		liCaseSensitive AS Integer
		
		STORE 0 TO m.liComparisonStatus, m.liCaseSensitive
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    TRY
		
		      liComparisonStatus = m.loChilkatObject.StrComp(m.tcString, m.liCaseSensitive)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liComparisonStatus
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

