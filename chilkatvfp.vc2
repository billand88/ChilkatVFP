	HIDDEN PROCEDURE enablecache_access		&& Access method used to retrieve the Chilkat SFTP EnableCache property.
		*==============================================================================
		* Method:            EnableCache_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP EnableCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EnableCache
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Controls whether the component keeps an internal file size & attribute cache. 
		** The cache affects the following methods: GetFileSize32, GetFileSize64, 
		** GetFileSizeStr, GetFileCreateTime, GetFileLastAccess, GetFileLastModified, 
		** GetFileOwner, GetFileGroup, and GetFilePermissions.
		**
		** The file attribute cache exists to minimize communications with the SFTP server. 
		** If the cache is enabled, then a request for any single attribute will cause 
		** all of the attributes to be cached. 
		** A subsequent request for a different attribute of the same file will be fulfilled from cache, 
		** eliminating the need for a message to be sent to the SFTP server.
		**
		** Note: Caching only occurs when filenames are used, not handles.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE enablecache_assign		&& Assign method used to hold a reference to the EnableCache property.
		*==============================================================================
		* Method:            EnableCache_Assign
		* Purpose:           Assign method used to hold a reference to the EnableCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the EnableCache property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE enablecompression_access		&& Access method used to retrieve the Chilkat SFTP EnableCompression property.
		*==============================================================================
		* Method:            EnableCompression_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP EnableCompression property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EnableCompression
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Enables or disables the use of compression w/ the SSH connection. The default value is 0.
		**
		** Some older SSH servers have been found that claim to support compression, 
		** but actually fail when compression is used. PuTTY does not enable compression by default. 
		** If trouble is encountered where the SSH server disconnects immediately 
		** after the connection is seemingly established (i.e. during authentication), 
		** then check to see if disabling compression resolves the problem.
		**
		** Change for version 82: Default is changed to false because some servers fail 
		** with compression enabled, and in other cases performance is slower with compression enabled. 
		** (Yet in other cases, it’s possible that performance is better with compression enabled — 
		** it entirely has to do with the compressibility of the data being sent/received.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE enablecompression_assign		&& Assign method used to hold a reference to the EnableCompression property.
		*==============================================================================
		* Method:            EnableCompression_Assign
		* Purpose:           Assign method used to hold a reference to the EnableCompression property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the EnableCompression property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE enablesecrets_access		&& Access method used to retrieve the Chilkat SFTP EnableSecrets property.
		*==============================================================================
		* Method:            EnableSecrets_Access
		* Purpose:           Access method used to retrieve 
		*                    the EnableSecrets property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EnableSecrets
		* Date Added:        06/02/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		** 
		** This property that automatic resolution of credentials from the operating system’s secure storage.
		**
		** When set to 1, the supported properties and methods (listed below) 
		** can accept a secret specification string (beginning with !!) in place of a literal value. 
		** Chilkat detects this format and retrieves the corresponding secret from:
		** 
		** Windows Credential Manager (Windows)
		** Apple Keychain (macOS)
		** Secrets are identified using a structured string format: !![appName|]service[|domain]|username
		** 
		** Applies to HttpProxyPassword, SocksPassword, AuthenticatePw, AuthenticatePwPk
		** 
		** This feature allows applications to avoid embedding sensitive data 
		** directly in code by securely resolving credentials at runtime.
		** 
		** The default value is 0
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*==============================================================================
		* Method:            EnableSecrets_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the EnableSecrets property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the EnableSecrets property.
		* Returns:           
		* Date Added:        06/02/2026
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE eof		&& Returns 1 if the last read operation for a handle reached the end of file. Otherwise returns 0. If an invalid handle is passed, a value of 1 is returned.
		*==============================================================================
		* Method:            EOF
		* Purpose:           Returns 1 if the last read operation 
		*                    for a handle reached the end of file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/20/2022
		*==============================================================================
		
		**
		** Returns 1 if the last read operation for a handle reached the end of file. 
		** Otherwise returns 0. If an invalid handle is passed, a value of 1 is returned.
		**
		
		LPARAMETERS tcHandle AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.EOF(m.tcHandle) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fileexists		&& Introduced in version 9.5.0.67. Returns a value to indicate whether the remote file exists or not. remotePath is the path of the remote file. If followLinks is 1, then symbolic links will be followed on the server.
		*==============================================================================
		* Method:            FileExists
		* Purpose:           Returns a value to indicate whether the remote file exists or not.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePath -- the remote path to the file
		*                    tuFollowLinks, whether or not server symbolic links are followed.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** Returns a value to indicate whether the remote file exists or not. 
		** remotePath is the path of the remote file. 
		** If followLinks is 1, then symbolic links will be followed on the server.
		**
		** This method returns one of the following possible values:
		**
		** -1: Unable to check. Examine the LastErrorText to determine the reason for failure.
		** 0: File does not exist.
		** 1: The regular file exists.
		** 2: It exists, but it is a directory.
		** 3: It exists, but it is a symlink (only possible if followLinks is 0)
		** 4: It exists, but it is a special filesystem entry type.
		** 5: It exists, but it is an unkown filesystem entry type.
		** 6: It exists, but it is an socket filesystem entry type.
		** 7: It exists, but it is an char device entry type.
		** 8: It exists, but it is an block device entry type.
		** 9: It exists, but it is an FIFO entry type.
		** 
		** Note: The values greater than zero correspond 
		** to the possible values as specified in the SFTP protocol specification. 
		** A given value may not make sense on all operating systems.
		**
		
		LPARAMETERS tcRemotePath AS Character, tuFollowLinks AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liFollowLinks AS Integer, liFileStatus AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liFollowLinks, m.liFileStatus 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
