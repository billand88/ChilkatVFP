		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE parseocspreply		&& Parses an OCSP reply.
		*==============================================================================
		* Method:            ParseOCSPReply
		* Purpose:           Parses an OCSP reply.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		*                    toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Numeric
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.75
		**
		** Parses an OCSP reply. Returns the following possible integer values:
		**
		** -1: The ocspReply does not contain a valid OCSP reply.
		** 0: Successful - Response has valid confirmations..
		** 1: Malformed request - Illegal confirmation request.
		** 2: Internal error - Internal error in issuer.
		** 3: Try later - Try again later.
		** 4: Not used - This value is never returned.
		** 5: Sig required - Must sign the request.
		** 6: Unauthorized - Request unauthorized.
		**
		** The binaryOCSP reply is provided in ocspReply. 
		** The replyData is populated with data parsed from ocspReply.
		**
		** Fixed for version 79: In some cases, the method returned JSON where information was missing/incorrect. 
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJsonObject, ;
		m.loParkParameterBinData, m.loChilkatJsonObject, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 75
		
		WITH this
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        liReturn = ;
		        m.loChilkatObject.ParseOCSPReply(m.loChilkatBinData, m.loChilkatJsonObject)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJsonObject, ;
		m.loParkParameterBinData, m.loChilkatJsonObject, m.loChilkatBinData
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE password_access		&& Access method used to retrieve the Chilkat HTTP Password property.
		*==============================================================================
		* Method:            Password_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP Password property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Password
		* Date Added:        01/28/2022
		*==============================================================================
		
		** 
		** The HTTP password for pages requiring a login/password. 
		** Chilkat HTTP can do Basic, Digest, and NTLM HTTP authentication. 
		** (NTLM is also known as SPA (or Windows Integrated Authentication). 
		** To use Basic authentication, the BasicAuth property must be set equal to 1. 
		** It is not necessary to set the NtlmAuth or DigestAuth properties 
		** beforehand if NTLM or Digest authentication is needed. 
		** However, it is most efficient to pre-set these properties 
		** when the type of authentication is known in advance.
		**
		** Note: When the Login and Password properties are set, 
		** and the type of authentication is specified by setting 
		** one of the following properties equal to 1 (BasicAuth, DigestAuth, NtlmAuth), 
		** Chilkat will automatically add the "Authorization: ..." header in the correct format.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE password_assign		&& Assign method used to hold a reference to the Password property.
		*==============================================================================
		* Method:            Password_Assign
		* Purpose:           Assign method used to hold a reference to the Password property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Password property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE pbinary		&& Sends an HTTP request to the url. The verb can be "POST", "PUT", "PATCH", etc. The body of the HTTP request contains the bytes passed in byteData. The contentType is a content type such as "image/gif", "application/pdf", etc.
		*==============================================================================
		* Method:            PBinary
		* Purpose:           Sends an HTTP request to the url.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb, the operation to run.
		*                    tcURL, the URL to receive the request. 
		*                    tqBinData, the HTTP body request.
		*                    tcContentType, the content type of the request.
		*                    tuMD5Header, set to 1 to add MD5 header to tqBinData.
		*                    tuGZip, set to 1 if tqBinData is gZip compressed.
		* Returns:           Chilkat HTTP Response Object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.45
		**
		** Sends an HTTP request to the url. 
		** The verb can be "POST", "PUT", "PATCH", etc. 
		** The body of the HTTP request contains the bytes passed in byteData. 
		** The contentType is a content type such as "image/gif", "application/pdf", etc. 
		** If md5 is 1, then a Content-MD5 header is added with the base64 MD5 hash of the byteData. 
		** Servers aware of the Content-MD5 header will perform 
		** a message integrity check to ensure that the data has not been corrupted. 
		** If gzip is 1, the byteData is compressed using the gzip algorithm. 
		** The HTTP request body will contain the GZIP compressed data, 
		** and a "Content-Encoding: gzip" header is automatically added 
		** to indicate that the request data needs to be ungzipped when received (at the server).
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Starting in version 97: 
		**
		** If the HTTP verb is “OPTIONS”, then Chilkat will now allow for the path to be “*”. 
		** Previously, Chilkat forced the path in the HTTP start line to begin with a “/”. 
		** Also, when the HTTP verb is OPTIONS, no “Content-Length” header
		** will be included in the request.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character, tqBinData AS Variant, ;
		tcContentType AS Character, tuMD5Header AS Unknown, tuGZip AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liMD5Header AS Integer, liGZip AS Integer, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE 0 TO m.liMD5Header, m.liGZip, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse
		
		llImplemented = .F.
		liIntroducedInBuild = 45
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		     liMD5Header = .LogicalToBit(m.tuMD5Header)
		     liGZip = .LogicalToBit(m.tuGZip)
		
		      TRY
		
		        loChilkatHTTPResponse = m.loChilkatObject.PBinary(;
		        m.tcVerb, m.tcURL, m.tqBinData, m.tcContentType, m.liMD5Header, m.liGZip)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE pbinaryasync		&& Creates an asynchronous task to call the PBinary method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
