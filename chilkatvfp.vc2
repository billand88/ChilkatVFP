	PROCEDURE savetext		&& Convenience method for saving the contents of a string variable to a file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SaveText
		* Purpose:           Convenience method for saving 
		*                    the contents of a string variable to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyString -- Contains the contents of the private key.
		*                    tcFileName -- the file to save the string to.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Convenience method for saving the contents of a string variable to a file.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcStringToSave AS Character, tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      STORE m.loChilkatObject.SaveText(m.tcStringToSave, m.tcFileName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE toopensshprivatekey		&& Exports the private key to a string in OpenSSH format. If bEncrypt is 1, the key is encrypted using the value of the Password property. Below are samples of RSA and DSA private keys in OpenSSH format, both encrypted and unencrypted:
		*==============================================================================
		* Method:            ToOpenSSHPrivateKey
		* Purpose:           Exports the private key to a string in OpenSSH format. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuEncrypt -- the key is encrypted 
		*                    using the value of the Password property. 
		* Returns:           An SSH formatted string.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Exports the private key to a string in OpenSSH format. 
		** If bEncrypt is 1, the key is encrypted using the value of the Password property. 
		** Below are samples of RSA and DSA private keys in OpenSSH format, 
		** both encrypted and unencrypted:
		** 
		** Encrypted OpenSSH DSA Key
		** 
		** -----BEGIN DSA PRIVATE KEY-----
		** 
		** Proc-Type: 4,ENCRYPTED
		** DEK-Info: DES-EDE3-CBC,934E999D91EFE8F8
		** 
		** j1sslF86hdpzaBdVeLZ9akXux+CEaa6HyZgou3BkRkWpMn7gFqX3lfRIjrlhY41w
