	ENDPROC

	PROCEDURE addnocompressextension		&& Attempting to compress already-compressed data is usually a waste of CPU cycles with little or no benefit. In fact, it is possible that attempting to compress already-compressed data results in a slightly increased size.
		*==============================================================================
		* Method:            AddNoCompressExtension
		* Purpose:           See full explanation.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileExtension -- the extension to suppress compression.
		* Returns:           
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** Attempting to compress already-compressed data is usually a waste 
		** of CPU cycles with little or no benefit. 
		** In fact, it is possible that attempting to compress already-compressed 
		** data results in a slightly increased size. 
		** The Zip file format allows for files to be "stored" rather than compressed. 
		** This allows the file data to be streamed directly into a .zip without compression.
		** 
		** An instance of the Zip object has an internal list of "no compress" extensions. 
		** A filename with a "no compress" extension is "stored" rather than compressed. 
		** Additional "no compress" extensions may be added by calling this method 
		** (once per file extension). You should pass the file extension, 
		** such as ".xyz" in fileExtension.
		** 
		** "no compress" extensions may be removed by calling RemoveNoCompressExtension.
		** 
		** The default "no compress" extensions are: 
		** .zip, .gif, .jpg, .gz, .rar, .jar, .tgz, .bz2, .z, .rpm, .msi, .png
		** 
		
		LPARAMETERS tcFileExtension AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddNoCompressExtension(m.tcFileExtension)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addsb		&& Introduced in version 11.0.0. The content of sb is added as a new entry to this object, using its byte representation based on the specified charset. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddSb
		* Purpose:           The content of sb is added as a new entry to this object, ;
		*                    using its byte representation based on the specified charset.
		* Author:            Bill Anderson
