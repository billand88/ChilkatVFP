		RETURN
	ENDPROC

	PROCEDURE removequickheader		&& Undocumented method! Adds a custom header field to any HTTP request sent by a method that does not use the HTTP request object.
		*==============================================================================
		* Method:            RemoveQuickHeader
		* Purpose:           Undocumented method! See SetRequestHeader method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeaderName -- the custom header name
		*                    tcLocalFilePath -- the custom header value
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented method!
		** 
		** Adds a custom header field to any HTTP request sent by a method that does not
		** use the HTTP request object. These methods include Download, DownloadAppend,
		** GetHead, PostBinary, PostMime, PostXml, PutBinary, PutText, QuickDeleteStr,
		** QuickGet, QuickGetObj, QuickGetStr, QuickPutStr, XmlRpc, and XmlRpcPut.
		** 
		** Cookies may be explictly added by calling this method passing "Cookie" for the
		** headerFieldName.
		** 
		** The RemoveQuickHeader method can be called to remove a custom header.
		** 
		** * Note: This method is decremented. It is identical to the SetRequestHeader
		** method. The SetRequestHeader method should be called instead because
		** AddQuickHeader will be removed in a future version.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHeaderName AS Character, tcHeaderValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.RemoveQuickHeader(m.tcHeaderName, m.tcHeaderValue) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE removerequestheader		&& Removes a header from the internal list of custom header field name/value pairs to be automatically added when HTTP requests are sent via methods that do not use the HTTP request object.
		*==============================================================================
		* Method:            RemoveRequestHeader
		* Purpose:           Removes a header from the internal list 
		*                    of custom header field name/value pairs.
