	PROCEDURE fileseek		&& Sets the file pointer for the currently open file. The offset is an offset in bytes from the origin.
		*==============================================================================
		* Method:            FileSeek
		* Purpose:           Sets the file pointer for the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiOffset, the file offset
		*                    tiOffsetOrigin, the offset origin status value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Sets the file pointer for the currently open file. 
		** The offset is an offset in bytes from the origin. 
		** The origin can be one of the following:
		** 
		**   0 = Offset is from beginning of file.
		**   1 = Offset is from current position of file pointer.
		**   2 = Offset is from the end-of-file (offset may be negative).
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiOffset AS Integer, tiOffsetOrigin AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.FileSeek(m.tiOffset, m.tiOffsetOrigin) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE filesize		&& Returns the size, in bytes, of a file. Returns -1 for failure. Note: This method returns a signed 32-bit integer, which is not large enough to handle files greater than 2GB in size.
		*==============================================================================
