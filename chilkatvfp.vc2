	PROCEDURE getmodelsasync		&& Introduced in version 11.2.0. Creates an asynchronous task to call the GetModels method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetModelsAsync
		* Purpose:           Creates an asynchronous task to call the GetModels 
		*                    method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringTable, a Chilkat StringTable object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** Introduced in version 11.2.0.
		**
		** Creates an asynchronous task to call the GetModels method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatStringTable AS [Chilkat.StringTable]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS [Chilkat.StringTable], loChilkatTask AS [Chilkat.Task]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable, m.loChilkatTask
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 2, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.GetModelsAsync(m.loChilkatStringTable)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = ;
		      m.loParkParameterStringTable.SetObject(m.toChilkatStringTable, m.loChilkatStringTable)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatStringTable = NEWOBJECT([Chilkat.StringTable])
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT([Chilkat.StringTable])
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

