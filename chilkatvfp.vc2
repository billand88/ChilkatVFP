	PROCEDURE waitforchannelmessage		&& Introduced in version 9.5.0.48. The pollTimeoutMs is the number of milliseconds to wait. To poll, pass a value of 0 in pollTimeoutMs. Waits for an incoming message on any channel. This includes data, EOF, CLOSE, etc.
		*==============================================================================
		* Method:            WaitForChannelMessage
		* Purpose:           The pollTimeoutMs is the number of milliseconds to wait.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiTimeoutMs, the polling timeout, in milliseconds.
		* Returns:           The completed command channel.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.48
		**
		** The pollTimeoutMs is the number of milliseconds to wait. 
		** To poll, pass a value of 0 in pollTimeoutMs. Waits for an incoming message on any channel. 
		** This includes data, EOF, CLOSE, etc. If a message arrives in the alotted time, 
		** the channel number is returned. A value of -1 is returned for a timeout, 
		** and -2 for any other errors such as if the connection is lost.
		**
		** Note: If a channel number is returned, the message must still be read 
		** by calling a method such as ChannelRead, ChannelReceiveUntilMatch, etc. 
		** Once the message is actually received, it may be collected by calling 
		** GetReceivedText, GetReceivedData, etc.
		**
		
		LPARAMETERS tiTimeoutMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, ;
		loException AS Exception, liChannel AS Integer
		
		STORE 0 TO m.liChannel, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 48
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liChannel = m.loChilkatObject.WaitForChannelMessage(m.tiTimeoutMs)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liChannel
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE waitforchannelmessageasync		&& Introduced in version 9.5.0.48. Creates an asynchronous task to call the WaitForChannelMessage method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            WaitForChannelMessageAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    WaitForChannelMessage method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiTimeoutMs, the polling timeout, in milliseconds.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.48
		**
		** Creates an asynchronous task to call the WaitForChannelMessage method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiTimeoutMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 48
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.WaitForChannelMessageAsync(m.tiTimeoutMs)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS sshkey AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides the ability to read and write Putty and OpenSSH format public and private keys. Supports both DSA and RSA keys. Able to generate new keys. Encryption/decryption of keys is supported. Can convert to/from Putty OpenSSH, and XML formats.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: comment_access		&& Access method used to retrieve the Chilkat SSHKey Comment property.
		*m: comment_assign		&& Assign method used to hold a reference to the Comment property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SSHKey DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: fromopensshprivatekey		&& Loads an SSH key from an OpenSSH private-key file format. If the key is encrypted, set the Password property prior to calling this method.
		*m: fromopensshpublickey		&& Loads an OpenSSH public-key from an OpenSSH formatted public-key. Note: keyStr is not a filename -- it should contain the contents of the OpenSSH formatted public key.
		*m: fromputtyprivatekey		&& Loads an SSH key from a PuTTY private-key file format. If the key is encrypted, set the Password property prior to calling this method. Note: keyStr is not a filename -- it should contain the contents of the PuTTY formatted private key.
		*m: fromrfc4716publickey		&& Loads an SSH public key from an RFC 4716 format. Note: keyStr is not a filename -- it should contain the contents of the PuTTY formatted public key.
		*m: fromxml		&& Loads an SSH key from XML. Note: xmlKey is not a filename -- it should contain the contents of the XML SSH key. To load from a file, you may first call LoadText to load the complete contents of a text file into a string.
		*m: generatedsakey		&& Generates a new SSH DSA key that is numBits bits in length. The numBits should be at least 1024 bits and a multiple of 64. Typical values are 1024 and 2048. Returns 1 for success, 0 for failure.
		*m: generateecdsakey		&& Introduced in version 9.5.0.83. Generates an ECDSA (ECC) private key. The curveName specifies the curve name which determines the key size.
		*m: generateed25519key		&& Introduced in version 9.5.0.83. Generates a new ED25519 public/private key pair. Returns 1 for success, 0 for failure.
		*m: generatersakey		&& Generates a new RSA public/private key pair. The numBits can range from 384 to 4096. Typical key lengths are 1024 or 2048 bits. After successful generation, the public/private keys can be exported in OpenSSH or PuTTY format.
		*m: genfingerprint		&& Generates a fingerpring for an SSH key. A sample fingerprint looks like this: ssh-dss 2048  d0:5f:f7:d6:49:60:7b:50:19:f4:41:59:d4:1f:61:7a
		*m: isdsakey_access		&& Access method used to retrieve the Chilkat SSHKey IsDSAKey property.
		*m: isdsakey_assign		&& Assign method used to hold a reference to the IsDSAKey property.
		*m: isprivatekey_access		&& Access method used to retrieve the Chilkat SSHKey IsPrivateKey property.
		*m: isprivatekey_assign		&& Assign method used to hold a reference to the IsPrivateKey property.
		*m: isrsakey_access		&& Access method used to retrieve the Chilkat SSHKey IsRSAKey property.
		*m: isrsakey_assign		&& Assign method used to hold a reference to the IsRSAKey property.
		*m: keytype_access		&& Access method used to retrieve the Chilkat SSHKey KeyType property.
		*m: keytype_assign		&& Assign method used to hold a reference to the KeyType property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SSHKey LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat SSHKey LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat SSHKey LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat SSHKey LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SSHKey LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SSHKey LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SSHKey LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtext		&& Convenience method for loading an entire text file into an in-memory string. Returns Nothing on failure
		*m: password_access		&& Access method used to retrieve the Chilkat SSHKey Password property.
		*m: password_assign		&& Assign method used to hold a reference to the Password property.
		*m: savetext		&& Convenience method for saving the contents of a string variable to a file. Returns 1 for success, 0 for failure.
		*m: toopensshprivatekey		&& Exports the private key to a string in OpenSSH format. If bEncrypt is 1, the key is encrypted using the value of the Password property. Below are samples of RSA and DSA private keys in OpenSSH format, both encrypted and unencrypted:
		*m: toopensshpublickey		&& Exports the public key to a string in OpenSSH format.
		*m: toputtyprivatekey		&& Exports the private key to PuTTY format. If bEncrypt is 1, the key is encrypted using the value of the Password property. Below are samples of RSA and DSA private keys in PuTTY format, both encrypted and unencrypted:
		*m: torfc4716publickey		&& Exports the public key to a string in RFC 4716 format. Sample RFC 4716 DSA and RSA public keys are below:
		*m: toxml		&& Exports an SSH key to XML. Samples of RSA and DSA private keys are shown below:
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat SSHKey UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: usepkcs11		&& Introduced in version 9.5.0.96. Use a private key in a PKCS11 session for public-key authentication, where your private key is on an HSM, such as a smart card or hardware token. Both the public and private key handles must be provided.
		*m: usesshcertificate		&& Introduced in version 11.0.0. Loads an SSH certificate into this object. Although an SSH certificate is not a public or private key, it can be used as an SSH key for public key authentication in SSH/SFTP.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat SSHKey VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: isdsakey		&& 1 if the object contains a DSA key. 0 if the object contains an RSA key.
		*p: isprivatekey		&& 1 if the object contains a private key. 0 if it contains a public key.
		*p: isrsakey		&& 1 if the object contains an RSA key. 0 if the object contains a DSA key.
		*p: keytype		&& Indicates the type of key held in this object instance. Can be "rsa", "dsa", "ecdsa", "ed25519", or "none".
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: password		&& The password to be used when importing or exporting encrypted private keys.
		*p: uncommonoptions		&& This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = SshKey
		debuglogfilepath = 
		isdsakey = 0
		isprivatekey = 0
		isrsakey = 0
		keytype = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "sshkey"
		password = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		   Added the UseSshCertificate method to support SSH authentication using SSH Certificates.
		
		** Version 96
		
		  Added the UsePkcs11 method to allow for SSH public key authentication to use an HSM
		  (smartcard or token) for the private key signing operation.
		  This allows for the Ssh, SFtp, and SshTunnel classes, or anywhere SSH is used in Chilkat,
		  to be able to use a private key located on an HSM and accessed via PKCS11
		  (because the private key for authentication is passed in an SshKey object,
		  and if the SshKey is using a PKCS11 session, then it will be used for signing).
		
		  Added support for the Watchdata PROXkey USB token.
		  Chilkat should automatically recognize the USB token
		  and use the PKCS11 driver at C:\Windows\System32\SignatureP11.dll.
		  (This is also supported on Linux, assuming the shared lib is at
		  /usr/lib/WatchData/ProxKey/lib/libwdpkcs_SignatureP11.so)
		
		** Version 95
		
		  Chilkat now works with the Turkish smartcard from TUBITAK UEKAE.
		
		  Chilkat now works correctly with the CryptoCertum 3.6 Cryptographic Card
		
		  Chilkat now works more seamlessly with the ePass2003 token.
		
		** Version 90
		
		  Improved automatic recognition and handling for various smart cards.
		
		** Version 89
		
		  Now supports the PPK3 file format.
		
		** Version 88
		
		  Greatly improved internals for automatically recognizing and handling
		  smart cards and USB tokens from many different vendors. 
		
		** Version 83
		
		  Added the KeyType property.
		
		  Added the GenerateEd25519Key and GenerateEcdsaKey methods.
		
		  Improved internal functionality relating to SmartCards, Storage Providers, etc.
		  This is for Cert.LoadFromSmartcard, CertStore.OpenSmartcard, etc.
		
		  Improved support for ECDSA certs.
		
		  Improved support for Ed25519 private keys.
		
		** Version 78
		
		  Fixed FromOpenSshPrivateKey for loading non-encrypted and encrypted RSA private keys.
		
		** Version 75
		
		  Support for Smartcard and USB tokens is much improved. Note: At this point,
		  smartcards and USB tokens are supported on Windows operating systems only.
		
		** Version 71
		
		  Added support for the EC key format used by openssl.
		  (No coding changes required, Chilkat automatically recognizes the key format when loading/parsing.)
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  (FIXED) SshKey.FromPuttyPrivateKey() failed if comment contained umlauts.
		  See http://www.chilkatforum.com/questions/10082/sshkeyfromputtyprivatekey-fails-if-comment-contains-umlauts
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE comment_access		&& Access method used to retrieve the Chilkat SSHKey Comment property.
		*==============================================================================
		* Method:            Comment_Access
		* Purpose:           Access method used to retrieve the Chilkat SSHKey Comment property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Comment
		* Date Added:        04/08/2022
		*==============================================================================
		
		** 
		** Some key file formats allow a comment to be included. 
		** This is the comment if present.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE comment_assign		&& Assign method used to hold a reference to the Comment property.
		*==============================================================================
		* Method:            Comment_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SSHKey Comment property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Comment property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat SSHKey DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve the Chilkat SSHKey DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        04/08/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call 
		** to automatically append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases 
		** where a Chilkat method call hangs or generates an exception 
		** that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. 
		** The typical causes of a hang are:
		**
		** 1) a timeout related property was set to 0 to explicitly indicate 
		** that an infinite timeout is desired, 
		** 2) the hang is actually a hang within an event callback 
		** (i.e. it is a hang within the application code), or 
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SSHKey DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE fromopensshprivatekey		&& Loads an SSH key from an OpenSSH private-key file format. If the key is encrypted, set the Password property prior to calling this method.
		*==============================================================================
		* Method:            FromOpenSSHPrivateKey
		* Purpose:           Loads an SSH key from an OpenSSH private-key file format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyString -- Contains the contents of the private key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Loads an SSH key from an OpenSSH private-key file format. 
		** If the key is encrypted, set the Password property prior to calling this method.
		** Note: keyStr is not a filename -- it should contain the contents 
		** of the OpenSSH formatted private key. To load from a file, you may first call 
		** LoadText to load the complete contents of a text file into a string.
		**
		** Here are are samples of RSA and DSA private keys in OpenSSH format, 
		** both encrypted and unencrypted:
