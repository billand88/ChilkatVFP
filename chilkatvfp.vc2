	PROCEDURE checkwriteable		&& Determines if the socket is writeable.
		*==============================================================================
		* Method:            CheckWritable
		* Purpose:           Determines if the socket is writeable.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaxWaitMs -- the maximum time to wait.
		* Returns:           The writeable status.
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Determines if the socket is writeable. Returns one of the following integer values:
		** 
		** 1: If the socket is connected and ready for writing.
		** 0: If a timeout occurred or if the application aborted the method during an event callback.
		** -1: The socket is not connected.
		** 
		** A maxWaitMs value of 0 indicates a poll.
		**
		
		LPARAMETERS tiMaxWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liWriteable AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liWriteable = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liWriteable = m.loChilkatObject.CheckWritable(m.tiMaxWaitMs) 
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liWriteable
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

