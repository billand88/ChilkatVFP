	PROCEDURE writefiletextasync		&& Creates an asynchronous task to call the WriteFileText method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            WriteFileTextAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    WriteFileText method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		*                    tcCharset, the character set of the text to write
		*                    tcText, the text to write
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/20/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the WriteFileText method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHandle AS Character, tcCharset AS Character, tcText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.WriteFileTextAsync(m.tcHandle, m.tcCharset, m.tcText)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE xferbytecount_access		&& Access method used to retrieve the Chilkat SFTP XferByteCount property.
		*==============================================================================
		* Method:            XferByteCount_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP XferByteCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.XferByteCount
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** The current transfer byte count for an ongoing upload or download. 
		** Programs doing asynchronous uploads or downloads can read this property 
		** in real time during the upload. For SyncTreeUpload and SyncTreeDownload operations, 
		** this is the real-time cumulative number of bytes for all files uploaded or downloaded.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 71
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE xferbytecount_assign		&& Assign method used to hold a reference to the XferByteCount property.
		*==============================================================================
		* Method:            XferByteCount_Assign
		* Purpose:           Assign method used to hold a reference to the XferByteCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the XferByteCount property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 71
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS sftpdir AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a remote SFTP directory listing.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SFTPDir DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: fileat		&& Introduced in version 11.0.0. Returns the entry in the directory at the given index. Indexing begins at 0. Returns 1 for success, 0 for failure.
		*m: getfilename		&& Returns the Nth filename in the directory (indexing begins at 0). Returns Nothing on failure
		*m: getfileobject		&& Returns the Nth entry in the directory. Indexing begins at 0. Returns Nothing on failure
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SFTPDir LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SFTPDir LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SFTPDir LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SFTPDir LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskresult		&& Introduced in version 9.5.0.52. Loads the SFTP directory object from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*m: numfilesanddirs_access		&& Access method used to retrieve the Chilkat SFTPDir NumFilesAndDirs property.
		*m: numfilesanddirs_assign		&& Assign method used to hold a reference to the NumFilesAndDirs property.
		*m: originalpath_access		&& Access method used to retrieve the Chilkat SFTPDir OriginalPath property.
		*m: originalpath_assign		&& Assign method used to hold a reference to the OriginalPath property.
		*m: sort		&& Introduced in version 9.5.0.79. Sorts the files and sub-directories in ascending or descending order based on the field. Possible values for field are "filename", "filenameNoCase", "lastModifiedTime", "lastAccessTime", "lastCreateTime", or "size".
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numfilesanddirs		&& The number of entries in this directory listing.
		*p: originalpath		&& The original path used to fetch this directory listing. This is the string that was originally passed to the OpenDir method when the directory was read.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = SFtpDir
		debuglogfilepath = 
		lastbinaryresult = .NULL.
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "sftpdir"
		numfilesanddirs = 0
		originalpath = 
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/05/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Added the FileAt method.
		
		  Decremented the GetFileObject method.
		  
		** Version 79
		
		  Added the Sort method.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  (FIXED) The ActiveX LoadTaskResult methods always returned 0,
		  regardless of success/failure.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat SFTPDir DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTPDir DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/08/2026
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SFTPDir DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/08/2026
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE fileat		&& Introduced in version 11.0.0. Returns the entry in the directory at the given index. Indexing begins at 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FileAt
		* Purpose:           Returns the entry in the directory at the given index.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex - the email message number to retrieve.
		*                    toChilkatSftpDir, a Chilkat Sftp Directory object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Returns the entry in the directory at the given index. Indexing begins at 0.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiIndex AS Integer, toChilkatSftpDir AS CHILKAT_SFTPDIR_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SFTPDIR_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterSftpDir AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSftpDir AS CHILKAT_SFTPDIR_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSftpDir, m.loChilkatSftpDir
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSftpDir = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSftpDir)
		
		      loChilkatSftpDir = m.loParkParameterSftpDir.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FileAt(m.tiIndex, m.loChilkatSftpDir) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSftpDir = ;
		      m.loParkParameterSftpDir.SetObject(m.toChilkatSftpDir, m.loChilkatSftpDir)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSftpDir, m.loChilkatSftpDir
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  toChilkatSftpDir = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loParkParameterSftpDir = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSftpDir = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getfilename		&& Returns the Nth filename in the directory (indexing begins at 0). Returns Nothing on failure
		*==============================================================================
		* Method:            GetFileName
		* Purpose:           Returns the Nth filename in the directory (indexing begins at 0).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the file array index value. 
		* Returns:           lcFileName, the file name.
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Returns the Nth filename in the directory (indexing begins at 0).
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SFTPDIR_COM_CALL, ;
		loException AS Exception, lcFileName AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcFileName = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcFileName = m.loChilkatObject.GetFileName(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFileName
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getfileobject		&& Returns the Nth entry in the directory. Indexing begins at 0. Returns Nothing on failure
		*==============================================================================
		* Method:            GetFileObject
		* Purpose:           Returns the Nth filename in the directory (indexing begins at 0).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the file array index value. 
		* Returns:           lcFileName, the file name.
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Returns the Nth filename in the directory (indexing begins at 0).
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SFTPDIR_COM_CALL, ;
		loException AS Exception, loChilkatSFtpFile AS CHILKAT_SFTPFILE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatSFtpFile
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatSFtpFile = m.loChilkatObject.GetFileObject(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatSFtpFile
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTPDIR_COM_CALL)
		  loChilkatSFtpFile = NEWOBJECT(CHILKAT_SFTPFILE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat SFTPDir LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
