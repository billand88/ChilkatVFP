	HIDDEN PROCEDURE enablecompression_access		&& Access method used to retrieve the Chilkat SSH EnableCompression property.
		*==============================================================================
		* Method:            EnableCompression_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH EnableCompression property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EnableCompression
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Enables or disables the use of compression w/ the SSH connection. 
		** The default value is 1, meaning that compression is used if the server supports it.
		**
		** Some older SSH servers have been found that claim to support compression, 
		** but actually fail when compression is used. PuTTY does not enable compression by default. 
		** If trouble is encountered where the SSH server disconnects immediately 
		** after the connection is seemingly established (i.e. during authentication), 
		** then check to see if disabling compression resolves the problem.
		**
		** Change for version 82: Default is changed to false because some servers fail 
		** with compression enabled, and in other cases performance is slower with compression enabled. 
		** (Yet in other cases, it’s possible that performance is better with compression enabled — 
		** it entirely has to do with the compressibility of the data being sent/received.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE enablecompression_assign		&& Assign method used to hold a reference to the SSH EnableCompression property.
		*==============================================================================
		* Method:            EnableCompression_Assign
		* Purpose:           Assign method used to hold a reference to the EnableCompression property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the EnableCompression property.
		* Returns:           
		* Date Added:        04/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE enablesecrets_access		&& Access method used to retrieve the Chilkat SSH EnableSecrets property.
		*==============================================================================
		* Method:            EnableSecrets_Access
		* Purpose:           Access method used to retrieve 
		*                    the EnableSecrets property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EnableSecrets
		* Date Added:        06/02/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		** 
		** This property that automatic resolution of credentials from the operating system’s secure storage.
		**
		** When set to 1, the supported properties and methods (listed below) 
		** can accept a secret specification string (beginning with !!) in place of a literal value. 
		** Chilkat detects this format and retrieves the corresponding secret from:
		** 
		** Windows Credential Manager (Windows)
		** Apple Keychain (macOS)
		** 
		** Secrets are identified using a structured string format: !![appName|]service[|domain]|username
		** 
		** Applies to HttpProxyPassword, SocksPassword, AuthenticatePw, AuthenticatePwPk
		** 
		** This feature allows applications to avoid embedding sensitive data 
		** directly in code by securely resolving credentials at runtime.
		** 
		** The default value is 0
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE enablesecrets_assign		&& Assign method used to hold a reference to the SSH EnableSecrets property.
		*==============================================================================
		* Method:            EnableSecrets_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the EnableSecrets property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the EnableSecrets property.
		* Returns:           
		* Date Added:        06/02/2026
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE forcecipher_access		&& Access method used to retrieve the Chilkat SSH ForceCipher property.
		*==============================================================================
		* Method:            ForceCipher_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH ForceCipher property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ForceCipher
		* Date Added:        04/09/2022
		*==============================================================================
		
		** 
		** Set to one of the following encryption algorithms to force that cipher to be used. 
		** By default, the component will automatically choose 
		** the first cipher supported by the server in the order listed here: 
		** "aes256-ctr", "aes128-ctr", "aes256-cbc", "aes128-cbc", "twofish256-cbc", 
		** "twofish128-cbc", "blowfish-cbc", "3des-cbc", "arcfour128", "arcfour256". 
		** (If blowfish is chosen, the encryption strength is 128 bits.)
		**
		** Important: If this is property is set and the server 
		** does NOT support then encryption algorithm, then the Connect will fail.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE forcecipher_assign		&& Assign method used to hold a reference to the SSH ForceCipher property.
		*==============================================================================
		* Method:            ForceCipher_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SSH ForceCipher property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ForceCipher property.
		* Returns:           
		* Date Added:        04/09/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [ForceCipher]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE getauthmethods		&& Introduced in version 9.5.0.78. Queries the SSH server to find out which authentication methods it supports. Returns a string such as "publickey,password,keyboard-interactive". This method should be called after connecting, but prior to authenticating.
		*==============================================================================
		* Method:            GetAuthMethods
		* Purpose:           Queries the SSH server to find out 
		*                    which authentication methods it supports.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The supported authentication methods.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.78
		**
		** Queries the SSH server to find out which authentication methods it supports. 
		** Returns a string such as "publickey,password,keyboard-interactive".
		**
		** This method should be called after connecting, but prior to authenticating. 
		** The method intentionally disconnects from the server after getting the authentication methods. 
		** An application may then connect again and authentication with a chosen method. 
		** (In most cases, an application knows in advance the type of authentication to be used, 
		** and this method is never called.)
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		lcAuthenticationMethods AS Character, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcAuthenticationMethods = []
		llImplemented = .F.
		liIntroducedInBuild = 78
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcAuthenticationMethods = m.loChilkatObject.GetAuthMethods()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcAuthenticationMethods
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getauthmethodsasync		&& Introduced in version 9.5.0.78. Creates an asynchronous task to call the GetAuthMethods method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            GetAuthMethodsAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    GetAuthMethods method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.78
		** 
		** Creates an asynchronous task to call the GetAuthMethods method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 78
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.GetAuthMethodsAsync(tcAuthenticationMethods)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getchannelexitstatus		&& Returns the exit status code for a channel. This method should only be called if an exit status has been received. You may check to see if the exit status was received by calling ChannelReceivedExitStatus.
		*==============================================================================
		* Method:            GetChannelExitStatus
		* Purpose:           Returns the exit status code for a channel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		* Returns:           The channel exit status.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Returns the exit status code for a channel. 
		** This method should only be called if an exit status has been received. 
		** You may check to see if the exit status was received by calling ChannelReceivedExitStatus.
		**
		
		LPARAMETERS tiChannel AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, ;
		loException AS Exception, liExitStatus AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liExitStatus = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liExitStatus = m.loChilkatObject.GetChannelExitStatus(m.tiChannel)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liExitStatus
		
		** Design time IntelliSense test
		#IF .F.
		
