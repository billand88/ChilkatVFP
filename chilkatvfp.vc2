	HIDDEN PROCEDURE snihostname_access		&& Access method used to retrieve a reference to the SNIHostName property.
		*==============================================================================
		* Method:            SNIHostName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan SNIHostName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SNIHostName
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Specifies the DNS hostname sent in the Server Name Indication (SNI) 
		** extension of the TLS handshake for SMTP and POP3 connections.
		**
		** Normally this property is left empty. In that case, MailMan uses SmtpHost 
		** for SMTP connections and MailHost for POP3 connections.
		**
		** Set this property when connecting by IP address or through an alternate endpoint 
		** while the server's TLS certificate and virtual-host configuration use a DNS hostname. 
		** The value is also used for certificate hostname comparison when RequireHostnameMatch is 1.
		**
		** The default value is the empty string.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE snihostname_assign		&& Assign method used to hold a reference to the SNIHostName property.
		*==============================================================================
