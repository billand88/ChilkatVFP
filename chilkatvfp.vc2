		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Decremented function! Set to true if the asynchronous file transfer succeeded.
		** 
		** This functionality is replaced by the new model for asynchronous programming
		** introduced in Chilkat v9.5.0.52. Applications should use the new model, which is
		** identified by methods having names ending with "Async" and return a task object.
		**
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AsyncSuccess() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE authssl_access		&& Access method used to retrieve the Chilkat AuthSSL property.
		*==============================================================================
		* Method:            AuthSSL_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 AuthSSL property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AuthSSL
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** Same as AuthTls, except the command sent to the FTP server is "AUTH SSL" 
		** instead of "AUTH TLS". Most FTP servers accept either. 
		** AuthTls is more commonly used. If a particular server has trouble with AuthTls, 
		** try AuthSsl instead.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE authssl_assign		&& Assign method used to hold a reference to the AuthSSL property.
		*==============================================================================
		* Method:            AuthSSL_Assign
		* Purpose:           Assign method used to hold a reference to the AuthSSL property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AuthSSL property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE authtls_access		&& Access method used to retrieve the Chilkat AuthTLS property.
		*==============================================================================
		* Method:            AuthTLS_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 AuthTLS property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AuthTLS
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** Set this to 1 to switch to a TLS encrypted channel. 
		** This property should be set prior to connecting. 
		** If this property is set, the port typically remains 
		** at it's default (21) and the Ssl property should *not* be set. 
		** When AuthTls is used, all control and data transmissions are encrypted. 
		** If your FTP client is behind a network-address-translating router, 
		** you may need to call ClearControlChannel 
		** after connecting and authenticating (i.e. after calling the Connect method). 
		** This keeps all data transmissions encrypted, but clears the control channel 
		** so that commands are sent unencrypted, thus allowing the router to translate 
		** network IP numbers in FTP commands.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE authtls_assign		&& Assign method used to hold a reference to the AuthTLS property.
		*==============================================================================
		* Method:            AuthTLS_Assign
		* Purpose:           Assign method used to hold a reference to the AuthTLS property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AuthTLS property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE autofeat_access		&& Access method used to retrieve the Chilkat AutoFEAT property.
		*==============================================================================
		* Method:            AutoFeat_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 AutoFeat property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoFeat
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** When 1 (which is the default value), a "FEAT" command 
		** is automatically sent to the FTP server immediately after connecting. 
		** This allows the Chilkat FTP2 component to know more about the server's 
		** capabilities and automatically adjust any applicable internal settings based on the response. 
		** In rare cases, some FTP servers reject the "FEAT" command and close the connection. 
		** Usually, if an FTP server does not implement FEAT, 
		** a harmless "command not understood" response is returned.
		**
		** Set this property to 0 to prevent the FEAT command from being sent.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autofeat_assign		&& Assign method used to hold a reference to the AutoFEAT property.
		*==============================================================================
		* Method:            AutoFeat_Assign
		* Purpose:           Assign method used to hold a reference to the AutoFeat property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoFeat property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE autofixsettings		&& Method to run after a connection is made to the server and the AutoFix property is set to 1.
		*==============================================================================
		* Method:            AutoFixSettings
		* Purpose:           Method to run after a connection is made to the server 
		*                    and the AutoFix property is set to 1.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        04/27/2022
		* Note:              Not a native Chilkat method.
		*==============================================================================
		
		**
		** Fixed for version 93: When using implicit TLS connections (i.e. port 990), 
		** if the same object instance is used for multiple connections, 
		** then for the 2nd and subsequent connections, Chilkat failed to send 
		** the “PROT P” command and the server refuses the connection. 
		**
		
		LOCAL luReturn AS Unknown, liReturn AS Integer, liPort AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liPort
		
		WITH THIS
		
		  luReturn = .AutoFix
		  liReturn = .LogicalToBit(m.luReturn)
		 
		  ** AutoFix On test
		  IF m.liReturn = 1
		
		    liPort = .Port
		
		    ** Port processing branch
		    DO CASE
		    
		      ** Port is 990 test
		      CASE m.liPort = 990
		
		        STORE 0 TO .AuthTLS, .AuthSSL
		        .SSL = 1
		
		      ** Port is 21 test
		      CASE m.liPort = 21
		  
		        .SSL = 0
		
		    ENDCASE
		    ** End port processing branch
		
		  ENDIF m.liReturn = 1
		  ** End AutoFix On test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE autofix_access		&& Access method used to retrieve the Chilkat AutoFix property.
		*==============================================================================
		* Method:            AutoFix_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 AutoFix property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoFix
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** If 1, then the following when a connection is made to an FTP server:
		** 
		** 1) If the Port property = 990, then sets AuthTls = 0, AuthSsl = 0, and Ssl = 1
		** 2) If the Port property = 21, sets Ssl = 0
		** 
		** The default value of this property is 1.
		**
		** Fixed for version 93: When using implicit TLS connections (i.e. port 990), 
		** if the same object instance is used for multiple connections, 
		** then for the 2nd and subsequent connections, Chilkat failed to send 
		** the “PROT P” command and the server refuses the connection. 
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

