	PROCEDURE getattribuint		&& Introduced in version 9.50.87. Get an unsigned integer typed attribute from the IFD Handler (reader driver). The attr can be one of the following, but should be limited to the particular attributes that return unsigned integer values.
		*==============================================================================
		* Method:            GetAttribUInt
		* Purpose:           Get an unsigned integer typed attribute 
		*                    from the IFD Handler (reader driver).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAttribute, the attribute to retrieve.
		* Returns:           The unsigned integer attribute value.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Get an unsigned integer typed attribute from the IFD Handler (reader driver).
		** 
		** The attr can be one of the following, but should be limited 
		** to the particular attributes that return unsigned integer values.
		** 
		**   "ASYNC_PROTOCOL_TYPES"
		**   "ATR_STRING"
		**   "CHANNEL_ID"
		**   "CHARACTERISTICS"
		**   "CURRENT_BWT"
		**   "CURRENT_CLK"
		**   "CURRENT_CWT"
		**   "CURRENT_D"
		**   "CURRENT_EBC_ENCODING"
		**   "CURRENT_F"
		**   "CURRENT_IFSC"
		**   "CURRENT_IFSD"
		**   "CURRENT_IO_STATE"
		**   "CURRENT_N"
		**   "CURRENT_PROTOCOL_TYPE"
		**   "CURRENT_W"
		**   "DEFAULT_CLK"
		**   "DEFAULT_DATA_RATE"
		**   "DEVICE_FRIENDLY_NAME"
		**   "DEVICE_IN_USE"
		**   "DEVICE_SYSTEM_NAME"
		**   "DEVICE_UNIT"
		**   "ESC_AUTHREQUEST"
		**   "ESC_CANCEL"
		**   "ESC_RESET"
		**   "EXTENDED_BWT"
		**   "ICC_INTERFACE_STATUS"
		**   "ICC_PRESENCE"
		**   "ICC_TYPE_PER_ATR"
		**   "MAX_CLK"
		**   "MAX_DATA_RATE"
		**   "MAX_IFSD"
		**   "MAXINPUT"
		**   "POWER_MGMT_SUPPORT"
		**   "SUPRESS_T1_IFS_REQUEST"
		**   "SYNC_PROTOCOL_TYPES"
		**   "USER_AUTH_INPUT_DEVICE"
		**   "USER_TO_CARD_AUTH_DEVICE"
		**   "VENDOR_IFD_SERIAL_NO"
		**   "VENDOR_IFD_TYPE"
		**   "VENDOR_IFD_VERSION"
		**   "VENDOR_NAME"
		** 
		** Returns 0xFFFFFFFF on failure.
		**
		
		LPARAMETERS tcAttribute AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liUnsignedAttribute AS Integer
		
		STORE 0 TO m.liUnsignedAttribute, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liUnsignedAttribute = m.loChilkatObject.GetAttribUInt(m.tcAttribute)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liUnsignedAttribute
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getstatuschange		&& Introduced in version 9.50.87. Blocks execution until the current availability of the cards in a specific set of readers changes. This function receives a list of reader names in stReaderNames.
		*==============================================================================
		* Method:            GetStatusChange
		* Purpose:           Blocks execution until the current availability 
		*                    of the cards in a specific set of readers changes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaximumWaitMs, the maximum millisecond time to wait.
		*                    toChilkatStringTable, a Chilkat String Table object.
		*                    toChilkatJSON, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Blocks execution until the current availability of the cards 
		** in a specific set of readers changes.
		** 
		** This function receives a list of reader names in stReaderNames. 
		** It then blocks waiting for a change in state to occur 
		** for a maximum blocking time of maxWaitMs (in milliseconds) 
		** or forever if 0 is used.
		** 
		** Information about the current reader states and which reader(s) 
		** changed is returned in json. See the example below for more information.
		** 
		** To wait for a reader event (reader added or removed) 
		** you may use the special reader name "\\?PnP?\Notification".
		** 
		** To cancel the ongoing call, call Cancel().
		** 
		** The stReaderNames contains the reader names to check. 
		** The json is empty on input, and if the call returns success 
		** contains information about the state (after the event change) of each reader.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiMaximumWaitMs AS Integer, ;
		toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, ;
		toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, ;
		loParkParameterJsonObject AS [iParkParameter AS ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetStatusChange(m.tiMaximumWaitMs, ;
		        m.loChilkatStringTable, m.loChilkatJsonObject) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = m.loParkParameterStringTable.SetObject(;
		      m.toChilkatStringTable, m.loChilkatStringTable)
		
		      toChilkatJsonObject = m.loParkParameterJsonObject.SetObject(;
		      m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  toChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getstatuschangeasync		&& Introduced in version 9.50.87. Creates an asynchronous task to call the GetStatusChange method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            GetStatusChangeAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    GetStatusChange method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaximumWaitMs, the maximum millisecond time to wait.
		*                    toChilkatStringTable, a Chilkat String Table object.
		*                    toChilkatJSON, a Chilkat JSON object.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.50.87
		**
		** Creates an asynchronous task to call the GetStatusChange method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiMaximumWaitMs AS Integer, ;
		toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, ;
		toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, ;
		loParkParameterJsonObject AS [iParkParameter AS ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterStringTable, m.loChilkatStringTable, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.GetStatusChangeAsync(m.tiMaximumWaitMs, ;
		        m.loChilkatStringTable, m.loChilkatJsonObject) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = m.loParkParameterStringTable.SetObject(;
		      m.toChilkatStringTable, m.loChilkatStringTable)
		
		      toChilkatJsonObject = m.loParkParameterJsonObject.SetObject(;
		      m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		  
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  toChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

