	PROCEDURE setfrommimebytes		&& Loads the email object with the mimeBytes. If the email object already contained an email, it is entirely replaced. The character encoding (such as "utf-8", "iso-8859-1", etc.) of the bytes is automatically inferred from the content.
		*==============================================================================
		* Method:            SetFromMIMEBytes
		* Purpose:           Loads the email object with the mimeBytes. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqMIMEBytes, a MIME message.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Loads the email object with the mimeBytes. 
		** If the email object already contained an email, it is entirely replaced. 
		** The character encoding (such as "utf-8", "iso-8859-1", etc.) 
		** of the bytes is automatically inferred from the content. 
		** If for some reason it is not possible to determine the character encoding, 
		** the SetFromMimeBytes2 method may be called to explicitly specify the charset.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tqMIMEBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetFromMIMEBytes(m.tqMIMEBytes) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
