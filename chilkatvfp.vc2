		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE workstation_access		&& Access method used to retrieve the Chilkat NTLM WorkStation property.
		*==============================================================================
