	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat HTTPRequest VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        05/08/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        05/08/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS httpresponse AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a complete HTTP response.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: bodyqp_access		&& Access method used to retrieve the Chilkat HTTPResponse BodyQP property.
		*m: bodyqp_assign		&& Assign method used to hold a reference to the BodyQP property.
		*m: bodystr_access		&& Access method used to retrieve the Chilkat HTTPResponse BodyStr property.
		*m: bodystr_assign		&& Assign method used to hold a reference to the BodyStr property.
		*m: body_access		&& Access method used to retrieve the Chilkat HTTPResponse Body property.
		*m: body_assign		&& Assign method used to hold a reference to the Body property.
		*m: charset_access		&& Access method used to retrieve the Chilkat HTTPResponse Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: contentlength_access		&& Access method used to retrieve the Chilkat HTTPResponse ContentLength property.
		*m: contentlength_assign		&& Assign method used to hold a reference to the ContentLength property.
		*m: datestr_access		&& Access method used to retrieve the Chilkat HTTPResponse DateStr property.
		*m: datestr_assign		&& Assign method used to hold a reference to the DateStr property.
		*m: date_access		&& Access method used to retrieve the Chilkat HTTPResponse Date property.
		*m: date_assign		&& Assign method used to hold a reference to the Date property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat HTTPResponse DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: domain_access		&& Access method used to retrieve the Chilkat HTTPResponse Domain property.
		*m: domain_assign		&& Assign method used to hold a reference to the Domain property.
		*m: finalredirecturl_access		&& Access method used to retrieve the Chilkat HTTPResponse FinalDirectURL property.
		*m: finalredirecturl_assign		&& Assign method used to hold a reference to the FinalDirectURL property.
		*m: fullmime_access		&& Access method used to retrieve the Chilkat HTTPResponse FullMIME property.
		*m: fullmime_assign		&& Assign method used to hold a reference to the FullMIME property.
		*m: getbodybd		&& Introduced in version 9.5.0.64. Copies the response body to a BinData object. Returns 1 for success, 0 for failure.
		*m: getbodyjarr		&& Introduced in version 9.5.0.89. Loads the JSON array response body into a JsonArray This method should only be called when it is known that the response body contains a JSON array (beginning with a square bracket '[' and ending with a square bracket ']').
		*m: getbodyjson		&& Introduced in version 9.5.0.89. Loads the JSON response body into a JsonObject. This method should only be called when it is known that the response body contains JSON (beginning with a curly brace '{' and ending with a curly brace '}')
		*m: getbodysb		&& Introduced in version 9.5.0.64. Copies the response body to a Chilkat StringBuilder object. Returns 1 for success, 0 for failure.
		*m: getbodyxml		&& Introduced in version 9.5.0.89. Loads the XML response body into an XML object. This method should only be called when it is known that the response body contains XML. Returns 1 for success, 0 for failure.
		*m: getcookiedomain		&& Returns the domain of the Nth cookie in the response. Indexing begins at 0. The number of response cookies is specified in the NumCookies property. Returns Nothing on failure
		*m: getcookieexpires		&& Undocumented method! See GetCookieExpireStr method. It is assumed that this method returns the value in a DateTime format.
		*m: getcookieexpiresstr		&& Returns the expiration date/time of the Nth cookie in the response. Indexing begins at 0. The number of response cookies is specified in the NumCookies property. Returns Nothing on failure
		*m: getcookiename		&& Returns the name of the Nth cookie returned in the response. Indexing begins at 0. The number of response cookies is specified in the NumCookies property. Returns Nothing on failure
		*m: getcookiepath		&& Returns the path of the Nth cookie returned in the response. Indexing begins at 0. The number of response cookies is specified in the NumCookies property. Returns Nothing on failure
		*m: getcookievalue		&& Returns the value of the Nth cookie returned in the response. Indexing begins at 0. The number of response cookies is specified in the NumCookies property. Returns Nothing on failure
		*m: getheaderfield		&& Returns the value of a response header field accessed by field name. Returns Nothing on failure
		*m: getheaderfieldattr		&& Returns a response header field attribute. As an example, the response charset is simply the GetHeaderFieldAttr("content-type","charset"). Returns Nothing on failure
		*m: getheadername		&& Gets the name of the Nth response header field. Indexing begins at 0. The number of response headers is specified by the NumHeaderFields property. Returns Nothing on failure
		*m: getheadervalue		&& Gets the value of the Nth response header field. Indexing begins at 0. The number of response headers is specified by the NumHeaderFields property. Returns Nothing on failure.
		*m: header_access		&& Access method used to retrieve the Chilkat HTTPResponse Header property.
		*m: header_assign		&& Assign method used to hold a reference to the Header property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat HTTPResponse LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat HTTPResponse LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat HTTPResponse LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat HTTPResponse LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat HTTPResponse LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat HTTPResponse LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat HTTPResponse LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskresult		&& Introduced in version 9.5.0.52. Loads the HTTP response from a completed asynchronous task.
		*m: numcookies_access		&& Access method used to retrieve the Chilkat HTTPResponse NumCookies property.
		*m: numcookies_assign		&& Assign method used to hold a reference to the NumCookies property.
		*m: numheaderfields_access		&& Access method used to retrieve the Chilkat HTTPResponse NumHeaderFields property.
		*m: numheaderfields_assign		&& Assign method used to hold a reference to the NumHeaderFields property.
		*m: savebodybinary		&& Saves the body of the HTTP response to a file. Returns 1 for success, 0 for failure.
		*m: savebodytext		&& Saves the HTTP response body to a file. This method provides control over CRLF vs bare-LF line-endings. If bCrlf is 1, then line endings are automatically converted to CRLF if necessary.
		*m: statuscode_access		&& Access method used to retrieve the Chilkat HTTPResponse StatusCode property.
		*m: statuscode_assign		&& Assign method used to hold a reference to the StatusCode property.
		*m: statusline_access		&& Access method used to retrieve the Chilkat HTTPResponse StatusLine property.
		*m: statusline_assign		&& Assign method used to hold a reference to the StatusLine property.
		*m: statustext_access		&& Access method used to retrieve the Chilkat HTTPResponse StatusText property.
		*m: statustext_assign		&& Assign method used to hold a reference to the StatusText property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat HTTPResponse UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: urlencparamvalue		&& Convenience method for parsing a param's value out of a URL-encoded param string.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat HTTPResponse VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: body		&& The response body returned as a byte array.
		*p: bodyqp		&& The same as the Body property, but returned as a quoted-printable encoded string.
		*p: bodystr		&& The response body returned as a string.
		*p: charset		&& The response charset, such as "iso-8859-1", if applicable. Obviously, responses for GIF and JPG files will not have a charset.
		*p: contentlength		&& The content length of the response, in bytes.
		*p: date		&& Undocumented! Returns a datetime value from the response header field.
		*p: datestr		&& Returns the content of the Date response header field in RFC822 date/time string format.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: domain		&& The domain of the HTTP server that created this response.
		*p: finalredirecturl		&& Introduced in version 9.5.0.49. Returns the redirect URL for 301/302 responses.
		*p: fullmime		&& Returns the full MIME (header + body) of the HTTP response.
		*p: header		&& The full text of the response header.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcookies		&& The number of cookies included in the response.
		*p: numheaderfields		&& The number of response header fields.
		*p: statuscode		&& The status code (as an integer) from the first line of an HTTP response. If the StatusLine = "HTTP/1.0 200 OK", the response status code returned is 200.
		*p: statusline		&& The first line of an HTTP response, such as "HTTP/1.0 200 OK".
		*p: statustext		&& Introduced in version 9.5.0.49. The text that follows the status code in the 1st line of the HTTP response. For example, i the first line of an HTTP response is "HTTP/1.0 200 OK", then this property contains "OK".
		*p: uncommonoptions		&& Introduced in version 9.5.0.89. This is a catch-all property to be used for uncommon needs. Can be set to a list of the following comma separated keywords: "TakeResponseBody" - Introduced in v9.5.0.89.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information.
	*</DefinedPropArrayMethod>

	*<PropValue>
		body = .NULL.
		bodyqp = 
		bodystr = 
		cchilkatclass = HttpResponse
		charset = 
		contentlength = 0
		date = ({/:})
		datestr = 
		debuglogfilepath = 
		domain = 
		finalredirecturl = 
		fullmime = 
		header = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "httpresponse"
		numcookies = 0
		numheaderfields = 0
		statuscode = 0
		statusline = 
		statustext = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE bodyqp_access		&& Access method used to retrieve the Chilkat HTTPResponse BodyQP property.
		*==============================================================================
		* Method:            BodyQP_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTPRequest BodyQP property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BodyQP
		* Date Added:        06/02/2022
		*==============================================================================
		
		**
		** The same as the Body property, but returned as a quoted-printable encoded string.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE bodyqp_assign		&& Assign method used to hold a reference to the BodyQP property.
		*==============================================================================
		* Method:            BodyQP_Assign
		* Purpose:           Assign method used to hold a reference to the BodyQP property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold 
		*                    a reference to the BodyQP property.
		* Returns:           
		* Date Added:        06/02/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE bodystr_access		&& Access method used to retrieve the Chilkat HTTPResponse BodyStr property.
		*==============================================================================
		* Method:            BodyStr_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTPRequest BodyStr property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BodyStr
		* Date Added:        06/02/2022
		*==============================================================================
		
		**
		** The response body returned as a string.
		**
		** Fix for version 77: For methods that return an HttpResponse object, 
		** if the response status code was >= 400, the response body (if it exists) 
		** was not contained in the responseObject.BodyStr property. Now it is.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

