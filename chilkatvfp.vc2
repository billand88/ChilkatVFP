		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE postjson		&& A simplified way of sending a JSON POST and receiving the JSON response. The HTTP response is returned in an HTTP response object. The content type of the HTTP request is "application/json".
		*==============================================================================
		* Method:            PostJSON
		* Purpose:           A simplified way of sending a JSON POST and receiving the JSON response.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to post the content.
		*                    tcJSONText -- the JSON text to post.
		* Returns:           Chilkat HTTP Response object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** A simplified way of sending a JSON POST and receiving the JSON response. 
		** The HTTP response is returned in an HTTP response object. 
		** The content type of the HTTP request is "application/json". 
		** To send a JSON POST using a different content-type, 
		** call the PostJson2 method where the content type can be explicitly specified.
		**
		** Enhancement for Version 40: For POST and PUT requests, ensures that 
		** a Content-Length header is always added even if the content length is 0.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		** 
		** Fixed for version 73: Changed the default Content-Type for this method to be “application/json”. 
		** The original default value, “application/jsonrequest” was the initial “standard” years ago, 
		** but seems to never be used nowadays. If an “application/jsonrequest” is needed 
		** (and I doubt it will ever be needed), then PostJson2 may be called to explicitly specify the Content-Type.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character, tcJSONText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatHTTPResponse = m.loChilkatObject.PostJSON(m.tcURL, m.tcJSONText)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE postjson2		&& The same as PostJson,except it allows for the content type to be explicitly provided. The PostJson method automatically uses "application/jsonrequest".
		*==============================================================================
		* Method:            PostJSON2
		* Purpose:           The same as PostJson, except it allows 
		*                    for the content type to be explicitly provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to post the content.
		*                    tcContentType -- the content type of the post.
		*                    tcJSONText -- the JSON text to post.
		* Returns:           Chilkat HTTP Response object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** The same as PostJson, except it allows for the content type to be explicitly provided. 
		** The PostJson method automatically uses "application/jsonrequest". 
		** If the application needs for the content type to be "application/json", 
		** or some other content type, then PostJson2 provides the means.
		**
		** Enhancement for Version 40: For POST and PUT requests, ensures that 
		** a Content-Length header is always added even if the content length is 0.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character, tcContentType AS Character, tcJSONText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatHTTPResponse = ;
		      m.loChilkatObject.PostJSON2(m.tcURL, m.tcContentType, m.tcJSONText)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

