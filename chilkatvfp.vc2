	PROCEDURE httpredirect		&& Called for each redirect that is followed. The abort may be set to 1 to abort the HTTP request.
		*==============================================================================
		* Method:            HTTPRedirect
		* Purpose:           Called for each redirect that is followed. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOriginalURL, the original URL
		*                    tcRedirectURL, the redirected URL
		*                    tiAbort, indicates the abort status. 0 = Not aborting.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** Called for each redirect that is followed. 
		** The abort may be set to 1 to abort the HTTP request.
		**
		
		LPARAMETERS tcOriginalURL AS Character, ;
		tcRedirectURL AS Character, tiAbort AS Integer
		
		LOCAL lcOriginalURL AS Character, lcRedirectURL AS Character, liAbort AS Integer
		
		lcOriginalURL = m.tcOriginalURL
		lcRedirectURL = m.tcRedirectURL 
		liAbort = m.tiAbort
		
		*!*  ? [HttpRedirect Event!]
		*!*  ? [HttpRedirect Original URL ] + lcOriginalURL 
		*!*  ? [HttpRedirect Redirected URL ] + lcRedirectURL 
		*!*  ? [HttpRedirect Abort Status ] + ALLTRIM(STR(liAbort)) + [.]
		
		WITH THIS
		
		  ** Not aborting test
		  IF m.liAbort = 0
		
		    liAbort = .HTTPRedirect_Pre(m.lcOriginalURL, m.lcRedirectURL, m.liAbort)
		
		    ** Still not aborting test
		    IF m.liAbort = 0
		
		      liAbort = .HTTPRedirect_Process(m.lcOriginalURL, m.lcRedirectURL, m.liAbort)
		
		      ** Still not aborting test
		      IF m.liAbort = 0
		
		        liAbort = .HTTPRedirect_Post(m.lcOriginalURL, m.lcRedirectURL, m.liAbort)
		
		      ENDIF m.liAbort = 0
		      ** End still not aborting test
		
		    ENDIF m.liAbort = 0
		    ** End still not aborting test
		
		  ENDIF m.liAbort = 0
		  ** End not aborting test
		
		ENDWITH
		
		tcOriginalURL = m.lcOriginalURL
		tcRedirectURL = m.lcRedirectURL
		tiAbort = m.liAbort
		
		RETURN
	ENDPROC

	PROCEDURE httpredirect_post		&& Template HTTPRedirect post-processing method.
		*==============================================================================
		* Method:            HTTPRedirect_Post
		* Purpose:           HTTPRedirect post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOriginalURL, the original URL
		*                    tcRedirectURL, the redirected URL
		*                    tiAbort, indicates the abort status. 0 = Not aborting.
		* Returns:           liAbort, indicates the abort status.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tcOriginalURL AS Character, ;
		tcRedirectURL AS Character, tiAbort AS Integer
		
		LOCAL lcOriginalURL AS Character, lcRedirectURL AS Character, liAbort AS Integer
		
		lcOriginalURL = m.tcOriginalURL
		lcRedirectURL = m.tcRedirectURL 
		liAbort = m.tiAbort
		
		tcOriginalURL = m.lcOriginalURL
		tcRedirectURL = m.lcRedirectURL
		tiAbort = m.liAbort
		
		RETURN m.liAbort
	ENDPROC

