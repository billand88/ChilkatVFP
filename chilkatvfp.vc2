	PROCEDURE readentiretextfile		&& Reads the entire contents of a text file, interprets the bytes according to the character encoding specified by charset, and returns the text file as a string. Returns Nothing on failure
		*==============================================================================
		* Method:            ReadEntireTextFile
		* Purpose:           Reads the entire contents of a text file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file.
		*                    tcEncoding, the return string encoding.
		* Returns:           The entire text file.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Reads the entire contents of a text file, interprets the bytes 
		** according to the character encoding specified by charset, 
		** and returns the text file as a string.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcFilePath AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, lcEntireTextFile AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEntireTextFile = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEntireTextFile = ;
		      m.loChilkatObject.ReadEntireTextFile(m.tcFilePath, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEntireTextFile
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readnextfragment		&& Introduced in version 9.5.0.80. Scans the currently open file (opened by calling OpenForRead) for the next chunk of text delimited by beginMarker and endMarker. The matched text, including the beginMarker and endMarker are appended to sb.
		*==============================================================================
		* Method:            ReadNextFragment
		* Purpose:           Scans the currently open file (opened by calling OpenForRead) 
		*                    for the next chunk of text delimited by beginMarker and endMarker.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuStartAtBeginning, whether or not to start at beginning of file.
		*                    tcBeginningMarker, the beginning marker.
		*                    tcEndingMarker, the ending marker.
		*                    tcCharset, the charset of the next fragment
		*                    loChilkatStringBuilder, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Scans the currently open file (opened by calling OpenForRead) for the next chunk 
		** of text delimited by beginMarker and endMarker. The matched text, 
		** including the beginMarker and endMarker are appended to sb. 
		** The bytes of the text file are interpreted according to charset. 
		** If startAtBeginning equals 1, then scanning begins at the start of the file. 
		** Otherwise scanning begins starting at the byte following the last matched fragment.
		** 
		** The return value of this function is:
		** 
		**   0: No match was found.
		**   1: Found the next matching fragment and appended to sb.
		**  -1: Error reading the file.
		** 
		** To support a common need for use with XML files, the beginMarker is "XML tag aware". 
		** If the beginMarker is a string such as "", then it will also match "
		** 
		
		LPARAMETERS tuStartAtBeginning AS Unknown, tcBeginningMarker AS Integer, ;
		tcEndingMarker AS Character, tcCharset AS Character, ;
		toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		liStartAtBeginning AS Integer
		
		STORE 0 TO m.liReturn, m.liIntroducedInBuild, m.liStartAtBeginning
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liStartAtBeginning = .LogicalToBit(m.tuStartAtBeginning)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        liReturn = m.loChilkatObject.ReadNextFragment(m.liStartAtBeginning, ;
		        m.tcBeginningMarker, m.tcEndingMarker, m.tcCharset, m.loChilkatStringBuilder)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.liReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

