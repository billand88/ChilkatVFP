	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat Socket UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the UncommonOptions property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty. 
		** Can be set to a list of the following comma separated keywords:
		**
		** "ProtectFromVpn" - Introduced in v9.5.0.80. On Android systems, 
		** will bypass any VPN that may be installed or active.
		**
		** "EnableTls13" - Introduced in v9.5.0.82. Causes TLS 1.3 to be offered 
		** in the ClientHello of the TLS protocol, allowing the server to select TLS 1.3 for the session. 
		** Future versions of Chilkat will enable TLS 1.3 by default. 
		** This option is only necessary in v9.5.0.82 if TLS 1.3 is desired.
		**
		** Introduced in version 98: Added the “brainpool_supported_group” UncommonOption 
		** to cause Chilkat to add brainpoolP256r1 to the “supported groups” extension.
		**
		** Introduced in version 99: Client-initiated TLS renegotiation is generally considered a vulnerability, 
		** and Chilkat does not allow it by default. If an application really needs 
		** to enable client-initiated renegotation (which is an extension in the TLS ClientHello, 
		** sent internally by Chilkat), then you can add the keyword “AllowClientInitReneg” 
		** to the UncommonOptions property for any Chilkat function that makes a TLS connection.
		**
		** ListenAllNetworkInterfaces - Introduced in v11.2.0. Causes the listener socket 
		** to bind to 0.0.0.0 instead of 127.0.0.1.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the Uncommoptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold
		*                    the UncommonOptions of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        05/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		lcValidationMethod = [UncommonOptions_Socket]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE unlockcomponent		&& Undocumented method! Unlocks the component allowing for the full functionality to be used. An arbitrary string can be passed to initiate a fully-functional 30-day trial.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE userdata_access		&& Access method used to retrieve the Chilkat Socket UserData property.
		*==============================================================================
		* Method:            UserData_Access
		* Purpose:           Access method used to retrieve 
		*                    the UserData property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UserData
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Provides a way to store text data with the socket object. 
		** The UserData is purely for convenience 
		** and is not involved in the socket communications in any way. 
		** An application might use this property to keep extra information associated with the socket.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE userdata_assign		&& Assign method used to hold a reference to the UserData property.
		*==============================================================================
		* Method:            UserData_Assign
		* Purpose:           Assign method used to hold
		*                    the UserData of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UserData property.
		* Returns:           
		* Date Added:        05/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE usessh		&& Introduced in version 9.5.0.55. Uses an existing SSH tunnel for the connection. This is an alternative way of establishing a socket connection through an SSH tunnel.
		*==============================================================================
		* Method:            UseSSH
		* Purpose:           Uses an existing SSH tunnel for the connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSSH, a Chilkat SSH object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/31/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** Uses an existing SSH tunnel for the connection. 
		** This is an alternative way of establishing a socket connection through an SSH tunnel. 
		** There are four ways of running a TCP or SSL/TLS connection through an SSH tunnel:
		** 
		** 1) UseSsh
		** 
		**    1) Establish the SSH connection and authenticate using the Chilkat SSH object.
		**    2) Call UseSsh to indicate that the connections 
		**       should be made through the SSH tunnel.
		**    3) Call the Connect method to establish the TCP or SSL/TLS connection 
		**       with a destination host:port. The connection is not direct, 
		**       but will instead be routed through the SSH tunnel and then port-forwarded 
		**       (from the SSH server) to the destination host:port. 
		**       (Had UseSsh not been called, the connection would be direct.)
		**
		** 2) SshOpenTunnel
		**
		**    1) Call the Socket object's SshOpenTunnel method to connect to an SSH server.
		**    2) Call SshAuthenticatePw to authenticate with the SSH server.
		**    3) Instead of calling Connect to connect with the destination host:port, 
		**       the SshOpenChannel method is called to connect via port-forwarding 
		**       through the SSH tunnel.
		**
		** 3) SshTunnel object with dynamic port forwarding
		**
		**    1) The Chilkat SSH Tunnel object is utilized to run in a background thread. 
		**       It connects and authenticates with an SSH server, 
		**       and then listens at a port chosen by the application, 
		**       and behaves as a SOCKS5 proxy server.
		**
		**    2) The Socket object sets the SOCKS5 proxy host:port to localhost:<port>,
		**    3) The Socket's Connect method is called to connect via the SSH Tunnel. 
		**       The connection is routed through the SSH tunnel via dynamic port forwarding.
		**    4) Once the background SSH Tunnel thread is running, it can handle any number 
		**       of incoming connections from the foreground thread, other threads, 
		**       or even other programs that are local or remote. Each incoming connection 
		**       is routed via dynamic port forwarding to it's chosen destnation host:port 
		**       on it's own logical SSH channel.
		**
		** 4) SshTunnel object with hard-coded port forwarding
		**
		**    1) The Chilkat SSH Tunnel object is utilized to run in a background thread. 
		**       It connects and authenticates with an SSH server, 
		**       and then listens at a port chosen by the application. 
		**       It does not behave as a SOCKS5 proxy server, 
		**       but instead has a hard-coded destination host:port.
		**    2) The Socket's Connect method is called to connect to localhost:<port>. 
		**       The connection is automatically port-forwarded through the SSH tunnel 
		**       to the hard-coded destination host:port.
		**
		** In all cases, the SSH tunnels can hold both unencrypted TCP connections 
		** and SSL/TLS connections.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSSH AS CHILKAT_SSH_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterSsh AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSsh AS CHILKAT_SSH_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSsh, m.loChilkatSsh
		
		llImplemented = .F.
		liIntroducedInBuild = 55
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSsh = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSsh)
		
		      loChilkatSsh = m.loParkParameterSsh.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseSSH(m.loChilkatSSH) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSsh = m.loParkParameterSsh.SetObject(m.toChilkatSsh, m.loChilkatSsh)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSsh, m.loChilkatSsh
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  toChilkatSSH = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loParkParameterSsh = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSsh = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat Socket VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        05/28/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        05/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS spider AS ibasechilkat OF "chilkatvfp.vcx" 		&& Chilkat Spider web crawler object.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat Spider AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: addavoidoutboundlinkpattern		&& Adds a wildcarded pattern to prevent collecting matching outbound link URLs. For example, if "*google*" is added, then any outbound links containing the word "google" will be ignored. The "*" character matches zero or more of any character.
		*m: addavoidpattern		&& Adds a wildcarded pattern to prevent spidering matching URLs. For example, if "*register*" is added, then any url containing the word "register" is not spidered. The "*" character matches zero or more of any character.
		*m: addmustmatchpattern		&& Adds a wildcarded pattern to limit spidering to only URLs that match the pattern. For example, if "*/products/*" is added, then only URLs containing "/products/" are spidered. This is helpful for only spidering a portion of a website.
		*m: addunspidered		&& To begin spidering you must call this method one or more times to provide starting points. It adds a single URL to the object's internal queue of URLs to be spidered.
		*m: avoidhttps_access		&& Access method used to retrieve the Chilkat Spider AvoidHTTPS property.
		*m: avoidhttps_assign		&& Assign method used to hold a reference to the AvoidHTTPS property.
		*m: cachedir_access		&& Access method used to retrieve the Chilkat Spider CacheDir property.
		*m: cachedir_assign		&& Assign method used to hold a reference to the CacheDir property.
		*m: canonicalizeurl		&& Canonicalizes a URL by doing the following: 1) Drops username/password if present. 2) Drops fragment if present., etc. Returns Nothing on failure.
		*m: chopatquery_access		&& Access method used to retrieve the Chilkat Spider ChopAtQuery property.
		*m: chopatquery_assign		&& Assign method used to hold a reference to the ChopAtQuery property.
		*m: clearfailedurls		&& Clears the object's internal list of URLs that could not be downloaded.
		*m: clearoutboundlinks		&& Clears the object's internal list of outbound URLs that will automatically accumulate while spidering.
		*m: clearspideredurls		&& Clears the object's internal list of already-spidered URLs that will automatically accumulate while spidering.
		*m: connecttimeout_access		&& Access method used to retrieve the Chilkat Spider ConnectTimeout property.
		*m: connecttimeout_assign		&& Assign method used to hold a reference to the ConnectTimeout property.
		*m: crawlnext		&& Crawls the next URL in the internal list of unspidered URLs. The URL is moved from the unspidered list to the spidered list. Any new links within the same domain and not yet spidered are added to the unspidered list.
		*m: crawlnextasync		&& Creates an asynchronous task to call the CrawlNext method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Spider DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: domain_access		&& Access method used to retrieve the Chilkat Spider Domain property.
		*m: domain_assign		&& Assign method used to hold a reference to the Domain property.
		*m: fetchfromcache_access		&& Access method used to retrieve the Chilkat Spider FetchFromCache property.
		*m: fetchfromcache_assign		&& Assign method used to hold a reference to the FetchFromCache property.
		*m: fetchrobotstext		&& Returns the contents of the robots.txt file from the domain being crawled. This spider object will not crawl URLs excluded by robots.txt.
		*m: fetchrobotstextasync		&& Creates an asynchronous task to call the FetchRobotsText method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: finalredirecturl_access		&& Access method used to retrieve the Chilkat Spider FinalDirectURL property.
		*m: finalredirecturl_assign		&& Assign method used to hold a reference to the FinalDirectURL property.
		*m: getavoidpattern		&& Returns the Nth avoid pattern previously added by calling AddAvoidPattern. Indexing begins at 0. Returns Nothing on failure.
		*m: getbasedomain		&& To be documented soon. Returns Nothing on failure.
		*m: getfailedurl		&& Returns the Nth URL in the failed URL list. Indexing begins at 0. Returns Nothing on failure.
		*m: getoutboundlink		&& Returns the Nth URL in the outbound link URL list. Indexing begins at 0. Returns Nothing on failure.
		*m: getspideredurl		&& Returns the Nth URL in the already-spidered URL list. Indexing begins at 0. Returns Nothing on failure.
		*m: getunspideredurl		&& Returns the Nth URL in the unspidered URL list. Indexing begins at 0. Returns Nothing on failure.
		*m: geturldomain		&& Returns the domain name part of a URL. For example, if the URL is "http://www.chilkatsoft.com/test.asp", then "www.chilkatsoft.com" is returned. Returns Nothing on failure
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat Spider HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: initialize		&& Initializes the object to begin spidering a domain. Calling Initialize clears any patterns added via the AddAvoidOutboundLinkPattern, AddAvoidPattern, and AddMustMatchPattern methods.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Spider LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Spider LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Spider LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Spider LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastfromcache_access		&& Access method used to retrieve the Chilkat Spider LastFromCache property.
		*m: lastfromcache_assign		&& Assign method used to hold a reference to the LastFromCache property.
		*m: lasthtmldescription_access		&& Access method used to retrieve the Chilkat Spider LastHTMLDescription property.
		*m: lasthtmldescription_assign		&& Assign method used to hold a reference to the LastHTMLDescription property.
		*m: lasthtmlkeywords_access		&& Access method used to retrieve the Chilkat Spider LastHTMLKeywords property.
		*m: lasthtmlkeywords_assign		&& Assign method used to hold a reference to the LastHTMLKeywords property.
		*m: lasthtmltitle_access		&& Access method used to retrieve the Chilkat Spider LastHTMLTitle property.
		*m: lasthtmltitle_assign		&& Assign method used to hold a reference to the LastHTMLTitle property.
		*m: lasthtml_access		&& Access method used to retrieve the Chilkat Spider LastHTML property.
		*m: lasthtml_assign		&& Assign method used to hold a reference to the LastHTML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Spider LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastmoddate_access		&& Access method used to retrieve the Chilkat Spider LastModDate property.
		*m: lastmoddate_assign		&& Assign method used to hold a reference to the LastModDate property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Spider LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Spider LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: lasturl_access		&& Access method used to retrieve the Chilkat Spider LastURL property.
		*m: lasturl_assign		&& Assign method used to hold a reference to the LastURL property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: maxresponsesize_access		&& Access method used to retrieve the Chilkat Spider MaxResponseSize property.
		*m: maxresponsesize_assign		&& Assign method used to hold a reference to the MaxResponseSize property.
		*m: maxurllen_access		&& Access method used to retrieve the Chilkat Spider MaxURLLen property.
		*m: maxurllen_assign		&& Assign method used to hold a reference to the MaxURLLen property.
		*m: numavoidpatterns_access		&& Access method used to retrieve the Chilkat Spider NumAvoidPatterns property.
		*m: numavoidpatterns_assign		&& Assign method used to hold a reference to the NumAvoidPatterns property.
		*m: numfailed_access		&& Access method used to retrieve the Chilkat Spider NumFailed property.
		*m: numfailed_assign		&& Assign method used to hold a reference to the NumFailed property.
		*m: numoutboundlinks_access		&& Access method used to retrieve the Chilkat Spider NumOutboundLinks property.
		*m: numoutboundlinks_assign		&& Assign method used to hold a reference to the NumOutboundLinks property.
		*m: numspidered_access		&& Access method used to retrieve the Chilkat Spider NumSpidered property.
		*m: numspidered_assign		&& Assign method used to hold a reference to the NumSpidered property.
		*m: numunspidered_access		&& Access method used to retrieve the Chilkat Spider NumUnspidered property.
		*m: numunspidered_assign		&& Assign method used to hold a reference to the NumUnspidered property.
		*m: preferipv6_access		&& Access method used to retrieve the Chilkat Spider PreferIPV6 property.
		*m: preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*m: proxydomain_access		&& Access method used to retrieve the Chilkat Spider ProxyDomain property.
		*m: proxydomain_assign		&& Assign method used to hold a reference to the ProxyDomain property.
		*m: proxylogin_access		&& Access method used to retrieve the Chilkat Spider ProxyLogin property.
		*m: proxylogin_assign		&& Assign method used to hold a reference to the ProxyLogin property.
		*m: proxypassword_access		&& Access method used to retrieve the Chilkat Spider ProxyPassword property.
		*m: proxypassword_assign		&& Assign method used to hold a reference to the ProxyPassword property.
		*m: proxyport_access		&& Access method used to retrieve the Chilkat Spider ProxyPort property.
		*m: proxyport_assign		&& Assign method used to hold a reference to the ProxyPort property.
		*m: readtimeout_access		&& Access method used to retrieve the Chilkat Spider ReadTimeout property.
		*m: readtimeout_assign		&& Assign method used to hold a reference to the ReadTimeout property.
		*m: recrawllast		&& Re-crawls the last URL spidered. This helpful when cookies set in a previous page load cause the page to be loaded differently the next time.
		*m: recrawllastasync		&& Creates an asynchronous task to call the RecrawlLast method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: skipunspidered		&& Moves a URL from the unspidered list to the spidered list. This allows an application to skip a specific URL.
		*m: sleepms		&& Suspends the execution of the current thread until the time-out interval elapses.
		*m: updatecache_access		&& Access method used to retrieve the Chilkat Spider UpdateCache property.
		*m: updatecache_assign		&& Assign method used to hold a reference to the UpdateCache property.
		*m: useragent_access		&& Access method used to retrieve the Chilkat Spider UserAgent property.
		*m: useragent_assign		&& Assign method used to hold a reference to the UserAgent property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Spider VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: wasredirected_access		&& Access method used to retrieve the Chilkat Spider WasRedirected property.
		*m: wasredirected_assign		&& Assign method used to hold a reference to the WasRedirected property.
		*m: winddowncount_access		&& Access method used to retrieve the Chilkat Spider WindDownCount property.
		*m: winddowncount_assign		&& Assign method used to hold a reference to the WindDownCount property.
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected. If no method is running,
		*p: avoidhttps		&& If set the 1 (true) the spider will avoid all HTTPS URLs. The default is 0 (false).
		*p: cachedir		&& Specifies a cache directory to use for spidering. If either of the FetchFromCache or UpdateCache properties are true, this is the location of the cache to be used.
		*p: chopatquery		&& If equal to 1 (true), then the query portion of all URLs are automatically removed when adding to the unspidered list. The default value is 0 (false).
		*p: connecttimeout		&& The maximum number of seconds to wait while connecting to an HTTP server.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: domain		&& The domain name that is being spidered. This is the domain previously set in the Initialize method.
		*p: fetchfromcache		&& If equal to 1 (true) then pages are fetched from cache when possible. If 0, the cache is ignored. The default value is 1. Regardless, if no CacheDir is set then the cache is not used.
		*p: finalredirecturl		&& Introduced in version 9.5.0.85. If the last URL crawled was redirected (as indicated by the WasRedirected property), this property will contain the final redirect URL.
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any method call prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastfromcache		&& Equal to 1 if the last page spidered was fetched from the cache. Otherwise equal to 0.
		*p: lasthtml		&& The HTML text of the last paged fetched by the spider.
		*p: lasthtmldescription		&& The HTML META description from the last page fetched by the spider.
		*p: lasthtmlkeywords		&& The HTML META keywords from the last page fetched by the spider.
		*p: lasthtmltitle		&& The HTML title from the last page fetched by the spider.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: lastmoddate		&& Undocumented property! Prorbably returns the last modfifed date of the last spidered page.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: lasturl		&& The URL of the last page spidered.
		*p: maxresponsesize		&& The maximum HTTP response size allowed. The spider will automatically fail any pages larger than this size. The default value is 250,000 bytes.
		*p: maxurllen		&& The maximum URL length allowed. URLs longer than this are not added to the unspidered list. The default value is 200.
		*p: numavoidpatterns		&& The number of avoid patterns previously set by calling AddAvoidPattern.
		*p: numfailed		&& The number of URLs in the object's failed URL list.
		*p: numoutboundlinks		&& The number of URLs in the object's outbound links URL list.
		*p: numspidered		&& The number of URLs in the object's already-spidered URL list.
		*p: numunspidered		&& The number of URLs in the object's unspidered URL list.
		*p: preferipv6		&& If 1, then use IPv6 over IPv4 when both are supported for a particular domain. The default value of this property is 0, which will choose IPv4 over IPv6.
		*p: proxydomain		&& The domain name of a proxy host if an HTTP proxy is used.
		*p: proxylogin		&& If an HTTP proxy is used and it requires authentication, this property specifies the HTTP proxy login.
		*p: proxypassword		&& If an HTTP proxy is used and it requires authentication, this property specifies the HTTP proxy password.
		*p: proxyport		&& The port number of a proxy server if an HTTP proxy is used.
		*p: readtimeout		&& The maximum number of seconds to wait when reading from an HTTP server.
		*p: updatecache		&& If equal to 1 (true) then pages saved to the cache. If 0, the cache is ignored. The default value is 1. Regardless, if no CacheDir is set then the cache is not used.
		*p: useragent		&& The value of the HTTP user-agent header field to be sent with HTTP requests. This can be set to any desired value, but be aware that some websites may reject requests from unknown user agents.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: wasredirected		&& Introduced in version 9.5.0.85. Indicates whether the last URL crawled was redirected. (1 = yes, 0 = no)
		*p: winddowncount		&& The "wind-down" phase begins when this number of URLs has been spidered. When in the wind-down phase, no new URLs are added to the unspidered list. The default value is 0 which means that there is NO wind-down phase.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		avoidhttps = 0
		cachedir = 
		cchilkatclass = Spider
		ceventhandlerclass = iBaseEventHandler
		chopatquery = 0
		connecttimeout = 0
		debuglogfilepath = 
		domain = 
		fetchfromcache = 1
		finalredirecturl = 
		heartbeatms = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastfromcache = 0
		lasthtml = 
		lasthtmldescription = 
		lasthtmlkeywords = 
		lasthtmltitle = 
		lastmethodsuccess = 1
		lastmoddate = ({/:})
		laststringresult = 
		laststringresultlen = 0
		lasturl = 
		maxresponsesize = 250000
		maxurllen = 200
		Name = "spider"
		numavoidpatterns = 0
		numfailed = 0
		numoutboundlinks = 
		numspidered = 0
		numunspidered = 0
		preferipv6 = 0
		proxydomain = 
		proxylogin = 
		proxypassword = 
		proxyport = 0
		readtimeout = 10
		updatecache = 1
		useragent = 
		verboselogging = 0
		wasredirected = 0
		winddowncount = 0
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat Spider AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Spider AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        06/11/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly 
		** (i.e.have no length file operations or network communications) are not affected. 
		** If no method is running, then this property is automatically reset to 0 
		** when the next method is called. 
		** When the abort occurs, this property is reset to 0. 
		** Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        06/11/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE addavoidoutboundlinkpattern		&& Adds a wildcarded pattern to prevent collecting matching outbound link URLs. For example, if "*google*" is added, then any outbound links containing the word "google" will be ignored. The "*" character matches zero or more of any character.
		*==============================================================================
		* Method:            AddAvoidOutboundLinkPattern
		* Purpose:           Adds a wildcarded pattern to prevent 
		*                    collecting matching outbound link URLs.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPattern, the pattern to avoid.
		* Returns:           
		* Date Added:        06/11/2022
		*==============================================================================
		
		**
		** Adds a wildcarded pattern to prevent collecting matching outbound link URLs. 
		** For example, if "*google*" is added, then any outbound links containing 
		** the word "google" will be ignored. The "*" character 
		** matches zero or more of any character.
		**
		
		LPARAMETERS tcPattern AS Character
		
		LOCAL loChilkatObject AS [Chilkat.Spider], loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddAvoidOutboundLinkPattern(m.tcPattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Spider])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

