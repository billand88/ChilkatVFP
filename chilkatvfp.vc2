		** Private-MAC: 3BE4CAA1B2AE19C3E6841639BD7275019CF961F1
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tuEncrypt AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, ;
		loException AS Exception, lcString AS Character, liEncrypt AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liEncrypt = 0
		lcString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liEncrypt = .LogicalToBit(m.tuEncrypt)
		
		    TRY
		 
		      lcString = m.loChilkatObject.ToPuttyPrivateKey(m.liEncrypt)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE torfc4716publickey		&& Exports the public key to a string in RFC 4716 format. Sample RFC 4716 DSA and RSA public keys are below:
		*==============================================================================
		* Method:            ToRFC4716PublicKey
		* Purpose:           Exports the public key to a string in RFC 4716 format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           An SSH formatted string.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Exports the public key to a string in RFC 4716 format. 
		** Sample RFC 4716 DSA and RSA public keys are below:
		** 
		** RSA Public Key
		** 
		** ---- BEGIN SSH2 PUBLIC KEY ----
		** 
		** Comment: "This is an optional comment"
		** AAAAB3NzaC1yc2EAAAADAQABAAABAQC9OMcyDX6cCiBjejxXzNcrB/5W5My0hmCA
		** KJRD01Tzzg94edu17OzHkpG4C02qFa2ASw2DT9oe/qj/sTgckT08KpWlRedNXWZk
		** TXgG+a6wKe7PUcudXcK1JbcE6H3yweLHC7QjjLZFnLSx9pMGfXMNe8K/aatUvkPV
		** Cc5nwH9WLl9x5B15ot7pTOPq9OLkwFaPO9WiD/EOvS0SjgU9Ga7pJSSZPOHASIRN
		** Jybmo6b1WdOvY72wKJsU+aqs4MYDOmP85YgfZEwxPUH02Xo/om8dZlz3auqtRVkc
		** GRKhqQ1aTK0s3mNbLHAh0IXFC8KcAqJzu46h0xKKoNQ8kceU8iCH
		** 
		** ---- END SSH2 PUBLIC KEY ----
		** 
		** DSA Public Key
		** 
		** ---- BEGIN SSH2 PUBLIC KEY ----
		** 
		** Comment: "This is an optional comment"
		** AAAAB3NzaC1kc3MAAAEBAKo/+RUI3bL8WrCL8XRCmyHtErh3ycZS0nQqryrJJ6Z9
		** ulAUnVucF6olEpi61O5iyEQFcXUO7pnKdzfMP3SIlZIib5vrVEKpT2K3ep9iSvnk
		** NJRrT3prJ+n0Mx4VJhtIwhYKLd5zaHbKW+XrlMVa1NAQqtj6SkbhirenMquaBAL5
		** YNSuqb6c3vLWfnrWRk6DdrgUP98rBo4Ig7N2YIf5N6PvFLXrgXY3fGsBB3CMxZpf
		** MN/l1hI7jrJVq3WvCojwkWRECGzX4ma3E8wHnzUcyYSiS+hJLglPt6GaPAy+l3Pt
		** Dm5JOuOpGFeaA2GzwQ5jSEAQq+qHTR51pwQZ0rN02y0AAAAVANkiO001oz4lzhsO
		** /tDx9rpOyH/5AAABAA8UN/pP7CYBI1KJ5KvBM7SSd5S5ItjA2ALboHF5uAWBKpaJ
		** vaHyHi/v/eCd1BahglmdTsWoP2W5p4HmHjr6fLseuPGyLTHkGFgKd/zC5eTBid8S
		** hNPJIByKm7XVGvLFhDqhiNKIIsOqYKYkNXmQjms5VInwT4GfE2orVr5MPSg3k3Dt
		** X220CIrEBaPXK4JRdrq2Jezxh7Pp76w+ZEfaQhgf9uEPWtBe0zmKsQ2gjdjRphm+
		** tl4gFR0r4JuJeOTs9UZ4rZlMojK2Ew64rHhaAROHHjOJiQdvBEBYxXNru71sqt7x
		** QbYtqHBR+oBgRFbPPouNMIUexC4DKxyNeuN2zIcAAAEAXh/Akb90+cojwtyjzXTx
		** A9h4CzfTE1G0cWziwToFYPVt/xWZM1/kDEAWRWtTDidZWRxWXxP+8J7PrMwA4Pwo
		** q2SPW1u9qQh1mGpPaPDluPiRbMKL2uV9oLfVEY7naVrqH05EPgtbiNjDin7EQljo
		** 3IoKzpEKB1lFHT/Vd4CMTdl7o+QhZ5ftMGv9sbmf2eZ6y9fQpebO7o4w7/LgQ5Sa
		** IWYaCiTZWNTS4vLeNBuJBVJL/pL3tMQrQFqHAg4o94q6M5Y6NvnsSoyZ3gs5bnuy
		** H/wk2oXdlNhRVx1DMYBSdeWRlgjLYUBEKDABs+1N/9nBIZDEUQYvVA71Fawp4cqi
		** zg==
		** 
		** ---- END SSH2 PUBLIC KEY ----
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, ;
		loException AS Exception, lcString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcString = m.loChilkatObject.ToRFC4716PublicKey()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE toxml		&& Exports an SSH key to XML. Samples of RSA and DSA private keys are shown below:
		*==============================================================================
		* Method:            ToXML
		* Purpose:           Exports an SSH key to XML.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           An XMLformatted string.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Exports an SSH key to XML. Samples of RSA and DSA private keys are shown below:
		**
		** DSA Key
		** 
		** <DSAKeyValue>
		**     <P>qj/5FQjdsvxasIvxd......Ss3TbLQ==</P>
		**     <Q>2SI7TTWjPiXOGw7+0PH2uk7If/k=</Q>
		**     <G>DxQ3+k/sJgEjUon......643bMhw==</G>
		**     <Y>Xh/Akb90+cojwty.....VA71p4cqizg==</Y>
		**     <X>ojilJuWXOyBTQ0H4hBNBTsL9Mq8=</X>
		** </DSAKeyValue>
		** 
		** RSA Key
		** 
		** <RSAKeyValue>
		**     <Modulus>vTjHMg1+n.....JHHlPIghw==</Modulus>
		**     <Exponent>AQAB</Exponent>
		**     <P>zfbbQagHiP48y.....udBR7n5w+MhP7c=</P>
		**     <Q>6zCwDGB8ipB....dSEy+BvdVRv9hbE=</Q>
		**     <DP>zcNdvlUg2g......9F72NjnAhQUjc=</DP>
		**     <DQ>1XB2FIVsA.....qNewUutJKWXcE=</DQ>
		**     <InverseQ>qHYYHyZI9d....VuqCeqsMeJ9I=</InverseQ>
		**     <D>Ar1Xgk/P1t4fd2Ryr........Onkwwn4Q==</D>
		** </RSAKeyValue>
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, ;
		loException AS Exception, lcXMLString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXMLString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcXMLString = m.loChilkatObject.ToXML()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXMLString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat SSHKey UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve the Chilkat SSHKey UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        04/08/2022
		*==============================================================================
		
		** 
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string, and should typically remain empty.
		**
		** Can be set to a list of the following comma separated keywords:
		** 
		** "DES-EDE3-CBC" - Use older Triple-DES encryption (instead of the default AES-128-CBC) 
		** when creating encrypted OpenSSH private keys.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SSHKey UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [UncommonOptions_SSHKey]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE usepkcs11		&& Introduced in version 9.5.0.96. Use a private key in a PKCS11 session for public-key authentication, where your private key is on an HSM, such as a smart card or hardware token. Both the public and private key handles must be provided.
		*==============================================================================
		* Method:            UsePKCS11
		* Purpose:           Use a private key in a PKCS11 session for public-key authentication. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPKCS11, a Chilkat PKCS11 object.
		*                    tiPrivateKeyHandle, a private key handle.
		*                    tiPublicKeyHandle, a public key handle.
		*                    tcKeyType -- the key type.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Use a private key in a PKCS11 session for public-key authentication, 
		** where your private key is on an HSM, such as a smart card or hardware token. 
		** Both the public and private key handles must be provided. 
		** The keyType can be "RSA" or "EC".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatPkcs11 AS CHILKAT_PKCS11_COM_CALL, tiPrivateKeyHandle AS Integer, ;
		tiPublicKeyHandle AS Integer, tcKeyType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, loException AS Exception, ;
		loParkParameterPkcs11 AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPkcs11 AS CHILKAT_PKCS11_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPkcs11, m.loChilkatPkcs11
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterPkcs11 = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPkcs11)
		
		    loChilkatPkcs11 = m.loParkParameterPkcs11.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.UsePkcs11(m.loChilkatPkcs11, ;
		      m.tiPrivateKeyHandle, m.tiPublicKeyHandle, m.tcKeyType) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatPkcs11 = ;
		    m.loParkParameterPkcs11.SetObject(m.toChilkatPkcs11, m.loChilkatPkcs11)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPkcs11, m.loChilkatPkcs11
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  toChilkatPkcs11 = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loParkParameterPkcs11 = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPkcs11 = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE usesshcertificate		&& Introduced in version 11.0.0. Loads an SSH certificate into this object. Although an SSH certificate is not a public or private key, it can be used as an SSH key for public key authentication in SSH/SFTP.
		*==============================================================================
		* Method:            UseSSHCertificate
		* Purpose:           Loads an SSH certificate into this object. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSSHCertificate -- the SSH Certificate text file string.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Loads an SSH certificate into this object. Although an SSH certificate is not a public or private key, 
		** it can be used as an SSH key for public key authentication in SSH/SFTP. 
		** This allows the use of an SSH certificate in place of a key.
		**
		** The SSH certificate (user_key-cert.pub) is a text file, just like a regular SSH public key. 
		** It follows the same OpenSSH-style format and is Base64-encoded, making it human-readable.
		** 
		** Here’s what an SSH user certificate looks like:
		** 
		** ssh-rsa-cert-v01@openssh.com AAAAHHNzaC1yc2EAAAADAQABAAABAQC...AAE= user@host
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcSSHCertificate AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.UseSSHCertificate(m.tcSSHCertificate) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat SSHKey VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        04/08/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS sshtunnel AS ibasechilkat OF "chilkatvfp.vcx" 		&& The SSH tunnel class provides for the ability to run a self-contained SSH tunnel in a background thread. It can behave as a SOCKS proxy, accepting connections from SOCKS4 or SOCK5 proxy clients and fowarding connections through an SSH tunnel. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat SSHTunnel AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: acceptlogpath_access		&& Access method used to retrieve the Chilkat SSHTunnel AcceptLogPath property.
		*m: acceptlogpath_assign		&& Assign method used to hold a reference to the AcceptLogPath property.
		*m: acceptlog_access		&& Access method used to retrieve the Chilkat SSHTunnel AcceptLog property.
		*m: acceptlog_assign		&& Assign method used to hold a reference to the AcceptLog property.
		*m: authenticatepk		&& Introduced in version 9.5.0.50. Authenticates with the SSH server using public-key authentication. The corresponding public key must have been installed on the SSH server for the username.
		*m: authenticatepkasync		&& Introduced in version 9.5.0.50. Creates an asynchronous task to call the AuthenticatePk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: authenticatepw		&& Introduced in version 9.5.0.50. Authenticates with the SSH server using a login and password. An SSH session always begins by first calling Connect to connect to the SSH server, and then calling either AuthenticatePw or AuthenticatePk to login.
		*m: authenticatepwasync		&& Introduced in version 9.5.0.50. Creates an asynchronous task to call the AuthenticatePwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.). Note: Async method event callbacks happen in the background thread.
		*m: authenticatepwpk		&& Introduced in version 9.5.0.50. Authentication for SSH servers that require both a password and private key. (Most SSH servers are configured to require one or the other, but not both.)
		*m: authenticatepwpkasync		&& Introduced in version 9.5.0.50. Creates an asynchronous task to call the AuthenticatePwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authenticatesecpw		&& Introduced in version 9.5.0.71. The same as AuthenticatePw, except the login and password strings are passed in secure string objects. Returns 1 for success, 0 for failure.
		*m: authenticatesecpwasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the AuthenticateSecPw method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authenticatesecpwpk		&& Introduced in version 9.5.0.71. The same as AuthenticatePwPk, except the login and password strings are passed in secure string objects. Returns 1 for success, 0 for failure.
		*m: authenticatesecpwpkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the AuthenticateSecPwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: beginaccepting		&& Starts a background thread for listening on listenPort. A new SSH tunnel is created and managed for each accepted connection. SSH tunnels are managed in a 2nd background thread: the SSH tunnel pool thread.
		*m: beginacceptingasync		&& Creates an asynchronous task to call the BeginAccepting method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: clientidentifier_access		&& Access method used to retrieve the Chilkat SSHTunnel ClientIdentifier property.
		*m: clientidentifier_assign		&& Assign method used to hold a reference to the ClientIdentifier property.
		*m: clientlogdir_access		&& Access method used to retrieve the Chilkat SSHTunnel ClientLogDir property.
		*m: clientlogdir_assign		&& Assign method used to hold a reference to the ClientLogDir property.
		*m: closetunnel		&& Introduced in version 9.5.0.50. Closes the SSH tunnel and disconnects all existing clients. If waitForThreads is 1, the method will wait for the tunnel and client threads to exit before returning. Returns 1 for success, 0 for failure.
		*m: connect		&& Introduced in version 9.5.0.50. Connects to the SSH server to be used for SSH tunneling. Important: Make sure to call CloseTunnel when finished with the tunnel, such as before exiting your program.
		*m: connectasync		&& Introduced in version 9.5.0.50. Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: connectthroughssh		&& Introduced in version 9.5.0.55. Connects to an SSH server through an existing SSH connection. The ssh is an existing connected and authenticated SSH object. The connection to hostname:port is made through the existing SSH connection via port-forwarding.
		*m: connectthroughsshasync		&& Introduced in version 9.5.0.55. Creates an asynchronous task to call the ConnectThroughSsh method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: connecttimeoutms_access		&& Access method used to retrieve the Chilkat SSHTunnel ConnectTimeoutMs property.
		*m: connecttimeoutms_assign		&& Assign method used to hold a reference to the ConnectTimeoutMs property.
		*m: continuekeyboardauth		&& Introduced in version 9.5.0.78. Continues keyboard-interactive authentication with the SSH server. The response is typically the password.
		*m: continuekeyboardauthasync		&& Introduced in version 9.5.0.78. Creates an asynchronous task to call the ContinueKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SSHTunnel DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: desthostname_access		&& Access method used to retrieve the Chilkat SSHTunnel DestHostName property.
		*m: desthostname_assign		&& Assign method used to hold a reference to the DestHostName property.
		*m: destport_access		&& Access method used to retrieve the Chilkat SSHTunnel DestPort property.
		*m: destport_assign		&& Assign method used to hold a reference to the DestPort property.
		*m: disconnectallclients		&& Introduced in version 9.5.0.50. Disconnects all clients, keeping the SSH tunnel open. If waitForThreads is 1, the method will wait for the client threads to exit before returning. Returns 1 for success, 0 for failure.
		*m: dynamicportforwarding_access		&& Access method used to retrieve the Chilkat SSHTunnel DynamicPortForwarding property.
		*m: dynamicportforwarding_assign		&& Assign method used to hold a reference to the DynamicPortForwarding property.
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat SSHTunnel EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: getcurrentstate		&& Introduced in version 9.5.0.65. Returns the current state of existing tunnels in an XML string. Returns Nothing on failure.
		*m: hostkeyfingerprint_access		&& Access method used to retrieve the Chilkat SSHTunnel HostKeyFingerprint property.
		*m: hostkeyfingerprint_assign		&& Assign method used to hold a reference to the HostKeyFingerprint property.
		*m: httpproxyauthmethod_access		&& Access method used to retrieve the Chilkat SSHTunnel HTTPProxyAuthMethod property.
		*m: httpproxyauthmethod_assign		&& Assign method used to hold a reference to the HTTPProxyAuthMethod property.
		*m: httpproxydomain_access		&& Access method used to retrieve the Chilkat SSHTunnel HTTPProxyDomain property.
		*m: httpproxydomain_assign		&& Assign method used to hold a reference to the HTTPProxyDomain property.
		*m: httpproxyhostname_access		&& Access method used to retrieve the Chilkat SSHTunnel HTTPProxyHostname property.
		*m: httpproxyhostname_assign		&& Assign method used to hold a reference to the HTTPProxyHostname property.
		*m: httpproxypassword_access		&& Access method used to retrieve the Chilkat SSHTunnel HTTPProxyPassword property.
		*m: httpproxypassword_assign		&& Assign method used to hold a reference to the HTTPProxyPassword property.
		*m: httpproxyport_access		&& Access method used to retrieve the Chilkat SSHTunnel HTTPProxyPort property.
		*m: httpproxyport_assign		&& Assign method used to hold a reference to the HTTPProxyPort property.
		*m: httpproxyusername_access		&& Access method used to retrieve the Chilkat SSHTunnel HTTPProxyUsername property.
		*m: httpproxyusername_assign		&& Assign method used to hold a reference to the HTTPProxyUsername property.
		*m: idletimeoutms_access		&& Access method used to retrieve the Chilkat SSHTunnel IdleTimeoutMs property.
		*m: idletimeoutms_assign		&& Assign method used to hold a reference to the IdleTimeoutMs property.
		*m: inboundsockspassword_access		&& Access method used to retrieve the Chilkat SSHTunnel InboundSOCKSPassword property.
		*m: inboundsockspassword_assign		&& Assign method used to hold a reference to the InboundSOCKSPassword property.
		*m: inboundsocksusername_access		&& Access method used to retrieve the Chilkat SSHTunnel InboundSOCKSUsername property.
		*m: inboundsocksusername_assign		&& Assign method used to hold a reference to the InboundSOCKSUsername property.
		*m: isaccepting_access		&& Access method used to retrieve the Chilkat SSHTunnel IsAccepting property.
		*m: isaccepting_assign		&& Assign method used to hold a reference to the IsAccepting property.
		*m: issshconnected		&& Introduced in version 9.5.0.61. Returns 1 if connected to the SSH server. Returns 0 if the connection has been lost (or was never established).
		*m: keepacceptlog_access		&& Access method used to retrieve the Chilkat SSHTunnel KeepAcceptLog property.
		*m: keepacceptlog_assign		&& Assign method used to hold a reference to the KeepAcceptLog property.
		*m: keeptunnellog_access		&& Access method used to retrieve the Chilkat SSHTunnel KeepTunnelLog property.
		*m: keeptunnellog_assign		&& Assign method used to hold a reference to the KeepTunnelLog property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SSHTunnel LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat SSHTunnel LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat SSHTunnel LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText  property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat SSHTunnel LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SSHTunnel LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SSHTunnel LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SSHTunnel LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: listenbindipaddress_access		&& Access method used to retrieve the Chilkat SSHTunnel ListenBindIPAddress property.
		*m: listenbindipaddress_assign		&& Assign method used to hold a reference to the ListenBindIPAddress property.
		*m: listenport_access		&& Access method used to retrieve the Chilkat SSHTunnel ListenPort property.
		*m: listenport_assign		&& Assign method used to hold a reference to the ListenPort property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: outboundbindipaddress_access		&& Access method used to retrieve the Chilkat SSHTunnel OutboundBindIPAddress property.
		*m: outboundbindipaddress_assign		&& Assign method used to hold a reference to the OutboundBindIPAddress property.
		*m: outboundbindport_access		&& Access method used to retrieve the Chilkat SSHTunnel OutboundBindIPort property.
		*m: outboundbindport_assign		&& Assign method used to hold a reference to the OutboundBindPort property.
		*m: preferipv6_access		&& Access method used to retrieve the Chilkat SSHTunnel PreferIPV6 property.
		*m: preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*m: setallowedalgorithms		&& Introduced in version 9.5.0.99. Provides a way to specify the exact set of algorithms allowed for the connection.
		*m: sockshostname_access		&& Access method used to retrieve the Chilkat SSHTunnel SOCKSHostName property.
		*m: sockshostname_assign		&& Assign method used to hold a reference to the SOCKSHostName property.
		*m: sockspassword_access		&& Access method used to retrieve the Chilkat SSHTunnel SOCKSPassword property.
		*m: sockspassword_assign		&& Assign method used to hold a reference to the SOCKSPassword property.
		*m: socksport_access		&& Access method used to retrieve the Chilkat SSHTunnel SOCKSPort property.
		*m: socksport_assign		&& Assign method used to hold a reference to the SOCKSPort property.
		*m: socksusername_access		&& Access method used to retrieve the Chilkat SSHTunnel SOCKSUserName property.
		*m: socksusername_assign		&& Assign method used to hold a reference to the SOCKSUserName property.
		*m: socksversion_access		&& Access method used to retrieve the Chilkat SSHTunnel SOCKSVersion property.
		*m: socksversion_assign		&& Assign method used to hold a reference to the SOCKSVersion property.
		*m: sorcvbuf_access		&& Access method used to retrieve the Chilkat SSHTunnel SoRcvBuf property.
		*m: sorcvbuf_assign		&& Assign method used to hold a reference to the SoRcvBuf property.
		*m: sosndbuf_access		&& Access method used to retrieve the Chilkat SSHTunnel SoSndBuf property.
		*m: sosndbuf_assign		&& Assign method used to hold a reference to the SoSndBuf property.
		*m: startkeyboardauth		&& Introduced in version 9.5.0.78. Begins keyboard-interactive authentication with the SSH server. Returns an XML string providing the name, instruction, and prompts.
		*m: startkeyboardauthasync		&& Introduced in version 9.5.0.78. Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: stopaccepting		&& Stops the listen background thread. It is possible to continue accepting connections by re-calling BeginAccepting. If waitForThread is 1, the method will wait for the listen thread to exit before returning.
		*m: tcpnodelay_access		&& Access method used to retrieve the Chilkat SSHTunnel TCPNoDelay property.
		*m: tcpnodelay_assign		&& Assign method used to hold a reference to the TCPNoDelay property.
		*m: tunnellogpath_access		&& Access method used to retrieve the Chilkat SSHTunnel TunnelLogPath property.
		*m: tunnellogpath_assign		&& Assign method used to hold a reference to the TunnelLogPath property.
		*m: tunnellog_access		&& Access method used to retrieve the Chilkat SSHTunnel TunnelLog property.
		*m: tunnellog_assign		&& Assign method used to hold a reference to the TunnelLog property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat SSHTunnel UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat SSHTunnel VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: acceptlog		&& Contains an in-memory log of the listen thread. This will only contain content if the KeepAcceptLog property is 1.
		*p: acceptlogpath		&& Introduced in version 9.5.0.50. Specifies a log file to be kept for the activity in the listen thread.
		*p: clientidentifier		&& Introduced in version 9.5.0.95. The client-identifier string to be used when connecting to an SSH server.  ** Defaults to "SSH-2.0-PuTTY_Release_0.78".
		*p: clientlogdir		&& Introduced in version 11.1.0. If not empty, this property specifies a directory path where a log file for each tunnel client will be created. Each log file will be named in the format: tunnel_client_log_{random_id}.txt.
		*p: connecttimeoutms		&& Maximum number of milliseconds to wait when connecting to an SSH server. The default value is 10000 (i.e. 10 seconds). A value of 0 indicates no timeout (wait forever).
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: desthostname		&& The destination hostname or IP address (in dotted decimal notation) of the service (such as a database server). Data sent through the SSH tunnel is forwarded by the SSH server to this destination.
		*p: destport		&& The destination port of the service (such as a database server).
		*p: dynamicportforwarding		&& Introduced in version 9.5.0.50. If 1, then this behaves as a SOCKS proxy server for inbound connections.
		*p: enablesecrets		&& Introduced in version 11.5.0. This property that automatic resolution of credentials from the operating system’s secure storage. The default value is 0.
		*p: hostkeyfingerprint		&& Introduced in version 9.5.0.56. Set after connecting to an SSH server. The format of the fingerprint looks like this: "ssh-rsa 1024 68:ff:d1:4e:6c:ff:d7:b0:d6:58:73:85:07:bc:2e:d5"
		*p: httpproxyauthmethod		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy authentication method name. Valid choices are "Basic" or "NTLM".
		*p: httpproxydomain		&& The NTLM authentication domain (optional) if NTLM authentication is used w/ the HTTP proxy. Note: This is for the outbound connection to the SSH server. It is used when the outbound connection to the SSH server must go through an HTTP proxy.
		*p: httpproxyhostname		&& If an HTTP proxy is to be used, set this property to the HTTP proxy hostname or IPv4 address (in dotted decimal notation).
		*p: httpproxypassword		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy password. Note: This is for the outbound connection to the SSH server. It is used when the outbound connection to the SSH server must go through an HTTP proxy.
		*p: httpproxyport		&& If an HTTP proxy is to be used, set this property to the HTTP proxy port number. (Two commonly used HTTP proxy ports are 8080 and 3128.) Note: This is for the outbound connection to the SSH server.
		*p: httpproxyusername		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy login name. Note: This is for the outbound connection to the SSH server.
		*p: idletimeoutms		&& A tunnel will fail when progress for sending or receiving data halts for more than this number of milliseconds. The default value is 10,000 (which is 10 seconds). A timeout of 0 indicates an infinite wait time (i.e. no timeout).
		*p: inboundsockspassword		&& Introduced in version 9.5.0.50. If dynamic port forwarding is used, then this may be set to the password required for authenticating inbound connections.
		*p: inboundsocksusername		&& Introduced in version 9.5.0.50. If dynamic port forwarding is used, then this may be set to the username required for authenticating inbound connections. If no username is set, then the inbound connection needs no authentication.
		*p: isaccepting		&& 1 if a background thread is running and accepting connections.
		*p: keepacceptlog		&& If 1, then an in-memory log of the listen thread is kept. The default value is 0.
		*p: keeptunnellog		&& Introduced in version 9.5.0.50. If 1, then a log of the SSH tunnel thread activity is kept in memory. The default value is 0.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: listenbindipaddress		&& In most cases, this property does not need to be set. It is provided for cases where it is required to bind the listen socket to a specific IP address (usually for computers with multiple network interfaces or IP addresses).
		*p: listenport		&& If a port number equal to 0 is passed to BeginAccepting, then this property will contain the actual allocated port number used. Otherwise it is equal to the port number passed to BeginAccepting, or 0 if BeginAccepting was never called.
		*p: outboundbindipaddress		&& In most cases, this property does not need to be set. It is provided for cases where it is required to bind the socket that is to connect to the SSH server (in the background thread) to a specific IP address.
		*p: outboundbindport		&& Unless there is a specific requirement for binding to a specific port, leave this unset (at the default value of 0). (99.9% of all users should never need to set this property.)
		*p: preferipv6		&& Introduced in version 9.5.0.70. If 1, then use IPv6 over IPv4 when both are supported for a particular domain. The default value of this property is 0, which will choose IPv4 over IPv6.
		*p: sockshostname		&& The SOCKS4/SOCKS5 hostname or IPv4 address (in dotted decimal notation). This property is only used if the SocksVersion property is set to 4 or 5). Note: This is for the outbound connection to the SSH server.
		*p: sockspassword		&& The SOCKS5 password (if required). The SOCKS4 protocol does not include the use of a password, so this does not apply to SOCKS4. Note: This is for the outbound connection to the SSH server.
		*p: socksport		&& The SOCKS4/SOCKS5 proxy port. The default value is 1080. This property only applies if a SOCKS proxy is used (if the SocksVersion property is set to 4 or 5). Note: This is for the outbound connection to the SSH server.
		*p: socksusername		&& The SOCKS4/SOCKS5 proxy username. This property is only used if the SocksVersion property is set to 4 or 5). Note: This is for the outbound connection to the SSH server.
		*p: socksversion		&& SocksVersion May be set to one of the following integer values: 0 - No SOCKS proxy is used. This is the default. 4 - Connect via a SOCKS4 proxy. 5 - Connect via a SOCKS5 proxy. Note: This is for the outbound connection to the SSH server.
		*p: sorcvbuf		&& Sets the receive buffer size socket option. Normally, this property should be left unchanged. The default value is 4194304. This property can be increased if download performance seems slow. It is recommended to be a multiple of 4096.
		*p: sosndbuf		&& Sets the send buffer size socket option. Normally, this property should be left unchanged. The default value is 262144. This property can be increased if upload performance seems slow. It is recommended to be a multiple of 4096.
		*p: tcpnodelay		&& Controls whether the TCP_NODELAY socket option is used for the underlying TCP/IP socket. The default value is 0. Setting this property equal to 1 disables the Nagle algorithm and allows for better performance when small amounts of data are sent.
		*p: tunnellog		&& Introduced in version 9.5.0.50. Contains an in-memory log of the SSH tunnel thread. This will only contain content if the KeepTunnelLog property is 1.
		*p: tunnellogpath		&& Introduced in version 9.5.0.50. Set to keep a log file of the SSH tunnel thread.
		*p: uncommonoptions		&& Introduced in version 9.5.0.73. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		acceptlog = 
		acceptlogpath = 
		cchilkatclass = SshTunnel
		ceventhandlerclass = iBaseEventHandler
		clientidentifier = SSH-2.0-PuTTY_Release_0.78
		clientlogdir = 
		connecttimeoutms = 10000
		debuglogfilepath = 
		desthostname = 
		destport = 0
		dynamicportforwarding = 0
		enablesecrets = 0
		hostkeyfingerprint = 
		httpproxyauthmethod = 
		httpproxydomain = 
		httpproxyhostname = 
		httpproxypassword = 
		httpproxyport = 0
		httpproxyusername = 
		idletimeoutms = 10000
		inboundsockspassword = 
		inboundsocksusername = 
		isaccepting = 0
		keepacceptlog = 0
		keeptunnellog = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		listenbindipaddress = 
		listenport = 0
		Name = "sshtunnel"
		outboundbindipaddress = 
		outboundbindport = 0
		preferipv6 = 0
		sockshostname = 
		sockspassword = 
		socksport = 1080
		socksusername = 
		socksversion = 0
		sorcvbuf = 4194304
		sosndbuf = 262144
		tcpnodelay = 0
		tunnellog = 
		tunnellogpath = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat SSHTunnel AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSHTunnel AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        07/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        07/07/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE acceptlogpath_access		&& Access method used to retrieve the Chilkat SSHTunnel AcceptLogPath property.
		*==============================================================================
		* Method:            AcceptLogPath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSHTunnel AcceptLogPath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AcceptLogPath
		* Date Added:        07/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		** 
		** Specifies a log file to be kept for the activity in the listen thread.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 50
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE acceptlogpath_assign		&& Assign method used to hold a reference to the AcceptLogPath property.
		*==============================================================================
