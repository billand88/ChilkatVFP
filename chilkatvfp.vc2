		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet, m.loChilkatTask
		
		m.liReturnuIDs = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liReturnUIDs = .LogicalToBit(m.tuReturnUIDs)
		
		      loParkParameterMessageSet = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		      loChilkatMessageSet = m.loParkParameterMessageSet.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.QueryMbx(;
		        m.tcCriteria, m.liReturnUIDs, m.loChilkatMessageSet)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatMessageSet = m.loParkParameterMessageSet.SetObject(;
		      m.toChilkatMessageSet, m.loChilkatMessageSet)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMessageSet  = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loParkParameterMessageSet = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loChilkatTask = NEWOBJECT([Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE querythread		&& Introduced in version 11.0.0. Sends the THREAD command to search the already selected mailbox for messages that match bUid.
		*==============================================================================
		* Method:            QueryThread
		* Purpose:           Sends the THREAD command to search the already selected mailbox 
		*                    for messages that match bUid.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcThreadAlgorithm -- the thread algorithm.
		*                    tcSearchCriteria -- the Mbx wildcard pattern.
		*                    tuUIDs -- whether or not to retrieve retrieve UIDs.
		*                    toChilkatJSONObject -- a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Sends the THREAD command to search the already selected mailbox for messages that match bUid.
		** 
		** The following explanation is from RFC 5256 :
		** 
		**   The THREAD command is a variant of SEARCH with threading semantics 
		**   for the results.  Thread has two arguments before the searching 
		**   criteria argument: a threading algorithm and the searching 
		**   charset.
		**   
		**   The THREAD command first searches the mailbox for messages that
		**   match the given searching criteria using the charset argument for
		**   the interpretation of strings in the searching criteria.  It then
		**   returns the matching messages in an untagged THREAD response,
		**   threaded according to the specified threading algorithm.
		**   
		**   All collation is in ascending order.  Earlier dates collate before
		**   later dates and strings are collated according to ascending values.
		**   
		**   The defined threading algorithms are as follows:
		**   
		**         ORDEREDSUBJECT
		**   
		**            The ORDEREDSUBJECT threading algorithm is also referred to as
		**            "poor man's threading".  The searched messages are sorted by
		**            base subject and then by the sent date.  The messages are then
		**            split into separate threads, with each thread containing
		**            messages with the same base subject text.  Finally, the threads
		**            are sorted by the sent date of the first message in the thread.
		**   
		**            The top level or "root" in ORDEREDSUBJECT threading contains
		**            the first message of every thread.  All messages in the root
		**            are siblings of each other.  The second message of a thread is
		**            the child of the first message, and subsequent messages of the
		**            thread are siblings of the second message and hence children of
		**            the message at the root.  Hence, there are no grandchildren in
		**            ORDEREDSUBJECT threading.
		**   
		**            Children in ORDEREDSUBJECT threading do not have descendents.
		**            Client implementations SHOULD treat descendents of a child in a
		**            server response as being siblings of that child.
		**   
		**         REFERENCES
		**   
		**            The REFERENCES threading algorithm threads the searched
		**            messages by grouping them together in parent/child
		**            relationships based on which messages are replies to others.
		**            The parent/child relationships are built using two methods:
		**            reconstructing a message's ancestry using the references
		**            contained within it; and checking the original (not base)
		**            subject of a message to see if it is a reply to (or forward of)
		**            another message.
		**   
		** See RFC 5256 for more details:
		** 
		** The searchCriteria is passed through to the low-level IMAP protocol unmodified, 
		** and therefore the rules for the IMAP SEARCH command (RFC 3501) apply. 
		** See the documentation for the Search method for more details (and also see RFC 3501).
		** 
		** The results are returned in a JSON object to make it easy 
		** to parse the parent/child relationships. See the example below for details.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcThreadAlgorithm AS Character, tcSearchCriteria AS Character, ;
		tuUIDs AS Unknown, toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liSubscribedOnly AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUIDs
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUIDs = .LogicalToBit(m.tuUIDs)
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.QueryThread(m.tcThreadAlgorithm, m.tcSearchCriteria, ;
		        m.liUIDs, m.loChilkatJSONObject) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = m.loParkParameterJsonObject.SetObject(;
		      m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatJSONObject  = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE querythreadasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the QueryThread method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            QueryThreadAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    QueryThread method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcThreadAlgorithm -- the thread algorithm.
		*                    tcSearchCriteria -- the Mbx wildcard pattern.
		*                    tuUIDs -- whether or not to retrieve retrieve UIDs.
		*                    toChilkatJSONObject -- a Chilkat MailBoxes object.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Creates an asynchronous task to call the QueryThread method with the arguments provided. 
		** 
		** Note: Async method event callbacks happen in the background thread. 
