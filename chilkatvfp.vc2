	PROCEDURE encryptstream		&& Introduced in version 9.5.0.56. Encrypts a stream. Internally, the strm's source is read, encrypted, and the encrypted data written to the strm's sink. It does this in streaming fashion.
		*==============================================================================
		* Method:            EncryptStream
		* Purpose:           Encrypts a stream.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStream, a Chilkat Stream object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Encrypts a stream. Internally, the strm's source is read, encrypted, 
		** and the encrypted data written to the strm's sink. 
		** It does this in streaming fashion. Extremely large or even infinite streams 
		** can be encrypted with stable ungrowing memory usage.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStream AS CHILKAT_STREAM_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStream AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStream AS CHILKAT_STREAM_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStream = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStream)
		
		      loChilkatStream = m.loParkParameterStream.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.EncryptStream(m.loChilkatStream) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStream = ;
		      m.loParkParameterStream.SetObject(m.toChilkatStream, m.loChilkatStream)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loParkParameterStream = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encryptstreamasync		&& Introduced in version 9.5.0.56. Creates an asynchronous task to call the EncryptStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            EncryptStreamAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    EncryptStream method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStream, a Chilkat Stream object.
