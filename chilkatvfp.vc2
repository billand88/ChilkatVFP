		* Date Added:        05/25/2022
		*==============================================================================
		
		**
		** Sets the contents for a single cell in the CSV. The content may include any characters 
		** including CRLF's, double-quotes, and the delimiter character. 
		** The Save* methods automatically double-quote fields with special chars when saving. 
		** The Load* methods automatically parse double-quoted 
		** and/or escaped fields correctly when loading.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiRowIndex AS Integer, tiColumnIndex AS Integer, tcContent AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CSV_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetCell(m.tiRowIndex, m.tiColumnIndex, m.tcContent) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSV_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

