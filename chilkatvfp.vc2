	HIDDEN PROCEDURE ignoremustrevalidate_access		&& Access method used to retrieve the Chilkat HTTP IgnoreMustRevalidate property.
		*==============================================================================
		* Method:            IgnoreMustRevalidate_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP IgnoreMustRevalidate property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IgnoreMustRevalidate
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** Some HTTP responses contain a "Cache-Control: must-revalidate" header. 
		** If this is present, the server is requesting 
		** that the client always issue a revalidate HTTP request 
		** instead of serving the page directly from cache. 
		** If IgnoreMustRevalidate is set to 1, then Chilkat HTTP will serve the page 
		** directly from cache without revalidating until the page is no longer fresh.
		**
		** The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE ignoremustrevalidate_assign		&& Assign method used to hold a reference to the IgnoreMustRevalidate property.
		*==============================================================================
		* Method:            IgnoreMustRevalidate_Assign
		* Purpose:           Assign method used to hold a reference to the IgnoreMustRevalidate property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the IgnoreMustRevalidate property.
		* Returns:           
		* Date Added:        01/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE ignorenocache_access		&& Access method used to retrieve the Chilkat HTTP IgnoreNoCache property.
		*==============================================================================
		* Method:            IgnoreNoCache_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP IgnoreNoCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IgnoreNoCache
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** Some HTTP responses contain headers of various types 
		** that indicate that the page should not be cached. 
		** Chilkat HTTP will adhere to this unless this property is set to 1.
		**
		** The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE ignorenocache_assign		&& Assign method used to hold a reference to the IgnoreNoCache property.
		*==============================================================================
		* Method:            IgnoreNoCache_Assign
		* Purpose:           Assign method used to hold a reference to the IgnoreNoCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the IgnoreNoCache property.
		* Returns:           
		* Date Added:        01/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        02/01/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of ChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		loVersioning = NULL
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Starting with 11.6.0 test
		      IF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(11, 6, 0)
		
		        .AllowHeaderFolding = 0
		
		      ENDIF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(11, 6, 0)
		      ** End before version 76 test
		
		      ** Before version 76 test
		      IF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 76)
		
		        .ReadTimeout = 20
		
		      ENDIF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 76)
		      ** End before version 76 test
		
		      ** Before version 73 test
		      IF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 73)
		
		        .S3SSL = 0
		
		      ENDIF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 73)
		      ** End before version 76 test
		
		      ** Before version 72 test
		      IF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 72)
		
		        .AWSSignatureVersion = 2
		
		      ENDIF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 72)
		      ** End before version 72 test
		
		      ** Before version 44 test
		      IF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 44)
		
		        .RedirectVerb = []
		
		      ENDIF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 44)
		      ** End before version 44 test
		
		      ** Before version 22 test
		      IF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 22)
		
		        .Accept = [*/*]
		        .AcceptCharset = [ISO-8859-1,utf-8;q=0.7,*;q=0.7]
		
		      ENDIF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 22)
		      ** End before version 22 test
		
		    ELSE
		
		      llReturn = .F.
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have versioning object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loVersioning = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE isunlocked		&& Undocumented method! Returns true if the class has been unlocked. It is necessary to call UnlockComponent before calling any other methods. Passing any string to UnlockComponent will automatically activate a 30-day trial period.
		*==============================================================================
		* Method:            IsUnlocked
		* Purpose:           Undocumented method! Returns true if the class has been unlocked.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		** 
		** Undocumented method! Returns true if the class has been unlocked. 
		** It is necessary to call UnlockComponent before calling any other methods. 
		** Passing any string to UnlockComponent will automatically activate a 30-day trial period.
		**
		** Version 11.0.0: Method removed.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.IsUnlocked() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE keepeventlog_access		&& Access method used to retrieve the Chilkat HTTP KeepEventLog property.
		*==============================================================================
		* Method:            KeepEventLog_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP KeepEventLog property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.KeepEventLog
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented property!
		**
		** If true, an in-memory event log is kept for any method that communicates with
		** an HTTP server (such as Download, PostUrlEncoded, QuickGetStr,
		** SynchronousRequest, etc.). When HTTP methods are called asynchronously, the
		** event log can be checked while the HTTP operation is in in progress. This is
		** done by examining the EventLogCount property and then fetching each event's name
		** and value via the EventLogName and EventLogValue methods. 
		** 
		** See this example: Asynchronous HTTP <http://www.cknotes.com/?p=271> .
		**  
		** The ClearBgEventLog method may be called to clear the in-memory event log.
		**  
		** Important: If event logging is enabled, make sure to clear the event log after
		** each HTTP method call. Otherwise the log will continue to grow without bounds.
		** 
		** The default value of this property is false.
		**  
		** The following items may be found in the event log:
		** Name
		** Value
		** 
		** SocketConnect
		** hostname:port, called when initiating a connection.
		**  
		** SocketConnected
		** hostname:port, called after successfully connected.
		** 
		** HttpProxyConnect
		** hostname:port
		** 
		** SslHandshake
		** "Starting"/"Finished"
		** 
		** HttpGetBegin
		** URL
		** 
		** HttpCacheHit
		** "Returning page from cache."
		** 
		** HttpInfo
		** various conditions...
		** "Begin reading response" -- called when beginning to read the response.
		** "Finished reading response"
		** "Existing connection with HTTP server no longer open, restarting GET with new
		** connection."
		** "Reading chunked response."
		** "UnGzipping response data"
		** "Connection:close header is present"
		** 
		** GetRequest
		** the full HTTP GET request to be sent to the server.
		** 
		** ResponseHeader
		** the header of the HTTP response.
		** 
		** HttpStatusCode
		** HTTP response status code (integer)
		** 
		** ChunkSize
		** Size (in bytes) of next chunk in response.
		** 
		** ResponseContentLength
		** Non-chunked response size in bytes.
		** 
		** UnGzippedLength
		** If the response was gzip compressed, this is the uncompressed size.
		** 
		** HostnameResolve
		** hostname, Called when starting to resolve a hostname (to an IP address)
		** 
		** ResolvedToIp
		** dotted IP address, called after hostname is resolved.
		** 
		** HttpAuth
		** one of the following strings:
		** "Starting Negotiate Authentication"
		** "Starting NTLM Authentication"
		** "Adding Basic Authentication Header"
		** "Adding Proxy Authentication Header"
		** "Starting Proxy NTLM Authentication"
		** "Starting Digest Authentication"
		** 
		** CookieToSend
		** Value of a Set-Cookie header field to be added to the outgoing request.
		**  
		** SavingCookie
		** XML of cookie being persisted.
		** 
		** HttpRedirect
		** Redirect URL
		** 
		** Socks4Connect
		** domain:port
		** 
		** Socks5Connect
		** domain:port
		**  
		** HttpRequestBegin
		** Verb (such as POST, GET, PUT), domain:port/path
		**  
		** RequestHeader
		** The full HTTP request header to be sent.
		** 
		** StartSendingRequest
		** Size of entire request, including header, in number of bytes. (Not called for
		** QuickGet) For uploads, this is the size of the entire upload (headers and all
		** files combined)
		** 
		** SubPartHeader
		** The header for one of the parts within a multipart request.
		** 
		** UploadFilename
		** The file about to be uploaded (streamed from file to socket..)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [LongBit]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 0
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		
	ENDPROC

