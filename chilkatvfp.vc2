	PROCEDURE getheadername		&& Returns the Nth request header field name. Indexing begins at 0, and the number of request header fields is specified by the NumHeaderFields property. Returns Nothing on failure
		*==============================================================================
		* Method:            GetHeaderName
		* Purpose:           Returns the Nth request header field name
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the header field index
		* Returns:           The name of the header.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Returns the Nth request header field name. 
		** Indexing begins at 0, and the number of request header fields 
		** is specified by the NumHeaderFields property.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, ;
		loException AS Exception, lcHeaderName AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHeaderName = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcHeaderName = m.loChilkatObject.GetHeaderName(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHeaderName
		
		** Design time IntelliSense test
		#IF .F.
		
