		RETURN
	ENDPROC

	HIDDEN PROCEDURE starttls_access		&& Access method used to retrieve the Chilkat IMAP StartTLS property.
		*==============================================================================
		* Method:            StartTLS_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP StartTLS property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.StartTLS
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** If 1, then the Connect method will (internallly) convert the connection 
		** to TLS/SSL via the STARTTLS IMAP command. This is called "explict SSL/TLS" 
		** because the client explicitly requests the connection be transformed 
		** into a TLS/SSL secure channel. The alternative is "implicit SSL/TLS" 
		** where the "Ssl" property is set to 1 and the IMAP client 
		** connects to the well-known TLS/SSL IMAP port of 993.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE starttls_assign		&& Assign method used to hold a reference to the StartTLS property.
		*==============================================================================
		* Method:            StartTLS_Assign
		* Purpose:           Assign method used to hold a reference to the StartTLS property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the StartTLS property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE storeflags		&& Sets one or more flags to a specific value for an email. The email is indicated by either a UID or sequence number, depending on whether bUid is 1 (UID) or 0 (sequence number). flagNames should be a space separated string of flag names.
		*==============================================================================
		* Method:            StoreFlags
		* Purpose:           Sets one or more flags to a specific value for an email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageID -- the message ID of the copied message.
		*                    tuUID -- whether or not the message ID is a UID.
		*                    tcFlagName -- the flag name to set the value against.
		*                    tuValue, whether or not it is set to on or off.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Sets one or more flags to a specific value for an email. 
		** The email is indicated by either a UID or sequence number, 
		** depending on whether bUid is 1 (UID) or 0 (sequence number).
		**
		** flagNames should be a space separated string of flag names. 
		** Both standard and customer flags may be set. 
		** Standard flag names typically begin with a backslash character. 
		** For example: "\Seen \Answered". Custom flag names may also be included. 
		** Custom flags often begin with a $ character, such as "$label1", or "$MailFlagBit0". 
		** Other customer flags may begin with any character, such as "NonJunk".
		** 
		** value should be 1 to turn the flags on, or 0 to turn the flags off.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiMessageID AS Integer, tuUID AS Unknown, ;
		tcFlagName AS Character, tuValue AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liValue AS Integer
		
		STORE 0 TO m.liUID, m.liValue, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUID = .LogicalToBit(m.tuUID)
		    liValue = .LogicalToBit(m.tuValue)
		
		    TRY
		 
		      STORE m.loChilkatObject.StoreFlags(m.tiMessageID, ;
		      m.liUID, m.tcFlagName, m.liValue) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE storeflagsasync		&& Creates an asynchronous task to call the StoreFlags method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            StoreFlagsAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    StoreFlags method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageID -- the message ID of the copied message.
		*                    tuUID -- whether or not the message ID is a UID.
		*                    tcFlagName -- the flag name to set the value against.
		*                    tuValue, whether or not it is set to on or off.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the StoreFlags method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		
		LPARAMETERS tiMessageID AS Integer, tuUID AS Unknown, ;
		tcFlagName AS Character, tuValue AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
