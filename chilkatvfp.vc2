		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setflags		&& Sets a flag for each message in the message set on the IMAP server. If value = 1, the flag is turned on, if value = 0, the flag is turned off.
		*==============================================================================
		* Method:            SetFlags
		* Purpose:           Sets a flag for each message in the message set on the IMAP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatMessageSet -- a Chilkat Message Set object.
		*                    tcFlagName -- the flag name to set the value against.
		*                    tuValue, whether or not it is set to on or off.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Sets a flag for each message in the message set on the IMAP server. 
		** If value = 1, the flag is turned on, if value = 0, the flag is turned off. 
		** Standard system flags such as "\Deleted", "\Seen", "\Answered", "\Flagged", 
		** "\Draft", and "\Answered" may be set. 
		** Custom flags such as "NonJunk", "$label1", "$MailFlagBit1", etc. may also be set.
		**
		** Fixed for Version 46: Fixed a problem in this method that occurred 
		** when an emtpy message set is passed in. In such a case, 
		** this method will do nothing and return true.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, ;
