		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Returns the Xml object that is the node's previous sibling, 
		** or NULL if there are no more.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, loChilkatXML AS CHILKAT_XML_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatXML
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatXML = m.loChilkatObject.PreviousSibling()
		
