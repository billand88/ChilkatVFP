		  loChilkatObject = NEWOBJECT(CHILKAT_DKIM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verifyinfo_access		&& Access method used to retrieve the Chilkat DKIM VerifyInfo property.
		*==============================================================================
		* Method:            VerifyInfo_Access
		* Purpose:           Access method used to retrieve 
		*                    the VerifyInfo property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerifyInfo
		* Date Added:        07/23/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.76
		**
		** Contains JSON with information about the last DKIM or DomainKey signature verified 
		** (or verification failure). The JSON will contain information like this:
		** 
		**   {
		**     "domain": "amazonses.com",
		**     "selector": "7v7vs6w47njt4pimodk5mmttbegzsi6n",
		**     "publicKey": "MIGfMA0GCSq...z6uqeQIDAQAB",
		**     "canonicalization": "relaxed/simple",
		**     "algorithm": "rsa-sha256",
		**     "signedHeaders": "Subject:From:To:Date:Mime-Version:Content-Type:References:Message-Id:Feedback-ID",
		**     "verified": "yes"
		**   }
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 76
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verifyinfo_assign		&& Assign method used to hold a reference to the VerifyInfo property.
		*==============================================================================
		* Method:            VerifyInfo_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerifyInfo of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the VerifyInfo property.
		* Returns:           
		* Date Added:        07/23/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 76
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS dns AS ibasechilkat OF "chilkatvfp.vcx" 		&& API for managing DNS nameservers to be used by Chilkat, and for doing DNS queries.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: adddefaultnameservers		&& Introduced in version 9.5.0.96. Adds the default (auto-assigned) nameservers to the collection of nameservers used by Chilkat for DNS queries and domain to IP address lookups.
		*m: addnameserver		&& Introduced in version 9.5.0.96. Adds a new nameserver to the collection of nameservers used by Chilkat for DNS queries and domain to IP address lookups. The ipAddr specifies the IPv4 address of the nameserver.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat DNS DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getnameserver		&& Introduced in version 9.5.0.96. Returns the IP address of the Nth nameserver currently used by Chilkat for DNS queries and domain to IP address lookups. The index specifies the index of the nameserver. The 1st nameserver is at index 0.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat DNS HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat DNS LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat DNS LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat DNS LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat DNS LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat DNS LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat DNS LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat DNS LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: maxwaitms_access		&& Access method used to retrieve the Chilkat DNS MaxWaitMs property.
		*m: maxwaitms_assign		&& Assign method used to hold a reference to the MaxWaitMs property.
		*m: numnameservers_access		&& Access method used to retrieve the Chilkat DNS NumNameservers property
		*m: numnameservers_assign		&& Assign method used to hold a reference to the NumNameservers property.
		*m: query		&& Introduced in version 9.5.0.96. Performs an DNS query for domain and returns the answer in answer. The type of DNS query is specified in recordType and can be A, AAAA, ALIAS, CAA, MX, NS, SOA, TXT. Additional record types can be added as needed.
		*m: queryasync		&& Introduced in version 9.5.0.96. Creates an asynchronous task to call the Query method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: removeallnameservers		&& Introduced in version 9.5.0.96. Removes all nameservers from the collection of nameservers used by Chilkat. An application can call this method to reset to 0 nameservers before adding new nameservers.
		*m: removenameserver		&& Introduced in version 9.5.0.96. Removes a nameserver from the collection of nameservers used by Chilkat. The ipAddr is the IPv4 address of the nameserver to be removed.
		*m: tlspref_access		&& Access method used to retrieve the Chilkat DNS TLSPref property.
		*m: tlspref_assign		&& Assign method used to hold a reference to the TLSPref property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat DNS UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncomonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat DNS VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort some methods call prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: lastbinaryresult		&& The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& The length, in characters, of the string contained in the LastStringResult property.
		*p: maxwaitms		&& Introduced in version 9.5.0.96. The maxiumum number of milliseconds to wait for the answer to a DNS query. A value of 0 is to wait indefinitely (no timeout). It's not a good idea to specify 0 (infinite timeout) or a value less than 1000 (1 second).
		*p: numnameservers		&& Introduced in version 9.5.0.96. The number of nameservers currently being used by Chilkat for DNS queries in all objects/classes, such as for HTTP, Email, FTP, SSH, etc.
		*p: tlspref		&& Specifies the TLS preference. Possible values are: 0 = No TLS 1 = Prefer TLS if possible. 2 = Require TLS. The default value is 0. If TLS is preferred then DNS nameservers with TLS capability will be tried first.
		*p: uncommonoptions		&& Introduced in version 11.4.0. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Dns
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		heartbeatms = 0
		iinstancepatch = 96
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		maxwaitms = 10000
		Name = "dns"
		numnameservers = 0
		tlspref = 0
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE adddefaultnameservers		&& Introduced in version 9.5.0.96. Adds the default (auto-assigned) nameservers to the collection of nameservers used by Chilkat for DNS queries and domain to IP address lookups.
		*==============================================================================
		* Method:            AddDefaultNameServers
		* Purpose:           Adds the default (auto-assigned) nameservers to the collection 
		*                    of nameservers for DNS queries and domain to IP address lookups.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Adds the default (auto-assigned) nameservers to the collection of nameservers 
		** used by Chilkat for DNS queries and domain to IP address lookups.
		**
		
		LOCAL loChilkatObject AS CHILKAT_DNS_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.AddDefaultNameServers()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DNS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addnameserver		&& Introduced in version 9.5.0.96. Adds a new nameserver to the collection of nameservers used by Chilkat for DNS queries and domain to IP address lookups. The ipAddr specifies the IPv4 address of the nameserver.
		*==============================================================================
		* Method:            AddNameserver
		* Purpose:           Adds a new nameserver to the collection of nameservers used by Chilkat.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcIPAddress, the IPV4 address of the nameserver.
		*                    tuSupportsTLS, whether or not the nameserver supports TLS.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Adds a new nameserver to the collection of nameservers used by Chilkat 
		** for DNS queries and domain to IP address lookups. The ipAddr specifies the IPv4 address of the nameserver. 
		** The supportsTls indicates if the namserver supports DoT 
		** (DNS over TLS. DoT uses port 853 for encrypted DNS communication.) 
		** If the TlsPreference property is set to 1 or 2, then Chilkat will use TLS nameservers.
		**
		
		LPARAMETERS tcIPAddress AS Character, tuSupportsTLS AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_DNS_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liSupportsTLS AS Integer, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild, m.liSupportsTLS
		
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSupportsTLS = .LogicalToBit(m.tuSupportsTLS)
		
		      TRY
		
		        STORE m.loChilkatObject.AddNameserver(m.tcIPAddress, m.liSupportsTLS) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DNS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.4.0
		
		  Added the UncommonOptions property.
		
		** Version 10.0.0
		
		  Regarding MX lookups, Chilkat now correctly follows the rule stated in RFC5321, Section 5: 
		  The lookup first attempts to locate an MX record associated with the name.  
		  If a CNAME record is found, the resulting name is processed as if it were the initial name. 
		  If an empty list of MXs is returned, the address is treated as if it was associated 
		  with an implicit MX RR, with a preference of 0, pointing to that host.
		
		** Version 99
		
		  Fixed a problem where Chilkat was not using the secondary DNS server if the primary DNS server failed.
		
		** Version 98
		
		  Fixed various DNS problems having to do with VPNs or other uncommon situations.
		
		** Version 97
		
		 Chilkat now automatically includes C:\Windows\System32\drivers\etc\Hosts as a source for IP address resolution.
		
		** Version 96
		
		  Created a new Dns class for managing DNS nameservers to be used by Chilkat, and for doing DNS queries.
		  It is a singleton class that allows an application to select the DNS nameservers used throughout Chilkat.
		  The term “singleton” means that all Chilkat DNS object instances work with a single copy
		  of internal DNS settings that are application wide. This allows for applications to use reliable
		  and high-speed public DNS servers such as Cloudfare, Google, and others.
		  It also allows for DNS over TLS (DoT), and the option to require all DNS queries to use TLS.
		  Also provides for a uniform way to do DNS queries over many DNS record types.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat DNS DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DNS DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        10/30/2023
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 96
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat DNS DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        10/30/2023
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 96
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE getnameserver		&& Introduced in version 9.5.0.96. Returns the IP address of the Nth nameserver currently used by Chilkat for DNS queries and domain to IP address lookups. The index specifies the index of the nameserver. The 1st nameserver is at index 0.
		*==============================================================================
		* Method:            GetNameserver
		* Purpose:           Returns the IP address of the Nth nameserver.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the namerserver array. 
		* Returns:           lcIPAddress, the IP Address of the Nth nameserver.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Returns the IP address of the Nth nameserver currently used by Chilkat 
		** for DNS queries and domain to IP address lookups. 
		** The index specifies the index of the nameserver. 
		** The 1st nameserver is at index 0.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_DNS_COM_CALL, loException AS Exception, ;
		lcIPAddress AS Character, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcIPAddress = []
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcIPAddress = m.loChilkatObject.GetNameserver(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcIPAddress
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DNS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat DNS HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DNS HeartbeatMs property.
