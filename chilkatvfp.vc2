	PROCEDURE writeentiretextfile		&& Opens filePath, writes textData using the character encoding specified by charset, and closes the file. If includedPreamble is 1 and the charset is Unicode or utf-8, then the BOM is included at the beginning of the file.
		*==============================================================================
		* Method:            WriteEntireTextFile
		* Purpose:           Opens filePath, writes textData using the character 
		*                    encoding specified by charset, and closes the file. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file to write.
		*                    tcTextData, the text data to write.
		*                    tcCharset, the extension for the file parts.
		*                    tuIncludedPreamble, whether or not BOM is included 
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Opens filePath, writes textData using the character encoding specified by charset, 
		** and closes the file. If includedPreamble is 1 and the charset is Unicode or utf-8, 
		** then the BOM is included at the beginning of the file.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath AS Character, tcTextData AS Character, ;
		tcCharset AS Character, tuIncludedPreamble AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liIncludedPreamble AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludedPreamble
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liIncludedPreamble = .LogicalToBit(m.tuIncludedPreamble)
		
		    TRY
		
		      STORE m.loChilkatObject.WriteEntireTextFile(m.tcFilePath, m.tcTextData, ;
		      m.tcCharset, m.liIncludedPreamble) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS ftp2 AS ibasechilkat OF "chilkatvfp.vcx" 		&& Commercial File Transfer Protocol (FTP) Component.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: account_access		&& Access method used to retrieve the Chilkat Account property.
		*m: account_assign		&& Assign method used to hold a reference to the Account property.
		*m: activeportrangeend_access		&& Access method used to retrieve the Chilkat ActivePortRangeEnd property.
		*m: activeportrangeend_assign		&& Assign method used to hold a reference to the ActivePortRangeEnd property.
		*m: activeportrangestart_access		&& Access method used to retrieve the Chilkat ActivePortRangeStart property.
		*m: activeportrangestart_assign		&& Assign method used to hold a reference to the ActivePortRangeStart property.
		*m: allocatesize_access		&& Access method used to retrieve the Chilkat AllocateSize property.
		*m: allocatesize_assign		&& Assign method used to hold a reference to the AllocateSize property.
		*m: allowmlsd_access		&& Access method used to retrieve the Chilkat AllowMSLD property.
		*m: allowmlsd_assign		&& Assign method used to hold a reference to the AllowMLSD property.
		*m: appendfile		&& Same as PutFile but the file on the FTP server is appended. If the remoteFilePath contains non-English characters, it may be necessary to set the DirListingCharset property equal to "utf-8".
		*m: appendfileasync		&& Creates an asynchronous task to call the AppendFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: appendfilebd		&& Introduced in version 11.0.0. Uploads data to be appended to a file on the FTP server. Returns 1 for success, 0 for failure.
		*m: appendfilebdasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the AppendFileBd method with the arguments provided.
		*m: appendfilefrombinarydata		&& Same as PutFileFromBinaryData, except the file on the FTP server is appended. Returns 1 for success, 0 for failure.
		*m: appendfilefrombinarydataasync		&& Creates an asynchronous task to call the AppendFileFromBinaryData method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: appendfilefromtextdata		&& Same as PutFileFromTextData, except the file on the FTP server is appended. Returns 1 for success, 0 for failure.
		*m: appendfilefromtextdataasync		&& Creates an asynchronous task to call the AppendFileFromTextData method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: appendfilesb		&& Introduced in version 11.0.0. Uploads the text data from sb to a file on the FTP server using the charset encoding specified in charset. Returns 1 for success, 0 for failure.
		*m: appendfilesbasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the AppendFileSb method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: asyncabort		&& Decremented function! Causes an asynchronous Get or Put to abort.
		*m: asyncappendfilestart		&& Decremented function! Initiates an asynchronous append. The file is uploaded and appended to an existing file on the FTP server. The append happens in a background thread and can be aborted by calling AsyncAbort.
		*m: asyncbytesreceivedstr_access		&& Access method used to retrieve the Chilkat AsyncBytesReceivedStr property.
		*m: asyncbytesreceivedstr_assign		&& Assign method used to hold a reference to the AsyncBytesReceivedStr property.
		*m: asyncbytesreceived_access		&& Access method used to retrieve the Chilkat AsyncBytesReceived property.
		*m: asyncbytesreceived_assign		&& Assign method used to hold a reference to the AsyncBytesReceived property.
		*m: asyncbytessentstr_access		&& Access method used to retrieve the Chilkat AsyncBytesSentStr property.
		*m: asyncbytessentstr_assign		&& Assign method used to hold a reference to the AsyncBytesSentStr property.
		*m: asyncbytessent_access		&& Access method used to retrieve the Chilkat AsyncBytesSent property.
		*m: asyncbytessent_assign		&& Assign method used to hold a reference to the AsyncBytesSent property.
		*m: asyncfinished		&& Decremented function! Set to true if the asynchronous transfer (download or upload) is finished. This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncgetfilestart		&& Decremented function! Initiates an asynchronous file download. The download happens in a background thread and can be aborted by calling AsyncAbort.
		*m: asynclog_access		&& Access method used to retrieve the Chilkat AsyncLog property.
		*m: asynclog_assign		&& Assign method used to hold a reference to the AsyncLog property.
		*m: asyncpercentdone_access		&& Access method used to retrieve the Chilkat AsyncPercentDone property.
		*m: asyncpercentdone_assign		&& Assign method used to hold a reference to the AsyncPercentDone property.
		*m: asyncputfilestart		&& Decremented function! Initiates an asynchronous file upload. The file is uploaded and creates a new file on the FTP server, or overwrites an existing file.
		*m: asyncsuccess		&& Decremented function! Set to true if the asynchronous file transfer succeeded. This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: authssl_access		&& Access method used to retrieve the Chilkat AuthSSL property.
		*m: authssl_assign		&& Assign method used to hold a reference to the AuthSSL property.
		*m: authtls_access		&& Access method used to retrieve the Chilkat AuthTLS property.
		*m: authtls_assign		&& Assign method used to hold a reference to the AuthTLS property.
		*m: autofeat_access		&& Access method used to retrieve the Chilkat AutoFEAT property.
		*m: autofeat_assign		&& Assign method used to hold a reference to the AutoFEAT property.
		*m: autofixsettings		&& Method to run after a connection is made to the server and the AutoFix property is set to 1.
		*m: autofix_access		&& Access method used to retrieve the Chilkat AutoFix property.
		*m: autofix_assign		&& Assign method used to hold a reference to the AutoFix property.
		*m: autogetsizeforprogress_access		&& Access method used to retrieve the Chilkat AutoGetSizeForProgress property.
		*m: autogetsizeforprogress_assign		&& Assign method used to hold a reference to the AutoGetSizeForProgress property.
		*m: autooptsutf8_access		&& Access method used to retrieve the Chilkat AutoOptsUTF8 property.
		*m: autooptsutf8_assign		&& Assign method used to hold a reference to the AutoOptsUTF8 property.
		*m: autosetuseepsv_access		&& Access method used to retrieve the Chilkat AutoSetUseEpsv property.
		*m: autosetuseepsv_assign		&& Assign method used to hold a reference to the AutoUseEspv property.
		*m: autosyst_access		&& Access method used to retrieve the Chilkat AutoSyst property.
		*m: autosyst_assign		&& Assign method used to hold a reference to the AutoSyst property.
		*m: autoxcrc_access		&& Access method used to retrieve the Chilkat AutoXCRC property.
		*m: autoxcrc_assign		&& Assign method used to hold a reference to the AutoXCRC property.
		*m: bandwidththrottledown_access		&& Access method used to retrieve the Chilkat BandwidthThrottleDown property.
		*m: bandwidththrottledown_assign		&& Assign method used to hold a reference to the BandwidthThrottleDown property.
		*m: bandwidththrottleup_access		&& Access method used to retrieve the Chilkat BandwidthThrottleUp property.
		*m: bandwidththrottleup_assign		&& Assign method used to hold a reference to the BandwidthThrottleUp property.
		*m: changeremotedir		&& Changes the current remote directory. The remoteDirPath should be relative to the current remote directory, which is initially the HOME directory of the FTP user account.
		*m: changeremotedirasync		&& Creates an asynchronous task to call the ChangeRemoteDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: checkconnection		&& Introduced in version 9.5.0.44. Returns 1 if currently connected and logged into an FTP server, otherwise returns 0. Note: This may cause a NOOP command to be sent to the FTP server. Returns 1 for success, 0 for failure.
		*m: checkconnectionasync		&& Creates an asynchronous task to call the CheckConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: clearcontrolchannel		&& Reverts the FTP control channel from SSL/TLS to an unencrypted channel. This may be required when using FTPS with AUTH TLS where the FTP client is behind a DSL or cable-modem router that performs NAT (network address translation).
		*m: clearcontrolchannelasync		&& Creates an asynchronous task to call the ClearControlChannel method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: cleardircache		&& The GetDirCount method returns the count of files and sub-directories in the current remote FTP directory, according to the ListPattern property.
		*m: clearsessionlog		&& Clears the in-memory session log.
		*m: clientipaddress_access		&& Access method used to retrieve the Chilkat ClientIPAddress property.
		*m: clientipaddress_assign		&& Assign method used to hold a reference to the ClientIPAddress property.
		*m: commandcharset_access		&& Access method used to retrieve the Chilkat CommandCharset property.
		*m: commandcharset_assign		&& Assign method used to hold a reference to the CommandCharset property.
		*m: connect		&& Connects and logs in to the FTP server using the username/password provided in the component properties. Check the integer value of the ConnectFailReason if this method returns 0 (indicating failure).
		*m: connectasync		&& Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: connectfailreason_access		&& Access method used to retrieve the Chilkat ConnectFailReason property.
		*m: connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*m: connectonly		&& Connects to the FTP server, but does not authenticate. The combination of calling this method followed by LoginAfterConnectOnly is the equivalent of calling the Connect method (which both connects and authenticates).
		*m: connectonlyasync		&& Creates an asynchronous task to call the ConnectOnly method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: connecttimeout_access		&& Access method used to retrieve the Chilkat ConnectTimeout property.
		*m: connecttimeout_assign		&& Assign method used to hold a reference to the ConnectTimeout property.
		*m: connectverified_access		&& Access method used to retrieve the Chilkat ConnectVerified property.
		*m: connectverified_assign		&& Assign method used to hold a reference to the ConnectVerified property.
		*m: converttotls		&& Explicitly converts the control channel to a secure SSL/TLS connection.
		*m: converttotlsasync		&& Creates an asynchronous task to call the ConvertToTls method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: createplan		&& Creates an "FTP plan" that lists the FTP operations that would be performed when PutTree is called. Additionally, the PutPlan method executes an "FTP plan" and logs each successful operation to a plan log file.
		*m: createplanasync		&& Creates an asynchronous task to call the CreatePlan method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: createremotedir		&& Creates a directory on the FTP server. If the directory already exists, a new one is not created and 0 is returned. If the remoteDirPath contains non-English characters, it may be necessary to set the DirListingCharset property equal to "utf-8".
		*m: createremotedirasync		&& Creates an asynchronous task to call the CreateRemoteDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: crlfmode_access		&& Access method used to retrieve the Chilkat CRLFMode property.
		*m: crlfmode_assign		&& Assign method used to hold a reference to the CRLFMode property.
		*m: curbytesreceivedstr_access		&& Access method used to retrieve the Chilkat CurBytesReceivedStr property.
		*m: curbytesreceivedstr_assign		&& Assign method used to hold a reference to the CurBytesReceivedStr property.
		*m: curbytesreceived_access		&& Access method used to retrieve the Chilkat CurBytesReceived property.
		*m: curbytesreceived_assign		&& Assign method used to hold a reference to the CurBytesReceived property.
		*m: curbytessentstr_access		&& Access method used to retrieve the Chilkat CurBytesSentStr property.
		*m: curbytessentstr_assign		&& Assign method used to hold a reference to the CurBytesSentStr property.
		*m: curbytessent_access		&& Access method used to retrieve the Chilkat CurBytesSent property.
		*m: curbytessent_assign		&& Assign method used to hold a reference to the CurBytesSent property.
		*m: dataprotection_access		&& Access method used to retrieve the Chilkat DataProtection property.
		*m: dataprotection_assign		&& Assign method used to hold a reference to the DataProtection property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deletematching		&& Deletes all the files in the current remote FTP directory matching the pattern. Returns the number of files deleted, or -1 for failure. The pattern is a string such as "*.txt", where any number of "*" wildcard characters can be used.
		*m: deletematchingasync		&& Creates an asynchronous task to call the DeleteMatching method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deleteremotefile		&& Deletes a file on the FTP server. If the remoteFilePath contains non-English characters, it may be necessary to set the DirListingCharset property equal to "utf-8". Please refer to the documentation for the DirListingCharset property.
		*m: deleteremotefileasync		&& Creates an asynchronous task to call the DeleteRemoteFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deletetree		&& Deletes the entire subtree and all files from the current remote FTP directory. To delete a subtree on the FTP server, your program would first navigate to the root of the subtree to be deleted by calling ChangeRemoteDir, and then call DeleteTree.
		*m: deletetreeasync		&& Creates an asynchronous task to call the DeleteTree method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: determineproxymethod		&& Automatically determines the ProxyMethod that should be used with an FTP proxy server. Tries each of the five possible ProxyMethod settings and returns the value (1-5) of the ProxyMethod that succeeded.
		*m: determineproxymethodasync		&& Creates an asynchronous task to call the DetermineProxyMethod method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: determinesettings		&& Discovers which combinations of FTP2 property settings result in successful data transfers.
		*m: determinesettingsasync		&& Creates an asynchronous task to call the DetermineSettings method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: dirlistingcharset_access		&& Access method used to retrieve the Chilkat DirListingCharset property.
		*m: dirlistingcharset_assign		&& Assign method used to hold a reference to the DirListingCharset property.
		*m: dirtreexml		&& Recursively downloads the structure of a complete remote directory tree. Returns an XML document with the directory structure. Note: Starting in version 9.5.0.47, the SyncMustMatch and SyncMustNotMatch properties apply to this method.
		*m: dirtreexmlasync		&& Creates an asynchronous task to call the DirTreeXml method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: disconnect		&& Disconnects from the FTP server, ending the current session. Returns 1 for success, 0 for failure.
		*m: disconnectasync		&& Creates an asynchronous task to call the Disconnect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: downloadtransferrate_access		&& Access method used to retrieve the Chilkat DownloadTransferRate property.
		*m: downloadtransferrate_assign		&& Assign method used to hold a reference to the DownloadTransferRate property.
		*m: downloadtree		&& Downloads an entire tree from the FTP server and recreates the directory tree on the local filesystem. This method downloads all the files and subdirectories in the current remote directory
		*m: downloadtreeasync		&& Creates an asynchronous task to call the DownloadTree method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat FTP2 EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: feat		&& Sends a FEAT command to the FTP server and returns the response. Returns a zero-length string to indicate failure.
		*m: featasync		&& Creates an asynchronous task to call the Feat method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: forceportipaddress_access		&& Access method used to retrieve the Chilkat ForceIPAddress property.
		*m: forceportipaddress_assign		&& Assign method used to hold a reference to the ForceIPAddress property.
		*m: getcreatedt		&& Returns the create date/time for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1). Returns Nothing on failure
		*m: getcreatedtasync		&& Creates an asynchronous task to call the GetCreateDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getcreatedtbyname		&& Returns the file-creation date/time for a remote file by filename. Note: The filename passed to this method must NOT include a path.
		*m: getcreatedtbynameasync		&& Creates an asynchronous task to call the GetCreateDtByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getcreatetime		&& Undocumented method! See GetCreateTimeStr method. It is assumed that this method returns the value in a DateTime format.
		*m: getcreatetimebyname		&& Undocumented function! Returns the file-creation date/time for a remote file by filename. Note: The filename passed to this method must NOT include a path.
		*m: getcreatetimebynamestr		&& Returns the file-creation date/time (in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500") for a remote file by filename. Note: The filename passed to this method must NOT include a path.
		*m: getcreatetimebynamestrasync		&& Creates an asynchronous task to call the GetCreateTimeByNameStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getcreatetimestr		&& Returns the create time (in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500") for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1)
		*m: getcreatetimestrasync		&& Creates an asynchronous task to call the GetCreateTimeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getcurrentremotedir		&& Returns the current remote directory. Returns Nothing on failure.
		*m: getcurrentremotedirasync		&& Creates an asynchronous task to call the GetCurrentRemoteDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getdircount		&& Introduced in version 9.5.0.44. Returns the number of files and sub-directories in the current remote directory that match the ListPattern property.
		*m: getdircountasync		&& Creates an asynchronous task to call the GetDirCount method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getfile		&& Downloads a file from the FTP server to the local filesystem.
		*m: getfileasync		&& Creates an asynchronous task to call the GetFile method with the arguments provided.
		*m: getfilebd		&& Introduced in version 9.5.0.62. Downloads a file from the FTP server into a BinData object.
		*m: getfilebdasync		&& Creates an asynchronous task to call the GetFileBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getfilename		&& Returns the filename for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1). Returns Nothing on failure
		*m: getfilenameasync		&& Creates an asynchronous task to call the GetFilename method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getfilesb		&& Introduced in version 9.5.0.62. Downloads a file from the FTP server into a StringBuilder object.
		*m: getfilesbasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the GetFileSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getfiletostream		&& Introduced in version 9.5.0.67. Downloads a file to a stream. If called synchronously, the remoteFilePath must have a sink, such as a file or another stream object. If called asynchronously, then the foreground thread can read the stream.
		*m: getfiletostreamasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the GetFileToStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getgroup		&& Introduced in version 9.5.0.50. Returns group name, if available, for the Nth file. If empty, then no group information is available.
		*m: getgroupasync		&& Creates an asynchronous task to call the GetGroup method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getisdirectory		&& Returns 1 for a sub-directory and 0 for a file, for the Nth entry in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1)
		*m: getisdirectoryasync		&& Creates an asynchronous task to call the GetIsDirectory method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getissymboliclink		&& Returns 1 if the remote file is a symbolic link. (Symbolic links only exist on Unix/Linux systems, not on Windows filesystems.)
		*m: getissymboliclinkasync		&& Creates an asynchronous task to call the GetIsSymbolicLink method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastaccessdt		&& Undocumented function! Returns the last access date/time for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (NumFilesAndDirs-1).
		*m: getlastaccessdtasync		&& Undocumented function! Creates an asynchronous task to call the GetLastAccessDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastaccessdtbyname		&& Undocumented function! Returns a remote file's last-access date/time. Note: The filename passed to this method must NOT include a path. Prior to calling this method, make sure to set the current remote directory.
		*m: getlastaccessdtbynameasync		&& Undocumented function! Creates an asynchronous task to call the GetLastAccessDtByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.).
		*m: getlastaccesstime		&& Undocumented function! Returns the last access date/time for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (NumFilesAndDirs-1).
		*m: getlastaccesstimebyname		&& Undocumented function! Returns a remote file's last-access date/time. Note: The filename passed to this method must NOT include a path.
		*m: getlastaccesstimebynamestr		&& Undocumented function! Returns a remote file's last-access date/time in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500".
		*m: getlastaccesstimebynamestrasync		&& Undocumented function! Creates an asynchronous task to call the GetLastAccesTimeByNameStrAsync method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastaccesstimestr		&& Undocumented function! Returns the last access date/time (in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500") for the Nth file or sub-directory in the current remote directory.
		*m: getlastaccesstimestrasync		&& Undocumented function! Creates an asynchronous task to call the GetLastAccessTimeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastjsondata		&& Introduced in version 11.5.0. Provides details about the last method called on this object instance. Returns 1 for success, 0 for failure.
		*m: getlastmoddt		&& Returns the last modified date/time for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1). Returns Nothing on failure.
		*m: getlastmoddtasync		&& Creates an asynchronous task to call the GetLastModDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastmoddtbyname		&& Returns the last-modified date/time for a remote file. Note: The filename passed to this method must NOT include a path.
		*m: getlastmoddtbynameasync		&& Creates an asynchronous task to call the GetLastModDtByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastmodifiedtime		&& Undocumented method! See GetLastModifiedStr method. It is assumed that this method returns the value in a DateTime format.
		*m: getlastmodifiedtimebyname		&& Undocumented method! Returns the last-modified date/time for a remote file. Note: The filename passed to this method must NOT include a path.
		*m: getlastmodifiedtimebynamestr		&& Returns a remote file's last-modified date/time in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500". Note: The filename passed to this method must NOT include a path.
		*m: getlastmodifiedtimebynamestrasync		&& Creates an asynchronous task to call the GetLastModifiedTimeByNameStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastmodifiedtimestr		&& Returns the last modified date/time (in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500") for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1)
		*m: getlastmodifiedtimestrasync		&& Creates an asynchronous task to call the GetLastModifiedTimeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getowner		&& Introduced in version 9.5.0.50. Returns owner name, if available, for the Nth file. If empty, then no owner information is available. Note: When MLSD is used to get directory listings, it is likely that the owner and group information is not transmitted
		*m: getownerasync		&& Creates an asynchronous task to call the GetOwner method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getpermissions		&& Returns permissions information, if available, for the Nth file. If empty, then no permissions information is available. The value returned by the GetPermType method defines the content and format of the permissions string returned by this method.
		*m: getpermissionsasync		&& Introduced in version 9.5.0.50. Creates an asynchronous task to call the GetPermissions method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getpermtype		&& Introduced in version 9.5.0.50. Returns the type of permissions information that is available for the Nth file.
		*m: getpermtypeasync		&& Introduced in version 9.5.0.50. Creates an asynchronous task to call the GetPermType method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getremotefilebinarydata		&& Downloads the contents of a remote file into a byte array. Returns a zero-length byte array (as a Variant) on failure.
		*m: getremotefilebinarydataasync		&& Creates an asynchronous task to call the GetRemoteFileBinaryData method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getremotefiletextc		&& Downloads a text file directly into a string variable. The character encoding of the text file is specified by the charset argument, which is a value such as utf-8, iso-8859-1, Shift_JIS, etc. Returns Nothing on failure
		*m: getremotefiletextcasync		&& Creates an asynchronous task to call the GetRemoteFileTextC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getremotefiletextdata		&& Downloads the content of a remote text file directly into an in-memory string.
		*m: getremotefiletextdataasync		&& Creates an asynchronous task to call the GetRemoteFileTextData method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getservercert		&& Introduced in version 11.0.0. Returns the FTP server's digital certificate (for SSL / TLS connections). Returns 1 for success, 0 for failure.
		*m: getsize		&& Returns the size of the Nth remote file in the current directory.
		*m: getsizeasync		&& Creates an asynchronous task to call the GetSize method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getsizebyname		&& Returns a remote file's size in bytes. Returns -1 if the file does not exist. Note: The filename passed to this method must NOT include a path.
		*m: getsizebynameasync		&& Creates an asynchronous task to call the GetSizeByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getsizestr		&& Returns the size in decimal string format of the Nth remote file in the current directory. This is helpful for cases when the file size (in bytes) is greater than what can fit in a 32-bit integer. Returns Nothing on failure
		*m: getsizestrasync		&& Creates an asynchronous task to call the GetSizeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getsizestrbyname		&& Returns the size of a remote file as a string. This is helpful when file a file size is greater than what can fit in a 32-bit integer
		*m: getsizestrbynameasync		&& Creates an asynchronous task to call the GetSizeStrByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getsslservercert		&& Returns the FTP server's digital certificate (for SSL / TLS connections). Returns Nothing on failure
		*m: getsyncedfiles		&& Introduced in version 10.0.0. Appends to strTable the paths of the files uploaded or downloaded in the last call to SyncDeleteTree, SyncLocalDir, SyncLocalTree, SyncRemoteTree, or SyncRemoteTree2.
		*m: gettextdirlisting		&& Returns a listing of the files and directories in the current directory matching the pattern. Passing "*.*" will return all the files and directories. Returns Nothing on failure
		*m: gettextdirlistingasync		&& Creates an asynchronous task to call the GetTextDirListing method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getxmldirlisting		&& Returns (in XML format) the files and directories in the current directory matching the pattern. Passing "*.*" will return all the files and directories.
		*m: getxmldirlistingasync		&& Creates an asynchronous task to call the GetXmlDirListing method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
