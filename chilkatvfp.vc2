	PROCEDURE preferredcharset		&& Method run to validate the data for the PreferredCharset property.
		*==============================================================================
		* Method:            PreferredCharset
		* Purpose:           Method run to validate the data for the PreferredCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/26/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		LOCAL ARRAY la_Valid[4]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		lcValue = UPPER(STRTRAN(m.lcValue, [ ]))
		
		la_Valid[1] = [GB2312]
		la_Valid[2] = [SHIFT_JIS]
		la_Valid[3] = [KS_C_5601-1987]
		la_Valid[4] = [WINDOWS-874]
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER) ;
		AND (EMPTY(m.lcValue) ;
		OR ASCAN(m.la_Valid, m.lcValue, -1, -1, 1, 15) > 0 ;
		OR LEFTC(m.lcValue, 9) == [ISO-8859-])
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

