	PROCEDURE verifyp7m		&& Verifies a .p7m file and extracts the original file from the .p7m. Returns 1 if the signature is valid and the contents are unchanged. Otherwise returns 0.
		*==============================================================================
		* Method:            VerifyP7M
		* Purpose:           Verifies a .p7m file and extracts the original file from the .p7m.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcP7MFilePath -- the path to the .p7m file.
		*                    tcOutputFileName -- the output file name.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Verifies a .p7m file and extracts the original file from the .p7m. 
		** Returns 1 if the signature is valid and the contents are unchanged. 
		** Otherwise returns 0.
		** 
		** Note: The signer certificates can be retrieved after any Verify* method call 
		** by using the NumSignerCerts property and the GetSignerCert method.
		**
		** Fixed for version 76: Fixed a rare problem where the this method 
		** could have huge memory usage for a particular ASN.1 situation.
		**
		** Fixed for version 79: Fixed crash bug (only happens under certain uncommon circumstances). 
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		
		LPARAMETERS tcP7MFilePath AS Character, tcOutputFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.VerifyP7M(;
		      m.tcP7MFilePath, m.tcOutputFileName) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

