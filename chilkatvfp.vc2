	HIDDEN PROCEDURE connected_access		&& Access method used to retrieve the Chilkat Mcp Connected property.
		*==============================================================================
		* Method:            Connected_Access
		* Purpose:           Access method used to retrieve 
		*                    the Connected property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Connected
		* Date Added:        09/06/2026
		*==============================================================================
		
		** 
		** Introduced in version 11.6.0
		** 
		** Read-only. 1 after a successful Connect (the initialize handshake completed).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connected_assign		&& Assign method used to hold a reference to the Connected property.
		*==============================================================================
		* Method:            Connected_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the Connected property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the Connected property.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE connecttimeoutms_access		&& Access method used to retrieve the Chilkat Mcp ConnectTimeout property.
		*==============================================================================
		* Method:            ConnectTimeoutMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the ConnectTimeoutMs property of the referenced Chilkat object.
		* Author:            Bill Anderson
