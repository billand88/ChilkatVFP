	PROCEDURE dsnnotify		&& Method run to validate the data for the DSNNotify property.
		*==============================================================================
		* Method:            DSNNotify
		* Purpose:           Method run to validate the data for the DSNNotify property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/16/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		lcValue AS Character, llValidated AS Logical
		
		LOCAL ARRAY la_Valid[14]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		lcValue = UPPER(STRTRAN(m.lcValue, [ ]))
		
		la_Valid[1] = [NEVER]
		la_Valid[2] = [SUCCESS]
		la_Valid[3] = [FAILURE]
		la_Valid[4] = [NOTIFY]
		la_Valid[5] = [SUCCESS,FAILURE]
		la_Valid[6] = [SUCCESS,NOTIFY]
		la_Valid[7] = [FAILURE,SUCCESS]
		la_Valid[8] = [FAILURE,NOTIFY]
		la_Valid[7] = [NOTIFY,SUCCESS]
		la_Valid[8] = [NOTIFY,FAILURE]
		la_Valid[9] = [SUCCESS,FAILURE,NOTIFY]
		la_Valid[10] = [SUCCESS,NOTIFY,FAILURE]
		la_Valid[11] = [FAILURE,SUCCESS,NOTIFY]
		la_Valid[12] = [FAILURE,NOTIFY,SUCCESS]
		la_Valid[13] = [NOTIFY,SUCCESS,FAILURE]
		la_Valid[14] = [NOTIFY,FAILURE,SUCCESS]
		
		llValidated = (VARTYPE(m.lcValue) == T_CHARACTER) ;
		AND (EMPTY(m.lcValue) ;
		OR ASCAN(m.la_Valid, m.lcValue, -1, -1, 1, 15) > 0)
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

