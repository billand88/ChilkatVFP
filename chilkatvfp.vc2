	PROCEDURE setflag		&& Sets one of the negotiate flags to be used in the Type 1 message sent by the client. It should normally be unnecessary to modify the default flag settings. For more information about flags, see the description for the Flags property above.
		*==============================================================================
		* Method:            SetFlag
		* Purpose:           Sets one of the negotiate flags to be used 
		*                    in the Type 1 message sent by the client.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFlagLetter -- the flag letter to set.
		*                    tuFlagSetting -- the setting of the on/off flag.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/16/2022
		*==============================================================================
		
		**
		** Sets one of the negotiate flags to be used in the Type 1 message sent by the client. 
		** It should normally be unnecessary to modify the default flag settings. 
		** For more information about flags, see the description for the Flags property above.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFlagLetter AS Character, tuFlagSetting AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_NTLM_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liFlagSetting AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liFlagSetting
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liFlagSetting = .LogicalToBit(m.tuFlagSetting)
		
		    TRY
		 
		      STORE m.loChilkatObject.SetFlag(m.tcFlagLetter, m.liFlagSetting) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_NTLM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE targetname_access		&& Access method used to retrieve the Chilkat NTLM TargetName property.
		*==============================================================================
		* Method:            TargetName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat NTLM TargetName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.TargetName
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** The authentication realm in which the authenticating account has membership, 
		** such as a domain for domain accounts, or a server name for local machine accounts. 
		** The TargetName is used in the Type2 message sent from the server to the client.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE targetname_assign		&& Assign method used to hold a reference to the TargetName property.
		*==============================================================================
		* Method:            TargetName_Assign
		* Purpose:           Assign method used to hold
		*                    the TargetName of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the TargetName property.
		* Returns:           
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE username_access		&& Access method used to retrieve the Chilkat NTLM UserName property.
		*==============================================================================
		* Method:            UserName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat NTLM UserName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
