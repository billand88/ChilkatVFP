	PROCEDURE getreport		&& Returns the body content of the Nth report within a multipart/report email.
		*==============================================================================
		* Method:            GetReport
		* Purpose:           Returns the body content of the Nth report within a multipart/report email. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the report array. 
		* Returns:           lcReport, the report.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** (See the NumReports property.) 
		** Returns the body content of the Nth report within a multipart/report email.
		**
		** Multipart/report is a message type that contains data formatted for a mail server to read. 
		** It is split between a text/plain (or some other content/type easily readable) 
		** and a message/delivery-status, which contains the data formatted for the mail server to read.
		**
		** It is defined in RFC 3462
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcReport AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcReport = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcReport = m.loChilkatObject.GetReport(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReport
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsignedbycert		&& Return the certificate used to digitally sign this email. Returns Nothing on failure
		*==============================================================================
		* Method:            GetSignedByCert
		* Purpose:           Return the certificate used to digitally sign this email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Certificate object or NULL
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Return the certificate used to digitally sign this email.
		**
		** Fixed for Version 59: Fixed this method so that it will 
		** still return the certificate even if the signature validation fails.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.GetSignedByCert()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

