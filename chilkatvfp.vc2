	HIDDEN PROCEDURE sizelimit_access		&& Access method used to retrieve a reference to the SizeLimit property.
		*==============================================================================
		* Method:            SizeLimit_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan SizeLimit property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SizeLimit
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** The MailMan will not try to retrieve mail messages from a POP3 server 
		** that are greater than this size limit. 
		** The default value is 0 indicating no size limit. 
		** The SizeLimit is specified in number of bytes.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sizelimit_assign		&& Assign method used to hold a reference to the SizeLimit property.
		*==============================================================================
		* Method:            SizeLimit_Assign
		* Purpose:           Assign method used to hold a reference to the SizeLimit property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used 
		*                    to hold a reference to the SizeLimit property.
		* Returns:           
		* Date Added:        01/13/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE smtpauthenticate		&& Authenticates with the SMTP server using the property settings such as SmtpUsername, SmtpPassword, etc. This method should only be called after a successful call to SmtpConnect.
		*==============================================================================
		* Method:            SMTPAuthenticate
		* Purpose:           Authenticates with the SMTP server using the property settings.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.48
		**
		** Authenticates with the SMTP server using the property 
		** settings such as SmtpUsername, SmtpPassword, etc. 
		** This method should only be called after a successful call to SmtpConnect.
		** 
		** Note 1: The OpenSmtpConnection method both connects and authenticates. 
		** It is the equivalent of calling SmtpConnect followed by SmtpAuthenticate.
		**
		** Note 2: All methods that communicate with the SMTP server, such as SendEmail, 
		** will automatically connect and authenticate if not already connected and authenticated.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 48
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SMTPAuthenticate() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE smtpauthenticateasync		&& Creates an asynchronous task to call the SmtpAuthenticate method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SMTPAuthenticateAsync
		* Purpose:           Creates an Asynchronous task to call the 
		*                    SMTPAuthenticate method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.48
		**
		** Creates an Asynchronous task to call the SMTPAuthenticate method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 48
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.SMTPAuthenticateAsync()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE smtpauthmethod_access		&& Access method used to retrieve a reference to the SMTPAuthMethod property.
		*==============================================================================
		* Method:            SMTPAuthMethod_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan SMTPAuthMethod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SMTPAuthMethod
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** This property should usually be left empty. 
		** The MailMan will by default choose the most secure login method available 
		** to prevent unencrypted username and passwords from being transmitted if possible. 
		** However, some SMTP servers may not advertise the acceptable authorization methods, 
		** and therefore it is not possible to automatically determine the best authorization method. 
		** To force a particular auth method, or to prevent any authorization from being used, 
		** set this property to one of the following values: "NONE", "LOGIN", "PLAIN", "CRAM-MD5", or "NTLM".
		** 
		** Note: If NTLM authentication does not succeed, 
		** set the Global.DefaultNtlmVersion property equal to 1 and then retry.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE smtpauthmethod_assign		&& Assign method used to hold a reference to the SMTPAuthMethod property.
		*==============================================================================
		* Method:            SMTPAuthMethod_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat MailMan SMTPAuthMethod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SMTPAuthMethod property.
		* Returns:           
		* Date Added:        01/13/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [SMTPAuthMethod]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE smtpconnect		&& Explicitly establishes a connection to the SMTP server, which includes establishing a secure TLS channel if required, and receives the initial greeting. This method stops short of authenticating.
		*==============================================================================
		* Method:            SMTPConnect
		* Purpose:           Explicitly establishes a connection to the SMTP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Explicitly establishes a connection to the SMTP server, 
		** which includes establishing a secure TLS channel if required, 
		** and receives the initial greeting. This method stops short of authenticating. 
		** The SmtpAuthenticate method should be called after a successful call to this method.
		**
		** Note 1: The OpenSmtpConnection method both connects and authenticates. 
		** It is the equivalent of calling SmtpConnect followed by SmtpAuthenticate.
		**
		** Note 2: All methods that communicate with the SMTP server, such as SendEmail, 
		** will automatically connect and authenticate if not already connected and authenticated.
		**
		** Important: All TCP-based Internet communications, regardless of the protocol 
		** (such as HTTP, FTP, SSH, IMAP, POP3, SMTP, etc.), and regardless of SSL/TLS, 
		** begin with establishing a TCP connection to a remote host:port. 
		** External security-related infrastructure such as software firewalls 
		** (Windows Firewall), hardware firewalls, anti-virus, at either source or destination 
		** (or both) can block the connection. 
		** If the connection fails, make sure to check all potential external causes of blockage.
		** 
		** Fixed for Version 49:  The internal automatic retry from EHLO to HELO did not work. 
		** If the SMTP server did not support EHLO, then EHLO was mistakenly tried a 2nd time instead of HELO.
		** 
		** Fixed for Version 53: A fix was made for some sitatuions 
		** where a server immediately wishes to renegotiate after connecting.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 48
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SMTPConnect() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		    ** Process successful test
		    IF m.liReturn = 1
		
		      .AutoFixSettings()
		
		    ENDIF m.liReturn = 1
		    ** End process successful test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE smtpconnectasync		&& Creates an asynchronous task to call the SmtpConnect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SMTPConnectAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    SmtpConnect method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the SmtpConnect method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		** 
		** Fixed for Version 53: A fix was made for some sitatuions 
		** where a server immediately wishes to renegotiate after connecting.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 48
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.SMTPConnectAsync()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		    ** Process successful test
		    IF NOT ISNULL(m.loChilkatTask)
		
		      .AutoFixSettings()
		
		    ENDIF NOT ISNULL(m.loChilkatTask)
		    ** End process successful test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE smtpfailreason_access		&& Access method used to retrieve a reference to the SMTPFailReason property.
		*==============================================================================
		* Method:            SMTPFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the SMTPFailReason property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SMTPFailReason
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.48
		** 
		** A keyword that indicates the cause of failure (or success) 
		** for the last SMTP related method called. Possible values are:
		**
		** 1) Success -- The method call was successful.
		** 2) Failed -- A general failure not covered by any of the other possible keywords.
		** 3) NoValidRecipients -- The SMTP server rejected all receipients.
		** 4) NoRecipients -- The app failed to provide any recipients (TO, CC, or BCC).
		** 5) SomeBadRecipients -- The AllOrNone property is 1, 
		**    and some recipients were rejected by the SMTP server.
		** 6) Aborted -- The application aborted the method.
		** 7) NoFrom -- The failed to provide a FROM address.
		** 8) FromFailure -- The SMTP replied with an error in response to the "MAIL FROM" command.
		** 9) NoCredentials -- The application did not provide the required credentials, 
		**    such as username or password.
		** 10) AuthFailure -- The login (authentication) failed.
		** 11) DataFailure -- The SMTP replied with an error in response to the "DATA" command.
		** 12) NoSmtpHostname -- The application failed to provide an SMTP hostname or IP address.
		** 13) StartTlsFailed -- Failed to convert the TCP connection to TLS via STARTTLS.
		** 14) ConnectFailed -- Unable to establish a TCP or TLS connection to the SMTP server.
		** 15) GreetingError -- The SMTP server immediately responded with an error status in the intial greeting.
		** 16) ConnectionLost -- The connection to the SMTP server was lost at some point during the method call.
		** 17) Timeout -- A timeout occurred when reading or writing the socket connection.
		** 18) RenderFailed -- A failure occurred when rendering the email. 
		**     (Rendering the email for sending includes tasks such as signing or encrypting.)
		** 19) NotUnlocked -- The UnlockComponent method was not previously called 
		**     on at least one instance of the mailman object.
		** 20) InternalFailure -- An internal failure that should be reported to Chilkat support.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 48
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

