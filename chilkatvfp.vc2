	PROCEDURE appendmimewithdatestr		&& The same as AppendMimeWithDate, except the date/time is provided in RFC822 string format, such as "Wed, 18 Oct 2017 09:08:21 GMT". Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendMIMEWithDateStr
		* Purpose:           The same as AppendMimeWithDate, except the date/time 
		*                    is provided in RFC822 string format
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMailBox -- the mailbox to append the MIME
		*                    tcMIMEText -- the MIME text to append.
		*                    tcDateString -- the date in string format
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** The same as AppendMimeWithDate, except the date/time is provided 
		** in RFC822 string format, such as "Wed, 18 Oct 2017 09:08:21 GMT".
		**
		** Fixed for version 70: If the date/time string passed to this method used “UTC”, 
		** such as in “18-Oct-2017 09:08:21 UTC”, then Chilkat would pass a date/time string without the UTC. 
		** This caused the IMAP server (or at least one particular IMAP server) to use it’s local date/time. 
		** The IMAP RFC specifies that the timezone part of the date/time string should be 
		** in the format +/- 4DIGIT, such as “+0800”. 
		** Chilkat now automatically converts the “UTC” (or GMT) to “+0000”.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMailBox AS Character, ;
		tcMIMEText AS Character, tcDateString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendMIMEWithDateStr(m.tcMailBox, ;
		      m.tcMIMEText, m.tcDateString) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

