	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat SCP HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** This is the number of milliseconds between each AbortCheck event callback. 
		** The AbortCheck callback allows an application to abort 
		** any SSH operation prior to completion. If HeartbeatMs is 0 (the default), 
		** no AbortCheck event callbacks will fire.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold a reference to the HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the HeartbeatMs property.
		* Returns:           
		* Date Added:        07/09/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 51
		
		lcValidationMethod = [HeartbeatMs]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        07/09/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of ChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		loVersioning = NULL
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Before version 79 test
		      IF m.liCalculatedBuildNumber <= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 79)
		
		        ** Set the SendEnv property in VFP...
		        .SendEnv = .SendEnv
		
		      ENDIF m.liCalculatedBuildNumber <= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 79)
		      ** End before version 79 test
		
		    ELSE
		
		      llReturn = .F.
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have a good object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loVersioning = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
		
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat SCP LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
