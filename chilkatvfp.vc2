	ENDPROC

	PROCEDURE renderget		&& Same as QuickGet, but does not send the HTTP GET. Instead, it builds the HTTP request that would've been sent and returns it. Returns Nothing on failure.
		*==============================================================================
		* Method:            RenderGet
		* Purpose:           Same as QuickGet, but does not send the HTTP GET.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL, the URL to render the GET.
		* Returns:           Character
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Same as QuickGet, but does not send the HTTP GET. 
		** Instead, it builds the HTTP request that would've been sent and returns it.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, lcHTTPRequest AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHTTPRequest = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcHTTPRequest = m.loChilkatObject.RenderGet(m.tcURL)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHTTPRequest
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE requiredcontenttype_access		&& Access method used to retrieve the Chilkat HTTP RequiredContentType property.
		*==============================================================================
		* Method:            RequiredContentType_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP RequiredContentType property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.RequiredContentType
		* Date Added:        01/28/2022
		*==============================================================================
		
		** 
		** If set, then any HTTP response to any POST or GET, including downloads, 
		** will be rejected if the content-type in the response header does not match this setting. 
		** If the content-type does not match, only the header of the HTTP response is read, 
		** the connection to the HTTP server is closed, and the remainder of the response is never read.
		**
		** This property is empty (zero-length string) by default.
		**
		** Some typical content-types are "text/html", "text/xml", "image/gif", 
		** "image/jpeg", "application/zip", "application/msword", "application/pdf", etc.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE requiredcontenttype_assign		&& Assign method used to hold a reference to the RequiredContentType property.
		*==============================================================================
		* Method:            RequiredContentType_Assign
