	PROCEDURE appendstring		&& Introduced in version 9.5.0.49. Appends a string item to the caller's sub-items. The strType specifies the type of string to be added. It may be "utf8", "ia5", "t61", "printable", "visible", "numeric", "universal", or "bmp".
		*==============================================================================
		* Method:            AppendString
		* Purpose:           Appends a string item to the caller's sub-items.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcStringType -- the string type to append.
		*                    tcValue, the string value to append.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/31/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Appends a string item to the caller's sub-items.
		** The strType specifies the type of string to be added. 
		** It may be "utf8", "ia5", "t61", "printable", "visible", "numeric", 
		** "universal", or "bmp". The value must conform to the ASN.1 restrictions 
		** imposed for a given string type. The "utf8", "bmp", and "universal" 
		** types have no restrictions on what characters are allowed. 
		** In general, unless a specific type of string is required, choose the "utf8" type.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcStringType AS Character, tcValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ASN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AppendString(m.tcStringType, m.tcValue) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ASN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendtime		&& Introduced in version 9.5.0.49. Appends a UTCTime item to the caller's sub-items. The timeFormat specifies the format of the dateTimeStr. It should be set to "utc".
		*==============================================================================
		* Method:            AppendTime
		* Purpose:           Appends a UTCTime item to the caller's sub-items.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTimeFormat -- the time format.
		*                    tcDateTimeValue, the date/time value to append.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/31/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Appends a UTCTime item to the caller's sub-items. 
		** The timeFormat specifies the format of the dateTimeStr. It should be set to "utc". 
		** (In the future, this method will be expanded to append GeneralizedTime items 
		** by using "generalized" for timeFormat.) To append the current date/time, 
		** set dateTimeStr equal to the empty string or the keyword "now". 
		** Otherwise, the dateTimeStr should be in the UTC time format "YYMMDDhhmm[ss]Z" 
		** or "YYMMDDhhmm[ss](+|-)hhmm".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcTimeFormat AS Character, tcDateTimeValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ASN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AppendTime(m.tcTimeFormat, m.tcDateTimeValue) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ASN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE asntoxml		&& Introduced in version 9.5.0.49. Converts ASN.1 to XML and returns the XML string. Returns Nothing on failure.
		*==============================================================================
		* Method:            ASNToXML
		* Purpose:           Converts ASN.1 to XML and returns the XML string.
		* Author:            Bill Anderson
