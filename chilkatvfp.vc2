	PROCEDURE unload		&& Introduced in version 11.0.0. Unload the certificate, which could mean closing a PKCS11 session if the certificate was loaded from a smart card.
		*==============================================================================
		* Method:            Unload
		* Purpose:           Unload the certificate, which could mean closing a PKCS11 session 
		*                    if the certificate was loaded from a smart card.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/04/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Unload the certificate, which could mean closing 
		** a PKCS11 session if the certificate was loaded from a smart card.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.Unload() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE uploadtocloud		&& Introduced in version 9.5.0.96. This is an open-ended method to accomodate uploading the private key to a cloud service, such as AWS KMS, or Azure Key Vault. For details, see the examples below. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UploadToCloud
		* Purpose:           This is an open-ended method to accomodate uploading the private key to a cloud service.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONIn, a Chilkat JSON object.
		*                    toChilkatJSONOut, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96.
		**
		** This is an open-ended method to accomodate uploading the private key to a cloud service, ;
		** such as AWS KMS, or Azure Key Vault. For details, see the examples below.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSONIn AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatJSONOut AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterJsonIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterJsonOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONIn AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loChilkatJSONOut AS CHILKAT_JSONOBJECT_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJsonIn, ;
		m.loParkParameterJsonOut, m.loChilkatJSONIn, m.loChilkatJSONOut
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONIn)
		
		      loParkParameterJsonOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONOut)
		
		      loChilkatJSONIn = m.loParkParameterJsonIn.GetObject()
		      loChilkatJSONOut = m.loParkParameterJsonIn.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UploadToCloud(m.loChilkatJSONIn, m.loParkParameterJsonOut) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONIn = ;
		      m.loParkParameterJsonIn.SetObject(m.toChilkatJSONIn, m.loChilkatJSONIn)
		
		      toChilkatJSONOut = ;
		      m.loParkParameterJsonIn.SetObject(m.toChilkatJSONOut, m.loChilkatJSONOut)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonIn, m.loChilkatJSONIn, ;
		m.loParkParameterJsonOut, m.loChilkatJSONOut
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatJSONIn = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONIn = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatJSONOut = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
