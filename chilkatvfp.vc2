	PROCEDURE shareconnection		&& Introduced in version 11.0.0. The caller will share ws's existing websocket connection, enabling multi-threaded applications to read and write to the websocket simultaneously. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ShareConnection
		* Purpose:           The caller will share ws's existing websocket connection, 
		*                    enabling multi-threaded applications to read and write 
		*                    to the websocket simultaneously.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWebSocket, a Chilkat Web Socket object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** The caller will share ws's existing websocket connection, 
		** enabling multi-threaded applications to read and write to the websocket simultaneously. 
		** The provided C++ and C# examples illustrate this concept, 
		** which you can adapt to your programming language.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatWebSocket AS CHILKAT_WEBSOCKET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_WEBSOCKET_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterWebSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatWebSocket AS CHILKAT_WEBSOCKET_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterWebSocket, m.loChilkatWebSocket 
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterWebSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatWebSocket)
		
		      loChilkatWebSocket = m.loParkParameterWebSocket.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ShareConnection(m.loChilkatWebSocket) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatWebSocket = ;
		      m.loParkParameterWebSocket.SetObject(m.toChilkatWebSocket, m.loChilkatWebSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterWebSocket, m.loChilkatWebSocket
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  toChilkatWebSocket = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  loParkParameterWebSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatWebSocket = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat WebSocket UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat WebSocket UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        07/06/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.80
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty. 
		** Can be set to a list of the following comma separated keywords:
		** 
		** "ProtectFromVpn" - Introduced in v9.5.0.80. On Android systems, 
		** will bypass any VPN that may be installed or active.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat WebSocket UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        07/06/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		lcValidationMethod = [UncommonOptions_WebSocket]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE useconnection		&& Introduced in version 9.5.0.70. Initializes the connection for a WebSocket session. All WebSocket sessions begin with a call to UseConnection.
		*==============================================================================
		* Method:            UseConnection
		* Purpose:           Initializes the connection for a WebSocket session.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatRest, a Chilkat Rest object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Initializes the connection for a WebSocket session. 
		** All WebSocket sessions begin with a call to UseConnection. 
		** A Chilkat REST object is used for the connection because the WebSocket handshake 
		** begins with an HTTP GET request. The Chilkat REST API provides the ability 
		** to add custom headers, authentication, etc. to the opening GET handshake. 
		** It also provides the ability to establish connections over TLS or SSH 
		** and to benefit from the rich set of features already present 
		** relating to HTTP proxies, SOCKS proxies, bandwidth throttling, IPv6, 
		** socket options, etc.
		** 
		
		LPARAMETERS toChilkatRest AS CHILKAT_REST_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_WEBSOCKET_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterRest AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatRest AS CHILKAT_REST_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterRest, m.loChilkatRest 
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterRest = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatRest)
		
		      loChilkatRest = m.loParkParameterRest.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseConnection(m.loChilkatRest) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatRest = ;
		      m.loParkParameterRest.SetObject(m.toChilkatRest, m.loChilkatRest)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterRest, m.loChilkatRest
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  toChilkatRest = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  loParkParameterRest = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatRest = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE validateserverhandshake		&& Introduced in version 9.5.0.70. Called after sending the opening handshake from the Rest object. Validates the server's response to the opening handshake message.
		*==============================================================================
		* Method:            ValidateServerHandshake
		* Purpose:           Called after sending the opening handshake from the Rest object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Called after sending the opening handshake from the Rest object. 
		** Validates the server's response to the opening handshake message. 
		** If validation is successful, the application may begin sending 
		** and receiving data and control frames.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_WEBSOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.ValidateServerHandshake() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat WebSocket VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/06/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 70
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS xml AS ibasechilkat OF "chilkatvfp.vcx" 		&& A free non-validating XML parser component with encryption and compression features.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: accumulatetagcontent		&& Accumulates the content of all nodes having a specific tag into a single result string. SkipTags specifies a set of subtrees to be avoided. The skipTags are formatted as a string of tags delimited by vertical bar characters.
		*m: addattribute		&& Adds an attribute to the calling node in the XML document. Returns True for success, and False for failure. Returns 1 for success, 0 for failure.
		*m: addattributeint		&& Adds an integer attribute to a node. Returns 1 for success, 0 for failure.
		*m: addchildtree		&& Adds an entire subtree as a child. If the child was a subtree within another Xml document then the subtree is effectively transferred from one XML document to another.
		*m: addorupdateattribute		&& Adds an attribute to an XML node. If an attribute having the specified name already exists, the value is updated.
		*m: addorupdateattributei		&& Adds an integer attribute to an XML node. If an attribute having the specified name already exists, the value is updated.
		*m: addstylesheet		&& Adds a style sheet declaration to the XML document. The styleSheet should be a string such as: <?xml-stylesheet href="mystyle.css" title="Compact" type="text/css"?>
		*m: addtoattribute		&& Adds an integer amount to an integer attribute's value. If the attribute does not yet exist, this method behaves the same as AddOrUpdateAttributeI.
		*m: addtochildcontent		&& Adds an integer value to the content of a child node.
		*m: addtocontent		&& Adds an integer amount to the node's content.
		*m: appendtocontent		&& Appends text to the content of an XML node. Returns 1 for success, 0 for failure.
		*m: bencodecontent		&& Sets the node's content with 8bit data that is in a specified multibyte character encoding such as utf-8, shift-jis, big5, etc. The data is first B-encoded and the content is set to be the B-encoded string.
		*m: cdata_access		&& Access method used to retrieve the Chilkat XML cData property.
		*m: cdata_assign		&& Assign method used to hold a reference to the cData property.
		*m: childcontentmatches		&& Return 1 if a child at the specified tagPath contains content that matches a wildcarded pattern. Otherwise returns 0.
		*m: chilkatpath		&& Follows a series of commands to navigate through an XML document to return a piece of data or update the caller's reference to a new XML document node. Note: This method not related to the XPath (XML Path) standard in any way.
		*m: clear		&& Removes all children, attributes, and content from the XML node. Resets the tag name to "unnamed".
		*m: contentint_access		&& Access method used to retrieve the Chilkat XML ContentInt property.
		*m: contentint_assign		&& Assign method used to hold a reference to the ContentInt property.
		*m: contentmatches		&& Return true if the node's content matches a wildcarded pattern.
		*m: content_access		&& Access method used to retrieve the Chilkat XML Content property.
		*m: content_assign		&& Assign method used to hold a reference to the Content property.
		*m: copy		&& Copies the tag, content, and attributes to the calling node.
		*m: copyref		&& Discards the caller's current internal reference and copies the internal reference from copyFromNode. Effectively updates the caller node to point to the same node in the XML document as copyFromNode.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat XML DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: decodecontent		&& Decodes a node's Q or B-encoded content string and returns the byte data. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: decodeentities		&& Utility method to decode HTML entities. It accepts a string containing (potentially) HTML entities and returns a string with the entities decoded. Returns Nothing on failure.
		*m: decryptcontent		&& Decrypts the content of an XML node that was previously 128-bit AES encrypted with the EncryptContent method. Returns 1 for success, 0 for failure.
		*m: doctype_access		&& Access method used to retrieve the Chilkat XML DocType property.
		*m: doctype_assign		&& Assign method used to hold a reference to the DocType property.
		*m: emitbom_access		&& Access method used to retrieve the Chilkat XML EmitBOM property.
		*m: emitbom_assign		&& Assign method used to hold a reference to the EmitBOM property.
		*m: emitcompact_access		&& Access method used to retrieve the Chilkat XML EmitCompact property.
		*m: emitcompact_assign		&& Assign method used to hold a reference to the EmitCompact property.
		*m: emitxmldecl_access		&& Access method used to retrieve the Chilkat XML EmitXMLDecl property.
		*m: emitxmldecl_assign		&& Assign method used to hold a reference to the EmitXMLDecl property.
		*m: encoding_access		&& Access method used to retrieve the Chilkat XML Encoding property.
		*m: encoding_assign		&& Assign method used to hold a reference to the Encoding property.
		*m: encryptcontent		&& Encrypts the content of the calling XML node using 128-bit CBC AES encryption. The base64-encoded encrypted content replaces the original content. Returns 1 for success, 0 for failure.
		*m: extractchildbyindex		&& Removes and returns the Nth child of an XML node. The first child is at index 0. Returns Nothing on failure.
		*m: extractchildbyname		&& Removes and returns the first child node at the specified tag or tag path. The attrName and attrValue may be empty, in which case the first child matching the tag is removed and returned.
		*m: findchild		&& Returns the child with the given tag or at the specified tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters. For example: "tagA|tagB|tagC".
		*m: findchild2		&& Updates the Xml object's internal reference to point to a child at the specified tag or tagPath. Beginning in version 9.5.0.64, the tagPath can be a tag path.
		*m: findnextrecord		&& Returns the next record node where the child with a specific tag matches a wildcarded pattern. This method makes it easy to iterate over high-level records. Beginning in version 9.5.0.64, the tagPath can be a tag path.
		*m: findoraddnewchild		&& First checks for a child at tagPath, and if found, returns it. Otherwise creates a new child with empty content. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: firstchild		&& Returns the first child. A program can step through the children by calling FirstChild, and then NextSibling repeatedly. Returns Nothing on failure.
		*m: firstchild2		&& Updates the internal reference of the caller to point to its first child. Returns 1 for success, 0 for failure.
		*m: getattributename		&& Returns the name of the Nth attribute of an XML node. The first attribute is at index 0. Returns Nothing on failure.
		*m: getattributevalue		&& Returns the value of the Nth attribute of an XML node. The first attribute is at index 0. Returns Nothing on failure.
		*m: getattributevalueint		&& Returns an attribute as an integer. Returns 0 if the attribute does not exist.
		*m: getattrvalue		&& Find and return the value of an attribute having a specified name. Returns Nothing on failure.
		*m: getattrvalueint		&& Returns an attribute as an integer. Returns 0 if the attribute does not exist.
		*m: getbinarycontent		&& Returns binary content of an XML node as a byte array. The content may have been Zip compressed, AES encrypted, or both. Unzip compression and AES decryption flags should be set appropriately. Returns a zero-length byte array (as a Variant) on failure.
		*m: getchild		&& Returns the Nth child of an XML node . Returns Nothing on failure.
		*m: getchild2		&& Updates the calling object's internal reference to the Nth child node. Returns 1 for success, 0 for failure.
		*m: getchildattrvalue		&& Introduced in version 9.5.0.77. Returns the content of a descendant child having a specified attribute. The tagPath can be a tag or a tag path. Returns Nothing on failure.
		*m: getchildboolvalue		&& Returns 0 if the node's content is "0", otherwise returns 1 if the node contains a non-zero integer. The tagPath can be a tag or a tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path.
		*m: getchildcontent		&& Returns the content of a child having a specified tag. The tagPath can be a tag or a tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: getchildcontentbyindex		&& Returns the content of the Nth child node. Returns Nothing on failure.
		*m: getchildcontentsb		&& Introduced in version 9.5.0.76. Returns the content of the XML element at the tagPath. The XML element's content is appended to the sb. Returns 1 for success, 0 for failure.
		*m: getchildexact		&& Returns the child having the exact tag and content. Returns Nothing on failure.
		*m: getchildintvalue		&& Returns the child integer content for a given tag. The tagPath can be a tag or a tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: getchildtag		&& Returns the tag name of the Nth child node. Returns Nothing on failure.
		*m: getchildtagbyindex		&& Returns the tag name of the Nth child node. Returns Nothing on failure.
		*m: getchildwithattr		&& Finds and returns the XML child node having both a given tag and an attribute with a given name and value. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: getchildwithcontent		&& Returns the first child found having the exact content specified. Returns Nothing on failure.
		*m: getchildwithtag		&& Returns the child at the specified tag or tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters. For example: "tagA|tagB|tagC". Returns Nothing on failure.
		*m: getchildwithtag2		&& Introduced in version 11.1.0. Updates the calling object's internal reference to the child at the specified tag or tag path. The tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters. For example: tagA|tagB|tagC.
		*m: getnthchildwithtag		&& Returns the Nth child having a tag that matches exactly with the tagName. Use the NumChildrenHavingTag method to determine how many children have a particular tag. Returns Nothing on failure.
		*m: getnthchildwithtag2		&& Updates the calling object's internal reference to the Nth child node having a specific tag. Returns 1 for success, 0 for failure.
		*m: getparent		&& Returns the parent of this XML node, or NULL if the node is the root of the tree. Returns Nothing on failure.
		*m: getparent2		&& Updates the internal reference of the caller to its parent. Returns 1 for success, 0 for failure.
		*m: getroot		&& Returns the root node of the XML document. Returns Nothing on failure.
		*m: getroot2		&& Updates the internal reference of the caller to the document root.
		*m: getself		&& Returns a new XML object instance that references the same XML node. Returns Nothing on failure.
		*m: getxml		&& Generate the XML text document for the XML tree rooted at this node. If called from the root node of the XML document, then the XML declarator ("<?xml version="1.0" encoding="utf-8" ?>") is included at the beginning of the XML.
		*m: getxmlbd		&& Introduced in version 9.5.0.77. Emits (appends) the XML to the contents of bd. Returns 1 for success, 0 for failure.
		*m: getxmlsb		&& Introduced in version 9.5.0.62. Emits the XML to a StringBuilder object. (Appends to the existing contents of sb.) Returns 1 for success, 0 for failure.
		*m: hasattribute		&& Returns true if the node contains an attribute with the specified name.
		*m: hasattrwithvalue		&& Returns true if the node contains attribute with the name and value.
		*m: haschildwithcontent		&& Returns true if the node has a direct child node containing the exact content string specified.
		*m: haschildwithtag		&& Returns 1 if the node has a child with the given tag (or tag path). Otherwise returns 0. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: haschildwithtagandcontent		&& Returns 1 if the node contains child with the given tag (or tag path) and content specified. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: insertchildtreeafter		&& Returns 1 if the node contains child with the given tag (or tag path) and content specified. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: insertchildtreebefore		&& Adds an entire subtree as a child. If the child was a subtree within another Xml document then the subtree is effectively transferred from one XML document to another. The child tree is inserted in a position before the Nth child (of the calling node).
		*m: isbase64_access		&& Access method used to retrieve the Chilkat XML IsBase64 property.
		*m: isbase64_assign		&& Assign method used to hold a reference to the IsBase64 property.
		*m: i_access		&& Access method used to retrieve the Chilkat XML I property.
		*m: i_assign		&& Assign method used to hold a reference to the I property.
		*m: j_access		&& Access method used to retrieve the Chilkat XML J property.
		*m: j_assign		&& Assign method used to hold a reference to the J property.
		*m: k_access		&& Access method used to retrieve the Chilkat XML K property.
		*m: k_assign		&& Assign method used to hold a reference to the K property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat XML LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastchild		&& Returns the last Xml child node. A node's children can be enumerated by calling LastChild and then repeatedly calling PreviousSibling, until a NULL is returned. Returns Nothing on failure.
		*m: lastchild2		&& Updates the internal reference of the caller to its last child. Returns 1 for success, 0 for failure.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat XML LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat XML LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat XML LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat XML LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat XML LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat XML LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadbd		&& Introduced in version 9.5.0.77. Loads XML from the contents of bd. If autoTrim is 1, then each element's text content is trimmed of leading and trailing whitespace. Returns 1 for success, 0 for failure.
		*m: loadsb		&& Introduced in version 9.5.0.62. Loads XML from the contents of a StringBuilder object. Returns 1 for success, 0 for failure.
		*m: loadxml		&& Loads an XML document from a memory buffer and returns 1 if successful. The contents of the calling node are replaced with the root node of the XML document loaded. Returns 1 for success, 0 for failure.
		*m: loadxml2		&& Same as LoadXml, but an additional argument controls whether or not leading/trailing whitespace is auto-trimmed from each leaf node's content. Returns 1 for success, 0 for failure.
		*m: loadxmlfile		&& Loads an XML document from a file and returns 1 if successful. The contents of the calling node are replaced with the root node of the XML document loaded. Returns 1 for success, 0 for failure.
		*m: loadxmlfile2		&& Same as LoadXmlFile, but an additional argument controls whether or not leading/trailing whitespace is auto-trimmed from each leaf node's content. Returns 1 for success, 0 for failure.
		*m: newchild		&& Creates a new child having tag and content. The new child is created even if a child with a tag equal to tagPath already exists. (Use FindOrAddNewChild to prevent creating children having the same tags.)
		*m: newchild2		&& Creates a new child node, but does not return the node that is created. The tagPath can be a tag or a tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*m: newchildafter		&& Inserts a new child in a position after the Nth child node. Returns Nothing on failure.
		*m: newchildbefore		&& Inserts a new child in a position before the Nth child node.
		*m: newchildint2		&& Inserts a new child having an integer for content. The tagPath can be a tag or a tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path.
		*m: nextintraversal2		&& Updates to Xml object's internal reference to the next node in a depth-first traversal.
		*m: nextsibling		&& Returns the nodes next sibling, or NULL if there are no more. Returns Nothing on failure.
		*m: nextsibling2		&& Updates the internal reference of the caller to its next sibling. Returns 1 for success, 0 for failure.
		*m: numattributes_access		&& Access method used to retrieve the Chilkat XML NumAttributes property.
		*m: numattributes_assign		&& Assign method used to hold a reference to the NumAttributes property.
		*m: numchildrenat		&& Introduced in version 9.5.0.64. Returns the number of children for the node indicated by tagPath. Returns -1 if the node at tagPath does not exist.
		*m: numchildrenhavingtag		&& Returns the number of children having a specific tag name.
		*m: numchildren_access		&& Access method used to retrieve the Chilkat XML NumChildren property.
		*m: numchildren_assign		&& Assign method used to hold a reference to the NumChildren property.
		*m: previoussibling		&& Returns the Xml object that is the node's previous sibling, or NULL if there are no more. Returns Nothing on failure.
		*m: previoussibling2		&& Updates the internal reference of the caller to its previous sibling. Returns 1 for success, 0 for failure.
		*m: pruneattribute		&& Introduced in version 9.5.0.77. Recursively descends the XML from this node and removes all occurrences of the specified attribute. Returns the number of attribute occurrences removed.
		*m: prunetag		&& Introduced in version 9.5.0.77. Recursively descends the XML from this node and removes all occurrences of the specified tag, including all descendents of each removed node. Returns the number of tag occurrences removed.
		*m: qencodecontent		&& Sets the node's content with 8bit data that is in a specified multibyte character encoding such as utf-8, shift-jis, big5, etc. The data is first Q-encoded and the content is set to be the Q-encoded string.
		*m: removeallattributes		&& Removes all attributes from an XML node. Should always return True. Returns 1 for success, 0 for failure.
		*m: removeallchildren		&& Removes all children from the calling node.
		*m: removeattribute		&& Removes an attribute by name from and XML node. Returns 1 for success, 0 for failure.
		*m: removechild		&& Removes all children with a given tag or tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters. For example: "tagA|tagB|tagC".
		*m: removechildbyindex		&& Removes the Nth child from the calling node.
		*m: removechildwithcontent		&& Removes all children having the exact content specified.
		*m: removefromtree		&& Removes the calling object and its sub-tree from the XML document making it the root of its own tree.
		*m: removestylesheet		&& Introduced in version 9.5.0.77. Removes all XML stylesheets having an attribute with attrName equal to attrValue. Returns the number of stylesheets removed, or -1 if there was an error.
		*m: savebinarycontent		&& Saves a node's binary content to a file. Returns 1 for success, 0 for failure.
		*m: savexml		&& Generates XML representing the tree or subtree rooted at this node and writes it to a file. Returns 1 for success, 0 for failure.
		*m: scrub		&& Introduced in version 9.5.0.77. Recursively traverses the XML rooted at the caller and scrubs according to the instructions in the comma separated directives.
		*m: searchallforcontent		&& Returns the first node having content matching the contentPattern. The contentPattern is a case-sensitive string that may contain any number of '*'s, each representing 0 or more occurrences of any character
		*m: searchallforcontent2		&& Same as SearchAllForContent except the internal reference of the caller is updated to point to the search result (instead of returning a new object). Returns 1 for success, 0 for failure.
		*m: searchforattribute		&& Returns the first node having a tag equal to tag, an attribute named attr, whose value matches valuePattern. The valuePattern is a case-sensitive string that may contain any number of '*'s, each representing 0 or more occurrences of any character.
		*m: searchforattribute2		&& Same as SearchForAttribute except the internal reference of the caller is updated to point to the search result (instead of returning a new object). Returns 1 for success, 0 for failure.
		*m: searchforcontent		&& Returns the first node having a tag equal to tag, whose content matches contentPattern. The contentPattern is a case-sensitive string that may contain any number of '*'s, each representing 0 or more occurrences of any character.
		*m: searchforcontent2		&& Same as SearchForContent except the internal reference of the caller is updated to point to the search result (instead of returning a new object). Returns 1 for success, 0 for failure.
		*m: searchfortag		&& Returns the first node having a tag equal to tag. The search is breadth-first over the sub-tree rooted at the caller. A match is returned only after the search has traversed past the node indicated by afterPtr.
		*m: searchfortag2		&& Same as SearchForTag except the internal reference of the caller is updated to point to the search result (instead of returning a new object). Returns 1 for success, 0 for failure.
		*m: setbinarycontent		&& Sets the node's content to a block of binary data with optional Zip compression and/or AES encryption. The binary data is automatically converted to base64 format whenever XML text is generated.
		*m: setbinarycontentbd		&& Introduced in version 11.0.0. Sets the element's content to binary data with optional Zip compression and/or AES encryption.
		*m: setbinarycontentfromfile		&& Sets the node's content with binary (or text) data from a file. The file contents can be Zip compressed and/or encrypted, and the result is base-64 encoded. Returns 1 for success, 0 for failure.
		*m: sortbyattribute		&& Sorts the direct child nodes by the value of a specified attribute.
		*m: sortbyattributeint		&& Sorts the direct child nodes by the value of a specified attribute interpreted as an integer (not lexicographically as strings).
		*m: sortbycontent		&& Sorts the direct child nodes by content.
		*m: sortbytag		&& Sorts the direct child nodes by tag.
		*m: sortcaseinsensitive_access		&& Access method used to retrieve the Chilkat XML SortCaseInsensitive property.
		*m: sortcaseinsensitive_assign		&& Assign method used to hold a reference to the SortCaseInsensitive property.
		*m: sortrecordsbyattribute		&& Sorts the direct child nodes by the content of an attribute in the grandchild nodes.
		*m: sortrecordsbycontent		&& Sorts the direct child nodes by the content of the grandchild nodes.
		*m: sortrecordsbycontentint		&& Sorts the direct child nodes by the content of the grandchild nodes. For sorting purposes, the content is interpreted as an integer (not lexicographically as for strings).
		*m: standalone_access		&& Access method used to retrieve the Chilkat XML StandAlone property.
		*m: standalone_assign		&& Assign method used to hold a reference to the StandAlone property.
		*m: strict_access
		*m: strict_assign
		*m: swapnode		&& Swaps another node's tag, content, and attributes with this one. Returns 1 for success, 0 for failure.
		*m: swaptree		&& Swaps another node's tag, content, attributes, and children with this one. Returns 1 for success, 0 for failure.
		*m: tagcontent		&& Returns the content of the 1st node found in the sub-tree rooted at the caller that has a given tag. (Note: The search for the node having tag ARG is not limited to the direct children of the caller.) Returns Nothing on failure.
		*m: tagequals		&& Returns 1 if the node's tag equals the specified string.
		*m: tagindex		&& Introduced in version 9.5.0.76. Returns the index of the XML node with the given tag. Returns -1 if no node having the specified tag is found at the tagPath.
		*m: tagnsequals		&& Introduced in version 9.5.0.77. Returns 1 if the node's tag namespace prefix equals the specified ns.
		*m: tagnsprefix_access		&& Access method used to retrieve the Chilkat XML TagNsPrefix property.
		*m: tagnsprefix_assign		&& Assign method used to hold a reference to the TagNsPrefix property.
		*m: tagpath_access		&& Access method used to retrieve the Chilkat XML TagPath property.
		*m: tagpath_assign		&& Assign method used to hold a reference to the TagPath property.
		*m: tagunpequals		&& Introduced in version 9.5.0.77. Returns 1 if the node's unprefixed tag equals the specified string. For example, if the tag is "soapenv:Body", the unprefixed tag is "Body".
		*m: tagunprefixed_access		&& Access method used to retrieve the Chilkat XML TagUnprefixed property.
		*m: tagunprefixed_assign		&& Assign method used to hold a reference to the TagUnprefixed property.
		*m: tag_access		&& Access method used to retrieve the Chilkat XML Tag property.
		*m: tag_assign		&& Assign method used to hold a reference to the Tag property.
		*m: treeid_access		&& Access method used to retrieve the Chilkat XML TreeID property.
		*m: treeid_assign		&& Assign method used to hold a reference to the TreeID property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat XML UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unzipcontent		&& Unzip the content of the XML node replacing it's content with the decompressed data. Returns 1 for success, 0 for failure.
		*m: unziptree		&& Unzips and recreates the XML node and the entire subtree, restoring it to the state before it was zip compressed. Returns 1 for success, 0 for failure.
		*m: updateat		&& Introduced in version 9.5.0.64. Updates the content for the node indicated by tagPath. If autoCreate is 1, then nodes along tagPath are auto-created as needed.
		*m: updateattrat		&& Introduced in version 9.5.0.64. Updates or adds the attribute value for the node indicated by tagPath. If autoCreate is 1, then nodes along tagPath are auto-created as needed.
		*m: updateattribute		&& Adds an attribute to the node if it doesn't already exist. Otherwise it updates the existing attribute with the new value. Returns 1 for success, 0 for failure.
		*m: updateattributeint		&& Updates an attribute value. (Call UpdateAttribute if the attribute value is a string.) Returns 1 for success, 0 for failure.
		*m: updatechildcontent		&& Replaces the content of a child node. The tagPath can be a tag or tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters
		*m: updatechildcontentint		&& Replaces the content of a child node where the content is an integer. The tagPath can be a tag or tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat XML VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: zipcontent		&& Applies Zip compression to the content of an XML node and replaces the content with base64-encoded compressed data. Returns 1 for success, 0 for failure.
		*m: ziptree		&& Zip compresses the content and entire subtree rooted at the calling XML node and replaces the current content with base64-encoded Zip compressed data.
		*p: cdata		&& When True, causes an XML node's content to be encapsulated in a CDATA section.
		*p: content		&& The content of the XML node. It is the text between the open and close tags, not including child nodes.
		*p: contentint		&& Set/get the content as an integer.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: doctype		&& The DOCTYPE declaration (if any) for the XML document.
		*p: emitbom		&& Introduced in version 9.5.0.44. If 1, then emit the BOM (byte order mark, also known as a preamble) for encodings such as utf-8, utf-16, etc. The default value is 0.
		*p: emitcompact		&& Introduced in version 9.5.0.64. If 1, then GetXml and GetXmlSb emit compact XML. The XML emitted has no unnecessary whitespace, incuding no end-of-lines (CR's and/or LF's). The default value is 0, which maintains backward compatibility.
		*p: emitxmldecl		&& If 1, then the XML declaration is emitted for methods (such as GetXml or SaveXml) where the XML is written to a file or string. The default value of this property is 1.
		*p: encoding		&& This is the encoding attribute in the XML declaration, such as "utf-8" or "iso-8859-1". The default is "utf-8". This property can be set from any node in the XML document and when set, causes the encoding property to be added to the XML declaration
		*p: i		&& Introduced in version 9.5.0.64. Used in tagPaths (and ChilkatPath). The value of this property is substituted for "i" in "[i]".
		*p: isbase64		&& Introduced in version 9.5.0.76. Returns 1 if the content contains only those characters allowed in the base64 encoding.
		*p: j		&& Introduced in version 9.5.0.64. Used in tagPaths (and ChilkatPath). The value of this property is substituted for "j" in "[j]"
		*p: k		&& Introduced in version 9.5.0.64. Used in tagPaths (and ChilkatPath). The value of this property is substituted for "k" in "[k]". See the example below..
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numattributes		&& The number of attributes.
		*p: numchildren		&& The number of direct child nodes contained under this XML node.
		*p: sortcaseinsensitive		&& If true (or 1 for ActiveX), then all Sort* methods use case insensitive sorting.
		*p: standalone		&& This is the standalone attribute in the XML declaration. This property can be set from any node in the XML document. A value of 1 adds a standalone="yes" to the XML declaration:
		*p: strict		&& Introduced in version 11.6.0. When Strict is true, the XML loading methods first check that the input is well-formed XML. If it is not, the load fails and the contents of this Xml object are left unchanged. The default is 0.
		*p: tagnsprefix		&& Introduced in version 9.5.0.77. The node's namespace prefix, if present. For example, if the tag is "soapenv:Envelope", then this property will return "soapenv".
		*p: tagpath		&& Introduced in version 9.5.0.77. Returns the path to reach this element from the XML document root. If the caller is the document root, then the empty string is returned.
		*p: tagunprefixed		&& Introduced in version 9.5.0.77. The node's tag without the namespace prefix. For example, if the tag is "soapenv:Envelope", then this property will return "Envelope".
		*p: treeid		&& Each tree (or XML document) has a unique TreeId. This is the ID of the tree, and can be used to determine if two Xml objects belong to the same tree.
		*p: uncommonoptions		&& Introduced in version 9.5.0.90. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Xml
		cdata = 0
		content = 
		contentint = 0
		debuglogfilepath = 
		doctype = 
		emitbom = 0
		emitcompact = 0
		emitxmldecl = 1
		encoding = 
		i = 0
		isbase64 = 0
		j = 0
		k = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "xml"
		numattributes = 0
		numchildren = 
		sortcaseinsensitive = 0
		standalone = 0
		strict = 0
		tagnsprefix = 
		tagpath = 
		tagunprefixed = 
		treeid = 0
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE accumulatetagcontent		&& Accumulates the content of all nodes having a specific tag into a single result string. SkipTags specifies a set of subtrees to be avoided. The skipTags are formatted as a string of tags delimited by vertical bar characters.
		*==============================================================================
		* Method:            AccumulateTagContent
		* Purpose:           Accumulates the content of all nodes having 
		*                    a specific tag into a single result string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTag -- the tag to search for
		*                    tcSkipTags -- specifies a set of subtrees to be avoided.
		* Returns:           The content
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Accumulates the content of all nodes having a specific tag into a single result string. 
		** SkipTags specifies a set of subtrees to be avoided. 
		** The skipTags are formatted as a string of tags delimited by vertical bar characters. 
		** All nodes in sub-trees rooted with a tag appearing in skipTags are not included in the result.
		**
		** Enhancement for Version 52: This method now allows an app to pass “*” or empty string 
		** to accumulate the text for any tag. This is one way to implement the innerText HTML function.
		**
		** Fixed for Version 96: Fixed the method. The “skipTags” argument was getting ignored.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTag AS Character, tcSkipTags AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, lcContent AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcContent = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcContent = m.loChilkatObject.AccumulateTagContent(m.tcTag, m.tcSkipTags)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcContent
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addattribute		&& Adds an attribute to the calling node in the XML document. Returns True for success, and False for failure. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddAttribute
		* Purpose:           Adds an attribute to the calling node in the XML document.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAttributeName -- the attribute name to add.
		*                    tcAttributeValue -- the attribute value to add.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Adds an attribute to the calling node in the XML document. 
		** Returns True for success, and False for failure.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcAttributeName AS Character, tcAttributeValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddAttribute(m.tcAttributeName, m.tcAttributeValue) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
