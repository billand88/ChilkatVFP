	PROCEDURE setauthoauth1		&& Introduced in version 9.5.0.58. Sets the authentication provider for REST API requests needing OAuth 1.0 (and OAuth 1.0a) authentication. If useQueryParams is 1, then the OAuth1 authentication information and signature is passed in query parameters.
		*==============================================================================
		* Method:            SetAuthOAuth1
		* Purpose:           Sets the authentication provider for REST API requests 
		*                    needing OAuth 1.0 (and OAuth 1.0a) authentication.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatOAuth1, a Chilkat OAuth1 object.
		*                    tuUseQueryParameters, whether or not to use query parameters.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Sets the authentication provider for REST API requests needing OAuth 1.0 
		** (and OAuth 1.0a) authentication. If useQueryParams is 1, 
		** then the OAuth1 authentication information and signature is passed in query parameters. 
		** Otherwise it is passed in an Authorization header.
		**
		** Fixed for Verison 93: Fixed Twitter OAuth1 authentication problems.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatOAuth1 AS [CHILKAT_OAUTH1_COM_CALL], tuUseQueryParameters AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		loParkParameterOAuth1 AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatOAuth1 AS [CHILKAT_OAUTH1_COM_CALL], ;
		luReturn AS Unknown, liUseQueryParameters AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUseQueryParameters, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterOAuth1, m.loChilkatOAuth1
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUseQueryParameters = .LogicalToBit(m.tuUseQueryParameters)
		
		      loParkParameterOAuth1 = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatOAuth1)
		
		      loChilkatOAuth1 = m.loParkParameterOAuth1.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetAuthOAuth1(m.loChilkatOAuth1, m.liUseQueryParameters) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatOAuth1 = ;
		      m.loParkParameterOAuth1.SetObject(m.toChilkatOAuth1, m.loChilkatOAuth1)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterOAuth1, m.loChilkatOAuth1
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  toChilkatOAuth1 = NEWOBJECT([CHILKAT_OAUTH1_COM_CALL])
		  loParkParameterOAuth1 = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatOAuth1 = NEWOBJECT([CHILKAT_OAUTH1_COM_CALL])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setauthoauth2		&& Introduced in version 9.5.0.59. Causes the "Authorization: Bearer <access_token>" header to be added to each request.
		*==============================================================================
