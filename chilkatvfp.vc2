	PROCEDURE sendreqexec		&& Initiates execution of a command on the channel specified by channelNum. The commandLine contains the full command line including any command-line parameters (just as you would type the command at a shell prompt).
		*==============================================================================
		* Method:            SendReqExec
		* Purpose:           Initiates execution of a command on the channel specified by channelNum.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		*                    tcCommand, the command line, including any parameters.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Initiates execution of a command on the channel specified by channelNum. 
		** The commandLine contains the full command line 
		** including any command-line parameters 
		** (just as you would type the command at a shell prompt).
		**
		** This is the equivalent of running a command on a remote server via the "rexec" command.
		** See rexec command. It is not a shell session.
		**
		** Important: A channel only exists for a single request. 
		** You may not call SendReqExec multiple times on the same open channel. 
		** The reason is that the SSH server automatically closes the channel 
		** at the end of the exec. The solution is to call OpenSessionChannel 
		** to get a new channel, and then call SendReqExec using the new channel. 
		** It is OK to have more than one channel open simultaneously.
		**
		** Charset: The ReqExecCharset property has been added in version 9.5.0.47. 
		** This can be set to control the character encoding of the command sent to the server. 
		** The default is ANSI. A likely alternative value is "utf-8".
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiChannel AS Integer, tcCommand AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SendReqExec(m.tiChannel, m.tcCommand) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

