	HIDDEN PROCEDURE sorcvbuf_access		&& Access method used to retrieve the Chilkat Socket SoRcvBuf property.
		*==============================================================================
		* Method:            SoRcvBuf_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket SoRcvBuf property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SoRcvBuf
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Sets the receive buffer size socket option. 
		** Normally, this property should be left unchanged. The default value is 4194304.
		**
		** This property can be increased if download performance seems slow. 
		** It is recommended to be a multiple of 4096.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sorcvbuf_assign		&& Assign method used to hold a reference to the SoRcvBuf property.
		*==============================================================================
		* Method:            SoRcvBuf_Assign
		* Purpose:           Assign method used to hold a reference to the SoRcvBuf property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the SoRcvBuf property.
		* Returns:           
		* Date Added:        05/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE soreuseaddr_access		&& Access method used to retrieve the Chilkat Socket SoReuseAddr property.
		*==============================================================================
		* Method:            SoReuseAddr_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket SoReuseAddr property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SoReuseAddr
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Sets the SO_REUSEADDR socket option for a socket that will bind to a port 
		** and listen for incoming connections. The default value is 1, 
		** meaning that the SO_REUSEADDR socket option is set. 
		** If the socket option must be unset, set this property equal to 0 
		** prior to calling BindAndListen or InitSslServer.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE soreuseaddr_assign		&& Assign method used to hold a reference to the SoReuseAddr property.
