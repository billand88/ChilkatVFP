	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        06/29/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of ChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Less than version 11.0.0 test
		      IF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(11, 0, 0)
		
		        .HashAlgorithm = [sha1]
		
		      ENDIF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(11, 0, 0)
		      ** End less than version 11.0.0 test
		
		      ** Version 75 or later test
		      IF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 75)
		
		        ** Force the default to be added to the property...
		        .SigningAttributes = .SigningAttributes
		
		      ENDIF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 75)
		      ** End before version 76 test
		
		      ** Less than version 56 test
		      IF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 56)
		
		        .Pkcs7CryptAlg = [rc2]
		
		      ENDIF m.liCalculatedBuildNumber < ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 56)
		      ** End less than version 56 test
		
		    ELSE
		
		      llReturn = .F.
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have versioning object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loVersioning = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	HIDDEN PROCEDURE initialcount_access		&& Access method used to retrieve the Chilkat Crypt2 IncludeCount property.
		*==============================================================================
		* Method:            InitialCount_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 InitialCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.InitialCount
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** The initial counter for the ChaCha20 encryption algorithm. The default value is 0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 55
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE initialcount_assign		&& Assign method used to hold a reference to the IncludeCount property.
		*==============================================================================
		* Method:            InitialCount_Assign
		* Purpose:           Assign method used to hold a reference to the InitialCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the InitialCount property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 55
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE isunlocked		&& Undocumented methiod! Returns true if the component is unlocked.
		*==============================================================================
		* Method:            IsUnlocked
		* Purpose:           Undocumented method! Returns true if the class has been unlocked.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Undocumented method! 
		**
		** Version 11.0.0: Method removed.
		**
		** Returns true if the class has been unlocked. 
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.IsUnlocked() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE iterationcount_access		&& Access method used to retrieve the Chilkat Crypt2 IterationCount property.
		*==============================================================================
		* Method:            IterationCount_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 IterationCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IterationCount
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Iteration count to be used with password-based encryption (PBE). 
		** Password-based encryption is defined in the PKCS5 
		** Password-Based Cryptography Standard at http://www.rsa.com/rsalabs/node.asp?id=2127
		** 
		** The purpose of the iteration count is to 
		** increase the computation required to encrypt and decrypt. 
		** A larger iteration count makes cracking via exhaustive search more difficult.
		** The default value is 1024.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE iterationcount_assign		&& Assign method used to hold a reference to the IterationCount property.
		*==============================================================================
		* Method:            IterationCount_Assign
		* Purpose:           Assign method used to hold a reference to the IterationCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the IterationCount property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

