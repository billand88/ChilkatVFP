DEFINE CLASS messageset AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a collection of email message sequence numbers or UIDs on an IMAP server.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: containsid		&& Returns 1 if the msgId is contained in the message set.
		*m: count_access		&& Access method used to retrieve the Chilkat MessageSet Count property.
		*m: count_assign		&& Assign method used to hold a reference to the Count property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat MessageSet DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: fromcompactstring		&& Loads the message set from a compact-string representation.
		*m: getid		&& Returns the message ID of the Nth message in the set. (indexing begins at 0). Returns -1 if the index is out of range.
		*m: hasuids_access		&& Access method used to retrieve the Chilkat MessageSet HasUIDs property.
		*m: hasuids_assign		&& Assign method used to hold a reference to the HasUIDs property.
		*m: insertid		&& Inserts a message ID into the set. If the ID already exists, a duplicate is not inserted.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat MessageSet LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat MessageSet LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat MessageSet LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat MessageSet LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskresult		&& Introduced in version 9.5.0.52. Loads the message set from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*m: removeid		&& Removes a message ID from the set.
		*m: subtract		&& Introduced in version 11.3.0. Remove the message IDs in msgSet from the caller's message set.
		*m: tocommaseparatedstr		&& Returns a string of comma-separated message IDs. (This is the non-compact string format.) Returns Nothing on failure.
		*m: tocompactstring		&& Returns the set of message IDs represented as a compact string.
		*p: count		&& The number of message UIDs (or sequence numbers) in this message set.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: hasuids		&& If 1 then the message set contains UIDs, otherwise it contains sequence numbers.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = MessageSet
		count = 0
		debuglogfilepath = .NULL.
		hasuids = 1
		lastbinaryresult = .NULL.
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "messageset"
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/07/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		 Improved, better-defined error handling for FromCompactString, and improved performance for larger id sets.
		
		** Version 11.3.0
		
		  Subtract — Added the Subtract method to subtract one message set from another. 
		  This helps track which server messages haven’t been downloaded yet.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  (FIXED) The ActiveX LoadTaskResult methods always returned 0,
		  regardless of success/failure.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE containsid		&& Returns 1 if the msgId is contained in the message set.
		*==============================================================================
		* Method:            ContainsID
		* Purpose:           Returns 1 if the msgId is contained in the message set.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		*                    tuUID -- whether or not the message ID is a UID.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Returns 1 if the msgId is contained in the message set.
		**
		
		LPARAMETERS tuUID AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_MESSAGESET_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liUID AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUID
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUID = .LogicalToBit(m.tuUID)
		
		    TRY
		
		      STORE m.loChilkatObject.ContainsID(m.liUID) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE count_access		&& Access method used to retrieve the Chilkat MessageSet Count property.
		*==============================================================================
		* Method:            Count_Access
		* Purpose:           Access method used to retrieve 
		*                    the Count property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Count
		* Date Added:        06/18/2022
		*==============================================================================
		
		** 
		** The number of message UIDs (or sequence numbers) in this message set.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE count_assign		&& Assign method used to hold a reference to the Count property.
