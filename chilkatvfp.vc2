	PROCEDURE readfiletostring		&& Convenience method for reading a text file into a string. The character encoding of the text file is specified by srcCharset. Valid values, such as "iso-8895-1" or "utf-8" are listed at: List of Charsets. Returns Nothing on failure
		*==============================================================================
		* Method:            ReadFileToString
		* Purpose:           Convenience method for reading a text file into a string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to read.
		*                    tcCharset -- the charset for the file name
		* Returns:           Character
		* Date Added:        05/13/2022
		*==============================================================================
		
		**
		** Convenience method for reading a text file into a string. 
		** The character encoding of the text file is specified by srcCharset. 
		** Valid values, such as "iso-8895-1" or "utf-8" are listed at: List of Charsets.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTMLTOTEXT_COM_CALL, ;
		loException AS Exception, lcString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcString = m.loChilkatObject.ReadFileToString(m.tcFileName, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTMLTOTEXT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE rightmargin_access		&& Access method used to retrieve the Chilkat RIghtMargin property.
		*==============================================================================
		* Method:            RightMargin_Access
		* Purpose:           Access method used to retrieve the Chilkat HTMLToText RightMargin property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.RightMargin
		* Date Added:        05/13/2022
		*==============================================================================
		
		** 
		** Used to control wrapping of text. The default value is 80. 
		** When the text gets close to this margin, 
		** the converter will try to break the line at a SPACE character. 
		** Set this property to 0 for no right margin.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE rightmargin_assign		&& Assign method used to hold a reference to the RightMargin property.
