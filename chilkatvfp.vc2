		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uploadtransferrate_assign		&& Assign method used to hold a reference to the UploadTransferRate property
		*==============================================================================
		* Method:            UploadTransferRate_Assign
		* Purpose:           Assign method used to hold a reference to the UploadTransferRate property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the UploadTransferRate property.
		* Returns:           
		* Date Added:        02/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE useepsv_access		&& Access method used to retrieve the Chilkat UseEPSV property.
		*==============================================================================
		* Method:            UseEPSV_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 UseEPSV property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UseEPSV
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** If 1, the FTP2 component will use the EPSV command 
		** instead of PASV for passive mode data transfers. 
		** The default value of this property is 0. 
		** (It is somewhat uncommon for FTP servers to support EPSV.)
		**
		** Note: If the AutoFeat property is 1, 
		** then the FTP server's features are automatically queried after connecting. 
		** In this case, if the AutoSetUseEpsv property is also set to 1, 
		** the UseEpsv property is automatically set to 1 if the FTP server supports EPSV.
		**
		** Important: EPSV can cause problems with some deep-inspection firewalls. 
		** If a passive data connection cannot be established, 
		** make sure to test with both the AutoSetUseEpsv and UseEpsv properties set equal to 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE useepsv_assign		&& Assign method used to hold a reference to the UseEPSV property
		*==============================================================================
		* Method:            UseEPSV_Assign
		* Purpose:           Assign method used to hold a reference to the UseEPSV property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the UseEPSV property.
		* Returns:           
		* Date Added:        02/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE username_access		&& Access method used to retrieve the Chilkat UserName property.
		*==============================================================================
		* Method:            UserName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 UserName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UserName
		* Date Added:        02/28/2022
		*==============================================================================
		
		** 
		** Username for logging into the FTP server. Defaults to "anonymous".
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE username_assign		&& Assign method used to hold a reference to the UserName property
		*==============================================================================
