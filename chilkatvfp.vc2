	PROCEDURE sendcount		&& Sends a 4-byte signed integer on the connection. The receiver may call ReceiveCount to receive the integer. The SendCount and ReceiveCount methods are handy for sending byte counts prior to sending data.
		*==============================================================================
		* Method:            SendCount
		* Purpose:           Sends a 4-byte signed integer on the connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the number of bytes to send.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** Sends a 4-byte signed integer on the connection. 
		** The receiver may call ReceiveCount to receive the integer. 
		** The SendCount and ReceiveCount methods are handy 
		** for sending byte counts prior to sending data. 
		** The sender would send a count followed by the data, 
		** and the receiver would receive the count first, 
		** and then knows how many data bytes it should expect to receive.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiByteCount AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SendCount(m.tiByteCount) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendcountasync		&& Creates an asynchronous task to call the SendCount method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
