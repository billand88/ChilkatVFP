	PROCEDURE htmltomhtfile		&& Creates an MHT file from an in-memory HTML string. All external images and style sheets are downloaded and embedded in the MHT file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            HTMLToMHTFile
		* Purpose:           Creates an MHT file from an in-memory HTML string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHTML, the HTML to convert.
		*                    tcMHTFilePath, the file path to the saved MHT file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Creates an MHT file from an in-memory HTML string. 
		** All external images and style sheets are downloaded and embedded in the MHT file.
		** 
		** Fixed in version 59: MS-Word html files with %20 in file paths needed to be replaced with SPACE chars.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHTML AS Character, tcMHTFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.HTMLToMHTFile(m.tcHTML, m.tcMHTFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

