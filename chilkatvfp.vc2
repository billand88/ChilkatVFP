		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmailPartial, m.loChilkatEmailPartial, ;
		m.loParkParameterEmailFull, m.loChilkatEmailFull
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmailPartial = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatEmailFull = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmailPartial = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterEmailFull = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmailPartial = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatEmailFull = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT([Task])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fetchmime		&& Fetches an email by UIDL and returns the MIME source of the email in a byte array.
		*==============================================================================
		* Method:            FetchMIME
		* Purpose:           Fetches an email by UIDL 
		*                    and returns the MIME source of the email in a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUIDL -- the email UIDL.
		* Returns:           Variant
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** Fetches an email by UIDL and returns the MIME source of the email in a byte array.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcUIDL AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, lqByteArray AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqByteArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lqByteArray = m.loChilkatObject.FetchMIME(m.tcUIDL)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqByteArray
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

