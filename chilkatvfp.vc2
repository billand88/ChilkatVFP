	PROCEDURE readfiletext		&& This method is identical to ReadFileBytes except for one thing: The bytes are interpreted according to the specified charset (i.e. the character encoding) and returned as a string
		*==============================================================================
		* Method:            ReadFileText
		* Purpose:           This method is identical to ReadFileBytes except for one thing: 
		*                    The bytes are interpreted according to the specified charset
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		*                    tiBytes, the maximum number of bytes to read
		*                    tcCharset, the character set of the file.
		* Returns:           The character bytes from a specific file.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** This method is identical to ReadFileBytes except for one thing: 
		** The bytes are interpreted according to the specified charset 
		** (i.e. the character encoding) and returned as a string. 
		** A list of supported charset values may be found on this page: Supported Charsets.
		**
		** 
		** Note: If the charset is an encoding where a single character 
		** might be represented in multiple bytes (such as utf-8, Shift_JIS, etc.) 
		** then there is a risk that the very last character may be partially read. 
		** This is because the method specifies the number of bytes to read, 
		** not the number of characters. This is never a problem with character encodings 
		** that use a single byte per character, 
		** such as all of the iso-8859-* encodings, or the Windows-* encodings.
		** 
		** To read an entire file, one may call ReadFileText repeatedly 
		** until Eof(handle) returns 1.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHandle AS Character, tiBytes AS Integer, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, lcBytes AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcBytes = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcBytes = m.loChilkatObject.ReadFileText(m.tcHandle, m.tiBytes, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

