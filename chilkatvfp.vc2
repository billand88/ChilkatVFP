		      loChilkatPublicKeySignature = m.loParkParameterPublicKeySignature.GetObject()
		      loChilkatPublicKeyKeyExchange = m.loParkParameterPublicKeyKeyExchange.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetContainerKeys(m.tiIndex, ;
		        m.loChilkatPublicKeySignature, m.loChilkatPublicKeyKeyExchange) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPublicKeySignature = m.loParkParameterPublicKeySignature.SetObject(;
		      m.toChilkatPublicKeySignature, m.loChilkatPublicKeySignature)
		
		      toChilkatPublicKeyKeyExchange = m.loParkParameterPublicKeyKeyExchange.SetObject(;
		      m.toChilkatPublicKeyKeyExchange, m.loChilkatPublicKeyKeyExchange)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPublicKeySignature, m.loChilkatPublicKeySignature, ;
		m.loParkParameterPublicKeyKeyExchange, m.loChilkatPublicKeyKeyExchange
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  toChilkatPublicKeySignature = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  toChilkatPublicKeyKeyExchange = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loParkParameterPublicKeySignature = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPublicKeyKeyExchange = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPublicKeySignature = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loChilkatPublicKeyKeyExchange = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getcspcontainermap		&& Introduced in version 9.5.0.87. Returns the contents of the CSP container map file (cmapfile). The information is returned in the json. This gives an overview of what key containers and certificates exist in the smart card from a CSP's point of view.
		*==============================================================================
