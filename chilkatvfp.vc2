	HIDDEN PROCEDURE smtpssl_access		&& Access method used to retrieve a reference to the SMTPSSL property.
		*==============================================================================
		* Method:            SMTPSSL_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan SMTPSSL property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SMTPSSL
		* Date Added:        01/06/2022
		*==============================================================================
		
		**
		** When set to 1, causes the mailman to connect to the SMTP server via the TLS/SSL protocol.
		** (Visual FoxPro) GMail SMTP port 465 (SSL)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE smtpssl_assign		&& Assign method used to hold a reference to the SMTPSSL property.
		*==============================================================================
		* Method:            SMTPSSL_Assign
		* Purpose:           Assign method used to hold a reference to the SMTPSSL property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the SMTPSSL property.
		* Returns:           
		* Date Added:        01/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character, liValue AS Integer
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		WITH THIS
		
		  liValue = .LogicalToBit(m.tuValue)
		
		  .CallAssignObject(m.liValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ** SMTP turned on test
		  IF m.liValue = 1
		
		    .SMTPPort = 465
		
		  ENDIF m.liValue = 1
		  ** End SMTP turned on test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE smtpusername_access		&& Access method used to retrieve a reference to the SMTPUserName property.
		*==============================================================================
		* Method:            SMTPUserName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan SMTPUserName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SMTPUserName
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** The login for logging into the SMTP server. Use this only if your SMTP server requires authentication.
		**
		** Note: In many cases, an SMTP server will not require authentication when sending 
		** to an email address local to it's domain. However, when sending email to an external domain, 
		** authentication is required (i.e. the SMTP server is being used as a relay).
		**
		** If the SmtpAuthMethod property is set to "NTLM", the SmtpUsername and SmtpPassword 
		** properties may be set to the string "default" to use the current Windows logged-on user credentials.
		**
		** smtp.office365.com: If SMTP authentication fails for your smtp.office365.com account, 
		** it may be that your account is configured to require MFA (multi-factor authentication). 
		** You may need to change settings to allow for legacy authentication (single-factor auth). 
		** See https://docs.microsoft.com/en-us/azure/active-directory/conditional-access/block-legacy-authentication 
		** Also, an app password may be required. 
		** See https://docs.microsoft.com/en-us/azure/active-directory/user-help/multi-factor-authentication-end-user-app-passwords
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

