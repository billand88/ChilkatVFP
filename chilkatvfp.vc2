	PROCEDURE asyncabort		&& Decremented function! Causes an asynchronous Get or Put to abort.
		*==============================================================================
		* Method:            AsyncAbort
		* Purpose:           Decremented function! Causes an asynchronous Get or Put to abort.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Decremented function! Causes an asynchronous Get or Put to abort.
		** 
		** This functionality is replaced by the new model for asynchronous programming
		** introduced in Chilkat v9.5.0.52. Applications should use the new model, which is
		** identified by methods having names ending with "Async" and return a task object.
		**
		** Fixed for Version 51: This method was fixed.
		**
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AsyncAbort() && returns NULL?
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE asyncappendfilestart		&& Decremented function! Initiates an asynchronous append. The file is uploaded and appended to an existing file on the FTP server. The append happens in a background thread and can be aborted by calling AsyncAbort.
		*==============================================================================
		* Method:            AsyncAppendFileStart
		* Purpose:           Decremented function! Initiates an asynchronous append.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalFilePath -- contains the path to the local file.
		*                    tcRemoteFilePath -- contains the path to the remote file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Decremented function! Initiates an asynchronous append. The file is uploaded 
		** and appended to an existing file on the FTP server. 
		** The append happens in a background thread and can be aborted by calling AsyncAbort. 
		** The AsyncFinished property can be checked periodically to determine 
		** when the background transfer is finished. The status of the transfer is available 
		** in the AsyncSuccess property. The last-error information is available 
		** in the AsyncLog property. The AsyncBytesSent property is updated in real time 
		** to reflect the current number of bytes sent while the transfer is in progress. 
		** The UploadRate is also updated with the current upload rate in bytes/second. 
		** While a transfer is in progress, a program may periodically read the UploadRate 
		** and AsyncBytesSent properties to display progress.
		**
		** This functionality is replaced by the new model for asynchronous programming
		** introduced in Chilkat v9.5.0.52. Applications should use the new model, which is
		** identified by methods having names ending with "Async" and return a task object.
		**
		** Fixed for version 47: Async uploads mistakenly returned AsyncSuccess = true when aborted or failed.
		**
		
		LPARAMETERS tcLocalFilePath AS Character, tcRemoteFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AsyncAppendFileStart(m.tcLocalFilePath, m.tcRemoteFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE asyncbytesreceivedstr_access		&& Access method used to retrieve the Chilkat AsyncBytesReceivedStr property.
		*==============================================================================
		* Method:            AsyncBytesReceivedStr_Access
		* Purpose:           Access method used to retrieve 
		*                    the AsyncBytesReceivedStr property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AsyncBytesReceivedStr
		* Date Added:        02/23/2022
		*==============================================================================
		
		** 
		** The number of bytes received during an asynchronous FTP download. 
		** This property is updated in real-time and an application 
		** may periodically fetch and display it's value while the download is in progress.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

