	PROCEDURE postjsonasync		&& Creates an asynchronous task to call the PostJson method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            PostJSONAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the PostJson method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to post the content.
		*                    tcJSONText -- the JSON text to post.
		* Returns:           Chilkat Task object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the PostJson method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		** 
		** Fixed for version 73: Changed the default Content-Type for this method to be “application/json”. 
		** The original default value, “application/jsonrequest” was the initial “standard” years ago, 
		** but seems to never be used nowadays. If an “application/jsonrequest” is needed 
		** (and I doubt it will ever be needed), then PostJson2 may be called to explicitly specify the Content-Type.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character, tcJSONText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.PostJSONAsync(m.tcURL, m.tcJSONText)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE posturlencoded		&& Sends a simple URL encoded POST. The form parameters are sent in the body of the HTTP request in x-www-form-urlencoded format. The content-type is "application/x-www-form-urlencoded". Returns Nothing on failure
		*==============================================================================
		* Method:            PostURLEncoded
		* Purpose:           Sends a simple URL encoded POST.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to post the content.
		*                    toChilkatHTTPRequest -- the HTTP Request Object to post.
		* Returns:           Chilkat HTTP Response object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Sends a simple URL encoded POST. 
		** The form parameters are sent in the body of the HTTP request in x-www-form-urlencoded format. 
		** The content-type is "application/x-www-form-urlencoded".
		**
		** Enhancement for Version 40: For POST and PUT requests, ensures that 
		** a Content-Length header is always added even if the content length is 0.
		**
		** Fixed for version 73: The LastHeader property was empty after this method ran.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character, toChilkatHTTPRequest AS CHILKAT_HTTPREQUEST_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loParkParameterHTTPRequest AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatHTTPRequest AS CHILKAT_HTTPREQUEST_COM_CALL, ;
		llImplemented AS Logical, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse, ;
		m.loParkParameterHTTPRequest, m.loChilkatHTTPRequest 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterHTTPRequest = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHTTPRequest)
		
		    loChilkatHTTPRequest = m.loParkParameterHTTPRequest.GetObject()
		
		    TRY
		
		      loChilkatHTTPResponse = m.loChilkatObject.PostURLEncoded(m.tcURL, m.loChilkatHTTPRequest)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatHTTPRequest = ;
		    m.loParkParameterHTTPRequest.SetObject(m.toChilkatHTTPRequest, m.loChilkatHTTPRequest)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHTTPRequest, m.loChilkatHTTPRequest
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatHTTPRequest = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loParkParameterHTTPRequest = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatHTTPRequest = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

