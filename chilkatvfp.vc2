	PROCEDURE sshauthenticatepw		&& Authenticates with the SSH server using a sshLogin and sshPassword. An SSH tunneling (port forwarding) session always begins by first calling SshTunnel to connect to the SSH server, then calling either AuthenticatePw or AuthenticatePk to authenticate.
		*==============================================================================
		* Method:            SSHAuthenticatePW
		* Purpose:           Authenticates with the SSH server using a sshLogin and sshPassword.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSSHLogin -- the SSH Login name.
		*                    tcSSHPassword -- the SSH Password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Authenticates with the SSH server using a sshLogin and sshPassword.
		**
		** An SSH tunneling (port forwarding) session always begins by first calling SshTunnel 
		** to connect to the SSH server, then calling either AuthenticatePw or AuthenticatePk to authenticate.
		**
		** Note: Once the SSH tunnel is setup by calling SshTunnel and SshAuthenticatePw (or SshAuthenticatePk), 
		** all underlying communcations with the POP3 or SMTP server use the SSH tunnel. 
		** No changes in programming are required other than making two initial calls to setup the tunnel.
		**
		** Important: When reporting problems, please send the full contents of the LastErrorText property 
		** to support@chilkatsoft.com.
		**
		** Enhancement for Version 48: 
		** Improved performance through the automatic (internal) use of pipelining.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSSHLogin AS Character, tcSSHPassword AS String
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.liReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SSHAuthenticatePW(m.tcSSHLogin, m.tcSSHPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense testp[
	ENDPROC

