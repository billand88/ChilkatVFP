	PROCEDURE scrub		&& Introduced in version 9.5.0.77. Recursively traverses the XML rooted at the caller and scrubs according to the instructions in the comma separated directives.
		*==============================================================================
		* Method:            Scrub
		* Purpose:           Recursively traverses the XML rooted at the caller and scrubs 
		*                    according to the instructions in the comma separated directives.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectives -- the directives to execute.
		* Returns:           
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Recursively traverses the XML rooted at the caller and scrubs 
		** according to the instructions in the comma separated directives. 
		** The currently defined directives are:
		** 
		** "AttrTrimEnds" - Leading and trailing whitespace removed from attribute values.
		** "AttrTrimInside" - Replace all tabs, CR's, and LF's with SPACE chars, 
		** and removes extra SPACE chars so that no more than one SPACE char in a row exists.
		** "ContentTrimEnds" - Same as AttrTrimEnds but for content.
		** "ContentTrimInside" - Same as AttrTrimInside but for content.
		** "LowercaseAttrs" - Convert all attribute names to lowercase.
		** "LowercaseTags" - Convert all tags to lowercase.
		** "RemoveCtrl" - Remove non-printable us-ascii control chars 
		** (us-ascii values <= 31 except for TAB,CR, and LF are removed)
		**
		** If you have other ideas for useful XML scrubbing directives, 
		** send email to support@chilkatsoft.com. 
		** It must be general enough such that many developers will find it useful.
		**
		
		LPARAMETERS tcDirectives AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.Scrub(m.tcDirectives)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE searchallforcontent		&& Returns the first node having content matching the contentPattern. The contentPattern is a case-sensitive string that may contain any number of '*'s, each representing 0 or more occurrences of any character
		*==============================================================================
		* Method:            SearchAllForContent
		* Purpose:           Returns the first node having content matching the contentPattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML, a Chilkat XML object to search against.
		*                    tcContentPattern, the content pattern to search
		* Returns:           loChilkatXMLMatch, a Chilkat XML object.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Returns the first node having content matching the contentPattern. 
		** The contentPattern is a case-sensitive string that may contain 
		** any number of '*'s, each representing 0 or more occurrences of any character. 
		** The search is breadth-first over the sub-tree rooted at the caller. 
		** A match is returned only after the search has traversed past the node indicated by afterPtr. 
		** To find the 1st occurrence, set afterPtr equal to Nothing. 
		** (For the ActiveX implementation, the afterPtr should never be Nothing. 
		** A reference to the caller's node should be passed instead.)
		** 
		** To iterate over matching nodes, the returned node 
		** can be passed in afterPtr for the next call to SearchAllForContent, 
		** until the method returns Nothing.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL, tcContentPattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, loChilkatXMLMatch AS CHILKAT_XML_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatXMLMatch, m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      loChilkatXMLMatch = ;
		      m.loChilkatObject.SearchAllForContent(m.loChilkatXML, m.tcContentPattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatXMLMatch
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loChilkatXMLMatch = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE searchallforcontent2		&& Same as SearchAllForContent except the internal reference of the caller is updated to point to the search result (instead of returning a new object). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SearchAllForContent2
		* Purpose:           Same as SearchAllForContent except the internal reference 
		*                    of the caller is updated to point to the search result.
		* Author:            Bill Anderson
