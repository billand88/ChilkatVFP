	PROCEDURE getpkcsbd		&& Introduced in version 11.0.0. Retrieves the private key in binary DER format. If pkcs1 is 1, it uses the PKCS1 format; if 0, it uses the PKCS8 format. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetPkcsBd
		* Purpose:           Retrieves the private key in binary DER format. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuPkcs1Format, whether or not to use Pkcs1 format
		*                    tcPassword, the password to the private key
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Retrieves the private key in binary DER format. 
		** If pkcs1 is 1, it uses the PKCS1 format; if 0, it uses the PKCS8 format. 
		** If password is non-empty and the PKCS8 format is specified, 
		** an encrypted PKCS8 key is returned. The private key is returned in bd.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuPkcs1Format AS Unknown, tcPassword AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, liUsePkcs1Format AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUsePkcs1Format
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUsePkcs1Format = .LogicalToBit(m.tuPkcs1Format)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetPkcsBd(m.liUsePkcs1Format, ;
		        m.tcPassword) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = m.loParkParameterBinData.SetObject(;
		      m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.luReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getpublickey		&& Introduced in version 9.5.0.52. Returns the public key portion of the private key as a public key object. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetPublicKey
		* Purpose:           Returns the public key portion of the private key as a public key object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
