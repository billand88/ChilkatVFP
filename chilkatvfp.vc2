	PROCEDURE getservercert		&& Introduced in version 11.0.0. Returns the IMAP server's digital certificate (for SSL / TLS connections). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetServerCert
		* Purpose:           Returns the IMAP server's digital certificate (for SSL / TLS connections).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Returns the IMAP server's digital certificate (for SSL / TLS connections).
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetServerCert(m.loChilkatCert) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsslservercert		&& Returns the IMAP server's digital certificate (for SSL / TLS connections). Returns Nothing on failure.
		*==============================================================================
		* Method:            GetSSLServerCert
		* Purpose:           Returns the IMAP server's digital certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat Certificate object, or NULL
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Returns the IMAP server's digital certificate (for SSL / TLS connections).
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.GetSSLServerCert()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN lcResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE hascapability		&& Introduced in version 9.5.0.58. Returns 1 if the capability indicated by name is found in the capabilityResponse. Otherwise returns 0.
		*==============================================================================
		* Method:            HasCapability
		* Purpose:           Returns 1 if the capability indicated by name 
		*                    is found in the capabilityResponse.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCapability -- the capability to test.
		*                    tcResponse -- the capability response.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Returns 1 if the capability indicated by name is found 
		** in the capabilityResponse. Otherwise returns 0.
		**
		** Fix for version 77: This method returned an incorrect answer 
		** if the capability in question was the last one listed in the IMAP 
		** server’s capability response and a CRLF followed. 
		** For example, querying for “QUOTA” — if the capability string ends with “QUOTA\r\n”, 
		** such as “* CAPABILITY IMAP4rev1 LITERAL+ SASL-IR LOGIN-REFERRALS …. SPECIAL-USE QUOTA\r\n”, 
		** then this method would return False/0.
		**
		
		LPARAMETERS tcCapability AS Character, tcResponse AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.HasCapability(m.tcCapability, m.tcResponse) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat IMAP HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** This is the number of milliseconds between each AbortCheck event callback. 
		** The AbortCheck callback allows an application to abort any IMAP operation 
		** prior to completion. If HeartbeatMs is 0, no AbortCheck event callbacks will occur.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat IMAP HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the HeartbeatMs property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE highestmodseq_access		&& Access method used to retrieve the Chilkat IMAP HighestModSeq property.
		*==============================================================================
		* Method:            HighestModSeq_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP HighestModSeq property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HighestModSeq
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** A string containing an integer value that is the HIGHESTMODSEQ 
		** of the currently selected mailbox, or 0 if no mailbox is selected. 
		** (Chilkat decided to make this a string property for the chance 
		** that HIGHESTMODSEQ is an extremely large integer.)
		** 
		** Not all IMAP servers support HIGHESTMODSEQ. 
		** See RFC 4551 Section 3.1.1 HIGHESTMODSEQ Response Code for more information.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE highestmodseq_assign		&& Assign method used to hold a reference to the HighestModSeq property.
		*==============================================================================
		* Method:            HighestModSeq_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat IMAP HighestModSeq property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the HighestModSeq property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE httpproxyauthmethod_access		&& Access method used to retrieve the Chilkat IMAP HTTPProxyAuthMethod property.
		*==============================================================================
		* Method:            HTTPProxyAuthMethod_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP HTTPProxyAuthMethod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HTTPProxyAuthMethod
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** If an HTTP proxy requiring authentication is to be used, set this property 
		** to the HTTP proxy authentication method name. Valid choices are "Basic" or "NTLM".
		**
		** Fixed in Version 51: Fixed issues related to using 
		** HTTP proxies for non-HTTP protocols where SSL/TLS is not used.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

