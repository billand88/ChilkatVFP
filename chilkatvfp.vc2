	HIDDEN PROCEDURE usebasicauth_access		&& Access method used to retrieve the Chilkat oAuth2 UseBasicAuth property.
		*==============================================================================
		* Method:            UseBasicAuth_Access
		* Purpose:           Access method used to retrieve 
		*                    the UseBasicAuth property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UseBasicAuth
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.73
		**
		** If set to 1, then the internal POST (on the background thread) 
		** that exchanges the code for an access token will send 
		** the client_id/client_secret in an "Authorization Basic ..." 
		** header where the client_id is the login and the client_secret is the password.
		**
		** Some services, such as fitbit.com, require the client_id/client_secret to be passed in this way.
		**
		** The default value of this property is 0, which causes the client_id/client_secret 
		** to be sent as query params.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 73
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE usebasicauth_assign		&& Assign method used to hold a reference to the UseBasicAuth property.
		*==============================================================================
		* Method:            UseBasicAuth_Assign
		* Purpose:           Assign method used to retrieve 
