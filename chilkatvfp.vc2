	PROCEDURE feat		&& Sends a FEAT command to the FTP server and returns the response. Returns a zero-length string to indicate failure.
		*==============================================================================
		* Method:            FEAT
		* Purpose:           Sends a FEAT command to the FTP server and returns the response.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Character
		* Date Added:        03/02/2022
		*==============================================================================
		
		**
		** Sends a FEAT command to the FTP server and returns the response. 
		** Returns a zero-length string to indicate failure. Here is a typical response:
		** 
		** 211-Features:
		**
		**  MDTM
		**  REST STREAM
		**  SIZE
		**  MLST type*;size*;modify*;
		**  MLSD
		**  AUTH SSL
		**  AUTH TLS
		**  UTF8
		**  CLNT
		**  MFMT
		** 211 End
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, lcResponse AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcResponse = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcResponse = m.loChilkatObject.FEAT()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE featasync		&& Creates an asynchronous task to call the Feat method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
