	PROCEDURE getencoded		&& Returns the character string in an encoding use the charsetEncoding specified. The binaryEncoding may be "base64", "hex", "url", or "quoted-printable".
		*==============================================================================
		* Method:            GetEncoded
		* Purpose:           Returns the character string in an encoding 
		*                    using the charsetEncoding specified.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBinaryEncoding, the binary encoding of the string.
		*                    tcEncoding, the encoding of the string to append.
		* Returns:           
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Returns the character string in an encoding using the charsetEncoding specified. 
		** The binaryEncoding may be "base64", "hex", "url", or "quoted-printable". For example:
		** 
		**   (Visual Basic 6.0)
		** 
		**   Dim s As New CkString
		** 
		**   s.Str = "Ã¨Ã¨Ã¨"
		**   Text1.Text = s.GetEncoded("hex", "iso-8859-1") & vbCrLf
		**   Text1.Text = Text.Text & s.GetEncoded("hex", "utf-8") & vbCrLf
		**   Text1.Text = Text1.Text & s.GetEncoded("hex", "unicode")
		** 
		**   'Output:
		**   'E8E8E8
		**   'C3A8C3A8C3A8
		**   'E800E800E800
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcBinaryEncoding AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, lcEncoded AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncoded = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncoded = m.loChilkatObject.GetEncoded(m.tcBinaryEncoding, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncoded
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

