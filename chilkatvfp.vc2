		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, lcECDSAEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterCert, ;
		m.loChilkatCert, m.loParkParameterBinData, m.loChilkatBinData 
		
		lcECDSAEncodedString = []
		llImplemented = .F.
		liIntroducedInBuild = 91
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        lcECDSAEncodedString = m.loChilkatObject.SignBdUsingCert(;
		        m.loChilkatBinData, m.tcHashAlgorithm, m.tcEncoding, m.loChilkatCert) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterCert, ;
		m.loChilkatCert, m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.lcECDSAEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signhashenc		&& Introduced in version 9.5.0.52. Computes an ECDSA signature on a hash. ECDSA signatures are computed and verified on the hashes of data (such as SHA1, SHA256, etc.). The hash of the data is passed in encodedHash.
		*==============================================================================
		* Method:            SignHashENC
		* Purpose:           Computes an ECDSA signature on a hash.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedHash, the hash of the data.
		*                    tcEncoding, the encoding of the data.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		*                    toChilkatPrng, a Chilkat Pseudo Random Number Generator object.
		* Returns:           The ECDSA encoded signature string.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Computes an ECDSA signature on a hash. ECDSA signatures are computed and verified 
		** on the hashes of data (such as SHA1, SHA256, etc.). The hash of the data 
		** is passed in encodedHash. The encoding, such as "base64", "hex", etc. is passed in encoding. 
		** The ECDSA private key is passed in the 3rd argument (privkey). 
		** Given that creating an ECDSA signature involves the generation of random numbers, 
		** a PRNG is passed in the 4th argument (prng). The signature is returned 
		** as an encoded string using the encoding specified by the encoding argument.
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEncodedHash AS Character, tcEncoding AS Character, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, toChilkatPrng AS CHILKAT_PRNG_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loParkParameterPrng AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrng AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		lcECDSAEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterPrivateKey, ;
		m.loChilkatPrivateKey, m.loParkParameterPrng, m.loChilkatPrng
		
		lcECDSAEncodedString = []
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loParkParameterPrng = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrng)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		      loChilkatPrng = m.loParkParameterPrng.GetObject()
		
		      TRY
		
		        lcECDSAEncodedString = m.loChilkatObject.SignHashENC(m.tcEncodedHash, ;
		        m.tcEncoding, m.loChilkatPrivateKey, m.loChilkatPrng) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		      toChilkatPrng = ;
		      m.loParkParameterPrng.SetObject(m.toChilkatPrng, m.loChilkatPrng)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterPrivateKey, ;
		m.loChilkatPrivateKey, m.loParkParameterPrng, m.loChilkatPrng
		
		RETURN m.lcECDSAEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  toChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrng = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signhashusingcert		&& Introduced in version 10.1.0. Computes an ECDSA signature on a hash. ECDSA signatures are computed and verified on the hashes of data (such as SHA1, SHA256, etc.). The hash of the data is passed in encodedHash.
		*==============================================================================
		* Method:            SignHashUsingCert
		* Purpose:           Computes an ECDSA signature on a hash.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedHash, the hash of the data.
		*                    tcEncoding, the encoding of the data.
		*                    toChilkatCert, a Chilkat Certificate object.
		* Returns:           The ECDSA encoded signature string.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		**
		** Computes an ECDSA signature on a hash. ECDSA signatures are computed and verified 
		** on the hashes of data (such as SHA1, SHA256, etc.). 
		** The hash of the data is passed in encodedHash. 
		** The encoding, such as "base64", "hex", etc. is passed in encoding. 
		** The certificate having a private key is passed in cert. 
		** The signature is returned as an encoded string using the encoding specified by the encoding argument.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEncodedHash AS Character, tcEncoding AS Character, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception, lcECDSAEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterCert, m.loChilkatCert
		
		lcECDSAEncodedString = []
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        lcECDSAEncodedString = m.loChilkatObject.SignHashUsingCert(m.tcEncodedHash, ;
		        m.tcEncoding, m.loChilkatCert) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterCert, ;
		m.loChilkatCert, m.loParkParameterPrng, m.loChilkatPrng
		
		RETURN m.lcECDSAEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrng = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat ECC VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/22/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/22/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE verifybd		&& Introduced in version 9.5.0.85. This method is the same as VerifyHashENC, except the actual data to be verified and the name of the hash algorithm is passed in. The following hash algorithms are supported: sha256, sha384, and sha512.
		*==============================================================================
		* Method:            VerifyBd
		* Purpose:           This method is the same as VerifyHashENC, except the actual data 
		*                    to be verified and the name of the hash algorithm is passed in.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		*                    tcHashAlgorithm, the hash algorithm used to validate.
		*                    tcEncodedSignature, the encoded ECDSA signature.
		*                    tcEncoding, the encoding of the hash and signature.
		*                    toChilkatPublicKey, a Chilkat Public Key object.
		* Returns:           The numeric verification status.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.85
		** 
		** This method is the same as VerifyHashENC, except the actual data 
		** to be verified and the name of the hash algorithm is passed in. 
		** The following hash algorithms are supported: sha256, sha384, and sha512.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tcHashAlgorithm AS Character, ;
		tcEncodedSignature AS Character, tcEncoding AS Character, ;
		toChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loParkParameterPublicKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL, ;
		loException AS Exception, liVerificationStatus AS Integer
		
		STORE 0 TO m.liVerificationStatus, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterBinData, ;
		m.loChilkatBinData, m.loParkParameterPublicKey, m.loChilkatPublicKey  
		
		llImplemented = .F.
		liIntroducedInBuild = 85
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loParkParameterPublicKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPublicKey)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		      loChilkatPublicKey = m.loParkParameterPublicKey.GetObject()
		
		      TRY
		
		        liVerificationStatus = m.loChilkatObject.VerifyBd(m.loChilkatBinData, ;
		        m.tcHashAlgorithm, m.tcEncodedSignature, m.tcEncoding, m.loChilkatPublicKey)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		      toChilkatPublicKey = ;
		      m.loParkParameterPublicKey.SetObject(m.toChilkatPublicKey, m.loChilkatPublicKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterBinData, ;
		m.loChilkatBinData, m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		RETURN m.liVerificationStatus
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPublicKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE verifyhashenc		&& Introduced in version 9.5.0.52. Verifies an ECDSA signature. ECDSA signatures are computed and verified on the hashes of data (such as SHA1, SHA256, etc.). The hash of the data is passed in encodedHash.
		*==============================================================================
		* Method:            VerifyHashENC
		* Purpose:           Verifies an ECDSA signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedHash, the hash of the data to validate.
		*                    tcEncodedSignature, the encoded ECDSA signature.
		*                    tcEncoding, the encoding of the hash and signature.
		*                    toChilkatPublicKey, a Chilkat Public Key object.
		* Returns:           The numeric verification status.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** Verifies an ECDSA signature. ECDSA signatures are computed and verified 
		** on the hashes of data (such as SHA1, SHA256, etc.).
		** The hash of the data is passed in encodedHash. The encoded signature is passed in encodedSig. 
		** The encoding of both the hash and signature, such as "base64", "hex", etc. 
		** is passed in encoding. The ECDSA public key is passed in the last argument (pubkey).
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** The method returns 1 for a valid signature, 0 for an invalid signature, 
		** and -1 for any other failure.
		**
		
		LPARAMETERS tcEncodedHash AS Character, tcEncodedSignature AS Character, ;
		tcEncoding AS Character, toChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPublicKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL, ;
		loException AS Exception, liVerificationStatus AS Integer
		
		STORE 0 TO m.liVerificationStatus, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey  
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPublicKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPublicKey)
		
		      loChilkatPublicKey = m.loParkParameterPublicKey.GetObject()
		
		      TRY
		
		        liVerificationStatus = m.loChilkatObject.VerifyHashENC(m.tcEncodedHash, ;
		        m.tcEncodedSignature, m.tcEncoding, m.loChilkatPublicKey)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPublicKey = ;
		      m.loParkParameterPublicKey.SetObject(m.toChilkatPublicKey, m.loChilkatPublicKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		RETURN m.liVerificationStatus
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loParkParameterPublicKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS eddsa AS ibasechilkat OF "chilkatvfp.vcx" 		&& Class for generating Ed25519 keys and creating/validating Ed25519 signatures. This class was added in v9.5.0.83.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: algorithm_access		&& Access method used to retrieve the Chilkat EdDSA Algorithm property.
		*m: algorithm_assign		&& Assign method used to hold a reference to the Algorithm property.
		*m: context_access		&& Access method used to retrieve the Chilkat EdDSA Context property.
		*m: context_assign		&& Assign method used to hold a reference to the Context property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat EdDSA DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: gened25519key		&& Introduced in version 9.5.0.83. Generates an Ed25519 key. privKey is an output argument. The generated key is created in privKey. Returns 1 for success, 0 for failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat EdDSA LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat EdDSA LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat EdDSA LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat EdDSA LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat EdDSA LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat EdDSA LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat EdDSA LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: sharedsecretenc		&& Introduced in version 9.5.0.83. Computes a shared secret given a private and public key.
		*m: signbdenc		&& Introduced in version 9.5.0.83. Signs the contents of bd and returns the signature according to encoding. The encoding can be any encoding supported by Chilkat, such as "hex", "base64", etc. Returns Nothing on failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat EdDSA VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifybdenc		&& Introduced in version 9.5.0.83. Verifies the signature against the contents of bd. The encodedSig is passed as an encoded string (such as hex, base64, etc.) using the encoding specified by enocding.
		*p: algorithm		&& Introduced in version 9.5.0.91. Can be "Ed25519", "Ed25519ph", or "Ed25519ctx". The default is "Ed25519". This property was introduced in v9.5.0.91. Prior to this version, "Ed25519" was the only EdDSA instance supported.
		*p: context		&& Introduced in version 9.5.0.91. The context bytes (in hex string format) to be used for Ed25519ctx or Ed25519ph.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		algorithm = Ed25519
		cchilkatclass = EdDSA
		context = 
		debuglogfilepath = 
		iinstancepatch = 83
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "eddsa"
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE algorithm_access		&& Access method used to retrieve the Chilkat EdDSA Algorithm property.
		*==============================================================================
		* Method:            Algorithm_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat EdDSA Algorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Algorithm
		* Date Added:        07/21/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.91
		**
		** Can be "Ed25519", "Ed25519ph", or "Ed25519ctx". The default is "Ed25519". 
		** This property was introduced in v9.5.0.91. Prior to this version, 
		** "Ed25519" was the only EdDSA instance supported.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 91
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE algorithm_assign		&& Assign method used to hold a reference to the Algorithm property.
		*==============================================================================
		* Method:            Algorithm_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat EdDSA Algorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Algorithm property.
		* Returns:           
		* Date Added:        07/21/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 91
		
		lcValidationMethod = [Algorithm_EdDSA]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 83
		
		  Added an EdDSA class for Ed25519 signatures and key generation.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		** Version 65
		
		  Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		  See https://www.example-code.com/foxpro/edifact_eda_syntax_level_A_encoding.asp
		  Also see: https://cknotes.com/chilkat-binary-encoding-list/
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE context_access		&& Access method used to retrieve the Chilkat EdDSA Context property.
		*==============================================================================
		* Method:            Context_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat EdDSA Context property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Context
		* Date Added:        07/21/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.91
		**
		** The context bytes (in hex string format) to be used for Ed25519ctx or Ed25519ph.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 91
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

