	PROCEDURE uploadfile		&& Introduced in version 11.4.0. Uploads a file and returns the file_id (or uri) that can be used to reference the pre-uploaded file using InputAddFileId before an Ask.
		*==============================================================================
		* Method:            UploadFile
		* Purpose:           Uploads a file and returns the file_id (or uri).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath - the path to the file to be uploaded.
		*                    tcMimeType, the MIME file type.
		* Returns:           Character
		* Date Added:        04/01/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0.
		** 
		** Uploads a file and returns the file_id (or uri) that can be used to reference 
		** the pre-uploaded file using InputAddFileId before an Ask. 
		** Files can be uploaded to the following providers: openai, gemini, claude, and grok. 
		** The mimeType specifies the MIME type, such as "application/pdf" or "text/plain". 
		** If mimeType is the emptys string, Chilkat will automatically choose 
		** the MIME type based on the filename extension.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcFilePath AS Character, tcMimeType AS Character 
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, lcFile_ID AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		lcFile_ID = []
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcFile_ID = m.loChilkatObject.UploadFile(m.tcFilePath, m.tcMimeType)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFile_ID
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

