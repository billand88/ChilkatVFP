	HIDDEN PROCEDURE charset_access		&& Access method used to retrieve the Chilkat Compression Charset property.
		*==============================================================================
		* Method:            Charset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Compression Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Charset
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** Only applies to methods that compress or decompress strings. 
		** This specifies the character encoding that the string 
		** should be converted to before compression. 
		** Many programming languages use Unicode (2 bytes per char) for representing characters. 
		** This property allows for the string to be converted to a 1-byte per char encoding 
		** prior to compression.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE charset_assign		&& Assign method used to hold a reference to the Charset property.
		*==============================================================================
		* Method:            Charset_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Compression Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Charset property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/05/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Removed the UnlockComponent method.
		
		  Added the FirstChunk, LastChunk and UncommonOptions properties.
		
		  Added the CompressBd2, CompressBd2Async, CompressStr, CompressStrAsync, 
		  DecompressBd2 and DecompressBd2 methods.
		
		  Decremented the BeginCompressBytes, BeginCompressBytesAsync, BeginCompressBytesENC, BeginCompressBytesENCAsync, 
		  BeginCompressString, BeginCompressStringAsync, BeginCompressStringENC, BeginCompressStringENCAsync, 
		  BeginDecompressBytes, BeginDecompressBytesAsync, BeginDecompressBytesENC, BeginDecompressBytesENCAsync, 
		  BeginDecompressString, BeginDecompressStringAsync, BeginDecompressStringENC, BeginDecompressStringENCAsync, 
		  EndCompressBytes, EndCompressBytesAsync, EndCompressBytesENC, EndCompressByteENCsAsync, 
		  EndCompressString, EndCompressStringAsync, EndCompressStringENC, EndCompressStringENCAsync, 
		  EndDecompressBytes, EndDecompressBytesAsync, EndDecompressBytesENC, EndDecompressBytesENCAsync, 
		  EndDecompressString, EndDecompressStringAsync, EndDecompressStringENC, EndDecompressStringENCAsync, 
		  MoreCompressBytes, MoreCompressBytesAsync, MoreCompressBytesENC, MoreCompressByteENCsAsync, 
		  MoreCompressString, MoreCompressStringAsync, MoreCompressStringENC, MoreCompressStringENCAsync, 
		  MoreDecompressBytes, MoreDecompressBytesAsync, MoreDecompressBytesENC, MoreDecompressBytesENCAsync, 
		  MoreDecompressString, MoreDecompressStringAsync, MoreDecompressStringENC and MoreDecompressStringENCAsync methods.
		
		** Version 99
		
		  Added the CompressEncryptFile and DecryptDecompressFile methods to make it easy 
		  to both compress and encrypt files, and to do the reverse. 
		  This is especially important when working with extremely large files that won’t fit in memory.
		
		** Version 77
		
		  When compressing in chunks using BeginCompressBytesENC / MoreCompressBytesENC / EndCompressBytesENC,
		  if the EncodingMode is base64, the final bit of data was not emitted in EndCompressBytesENC.
		
		** Version 73
		
		  Added the DeflateLevel property to the Compression class.
		
		  Added the CompressSb and DecompressSb methods.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 59
		
		  Fixed the CompressFile method for large files. 
		  See http://www.chilkatforum.com/questions/10752/compressioncompressfile-failing-on-large-file-28-gb
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 56
		
		  Added the CompressStream and DecompressStream methods.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE compressbd		&& Introduced in version 9.5.0.66. Compresses the data contained in a BinData object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CompressBd
		* Purpose:           Compresses the data contained in a BinData object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Compresses the data contained in a BinData object.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CompressBd(m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE compressbd2		&& Introduced in version 11.0.0. This method compresses the data in bdIn without modifying it and appends the compressed data to bdOut. It is also FirstChunk/LastChunk aware. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CompressBd2
		* Purpose:           This method compresses the data in bdIn without modifying it 
		*                    and appends the compressed data to bdOut.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinDataIn, a Chilkat Binary Data object.
		*                    toChilkatBinDataOut, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This method compresses the data in bdIn without modifying it 
		** and appends the compressed data to bdOut. 
		** It is also FirstChunk/LastChunk aware.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, toChilkatBinDataOut AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, llImplemented AS Logical, ;
		loParkParameterBinDataIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, loChilkatBinDataOut AS CHILKAT_BINDATA_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterBinDataIn, ;
		m.loParkParameterBinDataOut, m.loChilkatBinDataIn, m.loChilkatBinDataOut
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinDataIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataIn)
		
		      loChilkatBinDataIn = m.loParkParameterBinDataIn.GetObject()
