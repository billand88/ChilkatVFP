		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/15/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold the Chilkat OAuth1 VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS oauth2 AS ibasechilkat OF "chilkatvfp.vcx" 		&& The Chilkat OAuth2 class enables desktop applications and scripts to implement the OAuth2 Authorization Code Flow for obtaining an initial access token.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: accesstokenresponse_access		&& Access method used to retrieve the Chilkat oAuth2 AccessTokenResponse property.
		*m: accesstokenresponse_assign		&& Assign method used to hold a reference to the AccessTokenResponse property.
		*m: accesstoken_access		&& Access method used to retrieve the Chilkat oAuth2 AccessToken property.
		*m: accesstoken_assign		&& Assign method used to hold a reference to the AccessToken property.
		*m: addauthqueryparam		&& Introduced in version 9.5.0.85. Adds an additional custom query param (name=value) to the URL that is returned by the StartAuth method. This method exists to satisfy OAuth installations that require non-standard/custom query parms.
		*m: addrefreshqueryparam		&& Introduced in version 9.5.0.97. Adds an additional query param (name=value) to the HTTP request sent in the RefreshAccessToken method. This method can be called multiple times, once per additional query parm to be added.
		*m: addtokenqueryparam		&& Introduced in version 9.5.0.85. Adds an additional custom query param (name=value) to the request that occurs (internally) to exchange the authorization code for a token.
		*m: appcallbackurl_access		&& Access method used to retrieve the Chilkat oAuth2 AppCallbackURL property.
		*m: appcallbackurl_assign		&& Assign method used to hold a reference to the AppCallbackURL property.
		*m: authflowstate_access		&& Access method used to retrieve the Chilkat oAuth2 AuthFlowState property.
		*m: authflowstate_assign		&& Assign method used to hold a reference to the AuthFlowState property.
		*m: authorizationendpoint_access		&& Access method used to retrieve the Chilkat oAuth2 AuthorizationEndPoint property.
		*m: authorizationendpoint_assign		&& Assign method used to hold a reference to the AuthorizationEndPoint property.
		*m: cancel		&& Introduced in version 9.5.0.59. Cancels an OAuth2 authorization flow that is in progress. Returns 1 for success, 0 for failure.
		*m: clientid_access		&& Access method used to retrieve the Chilkat oAuth2 ClientID property.
		*m: clientid_assign		&& Assign method used to hold a reference to the ClientID property.
		*m: clientsecret_access		&& Access method used to retrieve the Chilkat oAuth2 ClientSecret property.
		*m: clientsecret_assign		&& Assign method used to hold a reference to the ClientSecret property.
		*m: codechallengemethod_access		&& Access method used to retrieve the Chilkat oAuth2 CodeChallengeMethod property.
		*m: codechallengemethod_assign		&& Assign method used to hold a reference to the CodeChallengeMethod property.
		*m: codechallenge_access		&& Access method used to retrieve the Chilkat oAuth2 CodeChallenge property.
		*m: codechallenge_assign		&& Assign method used to hold a reference to the CodeChallenge property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat oAuth2 DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugFilePath property.
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat oAuth2 EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: failureinfo_access		&& Access method used to retrieve the Chilkat oAuth2 FailureInfo property.
		*m: failureinfo_assign		&& Assign method used to hold a reference to the FailureInfo property.
		*m: getaccesstokenresponsesb		&& Introduced in version 10.1.0. Same as the AccessTokenResponse property, but returns the JSON in the sb. Returns 1 for success, 0 for failure.
		*m: getredirectrequestparam		&& Introduced in version 9.5.0.69. Some OAuth2 providers can provide additional parameters in the redirect request sent to the local listener (i.e. the Chilkat background thread).
		*m: includenonce_access		&& Access method used to retrieve the Chilkat oAuth2 IncludeNonce property.
		*m: includenonce_assign		&& Assign method used to hold a reference to the IncludeNonce property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat oAuth2 LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat oAuth2 LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat oAuth2 LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorrText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat oAuth2 LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorrXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat oAuth2 LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat oAuth2 LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat oAuth2 LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: launchbrowser		&& Introduced in version 10.1.2. Launches the default browser and navigated to url. If a browser window is already open, the page will be displayed in a new tab. This works on Windows, MacOS, and Linux. Returns 1 for success, 0 for failure.
		*m: listenportrangeend_access		&& Access method used to retrieve the Chilkat oAuth2 ListenPortRangeEnd property.
		*m: listenportrangeend_assign		&& Assign method used to hold a reference to the ListenPortRangeEnd property.
		*m: listenportselected_access		&& Access method used to retrieve the Chilkat oAuth2 ListenPortSelected property.
		*m: listenportselected_assign		&& Assign method used to hold a reference to the ListenPortSelected property.
		*m: listenport_access		&& Access method used to retrieve the Chilkat oAuth2 ListenPort property.
		*m: listenport_assign		&& Assign method used to hold a reference to the ListenPort property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: localhost_access		&& Access method used to retrieve the Chilkat oAuth2 LocalHost property.
		*m: localhost_assign		&& Assign method used to hold a reference to the LocalHost property.
		*m: monitor		&& Introduced in version 9.5.0.59. Monitors an already started OAuth2 authorization flow and returns when it is finished. Note: It rarely makes sense to call this method.
		*m: monitorasync		&& Introduced in version 9.5.0.59. Creates an asynchronous task to call the Monitor method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: noncelength_access		&& Access method used to retrieve the Chilkat oAuth2 NonceLength property.
		*m: noncelength_assign		&& Assign method used to hold a reference to the NonceLength property.
		*m: redirectallowhtml_access		&& Access method used to retrieve the Chilkat oAuth2 RedirectAllowHTML property.
		*m: redirectallowhtml_assign		&& Assign method used to hold a reference to the RedirectAllowHTML property.
		*m: redirectdenyhtml_access		&& Access method used to retrieve the Chilkat oAuth2 RedirectDenyHTML property.
		*m: redirectdenyhtml_assign		&& Assign method used to hold a reference to the RedirectDenyHTML property.
		*m: redirectreqreceived_access		&& Assign method used to hold a reference to the RedirectReqReceived property.
		*m: redirectreqreceived_assign		&& Assign method used to hold a reference to the RedirectReqReceived property.
		*m: refreshaccesstoken		&& Introduced in version 9.5.0.59. Sends a refresh request to the token endpoint to obtain a new access token. After a successful refresh request, the AccessToken and RefreshToken properties will be updated with new values.
		*m: refreshaccesstokenasync		&& Introduced in version 9.5.0.59. Creates an asynchronous task to call the RefreshAccessToken method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: refreshtoken_access		&& Access method used to retrieve the Chilkat oAuth2 RefreshToken property.
		*m: refreshtoken_assign		&& Assign method used to hold a reference to the RefreshToken property.
		*m: resource_access		&& Access method used to retrieve the Chilkat oAuth2 Resource property.
		*m: resource_assign		&& Assign method used to hold a reference to the Resource property.
		*m: responsemode_access		&& Access method used to retrieve the Chilkat oAuth2 ResponseMode property.
		*m: responsemode_assign		&& Assign method used to hold a reference to the ResponseMode property.
		*m: responsetype_access		&& Access method used to retrieve the Chilkat oAuth2 ResponseType property.
		*m: responsetype_assign		&& Assign method used to hold a reference to the ResponseType property.
		*m: scope_access		&& Access method used to retrieve the Chilkat oAuth2 Scope property.
		*m: scope_assign		&& Assign method used to hold a reference to the Scope property.
		*m: setrefreshheader		&& Introduced in version 9.5.0.77. Provides for the ability to add HTTP request headers for the request sent by the RefreshAccesToken method.
		*m: setrefreshheaderasync		&& Introduced in version 9.5.0.77. Creates an asynchronous task to call the SetRefreshHeader method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sleepms		&& Introduced in version 9.5.0.59. Convenience method to force the calling thread to sleep for a number of milliseconds.
		*m: startauth		&& Introduced in version 9.5.0.59. Initiates the three-legged OAuth2 flow. The various properties, such as ClientId, ClientSecret, Scope, CodeChallenge, AuthorizationEndpoint, and TokenEndpoint, should be set prior to calling this method.
		*m: stateparam_access		&& Access method used to retrieve the Chilkat oAuth2 StateParam property.
		*m: stateparam_assign		&& Assign method used to hold a reference to the StateParam property.
		*m: tokenendpoint_access		&& Access method used to retrieve the Chilkat oAuth2 TokenEndpoint property.
		*m: tokenendpoint_assign		&& Assign method used to hold a reference to the TokenEndpoint property.
		*m: tokentype_access		&& Access method used to retrieve the Chilkat oAuth2 TokenType property.
		*m: tokentype_assign		&& Assign method used to hold a reference to the TokenType property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat OAuth2 UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to retrieve the Chilkat OAuth2 UncommonOptions property.
		*m: usebasicauth_access		&& Access method used to retrieve the Chilkat oAuth2 UseBasicAuth property.
		*m: usebasicauth_assign		&& Assign method used to hold a reference to the UseBasicAuth property.
		*m: useconnection		&& Introduced in version 9.5.0.59. Calling this method is optional, and is only required if a proxy (HTTP or SOCKS), an SSH tunnel, or if special connection related socket options need to be used.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat oAuth2 VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: accesstoken		&& Introduced in version 9.5.0.59. When the OAuth2 three-legged authorization has successfully completed in the background thread, this property contains the access_token.
		*p: accesstokenresponse		&& When the OAuth2 three-legged authorization has completed in the background thread, this property contains the response that contains the access_token, the optional refresh_token, and any other information included in the final response.
		*p: appcallbackurl		&& Introduced in version 9.5.0.73. Some OAuth2 services, such as QuickBooks, do not allow for "http://localhost:port" callback URLs. When this is the case, a desktop app cannot pop up a browser and expect to get the final redirect callback.
		*p: authflowstate		&& Introduced in version 9.5.0.59. Indicates the current progress of the OAuth2 three-legged authorization flow.
		*p: authorizationendpoint		&& Introduced in version 9.5.0.59. The URL used to obtain an authorization grant. For example, the Google APIs authorization endpoint is "https://accounts.google.com/o/oauth2/v2/auth".
		*p: clientid		&& Introduced in version 9.5.0.59. The "client_id" that identifies the application.
		*p: clientsecret		&& Introduced in version 9.5.0.59. The "client_secret" for the application. Application credentials (i.e. what identifies the application) consist of a client_id and client_secret. See the ClientId property for more information.
		*p: codechallenge		&& Introduced in version 9.5.0.59. Optional. Set this to 1 to send a code_challenge (as per RFC 7636) with the authorization request. The default value is 0.
		*p: codechallengemethod		&& Introduced in version 9.5.0.59. Optional. Only applies when the CodeChallenge property is set to 1. Possible values are "plain" or "S256". The default is "S256".
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: enablesecrets		&& Introduced in version 11.5.0. This property that automatic resolution of credentials from the operating system’s secure storage.
		*p: failureinfo		&& Introduced in version 9.5.0.59. If the OAuth2 three-legged authorization failed prior to completion (the AuthFlowState = 5), then information about the failure is contained in this property.
		*p: includenonce		&& Introduced in version 9.5.0.78. Optional. Set this to 1 to send a nonce with the authorization request. The default value is 0.
		*p: lastbinaryresult		&& The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& The length, in characters, of the string contained in the LastStringResult property.
		*p: listenport		&& Introduced in version 9.5.0.59. The port number to listen for the redirect URI request sent by the browser. If set to 0, then a random unused port is used. The default value of this property is 0.
		*p: listenportrangeend		&& Introduced in version 9.5.0.69. If set, then an unused port will be chosen in the range from the ListenPort property to this property. Some OAuth2 services, such as Google, require that callback URL's, including port numbers, be selected in advance.
		*p: listenportselected		&& Introduced in version 9.5.0.94. If a listen port range was specified by setting both the ListenPort and ListenPortRangeEnd properties, then the StartAuth method will select and listen at an unused port in the range.
		*p: localhost		&& Introduced in version 9.5.0.59. Defaults to "localhost". This should typically remain at the default value. It is the loopback domain or IP address used for the redirect_uri. For example, "http://localhost:2012/".
		*p: noncelength		&& Introduced in version 9.5.0.80. Defines the length of the nonce in bytes. The nonce is only included if the IncludeNonce property = 1. (The length of the nonce in characters will be twice the length in bytes, because the nonce is a hex string.)
		*p: redirectallowhtml		&& Introduced in version 9.5.0.59. This property contains the HTML returned to the browser when access is allowed by the end-user. The default value is HTML that contains a META refresh to https://www.chilkatsoft.com/oauth2_allowed.html.
		*p: redirectdenyhtml		&& The HTML returned to the browser when access is denied by the end-user. The default value is HTMl that contains a META refresh to https://www.chilkatsoft.com/oauth2_denied.html
		*p: redirectreqreceived		&& Introduced in version 9.5.0.92. Contains the HTTP redirect request received from the local web browser. This is used for debugging.
		*p: refreshtoken		&& Introduced in version 9.5.0.59. When the OAuth2 three-legged authorization has successfully completed in the background thread, this property contains the refresh_token, if present.
		*p: resource		&& Introduced in version 9.5.0.67. This is an optional setting that defines the "resource" query parameter. For example, to call the Microsoft Graph API, set this property value to "https://graph.microsoft.com/".
		*p: responsemode		&& Introduced in version 9.5.0.78. Can be set to "form_post" to include a "response_mode=form_post" in the authorization request. The default value is the empty string to omit the "response_mode" query param.
		*p: responsetype		&& Introduced in version 9.5.0.78. The default value is "code". Can be set to "id_token+code" for cases where "response_type=id_token+code" is required in the authorization request.
		*p: scope		&& Introduced in version 9.5.0.59. This is an optional setting that defines the scope of access. For example, Google API scopes are listed here: https://developers.google.com/identity/protocols/googlescopes
		*p: stateparam		&& Introduced in version 9.5.0.94. Allows the application to explicitly set the state parameter to a value. Typically this property should remain unset, and Chilkat will automatically generate a random state.
		*p: tokenendpoint		&& Introduced in version 9.5.0.59. The URL for exchanging an authorization grant for an access token. For example, the Google APIs token endpoint is "https://www.googleapis.com/oauth2/v4/token".
		*p: tokentype		&& Introduced in version 9.5.0.59. When the OAuth2 three-legged authorization has successfully completed in the background thread, this property contains the token_type, if present.
		*p: uncommonoptions		&& Introduced in version 9.5.0.85. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: usebasicauth		&& Introduced in version 9.5.0.73. The default value of this property is 0, which causes the client_id/client_secret ** to be sent as query params.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		accesstoken = 
		accesstokenresponse = 
		appcallbackurl = 
		authflowstate = 0
		authorizationendpoint = 
		cchilkatclass = OAuth2
		ceventhandlerclass = iBaseEventHandler
		clientid = 
		clientsecret = 
		codechallenge = 0
		codechallengemethod = S256
		debuglogfilepath = 
		enablesecrets = 0
		failureinfo = 
		iinstancepatch = 59
		includenonce = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		listenport = 0
		listenportrangeend = 0
		listenportselected = 0
		localhost = localhost
		Name = "oauth2"
		noncelength = 4
		redirectallowhtml = 
		redirectdenyhtml = 
		redirectreqreceived = 
		refreshtoken = 
		resource = 
		responsemode = 
		responsetype = code
		scope = 
		stateparam = 
		tokenendpoint = 
		tokentype = 
		uncommonoptions = 
		usebasicauth = 0
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE accesstokenresponse_access		&& Access method used to retrieve the Chilkat oAuth2 AccessTokenResponse property.
		*==============================================================================
		* Method:            AccessTokenResponse_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat oAuth2 AccessTokenResponse property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AccessTokenResponse
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		** 
		** When the OAuth2 three-legged authorization has completed in the background thread, 
		** this property contains the response that contains the access_token, 
		** the optional refresh_token, and any other information included in the final response. 
		** If the authorization was denied, then this contains the error response.
		** 
		** For example, a successful JSON response for a Google API looks like this:
		** 
		**  {
		**              "access_token": "ya29.Ci9ZA-Z0Q7vtnch8xxxxxxxxxxxxxxgDVOOV97-IBvTt958xxxxxx1sasw",
		**              "token_type": "Bearer",
		** 
		**             "expires_in": 3600,
		** 
		**             "refresh_token": "1/fYjEVR-3Oq9xxxxxxxxxxxxxxLzPtlNOeQ"
		** }
		** 
		** Note: Not all responses are JSON. A successful Facebook response is plain text and looks like this:
		** 
		** access_token=EAAZALuOC1wAwBAKH6FKnxOkjfEP ... UBZBhYD5hSVBETBx6AZD&expires=5134653
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 59
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE accesstokenresponse_assign		&& Assign method used to hold a reference to the AccessTokenResponse property.
		*==============================================================================
		* Method:            AccessTokenResponse_Assign
		* Purpose:           Assign method used to hold a reference to the AccessTokenResponse property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the AccessTokenResponse property.
		* Returns:           
		* Date Added:        06/08/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 59
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE accesstoken_access		&& Access method used to retrieve the Chilkat oAuth2 AccessToken property.
		*==============================================================================
		* Method:            AccessToken_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat oAuth2 AccessToken property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AccessToken
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		**
		** When the OAuth2 three-legged authorization has successfully completed in the background thread, 
		** this property contains the access_token.
		** 
		** For example, a successful Google API JSON response looks like this:
		** 
		**  {
		**              "access_token": "ya29.Ci9ZA-Z0Q7vtnch8xxxxxxxxxxxxxxgDVOOV97-IBvTt958xxxxxx1sasw",
		**              "token_type": "Bearer",
		** 
		**             "expires_in": 3600,
		** 
		**             "refresh_token": "1/fYjEVR-3Oq9xxxxxxxxxxxxxxLzPtlNOeQ"
		** }
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 59
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE accesstoken_assign		&& Assign method used to hold a reference to the AccessToken property.
