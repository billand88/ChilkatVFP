	PROCEDURE loadpem		&& Introduced in version 9.5.0.47. Loads a PFX from a PEM formatted string. The PEM can contain the private key, the certificate, and certificates in the chain of authentication up to the CA root.
		*==============================================================================
		* Method:            LoadPEM
		* Purpose:           Loads a PFX from a PEM formatted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMString -- The PEM formatted string.
		*                    tcPassword -- The PEM password
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.47
		**
		** Loads a PFX from a PEM formatted string. The PEM can contain the private key, 
		** the certificate, and certificates in the chain of authentication up to the CA root. For example:
		** 
		**    -----BEGIN RSA PRIVATE KEY-----
		**    ...
		**    ... the private key associated with the main certificate.
		**    ...
		**    -----END RSA PRIVATE KEY-----
		**    -----BEGIN CERTIFICATE-----
		**    ...
		**    ... the main certificate
		**    ...
		**    -----END CERTIFICATE-----
		**    -----BEGIN CERTIFICATE-----
		**    ...
		**    ... an intermediate CA certificate (if present)
		**    ...
		**    -----END CERTIFICATE-----
		**    -----BEGIN CERTIFICATE-----
		**    ...
		**    ... the root CA certificate
		**    ...
		**    -----END CERTIFICATE----- 
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPEMString AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 47
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadPEM(m.tcPEMString, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpfxbd		&& Introduced in version 11.0.0. Loads a PFX from the contents of bd. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadPfxBd
		* Purpose:           Loads a PFX from the contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData -- a Chilkat Binary Data object.
		*                    tcPassword -- The PFX password
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Loads a PFX from the contents of bd.
		** 
		** If the .pfx/.p12 uses different passwords for integrity and private keys, 
		** then the password argument may contain JSON to specify the passwords. 
		** See the LoadPfxFile method (below) for details.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown, ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL 
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatBinData
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadPfxBd(m.tqPFXData, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatBinData, m.loParkParameterBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpfxbytes		&& Introduced in version 9.5.0.40. Loads a PFX from in-memory bytes. If the .pfx/.p12 uses different passwords for integrity and private keys, then the password argument may contain JSON to specify the passwords.
		*==============================================================================
		* Method:            LoadPFXBytes
		* Purpose:           Loads a PFX from in-memory bytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPFXData -- the PFX binary data.
		*                    tcPassword -- The PFX password
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Loads a PFX from in-memory bytes.
		** 
		** If the .pfx/.p12 uses different passwords for integrity and private keys, 
		** then the password argument may contain JSON to specify the passwords. 
		** See the LoadPfxFile method (below) for details.
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqPFXData AS VarBinary, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadPFXBytes(m.tqPFXData, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpfxencoded		&& Introduced in version 9.5.0.40. Loads a PFX from encoded byte data.
		*==============================================================================
		* Method:            LoadPFXEncoded
		* Purpose:           Loads a PFX from encoded byte data. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedData -- the encoded byte data.
		*                    tcEncoding, the encoding of the encoded data.
		*                    tcPassword -- The PFX password
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Loads a PFX from encoded byte data. The encoding can by any encoding, such as "Base64", 
		** "modBase64", "Base32", "UU", "QP" (for quoted-printable), "URL" (for url-encoding), 
		** "Hex", "Q", "B", "url_oath", "url_rfc1738", "url_rfc2396", and "url_rfc3986".
		** 
		** If the .pfx/.p12 uses different passwords for integrity and private keys, 
		** then the encoding argument may contain JSON to specify the passwords. 
		** See the LoadPfxFile method (below) for details.
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		
		LPARAMETERS tcEncodedData AS Character, tcEncoding AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadPFXEncoded(m.tcEncodedData, m.tcEncoding, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpfxfile		&& Introduced in version 9.5.0.40. Loads a PFX from a file.
		*==============================================================================
		* Method:            LoadPFXFile
		* Purpose:           Loads a PFX from a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMString -- The PEM formatted string.
		*                    tcPassword -- The PEM password
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Loads a PFX from a file.
		** 
		** Starting in v9.5.0.75, a .pfx/.p12 file with different passwords 
		** for integrity and private keys can be loaded by passing 
		** the following JSON for the password.
		** 
		**       {
		**         "integrity": "password1",
		**         "privKeys": "password2",
		**       }
		** 
		** If it is desired to open the .pfx/.p12 without access to the private keys, 
		** then add "skipPrivateKeys" like this:
		** 
		**       {
		**         "integrity": "password1",
		**         "privKeys": "not used",
		**         "skipPrivateKeys": true
		**       }
		** 
		** Fix for version 87: When using passwords longer than 32 chars, 
		** PFX’s created by Microsoft and others would truncate passwords to a max length, 
		** whereas PFX’s created by Apple and others would not. Therefore, opening such a PFX 
		** requires the correct behavior (truncate or no-truncate).  
		** Chilkat will now automatically determine the correct behavior and open appropriately.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPEMString AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadPFXFile(m.tcPEMString, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE numcerts_access		&& Access method used to retrieve the Chilkat PFX NumCerts property.
		*==============================================================================
		* Method:            NumCerts_Access
		* Purpose:           Access method used to retrieve 
		*                    the NumCerts property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumCerts
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.40
		**
		** The number of certificates contained in the PFX.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 40
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

