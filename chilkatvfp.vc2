		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE gened25519key		&& Introduced in version 9.5.0.83. Generates an Ed25519 key. privKey is an output argument. The generated key is created in privKey. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GenEd25519Key
		* Purpose:           Generates an Ed25519 key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPrng, a Chilkat Pseudo Random Number Generator object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Generates an Ed25519 key. privKey is an output argument. 
		** The generated key is created in privKey.
		**
		** Enhancement for Version 83: Improved support for Ed25519 private keys.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatPrng AS CHILKAT_PRNG_COM_CALL, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EDDSA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrng AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrng AS CHILKAT_PRNG_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrng, m.loChilkatPrng, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey  
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrng = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrng)
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrng = m.loParkParameterPrng.GetObject()
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenEd25519Key(m.loChilkatPrng, ;
		        m.loChilkatPrivateKey) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrng = ;
		      m.loParkParameterPrng.SetObject(m.toChilkatPrng, m.loChilkatPrng)
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrng, m.loChilkatPrng, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EDDSA_COM_CALL)
		  toChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrng = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat EdDSA LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83 && 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

