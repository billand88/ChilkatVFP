	PROCEDURE aesencrypt		&& Encrypts the email body, all alternative bodies, all message sub-parts and attachments using 128-bit AES CBC encryption. Decrypting is achieved by calling AesDecrypt with the same password.
		*==============================================================================
		* Method:            AESEncrypt
		* Purpose:           Encrypts the email body, all alternative bodies, 
		*                    all message sub-parts and attachments using 128-bit AES CBC encryption.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword, the encryption password.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Encrypts the email body, all alternative bodies, 
		** all message sub-parts and attachments using 128-bit AES CBC encryption. 
		** Decrypting is achieved by calling AESEncrypt with the same password. 
		** The AesEncrypt/Decrypt methods use symmetric password-based AES encryption 
		** and greatly simplify sending and receiving encrypted emails 
		** because certificates and private keys are not used. 
		** However, the sending and receiving applications must both use Chilkat, 
		** and the password must be pre-known on both ends.
		**
		** Update for Version 72: Modification: Encrypting 0 bytes for block cipher algorithms 
		** with padding now results in one block of output, rather than 0 bytes.
		** (Decrypting the 16-byte block will return the original 0 bytes.) 
		** This only applies to block ciphers operating in modes such as ECB, CBC, etc. 
		** This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AESEncrypt(m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

