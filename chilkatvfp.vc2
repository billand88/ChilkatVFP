	PROCEDURE hashof		&& Introduced in version 9.5.0.75. Returns an encoded hash of a particular part of the certificate. The part may be one of the following: IssuerDN - IssuerPublicKey - SubjectDN -
		*==============================================================================
		* Method:            HashOf
		* Purpose:           Returns an encoded hash of a particular part of the certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPart, the certificate part to hash.
		*                    tcHashAlgorithm, the hash algorithm.
		*                    tcEncoding, the encoding of the algorithm.
		* Returns:           The certificate extension data
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.75
		**
		** Returns an encoded hash of a particular part of the certificate. 
		** The part may be one of the following:
		** 
		**   IssuerDN
		**   IssuerPublicKey
		**   SubjectDN
		**   SubjectPublicKey
		** 
		** The hashAlg is the name of the hash algorithm, such as "sha1", "sha256", 
		** "sha384", "sha512", "md5", etc. The encoding is the format to return, 
		** such as "hex", "base64", etc.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS tcPart AS Character, ;
		tcHashAlgorithm AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, lcEncodedHash AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedHash = []
		llImplemented = .F.
		liIntroducedInBuild = 75
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcEncodedHash = ;
		        m.loChilkatObject.HashOf(m.tcPart, m.tcHashAlgorithm, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedHash
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE haskeycontainer_access		&& Access method used to retrieve the Chilkat Cert HasKeyContainer property.
		*==============================================================================
		* Method:            HasKeyContainer_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert HasKeyContainer property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HasKeyContainer
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** (Relevant only when running on a Microsoft Windows operating system.) 
		** Indicates whether this certificate is linked to a key container. 
		** If 1 then the certificate is linked to a key container 
		** (usually containing a private key). If 0, then it is not.
		** 
		** When a certificate is linked to a key container, 
		** the following properties will provide information 
		** about the key container and private key: CspName, 
		** KeyContainerName, MachineKeyset, and Silent.
		**
		** Version 11.0.0: Property removed.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [LongBitReadOnly]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 0
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		
	ENDPROC

