	ENDPROC

	HIDDEN PROCEDURE compressionalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 CompressionAlgorithm property.
		*==============================================================================
		* Method:            CompressionAlgorithm_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 CompressionAlgorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CompressionAlgorithm
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Undocumented property!
		**
		** This property is decremented. The only possible value is "BZIP2". The compression
		** functionality in Crypt2 is legacy and existed long before the general
		** compression functionality that is currently offered in Chilkat.Compression. 
		** The Chilkat.Compression API should be used instead.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [String]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN []
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		  
	ENDPROC

	HIDDEN PROCEDURE compressionalgorithm_assign		&& Assign method used to hold a reference to the CompressionAlgorithm property.
		*==============================================================================
		* Method:            CompressionAlgorithm_Assign
		* Purpose:           Assign method used to hold a reference to the CompressionAlgorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CompressionAlgorithm property.
		* Returns:           
		* Date Added:        07/01/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    lcValidationMethod = []
		    lcMethodToCall = [String]
		
		    .CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

	PROCEDURE compressstring		&& Compresses a string and returns the compressed bytes. Prior to compressing, the string is converted to a byte representation such as utf-8, utf-16, etc. as determined by the Charset property.
		*==============================================================================
		* Method:            CompressString
		* Purpose:           Compresses a string and returns the compressed bytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcData -- the string data to compress. 
		* Returns:           The compressed binary data bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Compresses a string and returns the compressed bytes. 
		** Prior to compressing, the string is converted to a byte representation 
		** such as utf-8, utf-16, etc. as determined by the Charset property. 
		** Otherwise, this method is the same as the CompressBytes method.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tcData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqCompressedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqCompressedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqCompressedBytes = m.loChilkatObject.CompressString(m.tcData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqCompressedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

