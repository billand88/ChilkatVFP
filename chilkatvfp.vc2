		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEventLogValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE extractmetarefreshurl		&& Convenience method for extracting the META refresh URL from HTML.
		*==============================================================================
		* Method:            ExtractMetaRefreshURL
		* Purpose:           Convenience method for extracting the META refresh URL from HTML.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHTMLContent -- the HTML content to extract from.
		* Returns:           Character
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** Convenience method for extracting the META refresh URL from HTML. 
		** For example, if the htmlContent contains a META refresh tag, such as:
		**
		** <meta http-equiv="refresh" content="5;URL='http://example.com/'">
		** Then the return value of this method would be "http://example.com/".
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHTMLContent AS Character
		
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, lcURL AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcURL = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcURL = m.loChilkatObject.ExtractMetaRefreshURL(m.tcHTMLContent)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcURL
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE fetchfromcache_access		&& Access method used to retrieve the Chilkat HTTP FreshFromCache property.
		*==============================================================================
		* Method:            FetchFromCache_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP FetchFromCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FetchFromCache
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** Set to true if pages should be fetched from cache when possible. 
		** Only HTTP GET requests are cached. HTTP responses that include 
		** Set-Cookie headers are not cached. 
		** A page is fetched from the disk cache if it is present 
		** and it is "fresh" according to the FreshnessAlgorithm property. 
		** If a page exists in cache but is not fresh, 
		** the HTTP component will issue a revalidate request 
		** and update the cache appropriately according to the response.
		**
		** Fixed for version 70: Fixed problem with using the caching feature. 
		** If the http.AllowGzip property was set to true, and a Gzip response was cached, 
		** then a subsequent cache-hit would not return the ungzipped response 
		** (as would a normal non-cache-hit response).
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE fetchfromcache_assign		&& Assign method used to hold a reference to the FreshFromCache property.
		*==============================================================================
		* Method:            FetchFromCache_Assign
		* Purpose:           Assign method used to hold a reference to the FetchFromCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the FetchFromCache property.
		* Returns:           
		* Date Added:        01/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE finalredirecturl_access		&& Access method used to retrieve the Chilkat HTTP FinalRedirectURL property.
		*==============================================================================
		* Method:            FinalRedirectURL_Access
		* Purpose:           Access method used to retrieve 
		*                    the FinalRedirectURL property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FinalRedirectURL
		* Date Added:        01/27/2022
		*==============================================================================
		
		** 
		** If an HTTP GET was redirected (as indicated by the WasRedirected property), 
		** this property will contain the final redirect URL, assuming the FollowRedirects property is 1.
		**
		** Note: Starting in v9.5.0.49, this property will contain the redirect URL 
		** for 301/302 responses even if FollowRedirects is not set to 1.
		**
		** Fixed for Version 47: This property was not working correctly.
		**
		** Fixed for Version 49: Fixed this property.
		**
		** Fixed for Version 82: The QuickGetObj and QuickGet methods did not properly 
		** set the property when redirects are automatically followed. 
		**
		** Fixed for Version 87: Http.FollowRedirects is False, certain method calls such as PostJson 
		** would fail to set the Http.FinalRedirectUrl property 
		** when the response status code = 301,302,303,306,307. 
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE finalredirecturl_assign		&& Assign method used to hold a reference to the FinalRedirect property.
