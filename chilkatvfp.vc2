	ENDPROC

	PROCEDURE closesmtpconnection		&& The mailman object automatically opens an SMTP connection (if necessary) whenever an email-sending method is called. The connection is kept open until explicitly closed by this method. Calling this method is entirely optional.
		*==============================================================================
		* Method:            CloseSMTPConnection
		* Purpose:           The mailman object automatically opens an SMTP connection 
		*                    (if necessary) whenever an email-sending method is called. 
		*                    The connection is kept open until explicitly closed by this method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** The mailman object automatically opens an SMTP connection (if necessary) 
		** whenever an email-sending method is called. 
		** The connection is kept open until explicitly closed by this method. 
		** Calling this method is entirely optional. 
		** The SMTP connection is also automatically closed when the mailman object is destructed. 
		** Thus, if an application calls SendEmail 10 times to send 10 emails, 
		** the 1st call will open the SMTP connection, 
		** while the subsequent 9 will send over the existing connection 
		** (unless a property such as username, login, hostname, etc. is changed, 
		** which would force the connection to become closed and re-established 
		** with the next mail-sending method call).
		**
		** Note: This method sends a QUIT command to the SMTP server prior to closing the connection.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CloseSMTPConnection() ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE closesmtpconnectionasync		&& Creates an asynchronous task to call the CloseSmtpConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            CloseSMTPConnectionASync
		* Purpose:           Creates an asynchronous task to call the CloseSmtpConnection 
		*                    method with the arguments provided.
		* Author:            Bill Anderson
