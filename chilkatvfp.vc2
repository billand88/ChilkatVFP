	ENDPROC

	PROCEDURE setdecryptcert2		&& Used to explicitly specify the certificate and associated private key to be used for decrypting S/MIME (PKCS7) email. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetDecryptCert2
		* Purpose:           Used to explicitly specify the certificate and associated  
		*                    private key to be used for decrypting S/MIME (PKCS7) email. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Used to explicitly specify the certificate and associated private key 
		** to be used for decrypting S/MIME (PKCS7) email.
		** 
		** Fixed for Version 59: When a cert doesn’t have the Issuer CN, 
		** the encrypted message could not be decrypted using Chilkat library, 
		** even though the cert does have subject key id.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Fixed for Version 89: Fixed a problem with decrypting messages 
		** that used AES-GCM with a certificate having a non-exportable private key.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetDecryptCert2(m.loChilkatCert, ;
		      m.loChilkatPrivateKey) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setflag		&& Sets a flag for a single message on the IMAP server. If value = 1, the flag is turned on, if value = 0, the flag is turned off. Standard system flags such as "\Deleted", "\Seen", "\Answered", "\Flagged", "\Draft", and "\Answered" may be set.
		*==============================================================================
		* Method:            SetFlag
		* Purpose:           Sets a flag for a single message on the IMAP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageID -- the message ID of the copied message.
		*                    tuUID -- whether or not the message ID is a UID.
		*                    tcFlagName -- the flag name to set the value against.
		*                    tuValue, whether or not it is set to on or off.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Sets a flag for a single message on the IMAP server. 
		** If value = 1, the flag is turned on, if value = 0, the flag is turned off. 
		** Standard system flags such as "\Deleted", "\Seen", "\Answered", "\Flagged", 
		** "\Draft", and "\Answered" may be set. Custom flags such as "NonJunk", "$label1", 
		** "$MailFlagBit1", etc. may also be set.
		**
		** If bUid is 1, then msgId represents a UID. 
		** If bUid is 0, then msgId represents a sequence number.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiMessageID AS Integer, tuUID AS Unknown, ;
		tcFlagName AS Character, tuValue AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liValue AS Integer
		
		STORE 0 TO m.liUID, m.liValue, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUID = .LogicalToBit(m.tuUID)
		    liValue = .LogicalToBit(m.tuValue)
		
		    TRY
		 
		      STORE m.loChilkatObject.SetFlag(m.tiMessageID, ;
		      m.liUID, m.tcFlagName, m.liValue) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setflagasync		&& Creates an asynchronous task to call the SetFlag method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            SetFlagAsync
