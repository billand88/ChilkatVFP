	PROCEDURE findissuer		&& Finds a matching issuer certificate.
		*==============================================================================
		* Method:            FindIssuer
		* Purpose:           Finds a matching issuer certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           loChilkatCert, a Chilkat Certificate object.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Digitally signed and/or encrypted emails are automatically "unwrapped" 
		** when received from a POP3 or IMAP server, 
		** or when loaded from any source such as a MIME string, 
		** in-memory byte data, or a .eml file. 
		** The results of the signature verification / decryption are stored 
		** in the properties such as ReceivedSigned, ReceivedEncrypted, SignaturesValid, etc. 
		** The signing certificate can be obtained via the GetSigningCert function. 
		** If the signature contained more certificates in the chain of authentication, 
		** this method provides a means to access them.
		**
		** During signature verification, the email object collects the certs 
		** found in the signature and holds onto them internally. 
		** To get the issuing certificate of the signing certificate, 
		** call this method passing the cert returned by GetSigningCert. 
		** If the issuing cert is available, it is returned. 
		** Otherwise Nothing is returned. 
		** If the cert passed in is the root (i.e. a self-signed certificate), 
		** then the cert object returned is a copy of the cert passed in.
		**
		** To traverse the chain to the root, one would write a loop that 
		** on first iteration passes the cert returned by GetSignedByCert (not GetSignerCert), 
		** and then on each subsequent iteration passes the cert from the previous iteration. 
		** The loop would exit when a cert is returned that has the same SubjectDN and SerialNumber 
		** as what was passed in (or when FindIssuer returns Nothing).
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, loChilkatIssuer AS CHILKAT_CERT_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatIssuer, m.loParkParameterCert, m.loChilkatCert 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      loChilkatIssuer = m.loChilkatObject.FindIssuer(m.loChilkatCert)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.loChilkatIssuer
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatIssuer = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

