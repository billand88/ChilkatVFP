	HIDDEN PROCEDURE pop3stlsifpossible_access		&& Access method used to retrieve a reference to the POP3SSTLSIfPossible property.
		*==============================================================================
		* Method:            POP3StlsIfPossible_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan POP3StlsIfPossible property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.POP3StlsIfPossible
		* Date Added:        10/12/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.92
		**
		** If 1, then an unencrypted connection (typically on port 110) 
		** is automatically converted to a secure TLS connection via the STLS command 
		** if the mail server supports the STLS command. If the mail server does not support STLS, 
		** then the connection will remain unencrypted.
		**
		** The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 92
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE pop3stlsifpossible_assign		&& Assign method used to hold a reference to the POP3SSTLSIfPossible property.
		*==============================================================================
		* Method:            POP3StlsIfPossible_Assign
		* Purpose:           Assign method used to hold a reference to the POP3StlsIfPossible property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiPOP3StlsIfPossible, integer/logical value used 
		*                    to hold a reference to the POP3StlsIfPossible property.
		* Returns:           
		* Date Added:        10/12/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 92
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE pop3stls_access		&& Access method used to retrieve a reference to the POP3SSTLS property.
		*==============================================================================
		* Method:            POP3STLS_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan POP3STLS property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.POP3STLS
		* Date Added:        01/12/2022
		*==============================================================================
		
		**
		** If 1, then an unencrypted connection (typically on port 110) 
		** is automatically converted to a secure TLS connection via the 
		** STLS command (see RFC 2595) when connecting. 
		** This should only be used with POP3 servers that support the STLS capability. 
		** If this property is set to 1, then the PopSsl property should be set to 0. 
		** (The PopSsl property controls whether the connection is SSL/TLS 
		** from the beginning. Setting the Pop3Stls property = 1 indicates that 
		** the POP3 client will initially connect unencrypted and then convert to TLS.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE pop3stls_assign		&& Assign method used to hold a reference to the POP3SSTLS property.
		*==============================================================================
		* Method:            POP3STLS_Assign
		* Purpose:           Assign method used to hold a reference to the POP3STLS property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the POP3STLS property.
		* Returns:           
		* Date Added:        01/13/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character, llValue AS Logical
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		llValue = .F.
		
		WITH THIS
		
		  .CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  llValue = .BitToLogical(m.tuValue)
		
		  ** Value turned on test
		  IF m.llValue
		
		    .POPSSL = 0
		
		  ENDIF m.llValue
		  ** End value turned on test
		
		ENDWITH
		RETURN
	ENDPROC

