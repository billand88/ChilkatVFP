	PROCEDURE Destroy
		*==============================================================================
		* Method:            Destroy
		* Purpose:           Occurs when an object is released.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        01/04/2023
		*==============================================================================
		
		LOCAL liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of iChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		
		WITH THIS
		
		  loVersioning = .oVersioning
		
		  ** Have versioning object test
		  IF VARTYPE(m.loVersioning) == T_OBJECT ;
		  AND (NOT ISNULL(m.loVersioning))
		
		    liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		    ** Version less than 67 test
		    IF liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 67)
		
		      .Clear()
		
		    ELSE
		
		      .SecureClear()
		   
		    ENDIF liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 67)
		    ** End version less than 67 test
		
		*!*    ELSE
		
		*!*      .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		  AND (NOT ISNULL(m.loVersioning))
		  ** End have versioning object test
		
		ENDWITH
		
		loVersioning = NULL
		
		RETURN DODEFAULT()
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

