	PROCEDURE bgresponseobject		&& Undocumented method! If a backgrounded method returns an Http response object, it may be retrieved by calling this method. The caller is responsible for deleting the object returned by this method.
		*==============================================================================
		* Method:            BgResponseObject
		* Purpose:           Undocumented method! Provides information about what transpired 
		*                    in the last method called on this object instance.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat JSON Object, or NULL
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented method!
		**
		** If a backgrounded method returns an Http response object, 
		** it may be retrieved by calling this method. The caller is responsible 
		** for deleting the object returned by this method.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loHttpResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loHttpResponse
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        loHttpResponse = m.loChilkatObject.BgResponseObject()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loHttpResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loHttpResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

