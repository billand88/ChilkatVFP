		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE pindeauthenticate		&& Introduced in version 9.5.0.87. Reverses a previous PIN authentication without resetting the card. The pinId can be "user", "admin", or "3" through "7". (It is typically "user".) Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            PINDeauthenticate
		* Purpose:           Reverses a previous PIN authentication without resetting the card.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPINID, the PIN ID to authenticate.
		*                    tcPIN, the alphanumeric PIN.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Reverses a previous PIN authentication without resetting the card. 
		** The pinId can be "user", "admin", or "3" through "7". (It is typically "user".)
		**
		** Returns 1 for success, 0 for failure.
		
		LPARAMETERS tcPINID AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
