		*                    used to hold a reference to the TextFlag property.
		* Returns:           
		* Date Added:        04/29/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat ZIP UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the UncommonOptions property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.84
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string, and should typically remain empty.
		** 
		** Currently, the only possible option is "ForceZip64".
		** 
		** "ForceZip64" - Force the zip to be written with the Zip64 file format, 
		** even if not necessary.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 84
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold
		*                    the UncommonOptions of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        04/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 84
		
		lcValidationMethod = [UncommonOptions_ZIP]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE unzip		&& Unzips and returns the number of files unzipped, or -1 if a failure occurs. Subdirectories are automatically created during the unzipping process.
		*==============================================================================
		* Method:            UnZip
		* Purpose:           Unzips and returns the number of files unzipped, 
		*                    or -1 if a failure occurs.
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryPath -- the path to unzip the file.
		* Returns:           The number of files extracted.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Unzips and returns the number of files unzipped, or -1 if a failure occurs. 
		** Subdirectories are automatically created during the unzipping process.
		**
		
		LPARAMETERS tcDirectoryPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, ;
		loException AS Exception, liFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFiles = m.loChilkatObject.UnZip(m.tcDirectoryPath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE unzipasync		&& Creates an asynchronous task to call the Unzip method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            UnZipAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    UnZip method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryPath -- the directory path.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the UnZip method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcDirectoryPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liRecursive AS Integer, loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE 0 TO m.liIntroducedInBuild, m.liRecursive 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.UnZipAsync(m.tcDirectoryPath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE unzipinto		&& Unzips and returns the number of files unzipped, or -1 if a failure occurs. All files in the Zip are unzipped into the specfied dirPath regardless of the directory path information contained in the Zip.
		*==============================================================================
		* Method:            UnZipInto
		* Purpose:           Unzips and returns the number of files unzipped, 
		*                    or -1 if a failure occurs.
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryPath -- the path to UnZipInto the file.
		* Returns:           The number of files extracted.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Unzips and returns the number of files unzipped, or -1 if a failure occurs. 
		** All files in the Zip are unzipped into the specfied dirPath 
		** regardless of the directory path information contained in the Zip. 
		** This has the effect of collapsing all files into a single directory. 
		** If several files in the Zip have the same name, 
		** the files unzipped last will overwrite the files already unzipped.
		**
		
		LPARAMETERS tcDirectoryPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, ;
		loException AS Exception, liFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFiles = m.loChilkatObject.UnZipInto(m.tcDirectoryPath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

