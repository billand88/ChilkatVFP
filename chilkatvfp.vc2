	PROCEDURE loadevent		&& Introduced in version 9.5.0.58. Loads the multi-line event text into this object.
		*==============================================================================
		* Method:            LoadEvent
		* Purpose:           Loads the multi-line event text into this object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEventText -- the event text to download
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Loads the multi-line event text into this object. 
		** For example, the eventText for a Firebase event might look like this:
		**
		**   event: put
		**   data: {"path": "/c", "data": {"foo": true, "bar": false}}
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEventText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SERVERSENTEVENT_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadEvent(m.tcEventText) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SERVERSENTEVENT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE retry_access		&& Access method used to retrieve the Chilkat ServerSentEvent Retry property.
		*==============================================================================
		* Method:            Retry_Access
		* Purpose:           Access method used to retrieve 
		*                    the Retry property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Retry
		* Date Added:        07/08/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.58
		**
		** The integer value of the "retry" field, if present. Otherwise 0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE retry_assign		&& Assign method used to hold a reference to the Retry property.
		*==============================================================================
		* Method:            Retry_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the Retry property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the Retry property.
		* Returns:           
		* Date Added:        07/08/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS sftp AS ibasechilkat OF "chilkatvfp.vcx" 		&& SFTP implementation for file transfer and remote file management over SSH.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat SFTP AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: accumulatebuffer_access		&& Access method used to retrieve the Chilkat SFTP AccumulateBuffer property.
		*m: accumulatebuffer_assign		&& Assign method used to hold a reference to the AccumulateBuffer property.
		*m: accumulatebytes		&& Downloads bytes from an open file and appends them to the AccumulateBuffer. The handle is a file handle returned by the OpenFile method. The maxBytes is the maximum number of bytes to read.
		*m: accumulatebytesasync		&& Creates an asynchronous task to call the AccumulateBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: add64		&& Convenience method for 64-bit addition. Allows for two 64-bit integers to be passed as decimal strings and returns the sum in a decimal sting. Returns Nothing on failure
		*m: authenticatepk		&& Authenticates with the SSH server using public-key authentication. The corresponding public key must have been installed on the SSH server for the username. Authentication will succeed if the matching privateKey is provided.
		*m: authenticatepkasync		&& Creates an asynchronous task to call the AuthenticatePk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: authenticatepw		&& Authenticates with the SSH server using a login and password. An SFTP session always begins by first calling Connect to connect to the SSH server, then calling either AuthenticatePw or AuthenticatePk to login, and finally calling InitializeSftp.
		*m: authenticatepwasync		&& Creates an asynchronous task to call the AuthenticatePw method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: authenticatepwpk		&& Authentication for SSH servers that require both a password and private key. (Most SSH servers are configured to require one or the other, but not both.)
		*m: authenticatepwpkasync		&& Creates an asynchronous task to call the AuthenticatePwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: authenticatesecpw		&& Introduced in version 9.5.0.71. The same as AuthenticatePw, but the login and password are passed in secure string objects. Returns 1 for success, 0 for failure.
		*m: authenticatesecpwasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the AuthenticateSecPw method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authenticatesecpwpk		&& Introduced in version 9.5.0.71. The same as AuthenticatePwPk, but the login and password are passed in secure string objects. Returns 1 for success, 0 for failure.
		*m: authenticatesecpwpkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the AuthenticateSecPwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authfailreason_access		&& Access method used to retrieve the Chilkat SFTP AuthFailReason property.
		*m: authfailreason_assign		&& Assign method used to hold a reference to the AuthFailReason property.
		*m: bandwidththrottledown_access		&& Access method used to retrieve the Chilkat SFTP BandwidthThrottleDown property.
		*m: bandwidththrottledown_assign		&& Assign method used to hold a reference to the BandwidthThrottleDown property.
		*m: bandwidththrottleup_access		&& Access method used to retrieve the Chilkat SFTP BandwidthThrottleUp property.
		*m: bandwidththrottleup_assign		&& Assign method used to hold a reference to the BandwidthThrottleUp property.
		*m: clearaccumulatebuffer		&& Clears the contents of the AccumulateBuffer property.
		*m: clearcache		&& Clears the internal file attribute cache. (Please refer to the EnableCache property for more information about the file attribute cache.)
		*m: clearsessionlog		&& Clears the contents of the SessionLog property.
		*m: clientidentifier_access		&& Access method used to retrieve the Chilkat SFTP ClientIdentifier property.
		*m: clientidentifier_assign		&& Assign method used to hold a reference to the ClientIdentifier property.
		*m: clientipaddress_access		&& Access method used to retrieve the Chilkat SFTP ClientIPAddress property.
		*m: clientipaddress_assign		&& Assign method used to hold a reference to the ClientIPAddress property.
		*m: closehandle		&& Closes a file on the SSH/SFTP server. handle is a file handle returned from a previous call to OpenFile or OpenDir. Returns 1 for success, 0 for failure.
		*m: closehandleasync		&& Creates an asynchronous task to call the CloseHandle method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: connect		&& Connects to an SSH/SFTP server. The domainName may be a domain name or an IP address (example: 192.168.1.10). Both IPv4 and IPv6 addresses are supported. The port is typically 22, which is the standard port for SSH servers.
		*m: connectasync		&& Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: connectthroughssh		&& Introduced in version 9.5.0.55. Connects to an SSH/SFTP server through an existing SSH connection. The sshConn is an existing connected and authenticated SSH object.
		*m: connectthroughsshasync		&& Introduced in version 9.5.0.55. Creates an asynchronous task to call the ConnectThroughSsh method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: connecttimeoutms_access		&& Access method used to retrieve the Chilkat SFTP ConnectTimeoutMs property.
		*m: connecttimeoutms_assign		&& Assign method used to hold a reference to the ConnectTimeoutMs property.
		*m: continuekeyboardauth		&& Introduced in version 9.5.0.88. Continues keyboard-interactive authentication with the SSH server. The response is typically the password.
		*m: continuekeyboardauthasync		&& Introduced in version 9.5.0.88. Creates an asynchronous task to call the ContinueKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: copyfileattr		&& Sets the date/time and other attributes of a remote file to be equal to that of a local file.
		*m: copyfileattrasync		&& Creates an asynchronous task to call the CopyFileAttr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: createdir		&& Creates a directory on the SFTP server. Returns 1 for success, 0 for failure.
		*m: createdirasync		&& Creates an asynchronous task to call the CreateDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SFTP DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: disconnect		&& Disconnects from the SSH server.
		*m: disconnectcode_access		&& Access method used to retrieve the Chilkat SFTP DisconnectCode property.
		*m: disconnectcode_assign		&& Assign method used to hold a reference to the DisconnectCode property.
		*m: disconnectreason_access		&& Access method used to retrieve the Chilkat SFTP DisconnectReason property.
		*m: disconnectreason_assign		&& Assign method used to hold a reference to the DisconnectReason property.
		*m: downloadbd		&& Introduced in version 9.5.0.62. Downloads the contents of a remote file to a BinData object. (Appends to the BinData.) Returns 1 for success, 0 for failure.
		*m: downloadbdasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the DownloadBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: downloadfile		&& Downloads a file from the SSH server to the local filesystem. There are no limitations on file size and the data is streamed from SSH server to the local file. handle is a file handle returned by a previous call to OpenFile.
		*m: downloadfileasync		&& Creates an asynchronous task to call the DownloadFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: downloadfilebyname		&& Simplified method for downloading files. The last-modified date/time is only preserved when the PreserveDate property is set to 1. (The default value of PreserveDate is 0.)
		*m: downloadfilebynameasync		&& Creates an asynchronous task to call the DownloadFileByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: downloadsb		&& Introduced in version 9.5.0.62. Downloads the contents of a remote file to a StringBuilder object. (Appends to the StringBuilder.) Returns 1 for success, 0 for failure.
		*m: downloadsbasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the DownloadSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: enablecache_access		&& Access method used to retrieve the Chilkat SFTP EnableCache property.
		*m: enablecache_assign		&& Assign method used to hold a reference to the EnableCache property.
		*m: enablecompression_access		&& Access method used to retrieve the Chilkat SFTP EnableCompression property.
		*m: enablecompression_assign		&& Assign method used to hold a reference to the EnableCompression property.
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat SFTP EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: eof		&& Returns 1 if the last read operation for a handle reached the end of file. Otherwise returns 0. If an invalid handle is passed, a value of 1 is returned.
		*m: fileexists		&& Introduced in version 9.5.0.67. Returns a value to indicate whether the remote file exists or not. remotePath is the path of the remote file. If followLinks is 1, then symbolic links will be followed on the server.
		*m: fileexistsasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the FileExists method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: filenamecharset_access		&& Access method used to retrieve the Chilkat SFTP FileNameCharset property.
		*m: filenamecharset_assign		&& Assign method used to hold a reference to the FileNameCharset property.
		*m: forcecipher_access		&& Access method used to retrieve the Chilkat SFTP ForceCipher property.
		*m: forcecipher_assign		&& Assign method used to hold a reference to the ForceCipher property.
		*m: forcev3_access		&& Access method used to retrieve the Chilkat SFTP ForceV3 property.
		*m: forcev3_assign		&& Assign method used to hold a reference to the ForceV3 property.
		*m: fsync		&& Introduced in version 9.5.0.71. Causes the SFTP server to do an fsync on the open file. Specifically, this is directing the SFTP server to call fsync (https://linux.die.net/man/2/fsync) on the open file.
		*m: fsyncasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the Fsync method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getfilecreatedt		&& Returns the create date/time for a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*m: getfilecreatedtasync		&& Creates an asynchronous task to call the GetFileCreateDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfilecreatetime		&& Undocumented method! See GetFileCreateTimeStr method. It is assumed that this method returns the value in a DateTime format.
		*m: getfilecreatetimestr		&& The same as GetFileCreateTime, except the date/time is returned as an RFC822 formatted string. Returns Nothing on failure
		*m: getfilecreatetimestrasync		&& Creates an asynchronous task to call the GetFileCreateTimeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfilegroup		&& Returns the group of a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*m: getfilegroupasync		&& Creates an asynchronous task to call the GetFileGroup method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfilelastaccess		&& Undocumented function! See GetFileLastAccessDt and GetFileLastAccessStr methods. Apparently returns a VFP datetime value representing the last access date of a file.
		*m: getfilelastaccessdt		&& Returns the last-access date/time for a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*m: getfilelastaccessdtasync		&& Creates an asynchronous task to call the GetFileLastAccessDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread
		*m: getfilelastaccessstr		&& The same as GetFileLastAccess, except the date/time is returned as an RFC822 formatted string. Returns Nothing on failure
		*m: getfilelastaccessstrasync		&& Creates an asynchronous task to call the GetFileLastAccessStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfilelastmodified		&& Undocumented function! See GetFileLastModifiedDt and GetFileLastModifiedStr methods. Apparently returns a VFP datetime value representing the last access date of a file.
		*m: getfilelastmodifieddt		&& Returns the last-modified date/time for a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*m: getfilelastmodifieddtasync		&& Creates an asynchronous task to call the GetFileLastModifiedDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfilelastmodifiedstr		&& The same as GetFileLastModified, except the date/time is returned as an RFC822 formatted string. Returns Nothing on failure
		*m: getfilelastmodifiedstrasync		&& Creates an asynchronous task to call the GetFileLastAccessStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfileowner		&& Returns the owner of a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*m: getfileownerasync		&& Creates an asynchronous task to call the GetFileOwner method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfilepermissions		&& Returns the access permisssions flags of a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*m: getfilepermissionsasync		&& Creates an asynchronous task to call the GetFilePermissions method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getfilesize32		&& Returns the size in bytes of a file on the SSH server. If the file size exceeds what can be represented in 32-bits, a value of -1 is returned. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile.
		*m: getfilesizestr		&& Returns the size in bytes (in decimal string form) of a file on the SSH server. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile.
		*m: gethostkeyfp		&& Introduced in version 9.5.0.92. Returns the host key fingerprint of the server, which is automatically set after connecting to an SSH/SFTP server.
		*m: getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData.
		*m: getsyncedfiles		&& Introduced in version 10.0.0. Appends to strTab the paths of the files uploaded or downloaded in the last call to SyncTreeUpload or SyncTreeDownload.
		*m: hardlink		&& Introduced in version 9.5.0.71. Creates a hard link on the server using the hardlink@openssh.com extension. This only works for SFTP servers that support the hardlink@openssh.com extension.
		*m: hardlinkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the HardLink method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat SFTP HeartBeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: hostkeyalg_access		&& Access method used to retrieve the Chilkat SFTP HostKeyAlg property.
		*m: hostkeyalg_assign		&& Assign method used to hold a reference to the HostKeyAlg property.
		*m: hostkeyfingerprint_access		&& Access method used to retrieve the Chilkat SFTP HostKeyFingerprint property.
		*m: hostkeyfingerprint_assign		&& Assign method used to hold a reference to the HostKeyFingerprint property.
		*m: httpproxyauthmethod_access		&& Access method used to retrieve the Chilkat SFTP HTTPProxyAuthMethod property.
		*m: httpproxyauthmethod_assign		&& Assign method used to hold a reference to the HTTPProxyAuthMethod property.
		*m: httpproxydomain_access		&& Access method used to retrieve the Chilkat SFTP HTTPProxyDomain property.
		*m: httpproxydomain_assign		&& Assign method used to hold a reference to the HTTPProxyDomain property.
		*m: httpproxyhostname_access		&& Access method used to retrieve the Chilkat SFTP HTTPProxyHostName property.
		*m: httpproxyhostname_assign		&& Assign method used to hold a reference to the HTTPProxyHostName property.
		*m: httpproxypassword_access		&& Access method used to retrieve the Chilkat SFTP HTTPProxyPassword property.
		*m: httpproxypassword_assign		&& Assign method used to hold a reference to the HTTPProxyPassword property.
		*m: httpproxyport_access		&& Access method used to retrieve the Chilkat SFTP HTTPProxyPort property.
		*m: httpproxyport_assign		&& Assign method used to hold a reference to the HTTPProxyPort property.
		*m: httpproxyusername_access		&& Access method used to retrieve the Chilkat SFTP HTTPUserName property.
		*m: httpproxyusername_assign		&& Assign method used to hold a reference to the HTTPProxyUserName property.
		*m: idletimeoutms_access		&& Access method used to retrieve the Chilkat SFTP IdleTimeout property.
		*m: idletimeoutms_assign		&& Assign method used to hold a reference to the IdleTimeout property.
		*m: includedotdirs_access		&& Access method used to retrieve the Chilkat SFTP IncludeDotDirs property.
		*m: includedotdirs_assign		&& Assign method used to hold a reference to the IncludeDotDirs property.
		*m: initializefailcode_access		&& Access method used to retrieve the Chilkat SFTP InitializeFailCode property.
		*m: initializefailcode_assign		&& Assign method used to hold a reference to the InitializeFailCode property.
		*m: initializefailreason_access		&& Access method used to retrieve the Chilkat SFTP InitializeFailReason property.
		*m: initializefailreason_assign		&& Assign method used to hold a reference to the InitializeFailReason property.
		*m: initializesftp		&& Intializes the SFTP subsystem. This should be called after connecting and authenticating.
		*m: initializesftpasync		&& Creates an asynchronous task to call the InitializeSftp method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: isconnected_access		&& Access method used to retrieve the Chilkat SFTP IsConnected property.
		*m: isconnected_assign		&& Assign method used to hold a reference to the IsConnected property.
		*m: keepsessionlog_access		&& Access method used to retrieve the Chilkat SFTP KeepSessionLog property.
		*m: keepsessionlog_assign		&& Assign method used to hold a reference to the KeepSessionLog property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SFTP LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat SFTP LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat SFTP LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat SFTP LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastjsondata		&& Introduced in version 9.5.0.79. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData. Returns Nothing on failure.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SFTP LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastreadfailed		&& Returns 1 if the last read on the specified handle failed. Otherwise returns 0.
		*m: lastreadnumbytes		&& Returns the number of bytes received by the last read on a specified channel.
		*m: laststatuscode_access		&& Access method used to retrieve the Chilkat SFTP LastStatusCode property.
		*m: laststatuscode_assign		&& Assign method used to hold a reference to the LastStatusCode property.
		*m: laststatusmessage_access		&& Access method used to retrieve the Chilkat SFTP LastStatusMessage property.
		*m: laststatusmessage_assign		&& Assign method used to hold a reference to the LastStatusMessage property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SFTP LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SFTP LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: maxpacketsize_access		&& Access method used to retrieve the Chilkat SFTP MaxPacketSize property.
		*m: maxpacketsize_assign		&& Assign method used to hold a reference to the MaxPacketSize property.
		*m: opendir		&& Opens a directory for reading. To get a directory listing, first open the directory by calling this method, then call ReadDir to read the directory, and finally call CloseHandle to close the directory.
		*m: opendirasync		&& Creates an asynchronous task to call the OpenDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.). Note: Async method event callbacks happen in the background thread.
		*m: openfile		&& Opens or creates a file on the remote system. Returns a handle which may be passed to methods for reading and/or writing the file. The remotePath is the remote file path (the path to the file on the server).
		*m: openfileasync		&& Creates an asynchronous task to call the OpenFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.). Note: Async method event callbacks happen in the background thread.
		*m: passwordchangerequested_access		&& Access method used to retrieve the Chilkat SFTP PasswordChangeRequested property.
		*m: passwordchangerequested_assign		&& Assign method used to hold a reference to the PasswordChangeRequested property.
		*m: percentdonescale_access		&& Access method used to retrieve the Chilkat SFTP PercentDoneScale property.
		*m: percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*m: preferipv6_access		&& Access method used to retrieve the Chilkat SFTP PreferIPV6 property.
		*m: preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*m: preservedate_access		&& Access method used to retrieve the Chilkat SFTP PreserveDate property.
		*m: preservedate_assign		&& Assign method used to hold a reference to the PreserveDate property.
		*m: protocolversion_access		&& Access method used to retrieve the Chilkat SFTP ProtocolVersion property.
		*m: protocolversion_assign		&& Assign method used to hold a reference to the ProtocolVersion property.
		*m: readdir		&& Reads the contents of a directory and returns the directory listing (as an object). The handle returned by OpenDir should be passed to this method. Returns Nothing on failure
		*m: readdirasync		&& Creates an asynchronous task to call the ReadDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.). Note: Async method event callbacks happen in the background thread.
		*m: readdirlisting		&& Introduced in version 11.0.0. Reads the contents of a directory and returns the directory listing in dirObj. The handle returned by OpenDir should be passed to this method. Returns 1 for success, 0 for failure.
		*m: readdirlistingasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the ReadDirListing method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: readdirmustmatch_access		&& Access method used to retrieve the Chilkat SFTP ReadDirMustMatch property.
		*m: readdirmustmatch_assign		&& Assign method used to hold a reference to the ReadDirMustMatch property.
		*m: readdirmustnotmatch_access		&& Access method used to retrieve the Chilkat SFTP ReadDirMustNotMatch property.
		*m: readdirmustnotmatch_assign		&& Assign method used to hold a reference to the ReadDirMustNotMatch property.
		*m: readfilebd		&& Introduced in version 9.5.0.77. Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method. The numBytes is the maximum number of bytes to read.
		*m: readfilebdasync		&& Introduced in version 9.5.0.77. Creates an asynchronous task to call the ReadFileBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: readfilebytes		&& Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method. The numBytes is the maximum number of bytes to read.
		*m: readfilebytes32		&& Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method. The offset is measured in bytes relative to the beginning of the file.
		*m: readfilebytes64s		&& (This method exists for systems that do not support 64-bit integers. The 64-bit integer offset is passed as a decimal string instead.). Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method.
		*m: readfilebytesasync		&& Creates an asynchronous task to call the ReadFileBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.). Note: Async method event callbacks happen in the background thread.
		*m: readfiletext		&& This method is identical to ReadFileBytes except for one thing: The bytes are interpreted according to the specified charset (i.e. the character encoding) and returned as a string
		*m: readfiletext32		&& This method is identical to ReadFileBytes32 except for one thing: The bytes are interpreted according to the specified charset (i.e. the character encoding) and returned as a string.
		*m: readfiletext64s		&& This method is identical to ReadFileBytes64s except for one thing: The bytes are interpreted according to the specified charset (i.e. the character encoding) and returned as a string.
		*m: readfiletextasync		&& Creates an asynchronous task to call the ReadFileText method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.). Note: Async method event callbacks happen in the background thread.
		*m: readlink		&& Introduced in version 9.5.0.71. Returns the target of a symbolic link on the server. The path is the path of the symbolic link on the server. Returns Nothing on failure
		*m: readlinkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the ReadLink method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: realpath		&& This method can be used to have the server canonicalize any given path name to an absolute path. This is useful for converting path names containing ".." components or relative pathnames without a leading slash into absolute paths.
		*m: realpathasync		&& Creates an asynchronous task to call the RealPath method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: removedir		&& Deletes a directory on the remote server. Most (if not all) SFTP servers require that the directorybe empty of files before it may be deleted. Returns 1 for success, 0 for failure.
		*m: removedirasync		&& Creates an asynchronous task to call the RemoveDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: removefile		&& Deletes a file on the SFTP server. Returns 1 for success, 0 for failure.
		*m: removefileasync		&& Creates an asynchronous task to call the RemoveFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: renamefileordir		&& Renames a file or directory on the SFTP server. This is the equivalent of moving a file.
		*m: renamefileordirasync		&& Creates an asynchronous task to call the RenameFileOrDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: resumedownloadfilebyname		&& Resumes an SFTP download. The size of the localFilePath is checked and the download begins at the appropriate position in the remoteFilePath. If localFilePath is empty or non-existent, then this method is identical to DownloadFileByName.
		*m: resumedownloadfilebynameasync		&& Creates an asynchronous task to call the ResumeDownloadFileByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: resumeuploadfilebyname		&& Resumes a file upload to the SFTP/SSH server. The size of the remoteFilePath is first checked to determine the starting offset for the upload. If remoteFilePath is empty or does not exist, this method is equivalent to UploadFileByName.
		*m: resumeuploadfilebynameasync		&& Creates an asynchronous task to call the ResumeUploadFileByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sendignore		&& Introduced in version 9.5.0.66. Sends an IGNORE message to the SSH server. This is one way of verifying that the connection to the SSH server is open and valid. The SSH server does not respond to an IGNORE message.
		*m: sendignoreasync		&& Introduced in version 9.5.0.66. Creates an asynchronous task to call the SendIgnore method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: serveridentifier_access		&& Access method used to retrieve the Chilkat SFTP ServerIdentifier property.
		*m: serveridentifier_assign		&& Assign method used to hold a reference to the ServerIdentifier property.
		*m: sessionlog_access		&& Access method used to retrieve the Chilkat SFTP SessionLog property.
		*m: sessionlog_assign		&& Assign method used to hold a reference to the SessionLog property.
		*m: setallowedalgorithms		&& Introduced in version 9.5.0.99. Provides a way to specific the exact set of algorithms allowed for the connection. Returns 1 for success, 0 for failure.
		*m: setcreatedt		&& Sets the create date/time for a file on the server. The pathOrHandle may be a filepath or the handle of a currently open file. isHandle should be set to 1 if the pathOrHandle is a handle, otherwise set isHandle to 0.
		*m: setcreatedtasync		&& Creates an asynchronous task to call the SetCreateDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: setcreatetime		&& Undocumented function! See SetCreateTimeStr method. It is an assumption that the third parameter is a VFP DateTime value. Returns 1 for success, 0 for failure.
		*m: setcreatetimestr		&& The same as SetCreateTime, except the date/time is passed as an RFC822 formatted string. Returns 1 for success, 0 for failure.
		*m: setcreatetimestrasync		&& Creates an asynchronous task to call the SetCreateTimeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread
		*m: setlastaccessdt		&& Sets the last-access date/time for a file on the server. The pathOrHandle may be a filepath or the handle of a currently open file. isHandle should be set to 1 if the pathOrHandle is a handle, otherwise set isHandle to 0.
		*m: setlastaccessdtasync		&& Creates an asynchronous task to call the SetLastAccessDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: setlastaccesstime		&& Undocumented function! See SetLastAccessTimeStr method. It is an assumption that the third parameter is a VFP DateTime value. Returns 1 for success, 0 for failure.
		*m: setlastaccesstimestr		&& The same as SetLastAccessTime, except the date/time is passed as an RFC822 formatted string. Returns 1 for success, 0 for failure.
		*m: setlastaccesstimestrasync		&& Creates an asynchronous task to call the SetLastAccessTimeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: setlastmodifieddt		&& Sets the last-modified date/time for a file on the server. The pathOrHandle may be a filepath or the handle of a currently open file. isHandle should be set to 1 if the pathOrHandle is a handle, otherwise set isHandle to 0.
		*m: setlastmodifieddtasync		&& Creates an asynchronous task to call the SetLastModifiedDt method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: setlastmodifiedtime		&& Undocumented function! See SetLastModifiedTimeStr method. It is an assumption that the third parameter is a VFP DateTime value. Returns 1 for success, 0 for failure.
		*m: setlastmodifiedtimestr		&& The same as SetLastModifiedTime, except the date/time is passed as an RFC822 formatted string. Returns 1 for success, 0 for failure.
		*m: setlastmodifiedtimestrasync		&& Creates an asynchronous task to call the SetLastModifiedTimeStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: setownerandgroup		&& Sets the owner and group for a file on the server. The pathOrHandle may be a filepath or the handle of a currently open file. isHandle should be set to 1 if the pathOrHandle is a handle, otherwise set isHandle to 0.
		*m: setownerandgroupasync		&& Creates an asynchronous task to call the SetOwnerAndGroup method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: setpermissions		&& Sets the permissions for a file on the server. The pathOrHandle may be a filepath or the handle of a currently open file. isHandle should be set to 1 if the pathOrHandle is a handle, otherwise set isHandle to 0.
		*m: setpermissionsasync		&& Creates an asynchronous task to call the SetPermissions method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: sockshostname_access		&& Access method used to retrieve the Chilkat SFTP SOCKSHostName property.
		*m: sockshostname_assign		&& Assign method used to hold a reference to the SOCKSHostName property.
		*m: sockspassword_access		&& Access method used to retrieve the Chilkat SFTP SOCKSPassword property.
		*m: sockspassword_assign		&& Assign method used to hold a reference to the SOCKSPassword property.
		*m: socksport_access		&& Access method used to retrieve the Chilkat SFTP SOCKSPort property.
		*m: socksport_assign		&& Assign method used to hold a reference to the SOCKSPort property.
		*m: socksusername_access		&& Access method used to retrieve the Chilkat SFTP SOCKSUserName property.
		*m: socksusername_assign		&& Assign method used to hold a reference to the SOCKSUserName property.
		*m: socksversion_access		&& Access method used to retrieve the Chilkat SFTP SOCKSVersion property.
		*m: socksversion_assign		&& Assign method used to hold a reference to the SOCKSVersion property.
		*m: sorcvbuf_access		&& Access method used to retrieve the Chilkat SFTP SoRcvBuf property.
		*m: sorcvbuf_assign		&& Assign method used to hold a reference to the SoRcvBuf property.
		*m: sosndbuf_access		&& Access method used to retrieve the Chilkat SFTP SoSndBuf property.
		*m: sosndbuf_assign		&& Assign method used to hold a reference to the SoSndBuf property.
		*m: startkeyboardauth		&& Introduced in version 9.5.0.88. Begins keyboard-interactive authentication with the SSH server. Returns an XML string providing the name, instruction, and prompts.
		*m: startkeyboardauthasync		&& Introduced in version 9.5.0.88. Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: symlink		&& Introduced in version 9.5.0.71. Create a symbolic link from oldpath to newpath on the server filesystem. Returns 1 for success, 0 for failure.
		*m: symlinkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the SymLink method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: synccreatealllocaldirs_access		&& Access method used to retrieve the Chilkat SFTP SyncCreateAllLocalDirs property.
		*m: synccreatealllocaldirs_assign		&& Assign method used to hold a reference to the SyncCreateAllLocalDirs property.
		*m: syncdirectives_access		&& Access method used to retrieve the Chilkat SFTP SyncDirectives property.
		*m: syncdirectives_assign		&& Assign method used to hold a reference to the SyncDirectives property.
		*m: syncedfiles_access		&& Access method used to retrieve the Chilkat SFTP SyncedFiles property.
		*m: syncedfiles_assign		&& Assign method used to hold a reference to the SyncedFiles property.
		*m: syncmustmatchdir_access		&& Access method used to retrieve the Chilkat SFTP SyncMustMatchDir property.
		*m: syncmustmatchdir_assign		&& Assign method used to hold a reference to the SyncMustMatchDir property.
		*m: syncmustmatch_access		&& Access method used to retrieve the Chilkat SFTP SyncMustMatch property.
		*m: syncmustmatch_assign		&& Assign method used to hold a reference to the SyncMustMatch property.
		*m: syncmustnotmatchdir_access		&& Access method used to retrieve the Chilkat SFTP SyncMustNotMatchDir property.
		*m: syncmustnotmatchdir_assign		&& Assign method used to hold a reference to the SyncMustNotMatchDir property.
		*m: syncmustnotmatch_access		&& Access method used to retrieve the Chilkat SFTP SyncMustNotMatch property.
		*m: syncmustnotmatch_assign		&& Assign method used to hold a reference to the SyncMustNotMatch property.
		*m: synctreedownload		&& Downloads files from the SFTP server to a local directory tree.
		*m: synctreedownloadasync		&& Creates an asynchronous task to call the SyncTreeDownload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: synctreeupload		&& Uploads a directory tree from the local filesystem to the SFTP server
		*m: synctreeuploadasync		&& Creates an asynchronous task to call the SyncTreeUpload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: tcpnodelay_access		&& Access method used to retrieve the Chilkat SFTP TCPNoDelay property.
		*m: tcpnodelay_assign		&& Assign method used to hold a reference to the TCPNoDelay property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat SFTP UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: uploadbd		&& Introduced in version 9.5.0.62. Uploads the contents of a BinData to a remote file. Returns 1 for success, 0 for failure.
		*m: uploadbdasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the UploadBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: uploadchunksize_access		&& Access method used to retrieve the Chilkat SFTP UploadChunkSize property.
		*m: uploadchunksize_assign		&& Assign method used to hold a reference to the UploadChunkSize property.
		*m: uploadfile		&& Uploads a file from the local filesystem to the SFTP server. handle is a handle of a currently open file (obtained by calling the OpenFile method). fromLocalFilePath is the local file path of the file to be uploaded.
		*m: uploadfileasync		&& Creates an asynchronous task to call the UploadFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uploadfilebyname		&& Simplified method for uploading a file to the SFTP/SSH server. The last-modified date/time is only preserved if the PreserveDate property is set to 1. This behavior of maintaining the last-mod date/time was introduced in v9.5.0.40.
		*m: uploadfilebynameasync		&& Creates an asynchronous task to call the UploadFileByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uploadsb		&& Introduced in version 9.5.0.62. Uploads the contents of a StringBuilder to a remote file.  Returns 1 for success, 0 for failure.
		*m: uploadsbasync		&& Introduced in version 9.5.0.62. Creates an asynchronous task to call the UploadSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: userauthbanner_access		&& Access method used to retrieve the Chilkat SFTP UserAuthBanner property.
		*m: userauthbanner_assign		&& Assign method used to hold a reference to the UserAuthBanner property.
		*m: utcmode_access		&& Access method used to retrieve the Chilkat SFTP UTCMode property.
		*m: utcmode_assign		&& Assign method used to hold a reference to the UTCMode property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat SFTP VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: writefilebd		&& Introduced in version 9.5.0.77. Appends the contents of bd to an open file. The handle is a file handle returned by the OpenFile method. Returns 1 for success, 0 for failure.
		*m: writefilebdasync		&& Introduced in version 9.5.0.77. Creates an asynchronous task to call the WriteFileBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: writefilebytes		&& Appends byte data to an open file. The handle is a file handle returned by the OpenFile method. Returns 1 for success, 0 for failure.
		*m: writefilebytes32		&& Writes data to an open file at a specific offset from the beginning of the file. The handle is a file handle returned by the OpenFile method. The offset is an offset from the beginning of the file. Returns 1 for success, 0 for failure.
		*m: writefilebytes64s		&& Writes data to an open file at a specific offset from the beginning of the file. The handle is a file handle returned by the OpenFile method. The offset64 is an offset (in decimal string format) from the beginning of the file.
		*m: writefilebytesasync		&& Creates an asynchronous task to call the WriteFileBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: writefiletext		&& Appends character data to an open file. The handle is a file handle returned by the OpenFile method. charset is a character encoding and is typically set to values such as "ansi", "utf-8", "windows-1252", etc.
		*m: writefiletext32		&& Writes character data to an open file at a specific offset from the beginning of the file. The handle is a file handle returned by the OpenFile method.
		*m: writefiletext64s		&& Writes character data to an open file at a specific offset from the beginning of the file. The handle is a file handle returned by the OpenFile method. The offset64 is an offset (in decimal string format) from the beginning of the file.
		*m: writefiletextasync		&& Creates an asynchronous task to call the WriteFileText method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: xferbytecount_access		&& Access method used to retrieve the Chilkat SFTP XferByteCount property.
		*m: xferbytecount_assign		&& Assign method used to hold a reference to the XferByteCount property.
		*p: abortcurrent		&& When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: accumulatebuffer		&& Contains the bytes downloaded from a remote file via the AccumulateBytes method call. Each call to AccumulateBytes appends to this buffer. To clear this buffer, call the ClearAccumulateBuffer method.
		*p: authfailreason		&& Set to one of the following values if a call to AuthenticatePw, AuthenticatePk, or AuthenticatePwPk returns a failed status.
		*p: bandwidththrottledown		&& Introduced in version 9.5.0.49. If non-zero, limits (throttles) the download bandwidth to approximately this maximum number of bytes per second. The default value of this property is 0.
		*p: bandwidththrottleup		&& Introduced in version 9.5.0.49. If non-zero, limits (throttles) the upload bandwidth to approximately this maximum number of bytes per second. The default value of this property is 0.
		*p: clientidentifier		&& The client-identifier string to be used when connecting to an SSH/SFTP server. Defaults to "SSH-2.0-PuTTY_Release_0.63". (This string is used to mimic PuTTY because some servers are known to disconnect from clients with unknown client identifiers.)
		*p: clientipaddress		&& The IP address to use for computers with multiple network interfaces or IP addresses. For computers with a single network interface (i.e. most computers), this property should not be set
		*p: connecttimeoutms		&& Maximum number of milliseconds to wait when connecting to an SSH server. To clarify: This property determines how long to wait for the SSH server to accept the TCP connection.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: disconnectcode		&& If the SSH/SFTP server sent a DISCONNECT message when closing the connection, this property contains the "reason code" as specified in RFC 4253:
		*p: disconnectreason		&& If the SSH/SFTP server sent a DISCONNECT message when closing the connection, this property contains a descriptive string for the "reason code" as specified in RFC 4253.
		*p: enablecache		&& Controls whether the component keeps an internal file size & attribute cache.
		*p: enablecompression		&& Enables or disables the use of compression w/ the SSH connection. The default value is 0. Some older SSH servers have been found that claim to support compression, but actually fail when compression is used. PuTTY does not enable compression by default
		*p: enablesecrets		&& Introduced in version 11.5.0. This property that automatic resolution of credentials from the operating system’s secure storage. The default value is 0.
		*p: filenamecharset		&& Automatically set during the InitializeSftp method if the server sends a filename-charset name-value extension. Otherwise, may be set directly to the name of a charset, such as "utf-8", "iso-8859-1", "windows-1252", etc. ("ansi" is also a valid choice.
		*p: forcecipher		&& Set to one of the following encryption algorithms to force that cipher to be used.
		*p: forcev3		&& If set to 1, forces the client to choose version 3 of the SFTP protocol, even if the server supports a higher version. The default value of this property is 1.
		*p: heartbeatms		&& This is the number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any SFTP operation prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: hostkeyalg		&& Indicates the preferred host key algorithm to be used in establishing the SSH secure connection. The default is "DSS". It may be changed to "RSA" if needed. Chilkat recommends not changing this unless a problem warrants the change.
		*p: hostkeyfingerprint		&& Set after connecting to an SSH/SFTP server. The format of the fingerprint looks like this: "ssh-rsa 1024 68:ff:d1:4e:6c:ff:d7:b0:d6:58:73:85:07:bc:2e:d5"
		*p: httpproxyauthmethod		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy authentication method name. Valid choices are "Basic" or "NTLM".
		*p: httpproxydomain		&& The NTLM authentication domain (optional) if NTLM authentication is used w/ the HTTP proxy.
		*p: httpproxyhostname		&& If an HTTP proxy is to be used, set this property to the HTTP proxy hostname or IPv4 address (in dotted decimal notation).
		*p: httpproxypassword		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy password.
		*p: httpproxyport		&& If an HTTP proxy is to be used, set this property to the HTTP proxy port number. (Two commonly used HTTP proxy ports are 8080 and 3128.)
		*p: httpproxyusername		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy login name.
		*p: idletimeoutms		&& Causes SFTP operations to fail when progress for sending or receiving data halts for more than this number of milliseconds. Setting IdleTimeoutMs = 0 allows the application to wait indefinitely.
		*p: includedotdirs		&& If 1, then the ReadDir method will include the "." and ".." directories in its results. The default value of this property is 0.
		*p: initializefailcode		&& The InitializeSftp method call opens a channel for the SFTP session. If the request to open a channel fails, this property contains a code that identifies the reason for failure.
		*p: initializefailreason		&& The InitializeSftp method call opens a channel for the SFTP session. If the request to open a channel fails, this property contains a description of the reason for failure. (It contains descriptive text matching the InitializeFailCode property.)
		*p: isconnected		&& Returns 1 if connected to the SSH server. Note: This does not mean authentication has happened or InitializeSftp has already succeeded. It only means that the connection has been established by calling Connect.
		*p: keepsessionlog		&& Controls whether communications to/from the SSH server are saved to the SessionLog property. The default value is 0. If this property is set to 1, the contents of the SessionLog property will continuously grow as SSH activity transpires.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststatuscode		&& Introduced in version 9.5.0.85. Contains the numeric last status code received in an SSH_FXP_STATUS message received from the SFTP server.
		*p: laststatusmessage		&& Introduced in version 9.5.0.85. Contains the message text received in the last SSH_FXP_STATUS message received from the SFTP server. The actual text of the message can vary depending on the SFTP server implementation.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: maxpacketsize		&& The maximum packet length to be used in the SSH transport protocol. The default value is 8192.
		*p: passwordchangerequested		&& Set by the AuthenticatePw and AuthenticatePwPk methods. If the authenticate method returns a failed status, and this property is set to 1, then it indicates the server requested a password change.
		*p: percentdonescale		&& Introduced in version 9.5.0.49. This property is only valid in programming environment and languages that allow for event callbacks. Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks.
		*p: preferipv6		&& If 1, then use IPv6 over IPv4 when both are supported for a particular domain. The default value of this property is 0, which will choose IPv4 over IPv6.
		*p: preservedate		&& If 1, then the file last-modified and create date/time will be preserved for downloaded and uploaded files. The default value is 0. Note: Prior to version 9.5.0.40, this property only applied to downloads.
		*p: protocolversion		&& The negotiated SFTP protocol version, which should be a value between 3 and 6 inclusive.
		*p: readdirmustmatch		&& Introduced in version 9.5.0.53. Can contain a wildcarded list of file patterns separated by semicolons. For example, "*.xml; *.txt; *.csv". If set, the ReadDir method will only return files that match any one of these patterns.
		*p: readdirmustnotmatch		&& Introduced in version 9.5.0.53. Can contain a wildcarded list of file patterns separated by semicolons. For example, "*.xml; *.txt; *.csv". If set, the ReadDir method will only return files that do not match any of these patterns.
		*p: serveridentifier		&& Introduced in version 9.5.0.71. The server-identifier string received from the server during connection establishment. For example, a typical value would be similar to "SSH-2.0-OpenSSH_7.2p2 Ubuntu-4ubuntu2.2".
		*p: sessionlog		&& Contains a log of the messages sent to/from the SSH server. To enable session logging, set the KeepSessionLog property = 1. Note: This property is not a filename -- it is a string property that contains the session log data.
		*p: sockshostname		&& The SOCKS4/SOCKS5 hostname or IPv4 address (in dotted decimal notation). This property is only used if the SocksVersion property is set to 4 or 5).
		*p: sockspassword		&& The SOCKS5 password (if required). The SOCKS4 protocol does not include the use of a password, so this does not apply to SOCKS4.
		*p: socksport		&& The SOCKS4/SOCKS5 proxy port. The default value is 1080. This property only applies if a SOCKS proxy is used (if the SocksVersion property is set to 4 or 5).
		*p: socksusername		&& The SOCKS4/SOCKS5 proxy username. This property is only used if the SocksVersion property is set to 4 or 5).
		*p: socksversion		&& SocksVersion May be set to one of the following integer values: 0 - No SOCKS proxy is used. This is the default. 4 - Connect via a SOCKS4 proxy. 5 - Connect via a SOCKS5 proxy.
		*p: sorcvbuf		&& Sets the receive buffer size socket option. Normally, this property should be left unchanged. The default value is 4194304. This property can be increased if download performance seems slow. It is recommended to be a multiple of 4096.
		*p: sosndbuf		&& Sets the send buffer size socket option. Normally, this property should be left unchanged. The default value is 262144. This property can be increased if upload performance seems slow. It is recommended to be a multiple of 4096.
		*p: synccreatealllocaldirs		&& Introduced in version 9.5.0.76. If 1, then empty directories on the server are created locally when doing a download synchronization. If 0, then only directories containing files that are downloaded are auto-created.
		*p: syncdirectives		&& Introduced in version 9.5.0.58. A property that can contain a list of comma-separated keywords to control certain aspects of an upload or download synchronization (for the SyncTreeUpload and SyncTreeDownload methods).
		*p: syncedfiles		&& Introduced in version 9.5.0.51. The paths of the files uploaded or downloaded in the last call to SyncUploadTree or SyncDownloadTree.
		*p: syncmustmatch		&& Can contain a wildcarded list of file patterns separated by semicolons. For example, "*.xml; *.txt; *.csv". If set, the SyncTreeUpload and SyncTreeDownload methods will only transfer files that match any one of these patterns.
		*p: syncmustmatchdir		&& Introduced in version 9.5.0.76. Can contain a wildcarded list of file patterns separated by semicolons. For example, "xml; txt; data_*".
		*p: syncmustnotmatch		&& Can contain a wildcarded list of file patterns separated by semicolons. For example, "*.xml; *.txt; *.csv". If set, the SyncTreeUpload and SyncTreeDownload methods will not transfer files that match any one of these patterns.
		*p: syncmustnotmatchdir		&& Introduced in version 9.5.0.76. Can contain a wildcarded list of file patterns separated by semicolons. For example, "xml; txt; data_*".
		*p: tcpnodelay		&& Controls whether the TCP_NODELAY socket option is used for the underlying TCP/IP socket. The default value is 1. This disables the Nagle algorithm and allows for better performance when small amounts of data are sent to/from the SSH server.
		*p: uncommonoptions		&& Introduced in version 9.5.0.73. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: uploadchunksize		&& The chunk size to use when uploading files via the UploadFile or UploadFileByName methods. The default value is 32000.
		*p: userauthbanner		&& Introduced in version 9.5.0.88. If a user authentication banner message is received during authentication, it will be made available here. An application can check to see if this property contains a banner string after calling StartKeyboardAuth.
		*p: utcmode		&& If 1, then date/times are returned as UTC times. If 0 (the default) then date/times are returned as local times.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: xferbytecount		&& Introduced in version 9.5.0.71. The current transfer byte count for an ongoing upload or download. Programs doing asynchronous uploads or downloads can read this property in real time during the upload.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		accumulatebuffer = 
		authfailreason = 0
		bandwidththrottledown = 0
		bandwidththrottleup = 0
		cchilkatclass = SFtp
		ceventhandlerclass = iSFTPEventHandler
		clientidentifier = SSH-2.0-PuTTY_Release_0.63
