	PROCEDURE verifybdenc		&& Introduced in version 9.5.0.83. Verifies the signature against the contents of bd. The encodedSig is passed as an encoded string (such as hex, base64, etc.) using the encoding specified by enocding.
		*==============================================================================
		* Method:            VerifyBdEnc
		* Purpose:           Verifies the signature against the contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		*                    tcEncodedSignature, the encoded signature to verify.
		*                    tcEncoding, the signature encoding.
		*                    toChilkatPublicKey, a Chilkat Public Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Verifies the signature against the contents of bd. 
		** The encodedSig is passed as an encoded string (such as hex, base64, etc.) 
		** using the encoding specified by encoding. 
		** The pubkey contains the Ed25519 public key used to verify.
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		tcEncodedSignature AS Character, tcEncoding AS Character, ;
		toChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EDDSA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loParkParameterPublicKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey  
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loParkParameterPublicKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPublicKey)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		      loChilkatPublicKey = m.loParkParameterPublicKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.VerifyBdEnc(m.loChilkatBinData, ;
		        m.tcEncodedSignature, m.tcEncoding, m.loChilkatPublicKey) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		      toChilkatPublicKey = ;
		      m.loParkParameterPublicKey.SetObject(m.toChilkatPublicKey, m.loChilkatPublicKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EDDSA_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPublicKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS email AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a complete Email object.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addattachmentbd		&& Adds an attachment using the contents of a BinData object. If contentType is empty, then the content-type will be inferred from the filename extension. Returns 1 for success, 0 for failure.
		*m: addattachmentheader		&& Adds or replaces a MIME header field in one of the email attachments. If the header field does not exist, it is added. Otherwise it is replaced.
		*m: addbcc		&& Adds a recipient to the blind carbon-copy list. emailAddress is required, but friendlyName may be empty. To add multiple BCC recipients, call this method once per recipient. Returns 1 for success, 0 for failure.
		*m: addcc		&& Adds a recipient to the carbon-copy list. emailAddress is required, but friendlyName may be empty. To add multiple CC recipients, call this method once per recipient. Returns 1 for success, 0 for failure.
		*m: adddataattachment		&& Adds an attachment directly from data in memory to the email. Returns 1 for success, 0 for failure.
		*m: adddataattachment2		&& Adds an attachment to an email from in-memory data. Same as AddDataAttachment but allows the content-type to be specified. Returns 1 for success, 0 for failure.
		*m: addencryptcert		&& Allows for certificates to be explicitly specified for sending encrypted email to one or more recipients. Call this method once per certificate to be used. The ClearEncryptCerts method may be called to clear the list of explicitly-specified certificates.
		*m: addfileattachment		&& Adds a file as an attachment to the email. Returns the MIME content-type of the attachment, which is inferred based on the filename extension. Returns Nothing on failure.
		*m: addfileattachment2		&& Same as AddFileAttachment, but the content type can be explicitly specified. Returns 1 for success, 0 for failure.
		*m: addheaderfield		&& Any standard or non-standard (custom) header field can be added to the email with this method. One interesting feature is that all header fields whose name begins with "CKX-" will not be included in the header when an email is sent.
		*m: addheaderfield2		&& This method is the same as AddHeaderField, except that if the header field already exists, it is not replaced. A duplicate header will be added.
		*m: addhtmlalternativebody		&& Sets the HTML body of the email. Use this method if there will be multiple versions of the body, but in different formats, such as HTML and plain text. Otherwise, set the body by calling the SetHtmlBody method. Returns 1 for success, 0 for failure.
		*m: addicalendaralternativebody		&& Adds an iCalendar (text/calendar) alternative body to the email. The icalContent contains the content of the iCalendar data. A sample is shown here:
		*m: addmultiplebcc		&& Adds multiple recipients to the blind carbon-copy list. The parameter is a string containing a comma separated list of full email addresses. Returns True if successful. Returns 1 for success, 0 for failure.
		*m: addmultiplecc		&& Adds multiple recipients to the carbon-copy list. The parameter is a string containing a comma separated list of full email addresses. Returns True if successful. Returns 1 for success, 0 for failure.
		*m: addmultipleto		&& Adds multiple recipients to the "to" list. The parameter is a string containing a comma separated list of full email addresses. Returns True if successful. Returns 1 for success, 0 for failure.
		*m: addpfxsourcebd		&& Introduced in version 11.0.0. Adds a PFX file to the object's list of sources for locating certificates and private keys during decryption or signing. To add multiple PFX sources, call this method for each file. Returns 1 for success, 0 for failure.
		*m: addpfxsourcedata		&& Adds a PFX to the object's internal list of sources to be searched for certificates and private keys when decrypting. Multiple PFX sources can be added by calling this method once for each.
		*m: addpfxsourcefile		&& Adds a PFX file to the object's internal list of sources to be searched for certificates and private keys when decrypting. Multiple PFX sources can be added by calling this method once for each.
		*m: addplaintextalternativebody		&& Sets the plain-text body of the email. Use this method if there will be multiple versions of the body, but in different formats, such as HTML and plain text. Otherwise, simply set the Body property. Returns 1 for success, 0 for failure.
		*m: addrelatedbd		&& Introduced in version 9.5.0.65. Adds a related item using the contents of a BinData object. Returns the Content-ID for the newly added relted item. Returns Nothing on failure.
		*m: addrelatedbd2		&& Adds a related item using the contents of a BinData object. The fileNameInHtml should be set to the filename/path/url used in the corresponding HTML IMG tag's "src" attribute. Returns 1 for success, 0 for failure.
		*m: addrelateddata		&& Adds the memory data as a related item to the email and returns the Content-ID. Emails formatted in HTML can include images with this call and internally reference the image through a "cid"hyperlink. (Chilkat Email.NET fully supports the MHTML standard.)
		*m: addrelateddata2		&& Adds a related item to the email from in-memory byte data. Related items are things such as images and style sheets that are embedded within an HTML email.
		*m: addrelatedfile		&& Adds the contents of a file to the email and returns the Content-ID. Emails formatted in HTML can include images with this call and internally reference the image through a "cid" hyperlink. (Chilkat Email.NET fully supports the MHTML standard.)
		*m: addrelatedfile2		&& Adds a related item to the email from a file. Related items are things such as images and style sheets that are embedded within an HTML email. They are not considered attachments because their sole purpose is to participate in the display of the HTML.
		*m: addrelatedheader		&& Adds or replaces a MIME header field in one of the email's related items. If the header field does not exist, it is added. Otherwise it is replaced.
		*m: addrelatedstring		&& Adds a related item to the email. A related item is typically an image or style sheet referenced by an HTML tag within the HTML email body.
		*m: addrelatedstring2		&& Adds a related item to the email from an in-memory string. Related items are things such as images and style sheets that are embedded within an HTML email.
		*m: addstringattachment		&& Adds an attachment directly from a string in memory to the email. Returns 1 for success, 0 for failure.
		*m: addstringattachment2		&& Adds an attachment to an email. The path specifies the filename to be used for the attachment and is not an actual filename existing on the local filesystem.
		*m: addto		&& Adds a recipient to the "to" list. emailAddress is required, but friendlyName may be empty. Emails that have no "To" recipients will be sent to <undisclosed-recipients>. To add multiple recipients, call this method once per TO recipient.
		*m: aesdecrypt		&& Decrypts and restores an email message that was previously encrypted using AesEncrypt. The password must match the password used for encryption.
		*m: aesencrypt		&& Encrypts the email body, all alternative bodies, all message sub-parts and attachments using 128-bit AES CBC encryption. Decrypting is achieved by calling AesDecrypt with the same password.
		*m: appendtobody		&& Appends a string to the plain-text body.
		*m: applyfixups		&& Sometimes emails created by other software or systems are not formatted according to typical conventions. This method provides a means to automatically fix certain problems.
		*m: aspunpack		&& Write an HTML’s embedded images to a temp directory. The HTML’s IMG tags are updated to reference the temp files. AspUnpack also writes an HTML file to the temp directory (for the purpose of including it in an iframe tag)
		*m: aspunpack2		&& Write an HTML’s embedded images to a temp directory. The HTML’s IMG tags are updated to reference the temp files. AspUnpack also writes an HTML file to the temp directory (for the purpose of including it in an iframe tag)
		*m: attachemail		&& Attaches copy of the email to this email object. The attached email will be encapsulated in an message/rfc822 sub-part. Returns 1 for success, 0 for failure.
		*m: attachmessage		&& Attaches a MIME message to the email object. The attached MIME will be encapsulated in an message/rfc822 sub-part. Returns 1 for success, 0 for failure.
		*m: bencodebytes		&& Takes a byte array of multibyte (non-Unicode) data and returns a Unicode B-Encoded string. Returns Nothing on failure
		*m: bencodestring		&& Takes a Unicode string, converts it to the charset specified in the 2nd parameter, B-Encodes the converted multibyte data, and returns the encoded Unicode string. Returns Nothing on failure
		*m: body_access		&& Access method used to retrieve the Chilkat Email Body property.
		*m: body_assign		&& Assign method used to hold a reference to the Body property.
		*m: bounceaddress_access		&& Access method used to retrieve the Chilkat Email BounceAddress property.
		*m: bounceaddress_assign		&& Assign method used to hold a reference to the BounceAddress property.
		*m: charset_access		&& Access method used to retrieve the Chilkat Email Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: clear		&& Introduced in version 9.5.0.76. Clears the email object of all information to the state as if the object was just created, which will have default headers such as Mime-Version, Date, Message-ID, Content-Type, Content-Transfer-Encoding, and X-Priority.
		*m: clearbcc		&& Clears the list of blind carbon-copy recipients.
		*m: clearcc		&& Clears the list of carbon-copy recipients.
		*m: clearencryptcerts		&& Clears the internal list of explicitly specified certificates to be used for this encrypted email.
		*m: clearto		&& Clears the list of "to" recipients.
		*m: clone		&& Creates and returns an identical copy of the Email object. Returns Nothing on failure
		*m: computeglobalkey		&& Decremented function! Use the ComputeGlobalKey2 function if you can.
		*m: computeglobalkey2		&& Computes a global unique key for the email.
		*m: convertinlineimages		&& Converts images embedded inline within HTML to multipart/related MIME parts referenced from the HTML by CID. Returns 1 for success, 0 for failure.
		*m: createdsn		&& Creates a new DSN (Delivery Status Notification) email having the format as specified in RFC 3464. See the example (below) for more detailed information.
		*m: createforward		&& Returns a copy of the Email object with the body and header fields changed so that the newly created email can be forwarded. After calling CreateForward, simply add new recipients to the created email, and call MailMan.SendEmail.
		*m: createmdn		&& Creates a new MDN (Message Disposition Notification) email having the format as specified in RFC 3798. See the example (below) for more detailed information. Returns Nothing on failure
		*m: createreply		&& Returns a copy of the Email object with the body and header fields changed so that the newly created email can be sent as a reply. After calling CreateReply, simply prepend additional information to the body, and call MailMan.SendEmail.
		*m: createtempmht		&& Saves the email to a temporary MHT file so that a WebBrowser control can navigate to it and display it. If fileName is empty, a temporary filename is generated and returned.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Email DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: decrypted_access		&& Access method used to retrieve the Chilkat Email Decrypted property.
		*m: decrypted_assign		&& Assign method used to hold a reference to the Decrypted property.
		*m: dropattachments		&& Removes all attachments from the email.
		*m: droprelateditem		&& A related item is typically an embedded image referenced from the HTML in the email via a "CID" hyperlink. This method removes the Nth embedded image from the email.
		*m: droprelateditems		&& A related item is typically an embedded image referenced from the HTML in the email via a "CID" hyperlink. This method removes all the embedded images from the email.
		*m: dropsingleattachment		&& Drops a single attachment from the email. Returns True if successful. Returns 1 for success, 0 for failure.
		*m: emaildatestr_access		&& Access method used to retrieve the Chilkat Email EmailDateStr property.
		*m: emaildatestr_assign		&& Assign method used to hold a reference to the EmailDateStr property.
		*m: emaildate_access		&& Access method used to retrieve the Chilkat Email EmailDate property.
		*m: emaildate_assign		&& Assign method used to hold a reference to the EmailDate property.
		*m: encryptedby_access		&& Access method used to retrieve the Chilkat Email Encrypted property.
		*m: encryptedby_assign		&& Assign method used to hold a reference to the Encrypted property.
		*m: filedistlist_access		&& Access method used to retrieve the Chilkat Email FileDistList property.
		*m: filedistlist_assign		&& Assign method used to hold a reference to the FileDistList property.
		*m: findissuer		&& Finds a matching issuer certificate.
		*m: fromaddress_access		&& Access method used to retrieve the Chilkat Email FromAddress property.
		*m: fromaddress_assign		&& Assign method used to hold a reference to the FromAddress property.
		*m: fromname_access		&& Access method used to retrieve the Chilkat Email FromName property.
		*m: fromname_assign		&& Assign method used to hold a reference to the FromName property.
		*m: from_access		&& Access method used to retrieve the Chilkat Email From property.
		*m: from_assign		&& Assign method used to hold a reference to the From property.
		*m: generatefilename		&& Generates a unique filename for this email. The filename will be different each time the method is called. Returns Nothing on failure
		*m: getalternativebody		&& Returns the Nth alternative body. The NumAlternatives property tells the number of alternative bodies present. Use the GetHtmlBody and GetPlainTextBody methods to easily get the HTML or plain text alternative bodies.
		*m: getalternativebodybd		&& Returns contents of the Nth alternative body to binData. The 1st alternative body is at index 0. This method should only be called when the NumAlternatives property has a value greater than 0. Returns 1 for success, 0 for failure.
		*m: getalternativebodybycontenttype		&& Returns the alternative body by content-type, such as "text/plain", "text/html", "text/xml", etc. Returns Nothing on failure
		*m: getalternativecontenttype		&& Returns the content type of the Nth alternative body. The NumAlternatives property tells the number of alternative bodies present. Returns Nothing on failure
		*m: getaltheaderfield		&& Returns the value of a header field within the Nth alternative body's MIME sub-part. Returns Nothing on failure
		*m: getattachedemail		&& Introduced in version 11.0.0. The Nth embedded "message/rfc822" subpart in email. Returns 1 for success, 0 for failure.
		*m: getattachedmessage		&& Returns an embedded "message/rfc822" subpart as an email object. (Emails are embedded as "message/rfc822" subparts by some mail clients when forwarding an email.) This method allows the original email to be accessed. Returns Nothing on failure
		*m: getattachedmessageattr		&& Returns a header field attribute value for the Nth attached (embedded) email. For example, to get the value of the "name" attribute in the Content-Type header for the 1st attached message:
		*m: getattachedmessagefilename		&& Returns the filename of the Nth attached (embedded) email. The filename is the "filename" attribute of the content-disposition header field found within the Nth message/rfc822 sub-part of the calling email object.
		*m: getattachmentattr		&& Returns a header field attribute value from the header field of the Nth attachment. Returns Nothing on failure
		*m: getattachmentbd		&& Copies an attachment's binary data into binData. The first attachment is at index 0. Returns 1 for success, 0 for failure.
		*m: getattachmentcontentid		&& Returns the ContentID header field for the Nth attachment. The first attachment is at index 0. Returns Nothing on failure
		*m: getattachmentcontenttype		&& Returns the Content-Type header field for the Nth attachment. Indexing of attachments begins at 0. Returns Nothing on failure
		*m: getattachmentdata		&& Retrieves an attachment's binary data for in-memory access. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: getattachmentfilename		&& Retrieves an attachment's filename.
		*m: getattachmentheader		&& Returns the value of a header field (by name) of an attachment. Returns Nothing on failure.
		*m: getattachmentsize		&& Returns the size (in bytes) of the Nth attachment. The 1st attachment is at index 0. Returns -1 if there is no attachment at the specified index.
		*m: getattachmentstring		&& Retrieves an attachment's data as a String. All CRLF sequences will be translated to single newline characters. The charset indicates how to interpret the bytes of the attachment.
		*m: getattachmentstringcrlf		&& Retrieves an attachment's data as a String. All end-of-lines will be translated to CRLF sequences. Returns Nothing on failure
		*m: getbcc		&& Returns a blind carbon-copy recipient's full email address. Returns Nothing on failure
		*m: getbccaddr		&& Returns the Nth BCC address (only the address part, not the friendly-name part). Returns Nothing on failure.
		*m: getbccname		&& Returns the Nth BCC name (only the friendly-name part, not the address part). Returns Nothing on failure.
		*m: getcc		&& Returns a carbon-copy recipient's full email address. Returns Nothing on failure
		*m: getccaddr		&& Returns the Nth CC address (only the address part, not the friendly-name part). Returns Nothing on failure.
		*m: getccname		&& Returns the Nth CC name (only the friendly-name part, not the address part). Returns Nothing on failure.
		*m: getdeliverystatusinfo		&& If the email is a multipart/report, then it is a delivery status notification. This method can be used to get individual pieces of information from the message/delivery-status part of the email.
		*m: getdigest		&& Returns an digest contained within a multipart/digest as an email object. The 1st digest is at index 0. Use the NumDigests property to get the number of digests available. Note: This example requires Chilkat v9.5.0.66 or greater.
		*m: getdigestemail		&& Introduced in version 11.0.0. Returns in email the Nth digest email contained within a multipart/digest. The 1st digest is at index 0. Use the NumDigests property to get the number of digests available. Returns 1 for success, 0 for failure.
		*m: getdsnfinalrecipients		&& If the email is a multipart/report, then it is a delivery status notification. This method can be used to get Final-Recipient values from the message/delivery-status part of the email.
		*m: getdsninfo		&& Introduced in version 11.0.0. If the IsMultipartReport property indicates that the email is multipart/report, you can use this method to obtain the delivery status information, including the final recipients, in a JSON format that is easy to parse.
		*m: getdt		&& Returns the date/time found in the "Date" header field as a date/time object. Returns Nothing on failure.
		*m: getencryptcert		&& Returns the certificate that was previously set by SetEncryptCert. Returns Nothing on failure.
		*m: getencryptedbycert		&& Returns the certificate associated with a received encrypted email. Returns Nothing on failure.
		*m: getfilecontent		&& Reads a file and returns the contents as a String. This is here purely for convenience. Returns a zero-length byte array (as a Variant) on failure.
		*m: getheaderfield		&& Returns the value of a header field. Returns Nothing on failure.
		*m: getheaderfieldname		&& Return the name of the Nth header field. The NumHeaderFields() method can be used to get the number of header fields. The GetHeaderField() method can be used to get the value of the field given the field name.
		*m: getheaderfieldvalue		&& Returns the value of the Nth header field. (Indexing begins at 0) The number of header fields can be obtained from the NumHeaderFields property.
		*m: gethtmlbody		&& Returns the body having the "text/html" content type. Returns Nothing on failure.
		*m: gethtmlbodysb		&& Introduced in version 10.1.2. Returns the body having the "text/html" content type. If inlineImageData is 1, the related images found in the MIME are inlined as base64 directly within the returned HTML. The HTML is returned in sb.
		*m: getimapuid		&& This method returns the UID if ckx-imap-uid exists and contains a UID, otherwise it returns -1.
		*m: getlinkeddomains		&& Parses an HTML email and returns the set of domain names that occur in hyperlinks within the HTML body. Returns Nothing on failure.
		*m: getmbheaderfield		&& Returns a header field's data in a byte array. If the field was Q or B encoded, this is automatically decoded, and the raw bytes of the field are returned. Call GetHeaderField to retrieve the header field as a Unicode string.
		*m: getmbhtmlbody		&& Returns the HTML body converted to a specified charset. If no HTML body exists, the returned byte array is empty.
		*m: getmbplaintextbody		&& Returns the plain-text body converted to a specified charset. The return value is a byte array containing multibyte character data.
		*m: getmime		&& Return the email as MIME text containing the email header, body (or bodies), related items (if any), and all attachments. Returns Nothing on failure.
		*m: getmimebd		&& Return the email as binary MIME containing the email header, body (or bodies), related items (if any), and all attachments. The MIME is appended to the existing contents (if any) of bindat. Returns 1 for success, 0 for failure.
		*m: getmimebinary		&& Returns the full MIME of an email. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: getmimesb		&& Return the email as MIME text containing the email header, body (or bodies), related items (if any), and all attachments. The MIME is appended to the existing contents (if any) of sb. Returns 1 for success, 0 for failure.
		*m: getnthbinarypartoftype		&& Returns the binary bytes of the Nth MIME sub-part having a specified content type (such as "application/pdf". Indexing begins at 0. Call GetNumPartsOfType to find out how many MIME sub-parts exist for any given content type.
		*m: getnthbinarypartoftypebd		&& Introduced in version 9.5.0.95. Loads bd with the binary bytes of the Nth MIME sub-part matching the contentType, which can be an exact Content-Type such as "application/pdf", or a wildcarded Content-Type such as "application/*", or "*/*".
		*m: getnthcontenttype		&& Introduced in version 9.5.0.95. Returns the Content-Type of the Nth MIME sub-part matching the specified contentType.
		*m: getnthtextpartoftype		&& Returns the text of the Nth MIME sub-part having a specified content type (such as "text/plain". Indexing begins at 0. Call GetNumPartsOfType to find out how many MIME sub-parts exist for any given content type.
		*m: getnumpartsoftype		&& Returns the number of MIME sub-parts within the email having a specified content type (such as "text/plain"). If inlineOnly is 1, then only MIME sub-parts having a content-disposition of "inline" are included.
		*m: getplaintextbody		&& Returns the email body having the "text/plain" content type. Returns Nothing on failure.
		*m: getrelatedattr		&& Returns a header field attribute value from the header field of the Nth related item. Returns Nothing on failure
		*m: getrelatedcontentid		&& Returns the content ID of a related item contained with the email. Related items are typically images and style-sheets embedded within HTML emails. Returns Nothing on failure
		*m: getrelatedcontentlocation		&& Returns the Content-Location of a related item contained with the email. Related items are typically images and style-sheets embedded within HTML emails. Returns Nothing on failure
		*m: getrelatedcontenttype		&& Returns the content-type of the Nth related content item in an email message. Returns Nothing on failure
		*m: getrelateddata		&& Returns the content of a related item contained with the email. Related items are typically images and style-sheets embedded within HTML emails. Returns a zero-length byte array (as a Variant) on failure.
		*m: getrelatedfilename		&& Returns the filename of a related item contained with the email. Related items are typically images and style-sheets embedded within HTML emails. Returns Nothing on failure
		*m: getrelatedheader		&& Introduced in version 10.0.0. Returns the value of a header field (by name) of a related item.
		*m: getrelatedstring		&& Returns the text with CR line-endings of a related item contained with the email. Related items are typically images and style-sheets embedded within HTML emails. Returns Nothing on failure
		*m: getrelatedstringcrlf		&& Returns the text with CRLF line-endings of a related item contained with the email. Related items are typically images and style-sheets embedded within HTML emails. Returns Nothing on failure
		*m: getreplacepattern		&& Returns a replacement pattern previously defined for mail-merge operations. Returns Nothing on failure
		*m: getreplacestring		&& Returns a replacement string for a previously defined pattern/replacement string pair. (This is a mail-merge feature.) Returns Nothing on failure
		*m: getreplacestring2		&& Returns a replacement string for a previously defined pattern/replacement string pair. (This is a mail-merge feature.) Returns Nothing on failure.
		*m: getreport		&& Returns the body content of the Nth report within a multipart/report email.
		*m: getsignedbycert		&& Return the certificate used to digitally sign this email. Returns Nothing on failure
		*m: getsignedbycertchain		&& Return the full certificate chain of the certificate used to digitally sign this email. Returns Nothing on failure
		*m: getsigningcert		&& Return the certificate that will be used to digitally sign this email. This is the cerficate that was previously set by calling the SetSigningCert method. Returns Nothing on failure
		*m: getto		&& Returns a "to" recipient's full email address. Returns Nothing on failure
		*m: gettoaddr		&& Returns the Nth To address (only the address part, not the friendly-name part). Returns Nothing on failure
		*m: gettoname		&& Returns the Nth To name (only the friendly-name part, not the address part). Returns Nothing on failure
		*m: getxml		&& Convert the email object to an XML document in memory. Returns Nothing on failure
		*m: hasheadermatching		&& Returns 1 if the email has a header field with the specified fieldName with a value matching valuePattern. Case sensitivity is controlled by caseSensitive.
		*m: hashtmlbody		&& Returns true if the email has an HTML body.
		*m: hasplaintextbody		&& Returns true if the email has a plain-text body.
		*m: header_access		&& Access method used to retrieve the Chilkat Email Header property.
		*m: header_assign		&& Assign method used to hold a reference to the Header property.
		*m: ismultipartreport		&& Returns true if the email is a multipart/report email.
		*m: language_access		&& Access method used to retrieve the Chilkat Email Language property.
		*m: language_assign		&& Assign method used to hold a reference to the Language property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Email LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastdecryptcert		&& Introduced in version 11.0.0. Returns in cert the certificate used to decrypt this email. Returns 1 for success, 0 for failure.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Email LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Email LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Email LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Email LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastsignercert		&& Introduced in version 11.0.0. Returns the Nth certificate in index used to digitally sign this email. Signed emails are typically signed by a single signer, but it is possible to have multiple signers. Returns 1 for success, 0 for failure.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Email LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Email LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: linkeddomains		&& Introduced in version 11.0.0. Extracts domain names from hyperlinks in an HTML email. Lowercase domains are appended to domains without creating duplicates. Returns 1 for success, 0 for failure.
		*m: loadbodyfromfile		&& Sets the plain-text or HTML body from the contents of a file. For an HTML file, the isHtml argument should be 1 (otherwise 0).
		*m: loademl		&& Loads a complete email from a .EML file. (EML files are simply RFC822 MIME text files.) Note: This replaces the entire contents of the email object, including the To/CC recipients. Returns 1 for success, 0 for failure.
		*m: loadtaskresult		&& Loads the email object from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*m: loadxml		&& Loads an email with the contents of an XML email file. Note: This replaces the entire contents of the email object, including the To/CC recipients. Returns 1 for success, 0 for failure.
		*m: loadxmlstring		&& Loads an email from an XML string (previously obtained by calling the GetXml method). The contents of the calling email object are erased and replaced with the email contained within the XML string. Returns 1 for success, 0 for failure.
		*m: localdatestr_access		&& Access method used to retrieve the Chilkat Email LocalDateStr property.
		*m: localdatestr_assign		&& Assign method used to hold a reference to the LocalDateStr property.
		*m: localdate_access		&& Access method used to retrieve the Chilkat Email LocalDate property.
		*m: localdate_assign		&& Assign method used to hold a reference to the LocalDate property.
		*m: mailer_access		&& Access method used to retrieve the Chilkat Email Mailer property.
		*m: mailer_assign		&& Assign method used to hold a reference to the Mailer property.
		*m: makecopy		&& Introduced in version 11.0.0. Creates a copy of this email in destEmail. Returns 1 for success, 0 for failure.
		*m: numalternatives_access		&& Access method used to retrieve the Chilkat Email NumAlternatives property.
		*m: numalternatives_assign		&& Assign method used to hold a reference to the NumAlternatives property.
		*m: numattachedmessages_access		&& Access method used to retrieve the Chilkat Email NumAttachedMessages property.
		*m: numattachedmessages_assign		&& Assign method used to hold a reference to the NumAttachedMessages property.
		*m: numattachments_access		&& Access method used to retrieve the Chilkat Email NumAttachments property.
		*m: numattachments_assign		&& Assign method used to hold a reference to the NumAttachments property.
		*m: numbcc_access		&& Access method used to retrieve the Chilkat Email NumBCC property.
		*m: numbcc_assign		&& Assign method used to hold a reference to the NumBCC property.
		*m: numcc_access		&& Access method used to retrieve the Chilkat Email NumCC property.
		*m: numcc_assign		&& Assign method used to hold a reference to the NumCC property.
		*m: numdaysold_access		&& Access method used to retrieve the Chilkat Email NumDaysOld property.
		*m: numdaysold_assign		&& Assign method used to hold a reference to the NumDaysOld property.
		*m: numdigests_access		&& Access method used to retrieve the Chilkat Email NumDigests property.
		*m: numdigests_assign		&& Assign method used to hold a reference to the NumDigests property.
		*m: numheaderfields_access		&& Access method used to retrieve the Chilkat Email NumHeaderFields property.
		*m: numheaderfields_assign		&& Assign method used to hold a reference to the NumHeaderFields property.
		*m: numrelateditems_access		&& Access method used to retrieve the Chilkat Email NumRelatedItems property.
		*m: numrelateditems_assign		&& Assign method used to hold a reference to the NumRelatedItems property.
		*m: numreplacepatterns_access		&& Access method used to retrieve the Chilkat Email NumReplacePatterns property.
		*m: numreplacepatterns_assign		&& Assign method used to hold a reference to the NumReplacePatterns property.
		*m: numreports_access		&& Access method used to retrieve the Chilkat Email NumReports property.
		*m: numreports_assign		&& Assign method used to hold a reference to the NumReports property.
		*m: numto_access		&& Access method used to retrieve the Chilkat Email NumTo property.
		*m: numto_assign		&& Assign method used to hold a reference to the NumTo property.
		*m: oaephash_access		&& Access method used to retrieve the Chilkat Email OAEPHash property.
		*m: oaephash_assign		&& Assign method used to hold a reference to the OAEPHash property.
		*m: oaepmgfhash_access		&& Access method used to retrieve the Chilkat Email OAEPMGFHash property.
		*m: oaepmgfhash_assign		&& Assign method used to hold a reference to the OAEPMGFHash property.
		*m: oaeppadding_access		&& Access method used to retrieve the Chilkat Email OAEPPadding property.
		*m: oaeppadding_assign		&& Assign method used to hold a reference to the OAEPPadding property.
		*m: overwriteexisting_access		&& Access method used to retrieve the Chilkat Email OverwriteExisting property.
		*m: overwriteexisting_assign		&& Assign method used to hold a reference to the OverwriteExisting property.
		*m: pkcs7cryptalg_access		&& Access method used to retrieve the Chilkat Email PKCS7CryptAlg property.
		*m: pkcs7cryptalg_assign		&& Assign method used to hold a reference to the PKCS7CryptAlg property.
		*m: pkcs7keylength_access		&& Access method used to retrieve the Chilkat Email PKCS7Length property.
		*m: pkcs7keylength_assign		&& Assign method used to hold a reference to the PKCS7KeyLength property.
		*m: preferredcharset_access		&& Access method used to retrieve the Chilkat Email PreferredCharset property.
		*m: preferredcharset_assign		&& Assign method used to hold a reference to the PreferredCharset property.
		*m: prependheaders_access		&& Access method used to retrieve the Chilkat Email PrependHeaders property.
		*m: prependheaders_assign		&& Assign method used to hold a reference to the PrependHeaders property.
		*m: qencodebytes		&& Takes a byte array of multibyte (non-Unicode) data and returns a Unicode Q-Encoded string. Returns Nothing on failure
		*m: qencodestring		&& Takes a Unicode string, converts it to the charset specified in the 2nd parameter, Q-Encodes the converted multibyte data, and returns the encoded Unicode string. Returns Nothing on failure
		*m: receivedencrypted_access		&& Access method used to retrieve the Chilkat Email ReceivedEncrypted property.
		*m: receivedencrypted_assign		&& Assign method used to hold a reference to the ReceivedEncrypted property.
		*m: receivedsigned_access		&& Access method used to retrieve the Chilkat Email ReceivedSigned property.
		*m: receivedsigned_assign		&& Assign method used to hold a reference to the ReceivedSigned property.
		*m: removeattachedmessage		&& Removes the Nth message/rfc822 sub-part of the email. Indexing begins at 0.
		*m: removeattachedmessages		&& Removes all message/rfc822 sub-parts of the email object.
		*m: removeattachmentpaths		&& Removes path information from all attachment filenames.
		*m: removeheaderfield		&& Removes by name all occurrences of a header field.
		*m: removehtmlalternative		&& Removes the HTML body from the email (if an HTML body exists).
		*m: removeplaintextalternative		&& Removes the plain-text body from the email (if a plain-text body exists).
		*m: replyto_access		&& Access method used to retrieve the Chilkat Email ReplyTo property.
		*m: replyto_assign		&& Assign method used to hold a reference to the ReplyTo property.
		*m: returnreceipt_access		&& Access method used to retrieve the Chilkat Email ReturnReceipt property.
		*m: returnreceipt_assign		&& Assign method used to hold a reference to the ReturnReceipt property.
		*m: saveallattachments		&& Save all the attachments of an email to files in a directory specified by dirPath. The OverwriteExisting property controls whether existing files are allowed to be overwritten.
		*m: saveattachedfile		&& Saves the Nth email attachment to the directory specified by dirPath. The 1st attachment is at index 0. The OverwriteExisting property controls whether existing files are allowed to be overwritten. Returns 1 for success, 0 for failure.
		*m: saveeml		&& Convert this email object to EML and save it to a file. Returns 1 for success, 0 for failure.
		*m: saverelateditem		&& Saves the Nth related item to the directory specified by dirPath. (The 1st related item is at index 0) Related content items are typically image or style-sheets embedded within an HTML email.
		*m: savexml		&& Convert this email object to XML and save it to a file. Returns 1 for success, 0 for failure.
		*m: sendencrypted_access		&& Access method used to retrieve the Chilkat Email SendEncrypted property.
		*m: sendencrypted_assign		&& Assign method used to hold a reference to the SendEncrypted property.
		*m: sender_access		&& Access method used to retrieve the Chilkat Email Sender property.
		*m: sender_assign		&& Assign method used to hold a reference to the Sender property.
		*m: sendsigned_access		&& Access method used to retrieve the Chilkat Email SendSigned property.
		*m: sendsigned_assign		&& Assign method used to hold a reference to the SendSigned property.
		*m: setattachmentcharset		&& Sets the charset attribute of the content-type header field for a specified attachment. This can be used if the attachment is a text file that contains text in a non us-ascii charset such as Shift_JIS, iso-8859-2, big5, iso-8859-5, etc.
		*m: setattachmentdisposition		&& Set's an attachment's disposition. The default disposition of an attachment is "attachment". This method is typically called to change the disposition to "inline". The 1st attachment is at index 0.
		*m: setattachmentfilename		&& Renames a email attachment's filename. The 1st attachment is at index 0. Returns 1 for success, 0 for failure.
		*m: setbinarybody		&& Sets the main body of the email to binary content of any type. The disposition can be an empty string, "inline", or "attachment".
		*m: setbodybd		&& Introduced in version 11.0.0. This function sets the email's main body to binary content. bd contains the binary data. disposition specifies the disposition and can be an empty string,
		*m: setcsp		&& Decremented function! Accepts a (decremented) Chilkat CSP reference.
		*m: setdecryptcert		&& Allows for a certificate to be explicity provided for decryption. When an email object is loaded via any method, such as LoadEml, SetFromMimeText, SetFromMimeBytes, etc., security layers (signatures and encryption) are automatically unwrapped.
		*m: setdecryptcert2		&& Allows for a certificate and private key to be explicity specified for decryption.
		*m: setdt		&& Sets the "Date" header field of the email to have the value of the date/time object provided. Returns 1 for success, 0 for failure.
		*m: setedifactbody		&& Introduced in version 9.5.0.28. Creates a typical email used to send EDIFACT messages
		*m: setencryptcert		&& Set the encryption certificate to be used in encryption. Use the CreateCS, CertStore, and Cert classes to create a Cert object by either locating a certificate in a certificate store or loading one from a file. Returns 1 for success, 0 for failure.
		*m: setfrommimebd		&& Loads an email with the MIME stored in a BinData object.
		*m: setfrommimebytes		&& Loads the email object with the mimeBytes. If the email object already contained an email, it is entirely replaced. The character encoding (such as "utf-8", "iso-8859-1", etc.) of the bytes is automatically inferred from the content.
		*m: setfrommimebytes2		&& Loads the email object with the mimeBytes. If the email object already contained an email, it is entirely replaced.
		*m: setfrommimesb		&& Loads an email with the MIME stored in a StringBuilder object. Note: This replaces the entire contents of the email object, including the To/CC recipients. Returns 1 for success, 0 for failure.
		*m: setfrommimetext		&& Loads an email with the contents of a .eml (i.e. MIME) contained in a string. Note: This replaces the entire contents of the email object, including the To/CC recipients. Returns 1 for success, 0 for failure.
		*m: setfromxmltext		&& Loads an email from an XML string. Note: This replaces the entire contents of the email object, including the To/CC recipients. Returns 1 for success, 0 for failure.
		*m: sethtmlbody		&& Sets the HTML body of an email.
		*m: setmbhtmlbody		&& Sets the HTML email body from a byte array containing character data in the specified character set. This method also updates the email "content-type"header to properly reflect the content type of the body.
		*m: setmbplaintextbody		&& Sets the plain-text email body from a byte array containing character data in the specified character set. This method also updates the email "content-type"header to properly reflect the content type of the body.
		*m: setrelatedfilename		&& Sets the filename for a related item within the email. Returns 1 for success, 0 for failure.
		*m: setreplacepattern		&& Create a pattern/replacement-text pair for mail-merge. When the email is sent via the MailMan's SendEmail method, or any other mail-sending method, the patterns are replaced with the replacement strings during the sending process.
		*m: setsigningcert		&& Set the certificate to be used in creating a digital signature. Use the CreateCS, CertStore, and Cert classes to create a Cert object by either locating a certificate in a certificate store or loading one from a file.
		*m: setsigningcert2		&& Explicitly sets the certificate and private key to be used for sending digitally signed email.
		*m: settextbody		&& Sets the body of the email and also sets the Content-Type header field of the contentType. If the email is already multipart/alternative, an additional alternative with the indicated Content-Type will be added.
		*m: signaturesvalid_access		&& Access method used to retrieve the Chilkat Email SignaturesValid property.
		*m: signaturesvalid_assign		&& Assign method used to hold a reference to the SignaturesValid property.
		*m: signedby_access		&& Access method used to retrieve the Chilkat Email SignedBy property.
		*m: signedby_assign		&& Assign method used to hold a reference to the SignedBy property.
		*m: signingalg_access		&& Access method used to retrieve the Chilkat Email SigningAlg property.
		*m: signingalg_assign		&& Assign method used to hold a reference to the SigningAlg property.
		*m: signinghashalg_access		&& Access method used to retrieve the Chilkat Email SigningHashAlg property.
		*m: signinghashalg_assign		&& Assign method used to hold a reference to the SigningHashAlg property.
		*m: size_access		&& Access method used to retrieve the Chilkat Email Size property.
		*m: size_assign		&& Assign method used to hold a reference to the Size property.
		*m: subject_access		&& Access method used to retrieve the Chilkat Email Subject property.
		*m: subject_assign		&& Assign method used to hold a reference to the Subject property.
		*m: todsn		&& Introduced in version 11.0.0. Creates a new Delivery Status Notification (DSN) email in the format specified by RFC 3464. The DSN email is generated in dsnEmail. Returns 1 for success, 0 for failure.
		*m: toforward		&& Introduced in version 11.0.0. Creates inline forward of this email in forward. Returns 1 for success, 0 for failure.
		*m: tomdn		&& Introduced in version 11.0.0. Creates a new MDN (Message Disposition Notification) email in message having the format as specified in RFC 3798. Returns 1 for success, 0 for failure.
		*m: toreply		&& Introduced in version 11.0.0. Generates a reply email in reply with updated header and body fields to enable sending as a reply. Note: Attachments are excluded from the reply, but attached messages are included.
		*m: uidl_access		&& Access method used to retrieve the Chilkat Email UIDL property.
		*m: uidl_assign		&& Assign method used to hold a reference to the UIDL property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat Email UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unpackhtml		&& Unpacks an HTML email into an HTML file and related files (images and style sheets). The links within the HTML are updated to point to the files unpacked and saved to disk.
		*m: unpackuserelpaths_access		&& Access method used to retrieve the Chilkat Email UnpackUserRelPaths property.
		*m: unpackuserelpaths_assign		&& Assign method used to hold a reference to the UnpackUserRelPaths property.
		*m: unspamify		&& Unobfuscates emails by undoing what spammers do to obfuscate email. It removes comments from HTML bodies and unobfuscates hyperlinked URLs.
		*m: unzipattachments		&& Unzips and replaces any Zip file attachments with the expanded contents.
		*m: usecertvault		&& Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Email VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: zipattachments		&& Replaces all the attachments of an email with a single Zip file attachment having the filename specified. Returns 1 for success, 0 for failure.
		*p: body		&& The body of the email. If the email has both HTML and plain-text bodies, this property returns the HTML body. The GetHtmlBody and GetPlainTextBody methods can be used to access a specific body.
		*p: bounceaddress		&& The "return-path" address of the email to be used when the email is sent. Bounces (i.e. delivery status notifications, or DSN's) will go to this address.
		*p: charset		&& Sets the charset for the entire email. The header fields and plain-text/HTML bodies will be converted and sent in this charset. (This includes parsing and updating the HTML with the appropriate META tag specifying the charset.)
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: decrypted		&& 1 if the email arrived encrypted and was successfully decrypted, otherwise 0. This property is only meaningful when the ReceivedEncrypted property is equal to 1.
		*p: emaildate		&& Undocumented method! See EmailDateStr property.
		*p: emaildatestr		&& The date/time from the "Date" header in the UTC/GMT timezone in RFC822 string form.
		*p: encryptedby		&& If the email was received encrypted, this contains the details of the certificate used for encryption.
		*p: filedistlist		&& Set this property to send an email to a list of recipients stored in a plain text file. The file format is simple: one recipient per line, no comments allowed, blank lines are ignored.
		*p: from		&& The combined name and email address of the sender, such as "John Smith" . This is the content that will be placed in the From: header field. If the actual sender is to be different, then set the Sender property to a different email address.
		*p: fromaddress		&& The email address of the sender.
		*p: fromname		&& The name of the sender.
		*p: header		&& The complete MIME header of the email.
		*p: language		&& A read-only property that identifies the primary language group for the email.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: localdate		&& Undocumented property! See LocalDateStr method. It is assumed that this method returns the value in a DateTime format.
		*p: localdatestr		&& The date/time found in the "Date" header field returned in the local timezone in RFC822 string form.
		*p: mailer		&& Identifies the email software that sent the email.
		*p: numalternatives		&& The number of alternative bodies present in the email. An email that is not "multipart/alternative"will return 0 alternatives. An email that is "multipart/alternative" will return a number greater than or equal to 1.
		*p: numattachedmessages		&& Returns the number of embedded emails. Some mail clients will embed an email that is to be forwarded into a new email as a "message/rfc822" subpart of the MIME message structure. This property tells how many emails have been embedded.
		*p: numattachments		&& The number of attachments contained in the email. Note: If an email is downloaded from an IMAP server without attachments, then the number of attachments should be obtained by calling the IMAP object's GetMailNumAttach method.
		*p: numbcc		&& The number of blind carbon-copy email recipients.
		*p: numcc		&& The number of carbon-copy email recipients.
		*p: numdaysold		&& Returns the number of days old from the current system date/time. The email's date is obtained from the "Date" header field. If the Date header field is missing, or invalid, then -9999 is returned.
		*p: numdigests		&& Returns the number of message/rfc822 parts contained within the multipart/digest enclosure. If no multipart/digest enclosure exists, then this property has the value of 0. The GetDigest method is called to get the Nth digest as an email object.
		*p: numheaderfields		&& The number of header fields. When accessing a header field by index, the 1st header field is at index 0, and the last is at NumHeaderFields-1. (Chilkat indexing is always 0-based.)
		*p: numrelateditems		&& The number of related items present in this email. Related items are typically image files (JPEGs or GIFs) or style sheets (CSS files) that are included with HTML formatted messages with internal "CID"hyperlinks.
		*p: numreplacepatterns		&& Returns the number of replacement patterns previously set by calling the SetReplacePattern method 1 or more times.
		*p: numreports		&& Any MIME sub-part within the email that has a Content-Type of "message/*", but is not a "message/rfc822", is considered to be a "report" and is included in this count.
		*p: numto		&& The number of direct email recipients.
		*p: oaephash		&& Selects the hash algorithm for use within OAEP padding when encrypting email using RSAES-OAEP. The valid choices are "sha1", "sha256", "sha384", "sha512"
		*p: oaepmgfhash		&& Selects the MGF hash algorithm for use within OAEP padding when encrypting email using RSAES-OAEP. The valid choices are "sha1", "sha256", "sha384", "sha512"
		*p: oaeppadding		&& Selects the RSA encryption scheme when encrypting email. The default value is 0, which selects RSAES_PKCS1-V1_5. If set to 1, then RSAES_OAEP is used.
		*p: overwriteexisting		&& When 1 (the default) the methods to save email attachments and related items will overwrite files if they already exist. If 0, then the methods that save email attachments and related items will append a string of 4 characters to create a unique filena
		*p: pkcs7cryptalg		&& When an email is sent encrypted (using PKCS7 public-key encryption), this selects the underlying symmetric encryption algorithm. Possible values are: "aes", "des", "3des", and "rc2". The default value is "aes".
		*p: pkcs7keylength		&& When the email is sent encrypted (using PKCS7 public-key encryption), this selects the key length of the underlying symmetric encryption algorithm.
		*p: preferredcharset		&& Only applies when building an email with non-English characters where the charset is not explicitly set.
		*p: prependheaders		&& If 1, then header fields added via the AddHeaderField or AddHeaderField2 methods are prepended to the top of the header as opposed to appended to the bottom. The default value is 0.
		*p: receivedencrypted		&& 1 if this email was originally received with encryption, otherwise 0.
		*p: receivedsigned		&& 1 if this email was originally received with a digital signature, otherwise 0.
		*p: replyto		&& Sets the "Reply-To" header field to the specified email address.
		*p: returnreceipt		&& Set to 1 if you want the email to request a return-receipt when received by the recipient. The default value is 0.
		*p: sendencrypted		&& Set to 1 if this email should be sent encrypted.
		*p: sender		&& The sender's address for this email message. This is the address of the actual sender acting on behalf of the author listed in the From: field.
		*p: sendsigned		&& Set to 1 if this email should be sent with a digital signature. Note: Please be aware of the Apple Mail bug explained in the web page at the link below. https://www.example-code.com/foxpro/smtp_send_signed_rsassa_pss_email.asp
		*p: signaturesvalid		&& 1 if the email was received with one or more digital signatures, and if all the signatures were validated indicating that the email was not altered. Otherwise this property is set to 0.
		*p: signedby		&& If the email was received digitally signed, this property contains the fields of the cert's SubjectDN. For example: US, 60187, Illinois, Wheaton, 1719 E Forest Ave, "Chilkat Software, Inc.", "Chilkat Software, Inc."
		*p: signingalg		&& Selects the signature algorithm to be used when sending signed (PKCS7) email. The default value is "PKCS1-v1_5". This can be set to "RSASSA-PSS" (or simply "pss") to use the RSASSA-PSS signature scheme.
		*p: signinghashalg		&& Selects the underlying hash algorithm used when sending signed (PKCS7) email. Possible values are "sha1", "sha256", "sha384", "sha512", "md5", and "md2".
		*p: size		&& The size in bytes of the email, including all parts and attachments. Note: This property is only valid if the full email was downloaded. If only the header was downloaded, then this property will contain the size of just the header.
		*p: subject		&& The email subject.
		*p: uidl		&& This is the unique ID assigned by the POP3 server. Emails can be retrieved or deleted from the POP3 server via the UIDL. The header field for this property is "X-UIDL".
		*p: uncommonoptions		&& This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: unpackuserelpaths		&& Applies to the UnpackHtml method. If 1, then relative paths are used within the HTML for the links to the related files (images and style sheets) that were unpacked to the filesystem. Otherwise absolute paths are used. The default value is 1.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		body = 
		bounceaddress = 
		cchilkatclass = Email
		charset = 
		debuglogfilepath = 
		decrypted = 0
		emaildate = ({/:})
		emaildatestr = 
		encryptedby = 
		filedistlist = 
		from = 
		fromaddress = 
		fromname = 
		header = 
		language = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		localdate = ({/:})
		localdatestr = 
		mailer = 
		Name = "email"
		numalternatives = 0
		numattachedmessages = 0
		numattachments = 0
		numbcc = 0
		numcc = 0
		numdaysold = 0
		numdigests = 0
