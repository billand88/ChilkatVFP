		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS ftp2eventhandler AS ibaseeventhandler OF "chilkatvfp.vcx" 		&& Event Handler for the ChilkatVFP object associated with the FTP2 class.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: begindownloadfile		&& Called just before a file is to be downloaded. The file can be skipped by setting the skip output-only argument equal to 1.
		*m: begindownloadfile_post		&& BeginDownloadFile post-processing method.
		*m: begindownloadfile_pre		&& BeginDownloadFile pre-processing method.
		*m: begindownloadfile_process		&& BeginDownloadFile processing method.
		*m: beginuploadfile		&& Called just prior to uploading a file. The file can be skipped by setting the skip output-only argument equal to 1.
		*m: beginuploadfile_post		&& BeginUploadFile post-processing method.
		*m: beginuploadfile_pre		&& BeginUploadFile pre-processing method.
		*m: beginuploadfile_process		&& BeginUploadFile processing method.
		*m: downloadrate		&& Called periodically with download progress information: The byteCount is the cumulative number of bytes downloaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*m: downloadrate_post		&& DownloadRate post-processing method.
		*m: downloadrate_pre		&& DownloadRate pre-processing method.
		*m: downloadrate_process		&& DownloadRate processing method.
		*m: enddownloadfile		&& Called just after a file download has completed.
		*m: enddownloadfile_post		&& EndDownloadFile post-processing method.
		*m: enddownloadfile_pre		&& EndDownloadFile pre-processing method.
		*m: enddownloadfile_process		&& EndDownloadFile processing method.
		*m: enduploadfile		&& Called just after a file upload has completed.
		*m: enduploadfile_post		&& EndUploadFile post-processing method.
		*m: enduploadfile_pre		&& EndUploadFile pre-processing method.
		*m: enduploadfile_process		&& EndUploadFile processing method.
		*m: uploadrate		&& Called periodically with upload progress information: The byteCount is the cumulative number of bytes uploaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*m: uploadrate_post		&& UploadRate post-processing method.
		*m: uploadrate_pre		&& UploadRate pre-processing method.
		*m: uploadrate_process		&& UploadRate processing method.
		*m: verifydeletedir		&& Fired just prior to recursively descending into a remote directory tree for deleting. The subtree can be skipped by setting the skip output-only argument equal to 1.
		*m: verifydeletedir_post		&& VerifyDeleteDir post-processing method.
		*m: verifydeletedir_pre		&& VerifyDeleteDir pre-processing method.
		*m: verifydeletedir_process		&& VerifyDeleteDir processing method.
		*m: verifydeletefile		&& Fired just prior to deleting a remote file. The delete can be skipped by setting the skip output-only argument equal to 1.
		*m: verifydeletefile_post		&& VerifyDeleteFile post-processing method.
		*m: verifydeletefile_pre		&& VerifyDeleteFile pre-processing method.
		*m: verifydeletefile_process		&& VerifyDeleteFile processing method.
		*m: verifydownloaddir		&& Fired just prior to recursively descending into a directory tree for downloading. The subtree can be skipped by setting the skip output-only argument equal to 1.
		*m: verifydownloaddir_post		&& VerifyDownloadDir post-processing method.
		*m: verifydownloaddir_pre		&& VerifyUploadDir pre-processing method.
		*m: verifydownloaddir_process		&& VerifyDownloadDir processing method.
		*m: verifyuploaddir		&& Fired just prior to recursively descending into a directory tree for uploading. The subtree can be skipped by setting the skip output-only argument equal to 1.
		*m: verifyuploaddir_post		&& VerifyUploadDir post-processing method.
		*m: verifyuploaddir_pre		&& VerifyUploadDir pre-processing method.
		*m: verifyuploaddir_process		&& VerifyUploadDir processing method.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "ftp2eventhandler"
	*</PropValue>
	
	PROCEDURE begindownloadfile		&& Called just before a file is to be downloaded. The file can be skipped by setting the skip output-only argument equal to 1.
		*==============================================================================
		* Method:            BeginDownloadFile
		* Purpose:           Called just before a file is to be downloaded. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file.
		*                    tiSkip, the skip setting.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** Called just before a file is to be downloaded. 
		** The file can be skipped by setting the skip output-only argument equal to 1.
		**
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		*!*  ? [BeginDownloadFile Event!]
		*!*  ? [BeginDownloadFile: Path = ] + lcPath + [, Skip = ] + STR(liSkip)
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liSkip = 0
		
		    llReturn = .BeginDownloadFile_Pre(m.lcPath, m.liSkip)
		
		    ** OK to continue test
		    IF m.liSkip = 0
		
		      llReturn = .BeginDownloadFile_Process(m.lcPath, m.liSkip)
		
		      ** OK to continue test
		      IF m.liSkip = 0
		
		        llReturn = .BeginDownloadFile_Post(m.lcPath, m.liSkip)
		
		      ENDIF m.liSkip = 0
		      ** End OK to continue test
		
		    ENDIF m.liSkip = 0
		    ** End OK to continue test
		
		  ENDIF m.liSkip = 0
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN
	ENDPROC

	PROCEDURE begindownloadfile_post		&& BeginDownloadFile post-processing method.
		*==============================================================================
		* Method:            BeginDownloadFile_Post
		* Purpose:           BeginDownloadFile post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file.
		*                    tiSkip, the skip setting.
		* Returns:           liSkip, the skip setting.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN m.liSkip
	ENDPROC

