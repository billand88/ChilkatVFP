	PROCEDURE cleardircache		&& The GetDirCount method returns the count of files and sub-directories in the current remote FTP directory, according to the ListPattern property.
		*==============================================================================
		* Method:            ClearDirCache
		* Purpose:           Clears the directory cache.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** The GetDirCount method returns the count of files 
		** and sub-directories in the current remote FTP directory, 
		** according to the ListPattern property. 
		** For example, if ListPattern is set to "*.xml", then GetDirCount 
		** returns the count of XML files in the remote directory.
		**
		** The 1st time it is accessed, the component will (behind the scenes) 
		** fetch the directory listing from the FTP server. 
		** This information is cached in the component until 
		** (1) the current remote directory is changed, or 
		** (2) the ListPattern is changed, or 
		** (3) the this method (ClearDirCache) is called.
		**
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.ClearDirCache()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

