		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE linkeddomains		&& Introduced in version 11.0.0. Extracts domain names from hyperlinks in an HTML email. Lowercase domains are appended to domains without creating duplicates. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LinkedDomains
		* Purpose:           Extracts domain names from hyperlinks in an HTML email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringTable, a Chilkat StringTable object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Extracts domain names from hyperlinks in an HTML email. 
		** Lowercase domains are appended to domains without creating duplicates.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LinkedDomains(m.loChilkatStringTable) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = ;
		      m.loParkParameterStringTable.SetObject(m.toChilkatStringTable, m.loChilkatStringTable)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE loadbodyfromfile		&& Sets the plain-text or HTML body from the contents of a file. For an HTML file, the isHtml argument should be 1 (otherwise 0).
		*==============================================================================
		* Method:            LoadBodyFromFile
		* Purpose:           Sets the plain-text or HTML body from the contents of a file. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath -- the path to the file.
		*                    tuIsHTML -- determines whether the file is in HTML format (or not).
		*                    tcCharset -- Set to 1 to make the search case sensitive.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Sets the plain-text or HTML body from the contents of a file. 
		** For an HTML file, the isHtml argument should be 1 (otherwise 0). 
		** The character encoding of the file, such as utf-8, ansi, etc. is specified by charset.
		**
		
		LPARAMETERS tcFilePath AS Character, tuIsHTML AS Unknown, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  liIsHTML = .LogicalToBit(m.tuIsHTML)
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadBodyFromFile(m.tcFilePath, m.liIsHTML, m.tcCharset) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loademl		&& Loads a complete email from a .EML file. (EML files are simply RFC822 MIME text files.) Note: This replaces the entire contents of the email object, including the To/CC recipients. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadEML
		* Purpose:           Loads a complete email from a .EML file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file to attach.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Loads a complete email from a .EML file. (EML files are simply RFC822 MIME text files.)
		**
		** Note: This replaces the entire contents of the email object, including the To/CC recipients.
		**
		** Fixed for Version 48: This method will automatically ignore the leading 
		** “From …” line that might exist if the file was an email saved in Mbox format.
		**
		** Fixed for Version 91: Fixed a crash bug (rare) when loading particular encrypted emails.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadEML(m.tcFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadtaskresult		&& Loads the email object from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadTaskResult
		* Purpose:           Loads the email object from a completed asynchronous task.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTask, a Chilkat Task object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Loads the email object from a completed asynchronous task.
		**
		** Fix for Version 58: This method always returned 0, regardless of success/failure.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatTask AS CHILKAT_TASK_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer, llImplemented AS Logical, ;
		loParkParameterTask AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask 
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTask = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTask)
		
		      loChilkatTask = m.loParkParameterTask.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadTaskResult(m.loChilkatTask) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTask = ;
		      m.loParkParameterTask.SetObject(m.toChilkatTask, m.loChilkatTask)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loParkParameterTask = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

