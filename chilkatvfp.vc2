	PROCEDURE removesignature		&& Introduced in version 9.5.0.97. Removes the authenticode signature of a Windows executable or DLL. The path to the executable/DLL is passed in path. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            RemoveSignature
		* Purpose:           Removes the authenticode signature of a Windows executable or DLL.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath -- the path to the executable/DLL.
		* Returns:           Returns the item's Content-ID if successful.
		* Date Added:        02/01/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.97
		**
		** Removes the authenticode signature of a Windows executable or DLL. 
		** The path to the executable/DLL is passed in path.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CODESIGN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		luReturn AS Unknown, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 97
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.RemoveSignature(m.tcPath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End not implemented yet test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CODESIGN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat CodeSign UncommonOptions property.
		*==============================================================================
		* Method:            UnCommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CodeSign UnCommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnCommonOptions
		* Date Added:        02/01/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.97
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty. 
		** 
		** Can be set to a list of the following comma separated keywords:
		** 
		** "codesign-allow-expired-cert" - Don't fail authenticode signature 
		** validation because the signing certificate is expired.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 97
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

