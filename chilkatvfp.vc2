	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat ZIPEntry VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        05/03/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        05/03/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS zipeventhandler AS ibaseeventhandler OF "chilkatvfp.vcx" 		&& Event Handler for the Chilkat object associated with the ZIP class.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addfilesbegin		&& Fired at the start of the AppendFiles or AppendFilesEx method.
		*m: addfilesbegin_post		&& Template AddFilesBegin post-processing method.
		*m: addfilesbegin_pre		&& Template AddFilesBegin pre-processing method.
		*m: addfilesbegin_process		&& Template AddFilesBegin processing method.
		*m: addfilesend		&& Fired at the end of the AppendFiles or AppendFilesEx method.
		*m: addfilesend_post		&& Template AddFilesEnd post-processing method.
		*m: addfilesend_pre		&& Template AddFilesEnd pre-processing method.
		*m: addfilesend_process		&& Template AddFilesEnd processing method.
		*m: dirtobeadded		&& This event fires during the AppendFiles and AppendFilesEx method calls. It is called just before each directory is to be added. The skip output-only argument may be set to 1 to prevent the directory and everything it contains from being added.
		*m: dirtobeadded_post		&& Template DirToBeAdded post-processing method.
		*m: dirtobeadded_pre		&& Template DirToBeAdded pre-processing method.
		*m: dirtobeadded_process		&& Template DirToBeAdded processing method.
		*m: fileadded		&& This event fires during the AppendFiles and AppendFilesEx method calls. It is called just after each file is added. The abort output-only argument may be set to 1 to abort the method call.
		*m: fileadded_post		&& Template FileAdded post-processing method.
		*m: fileadded_pre		&& Template FileAdded pre-processing method.
		*m: fileadded_process		&& Template FileAdded processing method.
		*m: fileunzipped		&& This event fires during method calls that unzip a zip archive. It is called just after each file is unzipped. The abort output-only argument may be set to 1 to abort the method call.
		*m: fileunzipped_post		&& Template FileUnzipped post-processing method.
		*m: fileunzipped_pre		&& Template FileUnzipped pre-processing method.
		*m: fileunzipped_process		&& Template FileUnzipped processing method.
		*m: filezipped		&& This event fires during method calls that write a zip archive. It is called just after each file is zipped. The abort output-only argument may be set to 1 to abort the method call.
		*m: filezipped_post		&& Template FileZipped post-processing method.
		*m: filezipped_pre		&& Template FileZipped pre-processing method.
		*m: filezipped_process		&& Template FileZipped processing method.
		*m: skippedforunzip		&& This event fires during method calls that unzip a zip archive. It is called for each file that was skipped for some reason (such as for when UnzipNewer or UnzipMatching is called).
		*m: skippedforunzip_post		&& Template SkippedForUnzip post-processing method.
		*m: skippedforunzip_pre		&& Template SkippedForUnzip pre-processing method.
		*m: skippedforunzip_process		&& Template SkippedForUnzip processing method.
		*m: tobeadded		&& This event fires during the AppendFiles and AppendFilesEx method calls. It is called just before each file is to be added. The skip output-only argument may be set to 1 to prevent the file from being added.
		*m: tobeadded_post		&& Template ToBeAdded post-processing method.
		*m: tobeadded_pre		&& Template ToBeAdded pre-processing method.
		*m: tobeadded_process		&& Template ToBeAdded processing method.
		*m: tobeunzipped		&& This event fires during method calls that unzip a zip archive. It is called just before each file is unzipped. The skip output-only argument may be set to 1 to prevent the file from being unzipped.
		*m: tobeunzipped_post		&& Template ToBeUnzipped post-processing method.
		*m: tobeunzipped_pre		&& Template ToBeUnzipped pre-processing method.
		*m: tobeunzipped_process		&& Template ToBeUnzipped processing method.
		*m: tobezipped		&& This event fires during method calls that create a zip archive. It is called just before each file is to be zipped. The skip output-only argument may be set to 1 to prevent the file from being zipped.
		*m: tobezipped_post		&& Template ToBeZipped post-processing method.
		*m: tobezipped_pre		&& Template ToBeZipped pre-processing method.
		*m: tobezipped_process		&& Template ToBeZipped processing method.
		*m: unzipbegin		&& To be documented soon...
		*m: unzipbegin_post		&& Template UnzipBegin post-processing method.
		*m: unzipbegin_pre		&& Template UnzipBegin pre-processing method.
		*m: unzipbegin_process		&& Template UnzipBegin processing method.
		*m: unzipend		&& Fired when finished unzipping.
		*m: unzipend_post		&& Template UnzipEnd post-processing method.
		*m: unzipend_pre		&& Template UnzipEnd pre-processing method.
		*m: unzipend_process		&& Template UnzipEnd processing method.
		*m: writezipbegin		&& Fired when starting to write a zip.
		*m: writezipbegin_post		&& Template WriteZipBegin post-processing method.
		*m: writezipbegin_pre		&& Template WriteZipBegin pre-processing method.
		*m: writezipbegin_process		&& Template WriteZipBegin processing method.
		*m: writezipend		&& Fired when finished writing a zip.
		*m: writezipend_post		&& Template WriteZipEnd post-processing method.
		*m: writezipend_pre		&& Template WriteZipEnd pre-processing method.
		*m: writezipend_process		&& Template WriteZipEnd processing method.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "zipeventhandler"
	*</PropValue>
	
	PROCEDURE addfilesbegin		&& Fired at the start of the AppendFiles or AppendFilesEx method.
		*==============================================================================
		* Method:            AddFilesBegin
		* Purpose:           Fired at the end of the AppendFiles or AppendFilesEx method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** Fired at the end of the AppendFiles or AppendFilesEx method.
		**
		
		LOCAL llReturn AS Logical
		
		llReturn = .T.
		
		*!*  ? [AddFilesBegin Event!]
		
		WITH THIS
		
		  llReturn = .AddFilesBegin_Pre()
		
		  ** OK to continue test
		  IF m.llReturn
		
		    llReturn = .AddFilesBegin_Process()
		
		    ** OK to continue test
		    IF m.llReturn
		
		      llReturn = .AddFilesBegin_Post()
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		RETURN
	ENDPROC

