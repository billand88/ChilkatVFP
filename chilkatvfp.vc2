	PROCEDURE compressfile		&& Performs file-to-file compression. Files of any size may be compressed because the file is compressed internally in streaming mode. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CompressFile
		* Purpose:           Performs file-to-file compression.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSourceFilePath, the path to the source file.
		*                    tcDestinationFilePath, the path to the compressed file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Performs file-to-file compression. Files of any size may be compressed 
		** because the file is compressed internally in streaming mode.
		**
		** Fixes for version 59: Fixed this method for large files. 
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSourceFilePath AS Character, tcDestinationFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CompressFile(m.tcSourceFilePath, ;
		      m.tcDestinationFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

