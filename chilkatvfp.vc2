		      ENDTRY
		
		      toChilkatXmlCertVault = ;
		      m.loParkParameterXmlCertVault.SetObject(m.toChilkatXmlCertVault, m.loChilkatXmlCertVault)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JAVAKEYSTORE_COM_CALL)
		  toChilkatXMLCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loParkParameterXmlCertVault = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXmlCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat JavaKeyStore VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/21/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/21/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 44
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verifykeyeddigest_access		&& Access method used to retrieve the Chilkat JavaKeyStore VerifyKeyedDigest property.
		*==============================================================================
		* Method:            VerifyKeyedDigest_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat JavaKeyStore VerifyKeyedDigest property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerifyKeyedDigest
		* Date Added:        07/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** If 1, then the keystore's keyed digest is required to pass validation (password required) 
		** for any of the load methods (such as LoadFile, LoadBinary, or LoadEncoded). 
		** If 0, then a keystore may be loaded into memory without password validation 
		** (if a null or empty string is passed to the load method). 
		** The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 44
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE verifykeyeddigest_assign		&& Assign method used to hold a reference to the VerifyKeyedDigest property.
		*==============================================================================
		* Method:            VerifyKeyedDigest_Assign
		* Purpose:           Assign method used to hold a reference to the VerifyKeyedDigest property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the VerifyKeyedDigest property.
		* Returns:           
		* Date Added:        07/21/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 44
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS js AS ibasechilkat OF "chilkatvfp.vcx" 		&& Chilkat.Js is a small, embeddable JavaScript engine. It executes JavaScript code inside an application without requiring a browser or large runtime like Node.js. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: callfunction		&& Introduced in version 11.4.0. Calls a JavaScript function. The function name and arguments are passed in func. The result is returned in result. Returns 1 for success, 0 for failure.
		*m: callfunctionasync		&& Introduced in version 11.4.0. Creates an asynchronous task to call the CallFunction method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: consoleoutputsb		&& Introduced in version 11.4.0. Returns the console output in sb from the last call to Eval .
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Js DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: eval		&& Introduced in version 11.4.0. Run jscript as a script. Return output and errors in result. Returns 1 for success, 0 for failure.
		*m: evalasync		&& Introduced in version 11.4.0. Creates an asynchronous task to call the Eval method with the arguments provided.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Js LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Js LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Js LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Js LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Js LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Js LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Js LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: setckpermission		&& Introduced in version 11.4.0. Sets sandbox related permissions for Chilkat objects. The chilkatClassName is the name of the Chilkat class (case-insensitive), such as Http, Rest, "MailMan", "Ftp2", "Ssh", etc.
		*m: timeoutseconds_access		&& Access method used to retrieve the Chilkat Js TimeoutSeconds property.
		*m: timeoutseconds_assign		&& Assign method used to hold a reference to the TimeoutSeconds property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Js VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& This property is mainly used in SQL Server stored procedures to retrieve binary data from the last method call that returned binary data. It is only accessible if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides HTML-formatted information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lasterrortext		&& Provides plain text information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lasterrorxml		&& Provides XML-formatted information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lastmethodsuccess		&& Indicates the success or failure of the most recent method call: 1 means success, 0 means failure. This property remains unchanged by property setters or getters.
		*p: laststringresult		&& In SQL Server stored procedures, this property holds the string return value of the most recent method call that returns a string. It is accessible only when Chilkat.Global.KeepStringResult is set to TRUE.
		*p: laststringresultlen		&& The length, in characters, of the string contained in the LastStringResult property.
		*p: timeoutseconds		&& Introduced in version 11.4.0. Specify a timeout in seconds to prevent JavaScript from running indefinitely, such as in an infinite loop. By default, the value is 0, meaning no timeout is set and infinite loops will continue forever.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Js
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		iinstancemajor = 11
		iinstanceminor = 4
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 0
		laststringresult = 
		laststringresultlen = 0
		Name = "js"
		timeoutseconds = 0
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE callfunction		&& Introduced in version 11.4.0. Calls a JavaScript function. The function name and arguments are passed in func. The result is returned in result. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CallFunction
		* Purpose:           Calls a JavaScript function.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObjectIn, a Chilkat JsonObject object.
		*                    toChilkatJsonObjectOut, a Chilkat JsonObject object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/07/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0.
		**
		** Calls a JavaScript function. The function name and arguments are passed in func. 
		** The result is returned in result.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJsonObjectIn AS [Chilkat.JsonObect], toChilkatJsonObjectOut AS [Chilkat.JsonObect]
		
		LOCAL loChilkatObject AS [Chilkat.Js], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJsonObjectIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectIn AS [Chilkat.JsonObect], liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterJsonObjectOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectOut AS [Chilkat.JsonObect]
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectIn, m.loChilkatJsonObjectIn, ;
		m.loParkParameterJsonObjectOut, m.loChilkatJsonObjectOut
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObjectIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatJsonObjectIn)
		
		      loChilkatJsonObjectIn = m.loParkParameterJsonObjectIn.GetObject()
		
		      loParkParameterJsonObjectOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatJsonObjectOut)
		
		      loChilkatJsonObjectOut = m.loParkParameterJsonObjectOut.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CallFunction(m.loChilkatJsonObjectIn, m.loChilkatJsonObjectOut) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObjectIn = ;
		      m.loParkParameterJsonObjectIn.SetObject(m.oChilkatJsonObjectIn, m.loChilkatJsonObjectIn)
		
		      toChilkatJsonObjectOut = ;
		      m.loParkParameterJsonObjectOut.SetObject(m.oChilkatJsonObjectOut, m.loChilkatJsonObjectOut)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObjectIn, m.loChilkatJsonObjectIn, ;
		m.loParkParameterJsonObjectOut, m.loChilkatJsonObjectOut
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Js])
		  toChilkatJsonObjectIn = NEWOBJECT([Chilkat.JsonObect])
		  loParkParameterJsonObjectIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectIn = NEWOBJECT([Chilkat.JsonObect])
		  toChilkatJsonObjectOut = NEWOBJECT([Chilkat.JsonObect])
		  loParkParameterJsonObjectOut = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectOut = NEWOBJECT([Chilkat.JsonObect])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE callfunctionasync		&& Introduced in version 11.4.0. Creates an asynchronous task to call the CallFunction method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            CallFunctionAsync
		* Purpose:           Creates an asynchronous task to call the CallFunction 
		*                    method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObjectIn, a Chilkat JsonObject object.
		*                    toChilkatJsonObjectOut, a Chilkat JsonObject object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/07/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0.
		**
		** Creates an asynchronous task to call the CallFunction method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatJsonObjectIn AS [Chilkat.JsonObect], toChilkatJsonObjectOut AS [Chilkat.JsonObect]
		
		LOCAL loChilkatObject AS [Chilkat.Js], loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS [Chilkat.Task], ;
		loParkParameterJsonObjectIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectIn AS [Chilkat.JsonObject], ;
		loParkParameterJsonObjectOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObjectOut AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterJsonObjectIn, m.loChilkatJsonObjectIn, ;
		m.loParkParameterJsonObjectOut, m.loChilkatJsonObjectOut
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObjectIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectIn)
		
		      loChilkatJsonObjectIn = m.loParkParameterJsonObjectIn.GetObject()
		
		      loParkParameterJsonObjectOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObjectOut)
		
		      loChilkatJsonObjectOut = m.loParkParameterJsonObjectOut.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.CallFunctionAsync(m.loChilkatJsonObjectIn, m.loChilkatJsonObjectOut)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObjectIn = ;
		      m.loParkParameterJsonObjectIn.SetObject(m.toChilkatJsonObjectIn, m.loChilkatJsonObjectIn)
		
		      toChilkatJsonObjectOut = ;
		      m.loParkParameterJsonObjectOut.SetObject(m.toChilkatJsonObjectOut, m.loChilkatJsonObjectOut)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJsonObjectIn, ;
		m.loChilkatJsonObjectIn, m.loParkParameterJsonObjectOut, m.loChilkatJsonObjectOut
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Js])
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		  toChilkatJsonObjectIn = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectIn = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJsonObjectOut = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObjectOut = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObjectOut = NEWOBJECT([Chilkat.JsonObject])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE consoleoutputsb		&& Introduced in version 11.4.0. Returns the console output in sb from the last call to Eval .
		*==============================================================================
		* Method:            ConsoleOutputSb
		* Purpose:           Returns the function calls in json if the output contains any. 
