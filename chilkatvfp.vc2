		llImplemented AS Logical, loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE 0 TO m.liMD5Header, m.liGZip, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liMD5Header = .LogicalToBit(m.tuMD5Header)
		      liGZip = .LogicalToBit(m.tuGZip)
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.PFileAsync(m.tcVerb, ;
		        m.tcURL, m.tcLocalFilePath, m.tcContentType, m.liMD5Header, m.liGZip)
		
		      CATCH TO m.loException
		
		       .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE postbinary		&& Sends an HTTP POST request to the url. The body of the HTTP request contains the bytes passed in byteData. The contentType is a content type such as "image/gif", "application/pdf", etc.
		*==============================================================================
		* Method:            PostBinary
		* Purpose:           Sends an HTTP POST request to the url.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL, the URL to receive the request. 
		*                    tqBinData, the HTTP body request.
		*                    tcContentType, the content type of the request.
		*                    tuMD5Header, set to 1 to add MD5 header to tqBinData.
		*                    tuGZip, set to 1 if tqBinData is gZip compressed.
		* Returns:           Character
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Sends an HTTP POST request to the url. 
		** The body of the HTTP request contains the bytes passed in byteData. 
		** The contentType is a content type such as "image/gif", "application/pdf", etc. 
		** If md5 is 1, then a Content-MD5 header is added with the base64 MD5 hash of the byteData. 
		** Servers aware of the Content-MD5 header 
		** will perform a message integrity check to ensure that the data has not been corrupted. 
		** If gzip is 1, the byteData is compressed using the gzip algorithm. 
		** The HTTP request body will contain the GZIP compressed data, 
		** and a "Content-Encoding: gzip" header is automatically added 
		** to indicate that the request data needs to be ungzipped when received (at the server).
		**
		** Returns the text body of the HTTP response if the HTTP response has a success status code. 
		** Otherwise the method is considered to have failed. 
		** If more details of the HTTP response are required, 
		** call PBinary instead (which returns the HTTP response object).
		**
		** Note: The HTTP response code is available in the LastStatus property. 
		** Other properties having information include LastResponseHeader, LastResponseBody, 
		** LastModDate, LastContentType, etc.
		**
		** Enhancement for Version 40: For POST and PUT requests, ensures that 
		** a Content-Length header is always added even if the content length is 0.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcURL AS Character, tqBinData AS Variant, ;
		tcContentType AS Character, tuMD5Header AS Unknown, tuGZip AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liMD5Header AS Integer, liGZip AS Integer, lcTextBody AS Character
		
		STORE 0 TO m.liMD5Header, m.liGZip 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcTextBody = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liMD5Header = .LogicalToBit(m.tuMD5Header)
		    liGZip = .LogicalToBit(m.tuGZip)
		
		    TRY
		
		      lcTextBody = m.loChilkatObject.PostBinary(m.tcURL, ;
		      m.tqBinData, m.tcContentType, m.liMD5Header, m.liGZip)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcTextBody
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE postbinaryasync		&& Creates an asynchronous task to call the PostBinary method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            PostBinaryAsync
