	PROCEDURE findemail		&& Introduced in version 11.0.0. Returns the first email from the bundle that matches the search criteria specified in json.
		*==============================================================================
		* Method:            FindEmail
		* Purpose:           Returns the first email from the bundle 
		*                    that matches the search criteria specified in json. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject -- a Chilkat JSON object.
		*                    toChilkatEmail -- a Chilkat EMail object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** The Nth embedded "message/rfc822" subpart in email.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAILBUNDLE_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject, ;
		m.loParkParameterEmail, m.loChilkatEmail  
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJSONObject.GetObject()
		
		      loParkParameterEmail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FindEmail(m.loChilkatJSONObject, m.loChilkatEmail) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getemail		&& Returns the Nth Email in the bundle. The email returned is a copy of the email in the bundle. Updating the email object returned by GetEmail has no effect on the email within the bundle.
		*==============================================================================
		* Method:            GetEmail
		* Purpose:           Returns the Nth Email in the bundle.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the email array index value.
		* Returns:           The Chilkat Email object.
		* Date Added:        06/14/2022
		*==============================================================================
		
		**
		** Returns the Nth Email in the bundle. 
		** The email returned is a copy of the email in the bundle. 
		** Updating the email object returned by GetEmail 
		** has no effect on the email within the bundle. 
		** To update/replace the email in the bundle, your program should call GetEmail 
		** to get a copy, make modifications, call RemoveEmailByIndex to remove the email 
		** (passing the same index used in the call to GetEmail), and then call AddEmail 
		** to insert the new/modified email into the bundle.
		** 
		** IMPORTANT: This method does NOT communicate with any mail server 
		** to download the email. It simply returns the Nth email object that exists 
		** within it's in-memory collection of email objects.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAILBUNDLE_COM_CALL, ;
		loException AS Exception, loChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatEmail = m.loChilkatObject.GetEmail(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmail
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getuidls		&& Returns a StringArray object containing UIDLs for all Email objects in the bundle. UIDLs are only valid for emails retrieved from POP3 servers. An email on a POP3 server has a "UIDL", an email on IMAP servers has a "UID".
		*==============================================================================
