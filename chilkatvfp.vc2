	PROCEDURE downloadhash		&& Retrieves the content at a URL and computes and returns a hash of the content.
		*==============================================================================
		* Method:            DownloadHash
		* Purpose:           Retrieves the content at a URL and computes and returns a hash of the content.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL content to retrieve
		*                    tcHashAlgorithm -- the hash algorithm to use
		*                    tcEncoding -- return value in Base64 encoded format.
		* Returns:           Character
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** Retrieves the content at a URL and computes and returns a hash of the content. 
		** The hash is returned as an encoded string according to the encoding, 
		** which may be "Base64", "modBase64", "Base32", "UU", "QP" (for quoted-printable), 
		** "URL" (for url-encoding), "Hex", "Q", "B", "url_oath", "url_rfc1738", "url_rfc2396", 
		** and "url_rfc3986". 
		** The hashAlgorithm may be "sha1", "sha256", "sha384", "sha512", "md2", 
		** "md5", "haval", "ripemd128", "ripemd160","ripemd256", or "ripemd320".
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character, tcHashAlgorithm AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, lcHash AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcHash = m.loChilkatObject.DownloadHash(m.tcURL, m.tcHashAlgorithm, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHash
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

