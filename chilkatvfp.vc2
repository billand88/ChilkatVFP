	PROCEDURE sendbundle		&& Sends a bundle of emails. This is identical to calling SendEmail for each email in the bundle.
		*==============================================================================
		* Method:            SendBundle
		* Purpose:           Sends a bundle of emails. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmailBundle, a Chilkat Email Bundle object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Sends a bundle of emails. This is identical to calling SendEmail for each email in the bundle.
		** 
		** If an error occurs when sending one of the emails in the bundle, 
		** it will continue with each subsequent email until each email in the bundle has been attempted 
		** (unless a fatal error occurs, in which case the send is aborted).
		**
		** Because it is difficult or impossible to programmatically identify 
		** which emails in the bundle failed and which succeeded, 
		** it is best to write a loop that sends each email separately (via the SendEmail method).
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		loParkParameterEmailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmailBundle, m.loChilkatEmailBundle
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmailBundle = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmailBundle)
		
		    loChilkatEmailBundle = m.loParkParameterEmailBundle.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SendBundle(m.loChilkatEmailBundle) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmailBundle = m.loParkParameterEmailBundle.SetObject(;
		    m.toChilkatEmailBundle, m.loChilkatEmailBundle)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmailBundle, m.loChilkatEmailBundle
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterEmailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendbundleasync		&& Creates an asynchronous task to call the SendBundle method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SendBundleAsync
		* Purpose:           Creates an asynchronous task to call 
		**                   the SendBundle method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmailBundle, an Chilkat Email Bundle object.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the SendBundle method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS toChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterEmailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterEmailBundle, m.loChilkatEmailBundle
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterEmailBundle = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmailBundle)
		
		      loChilkatEmailBundle = m.loParkParameterEmailBundle.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.SendBundleAsync(m.loChilkatEmailBundle)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmailBundle = m.loParkParameterEmailBundle.SetObject(;
		      m.toChilkatEmailBundle, m.loChilkatEmailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmailBundle, m.loChilkatEmailBundle
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterEmailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendemail		&& Sends a single email. The connection to the SMTP server will remain open so that a subsequent call to SendEmail (or other email-sending methods) can re-use the same connection.
		*==============================================================================
		* Method:            SendEmail
		* Purpose:           Sends a single email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Sends a single email. The connection to the SMTP server will remain open so that 
		** a subsequent call to SendEmail (or other email-sending methods) can re-use the same connection. 
		** If any properties relating to the SMTP server are changed, 
		** such as SmtpHost, SmtpUsername, etc., then the next call to an email-sending 
		** method will automatically close the connection 
		** and re-establish a connection using the updated property settings.
		**
		** Important: Some SMTP servers do not actually send the email until the connection is closed. 
		** In these cases, it is necessary to call CloseSmtpConnection for the mail to be sent. 
		** Most SMTP servers send the email immediately, and it is not required to close the connection.
		**
		** GMail: If sending via smtp.gmail.com, then send with OAuth2 authentication if possible. 
		** Otherwise you will need to change your GMail account settings to allow for sending by less secure apps. 
		** See the links below.
		**
		** Note: After sending email, information about what transpired is available via the LastJsonData method.
		**
		** Fixed for Version 40: This method when the email object’s FileDistList property is used.
		**
		** Fixed for Version 48: Fixed problem when setting the Email.FileDistList equal to the empty string 
		** (which should simply clear the property, but instead cause an error in the call to this method).
		**
		** Fixed for Version 77: If the connection is idle for 1 minute or more, the next email sent 
		** will automatically use a fresh connection. (When a method to send email is called, 
		** such as SendEmail, the connection is kept open for the possibility that another call 
		** to this method can use the same open connection. 
		** Quite often, the server disconnects from an idle connection and the next call to this method fails. 
		** This new behavior eliminates this possibility (for the most part). 
		** Applications can always explicitly close the SMTP connection by calling CloseSmtpConnection.)
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], liReturn AS Integer, ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SendEmail(m.loChilkatEmail) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendemailasync		&& Creates an asynchronous task to call the SendEmail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SendEmailAsync
		* Purpose:           Creates an asynchronous task to call 
		**                   the SendBundle method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, an Chilkat Email object.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the SendEmail method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Fixed for Version 77: If the connection is idle for 1 minute or more, the next email sent 
		** will automatically use a fresh connection. (When a method to send email is called, 
		** such as SendEmail, the connection is kept open for the possibility that another call 
		** to this method can use the same open connection. 
		** Quite often, the server disconnects from an idle connection and the next call to this method fails. 
		** This new behavior eliminates this possibility (for the most part). 
		** Applications can always explicitly close the SMTP connection by calling CloseSmtpConnection.)
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatTask, m.loParkParameterEmail, m.loChilkatEmail
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterEmail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.SendEmailAsync(m.loChilkatEmail)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE sendindividual_access		&& Access method used to retrieve a reference to the SendIndividual property.
		*==============================================================================
		* Method:            SendIndividual_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan SendIndividual property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SendIndividual
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** Determines how emails are sent to distribution lists. 
		** If 1, emails are sent to each recipient in the list one at a time, 
		** with the "To"header field containing the email address of the recipient. 
		** If 0, emails will contain in the "To"header field, 
		** and are sent to 100 BCC recipients at a time. 
		** As an example, if your distribution list contained 350 email addresses, 
		** 4 emails would be sent, the first 3 having 100 BCC recipients, 
		** and the last email with 50 BCC recipients. The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sendindividual_assign		&& Assign method used to hold a reference to the SendIndividual property.
		*==============================================================================
		* Method:            SendIndividual_Assign
		* Purpose:           Assign method used to hold a reference to the SendIndividual property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value used 
		*                    to hold a reference to the SendIndividual property.
		* Returns:           
		* Date Added:        01/13/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE sendmime		&& Provides complete control over the email that is sent. The MIME text passed in mimeSource (the MIME source of an email) is passed exactly as-is to the SMTP server.
		*==============================================================================
		* Method:            SendMIME
		* Purpose:           Provides complete control over the email that is sent.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFromAddress -- the From: email address.
		*                    tcRecipients -- the comma separated list of recipient email addresses. 
		*                    tcMIMESource -- the email MIME source.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Provides complete control over the email that is sent. 
		** The MIME text passed in mimeSource (the MIME source of an email) 
		** is passed exactly as-is to the SMTP server. 
		** The recipients is a comma separated list of recipient email addresses. 
		** The fromAddr is the reverse-path email address. 
		** This is where bounced email (non-delivery reports) will be delivered. 
		** It may be different than the "From" header field in the mimeSource.
		**
		** To understand how the fromAddr and recipients relate to the email addresses 
		** found in the MIME headers (FROM, TO, CC), see the link below entitled "SMTP Protocol in a Nutshell". 
		** The fromAddr is what is passed to the SMTP server in the "MAIL FROM" command. 
		** The recipients are the email addresses passed in "RCPT TO" commands. 
		** These are usually the same email addresses found in the MIME headers, 
		** but need not be (unless the SMTP server enforces policies that require them to be the same).
		**
		** Returns 1 for success, 0 for failure.
		**
		
		** Question:
		**
		** SendMime requires a from and recipients address string, but the MIME message contains both. 
		** The message I receive from the SendMime seems to ignore the addresses in the call 
		** and uses the one in the MIME. So why require a from and recipient address?
		**
		** Answer:
		**
		** The SMTP protocol works like this:
		**
		** 1) A client connects to an SMTP server.
		**
		** 2) The SMTP server says “hello”
		**
		** 3) The client authenticates (if necessary) by logging in.
		**
		** 4) Now it’s time to send an email. 
		**    First, the client sends a “MAIL FROM” command with the email address that is the reverse-path. 
		**    This is the email address that would receive a bounce or delivery status notification.
		**
		** 5) The client then sends one or more “RCPT TO” commands, each with a recipient email address. 
		**    It doesn’t matter if the recipient is a “To” , “CC”, or “BCC”, 
		**    all recipient email addresses are passed to the SMTP server via “RCPT TO” commands.
		**
		** 6) Finally, the MIME source of the email is sent with a “DATA” command. 
		**    Note: The MIME source has header fields for “From”, “To”, and “CC”. 
		**    These are the email addresses that will be seen by the receiver of the email. 
		**    The actual recipients are the email addresses passed via the RCPT TO commands. 
		**    It’s possible to create an email such that the “To” header field 
		**    contains “santa.claus@northpole.com”, but you pass actual email addresses in the RCPT TO commands. 
		**    The person receiving such an email (if not filtered as SPAM) 
		**    would scratch his/her head and wonder why he/she received an email addressed to Santa Claus.
		**
		**    The Chilkat mailman’s SendMime method has these arguments: 
		**    From, CommaSeparatedRcptToEmailAddresses, MimeSource. 
		**    Given the above explanation, it should be obvious how these arguments are used in sending the email…
		**
		
		LPARAMETERS tcFromAddress AS Character, tcRecipients AS Character, tcMIMESource AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SendMIME(m.tcFromAddress, m.tcRecipients, m.tcMIMESource) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendmimeasync		&& Creates an asynchronous task to call the SendMime method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
