		  toChilkatJSONPrivateAttrs = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatJSONOut = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatPublicKey  = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loChilkatJSONPublicAttrs = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatJSONPrivateAttrs = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
