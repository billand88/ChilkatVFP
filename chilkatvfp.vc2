	PROCEDURE connect		&& Introduced in version 9.5.0.58. Establishes an initial connection to a REST server. The hostname can be a domain name or an IP address. Both IPv4 and IPv6 addresses are supported. The port is the port, which is typically 80 or 443.
		*==============================================================================
		* Method:            Connect
		* Purpose:           Establishes an initial connection to a REST server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHostName, the query string to add.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Establishes an initial connection to a REST server. 
		** The hostname can be a domain name or an IP address. 
		** Both IPv4 and IPv6 addresses are supported. 
		** The port is the port, which is typically 80 or 443. 
		** If SSL/TLS is required, then tls should be set to 1. 
		** The autoReconnect indicates whether connection should automatically 
		** be established as needed for subsequent REST requests.
		** 
		** Note: This method is for simple connections 
		** that do not require any proxies (HTTP or SOCKS), or SSH tunneling. 
		** If a proxy, SSH tunnel, or any other advanced socket feature is required, 
		** the Chilkat Socket API can be used to establish the connection. 
		** The UseConnection method can then be called to use the pre-established socket connection.
		** 
		** IMPORTANT: The hostname argument should be just the domain or IP address. 
		** It is NOT the full URL. If your URL is "https://www.example.com/something/123", 
		** then pass "www.example.com" in the 1st argument.
		**
		** Enhancement for version 76: re-use the TLS connection if the subsequent call 
		** to this method is to the same domain/host. (This speeds up the TLS handshake.)
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHostName AS Character, tiPort AS Integer, ;
		tuTLS AS Unknown, tuAutoReconnect AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		luReturn AS Unknown, liTLS AS Integer, liAutoReconnect AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liTLS, m.liAutoReconnect, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liTLS = .LogicalToBit(m.tuTLS)
		      liAutoReconnect = .LogicalToBit(m.tuAutoReconnect)
		
		      TRY
		
		        STORE m.loChilkatObject.Connect(m.tcHostName, ;
		        m.tiPort, m.liTLS, m.liAutoReconnect) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE connectasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            ConnectAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    Connect method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHostName, the query string to add.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        06/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Creates an asynchronous task to call the Connect method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Enhancement for version 76: re-use the TLS connection if the subsequent call 
		** to this method is to the same domain/host. (This speeds up the TLS handshake.)
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHostName AS Character, tiPort AS Integer, ;
		tuTLS AS Unknown, tuAutoReconnect AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		liTLS AS Integer, liAutoReconnect AS Integer
		
		STORE 0 TO m.liTLS, m.liAutoReconnect, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liTLS = .LogicalToBit(m.tuTLS)
		      liAutoReconnect = .LogicalToBit(m.tuAutoReconnect)
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.ConnectAsync(;
		        m.tcHostName, m.tiPort, m.liTLS, m.liAutoReconnect)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE connectfailreason_access		&& Access method used to retrieve the Chilkat Rest ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Rest ConnectFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectFailReason
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** This property will be set to the status of the last connection made 
		** (or failed to be made) by any method.
		**
		** Possible values are:
		** 
		** 0 = success
		** 
		** Normal (non-TLS) sockets:
		** 1 = empty hostname
		** 2 = DNS lookup failed
		** 3 = DNS timeout
		** 4 = Aborted by application.
		** 5 = Internal failure.
		** 6 = Connect Timed Out
		** 7 = Connect Rejected (or failed for some other reason)
		** 99 = Chilkat not unlocked / trial expired.
		
		** 
		** SSL/TLS:
		** 100 = TLS internal error.
		** 101 = Failed to send client hello.
		** 102 = Unexpected handshake message.
		** 103 = Failed to read server hello.
		** 104 = No server certificate.
		** 105 = Unexpected TLS protocol version.
		** 106 = Server certificate verify failed 
		** (the server certificate is expired or the cert's signature verification failed).
		** 107 = Unacceptable TLS protocol version.
		** 109 = Failed to read handshake messages.
		** 110 = Failed to send client certificate handshake message.
		** 111 = Failed to send client key exchange handshake message.
		** 112 = Client certificate's private key not accessible.
		** 113 = Failed to send client cert verify handshake message.
		** 114 = Failed to send change cipher spec handshake message.
		** 115 = Failed to send finished handshake message.
		** 116 = Server's Finished message is invalid.
		** 125 = TLS Pin Set Mismatch. (Added in version 78)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Assign
		* Purpose:           Assign method used to hold 
		*                    the ConnectFailReason property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ConnectFailReason property.
		* Returns:           
		* Date Added:        06/05/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE connecttimeoutms_access		&& Access method used to retrieve the Chilkat Rest ConnectTimeoutMs property.
		*==============================================================================
		* Method:            ConnectTimeoutMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Rest ConnectTimeoutMs property.
		* Author:            Bill Anderson
