	PROCEDURE loaded25519		&& Introduced in version 9.5.0.83. Loads the private key object with an ed25519 key pair. The privKey is the 32-byte private key as a hex string. The pubKey is the 32-byte public key as a hex string.
		*==============================================================================
		* Method:            LoadEd25519
		* Purpose:           Loads the private key object with an ed25519 key pair.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPrivateKey, the private key.
		*                    tcPublicKey, the public key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Loads the private key object with an ed25519 key pair. 
		** The privKey is the 32-byte private key as a hex string. 
		** The pubKey is the 32-byte public key as a hex string. 
		** pubKey may be an empty string, in which case 
		** the public key is automatically computed from the private key.
		** 
		** Returns 1 for success, 0 for failure.
		**
		** Fixed for version 11.6.0: Ed25519 DER/PEM export now uses the correct OID 1.3.101.112 
		** (was sometimes the X25519 OID 1.3.101.110).
		**
		
		LPARAMETERS tcPrivateKey AS Character, tcPublicKey AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadEd25519(m.tcPrivateKey, m.tcPublicKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.luReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadencryptedpem		&& Loads the private key from an in-memory encrypted PEM string
		*==============================================================================
		* Method:            LoadEncryptedPEM
		* Purpose:           Loads the private key from an in-memory encrypted PEM string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMString, the encrypted PEM string.
		*                    tcPassword, the password to load.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Loads the private key from an in-memory encrypted PEM string. 
		** An encrypted PEM contains the private key in encrypted PKCS#8 format, 
		** where the data begins and ends with the following tags:
		** 
		**   -----BEGIN ENCRYPTED PRIVATE KEY-----
		**   BASE64 ENCODED DATA
		**   -----END ENCRYPTED PRIVATE KEY-----
		** 
		** For those requiring a deeper understanding: 
		** The base64 data contains ASN.1 DER with the following structure:
		**   
		**   EncryptedPrivateKeyInfo ::= SEQUENCE {
		**     encryptionAlgorithm  EncryptionAlgorithmIdentifier,
		**     encryptedData        EncryptedData
		**   }
		**   
		**   EncryptionAlgorithmIdentifier ::= AlgorithmIdentifier
		** 
		**   EncryptedData ::= OCTET STRING
		** 
		** Note: Each of the private key Load* methods willl auto-recognize 
		** the content and will parse appropriately. The private key should be successfully 
		** loaded even when the wrong format data is passed to the wrong method.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPEMString AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadEncryptedPEM(m.tcPEMString, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.luReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

