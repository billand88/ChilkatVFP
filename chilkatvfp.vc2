	PROCEDURE findcert		&& Introduced in version 9.5.0.88. Finds the certificate where the given certPart equals the partValue. Possible values for certPart are: "privateKey", "subjectDN", "subjectDN_withTags", "subjectCN", "serial", or "serial:issuerCN".
		*==============================================================================
		* Method:            FindCert
		* Purpose:           Finds the certificate where the given certPart equals the partValue.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCertificatePart, the certificate part to find.
		*                    tcCertificatePartValue, the certificate part value to find.
		*                    toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		**
		** Finds the certificate where the given certPart equals the partValue. 
		** Possible values for certPart are: "privateKey", "subjectDN", "subjectDN_withTags", 
		** "subjectCN", "serial", or "serial:issuerCN". If certPart equals "privateKey", 
		** then pass an empty string in partValue. 
		** Specifying "privateKey" means to return the first certificate having a private key.
		** 
		** The cert is loaded with the certificate if successful.
		** 
		** Important: Private keys will not be seen unless the PKCS11 session is authenticated. 
		** To authenticate, your application must call Login after calling OpenSession.
		** 
		** Note: If successful, the cert will be linked internally with this PKCS11 session 
		** such that certificate can be used for signing on the smart card 
		** when used in other Chilkat classes such as XmlDSigGen, Pdf, Crypt2, Mime, MailMan, etc.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCertificatePart AS Character, tcCertificatePartValue AS Character, ;
		toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		oParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert 
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FindCert(m.tcCertificatePart, ;
		        m.tcCertificatePartValue, m.loChilkatCert) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE findobject		&& Introduced in version 9.5.0.96. General function for finding an object such as a private key. Returns the handle of the first matching object, or 0 if not found.
		*==============================================================================
		* Method:            FindObject
		* Purpose:           General function for finding an object such as a private key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		** 
		** General function for finding an object such as a private key. 
		** Returns the handle of the first matching object, or 0 if not found.
		**
		** Enhancement in version 99: Internally, 
		** Chilkat increased the max number for FindObjects from 512 to 8192.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
