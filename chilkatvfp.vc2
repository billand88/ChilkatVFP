	PROCEDURE fetchfull		&& Introduced in version 11.0.0. If a partial email (header-only) was retrieved, this method will download and return the full email from the server using the partial email as an argument. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FetchFull
		* Purpose:           If a partial email (header-only) was retrieved, 
		*                    this method will download and return the full email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEMailPartial, a Chilkat Email object.
		*                    toChilkatEMailFull, a Chilkat Email object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** If a partial email (header-only) was retrieved, this method will download 
		** and return the full email from the server using the partial email as an argument.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEMailPartial AS CHILKAT_EMAIL_COM_CALL, ;
		toChilkatEMailFull AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEMailPartial AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMailPartial AS CHILKAT_EMAIL_COM_CALL, liReturn AS Integer, ;
		loParkParameterEMailFull AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMailFull AS CHILKAT_EMAIL_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailPartial, m.loChilkatEMailPartial, ;
		m.loParkParameterEMailFull, m.loChilkatEMailFull
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEMailPartial = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMailPartial)
		
		    loParkParameterEMailFull = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMailFull)
		
		    loChilkatEMailPartial = m.loParkParameterEMailPartial.GetObject()
		    loChilkatEMailFull = m.loParkParameterEMailFull.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.FetchFull(m.loChilkatEMailPartial, loChilkatEMailFull) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEMailPartial = ;
		    m.loParkParameterEMailPartial.SetObject(m.toChilkatEMailPartial, m.loChilkatEMailPartial)
		
		    toChilkatEMailFull = ;
		    m.loParkParameterEMailFull.SetObject(m.toChilkatEMailFull, m.loChilkatEMailFull)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailPartial, m.loChilkatEMailPartial, ;
		m.loParkParameterEMailFull, m.loChilkatEMailFull
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEMailPartial = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatEMailFull = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEMailPartial = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterEMailFull = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEMailPartial = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatEMailFull = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fetchfullasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchFull method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*==============================================================================
