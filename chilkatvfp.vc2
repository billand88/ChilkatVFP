		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.RenameRemoteFileAsync(;
		        m.tcExistingRemoteFilePath, m.tcNewRemoteFilePath)
		
		      CATCH TO m.loException
		
