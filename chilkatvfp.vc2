	PROCEDURE resumeuploadfilebyname		&& Resumes a file upload to the SFTP/SSH server. The size of the remoteFilePath is first checked to determine the starting offset for the upload. If remoteFilePath is empty or does not exist, this method is equivalent to UploadFileByName.
		*==============================================================================
		* Method:            ResumeUploadFileByName
		* Purpose:           Resumes a file upload to the SFTP/SSH server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteFilePath -- the remote file to download.
		*                    tcLocalFilePath, the path to the local file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Resumes a file upload to the SFTP/SSH server. 
		** The size of the remoteFilePath is first checked 
		** to determine the starting offset for the upload. 
		** If remoteFilePath is empty or does not exist, 
		** this method is equivalent to UploadFileByName. 
		** If remoteFilePath is already fully uploaded (i.e. it's size is equal to localFilePath), 
		** then no additional bytes are uploaded and 1 is returned.
		** 
		** Enhancement for Version 55: This method was improved.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcRemoteFilePath AS Character, tcLocalFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ResumeUploadFileByName(;
		      m.tcRemoteFilePath, m.tcLocalFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

