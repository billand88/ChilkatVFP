	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat StringTable VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/21/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/21/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 62
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE wordfollowing		&& Introduced in version 11.1.0. The method performs a case-insensitive search to return the index of a table entry matching sb, or -1 if there is no match.
		*==============================================================================
		* Method:            WordFollowing
		* Purpose:           The method performs a case-insensitive search to return 
		*                    the index of a table entry matching sb.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder -- a Chilkat StringBuilder object.
		*                    tuCaptureEmailAddress -- whether target word is an email address.
		*                    toChilkatStringBuilderWord -- a Chilkat StringBuilder object.
		* Returns:           Returns the number of matches, or -1 for failure.
		* Date Added:        07/31/2025
		*==============================================================================
		
		**
		** Introduced in version 11.1.0
		**
		** The method performs a case-insensitive search to return the index of a table entry matching sb, 
		** or -1 if there is no match. Set captureEmailAddr to 1 if the target word is expected to be an email address,
		** otherwise set captureEmailAddr to 0. sbWord will receive the word (email address) following the matched text. 
		** This method helps replace the outdated Chilkat Bounce class, 
		** which was used for identifying and categorizing bounced email types.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tuCaptureEmailAddress AS Unknown, toChilkatStringBuilderWord AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_STRINGTABLE_COM_CALL, loException AS Exception, ;
		liMatches AS Integer, loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loParkParameterStringBuilderWord AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilderWord AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		llImplemented AS Logical, liCaptureEmailAddress AS Integer
		
		STORE 0 TO m.liMatches, m.liCaptureEmailAddress
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterStringBuilder, ;
		m.loChilkatStringBuilder, m.loParkParameterStringBuilderWord, m.loChilkatStringBuilderWord
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCaptureEmailAddress = .LogicalToBit(m.tuCaptureEmailAddress)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loParkParameterStringBuilderWord = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilderWord)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		      loChilkatStringBuilderWord = m.loParkParameterStringBuilderWord.GetObject()
		
		      TRY
		
		        liMatches = m.loChilkatObject.WordFollowing(m.loChilkatStringBuilder, ;
		        m.liCaptureEmailAddress, m.loChilkatStringBuilderWord)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		      toChilkatStringBuilderWord = m.loParkParameterStringBuilderWord.SetObject(;
		      m.toChilkatStringBuilderWord, m.loChilkatStringBuilderWord)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterStringBuilder, ;
		m.loChilkatStringBuilder, m.loParkParameterStringBuilderWord, m.loChilkatStringBuilderWord
		
		RETURN m.liMatches
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  toChilkatStringBuilderWord  = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterStringBuilderWord = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loChilkatStringBuilderWord = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

ENDDEFINE

DEFINE CLASS tar AS ibasechilkat OF "chilkatvfp.vcx" 		&& API for creating and extracting TAR archives. Also supports creating and extracting .tar.gz (.tgz), .tar.bz2, and .tar.Z (compressed TAR archives, also known as compressed tarball archives). 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: adddirroot		&& Adds a directory tree to be included in the next call to one of the WriteTar* methods. To include multiple directory trees in a .tar, call AddDirRoot multiple times followed by a single call to WriteTar. Returns 1 for success, 0 for failure.
		*m: adddirroot2		&& Introduced in version 9.5.0.56. Adds a directory tree to be included in the next call to one of the WriteTar* methods.
		*m: addfile		&& Introduced in version 9.5.0.46. Adds a local file to be included in the next call to one of the WriteTar* methods. Returns 1 for success, 0 for failure.
		*m: addfile2		&& Introduced in version 9.5.0.69. Adds a local file to be included in the next call to one of the WriteTar* methods. Allows for the path within the TAR to be specified.
		*m: capturexmllisting_access		&& Access method used to retrieve the Chilkat TAR CaptureXMLListing property.
		*m: capturexmllisting_assign		&& Assign method used to hold a reference to the CaptureXMLListing property.
		*m: charset_access		&& Access method used to retrieve the Chilkat TAR Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: cleardirrootsandfiles		&& Introduced in version 9.5.0.84. Clears all directory roots and files previously added by calls to AddDirRoot, AddDirRoot2, AddFile, and AddFile2. Returns 1 for success, 0 for failure.
		*m: createdeb		&& Introduced in version 9.5.0.66. Creates a .deb Debian binary package archive from a control.tar.gz and data.tar.gz. The controlPath is the path to the control.tar.gz file (or equivalent), and the dataPath is the path to the data.tar.gz file.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat TAR DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: dirmode_access		&& Access method used to retrieve the Chilkat TAR DirMode property.
		*m: dirmode_assign		&& Assign method used to hold a reference to the DirMode property.
		*m: dirprefix_access		&& Access method used to retrieve the Chilkat TAR DirPrefix property.
		*m: dirprefix_assign		&& Assign method used to hold a reference to the DirPrefix property.
		*m: filemode_access		&& Access method used to retrieve the Chilkat TAR FileMode property.
		*m: filemode_assign		&& Assign method used to hold a reference to the FileMode property.
		*m: getdirroot		&& Returns the value of the Nth directory root.
		*m: groupid_access		&& Access method used to retrieve the Chilkat TAR GroupID property.
		*m: groupid_assign		&& Assign method used to hold a reference to the GroupID property.
		*m: groupname_access		&& Access method used to retrieve the Chilkat TAR GroupName property.
		*m: groupname_assign		&& Assign method used to hold a reference to the GroupName property.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat TAR HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat TAR LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat TAR LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat TAR LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat TAR LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat TAR LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat TAR LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat TAR LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: listxml		&& Scans a TAR archive and returns XML detailing the files and directories found within the TAR. Returns Nothing on failure.
		*m: listxmlasync		&& Creates an asynchronous task to call the ListXml method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: matchcasesensitive_access		&& Access method used to retrieve the Chilkat TAR MatchCaseSensitive property.
		*m: matchcasesensitive_assign		&& Assign method used to hold a reference to the MatchCaseSensitive property.
		*m: mustmatch_access		&& Access method used to retrieve the Chilkat TAR MustMatch property.
		*m: mustmatch_assign		&& Assign method used to hold a reference to the MustMatch property.
		*m: mustnotmatch_access		&& Access method used to retrieve the Chilkat TAR MustNotMatch property.
		*m: mustnotmatch_assign		&& Assign method used to hold a reference to the MustNotMatch property.
		*m: noabsolutepaths_access		&& Access method used to retrieve the Chilkat TAR NoAbsolutePaths property.
		*m: noabsolutepaths_assign		&& Assign method used to hold a reference to the NoAbsolutePaths property.
		*m: numdirroots_access		&& Access method used to retrieve the Chilkat TAR NumDirRoots property.
		*m: numdirroots_assign		&& Assign method used to hold a reference to the NumDirRoots property.
		*m: percentdonescale_access		&& Access method used to retrieve the Chilkat TAR PercentDoneScale property.
		*m: percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*m: scriptfilemode_access		&& Access method used to retrieve the Chilkat TAR ScriptFileMode property.
		*m: scriptfilemode_assign		&& Assign method used to hold a reference to the ScriptFileMode property.
		*m: suppressoutput_access		&& Access method used to retrieve the Chilkat TAR SuppressOutput property.
		*m: suppressoutput_assign		&& Assign method used to hold a reference to the SuppressOutput property.
		*m: untar		&& Extracts the files and directories from a TAR archive, reconstructing the directory tree(s) in the local filesystem. The files are extracted to the directory specified by the UntarFromDir property.
		*m: untarasync		&& Creates an asynchronous task to call the Untar method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: untarbz2		&& Extracts the files and directories from a tar.bz2 (or tar.bzip2) archive, reconstructing the directory tree(s) in the local filesystem. The files are extracted to the directory specified by the UntarFromDir property.
		*m: untarbz2async		&& Creates an asynchronous task to call the UntarBz2 method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: untarcasesensitive_access		&& Access method used to retrieve the Chilkat TAR UnTarCaseSensitive property.
		*m: untarcasesensitive_assign		&& Assign method used to hold a reference to the UnTarCaseSensitive property.
		*m: untardebuglog_access		&& Access method used to retrieve the Chilkat TAR UnTarDebugLog property.
		*m: untardebuglog_assign		&& Assign method used to hold a reference to the UnTarDebugLog property.
		*m: untardiscardpaths_access		&& Access method used to retrieve the Chilkat TAR UnTaDiscardPaths property.
		*m: untardiscardpaths_assign		&& Assign method used to hold a reference to the UnTarDiscardPaths property.
		*m: untarfirstmatchingtobd		&& Introduced in version 9.5.0.82. Untars the first file matching the matchPattern into bd. Returns 1 for success, 0 for failure.
		*m: untarfirstmatchingtomemory		&& Memory-to-memory untar. The first file matching the matchPattern is extracted and returned. Returns a zero-length byte array (as a Variant) on failure.
		*m: untarfromdir_access		&& Access method used to retrieve the Chilkat TAR UnTarFromDir property.
		*m: untarfromdir_assign		&& Assign method used to hold a reference to the UnTarFromDir property.
		*m: untarfrommemory		&& Extracts the files and directories from an in-memory TAR archive, reconstructing the directory tree(s) in the local filesystem. The files are extracted to the directory specified by the UntarFromDir property.
		*m: untarfrommemoryasync		&& Creates an asynchronous task to call the UntarFromMemory method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: untargz		&& Extracts the files and directories from a tar.gz (or tar.gzip) archive, reconstructing the directory tree(s) in the local filesystem. The files are extracted to the directory specified by the UntarFromDir property. Returns 1 for success, 0 for failure.
		*m: untargzasync		&& Creates an asynchronous task to call the UntarGz method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: untarmaxcount_access		&& Access method used to retrieve the Chilkat TAR UnTarMaxCount property.
		*m: untarmaxcount_assign		&& Assign method used to hold a reference to the UnTarMaxCount property.
		*m: untarz		&& Extracts the files and directories from a tar.Z archive, reconstructing the directory tree(s) in the local filesystem. The files are extracted to the directory specified by the UntarFromDir property. Returns 1 for success, 0 for failure.
		*m: untarzasync		&& Creates an asynchronous task to call the UntarZ method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: userid_access		&& Access method used to retrieve the Chilkat TAR UserID property.
		*m: userid_assign		&& Assign method used to hold a reference to the UserID property.
		*m: username_access		&& Access method used to retrieve the Chilkat TAR UserName property.
		*m: username_assign		&& Assign method used to hold a reference to the UserName property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat TAR VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifytar		&& Verifies that a TAR archive is valid. This method opens the TAR archive and scans the entire file by walking the TAR headers. Returns 1 if no errors were found. Otherwise returns 0.
		*m: verifytarasync		&& Creates an asynchronous task to call the VerifyTar method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: writeformat_access		&& Access method used to retrieve the Chilkat TAR WriteFormat property.
		*m: writeformat_assign		&& Assign method used to hold a reference to the WriteFormat property.
		*m: writetar		&& Writes a TAR archive. The directory trees previously added by calling AddDirRoot one or more times are included in the output TAR archive. Returns 1 for success, 0 for failure.
		*m: writetarasync		&& Creates an asynchronous task to call the WriteTar method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: writetarbz2		&& Writes a .tar.bz2 compressed TAR archive. The directory trees previously added by calling AddDirRoot one or more times are included in the output file. Returns 1 for success, 0 for failure.
		*m: writetarbz2async		&& Creates an asynchronous task to call the WriteTarBz2 method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: writetargz		&& Writes a .tar.gz (also known as .tgz) compressed TAR archive. The directory trees previously added by calling AddDirRoot one or more times are included in the output file. Returns 1 for success, 0 for failure.
		*m: writetargzasync		&& Creates an asynchronous task to call the WriteTarGz method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: xmllisting_access		&& Access method used to retrieve the Chilkat TAR XMLListing property.
		*m: xmllisting_assign		&& Assign method used to hold a reference to the XMLListing property.
		*p: capturexmllisting		&& Introduced in version 9.5.0.46. If 1, then untar methods, such as Untar, UntarGz, UntarBz2, and UntarZ, will also capture an XML listing of the contents in the XmlListing property.
		*p: charset		&& Character encoding to be used when interpreting filenames within .tar archives for untar operations. The default is "utf-8", and this is typically not changed. (The WriteTar methods always uses utf-8 to store filenames within the TAR archive.)
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: dirmode		&& The directory permissions to used in WriteTar* methods. The default is octal 0755. This is the value to be stored in the "mode" field of each TAR header for a directory entries.
		*p: dirprefix		&& A prefix to be added to each file's path within the TAR archive as it is being created. For example, if this property is set to the string "subdir1", then "subdir1/" will be prepended to each file's path within the TAR.
		*p: filemode		&& The file permissions to used in WriteTar* methods. The default is octal 0644. This is the value to be stored in the "mode" field of each TAR header for a file entries.
		*p: groupid		&& The default numerical GID to be stored in each TAR header when writing TAR archives. The default value is 1000.
		*p: groupname		&& The default group name to be stored in each TAR header when writing TAR archives. The default value is the logged-on username of the application's process.
		*p: heartbeatms		&& This is the number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any TAR operation prior to completion. If HeartbeatMs is 0, no AbortCheck event callbacks will occur.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: matchcasesensitive		&& Introduced in version 9.5.0.46. Determines whether pattern matching for the MustMatch and MustNotMatch properties is case-sensitive or not. The default value is 0.
		*p: mustmatch		&& Introduced in version 9.5.0.46. If set, then file paths must match this pattern when creating TAR archives, or when extracting from TAR archives.
		*p: mustnotmatch		&& Introduced in version 9.5.0.46. If set, then file paths must NOT match this pattern when creating TAR archives, or when extracting from TAR archives.
		*p: noabsolutepaths		&& If 1, then absolute paths are converted to relative paths by removing the leading "/" or "\" character when untarring.
		*p: numdirroots		&& The total number of directory roots set by calling AddDirRoot (i.e. the number of times AddDirRoot was called by the application).
		*p: percentdonescale		&& Introduced in version 9.5.0.49. This property is only valid in programming environment and languages that allow for event callbacks. Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks.
		*p: scriptfilemode		&& The file permissions to used in WriteTar* methods for shell script files (.sh, .csh, .bash, .bsh). The default is octal 0755. This is the value to be stored in the "mode" field of each TAR header for a file entries.
		*p: suppressoutput		&& Introduced in version 9.5.0.46. If 1, then untar methods, such as Untar, UntarGz, UntarBz2, and UntarZ, do not produce any output.
		*p: untarcasesensitive		&& This property is decremented. Applications should instead use the MatchCaseSensitive property. Until this property is officially removed, it will behave the same as the MatchCaseSensitive property.
		*p: untardebuglog		&& Similar to the VerboseLogging property. If set to 1, then information about each file/directory extracted in an untar method call is logged to LastErrorText (or LastErrorXml / LastErrorHtml). The default value is 0.
		*p: untardiscardpaths		&& If 1, then discard all path information when untarring. This causes all files to be untarred into a single directory. The default value is 0.
		*p: untarfromdir		&& The directory path where files are extracted when untarring. The default value is ".", meaning that the current working directory of the calling process is used.
		*p: untarmaxcount		&& Limits the number of files extracted during an untar to this count. The default value is 0 to indicate no maximum.
		*p: userid		&& The default numerical UID to be stored in each TAR header when writing TAR archives. The default value is 1000.
		*p: username		&& The default user name to be stored in each TAR header when writing TAR archives. The default value is the logged-on username of the application's process.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: writeformat		&& The TAR format to use when writing a TAR archive. Valid values are "gnu", "pax", and "ustar". The default value is "gnu".
		*p: xmllisting		&& Introduced in version 9.5.0.46. Contains the XML listing of the contents of the TAR archive for the last untar method call (such as Untar, UntarGz, etc.) where the CaptureXmlListing property was set to 1.
	*</DefinedPropArrayMethod>

	*<PropValue>
		capturexmllisting = 0
		cchilkatclass = Tar
		ceventhandlerclass = iTarEventHandler
		charset = utf-8
		debuglogfilepath = 
		dirmode = 493
		dirprefix = 
		filemode = 420
		groupid = 1000
		groupname = 
		heartbeatms = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		matchcasesensitive = 0
		mustmatch = 
		mustnotmatch = 
		Name = "tar"
		noabsolutepaths = 1
		numdirroots = 
		percentdonescale = 100
		scriptfilemode = 493
		suppressoutput = 0
		untarcasesensitive = 
		untardebuglog = 0
		untardiscardpaths = 0
		untarfromdir = 
		untarmaxcount = 0
		userid = 1000
		username = 
		verboselogging = 0
		writeformat = gnu
		xmllisting = 
	*</PropValue>
	
	PROCEDURE adddirroot		&& Adds a directory tree to be included in the next call to one of the WriteTar* methods. To include multiple directory trees in a .tar, call AddDirRoot multiple times followed by a single call to WriteTar. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddDirRoot
		* Purpose:           Adds a directory tree to be included 
		*                    in the next call to one of the WriteTar* methods.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryPath -- the directory path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Adds a directory tree to be included in the next call to one of the WriteTar* methods. 
		** To include multiple directory trees in a .tar, 
		** call AddDirRoot multiple times followed by a single call to WriteTar.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcDirectoryPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddDirRoot(m.tcDirectoryPath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE adddirroot2		&& Introduced in version 9.5.0.56. Adds a directory tree to be included in the next call to one of the WriteTar* methods.
		*==============================================================================
		* Method:            AddDirRoot2
		* Purpose:           Adds a directory tree to be included 
		*                    in the next call to one of the WriteTar* methods.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRootPrefix -- adds a prefix to the path in the TAR
		*                    tcRootPath -- the path to the root directory.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Adds a directory tree to be included in the next call to one of the WriteTar* methods. 
		** To include multiple directory trees in a .tar, call AddDirRoot2 
		** (and/or AddDirRoot) multiple times followed by a single call to WriteTar.
		** 
		** The rootPrefix adds a prefix to the path 
		** in the TAR for all files added under this root. 
		** The rootPrefix should not end with a forward-slash char. 
		** For example: This is good: "abc/123", but this is not good: "abc/123/". 
		** If the DirPrefix property is also set, its prefix will added first.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcRootPrefix AS Character, tcRootPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddDirRoot2(m.tcRootPrefix, m.tcRootPath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addfile		&& Introduced in version 9.5.0.46. Adds a local file to be included in the next call to one of the WriteTar* methods. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddFile
		* Purpose:           Adds a local file to be included 
		*                    in the next call to one of the WriteTar* methods.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath -- the path to the file to add.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		**
		** Adds a local file to be included in the next call to one of the WriteTar* methods. 
		** To include multiple files or directory trees in a .tar, 
		** call AddFile/AddDirRoot multiple times followed by a single call to WriteTar 
		** (or WriteTarGz, or WriteTarBz2).
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 46
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddFile(m.tcPath) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addfile2		&& Introduced in version 9.5.0.69. Adds a local file to be included in the next call to one of the WriteTar* methods. Allows for the path within the TAR to be specified.
		*==============================================================================
		* Method:            AddFile2
		* Purpose:           Adds a local file to be included 
		*                    in the next call to one of the WriteTar* methods.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath -- the path to the file to add.
		*                    tcPathWithinTAR -- the TAR path for the added file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		**
		** Adds a local file to be included in the next call to one of the WriteTar* methods. 
		** To include multiple files or directory trees in a .tar, 
		** call AddFile2/AddDirRoot multiple times followed by a single call to WriteTar 
		** (or WriteTarGz, or WriteTarBz2).
		** 
		** Note: The DirPrefix property does not apply to files added via this method 
		** because this method explicilty specifies the path-in-tar.
		**
		** Fixed in version 70: Fixed bug in method.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPath AS Character, tcPathWithinTAR AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddFile2(m.tcPath, m.tcPathWithinTAR) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE capturexmllisting_access		&& Access method used to retrieve the Chilkat TAR CaptureXMLListing property.
		*==============================================================================
		* Method:            CaptureXMLListing_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat TAR CaptureXMLListing property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CaptureXMLListing
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		**
		** If 1, then untar methods, such as Untar, UntarGz, UntarBz2, and UntarZ, 
		** will also capture an XML listing of the contents in the XmlListing property. 
		** The format of the XML contained in XmlListing is identical 
		** to what is returned by the ListXml method. The default value is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 46
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE capturexmllisting_assign		&& Assign method used to hold a reference to the CaptureXMLListing property.
		*==============================================================================
		* Method:            CaptureXMLListing_Assign
		* Purpose:           Assign method used to hold a reference to the CaptureXMLListing property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the CaptureXMLListing property.
		* Returns:           
		* Date Added:        05/07/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 46
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE charset_access		&& Access method used to retrieve the Chilkat TAR Charset property.
		*==============================================================================
		* Method:            Charset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat TAR Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Charset
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Character encoding to be used when interpreting filenames 
		** within .tar archives for untar operations. 
		** The default is "utf-8", and this is typically not changed. 
		** (The WriteTar methods always uses utf-8 to store filenames within the TAR archive.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE charset_assign		&& Assign method used to hold a reference to the Charset property.
		*==============================================================================
		* Method:            Charset_Assign
		* Purpose:           Assign method used to hold a reference to the Charset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Charset property.
		* Returns:           
		* Date Added:        05/07/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Fixed issues on non-Windows systems having to do with directories having names with trailing SPACE chars.
		
		  Fixed problems where the Unicode (0xFE 0xFF) and utf-8 (0xEF 0xBB 0xBF) were literally in the filenames.
		
		** Version 10.1.2
		
		  Fixed a crash bug in UnixCompress. This fix could also apply to the Chilkat Tar 
		  when creating .tar.Z compressed archives.
		
		** Version 84
		
		  Added the ClearDirRootsAndFiles method.
		
		** Version 82
		
		  Fixed the UntarFirstMatchingToMemory method.
		
		** Version 73
		
		  Fixed crash (access violation) in the Untar method.
		  This was caused by a corrupt tar file where the internal header contained garbage bytes.
		
		** Version 70
		
		  Fixed bug in AddFile2.
		  See http://www.chilkatforum.com/questions/13042/bug-with-new-tar-addfile2
		
		** Version 67
		
		  Fixed a problem caused when a file to be added to the .tar is exactly 4294967295 bytes in size
		  (which made the file size look like -1 when the 4-byte integer is interpreted as a signed integer).
		
		  Fixed the “Invalid octal string for file size” error.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Fixed a crash bug in the VerifyTar method (for corrupt/garbage input files).
		
		** Version 53
		
		  WriteTar mistakenly returned true if output file could not be opened/created.
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added asynchronous functionality for all qualifying methods
		  across all programming languages, operating systems, and architectures.
		  Each Chilkat method that can potentially be time-consuming or involve network communications,
		  now has a corresponding asynchronous version of the method with the name ending in “Async”.
		
		  Added the LastMethodSuccess property.
		
		** Version 49
		
		  Added PercentDoneScale property to FTP2, Http, Tar, Zip, SFtp, MailMan, Imap, Upload.
		
		** Version 46
		
		  Added the AddFile method to allow explicit files to be added to a TAR archive.
		  AddFile may be called once per file to be added.
		
		  Added the MustMatch, MustNotMatch, and MatchCaseSensitive properties 
		  to provide better control over what is included when creating a TAR archive, or what is extracted.
		
		  Added the following properties: SuppressOutput, CaptureXmlListing, XmlListing.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE cleardirrootsandfiles		&& Introduced in version 9.5.0.84. Clears all directory roots and files previously added by calls to AddDirRoot, AddDirRoot2, AddFile, and AddFile2. Returns 1 for success, 0 for failure.
