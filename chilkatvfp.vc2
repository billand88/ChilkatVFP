	HIDDEN PROCEDURE ignoremustrevalidate_access		&& Access method used to retrieve the Chilkat MHT IgnoreMustRevalidate property.
		*==============================================================================
		* Method:            IgnoreMustRevalidate_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MHT IgnoreMustRevalidate property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IgnoreMustRevalidate
		* Date Added:        07/18/2022
		*==============================================================================
		
		**
		** Some HTTP responses contain a "Cache-Control: must-revalidate" header. 
		** If this is present, the server is requesting that the client 
		** always issue a revalidate HTTP request instead of serving the page directly from cache. 
		** If IgnoreMustRevalidate is set to 1, then Chilkat MHT will serve the page 
		** directly from cache without revalidating until the page is no longer fresh. 
		** (assuming that FetchFromCache is set to 1)
		** 
		** The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE ignoremustrevalidate_assign		&& Assign method used to hold a reference to the MHT IgnoreMustRevalidate property.
		*==============================================================================
		* Method:            IgnoreMustRevalidate_Assign
		* Purpose:           Assign method used to hold a reference to the IgnoreMustRevalidate property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the IgnoreMustRevalidate property.
		* Returns:           
		* Date Added:        07/18/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE ignorenocache_access		&& Access method used to retrieve the Chilkat MHT IgnoreNoCache property.
		*==============================================================================
		* Method:            IgnoreNoCache_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MHT IgnoreNoCache property.
		* Author:            Bill Anderson
