	HIDDEN PROCEDURE tempdir_access		&& Access method used to retrieve the Chilkat ZIP TempDir property.
		*==============================================================================
		* Method:            TempDir_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP TempDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.TempDir
		* Date Added:        04/29/2022
		*==============================================================================
		
		** 
		** The temporary directory to use when unzipping files. 
		** When running in ASP or ASP.NET, the default value of TempDir 
		** is set to the directory where the .zip is being written. 
		** Set this property to override the default.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE tempdir_assign		&& Assign method used to hold a reference to the TempDir property.
		*==============================================================================
		* Method:            TempDir_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat ZIP TempDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the TempDir property.
		* Returns:           
		* Date Added:        04/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE textflag_access		&& Access method used to retrieve the Chilkat ZIP TextFlag property.
		*==============================================================================
		* Method:            TextFlag_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP TextFlag property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.TextFlag
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** If set to 1, the component will set the "text flag" 
		** for each file having these filename extensions: .txt, .xml, .htm, and .html. 
		** It will also preserve the "text flag" 
		** for existing zips that are opened and rewritten. 
		** By default, this property is set to 0.
		**
		** Update for Version 10: This property is now decremented.
		**
		** It is generally not necessary to set the text flag for a zip entry.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE textflag_assign		&& Assign method used to hold a reference to the TextFlag property.
		*==============================================================================
		* Method:            TextFlag_Assign
		* Purpose:           Assign method used to hold a reference to the TextFlag property.
		* Author:            Bill Anderson
