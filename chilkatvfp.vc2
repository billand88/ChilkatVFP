	PROCEDURE syncremotetree		&& Uploads a directory tree from the local filesystem to the FTP server.
		*==============================================================================
		* Method:            SyncRemoteTree
		* Purpose:           Uploads a directory tree from the local filesystem to the FTP server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalRootDirectory -- the local root directory to sync.
		*                    tiSyncMode -- the synchronization mode.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** Uploads a directory tree from the local filesystem to the FTP server. 
		** Synchronization modes include:
		**
		** mode=0: Download all files
		** mode=1: Download all files that do not exist on the local filesystem.
		** mode=2: Download newer or non-existant files.
		** mode=3: Download only newer files. 
		** If a file does not already exist on the local filesystem, 
		** it is not downloaded from the server.
		** mode=5: Download only missing files or files with size differences.
		** mode=6: Same as mode 5, but also download newer files.
		** mode=99: Do not download files, 
		** but instead delete remote files that do not exist locally.
		** There is no mode #4. It is a mode used internally by the DirTreeXml method.
		**
		** Note: In v9.5.0.51 and higher, the list of downloaded (or deleted) files is available 
		** in the SyncedFiles property.
		**
		** Fixed for version 59: Fixed SyncRemoteTree/SyncRemoteTree2 progress monitoring callbacks.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed for version 85: Fixed problems with uploading from UNC paths.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcLocalRootDirectory AS Character, tiSyncMode AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFiles = m.loChilkatObject.SyncRemoteTree(m.tcLocalRootDirectory, m.tiSyncMode)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE syncremotetree2		&& Same as SyncRemoteTree, except two extra arguments are added to allow for more flexibility.
		*==============================================================================
		* Method:            SyncRemoteTree2
		* Purpose:           Same as SyncRemoteTree, except two extra arguments 
		*                    are added to allow for more flexibility. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalRootDirectory -- the local root directory to sync.
		*                    tiSyncMode -- the synchronization mode.
		*                    tuDescending -- determines if the directory tree is descended.
		*                    tuPreviewOnly -- only make remote directories
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** Same as SyncRemoteTree, except two extra arguments 
		** are added to allow for more flexibility. 
		** If bDescend is 0, then the directory tree is not descended 
		** and only the files in localDirPath are synchronized. 
		** If bPreviewOnly is 1 then no files are transferred 
		** and instead the files that would've been transferred (had bPreviewOnly been set to 0) 
		** are listed in the SyncPreview property.
		**
		** Note: If bPreviewOnly is set to 1, 
		** the remote directories (if they do not exist) are created. 
		** It is only the files that are not uploaded.
		**
		** Note: In v9.5.0.51 and higher, ;
		** the list of uploaded files is available in the SyncedFiles property.
		**
		** Fixed for version 59: Fixed SyncRemoteTree/SyncRemoteTree2 progress monitoring callbacks.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcLocalRootDirectory AS Character, tiSyncMode AS Integer, ;
		tuDescending AS Unknown, tuPreviewOnly AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liFiles AS Integer, ;
		liDescending AS Integer, liPreviewOnly AS Integer
		
		STORE 0 TO m.liFiles, m.liDescending, m.liPreviewOnly
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liDescending = .LogicalToBit(m.tuDescending)
		    liPreviewOnly = .LogicalToBit(m.tuPreviewOnly)
		
		    TRY
		
		      liFiles = ;
		      m.loChilkatObject.SyncRemoteTree2(m.tcLocalRootDirectory, ;
		      m.tiSyncMode, m.liDescending, m.liPreviewOnly)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE syncremotetree2async		&& Creates an asynchronous task to call the SyncRemoteTree2 method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SyncRemoteTree2Async
		* Purpose:           Creates an asynchronous task to call the 
		*                    SyncRemoteTree2 method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalRootDirectory -- the local root directory to sync.
		*                    tiSyncMode -- the synchronization mode.
		*                    tuPreviewOnly -- only make remote directories
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the SyncRemoteTree2 method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Fixed for version 59: Fixed SyncRemoteTree/SyncRemoteTree2 progress monitoring callbacks.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLocalRootDirectory AS Character, tiSyncMode AS Integer, ;
		tuDescending AS Unknown, tuPreviewOnly AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liDescending AS Integer, ;
		liPreviewOnly AS Integer
		
		STORE 0 TO m.liDescending, m.liPreviewOnly, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liDescending = .LogicalToBit(m.tuDescending)
		      liPreviewOnly = .LogicalToBit(m.tuPreviewOnly)
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.SyncRemoteTree2Async(m.tcLocalRootDirectory, ;
		        m.tiSyncMode, m.liDescending, m.liPreviewOnly)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

