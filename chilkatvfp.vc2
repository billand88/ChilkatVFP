	PROCEDURE uploadfilebyname		&& Simplified method for uploading a file to the SFTP/SSH server. The last-modified date/time is only preserved if the PreserveDate property is set to 1. This behavior of maintaining the last-mod date/time was introduced in v9.5.0.40.
		*==============================================================================
		* Method:            UploadFileByName
		* Purpose:           Simplified method for uploading a file to the SFTP/SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteFilePath -- the handle to the file.
		*                    tcLocalFilePath -- the path to the local file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Simplified method for uploading a file to the SFTP/SSH server.
		**
		** The last-modified date/time is only preserved if the PreserveDate property is set to 1. 
		** This behavior of maintaining the last-mod date/time was introduced in v9.5.0.40.
		**
		** Important: If the remoteFilePath is an absolute path, 
		** then it is a path from the root of the server's filesystem. 
		** For example, "/home/joe/someFile.txt". 
		** Use a relative path to specify a directory relative to the $HOME directory 
		** of the SSH user account. For example, "./someFile.txt".
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fix for version 76: If preserving the last-mod date/time is the only error for this method, 
		** then the method will still return success (rather than failure).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcRemoteFilePath AS Character, tcLocalFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.UploadFileByName(m.tcRemoteFilePath, m.tcLocalFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

