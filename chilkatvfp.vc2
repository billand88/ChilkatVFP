	HIDDEN PROCEDURE s3ssl_access		&& Access method used to retrieve the Chilkat HTTP S3SSL property.
		*==============================================================================
		* Method:            S3SSL_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP S3SSL property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.S3SSL
		* Date Added:        01/28/2022
		*==============================================================================
		
		**
		** If 1, then all S3_* methods will use a secure SSL/TLS connection for communications. 
		** The default value is 1.
		**
		** Version 11.0.0: Property removed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [LongBit]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 0
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
	ENDPROC

	HIDDEN PROCEDURE s3ssl_assign		&& Assign method used to hold a reference to the S3SSL property.
		*==============================================================================
		* Method:            S3SSL_Assign
		* Purpose:           Assign method used to hold a reference to the S3SSL property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the S3SSL property.
		* Returns:           
		* Date Added:        02/04/2022
		*==============================================================================
		
		**
		** Version 11.0.0: Property removed.
		**
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    lcValidationMethod = []
		    lcMethodToCall = [LongBit]
		
		    .CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

	PROCEDURE s3_createbucket		&& Creates a new Amazon S3 bucket.
		*==============================================================================
		* Method:            S3_CreateBucket
		* Purpose:           Creates a new Amazon S3 bucket.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBucketPath -- the Amazon S3 bucket path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Creates a new Amazon S3 bucket.
		**
		** Note: x-amz-* headers, including metadata, can be added to any S3 request 
		** by adding each header with a call to SetRequestHeader. 
		** This applies to all S3 methods, even if not explicitly stated.
		**
		** Fixed for Version 46: Fixed the method.
		**
		** Fixed for Version 66: Fixed AWS Signature V4 issues 
		** for some cases when query params are used with S3.
		**
		** Fixed in Version 69: Fixed problems with pre-signing URLs having to do with 
		** 8bit non-us-ascii chars in the filename, or “.” chars in the bucket name.
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcBucketPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.S3_CreateBucket(m.tcBucketPath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

