		RETURN
	ENDPROC

	PROCEDURE gentimestamp		&& Returns the current GMT (also known as UTC) date/time in a string that is compliant with RFC 2616 format. Returns Nothing on failure
		*==============================================================================
		* Method:            GenTimeStamp
		* Purpose:           Returns the current GMT (also known as UTC) date/time in a string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
