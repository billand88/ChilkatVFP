	HIDDEN PROCEDURE reqexeccharset_access		&& Access method used to retrieve the Chilkat SSH ReqExecCharset property.
		*==============================================================================
		* Method:            ReqExecCharset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH ReqExecCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReqExecCharset
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.47
		**
		** Specifies the character encoding used for command text sent by SendReqExec, QuickCommand, and QuickCmdSend. 
		** The default is ANSI.
		**
		** On Windows, ANSI uses the Windows ANSI code page returned by GetACP, not the OEM code page. 
		** Its exact meaning on non-Windows platforms is environment-dependent. For portable behavior, 
		** specify an explicit charset such as utf-8 or windows-1252.
		** 
		** This property applies to the command string itself. It does not override the explicit charset 
		** argument passed to ChannelSendString.
		**
		** Use a supported charset name. In v11.6.0, an unrecognized charset name was observed to fall back 
		** to UTF-8 rather than fail; applications should not rely on that fallback.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 47
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE reqexeccharset_assign		&& Assign method used to hold a reference to the SSH ReqExecCharset property.
		*==============================================================================
		* Method:            ReqExecCharset_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SSH ReqExecCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ReqExecCharset property.
		* Returns:           
		* Date Added:        04/09/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 47
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE sendignore		&& Sends an IGNORE message to the SSH server. This is one way of verifying that the connection to the SSH server is open and valid. The SSH server does not respond to an IGNORE message. It simply ignores it.
		*==============================================================================
		* Method:            SendIgnore
		* Purpose:           Sends an IGNORE message to the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Sends an IGNORE message to the SSH server. 
		** This is one way of verifying that the connection to the SSH server is open and valid. 
		** The SSH server does not respond to an IGNORE message. It simply ignores it. 
		** IGNORE messages are not associated with a channel 
		** (in other words, you do not need to first open a channel prior to sending an IGNORE message).
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SendIgnore() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

