	HIDDEN PROCEDURE authoritykeyid_access		&& Access method used to retrieve the Chilkat Cert AuthorityKeyID property.
		*==============================================================================
		* Method:            AuthorityKeyID_Access
		* Purpose:           Access method used to retrieve 
		*                    the AuthorityKeyID property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AuthorityKeyID
		* Date Added:        07/28/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.40
		**
		** The authority key identifier of the certificate in base64 string format. 
		** This is only present if the certificate contains the extension OID 2.5.29.35.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 40
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE authoritykeyid_assign		&& Assign method used to hold a reference to the AuthorityKeyID property.
		*==============================================================================
		* Method:            AuthorityKeyID_Assign
		* Purpose:           Assign method used to hold
		*                    the AuthorityKeyID of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the AuthorityKeyID property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 40
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE avoidwindowspkaccess_access		&& Access method used to retrieve the Chilkat Cert AvoidWindowsPKAccess property.
		*==============================================================================
		* Method:            AvoidWindowsPKAccess_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert AvoidWindowsPKAccess property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AvoidWindowsPKAccess
		* Date Added:        07/28/2022
		*==============================================================================
		
		** 
		** Applies only when running on a Microsoft Windows operating system. 
		** If 1, then any method that returns a certificate will not try 
		** to also access the associated private key, assuming one exists. 
		** This is useful if the certificate was installed with high-security 
		** such that a private key access would trigger the Windows OS to display 
		** a security warning dialog. The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE avoidwindowspkaccess_assign		&& Assign method used to hold a reference to the AvoidWindowsPKAccess property.
		*==============================================================================
		* Method:            AvoidWindowsPKAccess_Assign
		* Purpose:           Assign method used to hold a reference to the AvoidWindowsPKAccess property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AvoidWindowsPKAccess property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE buildcertchain		&& Introduced in version 11.0.0. Builds the certificate chain in certChain containing all the certificates (including this one), in the chain of authentication to the trusted root (if possible).
		*==============================================================================
		* Method:            BuildCertChain
		* Purpose:           Builds the certificate chain in certChain containing all the certificates.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCertChain, a Chilkat Certificate Chain object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/04/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Builds the certificate chain in certChain containing all the certificates (including this one), 
		** in the chain of authentication to the trusted root (if possible). 
		** If this certificate object was loaded from a PFX, then the certiicates contained in the PFX 
		** are automatically available for building the certificate chain. The UseCertVault method 
		** can be called to provide additional certificates that might be required to build the cert chain. 
		** Finally, the TrustedRoots object can be used to provide a way of making trusted root certificates available.
		** 
		** Note: Returns 1 even if certificate chain is not completed to the root. 
		** The certificate chain's ReachesRoot property can be examined to see if the chain was completed to the root.
		** 
		** On Windows systems, the registry-based certificate stores 
		** are automatically consulted if needed to locate intermediate or root certificates in the chain. 
		** Chilkat searches certificate stores in the following order. 
		** See System Store Locations for more information.
		** 
		** 1) Current-User "CA" Certificate Store
		** 2) Local-Machine "CA" Certificate Store
		** 3) Current-User "Root" Certificate Store
		** 4) Local-Machine "Root" Certificate Store
		** 5) Current-User "MY" Certificate Store
		** 6) Local-Machine "MY" Certificate Store
		** 7) Current-User "ADDRESSBOOK" Certificate Store (if it exists)
		** 8) Local-Machine "ADDRESSBOOK" Certificate Store (if it exists)
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCertChain AS CHILKAT_CERTCHAIN_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterCertChain AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCertChain AS CHILKAT_CERTCHAIN_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCertChain, m.loChilkatCertChain  
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCertChain = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCertChain)
		
		      loChilkatCertChain = m.loParkParameterCertChain.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.BuildCertChain(m.loChilkatCertChain) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCertChain = ;
		      m.loParkParameterCertChain.SetObject(m.toChilkatCertChain, m.loChilkatCertChain)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCertChain, m.loChilkatCertChain
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatCertChain = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loParkParameterCertChain = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCertChain = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE certversion_access		&& Access method used to retrieve the Chilkat Cert CertVersion property.
		*==============================================================================
		* Method:            CertVersion_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert CertVersion property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CertVersion
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** The version of the certificate (1, 2, or 3). 
		** A value of 0 indicates an error -- the most likely cause 
		** being that the certificate object is empty 
		** (i.e. was never loaded with a certificate). 
		** Note: This is not the version of the software, 
		** it is the version of the X.509 certificate object. The version of the Chilkat 
		** certificate software is indicated by the Version property.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE certversion_assign		&& Assign method used to hold a reference to the CertVersion property.
		*==============================================================================
		* Method:            CertVersion_Assign
		* Purpose:           Assign method used to hold a reference to the CertVersion property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the CertVersion property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE checkrevoked		&& Returns 1 if the certificate has been revoked, 0 if not revoked, and -1 if unable to check the revocation status. Note: This method is only implemented on Windows systems.
		*==============================================================================
		* Method:            CheckRevoked
		* Purpose:           Returns 1 if the certificate has been revoked, 0 if not revoked, 
		*                    and -1 if unable to check the revocation status.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The revocation status.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Returns 1 if the certificate has been revoked, 0 if not revoked, 
		** and -1 if unable to check the revocation status.
		** 
		** Note: This method is only implemented on Windows systems. 
		** It uses the underlying Microsoft CertVerifyRevocation Platform SDK function 
		** to check the revocation status of a certificate. 
		** (Search "CertVerifyRevocation" to get information about it.)
		** 
		** Non-Windows (and Windows) applications can send an OCSP request as shown in the example below.
		**
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, liRevocationStatus AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liRevocationStatus = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liRevocationStatus = m.loChilkatObject.CheckRevoked()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liRevocationStatus
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE checksmartcardpin		&& Introduced in version 9.5.0.77. Verifies that the SmartCardPin property setting is correct. Returns 1 if correct, 0 if incorrect, and -1 if unable to check because the underlying CSP does not support the functionality.
		*==============================================================================
		* Method:            CheckSmartCardPIN
		* Purpose:           Verifies that the SmartCardPin property setting is correct.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The validation status.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Verifies that the SmartCardPin property setting is correct. 
		** Returns 1 if correct, 0 if incorrect, and -1 if unable to check 
		** because the underlying CSP does not support the functionality.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liValidationStatus AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liValidationStatus, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liValidationStatus = m.loChilkatObject.CheckSmartCardPIN()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liValidationStatus
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		  
		  Added the CheckRevokedCacheOnly uncommon option for Windows certificate revocation 
		  checking via the CheckRevoked method.
		
		** Version 11.0.0
		
		  Removed the CspName, HasKeyContainer, KeyContainerName, MachineKeyset and Silent properties.
		
		  Added the BuildCertChain, GetIssuer, GetPrivateKey, GetPublicKey and Unload methods.
		
		  Decremented the ExportPrivateKey, ExportPublicKey, GetCertChain,
		  GetValidFromDt and GetValidToDt methods.
		
		** Version 10.1
		
		  Added the Cert.IsRsa and Cert.IsEcdsa functions to make it easy 
		  to know if a certificate has an RSA or ECDSA key.
		
		  Cert.SmartCardPin: Can now be set to the special keyword “null_ptr”, 
		  which causes the following behavior when PKCS11 is the underlying access method:  
		  A null PIN (NULL pointer) indicates that no PIN value is being passed. 
		  The absence of a value is often interpreted in a special way by the token or module.
		
		  Added the SmartcardFailReason property to provide the ability 
		  to know the main reason the LoadFromSmartcard method failed.
		
		** Version 10.0
		
		  Fixed a problem having to do with sending OCSP requests for ECDSA based certificates.
		
		  Added the ability to create and verify AES-GCM authEnvelopedData. 
		  This applies to anything doing CMS/PKCS7 encryption, but was needed for S/MIME email.
		
		** Version 99
		
		  Chilkat’s internal ASN.1 decoder needed an update to correctly handle 
		  0-length ASN.1 bit strings (which is something not normally encountered).
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 98
		
		  Fixed a Y2038 problem having to do with certificate that have an expiration date later than year 2038.
		
		** Version 96
		
		  Added the SetCloudSigner method to link a certificate with a cloud service for any type of signing, 
		  such as PDF, XML Digital Signatures, CAdES (i.e. p7m/p7,), etc. For PAdES, XAdES, CAdES, etc., 
		  the certificate is still needed locally. This is because the certificate related information that goes 
		  into the PDF Signature, XML Signature, etc. is constructed by Chilkat, 
		  and it is only the RSA or ECDSA signing of a hash, deep within the internals of Chilkat, 
		  where the REST API call is made to the cloud signing service. Thus, your private key can exist only in the cloud.
		  
		  Added the UploadToCloud method to make it easy to upload a certificate to various cloud services. 
		  Examples are included for Azure Key Vault and Amazon KMS. The design allows for the easy expansion 
		  to support other cloud services. (Let us know if you have suggestions.)
		
		  Added the LinkPkcs11 method to allow for a certificate to be linked to a private key located 
		  on an HSM (smartcard or token). This is needed for cases where the private key is on the HSM, 
		  but not the certificate. One use case for using this function is with AWS CloudHSM, 
		  where the PKCS11 driver, cloudhsm_pkcs11.dll on Windows, or libcloudhsm_pkcs11.so on Linux, 
		  could be used to link your certificate with the private key stored in the cloud on Amazon’s CloudHSM. 
		  Note: In this case, the communication with AWS CloudHSM happens within the PKCS11 driver 
		  and thus Chilkat does not directly communicate with AWS CloudHSM (as opposed to AWS KMS, 
		  which is key storage in the cloud where Chilkat communicates directly via the AWS KMS API). 
		  Note: The difference between AWS CloudHSM and AWS KMS is that one is literally a hardware token in the cloud, 
		  and the other is your private keys in the cloud, but not in hardware. 
		  AWS CloudHSM (hardware in the cloud) can be very expensive.
		
		  Added the GetExtensionBd method to return binary extension data by OID.
		
		  Added support for the Watchdata PROXkey USB token. 
		  Chilkat should automatically recognize the USB token
		  and use the PKCS11 driver at C:\Windows\System32\SignatureP11.dll. 
		  (This is also supported on Linux, assuming the shared lib is at 
		  /usr/lib/WatchData/ProxKey/lib/libwdpkcs_SignatureP11.so)
		
		** Version 95
		
		  Chilkat now works with the Turkish smartcard from TUBITAK UEKAE.
		
		  Chilkat now works correctly with the CryptoCertum 3.6 Cryptographic Card
		
		  Chilkat now works more seamlessly with the ePass2003 token.
		
		  Fixed the Cert.VerifySignature method to successfully validate Ed25519 certificates.
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		** Version 94
		
		  Chilkat improved OCSP requests (used in various parts of the Chilkat API) to satisfy 
		  some servers that are more picky about certain parts of the OCSP protocol which should be optional.
		
		** Version 90
		
		  Improved automatic recognition and handling for various smart cards.
		
		** Version 89
		
		  Added the GetExtensionAsText method. 
		
		  Fixed a problem with loading AKD eID Cards, 
		  which are the government official eID cards for the Republic of Croatia.
		
		** Version 88
		
		  Greatly improved internals for automatically recognizing and handling 
		  smart cards and USB tokens from many different vendors. 
		
		  Vastly improved to automatically recognize smart cards 
		  and do what is appropriate internally (PKCS11, ScMinidriver, or Microsoft CNG/CryptoAPI).
		
		** Version 85
		
		  Added the ExtendedKeyUsage property.
		
		  Added the GetSubjectPart method.
		
		  Added the SubjectAlternativeName property. 
		  The SubjectAlternativeName property contains the cert’s SAN extension (if it exists) as XML.
		  
		  The Rfc822Name property is changed to contain just the RFC822 name part of the cert’s SubjectAlternativeName.
		  If the full SubjectAlternativeName is needed, use the SubjectAlternativeName property 
		  to access the information as XML where the sub-parts can be extracted.  
		
		** Version 83
		
		  Added the SHA3 hash algorithms: sha3-224, sha3-256, sha3-384, sha3-512. 
		  The SHA3 hash algorithms may generally be used in any property or method 
		  of any Chilkat class where a hash algorithm is specified.
		
		  Improved internal functionality relating to SmartCards, Storage Providers, etc. 
		  This is for Cert.LoadFromSmartcard, CertStore.OpenSmartcard, etc.
		
		  Improved support for ECDSA certs.
		  
		  Added the LoadByThumbprint method. (Windows-only method to search Windows 
		  certificate stores for the certificate having a given SHA1 or MD5 hash/thumbprint.)
		
		  Decremented/removed the LinkPrivateKey method. The LinkPrivateKey method should not be needed. 
		  If your application uses it, contact Chilkat for help about how to modify your code.
		  It’s likely you can simply remove the call altogether.
		
		  Fixed the “Cert's public key does not match the private key.” error 
		  that could sometimes occur in the cert.LoadPfxFile method.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms. 
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 77
		
		  Added the CheckSmartCardPin method and the SmartCardNoDialog property.
		
		  Added the X509PKIPathv1 method. This is a method for returning the base64 representation 
		  of an X509PKIPathv1 containing just the calling certificate. 
		  This is used in an X.509 Binary Security Token. 
		  It is a PKIPath that contains an ordered list of X.509 public certificates packaged in a PKIPath. 
		  The X509PKIPathv1 token type may be used to represent a certificate path. 
		  (This is sometimes used in XAdES signatures.)
		
		** Version 75
		
		  Support for Smartcard and USB tokens is much improved. Note: At this point, 
		  smartcards and USB tokens are supported on Windows operating systems only.
		
		  Added the Cert.SmartCardPin property.
		
		  Fixed the ValidFrom and ValidTo properties for some certificates (a rare problem, 
		  the vast majority of certs exhibited no problems with these properties).
		
		  Added the HashOf method to return the encoded hash of a particular part of a certificate.
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex” 
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 69
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		  Fixed an issue with automatically locating pre-installed Windows certificates 
		  (for encryption) when the email address stored within the certificate used uppercase letters.
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings. 
		  This is the same as “base64”, but causes the base64 to be emitted 
		  in lines just like it would be found in MIME or in a PEM.
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 66
		
		  Fixed exporting ECC private keys from PFX to other formats.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16) 
		  rather than in number of characters. This is fixed to return the number of characters. 
		  (Note: this is a property that only exists in ActiveX classes, and is only useful 
		  for certain programming languages such as SQL Server to help programs determine 
		  if temp tables are required.)
		
		** Version 59
		
		  Fixed: When a cert doesn’t have the Issuer CN, 
		  the encrypted message could not be decrypted using Chilkat library, 
		  even though the cert does have subject key id.
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs 
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  (FIXED) The ActiveX LoadTaskResult methods always returned 0, 
		  regardless of success/failure.
		
		** Version 56
		
		   Added the “base64url” encoding to the list of supported encodings. 
		   See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 55
		
		  Added the Cert.SpkiFingerprint property to help implement TLS pinning.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class. 
		  This is helpful for certain programming languages such as DataFlex or SQL Server 
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties. 
		  The KeepStringResult is a property of Chilkat.Global only. 
		  (It may be confusing that Chilkat.Global also has a LastStringResult property — 
		  but this is just like any other object..)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP. 
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary, 
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		  Fixed: The root certs explicitly trusted via the TrustedRoots class 
		  were not being used by the VerifyCert method.
		
		** Version 49
		
		  Added the LoadPem method.
		
		  Added the Cert.GetExtensionsAsXml method.
		
		** Version 48
		
		  Fixed problem with Cert.VerifySignature when the cert is obtained by the Socket.GetSslServerCert method. 
		  The intermedate certs in the chain of authentication, received during the SSL/TLS handshake, 
		  were not (internally and automatically) made available to the Cert object returned by GetSslServerCert, 
		  and thus they were not accessible when trying to verify the cert signature.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier, 
		  and if found will search for the cert with the matching subject key identifier. 
		  Otherwise it will locate the issuer by distinguished name.
		
		** Version 46
		
		  Fixed the LoadFromBase64 method. When a cert was loaded via LoadFromBase64, 
		  the ability to get the issuer certificate or the certificate chain was broken.
		
		** Version 41
		
		  Fixed a problem with Cert.LoadByCommonName.
		
		** Version 40
		
		  Added the Cert.VerifySignature and Cert.GetCertChain methods.
		
		  Review the online reference documentation for new methods or properties 
		  for Ftp2, TrustedRoots, Rsa, Mime, Cert, Email, Imap, MailMan, Crypt2, 
		  Http, Zip, Pfx, XmlCertVault, CertChain, and Upload. 
		  New entries are clearly marked by the version in which they are introduced.
		
		** Version 31
		
		  Added the Cert.ExportToPfxData method to export to an in-memory image of a PFX file.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE cspname_access		&& Access method used to retrieve the Chilkat Cert CSPName property.
		*==============================================================================
		* Method:            CSPName_Access
		* Purpose:           Access method used to retrieve 
		*                    the CSPName property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CSPName
		* Date Added:        07/28/2022
		*==============================================================================
		
		** 
		** (Relevant only when running on a Microsoft Windows operating system.) 
		** If the HasKeyContainer property is 1, then the certificate is linked 
		** to a key container and this property contains the name of the associated CSP 
		** (cryptographic service provider). When a certificate is linked to a key container, 
		** the following properties will provide information about the key container 
		** and private key: CspName, KeyContainerName, MachineKeyset, and Silent.
		**
		** Version 11.0.0: Property removed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [StringReadOnly]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN []
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		
	ENDPROC

	HIDDEN PROCEDURE cspname_assign		&& Assign method used to hold a reference to the CSPName property.
		*==============================================================================
		* Method:            CSPName_Assign
		* Purpose:           Assign method used to hold
		*                    the CSPName of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CSPName property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Version 11.0.0: Property removed.
		**
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    lcValidationMethod = []
		    lcMethodToCall = [StringReadOnly]
		
		    .CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat Cert DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/28/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Cert DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE expired_access		&& Access method used to retrieve the Chilkat Cert Expired property.
		*==============================================================================
		* Method:            Expired_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert Expired property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Expired
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Has a value of 1 if the certificate or any certificate 
		** in the chain of authority has expired. 
		** (This information is not available when running on Windows 95/98 computers.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE expired_assign		&& Assign method used to hold a reference to the Expired property.
		*==============================================================================
		* Method:            Expired_Assign
		* Purpose:           Assign method used to hold a reference to the Expired property.
		* Author:            Bill Anderson
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the Expired property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE exportcertder		&& Exports the digital certificate to ASN.1 DER format. Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            ExportCertDER
		* Purpose:           Exports the digital certificate to ASN.1 DER format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The digital certificate in DER format.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Exports the digital certificate to ASN.1 DER format.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, lqDERData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDERData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqDERData = m.loChilkatObject.ExportCertDER()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDERData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE exportcertderbd		&& Introduced in version 9.5.0.70. Exports the digital certificate in ASN.1 DER format to a BinData object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ExportCertDERBd
		* Purpose:           Returns the body of the MIME message in a BinData object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Exports the digital certificate in ASN.1 DER format to a BinData object.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData  
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ExportCertDERBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

