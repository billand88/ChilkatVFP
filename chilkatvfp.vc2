	PROCEDURE excludedir		&& Adds a directory name to be excluded when AppendFiles is called to add an entire directory tree. All directories having a name equal to an excluded directory will not be included when AppendFiles (or AppendFileEx) is called.
		*==============================================================================
		* Method:            ExcludeDir
		* Purpose:           Adds a directory name to be excluded when 
		*                    AppendFiles is called to add an entire directory tree.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryName -- the directory name to exclude
		* Returns:           
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Adds a directory name to be excluded when AppendFiles is called 
		** to add an entire directory tree. All directories having a name equal to 
		** an excluded directory will not be included when AppendFiles 
		** (or AppendFileEx) is called. Multiple directories can be excluded 
		** by calling ExcludeDir multiple times. The name comparison is case-insensitive.
		**
		
		LPARAMETERS tcDirectoryName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.ExcludeDir(m.tcDirectoryName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE exedefaultdir_access		&& Access method used to retrieve the Chilkat ZIP EXEDefaultDir property.
		*==============================================================================
		* Method:            EXEDefaultDir_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP EXEDefaultDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EXEDefaultDir
		* Date Added:        04/29/2022
		*==============================================================================
		
		** 
		** (Relevant only when running on a Microsoft Windows operating system.) 
		** Specifies the default unzip directory path to appear 
		** in the user-interface dialog box when the Windows-based self-extracting EXE is run.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE exedefaultdir_assign		&& Assign method used to hold a reference to the EXEDefaultDir property.
		*==============================================================================
