	HIDDEN PROCEDURE laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*==============================================================================
		* Method:            LastStringResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastStringResult of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the last string result in text format.
		* Returns:           
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE loadtype3		&& The server-side should call this method with the Type 3 message received from the client. The LoadType3 method sets the following properties: Username, Domain, Workstation, and ClientChallenge, all of which are embedded within the Type 3 message.
		*==============================================================================
		* Method:            LoadType3
		* Purpose:           The server-side should call this method 
		*                    with the Type 3 message received from the client.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcType3Message, a Type 3 message.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/16/2022
		*==============================================================================
		
		**
		** The server-side should call this method with the Type 3 message received from the client. 
		** The LoadType3 method sets the following properties: Username, Domain, Workstation, 
		** and ClientChallenge, all of which are embedded within the Type 3 message.
		**
		** The server-side code may then use the Username to lookup the associated password 
		** and then it will itself call the GenType3 method to do the same computation 
		** as done by the client. The server then compares it's computed Type 3 message 
		** with the Type 3 message received from the client. If the Type 3 messages 
		** are exactly the same, then it must be that the client used the correct password, 
		** and therefore the client authentication is successful.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcType3Message AS Character
		
		LOCAL loChilkatObject AS CHILKAT_NTLM_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      STORE m.loChilkatObject.LoadType3(m.tcType3Message) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_NTLM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE netbioscomputername_access		&& Access method used to retrieve the Chilkat NTLM NetBIOSComputerName property.
		*==============================================================================
		* Method:            NetBIOSComputerName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat NTLM NetBIOSComputerName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NetBIOSComputerName
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Optional. This is information that would be set by the server for inclusion 
		** in the "Target Info" internal portion of the Type 2 message. 
		** Note: If any optional "Target Info" fields are provided, 
		** then both NetBiosComputerName and NetBiosDomainName must be provided.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

