	PROCEDURE setbinarybody		&& Sets the main body of the email to binary content of any type. The disposition can be an empty string, "inline", or "attachment".
		*==============================================================================
		* Method:            SetBinaryBody
		* Purpose:           Sets the main body of the email to binary content of any type. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqBinData -- the content type to filter on.
		*                    tcContentType -- the content type of the binary data.
		*                    tcDisposition -- the email disposition.
		*                    tcFileName -- the file name to draw from.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Sets the main body of the email to binary content of any type. 
		** The disposition can be an empty string, "inline", or "attachment". 
		** If a filename is specified, the disposition must be non-empty 
		** because the filename is an attribute of the content-disposition header field.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqBinData AS VarBinary, tcContentType AS Character, ;
		tcDisposition AS Character, tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, lcDisposition AS Character, ;
		lcFileName AS Character
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		STORE [] TO m.lcDisposition, m.lcFileName
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		lcDisposition = ALLTRIM(m.tcDisposition)
		lcFileName = m.tcFileName
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    ** Bad values passed among file name/disposition test
		    IF VARTYPE(m.lcDisposition) == T_CHARACTER ;
		    AND ((NOT EMPTY(m.lcDisposition)) ;
		    AND (NOT (INLIST(UPPER(m.lcDisposition), [INLINE], [ATTACHMENT]))) ;
		    OR (UPPER(m.lcDisposition) == [ATTACHMENT] ;
		    AND EMPTY(m.lcFileName)))
		
		      lcSecondParameter = lcMethod + [~] + lcPEMType
		
		      lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ELSE
		
		      loChilkatObject = .oChilkat
		
		      ** Have a good object test
		      IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		      AND (NOT ISNULL(m.loChilkatObject))
		
		        TRY
		
		          STORE ;
		          m.loChilkatObject.SetBinaryBody(m.tqBinData, m.tcContentType, ;
		          m.tcDisposition, m.tcFileName) TO m.liReturn, m.luReturn
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        .MissingObjectError(THIS)
		
		      ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		      AND (NOT ISNULL(m.loChilkatObject))
		      ** End have a good object test
		
		    ENDIF VARTYPE(m.lcDisposition) == T_CHARACTER ;
		    AND ((NOT EMPTY(m.lcDisposition)) ;
		    AND (NOT (INLIST(UPPER(m.lcDisposition), [INLINE], [ATTACHMENT]))) ;
		    OR (UPPER(m.lcDisposition) == [ATTACHMENT] ;
		    AND EMPTY(m.lcFileName)))
		    ** End bad values passed among file name/disposition test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setbodybd		&& Introduced in version 11.0.0. This function sets the email's main body to binary content. bd contains the binary data. disposition specifies the disposition and can be an empty string,
		*==============================================================================
		* Method:            SetBodyBd
		* Purpose:           This function sets the email's main body to binary content.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData -- a Chilkat binary data object.
		*                    tcContentType -- the content type.
		*                    tcDisposition -- specifies the disposition
		*                    tcFileName -- the file name, if relevant.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This function sets the email's main body to binary content. 
		** bd contains the binary data. disposition specifies the disposition 
		** and can be an empty string, inline, or attachment. 
		** If filename is provided, disposition must be specified 
		** because filename is an attribute of the content-disposition header.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		tcContentType AS Character, tcDisposition AS Character, tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetBodyBd(m.loChilkatBinData, ;
		        m.tcContentType, m.tcDisposition, m.tcFileName) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setcsp		&& Decremented function! Accepts a (decremented) Chilkat CSP reference.
		*==============================================================================
		* Method:            SetCSP
		* Purpose:           Decremented function! Accepts a (decremented) Chilkat CSP reference.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCSP, a Chilkat CSP object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Decremented function! Accepts a (decremented) Chilkat CSP reference.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCSP AS [Chilkat_9_5_0.Csp]
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loParkParameterCsp AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCsp AS [Chilkat_9_5_0.Csp], liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCsp = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCsp)
		
		    loChilkatCsp = m.loParkParameterCsp.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetCSP(m.loChilkatCSP) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCsp = ;
		    m.loParkParameterCsp.SetObject(m.toChilkatCsp, m.loChilkatCsp)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatCSP = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loParkParameterCsp = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
