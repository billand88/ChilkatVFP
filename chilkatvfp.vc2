	PROCEDURE renameremotefile		&& Renames a file or directory on the FTP server. To move a file from one directory to another on a remote FTP server, call this method and include the source and destination directory filepath.
		*==============================================================================
		* Method:            RenameRemoteFile
		* Purpose:           Renames a file or directory on the FTP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcExistingRemoteFilePath -- the remote file to rename.
		*                    tcNewRemoteFilePath -- the renamed file name.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/05/2022
		*==============================================================================
		
		**
		** Renames a file or directory on the FTP server.
		** To move a file from one directory to another on a remote FTP server,
		** call this method and include the source and destination directory filepath.
		** 
		** If the existingRemoteFilePath or newRemoteFilePath contains non-English characters, 
		** it may be necessary to set the DirListingCharset property equal to "utf-8". 
		** Please refer to the documentation for the DirListingCharset property.
		**
		** Fixed for Version 10.1: This method would not return the failed status 
		** (false) if the target (destination) file already exists.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcExistingRemoteFilePath AS Character, tcNewRemoteFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn 
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.RenameRemoteFile(m.tcExistingRemoteFilePath, ;
		      m.tcNewRemoteFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
