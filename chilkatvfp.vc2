	HIDDEN PROCEDURE smtpsessionlog_access		&& Access method used to retrieve the Chilkat MailMan SMTPSessionLog property.
		*==============================================================================
		* Method:            SMTPSessionLog_Access
		* Purpose:           Access method used to retrieve 
		*                    the SMTPSessionLog property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SMTPSessionLog
		* Date Added:        01/13/2022
		*==============================================================================
		
		** 
		** This string property accumulates the raw commands sent to the POP3 server, 
		** and the raw responses received from the POP3 server. 
		** This property is read-only, but it may be cleared by calling ClearSMTPSessionLog.
		**
		** Updated for Version 56: This property is changed to no longer log the 1st 2500 chars 
		** of the MIME BODY, but to instead just log the size (number of bytes) of the MIME BODY.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE smtpsessionlog_assign		&& Assign method used to hold a reference to the SMTPSessionLog property.
		*==============================================================================
		* Method:            SMTPSessionLog_Assign
		* Purpose:           Assign method used to hold
		*                    the SMTPSessionLog of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the POP3SessionLog property.
		* Returns:           
		* Date Added:        01/13/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE smtpsslservercertverified_access		&& Access method used to retrieve a reference to the SMTPSSLServerCertVerified property.
		*==============================================================================
		* Method:            SMTPSSLServerCertVerified_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan SMTPSSLServerCertVerified property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SMTPSSLServerCertVerified
		* Date Added:        01/13/2022
		*==============================================================================
		
		** 
		** If using SSL, this property will be set to 1 if the SMTP server's SSL certificate 
		** was verified when establishing the connection. Otherwise it is set to 0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE smtpsslservercertverified_assign		&& Assign method used to hold a reference to the SMTPSSLServerCertVerified property.
