DEFINE CLASS socket AS ibasechilkat OF "chilkatvfp.vcx" 		&& TCP socket component with SSL capability. Supports both asynchronous connect, accept, send, and read operations in all programming languages. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat Socket AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: acceptfailreason_access		&& Access method used to retrieve the Chilkat Socket AcceptFailReason property.
		*m: acceptfailreason_assign		&& Assign method used to hold a reference to the AcceptFailReason property.
		*m: acceptnext		&& Introduced in version 11.0.0. This method accepts the next incoming connection and stores the result in socket. maxWaitMs specifies the maximum wait time in milliseconds; set it to 0 for an indefinite wait. Returns 1 for success, 0 for failure.
		*m: acceptnextasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the AcceptNext method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: acceptnextconnection		&& Blocking call to accept the next incoming connection on the socket. maxWaitMs specifies the maximum time to wait (in milliseconds). Set this to 0 to wait indefinitely. If successful, a new socket object is returned.
		*m: acceptnextconnectionasync		&& Creates an asynchronous task to call the AcceptNextConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: addsslacceptableclientcadn		&& If this object is a server-side socket accepting SSL/TLS connections,and wishes to require a client-side certificate for authentication,then it should make one or more calls to this method to identify the CA's it will accept for client-side certificates.
		*m: alpnprotocol_access		&& Access method used to retrieve the Chilkat Socket ALPNProtocol property.
		*m: alpnprotocol_assign		&& Assign method used to hold a reference to the ALPNProtocol property.
		*m: asyncacceptabort		&& Undocumented method!  Call this to abort an asynchronous socket connect that is running in a background thread. Asynchronous connects are initiated by calling AsyncAcceptStart.
		*m: asyncacceptfinished_access		&& Access method used to retrieve the Chilkat Socket AsyncAcceptFinish property.
		*m: asyncacceptfinished_assign		&& Assign method used to hold a reference to the AsyncAcceptFinish property.
		*m: asyncacceptlog_access		&& Access method used to retrieve the Chilkat Socket AsyncAcceptLog property.
		*m: asyncacceptlog_assign		&& Assign method used to hold a reference to the AsyncAcceptLog property.
		*m: asyncacceptsocket		&& Undocumented method! Returns the socket object for the connection accepted asynchronously in a background thread (via AsyncAcceptStart). The connected socket can only be retrieved once.
		*m: asyncacceptstart		&& Undocumented method! Initiates a background thread to wait for and accept the next incoming TCP connection. The method will fail if an asynchronous operation is already in progress. The timeout (in milliseconds) is passed in maxWaitMs.
		*m: asyncacceptsuccess_access		&& Access method used to retrieve the Chilkat Socket AsyncAcceptStart property.
		*m: asyncacceptsuccess_assign		&& Assign method used to hold a reference to the AsyncAcceptSuccess property.
		*m: asyncdnsabort		&& Undocumented method! Aborts an asynchronous DNS lookup running in a background thread (started via the AsyncDnsStart method). This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncdnsfinished_access		&& Access method used to retrieve the Chilkat Socket AsyncDNSFinished property.
		*m: asyncdnsfinished_assign		&& Assign method used to hold a reference to the AsyncDNSFinished property.
		*m: asyncdnslog_access		&& Access method used to retrieve the Chilkat Socket AsyncDNSLog property.
		*m: asyncdnslog_assign		&& Assign method used to hold a reference to the AsyncDNSLog property.
		*m: asyncdnsresult_access		&& Access method used to retrieve the Chilkat Socket AsyncDNSResult property.
		*m: asyncdnsresult_assign		&& Assign method used to hold a reference to the AsyncDNSResult property.
		*m: asyncdnsstart		&& Undocumented method! Initiates a background thread to do a DNS query (i.e. to resolve a hostname to an IP address). This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncdnssuccess_access		&& Access method used to retrieve the Chilkat Socket AsyncDNSSuccess property.
		*m: asyncdnssuccess_assign		&& Assign method used to hold a reference to the AsyncDNSSuccess property.
		*m: asyncreceiveabort		&& Undocumented method! Aborts an asynchronous receive running in a background thread (started via one of the AsyncReceive* methods). This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncreceivebytes		&& Undocumented method! Initiates a background thread to receive bytes on an already-connected socket (ssl or non-ssl). This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncreceivebytesn		&& Undoucumented method! Initiates a background thread to receive exactly numBytes bytes on an already-connected socket (ssl or non-ssl). This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncreceivedbytes_access		&& Access method used to retrieve the Chilkat Socket AsyncReceivedBytes property.
		*m: asyncreceivedbytes_assign		&& Assign method used to hold a reference to the AsyncReceivedBytes property.
		*m: asyncreceivedstring_access		&& Access method used to retrieve the Chilkat Socket AsyncReceivedString property.
		*m: asyncreceivedstring_assign		&& Assign method used to hold a reference to the AsyncReceivedString property.
		*m: asyncreceivefinished_access		&& Access method used to retrieve the Chilkat Socket AsyncReceiveFinished property.
		*m: asyncreceivefinished_assign		&& Assign method used to hold a reference to the AsyncReceiveFinished property.
		*m: asyncreceivelog_access		&& Access method used to retrieve the Chilkat Socket AsyncReceiveLog property.
		*m: asyncreceivelog_assign		&& Assign method used to hold a reference to the AsyncReceiveLog property.
		*m: asyncreceivestring		&& Undocumented method!  Initiates a background thread to receive text on an already-connected socket (ssl or non-ssl). The component interprets the received bytes according to the charset specified in the StringCharset property.
		*m: asyncreceivesuccess_access		&& Access method used to retrieve the Chilkat Socket AsyncReceiveSuccess property.
		*m: asyncreceivesuccess_assign		&& Assign method used to hold a reference to the AsyncReceiveSuccess property.
		*m: asyncreceivetocrlf		&& Undocumented method! Initiates a background thread to receive text on an already-connected socket (ssl or non-ssl). The asynchronous receive does not complete until a CRLF is received.
		*m: asyncreceiveuntilmatch		&& Undocumented method! Initiates a background thread to receive text on an already-connected socket (ssl or non-ssl). The asynchronous receive does not complete until the exact string specified by matchStr is received.
		*m: asyncsendabort		&& Undocumented method! Aborts an asynchronous send running in a background thread (started via one of the AsyncSend* methods). This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncsendbytedata		&& Undocumented method! Initiates a background thread to send bytes on an already-connected socket (SSL/TLS or unencrypted). This method is redundant and identical to SendBytes.
		*m: asyncsendbytes		&& Undocumented method! Initiates a background thread to send bytes on an already-connected socket (ssl or non-ssl).This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*m: asyncsendfinished_access		&& Access method used to retrieve the Chilkat Socket AsyncSendFinished property.
		*m: asyncsendfinished_assign		&& Assign method used to hold a reference to the AsyncSendFinished property.
		*m: asyncsendlog_access		&& Access method used to retrieve the Chilkat Socket AsyncSendLog property.
		*m: asyncsendlog_assign		&& Assign method used to hold a reference to the AsyncSendLog property.
		*m: asyncsendstring		&& Undocumented method! Initiates a background thread to send text on an already-connected socket (ssl or non-ssl). Before sending, the stringToSend is first converted (if necessary) to the charset specified by the StringCharset property.
		*m: asyncsendsuccess_access		&& Access method used to retrieve the Chilkat Socket AsyncSendSuccess property.
		*m: asyncsendsuccess_assign		&& Assign method used to hold a reference to the AsyncSendSuccessproperty.
		*m: bandwidththrottledown_access		&& Access method used to retrieve the Chilkat Socket BandwidthThrottleDown property.
		*m: bandwidththrottledown_assign		&& Assign method used to hold a reference to the BandwidthThrottleDown property.
		*m: bandwidththrottleup_access		&& Access method used to retrieve the Chilkat Socket BandwidthThrottleUp property.
		*m: bandwidththrottleup_assign		&& Assign method used to hold a reference to the BandwidthThrottleUp property.
		*m: bigendian_access		&& Access method used to retrieve the Chilkat Socket BigEndian property.
		*m: bigendian_assign		&& Assign method used to hold a reference to the BigEndian property.
		*m: bindandlisten		&& Binds a TCP socket to a port and configures it to listen for incoming connections. The size of the backlog is passed in backLog
		*m: bindandlistenasync		&& Creates an asynchronous task to call the BindAndListen method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: bindandlistenportrange		&& Introduced in version 9.5.0.69. Binds a TCP socket to an unused port within a port range (beginPort to endPort) and configures it to listen for incoming connections. The size of the backlog is passed in endPort.
		*m: bindandlistenportrangeasync		&& Introduced in version 9.5.0.69. Creates an asynchronous task to call the BindAndListenPortRange method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: buildhttpgetrequest		&& Introduced in version 9.5.0.35. Convenience method for building a simple HTTP GET request from a URL. Returns Nothing on failure
		*m: checkwriteable		&& Determines if the socket is writeable.
		*m: checkwriteableasync		&& Creates an asynchronous task to call the CheckWriteable method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: clearsessionlog		&& Clears the contents of the SessionLog property.
		*m: clientipaddress_access		&& Access method used to retrieve the Chilkat Socket ClientIPAddress property.
		*m: clientipaddress_assign		&& Assign method used to hold a reference to the ClientIPAddress property.
		*m: clientport_access		&& Access method used to retrieve the Chilkat Socket ClientPort property.
		*m: clientport_assign		&& Assign method used to hold a reference to the ClientPort property.
		*m: clonesocket		&& Introduced in version 9.5.0.47. Creates a copy that shares the same underlying TCP (or SSL/TLS) connection. This allows for simultaneous reading/writing by different threads on the socket.
		*m: close		&& Cleanly terminates and closes a TCP, TLS, or SSH channel connection. Returns 1 for success, 0 for failure.
		*m: closeasync		&& Creates an asynchronous task to call the Close method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: connect		&& Establishes a secure SSL/TLS or a plain non-secure TCP connection with a remote host:port. This is a blocking call. The maximum wait time (in milliseconds) is passed in maxWaitMs.
		*m: connectasync		&& Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: connectfailreason_access		&& Access method used to retrieve the Chilkat Socket ConnectFailReason property.
		*m: connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*m: convertfromssl		&& Closes the secure (TLS/SSL) channel leaving the socket in a connected state where data sent and received is unencrypted. Returns 1 for success, 0 for failure.
		*m: convertfromsslasync		&& Creates an asynchronous task to call the ConvertFromSsl method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: converttossl		&& Converts a non-SSL/TLS connected socket to a secure channel using TLS/SSL. Returns 1 for success, 0 for failure.
		*m: converttosslasync		&& Creates an asynchronous task to call the ConvertToSsl method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread
		*m: debugconnectdelayms_access		&& Access method used to retrieve the Chilkat Socket DebugConnectDelayMs property.
		*m: debugconnectdelayms_assign		&& Assign method used to hold a reference to the DebugConnectDelayMs property.
		*m: debugdnsdelayms_access		&& Access method used to retrieve the Chilkat Socket DebugDNSDelayMs property.
		*m: debugdnsdelayms_assign		&& Assign method used to hold a reference to the DebugDNSDelayMs property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Socket DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: dispose		&& To be documented soon... May be called when finished with the object to free/dispose of any internal resources held by the object.
		*m: dnscacheclear		&& Introduced in version 9.5.0.38. Clears the Chilkat-wide in-memory hostname-to-IP address DNS cache. Chilkat automatically maintains this in-memory cache to prevent redundant DNS lookups.
		*m: dnslookup		&& Performs a DNS query to resolve a hostname to an IP address. The IP address is returned if successful. The maximum time to wait (in milliseconds) is passed in maxWaitMs. To wait indefinitely, set maxWaitMs = 0.
		*m: dnslookupasync		&& Creates an asynchronous task to call the DnsLookup method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread
		*m: dupsocket		&& Introduced in version 11.0.0. Creates a copy in dest that uses the same underlying TCP or SSL/TLS connection as the caller, enabling simultaneous reading and writing by different threads on the socket. Returns 1 for success, 0 for failure.
		*m: elapsedseconds_access		&& Access method used to retrieve the Chilkat Socket ElapsedSeconds property.
		*m: elapsedseconds_assign		&& Assign method used to hold a reference to the ElapsedSeconds property.
		*m: getadaptersaddresses		&& Introduced in version 10.1.3. Retrieves network adapter information, including IP addresses (IPv4 and IPv6) and MAC addresses. The information is returned in json. Returns 1 for success, 0 for failure.
		*m: getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called on this object instance. For many methods, there is no information.
		*m: getmycert		&& Returns the digital certificate to be used for SSL connections. This method would only be called by an SSL server application. The SSL certificate is initially specified by calling InitSslServer. Returns Nothing on failure
		*m: getmyservercert		&& Introduced in version 11.0.0. Returns in cert the digital certificate for TLS connections. Returns 1 for success, 0 for failure.
		*m: getrcvdclientcert		&& Introduced in version 11.0.0. This method retrieves the Nth client certificate received during an SSL/TLS handshake on the server side of the connection. Returns 1 for success, 0 for failure.
		*m: getreceivedclientcert		&& Returns the Nth client certificate received during an SSL/TLS handshake. This method only applies to the server-side of an SSL/TLS connection. The 1st client certificate is at index 0.
		*m: getservercert		&& Introduced in version 11.0.0. This method returns the digital certificate of the remote SSL server for the current SSL connection on the client side. Returns 1 for success, 0 for failure.
		*m: getsslacceptableclientcadn		&& This method may be called to get the Distinguished Name (DN) of each acceptable CA. The index should range from 0 to NumSslAcceptableClientCAs - 1. Returns Nothing on failure
		*m: getsslservercert		&& Returns the SSL server's digital certificate. This method would only be called by the client-side of an SSL connection. It returns the certificate of the remote SSL server for the current SSL connection.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat Socket HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: httpproxyauthmethod_access		&& Access method used to retrieve the Chilkat Socket HTTPProxyAuthMethod property.
		*m: httpproxyauthmethod_assign		&& Assign method used to hold a reference to the HTTPProxyAuthMethod property.
		*m: httpproxydomain_access		&& Access method used to retrieve the Chilkat Socket HTTPProxyDomain property.
		*m: httpproxydomain_assign		&& Assign method used to hold a reference to the HTTPProxyDomain property.
		*m: httpproxyforhttp_access		&& Access method used to retrieve the Chilkat Socket HTTPProxyForHTTP property.
		*m: httpproxyforhttp_assign		&& Assign method used to hold a reference to the HTTPProxyForHTTP property.
		*m: httpproxyhostname_access		&& Access method used to retrieve the Chilkat Socket HTTPProxyHostName property.
		*m: httpproxyhostname_assign		&& Assign method used to hold a reference to the HTTPProxyHostName property.
		*m: httpproxypassword_access		&& Access method used to retrieve the Chilkat Socket HTTPProxyPassword property.
		*m: httpproxypassword_assign		&& Assign method used to hold a reference to the HTTPProxyPassword property.
		*m: httpproxyport_access		&& Access method used to retrieve the Chilkat Socket HTTPProxyPort property.
		*m: httpproxyport_assign		&& Assign method used to hold a reference to the HTTPProxyPort property.
		*m: httpproxyusername_access		&& Access method used to retrieve the Chilkat Socket HTTPProxyUserName property.
		*m: httpproxyusername_assign		&& Assign method used to hold a reference to the HTTPProxyUserName property.
		*m: initsslserver		&& SSL Server applications should call this method with the SSL server certificate to be used for SSL connections. It should be called prior to accepting connections.
		*m: isconnected_access		&& Access method used to retrieve the Chilkat Socket IsConnected property.
		*m: isconnected_assign		&& Assign method used to hold a reference to the IsConnected property.
		*m: isunlocked		&& Undocumented method! Returns true if the component is unlocked.
