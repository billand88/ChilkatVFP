		STORE 0 TO m.liReturn, m.luReturn, m.liLocalTime
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liLocalTime = .LogicalToBit(m.tuLocalTime)
		
		    TRY
		
		      STORE m.loChilkatObject.SetFromUnixTime(m.liLocalTime, m.tiUnixDate) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ulidgenerate		&& Introduced in version 9.5.0.94. Generates and returns a new ULID using this object's date/time value. bLocal indicates whether to use local time or UTC time. Returns Nothing on failure.
		*==============================================================================
		* Method:            ULIDGenerate
		* Purpose:           Generates and returns a new ULID using this object's date/time value. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuLocalTime, whether or not the returned time 
		*                    is local or UTC time.
		* Returns:           A character value representing the ULID format.
		* Date Added:        02/07/2023
		* Note:              (ULID - Universally Unique Lexicographically Sortable Identifier)
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.94
		**
		** Generates and returns a new ULID using this object's date/time value. 
		** bLocal indicates whether to use local time or UTC time.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tuLocalTime AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liLocalTime AS Integer, lcULID AS Character
		
		STORE 0 TO m.liLocalTime, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcULID = []
		llImplemented = .F.
		liIntroducedInBuild = 94
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liLocalTime = .LogicalToBit(m.tuLocalTime)
		
		      TRY
		
		        lcULID = m.loChilkatObject.ULIDGenerate(m.liLocalTime)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcULID 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ulidincrement		&& Introduced in version 9.5.0.94. Increments the ULID that is passed in ulid.
		*==============================================================================
		* Method:            ULIDIncrement
		* Purpose:           Increments the ULID that is passed in ulid.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat StringBuilder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/07/2023
		* Note:              (ULID - Universally Unique Lexicographically Sortable Identifier)
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.94
		**
		** Increments the ULID that is passed in ulid.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder 
		
		llImplemented = .F.
		liIntroducedInBuild = 94
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ULIDIncrement(m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.liReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ulidvalidate		&& Introduced in version 9.5.0.94. Validates the ulid. Returns 1 if the ulid is valid, otherwise returns 0. Returns 1 for success, 0 for failure.
		*==============================================================================
