		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE jsontypeof		&& Introduced in version 9.5.0.68
		*==============================================================================
		* Method:            JSONTypeOf
		* Purpose:           Returns the integer at the specified jsonPath.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSONPath, the JSON path.
		* Returns:           The JSON Type value, or -1.
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.68
		** Returns the type of data at the given jsonPath. Possible return values are:
		** 
		** 1 - string
		** 2- number
		** 3- object
		** 4- array
		** 5- boolean
		** 6- null
		** 
		** Fix for version 82: The method returned -1 
		** for inner nodes rather than the correct value of 3. 
		**
		** Returns -1 if no member exists at the given jsonPath.
		**
		
		LPARAMETERS tcJSONPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, liJSONType AS Integer
		
		STORE 0 TO m.liJSONType, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 68
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liJSONType = m.loChilkatObject.JSONTypeOf(m.tcJSONPath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liJSONType
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

