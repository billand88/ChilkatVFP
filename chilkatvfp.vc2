	HIDDEN PROCEDURE percentdonescale_access		&& Access method used to retrieve the Chilkat IMAP PercentDoneScale property.
		*==============================================================================
		* Method:            PercentDoneScale_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP PercentDoneScale property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PercentDoneScale
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** This property is only valid in programming environment and languages that allow for event callbacks.
		**
		** Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks. 
		** The defaut value of 100 means that at most 100 event PercentDone callbacks will occur 
		** in a method that (1) is event enabled and (2) is such that it is possible 
		** to measure progress as a percentage completed. This property may be set to larger numbers 
		** to get more fine-grained PercentDone callbacks. For example, setting this property equal 
		** to 1000 will provide callbacks with .1 percent granularity. 
		** For example, a value of 453 would indicate 45.3% competed. 
		** This property is clamped to a minimum value of 10, and a maximum value of 100000.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*==============================================================================
		* Method:            PercentDoneScale_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat IMAP PercentDoneScale property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the PercentDoneScale property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = [PercentDoneScale]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE port_access		&& Access method used to retrieve the Chilkat IMAP Port property.
		*==============================================================================
		* Method:            Port_Access
		* Purpose:           Access method used to retrieve the Chilkat IMAP Port property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Port
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** The IMAP port number. If using SSL, be sure to set this to the IMAP SSL port number, 
		** which is typically port 993. (If this is the case, make sure 
		** you also set the Ssl property = 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE port_assign		&& Assign method used to hold a reference to the Port property.
