	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat MIME LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        06/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqValue, the last binary result.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [VariantReadOnly]
		
		THIS.CallAssignObject(m.tqValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
	ENDPROC

	PROCEDURE lastdecryptcert		&& Introduced in version 11.0.0. Returns the Nth certificate found when decrypting. The NumDecryptCerts property contains the number of certificates. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LastDecryptCert
		* Purpose:           Returns the Nth certificate found when decrypting. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the certificate index value.
		*                    toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		** 
		** Introduced in version 11.0.0
		**
		** Returns the Nth certificate found when decrypting. 
		** The NumDecryptCerts property contains the number of certificates.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiIndex AS Integer, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		     loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.LastDecryptCert(m.tiIndex, m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lasterrorhtml_access		&& Access method used to retrieve the Chilkat MIME LastErrorHTML property.
		*==============================================================================
