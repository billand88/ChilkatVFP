	PROCEDURE startkeyboardauth		&& Introduced in version 9.5.0.88. Begins keyboard-interactive authentication with the SSH server. Returns an XML string providing the name, instruction, and prompts.
		*==============================================================================
		* Method:            StartKeyboardAuth
		* Purpose:           Begins keyboard-interactive authentication with the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLogin -- the login information.
		* Returns:           XML string of information.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		**
		** Begins keyboard-interactive authentication with the SSH server. 
		** Returns an XML string providing the name, instruction, and prompts. 
		** The XML has the following format:
		** 
		**    <infoRequest numPrompts="N">
		**       <name>name_string</name>
		**       <instruction>instruction_string</instruction>
		**       <prompt1 echo="1_or_0">prompt_string</prompt1>
		**       ...
		**       <promptN echo="1_or_0">prompt_string</promptN>
		**   </infoRequest>
		** 
		** If the authentication immediately succeeds because no password is required, 
		** or immediately fails, the XML response can be:
		** 
		** <success>success_message</success>
		** 
		** or
		** 
		** <error>error_message</error>
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLogin AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		lcXMLString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		lcXMLString = []
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcXMLString = m.loChilkatObject.StartKeyboardAuth(m.tcLogin)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXMLString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE startkeyboardauthasync		&& Introduced in version 9.5.0.88. Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            StartKeyboardAuthAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the StartKeyboardAuth method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLogin -- the login information.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		**
		** Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLogin AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.StartKeyboardAuthAsync(m.tcLogin)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE symlink		&& Introduced in version 9.5.0.71. Create a symbolic link from oldpath to newpath on the server filesystem. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SymLink
		* Purpose:           Create a symbolic link from oldpath 
		*                    to newpath on the server filesystem.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOldPath -- the old path of the file
		*                    tcNewPath -- the new path of the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Create a symbolic link from oldpath to newpath on the server filesystem.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcOldPath AS Character, tcNewPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SymLink(m.tcOldPath, m.tcNewPath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

