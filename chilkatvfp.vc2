		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE compressfile		&& Compresses a file to create a BZip2 compressed file (.bz2). Note: Both inFilename and toPath should be relative or absolute file paths (not just a path to a directory). For example "someDir1/someDir2/myFile.txt" or "c:/someDir1/myFile.bz2".
		*==============================================================================
		* Method:            CompressFile
		* Purpose:           Compresses a file to create a BZip2 compressed file (.bz2).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDecompressedFilePath, the path to the file to compress.
		*                    tcBz2FilePath, the path to the written .Bz2 file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Compresses a file to create a BZip2 compressed file (.bz2).
		**
		** Note: Both inFilename and toPath should be relative or absolute file paths 
		** (not just a path to a directory). For example "someDir1/someDir2/myFile.txt" 
		** or "c:/someDir1/myFile.bz2".
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcDecompressedFilePath AS Character, tcBz2FilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_BZ2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CompressFile(m.tcDecompressedFilePath, ;
		      m.tcBz2FilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BZ2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

