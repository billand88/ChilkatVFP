		* Parameters:        
		* Returns:           The public key in binary DER format
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Undocumented method! This method is decremented. 
		** 
		** Applications should call GetDer with preference for PKCS1 instead.
		**
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		lqDERFormattedPublicKey AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDERFormattedPublicKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        lqDERFormattedPublicKey = m.loChilkatObject.GetRSADER()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDERFormattedPublicKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getxml		&& Gets the public key in XML format. The format depends on the key type. The key parts indicated by "..." are base64 encoded.
		*==============================================================================
		* Method:            GetXML
		* Purpose:           Gets the public key in XML format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The public key in XML format.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Gets the public key in XML format. The format depends on the key type. 
		** The key parts indicated by "..." are base64 encoded.
		** 
		** RSA public keys have this XML format:
		** 
		**   <RSAPublicKey>
		**     <Modulus>...</Modulus>
		**     <Exponent>...</Exponent>
		**   </RSAPublicKey>
		** 
		** DSA public keys have this XML format:
		** 
		**   <DSAPublicKey>
		**     <P>...</P>
		**     <Q>...</Q>
		**     <G>...</G>
		**     <Y>...</Y>
		**   </DSAPublicKey>
		**
		** ECC public keys have this XML format:
		**
		** <ECCPublicKey curve="CURVE_NAME" x="HEX_DATA" y="HEX_DATA">...</ECCPublicKey>
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, ;
		loException AS Exception, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXML = m.loChilkatObject.GetXML()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE keysize_access		&& Access method used to retrieve the Chilkat PublicKey KeySize property.
		*==============================================================================
		* Method:            KeySize_Access
		* Purpose:           Access method used to retrieve the Chilkat PublicKey KeySize property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.KeySize
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** Fixed for version 76: This property (indicating the size of the key in bits) 
		** did not always properly return a size that was a multiple of 8 bits.
		**
		** Gets the size (in bits) of the public key. For example: 1024, 2048, etc.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 67
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE keysize_assign		&& Assign method used to hold a reference to the KeySize property.
		*==============================================================================
		* Method:            KeySize_Assign
		* Purpose:           Assign method used to hold 
		*                    the KeySize property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the KeySize property.
		* Returns:           
		* Date Added:        06/20/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 67
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

