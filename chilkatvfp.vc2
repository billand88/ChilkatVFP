		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getpersoninfo		&& Returns a piece of information about a person. To get the 2nd author's name, call GetPersonInfo("author",1,"name"). Returns Nothing on failure.
		*==============================================================================
		* Method:            GetPersonInfo
		* Purpose:           Returns a piece of information about a person.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTag -- the tag name to reference.
		*                    tiIndex -- the index value of the tag to reference.
		*                    tcTag2 -- the second tag name to reference.
		* Returns:           The value of the person info.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Returns a piece of information about a person. 
		** To get the 2nd author's name, call GetPersonInfo("author",1,"name").
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTag AS Character, tiIndex AS Character, tcTag2 AS Character
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Atom], ;
		loException AS Exception, lcValue AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcValue = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcValue = m.loChilkatObject.GetPersonInfo(m.tcTag, m.tiIndex, m.tcTag2)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Atom])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE gettopattr		&& Returns the value of an attribute on the top-level XML node. The tag of a top-level Atom XML node is typically "feed" or "entry", and it might have attributes such as "xmlns" and "xml:lang". Returns Nothing on failure.
