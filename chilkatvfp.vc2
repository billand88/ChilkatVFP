	HIDDEN PROCEDURE utcoffset_access		&& Assign method used to hold the Chilkat CkDateTime UTCOffset property.
		*==============================================================================
		* Method:            UTCOffset_Access
		* Purpose:           Access method used to retrieve the Chilkat Email UTCOffset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UTCOffset
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** For the current system's timezone, returns the number of seconds offset 
		** from UTC for this date/time. The offset includes daylight savings adjustment. 
		** Local timezones west of UTC return a negative offset.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE utcoffset_assign		&& Assign method used to hold the Chilkat CkDateTime UTCOffset property.
		*==============================================================================
		* Method:            UTCOffset_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the UTCOffset property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the UTCOffset property.
		* Returns:           
		* Date Added:        07/26/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat CkDateTime VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/26/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold the Chilkat CkDateTime VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/26/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS ckstring AS ibasechilkat OF "chilkatvfp.vcx" 		&& The Chilkat string class.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: ansicharat		&& Returns the ASCII value of the Nth char in the string. The 1st char is at index 0.
		*m: append		&& The str is appended to end of this instance.
		*m: appenddaterfc3339		&& Appends a date/time string in RFC 3339 format to the end of this instance.
		*m: appenddaterfc822		&& The dateTime is appended in RFC 822 format to the end of this instance.
		*m: appendencoded		&& Appends characters from an encoded string. The encoding may be "base64", "hex", "url", or "quoted-printable".
		*m: appendmultibyte		&& Appends characters from a byte array. mbtext contains the character data. The input bytes are interpreted according to the character encoding specified by charsetEncoding.
		*m: appendtofile		&& Appends the contents of the string to a file. The string is first converted to the character encoding specified by charsetEncoding before being appended to the file.
		*m: beginswith		&& Returns 1 if the string begins with str. Otherwise returns 0. This method is case sensitive.
		*m: chopafter		&& Truncates the string after the 1st occurrence of findStr. If findStr is not present, nothing is truncated.
		*m: chopbefore		&& Truncates the string before the 1st occurrence of findStr. If findStr is not present, nothing is truncated.
		*m: clear		&& Clears the string. After calling this method, the string contains 0 characters.
		*m: contains		&& Returns 1 if substr is present in the string (case sensitive), otherwise returns 0.
		*m: emitmultibyte		&& Converts the string to a byte array using the character encoding specified by charsetEncoding. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: endswith		&& Returns 1 if the string ends with substr (case-sensitive). Otherwise returns 0.
		*m: getencoded		&& Returns the character string in an encoding use the charsetEncoding specified. The binaryEncoding may be "base64", "hex", "url", or "quoted-printable".
		*m: htmlentitydecode		&& Decodes any HTML entities found in the string.
		*m: htmlentityencode		&& HTML entity encodes all special characters. (Those characters that might require HTML entity encoding.)
		*m: lastansichar		&& Returns the ASCII value of the last character in the string.
		*m: left2		&& Returns a string that is the leftmost numChars of this instance. Returns Nothing on failure.
		*m: length		&& Returns the length, in characters, of the string.
		*m: loadfile		&& Loads an entire text file into the string object. The character encoding of the text file is specified by charsetEncoding. This method allows for text files in any charset to be loaded: utf-8, Unicode, Shift_JIS, iso-8859-1, etc.
		*m: loadxmldoc		&& Loads an XML document into the CkString. The xmlDocumentBytes contains the raw bytes of the XML document.
		*m: matches		&& Returns 1 if the string matches the strPattern, which may contain one or more asterisk wildcard characters. Case-sensitivity is controlled by , where 1 = case sensitive, 0 = case insensitive.
		*m: mid		&& Same as the VB/VBScript "Mid" function, except that the 1st char is at index 0 (i.e. it is not 1-based). Returns a substring of length numChars starting at index. Returns Nothing on failure.
		*m: numarabic_access		&& Access method used to retrieve the Chilkat CkString NumArabic property.
		*m: numarabic_assign		&& Assign method used to hold a reference to the NumArabic property.
		*m: numascii_access		&& Access method used to retrieve the Chilkat CkString NumASCII property.
		*m: numascii_assign		&& Assign method used to hold a reference to the NumASCII property.
		*m: numcentraleuro_access		&& Access method used to retrieve the Chilkat CkString NumCentralEuro property.
		*m: numcentraleuro_assign		&& Assign method used to hold a reference to the NumCentralEuro property.
		*m: numchars_access		&& Access method used to retrieve the Chilkat CkString NumChars property.
		*m: numchars_assign		&& Assign method used to hold a reference to the NumChars property.
		*m: numchinese_access		&& Access method used to retrieve the Chilkat CkString NumChinese property.
		*m: numchinese_assign		&& Assign method used to hold a reference to the NumChinese property.
		*m: numcyrillic_access		&& Access method used to retrieve the Chilkat CkString NumCyrillic property.
		*m: numcyrillic_assign		&& Assign method used to hold a reference to the NumCyrillic property.
		*m: numgreek_access		&& Access method used to retrieve the Chilkat CkString NumGreek property.
		*m: numgreek_assign		&& Assign method used to hold a reference to the NumGreek property.
		*m: numhebrew_access		&& Access method used to retrieve the Chilkat CkString NumHebrew property.
		*m: numhebrew_assign		&& Assign method used to hold a reference to the NumHebrew property.
		*m: numjapanese_access		&& Access method used to retrieve the Chilkat CkString NumJapanese property.
		*m: numjapanese_assign		&& Assign method used to hold a reference to the NumJapanese property.
		*m: numkorean_access		&& Access method used to retrieve the Chilkat CkString NumKorean property.
		*m: numkorean_assign		&& Assign method used to hold a reference to the NumKorean property.
		*m: numlatin_access		&& Access method used to retrieve the Chilkat CkString NumLatin property.
		*m: numlatin_assign		&& Assign method used to hold a reference to the NumLatin property.
		*m: numthai_access		&& Access method used to retrieve the Chilkat CkString NumThai property.
		*m: numthai_assign		&& Assign method used to hold a reference to the NumThai property.
		*m: parsedaterfc3339		&& Converts the date string (in RFC 3339 format) to a Date type.
		*m: parsedaterfc822		&& Converts the date string (in RFC 822 format) to a Date type.
		*m: pluralize		&& Pluralizes an English word.
		*m: prepend		&& Prepends str to this instance.
		*m: punydecode		&& Introduced in version 9.5.0.52. In-place decodes the string from punycode.
		*m: punyencode		&& Introduced in version 9.5.0.52. In-place encodes the string to punycode.
		*m: removeansichar		&& Removes all occurrences of ch from the string.
		*m: replaceall		&& Replaces all occurrences of findStr with replaceStr. (case sensitive)
		*m: replaceansichar		&& Replaces all occurrences of findCh with replaceCh.
		*m: replacefirst		&& Replaces the first occurrence of findStr with replaceStr. (case sensitive)
		*m: right		&& Returns a string that is the rightmost numChars of this instance. Returns Nothing on failure.
		*m: savetofile		&& Saves the string to a file, using the character encoding specified by charsetEncoding. This method allows for the string to be saved using character encodings such as "utf-8", "Unicode", "Shift-JIS", or anything else...
		*m: shorten		&& Removes the final numChars from the string.
		*m: sizeansi_access		&& Access method used to retrieve the Chilkat CkString SizeAnsi property.
		*m: sizeansi_assign		&& Assign method used to hold a reference to the SizeAnsi property.
		*m: sizeutf8_access		&& Access method used to retrieve the Chilkat CkString SizeUTF8 property.
		*m: sizeutf8_assign		&& Assign method used to hold a reference to the SizeUTF8 property.
		*m: strcomp		&& Lexicographically compares two strings. Returns 0 if both strings are equal.
		*m: striphtml		&& Strips HTML tags from a string.
		*m: str_access		&& Access method used to retrieve the Chilkat CkString Str property.
		*m: str_assign		&& Assign method used to hold a reference to the Str property.
		*m: tocrlf		&& Converts all line endings to CRLF.
		*m: tolf		&& Converts all line endings to bare-LF (Unix/Linux style).
		*m: trim		&& Trim SPACE and Tab characters from both ends of the string.
		*m: trim2		&& Trim SPACE, Tab, CR, and LF characters from both ends of the string.
		*m: triminside		&& Replaces all tabs, CR's, and LF's, with SPACE chars, and removes extra SPACE's so there are no occurrences of more than one SPACE char in a row.
		*m: unpluralize		&& Unpluralizes an English word.
		*p: numarabic		&& Introduced in version 9.5.0.25. The number of Arabic characters contained in this string.
		*p: numascii		&& Introduced in version 9.5.0.25. The number of us-ascii characters contained in this string.
		*p: numcentraleuro		&& ntroduced in version 9.5.0.25. The number of Central European and Eastern European characters found in this string. These are characters specific to Polish, Czech, Slovak, Hungarian, Slovene, Croatian, Serbian (Latin script), Romanian and Albanian.
		*p: numchars		&& To be documented soon...
		*p: numchinese		&& Introduced in version 9.5.0.25. The number of Chinese characters contained in this string.
		*p: numcyrillic		&& Introduced in version 9.5.0.25. The number of Cyrillic characters contained in this string.
		*p: numgreek		&& Introduced in version 9.5.0.25. The number of Greek characters contained in this string.
		*p: numhebrew		&& Introduced in version 9.5.0.25. The number of Hebrew characters contained in this string.
		*p: numjapanese		&& Introduced in version 9.5.0.25. The number of Japanese characters contained in this string.
		*p: numkorean		&& Introduced in version 9.5.0.25. The number of Korean characters contained in this string.
		*p: numlatin		&& Introduced in version 9.5.0.25. The number of Latin characters contained in this string. Latin characters include all major Western European languages, such as German, Spanish, French, Italian, Nordic languages, etc.
		*p: numthai		&& Introduced in version 9.5.0.25. The number of Thai characters contained in this string.
		*p: sizeansi		&& The size, in bytes, of the ANSI encoding of the string.
		*p: sizeutf8		&& The size, in bytes, of the utf-8 encoding of the string.
		*p: str		&& The string value of this object.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = CkString
		Name = "ckstring"
		numarabic = 0
