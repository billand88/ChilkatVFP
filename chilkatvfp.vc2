	PROCEDURE setpayloadsb		&& Introduced in version 9.5.0.66. Sets the JWS payload from the contents of sbPayload. The charset specifies the byte representation to be used for the string that is to be the payload. (For example, "utf-8", "windows-1252", "utf-16", etc.).
		*==============================================================================
		* Method:            SetPayloadSb
		* Purpose:           Sets the JWS payload from the contents of payload.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat String Builder object.
		*                    tcCharset, the charset of the payload.
		*                    tuIncludeBOM, whether or not to include the BOM.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Sets the JWS payload from the contents of payload. 
		** The charset specifies the byte representation to be used 
		** for the string that is to be the payload. 
		** (For example, "utf-8", "windows-1252", "utf-16", etc.). 
		** If includeBom is 1, then the byte-order-mark (BOM), also known as preamble, 
		** if one exists for the given charset, is included in the payload. 
		** Normally, includeBom should be set to 0.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tcCharset AS Character, tuIncludeBOM AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		luReturn AS Unknown, liIncludeBOM AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeBOM, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeBOM = .LogicalToBit(m.tuIncludeBOM)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetPayloadSb(m.loChilkatStringBuilder, ;
		        m.tcCharset, m.liIncludeBOM) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setprivatekey		&& Introduced in version 9.5.0.66. Sets the private key (ECC or RSA) to be used in creating a signature for the following algorithms: RS256, RS384, RS512, ES256, ES384, ES512, PS256, PS384, PS512.
		*==============================================================================
		* Method:            SetPrivateKey
		* Purpose:           Sets the private key (ECC or RSA) to be used in creating a signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the signature array value.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Sets the private key (ECC or RSA) to be used in creating a signature 
		** for the following algorithms:
		**
		**   RS256
		**   RS384
		**   RS512
		**   ES256
		**   ES384
		**   ES512
		**   PS256
		**   PS384
		**   PS512
		** 
		** The JWS algorithms are described in RFC 7518, section 3.1. Here is a summary:
		** 
		**       +--------------+-------------------------------+--------------------+
		**       | "alg" Param  | Digital Signature or MAC      | Implementation     |
		**       | Value        | Algorithm                     | Requirements       |
		**       +--------------+-------------------------------+--------------------+
		**       | HS256        | HMAC using SHA-256            | Required           |
		**       | HS384        | HMAC using SHA-384            | Optional           |
		**       | HS512        | HMAC using SHA-512            | Optional           |
		**       | RS256        | RSASSA-PKCS1-v1_5 using       | Recommended        |
		**       |              | SHA-256                       |                    |
		**       | RS384        | RSASSA-PKCS1-v1_5 using       | Optional           |
		**       |              | SHA-384                       |                    |
		**       | RS512        | RSASSA-PKCS1-v1_5 using       | Optional           |
		**       |              | SHA-512                       |                    |
		**       | ES256        | ECDSA using P-256 and SHA-256 | Recommended+       |
		**       | ES384        | ECDSA using P-384 and SHA-384 | Optional           |
		**       | ES512        | ECDSA using P-521 and SHA-512 | Optional           |
		**       | PS256        | RSASSA-PSS using SHA-256 and  | Optional           |
		**       |              | MGF1 with SHA-256             |                    |
		**       | PS384        | RSASSA-PSS using SHA-384 and  | Optional           |
		**       |              | MGF1 with SHA-384             |                    |
		**       | PS512        | RSASSA-PSS using SHA-512 and  | Optional           |
		**       |              | MGF1 with SHA-512             |                    |
		**       | none         | No digital signature or MAC   | Optional           |
		**       |              | performed                     |                    |
		**       +--------------+-------------------------------+--------------------+
		**
		** Enhancement for Version 67: 
		** Added RSASSA-PSS and RSAES-OAEP capabilities for signed and encrypted email.  
		** 
		** Enhancement for Version 83: Improved support for ECDSA certs.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetPrivateKey(m.tiIndex, m.loChilkatPrivateKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

