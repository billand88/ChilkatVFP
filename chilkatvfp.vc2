	PROCEDURE appendarray2		&& Introduced in version 11.0.0. Appends a new and empty JSON array and returns it in jarr. Important: The name is the member name, it is not a JSON path. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendArray2
		* Purpose:           Appends a new and empty JSON array and returns it in jarr.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMemberName, the name of the member array.
		*                    toChilkatJSONArray, a Chilkat JSON Array.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Appends a copy of a JSON array.
		** 
		** Important: The name is the member name, it is not a JSON path.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMemberName AS Character, toChilkatJSONArray AS CHILKAT_JSONARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterJsonArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonArray AS CHILKAT_JSONARRAY_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonArray, m.loChilkatJsonArray
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonArray = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonArray)
		
		      loChilkatJsonArray = m.loParkParameterJsonArray.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AppendArray2(m.tcMemberName, m.loChilkatJSONArray) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonArray = ;
		      m.loParkParameterJsonArray.SetObject(m.toChilkatJsonArray, m.loChilkatJsonArray)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonArray, m.loChilkatJsonArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatJSONArray = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  loParkParameterJsonArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonArray = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

