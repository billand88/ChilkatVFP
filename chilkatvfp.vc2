	PROCEDURE sendwakeonlan		&& Introduced in version 9.5.0.69. Sends a "Wake on Lan" magic packet to a computer. A Wake on Lan is a way to power on a computer remotely by sending a data packet known as a magic packet.
		*==============================================================================
		* Method:            SendWakeOnLAN
		* Purpose:           Sends a "Wake on Lan" magic packet to a computer.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMACAddress, the computer to wake.
		*                    tiPort, the port to communicate through.
		*                    tcIPBroadcastAddress, the IP broadcast address to transmit.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Sends a "Wake on Lan" magic packet to a computer. 
		** A Wake on Lan is a way to power on a computer remotely 
		** by sending a data packet known as a magic packet. 
		** For this to work, the network card must have enabled the feature: 
		** “Power on Lan” or “Power on PCI Device“, 
		** which is done by accessing the BIOS of the machine.
		** 
		** The macAddress is the MAC address (in hex) of the computer to wake. 
		** A MAC address should be 6 bytes in length. 
		** For example, "000102030405". The port is the port which should be 7 or 9. 
		** (Port number 9 is more commonly used.) 
		** The ipBroadcastAddr is the broadcast address of your network, 
		** which usually ends with *.255. For example: "192.168.1.255".
		** 
		** Your application does not call Connect prior to calling SendWakeOnLan. 
		** To use this method, it's just a matter of instantiating an instance 
		** of this socket object and then call SendWakeOnLan.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMACAddress AS Character, ;
		tiPort AS Integer, tcIPBroadcastAddress AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SendWakeOnLAN(m.tcMACAddress, ;
		        m.tiPort, m.tcIPBroadcastAddress) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendwakeonlan2		&& Introduced in version 9.5.0.77. The same as SendWakeOnLan, but includes an additional argument to specify a SecureOn password. The password should be a hexidecimal string representing 4 or 6 bytes.
		*==============================================================================
		* Method:            SendWakeOnLAN2
		* Purpose:           The same as SendWakeOnLan, but includes 
		*                    an additional argument to specify a SecureOn password.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMACAddress, the computer to wake.
		*                    tiPort, the port to communicate through.
		*                    tcIPBroadcastAddress, the IP broadcast address to transmit.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** The same as SendWakeOnLan, but includes an additional argument 
		** to specify a SecureOn password. The password should be a hexidecimal 
		** string representing 4 or 6 bytes. (See https://wiki.wireshark.org/WakeOnLAN) 
		** Sending a WakeOnLAN (WOL) to an IPv4 address would need a 4-byte SecureOn password, 
		** whereas an IPv6 address would need a 6-byte SecureOn password.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMACAddress AS Character, tiPort AS Integer, ;
		tcIPBroadcastAddress AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SendWakeOnLAN2(m.tcMACAddress, ;
		        m.tiPort, m.tcIPBroadcastAddress, m.tcPassword) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE sessionlogencoding_access		&& Access method used to retrieve the Chilkat Socket SessionLogEncoding property.
		*==============================================================================
		* Method:            SessionLogEncoding_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket SessionLogEncoding property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SessionLogEncoding
		* Date Added:        05/28/2022
		*==============================================================================
		
		** 
		** Controls how the data is encoded in the SessionLog. 
		** Possible values are "esc" and "hex". The default value is "esc".
		**
		** When set to "hex", the bytes are encoded as a hexidecimalized string. 
		** The "esc" encoding is a C-string like encoding, 
		** and is more compact than hex if most of the data to be logged is text. 
		** Printable us-ascii chars are unmodified. 
		** Common "C" control chars are represented as "\r", "\n", "\t", etc. 
		** Non-printable and byte values greater than 0x80 are escaped 
		** using a backslash and hex encoding: \xHH. 
		** Certain printable chars are backslashed: SPACE, double-quote, single-quote, etc.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sessionlogencoding_assign		&& Assign method used to hold a reference to the SessionLogEncoding property.
		*==============================================================================
		* Method:            SessionLogEncoding_Assign
		* Purpose:           Assign method used to hold a reference to the SessionLogEncoding property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SessionLogEncoding property.
		* Returns:           
		* Date Added:        05/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [SessionLogEncoding]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sessionlog_access		&& Access method used to retrieve the Chilkat Socket SessionLog property.
		*==============================================================================
		* Method:            SessionLog_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket SessionLog property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SessionLog
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Contains a log of the bytes sent and received on this socket. 
		** The KeepSessionLog property must be set to 1 for logging to occur.
		**
		** Fixed for Version 52: The session log did not include data received from the ReceiveUntilMatch method.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sessionlog_assign		&& Assign method used to hold a reference to the SessionLog property.
		*==============================================================================
