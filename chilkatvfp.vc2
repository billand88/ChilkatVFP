		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS stringarray AS ibasechilkat OF "chilkatvfp.vcx" 		&& Class/object for managing and manipulating collections of strings. Contains an ordered collection of strings. Important: The Chilkat StringTable class is a better choice for a large number of strings.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: append		&& Appends a string to the end of the internal ordered collection. Returns 1 for success, 0 for failure.
		*m: appendserialized		&& Appends multiple strings to the end of the internal ordered collection. The encodedStr is what is returned from the Serialize method (see below). Returns 1 for success, 0 for failure.
		*m: clear		&& Remove all strings from the internal collection.
		*m: contains		&& Returns 1 if the string is present in the internal collection. The string comparisons are case sensitive.
		*m: count_access		&& Access method used to retrieve the Chilkat StringArray Count property.
		*m: count_assign		&& Assign method used to hold a reference to the Count property.
		*m: crlf_access		&& Access method used to retrieve the Chilkat StringArray CRLF property.
		*m: crlf_assign		&& Assign method used to hold a reference to the CRLF property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat StringArray DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: find		&& Finds the index of the first string equal to findStr. The search begins at startIndex. If the string is not found, -1 is returned. The first string in the array is at index 0.
		*m: findfirstmatch		&& Finds the first string that matches the matchPattern. The search begins at startIndex. If the string is not found, -1 is returned. The first string in the array is at index 0.
		*m: getstring		&& Returns the string at an indexed location within the internal collection. The first string is located at index 0. Returns Nothing on failure.
		*m: insertat		&& Inserts a string into the internal collection at a specified index. Using index 0 will insert at the beginning.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat StringArray LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat StringArray LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat StringArray LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat StringArray LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat StringArray LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststring		&& Returns the last string in the internal collection. Returns Nothing on failure.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat StringArray LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat StringArray LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: length_access		&& Access method used to retrieve the Chilkat StringArray Length property.
		*m: length_assign		&& Assign method used to hold a reference to the Length property.
		*m: loadfromfile		&& Loads strings from a file (one per line) into the internal collection. It is assumed the file contains ANSI strings. To load from a file containing non-ANSI strings (such as utf-8), call LoadFromFile2 instead.
		*m: loadfromfile2		&& Loads strings from a file (one per line) into the internal collection. The charset specifies the character encoding (such as utf-8) of the strings contained in the file.
		*m: loadfromtext		&& Loads strings from an in-memory string (one per line) into the internal collection. Note: This method appends the strings in str to the existing collection of strings contained in this object.
		*m: loadtaskresult		&& Introduced in version 9.5.0.52. Loads the string collection from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*m: pop		&& Returns the last string and removes it from the internal collection. Returns Nothing on failure.
		*m: prepend		&& Adds a string to the beginning of the internal collection.
		*m: remove		&& Removes all strings equal to the string argument from the internal collection.
		*m: removeat		&& Removes the string at a particular index.
		*m: replaceat		&& Introduced in version 9.5.0.52. Replaces the string at a specified index.
		*m: saventhtofile		&& Saves the Nth string in the collection to a file. Returns 1 for success, 0 for failure.
		*m: savetofile		&& Saves the collection of strings to a file, one string per line. Strings are saved using the ANSI charset. (Call SaveToFile2 to specify a charset, such as "utf-8")  Returns 1 for success, 0 for failure.
		*m: savetofile2		&& Saves the collection of strings to a file, one string per line. Strings are saved using the specified charset. Returns 1 for success, 0 for failure.
		*m: savetotext		&& Writes the collection of strings to a single string, one per line (separated by CRLF line endings). Returns Nothing on failure.
		*m: serialize		&& Returns an string which is an encoded representation of all the strings in the collection. The string collection can be re-created by calling the AppendSerialized method. Returns Nothing on failure.
		*m: sort		&& Sorts the strings in the collection in ascending or descending order. To sort in ascending order, set ascending to 1, otherwise set ascending equal to 0.
		*m: splitandappend		&& Splits a string at a character or substring boundary and adds each resulting string to the internal collection.
		*m: subtract		&& Subtracts the strings contained within stringArrayObj from the caller's internal collection.
		*m: trim_access		&& Access method used to retrieve the Chilkat StringArray Trim property.
		*m: trim_assign		&& Assign method used to hold a reference to the Trim property.
		*m: union		&& Performs the union set-operator. The result is that the caller will have a string collection that is the union of itself and stringArrayObj.
		*m: unique_access		&& Access method used to retrieve the Chilkat StringArray Unique property.
		*m: unique_assign		&& Assign method used to hold a reference to the Unique property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat StringArray VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: count		&& The number of strings contained within the object's internal array (i.e. ordered collection). Important: This is an object that contains a collection of strings.
		*p: crlf		&& If 1, strings are always automatically converted to use CRLF line endings. If 0, strings are automatically converted to use bare LF line endings.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: length		&& The number of strings contained within the internal collection. (Identical to the Count property.)
		*p: trim		&& If 1, whitespace, including carriage-returns and linefeeds, are automatically removed from the beginning and end of a string when added to the collection.
		*p: unique		&& If 1, then duplicates are not allowed. When an attempt is made to insert a string that already exists, the duplicate insertion is silently suppressed and no error is returned. The default value is 0.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = StringArray
		count = 0
		crlf = 1
		debuglogfilepath = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		length = 0
		Name = "stringarray"
		trim = 0
		unique = 0
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE append		&& Appends a string to the end of the internal ordered collection. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Append
		* Purpose:           Appends a string to the end of the internal ordered collection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the string to append.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Appends a string to the end of the internal ordered collection.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.Append(m.tcString) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

