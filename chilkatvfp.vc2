	PROCEDURE receiverate		&& Periodicallly called with information about the download performance (i.e. the receiving of the HTTP response). The byteCount is the cumulative number of bytes downloaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*==============================================================================
		* Method:            ReceiveRate
		* Purpose:           Periodicallly called with information about the download performance.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** Periodicallly called with information about the download performance 
		** (i.e. the receiving of the HTTP response). The byteCount 
		** is the cumulative number of bytes downloaded so far. 
		** The bytesPerSec is the current transfer rate in bytes per second.
		**
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount
		liBytesPerSec = m.tiBytesPerSec
		llReturn = .T.
		
		*!*  ? [ReceiveRate Event!]
		*!*  ? [ReceiveRate: ByteCount = ] + STR(liByteCount) + [, BytesPerSec = ] + STR(liBytesPerSec)
		
		WITH THIS
		
		  llReturn = .ReceiveRate_Pre(m.liByteCount, m.liBytesPerSec)
		
		  ** OK to continue test
		  IF m.llReturn 
		
		    llReturn = .ReceiveRate_Process(m.liByteCount, m.liBytesPerSec)
		
		    ** OK to continue test
		    IF m.llReturn 
		
		      llReturn = .ReceiveRate_Post(m.liByteCount, m.liBytesPerSec)
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		tiByteCount = m.liByteCount
		tiBytesPerSec = m.liBytesPerSec
		
		RETURN
	ENDPROC

	PROCEDURE receiverate_post		&& Template ReceiveRate post-processing method.
		*==============================================================================
		* Method:            ReceiveRate_Post
		* Purpose:           ReceiveRate post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE receiverate_pre		&& Template ReceiveRate pre-processing method.
		*==============================================================================
		* Method:            ReceiveRate_Pre
		* Purpose:           ReceiveRate pre-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE receiverate_process		&& Template ReceiveRate processing method.
		*==============================================================================
		* Method:            ReceiveRate_Process
		* Purpose:           ReceiveRate processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE sendrate		&& Called periodically with upload progress information: The byteCount is the cumulative number of bytes uploaded so far. The bytesPerSec is the current transfer rate in bytes per second.
		*==============================================================================
		* Method:            SendRate
		* Purpose:           Called periodically with upload progress information.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes sent.
		*                    tiBytesPerSec, the uploaded bytes per second.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** Called periodically with upload progress information: 
		** The byteCount is the cumulative number of bytes uploaded so far. 
		** The bytesPerSec is the current transfer rate in bytes per second.
		**
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount
		liBytesPerSec = m.tiBytesPerSec
		llReturn = .T.
		
		*!*  ? [SendRate Event!]
		*!*  ? [SendRate: ByteCount = ] + STR(liByteCount) + [, BytesPerSec = ] + STR(liBytesPerSec)
		
		WITH THIS
		
		  llReturn = .SendRate_Pre(m.liByteCount, m.liBytesPerSec)
		
		  ** OK to continue test
		  IF m.llReturn 
		
		    llReturn = .SendRate_Process(m.liByteCount, m.liBytesPerSec)
		
		    ** OK to continue test
		    IF m.llReturn 
		
		      llReturn = .SendRate_Post(m.liByteCount, m.liBytesPerSec)
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		tiByteCount = m.liByteCount
		tiBytesPerSec = m.liBytesPerSec
		
		RETURN
	ENDPROC

	PROCEDURE sendrate_post		&& Template SendRate post-processing method.
		*==============================================================================
		* Method:            SendRate_Post
		* Purpose:           SendRate post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE sendrate_pre		&& Template SendRate pre-processing method.
		*==============================================================================
		* Method:            SendRate_Pre
		* Purpose:           SendRate pre-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

	PROCEDURE sendrate_process		&& Template SendRate processing method.
		*==============================================================================
		* Method:            SendRate_Process
		* Purpose:           SendRate processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the total number of bytes downloaded.
		*                    tiBytesPerSec, the downloaded bytes per second.
		* Returns:           Logical, indicating success.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tiByteCount AS Integer, tiBytesPerSec AS Integer
		
		LOCAL liByteCount AS Integer, liBytesPerSec AS Integer, llReturn AS Logical
		
		liByteCount = m.tiByteCount 
		liBytesPerSec = m.tiBytesPerSec 
		
		llReturn = .T.
		
		RETURN m.llReturn
	ENDPROC

ENDDEFINE

DEFINE CLASS httprequest AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a complete HTTP request.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addbdforupload		&& Introduced in version 9.5.0.76. Adds a file to an upload request where the contents of the file come from byteData. name is an arbitrary name. (In HTML, it is the form field name of the input tag.)
		*m: addbytesforupload		&& Adds a file to an upload request where the contents of the file come from an in-memory byte array.
		*m: addbytesforupload2		&& Same as AddBytesForUpload, but allows the Content-Type header field to be directly specified. (Otherwise, the Content-Type header is automatically determined based on the remoteFileName's file extension.) Returns 1 for success, 0 for failure.
		*m: addfileforupload		&& Adds a file to an upload request. To create a file upload request, set the ContentType property = "multipart/form-data" and then call AddFileForUpload, AddBytesForUpload, or AddStringForUpload for each file to be uploaded.
		*m: addfileforupload2		&& Same as AddFileForUpload, but allows the Content-Type header field to be directly specified. (Otherwise, the Content-Type header is automatically determined based on the file extension.)
		*m: addheader		&& Adds a request header to the HTTP request. If a header having the same field name is already present, this method replaces it. Note: Never explicitly set the Content-Length header field.
		*m: addmwssignature		&& Introduced in version 9.5.0.66. Computes the Amazon MWS signature using the mwsSecretKey and adds the "Signature" parameter to the request. This method should be called for all Amazon Marketplace Web Service (Amazon MWS) HTTP requests.
		*m: addparam		&& Adds a request query parameter (name/value pair) to the HTTP request. The name and value strings passed to this method should not be URL encoded.
		*m: addstringforupload		&& Same as AddFileForUpload, but the upload data comes from an in-memory string instead of a file. Returns 1 for success, 0 for failure.
		*m: addstringforupload2		&& Same as AddStringForUpload, but allows the Content-Type header field to be directly specified. (Otherwise, the Content-Type header is automatically determined based on the filename's file extension.) Returns 1 for success, 0 for failure.
		*m: addsubheader		&& Introduced in version 9.5.0.55. Adds a request header to the Nth sub-header of the HTTP request. If a header having the same field name is already present, this method replaces it. Returns 1 for success, 0 for failure.
		*m: boundary_access		&& Access method used to retrieve the Chilkat HTTPRequest Boundary property.
		*m: boundary_assign		&& Assign method used to hold a reference to the Boundary property.
		*m: charset_access		&& Access method used to retrieve the Chilkat HTTPRequest Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: contenttype_access		&& Access method used to retrieve the Chilkat HTTPRequest ContentType property.
		*m: contenttype_assign		&& Assign method used to hold a reference to the ContentType property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat HTTPRequest DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: entireheader_access		&& Access method used to retrieve the Chilkat HTTPRequest EntireHeader property.
		*m: entireheader_assign		&& Assign method used to hold a reference to the EntireHeader property.
		*m: generaterequestfile		&& Introduced in version 9.5.0.64. The same as GenerateRequestText, except the generated request is written to the file specified by path. Returns 1 for success, 0 for failure.
		*m: generaterequesttext		&& Returns the request text that would be sent if Http.SynchronousRequest was called. Returns Nothing on failure
		*m: getheaderfield		&& Returns the value of a request header field. Returns Nothing on failure
		*m: getheadername		&& Returns the Nth request header field name. Indexing begins at 0, and the number of request header fields is specified by the NumHeaderFields property. Returns Nothing on failure
		*m: getheadervalue		&& Returns the Nth request header field value. Indexing begins at 0, and the number of request header fields is specified by the NumHeaderFields property. Returns Nothing on failure
		*m: getparam		&& Returns a request query parameter value by name. Returns Nothing on failure
		*m: getparamname		&& Returns the Nth request query parameter field name. Indexing begins at 0, and the number of request query parameter fields is specified by the NumParams property. Returns Nothing on failure
		*m: getparamvalue		&& Returns the Nth request query parameter field value. Indexing begins at 0, and the number of request query parameter fields is specified by the NumParams property. Returns Nothing on failure
		*m: geturlencodedparams		&& Returns the request parameters in URL encoded form (i.e. in the exact form that would be sent if the ContentType property was application/x-www-form-urlencoded).
		*m: httpverb_access		&& Access method used to retrieve the Chilkat HTTPRequest HTTPVerb property.
		*m: httpverb_assign		&& Assign method used to hold a reference to the HTTPVerb property.
		*m: httpversion_access		&& Access method used to retrieve the Chilkat HTTPRequest HTTPVersion property.
		*m: httpversion_assign		&& Assign method used to hold a reference to the HTTPVersion property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat HTTPRequest LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat HTTPRequest LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat HTTPRequest LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat HTTPRequest LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat HTTPRequest LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat HTTPRequest LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat HTTPRequest LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadbodyfrombd		&& Introduced in version 9.5.0.67. Uses the contents of the requestBody as the HTTP request body. Returns 1 for success, 0 for failure.
		*m: loadbodyfrombytes		&& The HTTP protocol is such that all HTTP requests are MIME. For non-multipart requests, this method may be called to set the MIME body of the HTTP request to the exact contents of the byteData.
		*m: loadbodyfromfile		&& The HTTP protocol is such that all HTTP requests are MIME. For non-multipart requests, this method may be called to set the MIME body of the HTTP request to the exact contents of filePath.
		*m: loadbodyfromsb		&& Introduced in version 9.5.0.67. Uses the contents of the requestBody as the HTTP request body. The charset indicates the binary representation of the string, such as "utf-8", "utf-16", "iso-8859-*", "windows-125*", etc.
		*m: loadbodyfromstring		&& The HTTP protocol is such that all HTTP requests are MIME. For non-multipart requests, this method may be called to set the MIME body of the HTTP request to the exact contents of bodyStr.
		*m: numheaderfields_access		&& Access method used to retrieve the Chilkat HTTPRequest NumHeaderFields property.
		*m: numheaderfields_assign		&& Assign method used to hold a reference to the NumHeaderFields property.
		*m: numparams_access		&& Access method used to retrieve the Chilkat HTTPRequest NumParams property.
		*m: numparams_assign		&& Assign method used to hold a reference to the NumParams property.
		*m: path_access		&& Access method used to retrieve the Chilkat HTTPRequest Path property.
		*m: path_assign		&& Assign method used to hold a reference to the Path property.
		*m: removeallparams		&& Removes all request parameters.
		*m: removeheader		&& Removes all occurrences of a HTTP request header field. Always returns 1. Returns 1 for success, 0 for failure.
		*m: removeparam		&& Removes a single HTTP request parameter by name.
		*m: sendcharset_access		&& Access method used to retrieve the Chilkat HTTPRequest SendCharset property.
		*m: sendcharset_assign		&& Assign method used to hold a reference to the SendCharset property.
		*m: setfromurl		&& Parses a URL and sets the Path and query parameters (NumParams, GetParam, GetParamName, GetParamValue).
		*m: streambodyfromfile		&& Useful for sending HTTP requests where the body is a very large file.
		*m: streamchunkfromfile		&& Introduced in version 9.5.0.55. This method is the same as StreamBodyFromFile, but allows for an offset and number of bytes to be specified. The offset and numBytes are integers passed as strings. Returns 1 for success, 0 for failure.
		*m: useget		&& Undocumented method! Makes the HttpRequest a GET request.  Important: This method is decremented. An application should instead set the HttpVerb property equal to "GET", and the ContentType equal to an empty string.
		*m: usehead		&& Undocumented function!  Makes the HttpRequest a HEAD request. Important: This method is decremented. An application should instead set the HttpVerb property equal to "HEAD", and the ContentType equal to an empty string.
		*m: usepost		&& Undocumented function! Makes the HttpRequest a POST request that uses the "application/x-www-form-urlencoded" content type. Important: This method is decremented.
		*m: usepostmultipartform		&& Undocumented function! Makes the HttpRequest a POST request that uses the "multipart/form-data" content type. Important: This method is decremented.
		*m: useput		&& Undocumented function! Makes the HttpRequest a PUT request. Important: This method is decremented. An application should instead set the HttpVerb property equal to "PUT", and the ContentType equal to "application/x-www-form-urlencoded".
		*m: useupload		&& Undocumented function! Makes the HttpRequest a POST request that uses the "multipart/form-data" content type. To create a file upload request, call UseUpload and then call AddFileForUpload for each file to be uploaded.
		*m: useuploadput		&& Undocumented function!  Makes the HttpRequest a PUT request that uses the "multipart/form-data" content type. To create a file upload request (using the PUT verb), call UseUploadPut and then call AddFileForUpload for each file to be uploaded.
		*m: usexmlhttp		&& Undocumented function! Makes the HttpRequest a POST request using the "application/xml" content type. The request body is set to the XML string passed to this method. Important: This method is decremented.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat HTTPRequest VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: boundary		&& Introduced in version 9.5.0.49. Sets an explicit boundary string to be used in multipart/form-data requests. If no Boundary is set, then a boundary string is automaticaly generated as needed during the sending of a request.
		*p: charset		&& Controls the character encoding used for HTTP request parameters for POST requests. The default value is the ANSI charset of the computer. The charset should match the charset expected by the form target.
		*p: contenttype		&& The ContentType property sets the "Content-Type" header field, and identifies the content-type of the HTTP request body.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: entireheader		&& Composes and returns the entire MIME header of the HTTP request.
		*p: httpverb		&& The HttpVerb property should be set to the name of the HTTP method that appears on the "start line" of an HTTP request, such as GET, POST, PUT, DELETE, etc.
		*p: httpversion		&& The HTTP version in the request header. Defaults to "1.1".
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numheaderfields		&& Returns the number of request header fields.
		*p: numparams		&& Returns the number of query parameters.
		*p: path		&& The path of the resource requested. A path of "/" indicates the default document of a domain.
		*p: sendcharset		&& Controls whether the charset is explicitly included in the content-type header field of the HTTP POST request. The default value of this property is 0.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		boundary = 
		cchilkatclass = HttpRequest
		charset = 
		contenttype = 
		debuglogfilepath = 
		entireheader = 
		httpverb = 
		httpversion = 1.1
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "httprequest"
		numheaderfields = 0
		numparams = 0
		path = 
		sendcharset = 0
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addbdforupload		&& Introduced in version 9.5.0.76. Adds a file to an upload request where the contents of the file come from byteData. name is an arbitrary name. (In HTML, it is the form field name of the input tag.)
		*==============================================================================
		* Method:            AddBdForUpload
		* Purpose:           Adds a file to an upload request where 
		*                    the contents of the file come from byteData.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName -- arbitrary name
		*                    tcRemoteFileName -- file name on HTTP server
		*                    toChilkatBinData -- a Chilkat Binary Data object.
		*                    tcContentType -- the value of the content type header.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		** 
		** Adds a file to an upload request where the contents of the file come from byteData.
		** 
		** name is an arbitrary name. (In HTML, it is the form field name of the input tag.)
		** 
		** remoteFilename is the name of the file to be created on the HTTP server.
		** 
		** byteData contains the bytes to be uploaded.
		** 
		** contentType contains is the value of the Content-Type header. 
		** 
		** An empty string may be passed to allow Chilkat to automatically determine 
		** the Content-Type based on the filename extension.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcName AS Character, tcRemoteFileName AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tcContentType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = EVALUATE([.] + .cChilkatObjectName)
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddBdForUpload(m.tcName, m.tcRemoteFileName, ;
		        m.toChilkatBinData, m.tcContentType) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addbytesforupload		&& Adds a file to an upload request where the contents of the file come from an in-memory byte array.
		*==============================================================================
		* Method:            AddBytesForUpload
		* Purpose:           Adds a file to an upload request where the contents 
		*                    of the file come from an in-memory byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName -- arbitrary name
		*                    tcRemoteFileName -- file name on HTTP server
		*                    tqData -- contains the contents (bytes) to be uploaded.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Adds a file to an upload request where the contents 
		** of the file come from an in-memory byte array. 
		** To create a file upload request, set the ContentType property = "multipart/form-data" 
		** and then call AddBytesForUpload, AddStringForUpload, or AddFileForUpload 
		** for each file to be uploaded.
		** 
		** name is an arbitrary name. (In HTML, it is the form field name of the input tag.)
		** 
		** remoteFileName is the name of the file to be created on the HTTP server.
		** 
		** byteData contains the contents (bytes) to be uploaded.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcName AS Character, tcRemoteFileName AS Character, tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddBytesForUpload(m.tcName, ;
		      m.tcRemoteFileName, m.tqData) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
