		tcCharset AS Character, tcContentType AS Character, tuMD5Header AS Unknown, tuGZip AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		liMD5Header AS Integer, liGZip AS Integer, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liMD5Header, m.liGZip, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 46
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liMD5Header = .LogicalToBit(m.tuMD5Header)
		      liGZip = .LogicalToBit(m.tuGZip)
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.PTextAsync(m.tcVerb, m.tcURL, ;
		        m.tcTextData, m.tcCharset, m.tcContentType, m.liMD5Header, m.liGZip)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ptextsb		&& The same as PText, but the data to be uploaded is passed in textData. Returns Nothing on failure
		*==============================================================================
		* Method:            PTextSb
		* Purpose:           The same as PText, but the data to be uploaded is passed in textData.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
