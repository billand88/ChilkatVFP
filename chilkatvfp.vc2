	PROCEDURE setfiletimes		&& Sets the create date/time, the last-access date/time, and the last-modified date/time for a file. For non-Windows filesystems where create times are not implemented, the createTime is ignored.
		*==============================================================================
		* Method:            SetFileTimes
		* Purpose:           Sets the create date/time, the last-access date/time, 
		*                    and the last-modified date/time for a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file parts.
		*                    toChilkatCkDateTimeCreate, a Chilkat Date/Time object.
		*                    toChilkatCkDateTimeLastAccess, a Chilkat Date/Time object.
		*                    toChilkatCkDateTimeLastModified, a Chilkat Date/Time object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Sets the create date/time, the last-access date/time, 
		** and the last-modified date/time for a file. For non-Windows filesystems 
		** where create times are not implemented, the createTime is ignored.
		** 
		
		LPARAMETERS tcFilePath AS Character, ;
		toChilkatCkDateTimeCreate AS CHILKAT_CKDATETIME_COM_CALL, ;
		toChilkatCkDateTimeLastAccess AS CHILKAT_CKDATETIME_COM_CALL, ;
		toChilkatCkDateTimeLastModified AS CHILKAT_CKDATETIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loParkParameterCkDateTimeCreate AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTimeCreate AS CHILKAT_CKDATETIME_COM_CALL, ;
		loParkParameterCkDateTimeLastAccess AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTimeLastAccess AS CHILKAT_CKDATETIME_COM_CALL, ;
		loParkParameterCkDateTimeLastModified AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTimeLastModified AS CHILKAT_CKDATETIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTimeCreate, m.loChilkatCkDateTimeCreate, ;
		m.loParkParameterCkDateTimeLastAccess, m.loChilkatCkDateTimeLastAccess, ;
		m.loParkParameterCkDateTimeLastModified, m.loChilkatCkDateTimeLastModified  
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCkDateTimeCreate = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTimeCreate)
		
		      loParkParameterCkDateTimeLastAccess = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTimeLastAccess)
		
		      loParkParameterCkDateTimeLastModified = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTimeLastModified)
		
		      loChilkatCkDateTimeCreate = m.loParkParameterCkDateTimeCreate.GetObject()
		      loChilkatCkDateTimeLastAccess = m.loParkParameterCkDateTimeLastAccess.GetObject()
		      loChilkatCkDateTimeLastModified = m.loParkParameterCkDateTimeLastModified.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetFileTimes(m.tcFilePath, m.loChilkatCkDateTimeCreate, ;
		      m.loChilkatCkDateTimeLastAccess, m.loChilkatCkDateTimeLastModified) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCkDateTimeCreate = m.loParkParameterCkDateTimeCreate.SetObject(;
		    toChilkatCkDateTime, m.loChilkatCkDateTimeCreate)
		
		    toChilkatCkDateTimeLastAccess = loParkParameterCkDateTime.SetObject(;
		    m.toChilkatCkDateTimeLastAccess, m.loChilkatCkDateTimeLastAccess)
		
		    toChilkatCkDateTimeLastModified = m.loChilkatCkDateTimeLastModified.SetObject(;
		    m.toChilkatCkDateTimeLastModified, m.loChilkatCkDateTimeLastModified)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
