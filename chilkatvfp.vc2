	ENDPROC

	PROCEDURE addheaderfield		&& Any standard or non-standard (custom) header field can be added to the email with this method. One interesting feature is that all header fields whose name begins with "CKX-" will not be included in the header when an email is sent.
		*==============================================================================
		* Method:            AddHeaderField
		* Purpose:           Any standard or non-standard (custom) header field can be added to the email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFieldName -- the non-standard header field.
		*                    tcFieldValue -- the (variable) content.
		* Returns:           
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Any standard or non-standard (custom) header field can be added to the email with this method. 
		** One interesting feature is that all header fields whose name begins with "CKX-" 
		** will not be included in the header when an email is sent. 
		** These fields will be included when saved to or loaded from XML. 
		** This makes it easy to include persistent meta-data with an email 
		** which your programs can use in any way it chooses.
		**
		** Important: This method will replace an already-existing header field. 
		** To allow for adding duplicate header fields, call AddHeaderField2 (see below).
		**
		
		LPARAMETERS tcFieldName AS Character, tcFieldValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      m.loChilkatObject.AddHeaderField(m.tcFieldName, m.tcFieldValue)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addheaderfield2		&& This method is the same as AddHeaderField, except that if the header field already exists, it is not replaced. A duplicate header will be added.
		*==============================================================================
