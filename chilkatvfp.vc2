	ENDPROC

	PROCEDURE getsafebagattr		&& Introduced in version 9.5.0.83. Can be called to get one of the following safebag attributes for the Nth private key or certificate in the PFX. forPrivateKey should be 1 for a private key, and 0 for a certificate.
		*==============================================================================
		* Method:            GetSafeBagAttr
		* Purpose:           Can be called to get one of the following safebag attributes 
		*                    for the Nth private key or certificate in the PFX.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuIsPrivateKey, whether or not the index references 
		*                    a private key or a certificate
		*                    tiIndex, the index into the private key/certificate array.
		*                    tcAttributeName, the attribute name to locate.
		* Returns:           The attribute value.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Can be called to get one of the following safebag attributes for the Nth private key 
		** or certificate in the PFX. forPrivateKey should be 1 for a private key, and 0 for a certificate. 
		** The index is the index of the certificate or key in the PFX. 
		** The attrName can be one of the following:
		** 
		** "localKeyId" : Returns the decimal representation of the local key ID. 
		** The local key ID is used to associate the certificate contained in the PFX with this private key. 
		** (The certificate will include a "localKeyId" attribute in its cert bag of attributes within the PFX.)
		** 
		** "keyContainerName" : Returns the key container name (or key name) of the private key. 
		** For more information about the directories where the Windows OS stores private keys, 
		** see https://docs.microsoft.com/en-us/windows/win32/seccng/key-storage-and-retrieval
		** 
		** "storageProvider" : Returns the name of the Cryptographic Storage Provider to be used for the key.
		** Note: It is not required that any of the above attributes are present in the PFX.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tuIsPrivateKey AS Unknown, ;
		tiIndex AS Integer, tcAttributeName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liIsPrivateKey AS Integer, lcAttributeValue AS Character
		
		STORE 0 TO m.liIsPrivateKey, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcAttributeValue = []
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIsPrivateKey = .LogicalToBit(m.tuIsPrivateKey)
		
		      TRY
		
		        lcAttributeValue = ;
		        m.loChilkatObject.GetSafeBagAttr(m.liIsPrivateKey, m.tiIndex, m.tcAttributeName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcAttributeValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE importtokeychain		&& Introduced in version 10.0.0. Imports the certificates and private keys contained in the PFX to the MacOS/iOS keychain. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ImportToKeyChain
		* Purpose:           Imports the certificates and private keys 
		*                    contained in the PFX to the MacOS/iOS keychain.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/27/2024
		*==============================================================================
		
		**
		** Introduced in version 10.0.0
		** 
		** Imports the certificates and private keys contained in the PFX to the MacOS/iOS keychain.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, liReturn AS Integer, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, llImplemented AS Logical
		
		LOCAL ARRAY la_Implemented(3)
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		llImplemented = .F.
		
		la_Implemented(1) = 10
		la_Implemented(2) = 0
		la_Implemented(3) = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(@m.la_Implemented)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ImportToKeyChain(m.loChilkatJSONObject) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE importtowindows		&& Introduced in version 9.5.0.83. Imports the certificates and private keys contained in the PFX to Windows certificate store(s). If exportable is 1, imported keys are marked as exportable.
		*==============================================================================
		* Method:            ImportToWindows
		* Purpose:           Imports the certificates and private keys 
		*                    contained in the PFX to Windows certificate store(s).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuKeysExportable, whether or not the imported keys are exportable.
		*                    tuUserProtected, whether or not the key is user protected.
		*                    tuMachineKeySet, whether or not the keys are stored in MACHINE in registry.
		*                    tuAllowOverwriteKey, whether or not the key can be overwritten.
		*                    tuAllowExport, whether or not the key is exportable.
		*                    tcLeafStoreName, the Windows Leaf Certificate store name.
		*                    tcIntermediateStoreName, the Windows Intermidiate Certificate store name.
		*                    tcRootStoreName, the Windows Root Certificate store name.
		*                    tcExtraOptions, an undefined parameter...
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/13/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Imports the certificates and private keys contained in the PFX to Windows certificate store(s).
		** 
		** If exportable is 1, imported keys are marked as exportable.
		** 
		** If userProtected is 1, the user is to be notified through a dialog box 
		** or other method when certain attempts to use this key are made. 
		** The precise behavior is specified by the cryptographic service provider (CSP) being used.
		** 
		** If machineKeyset is 1, the private keys are stored under the local computer 
		** and not under the current user.
		** 
		** If allowOverwriteKey is 1, allow overwrite of the existing key. 
		** Specify this flag when you encounter a scenario in which you must import 
		** a PFX file that contains a key name that already exists. 
		** For example, when you import a PFX file, it is possible that a container 
		** of the same name is already present because there is no unique namespace for key containers. 
		** If you have created a "TestKey" on your computer, and then you import a PFX file 
		** that also has "TestKey" as the key container, this flag allows the key to be overwritten.
		** 
		** If allowExport is 1, then the key is marked as exportable, 
		** which allows for it to be re-exported to a PFX.
		** 
		** The leafStore, intermediateStore, and rootStore are the Windows certificate store names 
		** indicating where to import certificates of each given type. 
		** A leafStore is a certificate that is not the issuer of any other certificate in the PFX. 
		** An intermediateStore is any certificate that is not a root (or self-signed) 
		** but is also the issuer of some other certificate in the PFX. 
		** A rootStore is a self-signed or root certificate.
		** 
		** The possible store names for leafStore, intermediateStore, and rootStore are as follows:
		** 
		**   "None": Do not import certificates of the given type into any Windows certicate store.
		**   "AddressBook": Certificate store for other users.
		**   "AuthRoot": Certificate store for third-party certification authorities (CAs).
		**   "CertificationAuthority": Certificate store for intermediate certification authorities (CAs).
		**   "My": Certificate store for personal certificates. (Leaf certificates are 
		**         typically imported into this store.)
		**   "Root": Certificate store for trusted root certification authorities (CAs).
		**   "TrustedPeople": Certificate store for directly trusted people and resources.
		**   "TrustedPublisher": Certificate store for directly trusted publishers.
		** 
		** The rootStore is reserved for any future options that may be needed. 
		** At this time, pass an empty string.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuKeysExportable AS Unknown, tuUserProtected AS Unknown, ;
		tuMachineKeySet AS Unknown, tuAllowOverwriteKey AS Unknown, tuAllowExport AS Unknown, ;
		tcLeafStoreName AS Character, tcIntermediateStoreName AS Character, ;
		tcRootStoreName AS Character, tcExtraOptions AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PFX_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liKeysExportable AS Integer, liUserProtected AS Integer, ;
		liMachineKeySet AS Integer, liAllowOverwriteKey AS Integer, liAllowExport AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liKeysExportable, m.liUserProtected, ;
		m.liMachineKeySet, m.liAllowOverwriteKey, m.liAllowExport, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liKeysExportable = .LogicalToBit(m.tuKeysExportable)
		      liUserProtected = .LogicalToBit(m.tuUserProtected)
		      liMachineKeySet = .LogicalToBit(m.tuMachineKeySet)
		      liAllowOverwriteKey = .LogicalToBit(m.tuAllowOverwriteKey)
		      liAllowExport = .LogicalToBit(m.tuAllowExport)
		
		      TRY
		
		        STORE m.loChilkatObject.ImportToWindows(m.liKeysExportable, m.liUserProtected, ;
		        m.liMachineKeySet, m.liAllowOverwriteKey, m.liAllowExport, m.tcLeafStoreName, ;
		        m.tcIntermediateStoreName, m.tcRootStoreName, m.tcExtraOptions) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat PFX LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqValue, the last binary result.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [VariantReadOnly]
		
		THIS.CallAssignObject(m.tqValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE lasterrorhtml_access		&& Access method used to retrieve the Chilkat PFX LastErrorHTML property.
		*==============================================================================
		* Method:            LastErrorHTML_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastErrorHTML property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastErrorHTML
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** Provides information in HTML format about the last method/property called. 
		** If a method call returns a value indicating failure, or behaves unexpectedly, 
		** examine this property to get more information.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*==============================================================================
		* Method:            LastErrorHTML_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastErrorHTML property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the last error message in HTML format.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
