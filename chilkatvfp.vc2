DEFINE CLASS authgoogle AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides functionality for authenticating calls to the Google Cloud Platform API and Google Apps API using a service account.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: accesstoken_access		&& Access method used to retrieve the Chilkat AuthGoogle AccessToken property.
		*m: accesstoken_assign		&& Assign method used to hold a reference to the AccessToken property.
		*m: addclaims		&& Introduced in version 9.5.0.99. Adds additional custom claims to the JWT claims set. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat AuthGoogle DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: emailaddress_access		&& Access method used to retrieve the Chilkat AuthGoogle DebugLogFilePath property.
		*m: emailaddress_assign		&& Assign method used to hold a reference to the EmailAddress property.
		*m: expirenumseconds_access		&& Access method used to retrieve the Chilkat AuthGoogle ExpireNumSeconds property.
		*m: expirenumseconds_assign		&& Assign method used to hold a reference to the ExpireNumSeconds property.
		*m: getp12		&& Introduced in version 9.5.0.58. Returns the private key in a PFX (P12) object. This is only possible if the private key was previously set by calling SetP12. Returns Nothing on failure.
		*m: iat_access		&& Access method used to retrieve the Chilkat AuthGoogle IAt property.
		*m: iat_assign		&& Assign method used to hold a reference to the IAt property.
		*m: jsonkey_access		&& Access method used to retrieve the Chilkat AuthGoogle JSONKey property.
		*m: jsonkey_assign		&& Assign method used to hold a reference to the JSONKey property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat AuthGoogle LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat AuthGoogle LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat AuthGoogle LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat AuthGoogle LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat AuthGoogle LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat AuthGoogle LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat AuthGoogle LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: numsecondsremaining_access		&& Access method used to retrieve the Chilkat AuthGoogle NumSecondsRemaining property.
		*m: numsecondsremaining_assign		&& Access method used to retrieve the Chilkat AuthUtil NumSecondsRemaining property.
		*m: obtainaccesstoken		&& Introduced in version 9.5.0.58. Sends the HTTP request to fetch the access token. When this method completes successfully, the access token is available in the AccessToken property. The connection is an existing connection to www.googleapis.com.
		*m: obtainaccesstokenasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the ObtainAccessToken method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: scope_access		&& Access method used to retrieve the Chilkat AuthGoogle Scope property.
		*m: scope_assign		&& Access method used to retrieve the Chilkat AuthUtil Scope property.
		*m: setp12		&& Introduced in version 9.5.0.58. Sets the P12 private key to be used for obtaining an access token. An application must set either the P12 or JSON private key, but not both. Returns 1 for success, 0 for failure.
		*m: subemailaddress_access		&& Access method used to retrieve the Chilkat AuthGoogle SubEmailAddress property.
		*m: subemailaddress_assign		&& Access method used to retrieve the Chilkat AuthUtil SubEmailAddress property.
		*m: valid_access		&& Access method used to retrieve the Chilkat AuthGoogle Valid property.
		*m: valid_assign		&& Access method used to retrieve the Chilkat AuthUtil Valid property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat AuthGoogle VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property
		*p: accesstoken		&& Introduced in version 9.5.0.58. The access token to be used in Google API requests. This property is set on a successful call to ObtainAccessToken.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: emailaddress		&& Introduced in version 9.5.0.58. The client email address of the service account. If a JSON key is used, then the client_email should already be specified within the JSON key, and this property is unused. This property must be set if using a P12 key.
		*p: expirenumseconds		&& Introduced in version 9.5.0.58. The expiration time, in seconds, of the access token to be requested. The maximum value is 1 hour (3600 seconds). The default value is 3600.
		*p: iat		&& Introduced in version 9.5.0.77. This property can be set to override the default current date/time value for the "iat" claim of the JWT. It can be set to a value indicating the number of seconds from 1970-01-01T00:00:00Z UTC.
		*p: jsonkey		&& Introduced in version 9.5.0.58. The JSON key for obtaining an access token. An application must set either the P12 or JSON private key, but not both.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult propert
		*p: numsecondsremaining		&& Introduced in version 9.5.0.58. If the access token is valid, contains the number of seconds remaining until it expires. A value of 0 indicates an invalid or expired access token.
		*p: scope		&& Introduced in version 9.5.0.58. A space-delimited list of the permissions that the application requests.
		*p: subemailaddress		&& Introduced in version 9.5.0.58. The email address of the user for which the application is requesting delegated access.
		*p: valid		&& Introduced in version 9.5.0.58. 1 if the AccessToken property contains a valid non-expired access token obtained via the call to ObtainAccessToken.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		accesstoken = 
		cchilkatclass = AuthGoogle
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		emailaddress = 
		expirenumseconds = 3600
		iat = 0
		iinstancepatch = 58
		jsonkey = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "authgoogle"
		numsecondsremaining = 0
		scope = 
		subemailaddress = 
		valid = 0
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE accesstoken_access		&& Access method used to retrieve the Chilkat AuthGoogle AccessToken property.
		*==============================================================================
		* Method:            AccessToken_Access
		* Purpose:           Access method used to retrieve the Chilkat AuthGoogle AccessToken property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AccessToken
		* Date Added:        07/29/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.58
		**
		** The access token to be used in Google API requests. 
		** This property is set on a successful call to ObtainAccessToken.
		**
		**   <b>Important:</b> This class is used for authenticating calls to the Google Cloud 
		**   Platform API and Google Apps API using a <b>service account.</b>. 
		**
		**   For 3-legged OAuth2, where a browser must be used to interactively get permission 
		**   from the Google account owner, use the Chilkat OAuth2 class/object.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE accesstoken_assign		&& Assign method used to hold a reference to the AccessToken property.
		*==============================================================================
		* Method:            AccessToken_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat AuthGoogle AccessToken property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the AccessToken property.
		* Returns:           
		* Date Added:        07/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
	ENDPROC

	PROCEDURE addclaims		&& Introduced in version 9.5.0.99. Adds additional custom claims to the JWT claims set. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddClaims
		* Purpose:           Adds additional custom claims to the JWT claims set.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/08/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.99
		**
		** Adds additional custom claims to the JWT claims set.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_AUTHGOOGLE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 99
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddClaims(m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_AUTHGOOGLE_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/05/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 99
		
		  Added the AddClaims method.
		
		** Version 75
		
		  Added the ability to open .pfx/.p12 files where two different passwords are required: 
		  one for integrity and the other for the private keys. 
		  See the example at https://www.example-code.com/csharp/pfx_multiple_passwords.asp
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16) 
		  rather than in number of characters. This is fixed to return the number of characters. 
		  (Note: this is a property that only exists in ActiveX classes, and is only useful 
		  for certain programming languages such as SQL Server to help programs determine 
		  if temp tables are required.)
		
		** Version 58
		
		 Added the AuthGoogle class.
		
		ENDTEXT
		
		#ENDIF 
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat AuthGoogle DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat AuthGoogle DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/29/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liIntroducedInBuild = 58
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
