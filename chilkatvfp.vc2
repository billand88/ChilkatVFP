	PROCEDURE partat		&& Introduced in version 11.0.0. Returns the Nth sub-part in subPart, with indexing starting at 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            PartAt
		* Purpose:           Returns the Nth sub-part in subPart, with indexing starting at 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the certificate index value.
		*                    toChilkatMime, a Chilkat MIME object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		** 
		** Introduced in version 11.0.0
		**
		** Returns the Nth sub-part in subPart, with indexing starting at 0.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiIndex AS Integer, toChilkatMime AS CHILKAT_MIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMime AS CHILKAT_MIME_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatMime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMime)
		
		     loChilkatMime = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.PartAt(m.tiIndex, m.loChilkatMime) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatMime = ;
		    m.loParkParameterCert.SetObject(m.toChilkatMime, m.loChilkatMime)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatMime
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatMime = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMime = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE partstofiles		&& Introduced in version 11.0.0. The function recursively traverses a MIME message, extracting and saving parts that have a filename. It saves these parts to the directory specified by path. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            PartsToFiles
		* Purpose:           The function recursively traverses a MIME message, 
		*                    extracting and saving parts that have a filename. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the certificate index value.
		*                    toChilkatMime, a Chilkat MIME object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		** 
		** Introduced in version 11.0.0
		**
		** Returns the Nth sub-part in subPart, with indexing starting at 0.
		**
		** Fixed for Version 11.6.0: The returned StringTable now contains the actual 
		** sanitized paths, and no nonexistent paths are added when extraction fails.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcPath AS Character, toChilkatMime AS CHILKAT_MIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMime AS CHILKAT_MIME_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatMime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMime)
		
		     loChilkatMime = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.PartsToFiles(m.tcPath, m.loChilkatMime) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatMime = ;
		    m.loParkParameterCert.SetObject(m.toChilkatMime, m.loChilkatMime)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatMime
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatMime = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMime = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE pkcs7cryptalg_access		&& Access method used to retrieve the Chilkat MIME PKCS7CryptAlg property.
		*==============================================================================
		* Method:            PKCS7CryptAlg_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME PKCS7CryptAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PKCS7CryptAlg
		* Date Added:        06/25/2022
		*==============================================================================
		
		** 
		** When the MIME is encrypted (using PKCS7 public-key encryption), 
		** this selects the underlying symmetric encryption algorithm. 
		** Possible values are: "aes", "des", "3des", and "rc2". The default value is "aes".
		**
		** Fixed in Version 11.4.0: When this property is set to aes-gcm, 
		** the encrypted email should use the Content-Type header smime-type=authEnveloped-data 
		** rather than smime-type=enveloped-data. This issue has been fixed.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE pkcs7cryptalg_assign		&& Assign method used to hold a reference to the PKCS7CrypttAlg property.
		*==============================================================================
		* Method:            PKCS7CryptAlg_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME PKCS7CryptAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the PKCS7CryptAlg property.
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		**
		** Fixed in version 11.4.0: When the property is set to aes-gcm, 
		** the encrypted email should use the Content-Type header smime-type=authEnveloped-data 
		** rather than smime-type=enveloped-data. This issue has been fixed.
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [PKCS7CryptAlg]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE pkcs7keylength_access		&& Access method used to retrieve the Chilkat MIME PKCS7KeyLength property.
		*==============================================================================
		* Method:            PKCS7KeyLength_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MIME PKCS7KeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PKCS7KeyLength
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** When the email is sent encrypted (using PKCS7 public-key encryption), 
		** this selects the key length of the underlying symmetric encryption algorithm. 
		** The possible values allowed depend on the Pkcs7CryptAlg property. 
		** For "aes", the key length may be 128, 192, or 256. 
		** For "3des" the key length must be 192. 
		** For "des" the key length must be 40. 
		** For "rc2" the key length can be 40, 56, 64, or 128.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE pkcs7keylength_assign		&& Assign method used to hold a reference to the PKCS7KeyLength property.
		*==============================================================================
		* Method:            PKCS7KeyLength_Assign
		* Purpose:           Assign method used to hold a reference to the PKCS7KeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PKCS7KeyLength property.
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [PKCS7KeyLength]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE protocol_access		&& Access method used to retrieve the Chilkat MIME Protocol property.
		*==============================================================================
		* Method:            Protocol_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME Protocol property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Protocol
		* Date Added:        06/25/2022
		*==============================================================================
		
		** 
		** The value of the "protocol" attribute of the Content-Type header field. 
		** For example, if the Content-Type header is this:
		**
		** Content-Type: multipart/signed; protocol="application/x-pkcs7-signature"; micalg=sha1; 
		**   boundary="------------ms000908010507020408060303"
		** 
		** then the value of the Protocol property is "application/x-pkcs7-signature".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE protocol_assign		&& Assign method used to hold a reference to the Protocol property.
		*==============================================================================
		* Method:            Protocol_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME Protocol property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Protocol property.
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE removeheaderfield		&& Removes a header field from the MIME header. If bAllOccurrences is 1, then all occurrences of the header field are removed. Otherwise, only the 1st occurrence is removed.
		*==============================================================================
		* Method:            RemoveHeaderField
		* Purpose:           Removes a header field from the MIME header.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeaderFieldName, the field name to remove.
		*                    tuAllOccurrences, whether or not to remove all occurrences
		*                    of the header field name.
		* Returns:           The entire MIME header.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Removes a header field from the MIME header. 
		** If bAllOccurrences is 1, then all occurrences of the header field are removed. 
		** Otherwise, only the 1st occurrence is removed.
		** 
		
		LPARAMETERS tcHeaderFieldName AS Character, tuAllOccurrences AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liAllOccurrences AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liAllOccurrences = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liAllOccurrences = .LogicalToBit(m.tuAllOccurrences)
		
		    TRY
		
		      m.loChilkatObject.RemoveHeaderField(m.tcHeaderFieldName, m.liAllOccurrences)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE removepart		&& Removes the Nth subpart from the MIME message. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            RemovePart
		* Purpose:           Removes the Nth subpart from the MIME message.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the signature part index value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Removes the Nth subpart from the MIME message.
		**
		** Fixed for Version 11.6.0: An out-of-range index 
		** returns false and leaves the tree unchanged.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.RemovePart(m.tiIndex) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

