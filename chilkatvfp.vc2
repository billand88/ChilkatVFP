	PROCEDURE channelreceiveuntilmatchn		&& The same as ChannelReceiveUntilMatch except that the method returns when any one of the match patterns specified in matchPatterns are received on the channel.
		*==============================================================================
		* Method:            ChannelReceiveUntilMatchN
		* Purpose:           The same as ChannelReceiveUntilMatch except that the method returns 
		*                    when any one of the match patterns specified in matchPatterns
		*                    are received on the channel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		* Parameters:        toChilkatStringArray, a Chilkat String Array object.
		*                    tcCharset, the character set of the matching pattern
		*                    tuCaseSensitive -- Set to 1 to make the search case sensitive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** The same as ChannelReceiveUntilMatch except that the method returns 
		** when any one of the match patterns specified in matchPatterns are received on the channel.
		**
		** Important: It's wise to set the ReadTimeoutMs property to a non-zero value 
		** to prevent an infinite wait if of the matchPatterns ever arrives.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiChannel AS Integer, toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		tcCharset AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown, liCaseSensitive AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.ChannelReceiveUntilMatchN(m.tiChannel, ;
		      m.loChilkatStringArray, m.tcCharset, m.liCaseSensitive) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatStringArray = m.loParkParameterStringArray.SetObject(;
		    m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

