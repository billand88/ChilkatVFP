	PROCEDURE fileadded		&& This event fires during the AppendFiles and AppendFilesEx method calls. It is called just after each file is added. The abort output-only argument may be set to 1 to abort the method call.
		*==============================================================================
		* Method:            FileAdded
		* Purpose:           This event fires during the AppendFiles and AppendFilesEx method calls.
		*                    It is called just after each file is added. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the file to be added.
		*                    tiFileSize, the size of the file to be added.
		*                    tiAbort, the abort setting.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** This event fires during the AppendFiles and AppendFilesEx method calls. 
		** It is called just after each file is added. 
		** The abort output-only argument may be set to 1 to abort the method call.
		**
		
		LPARAMETERS tcPath AS Character, tiFileSize AS Integer, tiAbort AS Integer
		
		LOCAL lcPath AS Character, liFileSize AS Integer, liAbort AS Integer
		
		lcPath = m.tcPath
		liFileSize = m.tiFileSize
		liAbort = m.tiAbort
		
		*!*  
		*!*  ? [FileAdded Event!] 
		*!*  ? [FileAdded: File Path = ] + lcPath
		*!*  ? [File Size = ] + STR(liFileSize)
		*!*  ? [Abort = ] + STR(liAbort)
		*!*  
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liAbort = 0
		
		    .FileAdded_Pre(m.lcPath, m.liFileSize, m.liAbort)
		
		    ** OK to continue test
		    IF m.liAbort = 0
		
		      .FileAdded_Process(m.lcPath, m.liFileSize, m.liAbort)
		
		      ** OK to continue test
		      IF m.liAbort = 0
		
		        .FileAdded_Post(m.lcPath, m.liFileSize, m.liAbort)
		
		      ENDIF m.liAbort = 0
		      ** End OK to continue test
		
		    ENDIF m.liAbort = 0
		    ** End OK to continue test
		
		  ENDIF m.liAbort = 0
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiFileSize = m.liFileSize
		tiAbort = m.liAbort
		
		RETURN
	ENDPROC

