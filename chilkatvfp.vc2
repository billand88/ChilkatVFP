	PROCEDURE appendcountedstring		&& Introduced in version 9.5.0.91. Appends a byte count followed by the string in the desired character encoding, such as "utf-8". The numCountBytes is the size in bytes of the integer to represent the byte count.
		*==============================================================================
		* Method:            AppendCountedString
		* Purpose:           Appends a byte count followed by the string 
		*                    in the desired character encoding, such as "utf-8".
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiByteCount, the byte count.
		*                    tuBigEndian, whether or not the big endian
		*                    byte ordering is used.
		*                    tcString, the string to append.
		*                    tcCharset, the appended string's character encoding.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        11/05/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		** 
		** Appends a byte count followed by the string in the desired character encoding, 
		** such as "utf-8". The numCountBytes is the size in bytes of the integer 
		** to represent the byte count. If 0, then a minimal number of bytes is used. 
		** If bigEndian is 1, the byte count is appended in big endian byte ordering, 
		** otherwise little-ending byte ordering. The str is the string to be appended. 
		** The charset is the character encoding, such as "utf-8", "utf-16", "windows-1252", etc.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiByteCount AS Integer, tuBigEndian AS Unknown, ;
		tcString AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_BINDATA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liBigEndian AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liBigEndian, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 91
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liBigEndian = .LogicalToBit(m.tuBigEndian)
		
		      TRY
		
		        STORE m.loChilkatObject.AppendCountedString(m.tiByteCount, ;
		        m.liBigEndian, m.tcString, m.tcCharset) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

