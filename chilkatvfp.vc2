	PROCEDURE removecustomheader		&& Removes a custom header by header field name.
		*==============================================================================
		* Method:            RemoveCustomHeader
		* Purpose:           Removes a custom header by header field name.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeaderName the header name to remove.
		* Returns:           
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Removes a custom header by header field name.
		**
		
		LPARAMETERS tcHeaderName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.RemoveCustomHeader(m.tcHeaderName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE requiresslcertverify_access		&& Access method used to retrieve the Chilkat MHT RequireSSLCertVerify property.
		*==============================================================================
		* Method:            RequireSSLCertVerify_Access
