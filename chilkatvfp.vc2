		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE sendcommand		&& Sends an raw command to the FTP server and returns the raw response. Returns Nothing on failure
		*==============================================================================
		* Method:            SendCommand
		* Purpose:           Sends an raw command to the FTP server 
		*                    and returns the raw response.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRAWCommand, the RAW command.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/05/2022
		*==============================================================================
		
		**
		** Sends an raw command to the FTP server and returns the raw response.
		**
		** Enhancement for version 76: Added the ability to resume downloads by this workaround: 
		** A special command can be passed to this method, namely “NextDownloadStartLoc <offset>” 
		** which doesn’t actually send a command but indicate that a “REST <offset>” 
		** command should be sent before the next RETR command. 
		** (The command “REST” is short for “restart”, and RETR is short for “retrieve”.)
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRAWCommand AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn 
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SendCommand(m.tcRAWCommand) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

