		RETURN
	ENDPROC

	PROCEDURE gentype1		&& Generates the Type 1 message. The Type 1 message is sent from Client to Server and initiates the NTLM authentication exchange. Returns Nothing on failure.
		*==============================================================================
		* Method:            GenType1
		* Purpose:           Generates the Type 1 message.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Type 1 Message
		* Date Added:        07/16/2022
		*==============================================================================
		
		**
		** Generates the Type 1 message. 
		** The Type 1 message is sent from Client to Server and initiates the NTLM authentication exchange.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_NTLM_COM_CALL, ;
		loException AS Exception, lcType1Message AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcType1Message = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcType1Message = m.loChilkatObject.GenType1()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcType1Message
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_NTLM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE gentype2		&& Generates a Type2 message from a received Type1 message. The server-side generates the Type2 message and sends it to the client. This is the 2nd step in the NTLM protocol.
		*==============================================================================
		* Method:            GenType2
		* Purpose:           Generates a Type2 message from a received Type1 message.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcType1Message, a Type 1 message.
		* Returns:           A Type 2 Message
		* Date Added:        07/16/2022
		*==============================================================================
		
		**
		** Generates a Type2 message from a received Type1 message. 
		** The server-side generates the Type2 message and sends it to the client. 
		** This is the 2nd step in the NTLM protocol. The 1st step is the client 
		** generating the initial Type1 message which is sent to the server.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcType1Message AS Character
		
		LOCAL loChilkatObject AS CHILKAT_NTLM_COM_CALL, ;
		loException AS Exception, lcType2Message AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcType2Message = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcType2Message = m.loChilkatObject.GenType2(m.tcType1Message)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcType2Message
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_NTLM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE gentype3		&& Generates the final message in the NTLM authentication exchange. This message is sent from the client to the server. The Type 2 message received from the server is passed to GenType3.
		*==============================================================================
		* Method:            GenType3
		* Purpose:           Generates the final message in the NTLM authentication exchange.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcType2Message, a Type 2 message.
		* Returns:           A Type 3 Message
		* Date Added:        07/16/2022
		*==============================================================================
		
		**
		** Generates the final message in the NTLM authentication exchange. 
		** This message is sent from the client to the server. 
		** The Type 2 message received from the server is passed to GenType3. 
		** The Username and Password properties are finally used here 
		** in the generation of the Type 3 message. Note, the Password is never actually sent. 
		** It is used to compute a binary response that the server can then check, 
		** using the password it has on file, to verify that indeed the client 
		** must've used the correct password.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcType2Message AS Character
		
		LOCAL loChilkatObject AS CHILKAT_NTLM_COM_CALL, ;
		loException AS Exception, lcType3Message AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcType3Message = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcType3Message = m.loChilkatObject.GenType3(m.tcType2Message)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcType3Message
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_NTLM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        07/15/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    ** Fill in property value...
		    .OEMCodePage = .OEMCodePage
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		RETURN m.llReturn
		
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat NTLM LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
