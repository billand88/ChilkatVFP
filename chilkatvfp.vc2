	PROCEDURE writestringtofile		&& Converts a Unicode string to a multibyte charset and writes the multibyte text data to a file. The destination charset is specified in the 2nd method argument. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            WriteStringToFile
		* Purpose:           Converts a Unicode string to a multibyte charset 
		*                    and writes the multibyte text data to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcText, the text to save.
		*                    tcFilePath, the path to the file to write.
		*                    tcCharset, the charset of the written file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Converts a Unicode string to a multibyte charset and writes the multibyte 
		** text data to a file. The destination charset is specified in the 2nd method argument.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcText AS Character, tcFilePath AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.WriteStringToFile(m.tcText, ;
		      m.tcFilePath, m.tcCharset) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS ckdatetime AS ibasechilkat OF "chilkatvfp.vcx" 		&& A class for holding a date/time value, and for converting it to from many different formats. The power of this class is that the different date/time formats are implemented across many different operating systems. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: adddays		&& Adds an integer number of days to the date/time. To subtract days, pass a negative integer. Returns 1 for success, 0 for failure.
		*m: addseconds		&& Introduced in version 9.5.0.65. Adds an integer number of seconds to the date/time. To subtract seconds, pass a negative integer. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat CkDateTime DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold the Chilkat CkDateTime DebugLogFiilePath property.
		*m: deserialize		&& Loads the date/time with a string having the format as produced by the Serialize method, which is a string of SPACE separated integers containing (in this order) year, month, day, hour, minutes, seconds, and a UTC flag having the value of 1/0.
		*m: diffseconds		&& Introduced in version 9.5.0.65. Returns the difference in seconds between the dateTimeArg and this date/time. The value returned is this object's date/time - dateTimeArg's date/time.
		*m: expireswithin		&& Introduced in version 9.5.0.67. Returns 1 if the date/time is within n seconds/minutes/hours/days of the current system date/time. Otherwise returns 0. The units can be "seconds", "minutes", "hours", or "days" (plural or singular).
		*m: getasdatetime		&& Returns the date/time in a native format. The .NET implementation returns a .NET System.DateTime structure. The ActiveX implementation returns a Date object. The C/C++ implementation (and others) returns the date/time in a SYSTEMTIME structure.
		*m: getasdosdate		&& Returns the date/time as a 32-bit DOS date/time bitmask. bLocal indicates whether a local or UTC time is returned.
		*m: getasiso8601		&& Introduced in version 9.5.0.65. Returns the date/time in a compatible ISO 8601 format according to the format specified in formatStr.
		*m: getasoledate		&& Returns the date/time in a Windows OLE "DATE" format. bLocal indicates whether a local or UTC time is returned. The OLE automation date format is a floating point value, counting days since midnight 30 December 1899.
		*m: getasrfc822		&& Returns the date/time as an RFC822 formatted string. (An RFC822 format string is what is found in the "Date" header field of an email, such as "Wed, 18 Oct 2017 09:08:21 GMT".) bLocal indicates whether a local or UTC time is returned.
		*m: getastimestamp		&& Introduced in version 9.5.0.58. Returns the date/time as an RFC 3339 formatted string, such as "1990-12-31T23:59:60Z". (This is an ISO 8061 format like the following: YYYY-MM-DDThh:mm:ssTZD) bLocal indicates whether a local or UTC time is returned.
		*m: getasunixtime		&& Returns the date/time as a 32-bit Unix time. bLocal indicates whether the date/time returned is local or UTC. Note: With this format, there is a Y2038 problem that pertains to 32-bit signed integers.
		*m: getasunixtimestr		&& Introduced in version 9.5.0.65. Returns the time in Unix format (in seconds since the epoch: 00:00:00 UTC on 1 January 1970). bLocal indicates whether the date/time returned is local or UTC. Returns Nothing on failure.
		*m: getdtobj		&& Introduced in version 9.5.0.47. Gets the date/time as a Chilkat "Dt" object. Returns Nothing on failure.
		*m: isdst_access		&& Access method used to retrieve the Chilkat CkDateTime IsDst property.
		*m: isdst_assign		&& Assign method used to hold the Chilkat CkDateTime IsDst property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat CkDateTime LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold the Chilkat CkDateTime LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat CkDateTime LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold the Chilkat CkDateTime LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat CkDateTime LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold the Chilkat CkDateTime LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat CkDateTime LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold the Chilkat CkDateTime LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat CkDateTime LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold the Chilkat CkDateTime LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat CkDateTime LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold the Chilkat CkDateTime LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat CkDateTime LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold the Chilkat CkDateTime LastStringResult property.
		*m: loadtaskresult		&& Introduced in version 9.5.0.52. Loads the date/time from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*m: olderthan		&& Introduced in version 9.5.0.67. Returns 1 if the date/time is older than the current system date/time by n seconds/minutes/hours/days. Otherwise returns 0. The units can be "seconds", "minutes", "hours", or "days" (plural or singular).
		*m: serialize		&& Serializes the date/time to a us-ascii string that can be imported at a later time via the DeSerialize method. The format of the string returned by this method is not intended to match any published standard.
		*m: setfromcurrentsystemtime		&& Sets the date/time from the current system time.
		*m: setfromdosdate		&& Sets the date/time from a 32-bit DOS date/time bitmask. See GetAsDosDate for more information.
		*m: setfromdtobj		&& Introduced in version 9.5.0.47. Sets the date/time from a Chilkat "Dt" object. Returns 1 for success, 0 for failure.
		*m: setfromntpserver		&& Introduced in version 9.5.0.96. Sets the date/time by sending a query to an NTP server. Returns 1 for success, 0 for failure.
		*m: setfromntptime		&& Introduced in version 9.5.0.50. Sets the date/time from a 32-bit NTP time value. ntpSeconds is the number of seconds since 00:00 (midnight) 1 January 1900 GMT.
		*m: setfromoledate		&& Sets the date/time from a Windows OLE "DATE" value. bLocal indicates whether the passed in date/time is local or UTC. Note: This method was not working correctly. The problem was discovered just after releasing v9.5.0.65.
		*m: setfromrfc822		&& Sets the date/time from an RFC822 date/time formatted string. Returns 1 for success, 0 for failure.
		*m: setfromtimestamp		&& Introduced in version 9.5.0.58. Sets the date/time from an RFC 3339 timestamp format. (such as "1990-12-31T23:59:60Z:") (This is an ISO 8061 format like the following: YYYY-MM-DDThh:mm:ssTZD)
		*m: setfromulid		&& Introduced in version 9.5.0.94. Sets this object's date/time using the timestamp embedded in the ulid. If the ulid was not a valid ULID, returns 0 and the date/time is not set. bLocal indicates whether the ulid uses a local time or UTC time.
		*m: setfromunixtime		&& Sets the date/time from a 32-bit UNIX time value. (See GetAsUnixTime for information about the Y2038 problem.) bLocal indicates whether the passed in date/time is local or UTC.
		*m: ulidgenerate		&& Introduced in version 9.5.0.94. Generates and returns a new ULID using this object's date/time value. bLocal indicates whether to use local time or UTC time. Returns Nothing on failure.
		*m: ulidincrement		&& Introduced in version 9.5.0.94. Increments the ULID that is passed in ulid.
		*m: ulidvalidate		&& Introduced in version 9.5.0.94. Validates the ulid. Returns 1 if the ulid is valid, otherwise returns 0. Returns 1 for success, 0 for failure.
		*m: utcoffset_access		&& Assign method used to hold the Chilkat CkDateTime UTCOffset property.
		*m: utcoffset_assign		&& Assign method used to hold the Chilkat CkDateTime UTCOffset property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat CkDateTime VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold the Chilkat CkDateTime VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: isdst		&& This is the Daylight Saving Time flag. It can have one of three possible values: 1, 0, or -1. It has the value 1 if Daylight Saving Time is in effect, 0 if Daylight Saving Time is not in effect, and -1 if the information is not available.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: utcoffset		&& For the current system's timezone, returns the number of seconds offset from UTC for this date/time. The offset includes daylight savings adjustment. Local timezones west of UTC return a negative offset.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = CkDateTime
		debuglogfilepath = 
		isdst = 1
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "ckdatetime"
		utcoffset = 0
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE adddays		&& Adds an integer number of days to the date/time. To subtract days, pass a negative integer. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddDays
		* Purpose:           Adds an integer number of days to the date/time.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiDays, the number of days to add or subtract.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Adds an integer number of days to the date/time. 
		** To subtract days, pass a negative integer.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiDays AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddDays(m.tiDays) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addseconds		&& Introduced in version 9.5.0.65. Adds an integer number of seconds to the date/time. To subtract seconds, pass a negative integer. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddSeconds
		* Purpose:           Adds an integer number of seconds to the date/time.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiSeconds, the number of seconds to add or subtract.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Adds an integer number of seconds to the date/time. 
		** To subtract seconds, pass a negative integer.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiSeconds AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddSeconds(m.tiSeconds) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Added the ToDtObj method.
		  
		  The GetDtObj method is now decremented.
		
		** Version 96
		
		  Added the SetFromNtpServer method to load the current date/time from an NTP server.
		
		** Version 94
		
		  Added ULID functions to generate ULID’s in various ways.
		
		** Version 93
		
		  The GetAsIso8601 method did not return the ISO-8601 formatted date/time correctly
		  for dates before the UNIX epoch (before Jan 1, 1970)
		
		** Version 77
		
		  Added the ability to also parse date/time strings formatted
		  as “YYMMDDhhmmssZ”, such as “181221132225Z”.
		
		** Version 69
		
		  The DiffSeconds method returned 0 when it should’ve returned a negative number.
		
		** Version 67
		
		  Added the ExpiresWithin and OlderThan methods.
		
		** Version 66
		
		  The CkDateTime.SetFromOleDate method was not working correctly.
		  It has been fixed, and the fix will appear in the next version to be released after v9.5.0.65.
		
		  CkDateTime.GetAsIso8601 interpreted the “bLocal” argument as the opposite.
		  This has also been fixed and the fix will appear in the next version to be released after v9.5.0.65.
		
		** Version 65
		
		  Added the CkDateTime.DiffSeconds to get the difference in seconds between two CkDateTime objects.
		
		  Added new methods to CkDateTime: AddSeconds, GetAsUnixTimeStr, GetAsIso8601.
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  (FIXED) The ActiveX LoadTaskResult methods always returned 0,
		  regardless of success/failure.
		
		  Added the GetAsTimestamp and SetFromTimestamp methods.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat CkDateTime DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CkDateTime DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/26/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold the Chilkat CkDateTime DebugLogFiilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat CkDateTime DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/26/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE deserialize		&& Loads the date/time with a string having the format as produced by the Serialize method, which is a string of SPACE separated integers containing (in this order) year, month, day, hour, minutes, seconds, and a UTC flag having the value of 1/0.
		*==============================================================================
		* Method:            Deserialize
		* Purpose:           Loads the date/time with a string having the format 
		*                    as produced by the Serialize method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSerializedDateTime, a serialized date time string
		* Returns:           
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Loads the date/time with a string having the format as produced 
		** by the Serialize method, which is a string of SPACE separated integers 
		** containing (in this order) year, month, day, hour, minutes, seconds, 
		** and a UTC flag having the value of 1/0.
		** 
		
		LPARAMETERS tcSerializedDateTime AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.Deserialize(m.tcSerializedDateTime)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE diffseconds		&& Introduced in version 9.5.0.65. Returns the difference in seconds between the dateTimeArg and this date/time. The value returned is this object's date/time - dateTimeArg's date/time.
		*==============================================================================
		* Method:            DiffSeconds
		* Purpose:           Returns the difference in seconds 
		*                    between the dateTimeArg and this date/time.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCkDateTime, a Chilkat Date Time object.
		* Returns:           The number of seconds difference.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Returns the difference in seconds between the dateTimeArg and this date/time. 
		** The value returned is this object's date/time - dateTimeArg's date/time. 
		** For example, if the returned value is positive, then this object's date/time 
		** is more recent than dateTimeArg's date/time. If the return value is negative, 
		** then this object's date/time is older than dateTimeArg's date/time.
		**
		** Fixed for version 69: This method returned 0 when it should’ve returned a negative number. 
		** 
		
		LPARAMETERS toChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, loException AS Exception, ;
		loParkParameterCkDateTime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liSeconds AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liSeconds
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCkDateTime = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTime)
		
		      loChilkatCkDateTime = m.loParkParameterCkDateTime.GetObject()
		
		      TRY
		
		        liSeconds = m.loChilkatObject.DiffSeconds(m.loChilkatCkDateTime)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCkDateTime = ;
		      m.loParkParameterCkDateTime.SetObject(m.toChilkatCkDateTime, m.loChilkatCkDateTime)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		RETURN m.liSeconds
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  toChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loParkParameterCkDateTime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE expireswithin		&& Introduced in version 9.5.0.67. Returns 1 if the date/time is within n seconds/minutes/hours/days of the current system date/time. Otherwise returns 0. The units can be "seconds", "minutes", "hours", or "days" (plural or singular).
		*==============================================================================
		* Method:            ExpiresWithin
		* Purpose:           Returns 1 if the date/time is within n 
		*                    seconds/minutes/hours/days of the current system date/time.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the numeric value associated with the units.
		*                    tcUnits, the units of time.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** Returns 1 if the date/time is within n seconds/minutes/hours/days 
		** of the current system date/time. Otherwise returns 0. 
		** The units can be "seconds", "minutes", "hours", or "days" (plural or singular).
		** 
		
		LPARAMETERS tiValue AS Integer, tcUnits AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.ExpiresWithin(m.tiValue, m.tcUnits) ;
		        TO m.liReturn, m.liReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getasdatetime		&& Returns the date/time in a native format. The .NET implementation returns a .NET System.DateTime structure. The ActiveX implementation returns a Date object. The C/C++ implementation (and others) returns the date/time in a SYSTEMTIME structure.
		*==============================================================================
		* Method:            GetAsDateTime
		* Purpose:           Returns the date/time in a native format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuLocalTime, whether or not the returned time 
		*                    is local or UTC time.
		* Returns:           A VFP DateTime value.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Returns the date/time in a native format. The .NET implementation 
		** returns a .NET System.DateTime structure. The ActiveX implementation returns a Date object. 
		** The C/C++ implementation (and others) returns the date/time in a SYSTEMTIME structure.
		** On Windows, SYSTEMTIME is defined at SYSTEMTIME. On non-Windows systems, 
		** Chilkat provides a SYSTEMTIME structure definition in SystemTime.h.
		** 
		** bLocal indicates whether a local or UTC time is returned.
		** 
		
		LPARAMETERS tuLocalTime AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		loException AS Exception, liLocalTime AS Integer, ;
		ltCurrent AS DateTime
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liLocalTime = 0
		ltCurrent = {/:}
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liLocalTime = .LogicalToBit(m.tuLocalTime)
		
		    TRY
		
		      ltCurrent = m.loChilkatObject.GetAsDateTime(m.liLocalTime)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.ltCurrent
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getasdosdate		&& Returns the date/time as a 32-bit DOS date/time bitmask. bLocal indicates whether a local or UTC time is returned.
		*==============================================================================
		* Method:            GetAsDOSDate
		* Purpose:           Returns the date/time as a 32-bit DOS date/time bitmask.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuLocalTime, whether or not the returned time 
		*                    is local or UTC time.
		* Returns:           An integer representing the current DOS DateTime value.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Returns the date/time as a 32-bit DOS date/time bitmask.
		** 
		** bLocal indicates whether a local or UTC time is returned.
		** 
		** The DOS date/time format is a bitmask:
		** 
		** 
		**                         24                16                 8                 0
		**          +-+-+-+-+-+-+-+-+ +-+-+-+-+-+-+-+-+ +-+-+-+-+-+-+-+-+ +-+-+-+-+-+-+-+-+
		**          |Y|Y|Y|Y|Y|Y|Y|M| |M|M|M|D|D|D|D|D| |h|h|h|h|h|m|m|m| |m|m|m|s|s|s|s|s|
		**          +-+-+-+-+-+-+-+-+ +-+-+-+-+-+-+-+-+ +-+-+-+-+-+-+-+-+ +-+-+-+-+-+-+-+-+
		**           \___________/\________/\_________/ \________/\____________/\_________/
		**               year        month       day      hour       minute        second
		**
		** The year is stored as an offset from 1980. Seconds are stored in two-second increments. 
		** (So if the "second" value is 15, it actually represents 30 seconds.)
		** 
		
		LPARAMETERS tuLocalTime AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		loException AS Exception, liLocalTime AS Integer, liDOSDate AS Integer
		
		STORE 0 TO m.liLocalTime, m.liDOSDate
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liLocalTime = .LogicalToBit(m.tuLocalTime)
		
		    TRY
		
		      liDOSDate = m.loChilkatObject.GetAsDOSDate(m.liLocalTime)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liDOSDate 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getasiso8601		&& Introduced in version 9.5.0.65. Returns the date/time in a compatible ISO 8601 format according to the format specified in formatStr.
		*==============================================================================
		* Method:            GetAsISO8601
		* Purpose:           Returns the date/time in a compatible ISO 8601 format 
		*                    according to the format specified in formatStr.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDateTimeFormat, the format of the output string.
		*                    tuLocalTime, whether or not the returned time 
		*                    is local or UTC time.
		* Returns:           A character value representing the ISO8601 format
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Returns the date/time in a compatible ISO 8601 format according to the format 
		** specified in formatStr. Examples of ISO 8601 formats include the following:
		** 
		**       YYYY-MM-DD
		** 
		**       YYYY-MM-DDThh:mmTZD
		** 
		**       YYYY-MM-DDThh:mm:ssTZD
		** 
		** For the date portion of these formats, YYYY is a four-digit year representation, 
		** MM is a two-digit month representation, and DD is a two-digit day representation. 
		** For the time portion, hh is the hour representation in 24-hour notation, 
		** mm is the two-digit minute representation, and ss is the two-digit second representation. 
		** A time designator T separates the date and time portions of the string, 
		** while a time zone designator TZD specifies a time zone (UTC).
		**
		** bLocal indicates whether a local or UTC time is returned.
		**
		** Note: The bLocal argument is interpreted as the reverse of what is intended. 
		** The problem was discovered just after releasing v9.5.0.65. 
		** It will be fixed in the next version update.
		**
		** Fixed in version 93: The method did not return the ISO-8601 
		** formatted date/time correctly for dates before the UNIX epoch (before Jan 1, 1970)
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcDateTimeFormat AS Character, tuLocalTime AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liLocalTime AS Integer, ;
		lcISO8601Format AS Character
		
		STORE 0 TO m.liIntroducedInBuild, m.liLocalTime 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcISO8601Format = []
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liLocalTime = .LogicalToBit(m.tuLocalTime)
		
		      TRY
		
		        lcISO8601Format = m.loChilkatObject.GetAsISO8601(m.tcDateTimeFormat, m.liLocalTime)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcISO8601Format 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getasoledate		&& Returns the date/time in a Windows OLE "DATE" format. bLocal indicates whether a local or UTC time is returned. The OLE automation date format is a floating point value, counting days since midnight 30 December 1899.
		*==============================================================================
		* Method:            GetAsOLEDate
		* Purpose:           Returns the date/time in a Windows OLE "DATE" format.
