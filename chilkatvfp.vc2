	PROCEDURE listsecrets		&& Introduced in version 10.1.0. Lists secrets matching the wildcarded or exact values passed in json. The results of the query are returned in jsonOut. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ListSecrets
		* Purpose:           Lists secrets matching the wildcarded or exact values passed in json. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONIn, a Chilkat JSON object.
		*                    toChilkatJSONOut, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0.
		**
		** Lists secrets matching the wildcarded or exact values passed in json. 
		** The results of the query are returned in jsonOut.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSONIn AS [Chilkat.JsonObject], toChilkatJSONOut AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Secrets], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJsonIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterJsonOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONIn AS [Chilkat.JsonObject], loChilkatJSONOut AS [Chilkat.JsonObject], ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJsonIn, ;
		m.loParkParameterJsonOut, m.loChilkatJSONIn, m.loChilkatJSONOut
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONIn)
		
		      loParkParameterJsonOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONOut)
		
		      loChilkatJSONIn = m.loParkParameterJsonIn.GetObject()
		      loChilkatJSONOut = m.loParkParameterJsonIn.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ListSecrets(m.loChilkatJSONIn, m.loChilkatJSONOut) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONIn = ;
		      m.loParkParameterJsonIn.SetObject(m.toChilkatJSONIn, m.loChilkatJSONIn)
		
		      toChilkatJSONOut = ;
		      m.loParkParameterJsonIn.SetObject(m.toChilkatJSONOut, m.loChilkatJSONOut)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonIn, m.loChilkatJSONIn, ;
		m.loParkParameterJsonOut, m.loChilkatJSONOut
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Secrets])
		  toChilkatJSONIn = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONIn = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJSONOut = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonOut = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONOut = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE listsecretsasync		&& Introduced in version 10.1.0. Creates an asynchronous task to call the ListSecrets method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            ListSecretsAsync
		* Purpose:           Creates an asynchronous task to call the ListSecrets 
		*                    method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONIn, a Chilkat JSON object.
		*                    toChilkatJSONOut, a Chilkat JSON object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0.
		**
		** Creates an asynchronous task to call the ListSecrets method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatJSONIn AS [Chilkat.JsonObject], toChilkatJSONOut AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Secrets], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJsonIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterJsonOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONIn AS [Chilkat.JsonObject], loChilkatTask AS [Chilkat.Task], ;
		loChilkatJSONOut AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJsonIn, ;
		m.loParkParameterJsonOut, m.loChilkatJSONIn, m.loChilkatJSONOut, m.loChilkatTask
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONIn)
		
		      loParkParameterJsonOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONOut)
		
		      loChilkatJSONIn = m.loParkParameterJsonIn.GetObject()
		      loChilkatJSONOut = m.loParkParameterJsonOut.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.ListSecretsAsync(m.loChilkatJSONIn, m.loChilkatJSONOut)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONIn = ;
		      m.loParkParameterJsonIn.SetObject(m.toChilkatJSONIn, m.loChilkatJSONIn)
		
		      toChilkatJSONOut = ;
		      m.loParkParameterJsonIn.SetObject(m.toChilkatJSONOut, m.loChilkatJSONOut)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonIn, m.loChilkatJSONIn, ;
		m.loParkParameterJsonOut, m.loChilkatJSONOut
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Secrets])
		  toChilkatJSONIn = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONIn = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatJSONOut = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonOut = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONOut = NEWOBJECT([Chilkat.JsonObject])
		  loChilkatTask = NEWOBJECT([Chilkat.Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE location_access		&& Access method used to retrieve the Chilkat Secrets Location property.
		*==============================================================================
		* Method:            Location_Access
		* Purpose:           Access method used to retrieve the Chilkat Secrets Location property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Location
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		**
		** The location of the secrets. Possible values are:
		**
		** "local_manager" - On Windows this is the Credentials Manager. 
		** On MacOS and iOS it is the Keychain. This is not yet an option on Linux or Android.
		** "aws_secrets_manager" - AWS Secrets Manager
		** "azure_key_vault" - Azure Key Vault
		** "ibm_cloud" - IBM Cloud Secrets Manager
		** "oracle_cloud" - Oracle Cloud Secrets
		** "doppler" - Doppler Secrets
		** "memory" - In-Memory Secrets
		** 
		** The default location is the "local_manager". 
		** On Linux and Android, "local_manager" will behave the same as "memory".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

