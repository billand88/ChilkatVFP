	PROCEDURE hashalgorithm_crypt2		&& Method run to validate the data for the Crypt2 HashAlgorithm property.
		*==============================================================================
		* Method:            HashAlgorithm_Crypt2
		* Purpose:           Method run to validate the data for 
		*                    the Crypt2 HashAlgorithm_Crypt2 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer, ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[15, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have a word to validate test (should be true)
		  IF m.liWords = 1
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = STRTRAN(m.lcValue, [ ])
		
		          la_Values[1, 1] = [SHA1]
		          la_Values[1, 2] = 0
		          la_Values[2, 1] = [SHA256]
		          la_Values[2, 2] = 0
		          la_Values[3, 1] = [SHA384]
		          la_Values[3, 2] = 0
		          la_Values[4, 1] = [SHA512]
		          la_Values[4, 2] = 0
		          la_Values[5, 1] = [SHA3-224]
		          la_Values[5, 2] = .GenerateVersionNumber(9, 5, 83)
		          la_Values[6, 1] = [SHA3-256]
		          la_Values[6, 2] = .GenerateVersionNumber(9, 5, 83)
		          la_Values[7, 1] = [SHA3-384]
		          la_Values[7, 2] = .GenerateVersionNumber(9, 5, 83)
		          la_Values[8, 1] = [SHA3-512]
		          la_Values[8, 2] = .GenerateVersionNumber(9, 5, 83)
		          la_Values[9, 1] = [MD2]
		          la_Values[9, 2] = 0
		          la_Values[10, 1] = [MD5]
		          la_Values[10, 2] = 0
		          la_Values[11, 1] = [HAVAL]
		          la_Values[11, 2] = 0
		          la_Values[12, 1] = [RIPEMD128]
		          la_Values[12, 2] = 0
		          la_Values[12, 1] = [RIPEMD160]
		          la_Values[12, 2] = 0
		          la_Values[13, 1] = [RIPEMD256]
		          la_Values[13, 2] = 0
		          la_Values[14, 1] = [RIPEMD320]
		          la_Values[14, 2] = 0
		          la_Values[15, 1] = [SHA224]
		          la_Values[15, 2] = .GenerateVersionNumber(9, 5, 95)
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End walk through words loop
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords > 0
		  ** End have words to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE hashalgorithm_csr		&& Method run to validate the data for the CSR HashAlgorithm property.
		*==============================================================================
		* Method:            HashAlgorithm_CSR
		* Purpose:           Method run to validate the data for the HashAlgorithm_CSR property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer, ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[5, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		llValidated = EMPTY(m.lcValue)
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		  STORE [] TO m.lcWord, m.la_Values
		
		  liWords = GETWORDCOUNT(m.lcValue, [,])
		
		  ** Have a word to validate test (should be true)
		  IF m.liWords = 1
		
		    WITH m.loChilkatWrapper
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		        WITH m.loVersioning
		
		          ** Get rid of the spaces in the words...
		          lcValue = STRTRAN(m.lcValue, [ ])
		
		          la_Values[1, 1] = [SHA1]
		          la_Values[1, 2] = .GenerateVersionNumber(9, 5, 82)
		          la_Values[2, 1] = [SHA256]
		          la_Values[2, 2] = .GenerateVersionNumber(9, 5, 82)
		          la_Values[3, 1] = [SHA384]
		          la_Values[3, 2] = .GenerateVersionNumber(9, 5, 82)
		          la_Values[4, 1] = [SHA512]
		          la_Values[4, 2] = .GenerateVersionNumber(9, 5, 82)
		          la_Values[5, 1] = [SHA224]
		          la_Values[5, 2] = .GenerateVersionNumber(9, 5, 95)
		
		          ** Assume it's validated...
		          ** If we have an issue just kick it back to .F.
		          llValidated = .T. 
		
		          ** Walk through words loop
		          FOR li = 1 TO m.liWords
		
		            lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		            liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		            ** No match or below current version test
		            IF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		              llValidated = .F.
		              EXIT
		
		            ENDIF m.liMatch = 0 ;
		            OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		            ** End no match test
		
		          ENDFOR m.li = 1 TO m.liWords
		          ** End walk through words loop
		
		        ENDWITH
		
		      ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		      ** End have versioning object test
		
		    ENDWITH
		
		  ENDIF m.liWords > 0
		  ** End have words to validate test (should be true)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE havalrounds		&& Method run to validate the data for the HAVALRounds property.
		*==============================================================================
		* Method:            HAVALRounds
		* Purpose:           Method run to validate the data for the HAVALRounds property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the value to validate
