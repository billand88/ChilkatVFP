	PROCEDURE ocspcheck		&& Gets the server certificate at a domain:port and then sends an OCSP request to the certificate's OCSP URL to determine if the certificate has been revoked.
		*==============================================================================
		* Method:            OSCPCheck
		* Purpose:           Gets the server certificate at a domain:port 
		*                    and then sends an OCSP request to the certificate's OCSP URL.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDomain -- the OCSP server domain
		*                    tiPort -- the port to draw from.
		* Returns:           Numeric
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.84
		**
		** Gets the server certificate at a domain:port and then sends an OCSP request 
		** to the certificate's OCSP URL to determine if the certificate has been revoked. 
		** Returns the OCSP status, which has one of the following values:
		**
		** -1: Unable to check. See the contents of the LastErrorText property for more informaiton.
		** 0: Good
		** 1: Revoked
		** 2: Unknown
		**
		** Enhancement in Version 94: Chilkat improved OCSP requests 
		** (used in various parts of the Chilkat API) to satisfy some servers 
		** that are more picky about certain parts of the OCSP protocol which should be optional.
		** 
		** Fixed for Version 10: Fixed a problem having to do 
		** with sending OCSP requests for ECDSA based certificates.
		**
		
		LPARAMETERS tcDomain AS Character, tiPort AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 84
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liReturn = m.loChilkatObject.OSCPCheck(m.tcDomain, m.tiPort)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ocspcheckasync		&& Creates an asynchronous task to call the OcspCheck method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            OSCPCheckAsync
		* Purpose:           Creates an asynchronous task to call the OCSPCheck 
		*                    method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDomain -- the OCSP server domain
		*                    tiPort -- the port to draw from.
		* Returns:           Numeric
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.84
		**
		** Creates an asynchronous task to call the OCSPCheck method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Enhancement in Version 94: Chilkat improved OCSP requests 
		** (used in various parts of the Chilkat API) to satisfy some servers 
		** that are more picky about certain parts of the OCSP protocol which should be optional.
		** 
		** Fixed for Version 10: Fixed a problem having to do 
		** with sending OCSP requests for ECDSA based certificates.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcDomain AS Character, tiPort AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 84
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.OSCPCheckAsync(m.tcDomain, m.tiPort)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
