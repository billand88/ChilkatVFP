		*                    the Chilkat FTP2 SyncedFiles property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SyncedFiles property.
		* Returns:           
		* Date Added:        02/26/2022
		*==============================================================================
		
		**
		** Version 11.0.0: Property removed.
		**
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    la_IntroducedInBuild[1] = 9
		    la_IntroducedInBuild[2] = 5
		    la_IntroducedInBuild[3] = 51
		
		    lcValidationMethod = []
		    lcMethodToCall = [String]
		
		    .CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

	PROCEDURE synclocaldir		&& The same as SyncLocalTree, except the sub-directories are not traversed. The files in the current remote directory are synchronized (downloaded) with the files in localRoot. For possible mode settings, see SyncLocalTree.
		*==============================================================================
		* Method:            SyncLocalDir
		* Purpose:           The same as SyncLocalTree, except the sub-directories are not traversed. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalRootDirectory -- the local root directory to sync.
		*                    tiSyncMode -- the synchronization mode.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** The same as SyncLocalTree, except the sub-directories are not traversed. 
		** The files in the current remote directory are synchronized (downloaded) 
		** with the files in localRoot. 
		** For possible mode settings, see SyncLocalTree.
		**
		** Note: In v9.5.0.51 and higher, the list of downloaded files 
		** is available in the SyncedFiles property.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcLocalRootDirectory AS Character, tiSyncMode AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFiles = ;
		      m.loChilkatObject.SyncLocalDir(m.tcLocalRootDirectory, m.tiSyncMode)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

