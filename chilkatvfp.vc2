	PROCEDURE examineplan		&& Introduced in version 11.5.0. Used for debugging. Returns in json the plan of execution that would occur for the curl based on the variables that are either unknown or already known.
		*==============================================================================
		* Method:            ExaminePlan
		* Purpose:           Used for debugging.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCurl, the Curl to be examined.
		*                    toChilkatJsonObject, the object to hold the results of the examination.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/15/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Used for debugging. Returns in json the plan of execution that would occur 
		** for the curl based on the variables that are either unknown or already known. 
		** The plan of execution is what would occur if DoYourThing was called 
		** with the current state of knowledge.
		**
		** If no execution plan is possible with the current known inputs and outputs, 
		** then json provides information about what is missing and the method returns 0.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCurl AS Character, toChilkatJsonObject AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ExaminePlan(m.tcCurl, ;
		        m.loChilkatJsonObject) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.HttpCurl])
		  loException = NEWOBJECT([Exception])
		  toChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterChilkatJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	HIDDEN PROCEDURE failedcurl_access		&& Access method used to retrieve the Chilkat HttpCurl FailedCurl property.
