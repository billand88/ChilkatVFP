	PROCEDURE getproperty		&& To be documented soon...Returns Nothing on failure.
		*==============================================================================
		* Method:            GetProperty
		* Purpose:           To be documented soon...
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML -- a Chilkat XML object.
		*                    tcPropertyName -- the property name to retrieve.
		* Returns:           A Chilkat XML object, or NULL.
		* Date Added:        07/04/2022
		*==============================================================================
		
		**
		** To be documented soon...
		** 
		** Returns Nothing on failure
		**
		** In Version 9.3.1 notes: 
		** This was added to provide the ability to handle “Property Qualifiers”. 
		** (see http://www.aiim.org/documents/standards/xmpspecification.pdf )
		** 
		** Property Qualifiers
		** 
		** Any individual property value may have other properties attached to it; these attached
		** properties are called property qualifiers. They are in effect “properties of properties”; they can
		** provide additional information about the property value. For example, a digital resource
		** representing a musical production might have one or more authors, specified using the
		** dc:creator property, which is an array (see the figure below). Each array value might have a
		** property qualifier called role, which could take a value of “composer” or “lyricist” or
		** possibly other values.
		** 
		** NOTE: At this time, only simple properties may have qualifiers, and the qualifiers themselves
		** must be simple values (not structures or arrays). This is because of limitations in early
		** versions of the Adobe XMP Toolkit.
		** 
		** To handle the situation, a new method named GetProperty was added. 
		** It returns the Xml node for the property. 
		** The Chilkat XML API can then be used to get the attributes.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL, tcPropertyName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMP_COM_CALL, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		loChilkatXMLPropertyValue AS CHILKAT_XML_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatXMLPropertyValue, m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      loChilkatXMLPropertyValue = ;
		      m.loChilkatObject.GetProperty(m.loChilkatXML, m.tcPropertyName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.loChilkatXMLPropertyValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMP_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loChilkatXMLPropertyValue = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

