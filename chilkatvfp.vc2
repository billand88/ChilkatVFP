	PROCEDURE httpsreq		&& Introduced in version 11.0.0. Sends an HTTP request to web server at domain:port using TLS if ssl equals 1. The content of the request, including the path part of the URL, query params, additional headers, and request body is defined by request.
		*==============================================================================
		* Method:            HttpSReq
		* Purpose:           Sends an HTTP request to url where the content 
		*                    of the request is defined by request.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDomain -- the web server domain.
		*                    tiPort -- the port to communicate to the web server.
		*                    tuSSL -- flag to use Secure Socket Layer
		*                    toChilkatHTTPRequest -- a Chilkat HTTP Request object.
		*                    toChilkatHTTPResponse -- a Chilkat HTTP Response object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Sends an HTTP request to url where the content of the request is defined by request. 
		** The path and query part of target is taken from the url instead of the path property within request.
		** 
		** scheme   host       path             query    
		** +----+  +---------++--------------+ +--------+ 
		** https://example.com/docs/index.html?search=test
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcDomain AS Character, tiPort AS Integer, tuSSL AS Unknown, ;
		toChilkatHTTPRequest AS CHILKAT_HTTPREQUEST_COM_CALL, toChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterHTTPRequest AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterHTTPResponse AS [iParkParameter OF ChilkatVFP.VCX], liSSL AS Integer, ;
		loChilkatHTTPRequest AS CHILKAT_HTTPREQUEST_COM_CALL, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn, m.liSSL
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHTTPRequest, m.loChilkatHTTPRequest, ;
		m.loParkParameterHTTPResponse, m.loChilkatHTTPResponse
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSSL = .LogicalToBit(m.tuSSL)
		
		      loParkParameterHTTPRequest = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHTTPRequest)
		
		      loChilkatHTTPRequest = m.loParkParameterHTTPRequest.GetObject()
		
		      loParkParameterHTTPResponse = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHTTPResponse)
		
		      loChilkatHTTPResponse = m.loParkParameterHTTPResponse.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.HttpSReq(m.tcDomain, m.tiPort, m.liSSL, ;
		        m.loChilkatHTTPRequest, m.loChilkatHTTPResponse) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatHTTPRequest = m.loParkParameterHTTPRequest.SetObject(;
		      m.toChilkatHTTPRequest, m.loChilkatHTTPRequest)
		
		      toChilkatHTTPResponse = m.loParkParameterHTTPResponse.SetObject(;
		      m.toChilkatHTTPResponse, m.loChilkatHTTPResponse)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHTTPRequest, m.loChilkatHTTPRequest, ;
		m.loParkParameterHTTPResponse, m.loChilkatHTTPResponse
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatHTTPRequest = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  toChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loParkParameterHTTPRequest = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterHTTPResponse = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatHTTPRequest = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
