		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsyncedfiles		&& Introduced in version 10.0.0. Appends to strTable the paths of the files uploaded or downloaded in the last call to SyncDeleteTree, SyncLocalDir, SyncLocalTree, SyncRemoteTree, or SyncRemoteTree2.
		*==============================================================================
		* Method:            GetSyncedFiles
		* Purpose:           Appends to strTable the paths of the files uploaded 
		*                    or downloaded in the last call to SyncDeleteTree, SyncLocalDir, 
		*                    SyncLocalTree, SyncRemoteTree, or SyncRemoteTree2. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringTable, a Chilkat StringTable object.
		* Returns:           
		* Date Added:        09/27/2024
		*==============================================================================
		
		**
		** Introduced in version 10.0.0
		**
		** Appends to strTable the paths of the files uploaded or downloaded in the last call to SyncDeleteTree, 
		** SyncLocalDir, SyncLocalTree, SyncRemoteTree, or SyncRemoteTree2. In both cases 
		** (for upload and download) each line contains the paths relative to the root synced directory.
		** 
		
		LPARAMETERS toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL ARRAY la_Implemented(3)
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		llImplemented = .F.
		
		la_Implemented(1) = 10
		la_Implemented(2) = 0
		la_Implemented(3) = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(@m.la_Implemented)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetSyncedFiles(m.loChilkatStringTable) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = ;
		      m.loParkParameterStringTable.SetObject(m.toChilkatStringTable, m.loChilkatStringTable)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  toChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE gettextdirlisting		&& Returns a listing of the files and directories in the current directory matching the pattern. Passing "*.*" will return all the files and directories. Returns Nothing on failure
		*==============================================================================
