	PROCEDURE mbxlist		&& Introduced in version 11.0.0. Queries the IMAP server to retrieve the mailboxes in mboxes. If subscribed is 1, only subscribed mailboxes are included. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            MbxList
		* Purpose:           Queries the IMAP server to retrieve the mailboxes in mboxes. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuSubscribedOnly -- include subscribed mailboxes only.
		*                    tcReference -- the starting message ID number.
		*                    tcMbxPattern -- the Mbx wildcard pattern.
		*                    toChilkatMailBoxes -- a Chilkat MailBoxes object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Queries the IMAP server to retrieve the mailboxes in mboxes. 
		** If subscribed is 1, only subscribed mailboxes are included.
		**
		** The reference acts as a base path or context for interpreting the second argument. 
		** It is typically set to "" (empty string) or the current directory. It allows for relative mailbox naming.
		** 
		** The mbxPattern is a wildcard pattern (similar to globbing) that defines which mailboxes to return. It uses wildcards.
		** 
		** * matches zero or more levels of hierarchy (e.g., * or INBOX/*)
		** % matches one level of hierarchy (e.g., INBOX/%)
		** For example:
		** 
		** If reference = "" and mbxPattern = "*" then lists all mailboxes from the root (absolute path).
		** If reference = "" and mbxPattern = "%" then lists only top-level mailboxes (one level deep).
		** If reference = "INBOX." and mbxPattern = "*" then lists all folders under INBOX. (e.g., INBOX.Sent, INBOX.Archive)
		** 
		** Note: This method has the side-effect of setting the SeparatorChar property 
		** to the correct character used by the IMAP server, which is typically "/" or ".".
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuSubscribedOnly AS Unknown, tcReference AS Character, ;
		tcMbxPattern AS Character, toChilkatMailBoxes AS CHILKAT_MAILBOXES_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liSubscribedOnly AS Integer, ;
		loParkParameterMailboxes AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMailBoxes AS CHILKAT_MAILBOXES_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liSubscribedOnly
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMailboxes, m.loChilkatMailBoxes
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSubscribedOnly = .LogicalToBit(m.tuSubscribedOnly)
		
		      loParkParameterMailboxes = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMailBoxes)
		
		      loChilkatMailBoxes = m.loParkParameterMailboxes.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.MbxList(m.liSubscribedOnly, m.tcReference, ;
		        m.tcMbxPattern, m.loChilkatMailBoxes) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatMailBoxes = m.loParkParameterMailboxes.SetObject(;
		      m.toChilkatMailBoxes, m.loChilkatMailBoxes)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMailboxes, m.loChilkatMailBoxes
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMailBoxes  = NEWOBJECT(CHILKAT_MAILBOXES_COM_CALL)
		  loParkParameterMailboxes = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMailBoxes = NEWOBJECT(CHILKAT_MAILBOXES_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE mbxlistasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the MbxList method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*==============================================================================
		* Method:            MbxListAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    MbxList method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuSubscribedOnly -- include subscribed mailboxes only.
		*                    tcReference -- the starting message ID number.
		*                    tcMbxPattern -- the Mbx wildcard pattern.
		*                    toChilkatMailBoxes -- a Chilkat MailBoxes object.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Creates an asynchronous task to call the MbxList method with the arguments provided. 
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tuSubscribedOnly AS Unknown, tcReference AS Character, ;
		tcMbxPattern AS Character, toChilkatMailBoxes AS CHILKAT_MAILBOXES_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liSubscribedOnly AS Integer, ;
		loParkParameterMailboxes AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMailBoxes AS CHILKAT_MAILBOXES_COM_CALL, llImplemented AS Logical, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE 0 TO liReturn, luReturn, liSubscribedOnly
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMailboxes, m.loChilkatMailBoxes, m.loChilkatTask
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSubscribedOnly = .LogicalToBit(m.tuSubscribedOnly)
		
		      loParkParameterMailboxes = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMailBoxes)
		
		      loChilkatMailBoxes = m.loParkParameterMailboxes.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.MbxListAsync(m.liSubscribedOnly, ;
		        m.tcReference, m.tcMbxPattern, m.loChilkatMailBoxes)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatMailBoxes = m.loParkParameterMailboxes.SetObject(;
		      m.toChilkatMailBoxes, m.loChilkatMailBoxes)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMailboxes, m.loChilkatMailBoxes
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMailBoxes  = NEWOBJECT(CHILKAT_MAILBOXES_COM_CALL)
		  loParkParameterMailboxes = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMailBoxes = NEWOBJECT(CHILKAT_MAILBOXES_COM_CALL)
		  loChilkatTask = NEWOBJECT([Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE movemessages		&& Introduced in version 9.5.0.64. Moves a set of messages from one mailbox to another. Note: This is only possible if the IMAP server supports the "MOVE" extension.
		*==============================================================================
		* Method:            MoveMessages
		* Purpose:           Moves a set of messages from one mailbox to another.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatMessageSet -- a Chilkat Message Set object.
		*                    tcDestinationFolder -- the destination folder for the messages.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.64
		** 
		** Moves a set of messages from one mailbox to another. 
		** Note: This is only possible if the IMAP server supports the "MOVE" extension. 
		** The messageSet contains message UIDs or sequence numbers 
		** for messages in the currently selected mailbox. 
		** The destFolder is the destination mailbox/folder.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, ;
		tcDestinationFolder AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterMessageSet AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		llImplemented = .F.
		liIntroducedInBuild = 64
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterMessageSet = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		      loChilkatMessageSet = m.loParkParameterMessageSet.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.MoveMessages(m.loChilkatMessageSet, m.tcDestinationFolder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		       toChilkatMessageSet = ;
		      m.loParkParameterMessageSet.SetObject(m.toChilkatMessageSet, m.loChilkatMessageSet)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loParkParameterMessageSet = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

