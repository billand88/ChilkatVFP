	HIDDEN PROCEDURE sendpacketsize_access		&& Access method used to retrieve the Chilkat Socket SendPacketSize property.
		*==============================================================================
		* Method:            SendPacketSize_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket SendPacketSize property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SendPacketSize
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** The number of bytes to send at a time (internally). 
		** This can also be though of as the "chunk size". 
		** If a large amount of data is to be sent, 
		** the data is sent in chunks equal to this size in bytes. 
		** The default value is 65535. (Note: This only applies to non-SSL/TLS connections. 
		** SSL and TLS have their own pre-defined packet sizes.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sendpacketsize_assign		&& Assign method used to hold a reference to the SendPacketSize property.
		*==============================================================================
		* Method:            SendPacketSize_Assign
		* Purpose:           Assign method used to hold a reference to the SendPacketSize property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the SendPacketSize property.
		* Returns:           
		* Date Added:        05/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE sendsb		&& Introduced in version 9.5.0.65. Sends the contents of sb over the connection. If transmission halts for more than MaxSendIdleMs milliseconds, the send is aborted. The string is sent in the charset encoding specified by the StringCharset property.
		*==============================================================================
