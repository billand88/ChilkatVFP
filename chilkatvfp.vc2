		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS zip AS ibasechilkat OF "chilkatvfp.vcx" 		&& Zip compression component.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat ZIP AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: addbd		&& Introduced in version 11.0.0. Appends the contents of bd as a new entry to this object. Returns 1 for success, 0 for failure.
		*m: addembedded		&& (Relevant only when running on a Microsoft Windows operating system.) Embeds a Zip file into an EXE as a custom resource. This resource can be opened by the EXE containing it at runtime by using the OpenMyEmbedded method.
		*m: addempty		&& Introduced in version 11.0.0. Adds an empty file or directory entry to this object. If isDir is 1, then an empty directory entry is added. Otherwise an empty file entry is added. Returns 1 for success, 0 for failure.
		*m: addencoded		&& Introduced in version 11.0.0. Adds binary data as a new entry to this object. Returns 1 for success, 0 for failure.
		*m: addfile		&& Introduced in version 11.0.0. Adds a file or directory to the object. Returns 1 for success, 0 for failure.
		*m: addnocompressextension		&& Attempting to compress already-compressed data is usually a waste of CPU cycles with little or no benefit. In fact, it is possible that attempting to compress already-compressed data results in a slightly increased size.
		*m: addsb		&& Introduced in version 11.0.0. The content of sb is added as a new entry to this object, using its byte representation based on the specified charset. Returns 1 for success, 0 for failure.
		*m: addstring		&& Introduced in version 11.0.0. Adds a new text entry to this object, using its byte representation based on the specified charset. Returns 1 for success, 0 for failure.
		*m: appendbase64		&& Creates a new Zip entry and initializes it with already-compressed data that is Base64 encoded. (The ZipEntry.CopyBase64 method can be used to retrieve the compressed data in Base64 format.)
		*m: appendbd		&& Introduced in version 9.5.0.70. Appends the contents of byteData as a new entry to this zip object. The zip entry object containing the data is returned. Returns Nothing on failure
		*m: appendcompressed		&& Append memory data that is already Zip-compressed to the Zip object. The ZipEntry object containing the compressed data is returned. Note: This method appends the compressed data for a single zip entry.
		*m: appenddata		&& Appends in-memory data as a new entry to a Zip object. The ZipEntry object containing the data is returned. Note: This method only updates the zip object.
		*m: appenddataencoded		&& Introduced in version 9.5.0.59. Appends in-memory data as a new entry to a Zip object. The filename is the filename of the entry as it will appear within the zip. The encoding is the encoding of the data, such as "base64", "hex", etc.
		*m: appendfiles		&& Appends one or more files to the Zip object. The filePattern can use the "*" wildcard character for 0 or more of any characterSet recurse equal to True to recursively add all subdirectories, or False to only add files in the current directory.
		*m: appendfilesasync		&& Creates an asynchronous task to call the AppendFiles method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: appendfilesex		&& Appends one or more files to the Zip object. The filePattern can use the "*" to mean 0 or more of any character. The recurse controls whether directories are recursively traversed.
		*m: appendfilesexasync		&& Creates an asynchronous task to call the AppendFilesEx method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: appendfromdir_access		&& Access method used to retrieve the Chilkat ZIP AppendFromDir property.
		*m: appendfromdir_assign		&& Assign method used to hold a reference to the AppendFromDir property.
		*m: appendhex		&& Creates a new Zip entry and initializes it with already-compressed data that is hexidecimal encoded. (The ZipEntry.CopyHex method can be used to retrieve the compressed data in Hex format.)
		*m: appendmultiple		&& This method is the same as calling AppendFiles multiple times - once for each file pattern in fileSpecs. Note: This method only updates the zip object.
		*m: appendmultipleasync		&& Creates an asynchronous task to call the AppendMultiple method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: appendnew		&& Appends a new and empty entry to the Zip object and returns the ZipEntry object. Data can be appended to the entry by calling ZipEntry.AppendData. Important: To append an already-existing file, call the AppendOneFileOrDir method.
		*m: appendnewdir		&& Adds an entry to the zip so that when it unzips, a new directory (with no files) is created. The directory does not need to exist on the local filesystem when calling this method.
		*m: appendonefileordir		&& Appends a single file or directory to the Zip object. The saveExtraPath applies when fileOrDirPath is an absolute (non-relative) path. If saveExtraPath is 1, then the absolute path is made relative and saved in the zip.
		*m: appendonefileordirasync		&& Creates an asynchronous task to call the AppendOneFileOrDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: appendsb		&& Introduced in version 10.0.0. Same as AppendString, but append the contents of of the sb, and allow the charset to be specified. The contents of sb is converted to charset before being added to the zip.
		*m: appendstring		&& Adds an in-memory string to the Zip object. The textData argument is converted to the ANSI charset before being added to the Zip. If the Zip were written to disk by calling WriteZip, and later unzipped, the entry would unzip to an ANSI text file.
		*m: appendstring2		&& Same as AppendString, but allows the charset to be specified. The textData is converted to charset before being added to the zip. The internalZipFilepath is the path of the file that will be stored within the zip.
		*m: appendzip		&& Adds the contents of another existing Zip file to this Zip object. Returns 1 for success, 0 for failure.
		*m: autorunparams_access		&& Access method used to retrieve the Chilkat ZIP AutoRunParams property.
		*m: autorunparams_assign		&& Assign method used to hold a reference to the AutoRunParams property.
		*m: autorun_access		&& Access method used to retrieve the Chilkat ZIP AutoRun property.
		*m: autorun_assign		&& Assign method used to hold a reference to the AutoRun property.
		*m: autotemp_access		&& Access method used to retrieve the Chilkat ZIP AutoTemp property.
		*m: autotemp_assign		&& Assign method used to hold a reference to the AutoTemp property.
		*m: casesensitive_access		&& Access method used to retrieve the Chilkat ZIP CaseSensitive property.
		*m: casesensitive_assign		&& Assign method used to hold a reference to the CaseSensitive property.
		*m: cleararchiveattribute_access		&& Access method used to retrieve the Chilkat ZIP ClearArchiveAttribute property.
		*m: cleararchiveattribute_assign		&& Assign method used to hold a reference to the ClearArchiveAttribute property.
		*m: clearreadonlyattr_access		&& Access method used to retrieve the Chilkat ZIP ClearReadOnlyAttr property.
		*m: clearreadonlyattr_assign		&& Assign method used to hold a reference to the ClearReadOnlyAttr property.
		*m: closezip		&& Closes an open Zip file. This is identical to calling NewZip. (NewZip closes the current Zip file, if open, and initializes the Zip object to be empty. Zip files are only created when WriteZip is called.)
		*m: comment_access		&& Access method used to retrieve the Chilkat ZIP Comment property.
		*m: comment_assign		&& Assign method used to hold a reference to the Comment property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat ZIP DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: decryptpassword_access		&& Access method used to retrieve the Chilkat ZIP DecryptPassword property.
		*m: decryptpassword_assign		&& Assign method used to hold a reference to the DecryptPassword property.
		*m: deleteentry		&& Removes a Zip entry from the calling Zip object. Returns 1 for success, 0 for failure.
		*m: discardpaths_access		&& Access method used to retrieve the Chilkat ZIP DiscardPaths property.
		*m: discardpaths_assign		&& Assign method used to hold a reference to the DiscardPaths property.
		*m: encryption_access		&& Access method used to retrieve the Chilkat ZIP Encrypted property.
		*m: encryption_assign		&& Assign method used to hold a reference to the Encrypted property.
		*m: encryptkeylength_access		&& Access method used to retrieve the Chilkat ZIP EncryptKeyLength property.
		*m: encryptkeylength_assign		&& Assign method used to hold a reference to the EncryptKeyLength property.
		*m: encryptpassword_access		&& Access method used to retrieve the Chilkat ZIP EncryptPassword property.
		*m: encryptpassword_assign		&& Assign method used to hold a reference to the EncryptPassword property.
		*m: entryat		&& Introduced in version 11.0.0. Returns the entry at index in entry. The 1st entry is at index 0. Returns 1 for success, 0 for failure.
		*m: entrybyid		&& Introduced in version 11.0.0. Finds and returns the entry with the given id. (Each entry within the zip object has a unique EntryID.) Returns 1 for success, 0 for failure.
		*m: entrymatching		&& Introduced in version 11.0.0. Returns in entry the first entry that matches pattern, where pattern may include * as a wildcard character matching any sequence of zero or more characters. Returns 1 for success, 0 for failure.
		*m: entryof		&& Introduced in version 11.0.0. Returns in entry the entry where the file path stored within the zip equals pathInZip. Returns 1 for success, 0 for failure.
		*m: excludedir		&& Adds a directory name to be excluded when AppendFiles is called to add an entire directory tree. All directories having a name equal to an excluded directory will not be included when AppendFiles (or AppendFileEx) is called.
		*m: exedefaultdir_access		&& Access method used to retrieve the Chilkat ZIP EXEDefaultDir property.
		*m: exedefaultdir_assign		&& Assign method used to hold a reference to the EXEDefaultDir property.
		*m: exefinishnotifier_access		&& Access method used to retrieve the Chilkat ZIP EXEFinishNotifier property.
		*m: exefinishnotifier_assign		&& Assign method used to hold a reference to the EXEFinishNotifier property.
		*m: exeiconfile_access		&& Access method used to retrieve the Chilkat ZIP EXEIconFile property.
		*m: exeiconfile_assign		&& Assign method used to hold a reference to the EXEIconFile property.
		*m: exenointerface_access		&& Access method used to retrieve the Chilkat ZIP EXENoInterface property.
		*m: exenointerface_assign		&& Assign method used to hold a reference to the EXENoInterface property.
		*m: exesilentprogress_access		&& Access method used to retrieve the Chilkat ZIP EXESilentProgress property.
		*m: exesilentprogress_assign		&& Assign method used to hold a reference to the EXESilentProgress property.
		*m: exetitle_access		&& Access method used to retrieve the Chilkat ZIP EXETitle property.
		*m: exetitle_assign		&& Assign method used to hold a reference to the EXETitle property.
		*m: exeunzipcaption_access		&& Access method used to retrieve the Chilkat ZIP EXEUnZipCaption property.
		*m: exeunzipcaption_assign		&& Assign method used to hold a reference to the EXEUnZipCaption property.
		*m: exeunzipdir_access		&& Access method used to retrieve the Chilkat ZIP EXEUnZipDir property.
		*m: exeunzipdir_assign		&& Assign method used to hold a reference to the EXEUnZipDir property.
		*m: exewaitforsetup_access		&& Access method used to retrieve the Chilkat ZIP EXEWaitForSetup property.
		*m: exewaitforsetup_assign		&& Assign method used to hold a reference to the EXEWaitForSetup property.
		*m: exexmlconfig_access		&& Access method used to retrieve the Chilkat ZIP EXEXMLConfig property.
		*m: exexmlconfig_assign		&& Assign method used to hold a reference to the EXEXMLConfig property.
		*m: extract		&& Unzip all the files into the specified directory. Subdirectories are automatically created as needed. Returns 1 for success, 0 for failure.
		*m: extractasync		&& Creates an asynchronous task to call the Extract method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: extractexe		&& Introduced in version 9.5.0.44. Extracts files from a Chilkat produced self-extracting EXE into the specified directory.
		*m: extractexeasync		&& Introduced in version 9.5.0.44. Creates an asynchronous task to call the ExtractExe method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: filecount_access		&& Access method used to retrieve the Chilkat ZIP FileCount property.
		*m: filecount_assign		&& Assign method used to hold a reference to the FileCount property.
		*m: filename_access		&& Access method used to retrieve the Chilkat ZIP FileName property.
		*m: filename_assign		&& Assign method used to hold a reference to the FileName property.
		*m: firstentry		&& Return the first entry in the Zip. Call ZipEntry.NextEntry to iterate over the entries in a Zip until a NULL is returned. Returns Nothing on failure.
		*m: firstmatchingentry		&& Returns the first entry having a filename matching a pattern. The "*" characters matches 0 or more of any character. The full filename, including path, is used when matching against the pattern. A NULL is returned if nothing matches.
		*m: getdirectoryasxml		&& Return the contents of the Zip file directory in an XML formatted string. Returns Nothing on failure.
		*m: getentrybyid		&& Retrieves a ZipEntry by ID. Chilkat Zip.NET automatically assigns a unique ID to each ZipEntry in the Zip. This feature makes it easy to associate an item in a UI control with a ZipEntry. Returns Nothing on failure.
		*m: getentrybyindex		&& Retrieves a ZipEntry by index. The first entry is at index 0. This will return directory entries as well as files. Returns Nothing on failure.
		*m: getentrybyname		&& Returns a ZipEntry by filename. If a full or partial path is part of the filename, this must be included in the filename parameter.
		*m: getexclusions		&& Returns the current collection of exclusion patterns that have been set by SetExclusions. Returns Nothing on failure.
		*m: getexeconfigparam		&& (Relevant only when running on a Microsoft Windows operating system.) Gets the value of an EXE config param as described in the ExeXmlConfig property. Returns Nothing on failure.
		*m: getmaxuncompressedsize		&& Introduced in version 9.5.0.96. Returns the size of the file contained within the Zip that has the largest uncompressed size.
		*m: haszipformaterrors_access		&& Access method used to retrieve the Chilkat ZIP HasZIPFormatErrors property.
		*m: haszipformaterrors_assign		&& Assign method used to hold a reference to the HasZIPFormatErrors property.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat ZIP HeartBeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartBeatMs property.
		*m: ignoreaccessdenied_access		&& Access method used to retrieve the Chilkat ZIP IgnoreAccessDenied property.
		*m: ignoreaccessdenied_assign		&& Assign method used to hold a reference to the IgnoreAccessDenied property.
		*m: insertnew		&& Inserts a new and empty entry into the Zip object. To insert at the beginning of the Zip, beforeIndex should be 0. The ZipEntry's FileName property is initialized to fileName parameter. Returns Nothing on failure.
		*m: isnocompressextension		&& Returns 1 if the fileExtension is contained in the set of "no compress" extensions, otherwise returns 0. (See the documentation for the AddNoCompressExtension method.) The fileExtension may be passed with or without the ".".
		*m: ispasswordprotected		&& Return True if a Zip file is password protected.
		*m: isunlocked		&& Undocumented method! Returns true if the class has been unlocked. It is necessary to call UnlockComponent before calling any other methods. Passing any string to UnlockComponent will automatically activate a 30-day trial period.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat ZIP LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the Chilkat ZIP LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat ZIP LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the Chilkat ZIP LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat ZIP LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the Chilkat ZIP LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat ZIP LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the Chilkat ZIP LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat ZIP LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the Chilkat ZIP LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat ZIP LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the Chilkat ZIP LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat ZIP LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the Chilkat ZIP LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: maxdate_access		&& Access method used to retrieve the Chilkat ZIP MaxDate property.
		*m: maxdate_assign		&& Assign method used to hold a reference to the Chilkat ZIP MaxDate property.
		*m: maxuncompresssize_access		&& Access method used to retrieve the Chilkat ZIP MaxUncompressSize property.
		*m: maxuncompresssize_assign		&& Assign method used to hold a reference to the Chilkat ZIP MaxUncompressSize property.
		*m: mindate_access		&& Access method used to retrieve the Chilkat ZIP MinDate property.
		*m: mindate_assign		&& Assign method used to hold a reference to the Chilkat ZIP MinDate property.
		*m: newzip		&& Clears and initializes the contents of the Zip object. If a Zip file was open, it is closed and all entries are removed from the object. The FileName property is set to the zipFilePath argument.
		*m: numentries_access		&& Access method used to retrieve the Chilkat ZIP NumEntries property.
		*m: numentries_assign		&& Assign method used to hold a reference to the NumEntries property.
		*m: oemcodepage_access		&& Access method used to retrieve the Chilkat ZIP OEMCodePages property.
		*m: oemcodepage_assign		&& Assign method used to hold a reference to the OEMCodePages property.
		*m: openbd		&& Introduced in version 9.5.0.66. Open a Zip contained in binData. When a zip is opened, the PasswordProtect and Encryption properties will be appropriately set.
		*m: openembedded		&& (Relevant only when running on a Microsoft Windows operating system.) Opens a Zip embedded in an MS Windows EXE. Returns 1 for success, 0 for failure.
		*m: openfrombytedata		&& Same as OpenFromMemory. When a zip is opened, the PasswordProtect and Encryption properties will be appropriately set. If the zip is password protected (i.e. uses older Zip 2.0 encrypion), then the PasswordProtect property will be set to 1.
		*m: openfrommemory		&& Open a Zip that is completely in-memory. This allows for Zip files to be opened from non-filesystem sources, such as a database. When a zip is opened, the PasswordProtect and Encryption properties will be appropriately set.
		*m: openmyembedded		&& (Relevant only when running on a Microsoft Windows operating system.) Opens a Zip embedded within the caller's MS Windows EXE. Returns 1 for success, 0 for failure.
		*m: openzip		&& Opens a Zip archive. Encrypted and password-protected zips may be opened without providing the password, but their contents may not be unzipped unless the correct password is provided via the DecryptPassword proprety, or the SetPassword method.
		*m: openzipasync		&& Creates an asynchronous task to call the OpenZip method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: overwriteexisting_access		&& Access method used to retrieve the Chilkat ZIP OverwriteExisting property.
		*m: overwriteexisting_assign		&& Assign method used to hold a reference to the OverwriteExisting property.
		*m: passwordprotect_access		&& Access method used to retrieve the Chilkat ZIP PasswordProtect property.
		*m: passwordprotect_assign		&& Assign method used to hold a reference to the PasswordProtect property.
		*m: pathprefix_access		&& Access method used to retrieve the Chilkat ZIP PathPrefix property.
		*m: pathprefix_assign		&& Assign method used to hold a reference to the PathPrefix property.
		*m: percentdonescale_access		&& Access method used to retrieve the Chilkat ZIP PercentDoneScale property.
		*m: percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*m: pwdprotcharset_access		&& Access method used to retrieve the Chilkat ZIP PwdProtCharset property.
		*m: pwdprotcharset_assign		&& Assign method used to hold a reference to the PwdProtCharset property.
		*m: quickappend		&& Efficiently appends additional files to an existing zip archive. QuickAppend leaves all entries in the existing .zip untouched. It operates by appending new files and updating the internal "central directory" of the zip archive.
		*m: quickappendasync		&& Creates an asynchronous task to call the QuickAppend method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: removeembedded		&& (Relevant only when running on a Microsoft Windows operating system.) Removes an embedded Zip from an MS-Windows EXE. Returns 1 for success, 0 for failure.
		*m: removenocompressextension		&& Removes a file extension from the zip object's internal list of "no compress" extensions. (For more information, see AddNoCompressExtension.)
		*m: replaceembedded		&& (Relevant only when running on a Microsoft Windows operating system.) Replace a Zip embedded in an MS-Windows EXE with another Zip file. Returns 1 for success, 0 for failure.
		*m: setcompressionlevel		&& Sets the compression level for all file and data entries. The compression level for a mapped entry (i.e. an entry that is contained within an opened .zip, cannot be changed.) The default compression level is 6.
		*m: setexclusions		&& Specify a collection of exclusion patterns to be used when adding files to a Zip. Each pattern in the collection can use the "*" wildcard character, where "*" indicates 0 or more occurrences of any character.
		*m: setexeconfigparam		&& Sets a self-extractor property that is embedded in the resultant EXE created by the WriteExe or WriteExe2 methods. The paramName is one of the XML tags listed in the ExeXmlConfig property.
		*m: setpassword		&& Set the password for an encrypted or password-protected Zip. Note: The SetPassword method has the effect of setting both the EncryptPassword property as well as the DecryptPassword property. The SetPassword method should no longer be used.
		*m: tempdir_access		&& Access method used to retrieve the Chilkat ZIP TempDir property.
		*m: tempdir_assign		&& Assign method used to hold a reference to the TempDir property.
		*m: textflag_access		&& Access method used to retrieve the Chilkat ZIP TextFlag property.
		*m: textflag_assign		&& Assign method used to hold a reference to the TextFlag property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat ZIP UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: unzip		&& Unzips and returns the number of files unzipped, or -1 if a failure occurs. Subdirectories are automatically created during the unzipping process.
		*m: unzipasync		&& Creates an asynchronous task to call the Unzip method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: unzipinto		&& Unzips and returns the number of files unzipped, or -1 if a failure occurs. All files in the Zip are unzipped into the specfied dirPath regardless of the directory path information contained in the Zip.
		*m: unzipintoasync		&& Creates an asynchronous task to call the UnzipInto method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: unzipmatching		&& Same as Unzip, but only unzips files matching a pattern. If no wildcard characters ('*') are used, then only files that exactly match the pattern will be unzipped. The "*" characters matches 0 or more of any character.
		*m: unzipmatchingasync		&& Creates an asynchronous task to call the UnzipMatching method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: unzipmatchinginto		&& Unzips matching files into a single directory, ignoring all path information stored in the Zip.
		*m: unzipmatchingintoasync		&& Creates an asynchronous task to call the UnzipMatchingInto method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: unzipnewer		&& Same as Unzip, but only files that don't already exist on disk, or have later file modification dates are unzipped.
		*m: unzipnewerasync		&& Creates an asynchronous task to call the UnzipNewer method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat ZIP VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifypassword		&& Tests the current DecryptPassword setting against the currently opened zip. Returns 1 if the password is valid, otherwise returns 0.
		*m: writebd		&& Introduced in version 9.5.0.66. Same as WriteZip, but instead of writing the Zip to a file, it writes to binData. Zips that are written to binData can be opened by calling OpenBd. Note: Both WriteBd and OpenBd are added in Chilkat v9.5.0.66.
		*m: writebdasync		&& Introduced in version 9.5.0.66. Creates an asynchronous task to call the WriteBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: writeexe		&& (Relevant only when running on a Microsoft Windows operating system.) Writes an MS-Windows self-extracting executable. There are no limitations on the total size, individual file size, or number of files that can be added to a self-extracting EXE.
		*m: writeexe2		&& Undocumented method!
		*m: writeexetomemory		&& (Relevant only when running on a Microsoft Windows operating system.) Same as WriteExe, but instead of writing a file, the MS-Windows EXE is written to memory.
		*m: writetomemory		&& Same as WriteZip, but instead of writing the Zip to a file, it writes to memory. Zips that are written to memory can also be opened from memory by calling OpenFromMemory.
		*m: writetomemoryasync		&& Creates an asynchronous task to call the WriteToMemory method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: writezip		&& Saves the Zip to a file and implictly re-opens it so further operations can continue. Use WriteZipAndClose to write and close the Zip.
		*m: writezipandclose		&& Saves the Zip to a file and closes it. On return, the Zip object will be in the state as if NewZip had been called.
		*m: writezipandcloseasync		&& Creates an asynchronous task to call the WriteZipAndClose method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: writezipasync		&& Creates an asynchronous task to call the WriteZip method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: zipxdefaultalg_access		&& Access method used to retrieve the Chilkat ZIP ZipXDefaultAlg property
		*m: zipxdefaultalg_assign		&& Assign method used to hold a reference to the ZipXDefaultAlg property.
		*m: zipx_access		&& Access method used to retrieve the Chilkat ZIP ZipX property.
		*m: zipx_assign		&& Assign method used to hold a reference to the ZipX property.
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: appendfromdir		&& When files are added to a Zip archive, they are appended from this directory. For example, to add all the files under c:/abc/123/myAppDir, this property could be set to "c:/abc/123", and "myAppDir/*" would be passed to AppendFiles.
		*p: autorun		&& (Relevant only when running on a Microsoft Windows operating system.) Optional when creating Windows-based self-extracting EXEs. This is the name of an executable contained within the to-be-created EXE that will automatically be run after extraction.
		*p: autorunparams		&& (Relevant only when running on a Microsoft Windows operating system.) Command line parameters that get passed to the AutoRun executable.
		*p: autotemp		&& (Relevant only when running on a Microsoft Windows operating system.) This option applies to creating Windows-based self-extracting EXEs. If 1, the to-be-created EXE will automatically select and create a temporary directory for unzipping.
		*p: casesensitive		&& If 1 then all methods that get or search for zip entries by name will use case-sensitive filename matching. If 0 then filename matching will be case insensitive.
		*p: cleararchiveattribute		&& Set this to 1 to clear the FILE_ATTRIBUTE_ARCHIVE file attribute of each file during a zipping operation. The default value is 0.
		*p: clearreadonlyattr		&& If 1, the read-only attribute is automatically cleared when unzipping. The default value of this property is 0, which leaves the read-only attribute unchanged when unzipping.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: decryptpassword		&& When opening a password-protected or AES encrypted Zip, this is the password to be used for decryption. Encrypted Zips may be opened without setting a password, but the contents cannot be unzipped without setting this password.
		*p: discardpaths		&& If 1, discards all file path information when zipping. The default value is 0.
		*p: encryption		&& Indicate whether the Zip is to be strong encrypted or not. Valid values are 0 (not encrypted) or 4 (AES encrypted). When this property is set to the value 4, WinZip AES compatible encrypted zip archives are produced.
		*p: encryptkeylength		&& The encryption key length if AES, Blowfish, Twofish, or WinZip-compatible AES encryption is used. This value must be 128, 192, or 256. The default value is 128.
		*p: encryptpassword		&& The password used when writing a password-protected or strong-encrytped Zip. Note:The SetPassword method has the effect of setting both this property as well as the DecryptPassword property. The SetPassword method should no longer be used.
		*p: exedefaultdir		&& (Relevant only when running on a Microsoft Windows operating system.) Specifies the default unzip directory path to appear in the user-interface dialog box when the Windows-based self-extracting EXE is run.
		*p: exefinishnotifier		&& (Relevant only when running on a Microsoft Windows operating system.) If set to 1, a "Finished" dialog box is displayed when the self-extracting EXE is finished extracting.
		*p: exeiconfile		&& This property can be set to a pre-existing icon filename (.ico) that will be embedded within the to-be-created EXE and set as its default icon.
		*p: exenointerface		&& Applies to creating Windows-based self-extracting EXEs. When set to 1, the to-be-created EXE will run without a user-interface. The default value is 0.. Note: The ExeSilentProgress property needs to be set to 1 for the extract to be truly silent.
		*p: exesilentprogress		&& (Relevant only when running on a Microsoft Windows operating system.) Determines whether a progress dialog is displayed when the self-extracting EXE is run. If ExeNoInterface = 0
		*p: exetitle		&& (Relevant only when running on a Microsoft Windows operating system.) Applies to creating Windows-based self-extracting EXEs. Sets the title of the main user-interface dialog that appears when the self-extracting EXE runs.
		*p: exeunzipcaption		&& (Relevant only when running on a Microsoft Windows operating system.) Applies to creating MS Windows-based self-extracting EXEs. Sets the unzipping caption of the main user-interface dialog that appears when the self-extracting EXE runs.
		*p: exeunzipdir		&& Applies to creating MS Windows self-extracting EXEs. Stores a pre-defined unzip directory within the self-extracting EXE so that it automatically unzips to this directory without user-intervention.
		*p: exewaitforsetup		&& If 1, the self-extracting EXE will wait for the AutoRun EXE to complete before it exits. If 0, the self-extracting EXE dialog (or process if running silently with no user-interface), is allowed to exit prior to the completion of the AutoRun EXE.
		*p: exexmlconfig		&& Allows for an XML config document to be used to specify all possible options for self-extracting EXEs. This property is a string containing the XML config document.
		*p: filecount		&& The number of files (excluding directories) contained within the Zip.
		*p: filename		&& The path (absolute or relative) of the Zip archive. This is the path of the file that is created or overwritten when the zip is saved.
		*p: haszipformaterrors		&& 1 if the opened zip contained file format errors (that were not severe enough to prevent the zip from being opened and parsed).
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any method call prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: ignoreaccessdenied		&& If 1, then files that cannot be read due to "access denied" (i.e. a file permission error) will be ignored and the call to WriteZip, WriteZipAndClose, WriteExe, etc. will return a success status.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: maxdate		&& Introduced in version 10.0.0. The maximum last-modified date/time of a file to process for either adding to a .zip, or unzipping. This property uses the timestamp date/time string format.
		*p: maxuncompresssize		&& Introduced in version 9.5.0.96. An application can set this property to prevent unzipping any files larger than a max size uncompressed. The default value of this property is 0, which means any size file can be unzipped.
		*p: mindate		&& Introduced in version 10.0.0. The minimum last-modified date/time of a file to process for either adding to a .zip, or unzipping. This property uses the timestamp date/time string format.
		*p: numentries		&& The number of entries in the Zip, including both files and directories.
		*p: oemcodepage		&& Sets the OEM code page to be used for Unicode filenames. This property defaults to the OEM code page of the computer.
		*p: overwriteexisting		&& Determines whether existing files are overwritten during unzipping. The default is 1, which means that already-existing files will be overwritten. Set this property = 0 to prevent existing files from being overwritten when unzipping.
		*p: passwordprotect		&& 1 if the Zip should be password-protected using older Zip 2.0 encryption, commonly referred to as "password-protection". This property is set when a zip archive is opened by any of the Open* methods, such as OpenZip, OpenFromMemory, etc.
		*p: pathprefix		&& A prefix that is added to each filename when zipping. One might set the PathPrefix to "subdir/" so that files are unzipped to a specified subdirectory when unzipping.
		*p: percentdonescale		&& Introduced in version 9.5.0.49. This property is only valid in programming environment and languages that allow for event callbacks. Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks.
		*p: pwdprotcharset		&& Introduced in version 9.5.0.73. For older password-protected Zip archives (Zip 2.0 encryption), specifies the charset used for the binary representation of the decrypt password.
		*p: tempdir		&& The temporary directory to use when unzipping files. When running in ASP or ASP.NET, the default value of TempDir is set to the directory where the .zip is being written. Set this property to override the default.
		*p: textflag		&& If set to 1, the component will set the "text flag" for each file having these filename extensions: .txt, .xml, .htm, and .html. It will also preserve the "text flag" for existing zips that are opened and rewritten. By default, this property is set to
		*p: uncommonoptions		&& Introduced in version 9.5.0.84. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and  should typically remain empty. Currently, the only possible option is "ForceZip64".
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: zipx		&& Starting in v9.4.1, Chilkat Zip will automatically unzip ZIPX files using any of the following compression methods: BZIP2, PPMd, LZMA, and Deflate64 ("Deflate64" is a trademark of PKWare, Inc.)
		*p: zipxdefaultalg		&& The default compression algorithm to be used when creating ZIPX archives. The default value is "deflate". Other possible values are "ppmd", "lzma", "bzip2" and "deflate64".
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		appendfromdir = 
		autorun = 
		autorunparams = 
		autotemp = 0
		casesensitive = 0
		cchilkatclass = Zip
		ceventhandlerclass = iZIPEventHandler
		cleararchiveattribute = 0
		clearreadonlyattr = 0
		debuglogfilepath = 
		decryptpassword = 
		discardpaths = 0
		encryption = 0
		encryptkeylength = 128
		encryptpassword = 
		exedefaultdir = 
		exefinishnotifier = 0
		exeiconfile = 
		exenointerface = 0
		exesilentprogress = 1
		exetitle = 
		exeunzipcaption = 
		exeunzipdir = 
		exewaitforsetup = 1
		exexmlconfig = 
		filecount = 0
		filename = 
		haszipformaterrors = 0
		heartbeatms = 0
		ignoreaccessdenied = 1
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		maxdate = 
		maxuncompresssize = 0
		mindate = 
		Name = "zip"
		numentries = 0
		oemcodepage = 
		overwriteexisting = 1
		passwordprotect = 0
		pathprefix = 
		percentdonescale = 100
		pwdprotcharset = ansi
		tempdir = 
		textflag = 0
		uncommonoptions = 
		verboselogging = 0
		zipx = 
		zipxdefaultalg = deflate
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat ZIP AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        04/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        04/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE addbd		&& Introduced in version 11.0.0. Appends the contents of bd as a new entry to this object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddBd
		* Purpose:           Appends the contents of bd as a new entry to this object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathInZip -- The path to the internal ZIP EXE file.
		*                    toChilkatBinData -- the Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Appends the contents of bd as a new entry to this object.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcPathInZip AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddBd(m.tcPathInZip, ;
		        m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addembedded		&& (Relevant only when running on a Microsoft Windows operating system.) Embeds a Zip file into an EXE as a custom resource. This resource can be opened by the EXE containing it at runtime by using the OpenMyEmbedded method.
		*==============================================================================
		* Method:            AddEmbedded
		* Purpose:           Embeds a Zip file into an EXE as a custom resource.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEXEFileName -- the EXE containing the resource.
		*                    tcResourceName -- the resource to embed.
		*                    tcZIPFlieName -- the ZIP file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** (Relevant only when running on a Microsoft Windows operating system.) 
		** Embeds a Zip file into an EXE as a custom resource. 
		** This resource can be opened by the EXE containing it 
		** at runtime by using the OpenMyEmbedded method.
		** 
		** Important: In Visual Studio 2010, the linker has a property 
		** "Randomized Base Address" (Project Properties/Linker) that defaults to "YES", 
		** but the default is "NO" in Visual Studio 2008. 
		** (The property is nonexistent in Visual Studio 2005 and earlier.) 
		** This enables ASLR ( Address Space Layout Randomization) in Vista and up, 
		** and prevents the proper code injection in the executable address space. 
		** To successfully embed a .zip as a resource within an EXE, 
		** this Visual Studio property must be set to "NO".
		**
		** Update for Version 10: This method is now decremented.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEXEFileName AS Character, ;
		tcResourceName AS Character, tcZIPFlieName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.AddEmbedded(m.tcEXEFileName, m.tcResourceName, m.tcZIPFlieName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addempty		&& Introduced in version 11.0.0. Adds an empty file or directory entry to this object. If isDir is 1, then an empty directory entry is added. Otherwise an empty file entry is added. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddEmpty
		* Purpose:           Adds an empty file or directory entry to this object. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuRecursive -- whether or not to recurse subdirectories.
		*                    tcPathInZip -- the entry's path within the Zip.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Adds an empty file or directory entry to this object. 
		** If isDir is 1, then an empty directory entry is added. 
		** Otherwise an empty file entry is added.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuIsDirectory AS Unknown, tcPathInZip AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIsDirectory AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIsDirectory
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liIsDirectory = .LogicalToBit(m.tuIsDirectory)
		
		    TRY
		
		      STORE m.loChilkatObject.AddEmpty(m.liIsDirectory, m.tcPathInZip) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addencoded		&& Introduced in version 11.0.0. Adds binary data as a new entry to this object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddEncoded
		* Purpose:           Adds binary data as a new entry to this object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathInZip -- The path to the internal ZIP EXE file.
		*                    tcEncoding -- the encoding algorithm.
		*                    tcEncodedData -- the encoded data.
