	PROCEDURE getkeycontainernames		&& Undocumented method! Assumed to do what the name suggests.
		*==============================================================================
		* Method:            GetKeyContainerNames
		* Purpose:           Undocumented method! Assumed to do what the name suggests.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           toStringArray, a Chilkat String Array object.
		* Date Added:        06/11/2022
		*==============================================================================
		
		**
		** Undocumented method! Assumed to do what the name suggests.
		**
		** Returns a Chilkat string array, or NULL
		**
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Csp], loException AS Exception, ;
		loChilkatStringArray AS [Chilkat_9_5_0.StringArray]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatStringArray 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatStringArray = m.loChilkatObject.GetKeyContainerNames()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatStringArray
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loChilkatStringArray = NEWOBJECT([Chilkat_9_5_0.StringArray])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE hasencryptalgorithm		&& Returns true if the currently selected CSP contains an encryption algorithm matching the name and key length. Otherwise returns false.
		*==============================================================================
		* Method:            HasEncryptAlgorithm
		* Purpose:           Returns true if the currently selected CSP contains 
		*                    an encryption algorithm matching the name and key length.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncryptName, the encryption name.
		*                    tiBits, the number of encryption bits.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/11/2022
		*==============================================================================
		
		**
		** Returns true if the currently selected CSP contains an encryption algorithm 
		** matching the name and key length. Otherwise returns false.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEncryptName AS Character, tiBits AS Integer
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Csp], ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.HasEncryptAlgorithm(m.tcEncryptName, m.tiBits) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

