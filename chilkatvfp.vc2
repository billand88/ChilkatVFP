		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.CheckStatus() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.2.0
		
		  Smartcards/Tokens Chilkat now automatically recognizes the ATR corresponding 
		  to the Italian Electronic Identity Card (CIE) with NFC support 
		  (contactless, ISO 14443 Type B), Manufacturer: 
		  Italian Government / IPZS (Istituto Poligrafico e Zecca dello Stato).
		
		** Version 11.1.0
		
		  Smartcards/USB Tokens: Updated internal PKCS11 information 
		  to automatically recognize Longmai mToken CryptoIDE tokens.
		
		** Version 10.1.0
		
		  Fixed a problem having to with signing that could occur when the certificate/key on the smartcard or token is ECDSA.
		
		** Version 99
		
		  Added to Chilkat’s internal list of recognized smartcard ATR’s 
		  to also recognize Giesecke & Devrient Sm@rtCafe 7.0 CC.
		
		** Version 96
		
		  Added support for the Watchdata PROXkey USB token.
		  Chilkat should automatically recognize the USB token
		  and use the PKCS11 driver at C:\Windows\System32\SignatureP11.dll.
		  (This is also supported on Linux, assuming the shared lib is at
		  /usr/lib/WatchData/ProxKey/lib/libwdpkcs_SignatureP11.so)
		
		** Version 95
		
		  Chilkat now works with the Turkish smartcard from TUBITAK UEKAE.
		
		  Chilkat now works correctly with the CryptoCertum 3.6 Cryptographic Card
		
		  Chilkat now works more seamlessly with the ePass2003 token.
		
		** Version 90
		
		  Improved automatic recognition and handling for various smart cards.
		
		** Version 88
		
		  Greatly improved internals for automatically recognizing and handling
		  smart cards and USB tokens from many different vendors. 
		
		** Version 87
		
		  Added the SCard class, which is a wrapper around the Resource Manager API
		  of the PC/SC architecture for smart cards. On Windows it is a wrapper
		  around the WinSCard functions implemented in the winscard.dll.
		  On other systems (such as Linux) it is a wrapper around the same API implemented in pcsc-lite.so.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE connect		&& Introduced in version 9.50.87. Establish a connection to a reader. The reader is the name of a reader returned from ListReaders. The shareMode can be "shared", "exclusive", or "direct".
		*==============================================================================
		* Method:            Connect
		* Purpose:           Establish a connection to a reader.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcReader, the reader to connect to.
		*                    tcShareMode, the share mode setting.
		*                    tcPreferredProtocol, the preferred protocol.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.50.87
		**
		** Establish a connection to a reader. The reader is the name of a reader 
		** returned from ListReaders. The shareMode can be "shared", "exclusive", 
		** or "direct". The preferredProtocol can be "0" 
		** (valid only if the shareMode = "direct"), "T0", "T1", "raw", 
		** or "no_preference". (No preference is effectively T0 or T1.)
		** 
		** If successful, the state of this object instance 
		** is that it's connected to the reader.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcReader AS Character, tcShareMode AS Character, ;
		tcPreferredProtocol AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.Connect(m.tcReader, ;
		        m.tcShareMode, m.tcPreferredProtocol) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

