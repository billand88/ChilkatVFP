	PROCEDURE sshopenchannel		&& Introduced in version 9.5.0.50. Opens a new channel within an SSH tunnel. Returns the socket that is connected to the destination host:port through the SSH tunnel via port forwarding.
		*==============================================================================
		* Method:            SSHOpenTunnel
		* Purpose:           Opens a new channel within an SSH tunnel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHostName -- the host name.
		*                    tiPort -- the port to communicate through
		*                    tuSSL -- whether or not SSL (TLS) is uesd.
		*                    tiWaitMs -- response window before failing.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/31/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		**
		** Opens a new channel within an SSH tunnel. 
		** Returns the socket that is connected to the destination host:port 
		** through the SSH tunnel via port forwarding. 
		** If ssl is 1, the connection is TLS (i.e. TLS inside the SSH tunnel). 
		** Returns the socket object that is the port-forwarded tunneled connection. 
		** Any number of channels may be opened within a single SSH tunnel, 
		** and may be port-forwarded to different remote host:port endpoints.
		** 
		** Fixed for Version 61: Fixed TLS connection issue 
		** with some cipher suites on Big Endian machines.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcHostName AS Character, ;
		tiPort AS Integer, tuSSL AS Unknown, tiWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liSSL AS Integer, ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		STORE 0 TO m.liSSL, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatSocket
		
		llImplemented = .F.
		liIntroducedInBuild = 50
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSSL = .LogicalToBit(m.tuSSL)
		
		      TRY
		
		        loChilkatSocket = ;
		        m.loChilkatObject.SSHOpenTunnel(m.tcHostName, m.tiPort, m.liSSL, m.tiWaitMs)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatSocket
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

