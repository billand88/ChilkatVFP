	PROCEDURE getp12		&& Introduced in version 9.5.0.58. Returns the private key in a PFX (P12) object. This is only possible if the private key was previously set by calling SetP12. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetP12
		* Purpose:           Returns the private key in a PFX (P12) object. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           toChilkatPFX, a Chilkat PFX object.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Returns the private key in a PFX (P12) object. 
		** This is only possible if the private key was previously set by calling SetP12.
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Returns Nothing on failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_AUTHGOOGLE_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loChilkatPFX AS CHILKAT_PFX_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatPFX
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatPFX = m.loChilkatObject.GetP12()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatPFX
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_AUTHGOOGLE_COM_CALL)
		  loChilkatPFX = NEWOBJECT(CHILKAT_PFX_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE iat_access		&& Access method used to retrieve the Chilkat AuthGoogle IAt property.
		*==============================================================================
		* Method:            IAt_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat AuthGoogle IAt property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IAt
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** This property can be set to override the default current date/time value 
		** for the "iat" claim of the JWT. It can be set to a value indicating 
		** the number of seconds from 1970-01-01T00:00:00Z UTC.
		** 
		** The default value is 0, which indicates to use the iat value 
		** for the current system date/time. Unless explicitly needed, 
		** always leave this property at the default value.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 77
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

