	PROCEDURE s3_generateurl		&& Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V2. (Call S3_GenerateUrlV4 to generate AWS Signature V4 pre-signed URLs.) Requires that the AwsSecretKey and AwsAccessKey be set to valid values prior to calling this method.
		*==============================================================================
		* Method:            S3_GenerateURL
		* Purpose:           Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V2. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBucket -- the Amazon S3 bucket name.
		*                    tcPath -- the path to the bucket.
		*                    toChilkatCkDateTime -- a Chilkat Date/Time object.
		* Returns:           Character
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		**
		** Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V2. 
		** (Call S3_GenerateUrlV4 to generate AWS Signature V4 pre-signed URLs.) 
		** Requires that the AwsSecretKey and AwsAccessKey be set 
		** to valid values prior to calling this method.
		**
		** Note: This method can only generate URLs that are for HTTP GET requests 
		** (i.e. URLs you can paste into a browser address bar). 
		** This method does not generate URLs for POST, PUT, DELETE, etc.
		**
		** Returns Nothing on failure
		**
		** Fixed in Version 69: Fixed: In certain situations, 
		** the Content-MD5 header was added twice, 
		** which caused the AWS Signature format v2 to fail.
		**
		** Fixed in Version 75: Fixed problems with non-us-ascii chars in x-amz-meta-* headers
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		
		LPARAMETERS tcBucket AS Character, tcPath AS Character, ;
		toChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loParkParameterCkDateTime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, lcURL AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		lcURL = []
		llImplemented = .F.
		liIntroducedInBuild = 46
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCkDateTime = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTime)
		
		      loChilkatCkDateTime = m.loParkParameterCkDateTime.GetObject()
		
		      TRY
		
		        lcURL = ;
		        m.loChilkatObject.S3_GenerateURL(m.tcBucket, m.tcPath, m.loChilkatCkDateTime)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCkDateTime = ;
		      m.loParkParameterCkDateTime.SetObject(m.toChilkatCkDateTime, m.loChilkatCkDateTime)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		RETURN m.lcURL
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loParkParameterCkDateTime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE s3_generateurlv4		&& Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V4. (Call S3_GenerateUrl to generate AWS Signature V2 pre-signed URLs.)
		*==============================================================================
		* Method:            S3_GenerateURLV4
		* Purpose:           Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V4.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuUseHTTPS -- whether or not to use the https protocol
		*                    tcBucketName -- the Amazon bucket name.
		*                    tcBucketPath -- the path to the Amazon bucket.
		*                    tiSecondsValid -- number of seconds before expiration.
		*                    tcAWSService -- the name of the AWS service.
		* Returns:           Character
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Note: The S3_GenPresignedUrl method is new in Chilkat v9.5.0.83 
		** and can create S3 pre-signed URLs for GET, POST, PUT, DELETE, or any other HTTP verb.
		**
		** Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V4. 
		** (Call S3_GenerateURLV4 to generate AWS Signature V2 pre-signed URLs.) 
		** Requires that the AwsSecretKey, AwsAccessKey, and AwsRegion properties 
		** be set to valid values prior to calling this method. 
		** Also requires the AwsEndpoint property to be set if the endpoint 
		** is different than "s3.amazonaws.com".
		**
		** The URL that is generated has this format:
		** 
		** https://<AwsEndpoint>/<bucket_name>/<path>
		** ?X-Amz-Algorithm=AWS4-HMAC-SHA256
		** &X-Amz-Credential=<AwsAccessKey>/<currentDate>/<AwsRegion>/<awsService>/aws4_request
		** &X-Amz-Date=<currentDateTime>
		** &X-Amz-Expires=<numSecondsValid>
		** &X-Amz-SignedHeaders=host
		** &X-Amz-Signature=<signature-value>  
		** 
		** The awsService is a string naming the AWS service, such as "s3". 
		** If useHttps is 1, then the URL begins with "https://", otherwise it begins with "http://".
		** 
		** Note: This method can only generate URLs that are for HTTP GET requests 
		** (i.e. URLs you can paste into a browser address bar). 
		** This method does not generate URLs for POST, PUT, DELETE, etc.
		**
		** Fixed for Version 66: Fixed AWS Signature V4 issues 
		** for some cases when query params are used with S3.
		**
		** Fixed in Version 75: Fixed problems with non-us-ascii chars in x-amz-meta-* headers
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tuUseHTTPS AS Unknown, tcBucketName AS Character, ;
		tcBucketPath AS Character, tiSecondsValid AS Integer, tcAWSService AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcURL AS Character, liUseHTTPS AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liUseHTTPS 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcURL = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUseHTTPS = .LogicalToBit(m.tuUseHTTPS)
		
		      TRY
		
		        lcURL = ;
		        m.loChilkatObject.S3_GenerateURLV4(m.liUseHTTPS, ;
		        m.tcBucketName, m.tcBucketPath, m.tiSecondsValid, m.tcAWSService)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcURL
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE s3_genpresignedurl		&& Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V4. Requires that the AwsSecretKey, AwsAccessKey, and AwsRegion properties be set to valid values prior to calling this method.
		*==============================================================================
		* Method:            S3_GenPresignedURL
		* Purpose:           Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V4.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHTTPVerb -- the HTTP action to take.
		*                    tuUseHTTPS -- the Amazon S3 bucket name.
		*                    tcBucketName -- the Amazon bucket name.
		*                    tcBucketPath -- the path to the Amazon bucket.
		*                    tiSecondsValid -- number of seconds before expiration.
		*                    tcAWSService -- the name of the AWS service.
		* Returns:           Character
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Generates a temporary pre-signed URL for Amazon S3 using AWS Signature V4. 
		** Requires that the AwsSecretKey, AwsAccessKey, and AwsRegion properties 
		** be set to valid values prior to calling this method. 
		** Also requires the AwsEndpoint property to be set if the endpoint is different than "s3.amazonaws.com".
		**
		** The URL that is generated has this format:
		** 
		** https://<AwsEndpoint>/<bucket_name>/<path>
		** ?X-Amz-Algorithm=AWS4-HMAC-SHA256
		** &X-Amz-Credential=<AwsAccessKey>/<currentDate>/<AwsRegion>/<awsService>/aws4_request
		** &X-Amz-Date=<currentDateTime>
		** &X-Amz-Expires=<numSecondsValid>
		** &X-Amz-SignedHeaders=host
		** &X-Amz-Signature=<signature-value>  
		** 
		** The httpVerb is the HTTP verb such as "GET", "PUT", "POST", "DELETE", etc. 
		** The awsService is a string naming the AWS service, such as "s3" or "s3-accelerate". 
		** If useHttps is 1, then the URL begins with "https://", otherwise it begins with "http://".
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		** 
		** Starting in version 97: 
		**
		** If the HTTP verb is “OPTIONS”, then Chilkat will now allow for the path to be “*”. 
		** Previously, Chilkat forced the path in the HTTP start line to begin with a “/”. 
		** Also, when the HTTP verb is OPTIONS, no “Content-Length” header
		** will be included in the request.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcHTTPVerb AS Character, tuUseHTTPS AS Unknown, tcBucketName AS Character, ;
		tcBucketPath AS Character, tiSecondsValid AS Integer, tcAWSService AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcURL AS Character, liUseHTTPS AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liUseHTTPS 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcURL = []
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUseHTTPS = .LogicalToBit(m.tuUseHTTPS)
		
		      TRY
		
		        lcURL = m.loChilkatObject.S3_GenPresignedURL(m.tcHTTPVerb, m.liUseHTTPS, ;
		        m.tcBucketName, m.tcBucketPath, m.tiSecondsValid, m.tcAWSService)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcURL
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE s3_listbucketobjects		&& Retrieves the XML listing of the objects contained within an Amazon S3 bucket. (This is like a directory listing, but in XML format.) The bucketPath name may be qualified with URL-encoded params.
		*==============================================================================
		* Method:            S3_ListBucketObjects
		* Purpose:           Retrieves the XML listing of the objects 
		*                    contained within an Amazon S3 bucket. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBucketPath, the Amazon S3 bucket path.
		* Returns:           Character, in XML
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Retrieves the XML listing of the objects contained within an Amazon S3 bucket. 
		** (This is like a directory listing, but in XML format.)
		**
		** The bucketPath name may be qualified with URL-encoded params. 
		** For example, to list the objects in a bucket named "ChilkatABC" 
		** with max-keys = 2000 and marker = "xyz", 
		** call S3_ListBucketObject passing the 
		** following string for bucketPath: "ChilkatABC?max-keys=2000&marker=xyz"
		**
		** The S3_ListBucketObjects method recognized all params listed 
		** in the AWS documentation for listing objects in a bucket: 
		** delimiter, marker, max-keys, and prefix. 
		** See Amazon's AWS online documentation for more information.
		**
		** Fixed for Version 66: Fixed AWS Signature V4 issues 
		** for some cases when query params are used with S3.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed in Version 69:   Fixed problems with pre-signing URLs having to do with 
		** 8bit non-us-ascii chars in the filename, or “.” chars in the bucket name.
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcBucketPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXML = m.loChilkatObject.S3_ListBucketObjects(m.tcBucketPath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE s3_listbucketobjectsasync		&& Creates an asynchronous task to call the S3_ListBucketObjects method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
