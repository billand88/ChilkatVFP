		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		    TRY
		
		      lqDecryptedBytes = m.loChilkatObject.DecryptBytesENC(m.tqData, m.liUsePrivateKey)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDecryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptstring		&& Decrypts encrypted string data and returns an unencrypted string. usePrivateKey should be set to 1 if the private key is to be used for decrypting. Otherwise it should be set to 0 if the public key is to be used.
		*==============================================================================
		* Method:            DecryptString
		* Purpose:           Decrypts encrypted string data and returns an unencrypted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to decrypt. 
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           The decrypted bytes
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Decrypts encrypted string data and returns an unencrypted string. 
		** usePrivateKey should be set to 1 if the private key is to be used for decrypting. 
		** Otherwise it should be set to 0 if the public key is to be used. 
		** The Charset property controls how the component interprets the decrypted string. 
		** Depending on the programming language, strings are returned 
		** to the application as Unicode, utf-8, or ANSI. Internal to DecryptString, 
		** the decrypted string is automatically converted from the charset specified 
		** by the Charset property to the encoding required by the calling programming language.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tqData AS VarBinary, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, lcDecryptedBytes AS Character, liUsePrivateKey AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcDecryptedBytes = []
		liUsePrivateKey = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		    TRY
		
		      lcDecryptedBytes = m.loChilkatObject.DecryptString(m.tqData, m.liUsePrivateKey)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcDecryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

