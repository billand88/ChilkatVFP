	PROCEDURE getasrfc822		&& Returns the date/time as an RFC822 formatted string. (An RFC822 format string is what is found in the "Date" header field of an email, such as "Wed, 18 Oct 2017 09:08:21 GMT".) bLocal indicates whether a local or UTC time is returned.
		*==============================================================================
		* Method:            GetAsRFC822
		* Purpose:           Returns the date/time as an RFC822 formatted string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuLocalTime, whether or not the returned time 
		*                    is local or UTC time.
		* Returns:           A character value representing the RFC822 format.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Returns the date/time as an RFC822 formatted string. 
		** (An RFC822 format string is what is found in the "Date" header field of an email, 
		** such as "Wed, 18 Oct 2017 09:08:21 GMT".)
		** 
		** bLocal indicates whether a local or UTC time is returned.
		** 
		
		LPARAMETERS tuLocalTime AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CKDATETIME_COM_CALL, ;
		loException AS Exception, liLocalTime AS Integer, lcRFC822DateTime AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liLocalTime = 0
		lcRFC822DateTime = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liLocalTime = .LogicalToBit(m.tuLocalTime)
		
		    TRY
		
		      lcRFC822DateTime = m.loChilkatObject.GetAsRFC822(m.liLocalTime)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcRFC822DateTime 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getastimestamp		&& Introduced in version 9.5.0.58. Returns the date/time as an RFC 3339 formatted string, such as "1990-12-31T23:59:60Z". (This is an ISO 8061 format like the following: YYYY-MM-DDThh:mm:ssTZD) bLocal indicates whether a local or UTC time is returned.
		*==============================================================================
