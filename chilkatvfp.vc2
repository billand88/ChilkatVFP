		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE selectforwriting		&& Waits until it is known that data can be written to one or more sockets without it blocking.
		*==============================================================================
		* Method:            SelectForWriting
		* Purpose:           Waits until it is known that data can be written 
		*                    to one or more sockets without it blocking.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiTimeoutMs -- the millisecond timeout value.
		* Returns:           The number of sockets such that data can be written without blocking.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** Waits until it is known that data can be written to one or more sockets without it blocking.
		** 
		** Socket writes are typically buffered by the operating system. 
		** When an application writes data to a socket, 
		** the operating system appends it to the socket's outgoing send buffers and returns immediately. 
		** However, if the OS send buffers become filled up 
		** (because the sender is sending data faster than the remote receiver can read it), 
		** then a socket write can block (until outgoing send buffer space becomes available).
		** 
		** Waits a maximum of timeoutMs milliseconds. If maxWaitMs = 0, then it is effectively a poll. 
		** Returns the number of sockets such that data can be written without blocking. 
		** A value of -1 indicates an error condition.
		**
		
		LPARAMETERS tiTimeoutMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liSockets AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liSockets = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liSockets = m.loChilkatObject.SelectForWriting(m.tiTimeoutMs)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liSockets
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE selectforwritingasync		&& Creates an asynchronous task to call the SelectForWriting method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
