	PROCEDURE fileclose		&& Closes the currently open file.
		*==============================================================================
		* Method:            FileClose
		* Purpose:           Closes the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Closes the currently open file.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.FileClose()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE filecontentsequal		&& Compares the contents of two files and returns 1 if they are equal and otherwise returns 0. The actual contents of the files are only compared if the sizes are equal. The files are not entirely loaded into memory.
		*==============================================================================
		* Method:            FileContentsEqual
		* Purpose:           Compares the contents of two files and returns 1 
		*                    if they are equal and otherwise returns 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath1, the first file to compare.
		*                    tcFilePath2, the second file to compare.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Compares the contents of two files and returns 1 
		** if they are equal and otherwise returns 0. 
		** The actual contents of the files are only compared if the sizes are equal. 
		** The files are not entirely loaded into memory. 
		** Instead, they are compared chunk by chunk. 
		** This allows for any size files to be compared, 
		** regardless of the memory capacity of the computer.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath1 AS Character, tcFilePath2 AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.FileContentsEqual(m.tcFilePath1, m.tcFilePath2) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE filecopy		&& Copys existingFilepath to newFilepath. If failIfExists is 1 and newFilepath already exists, then an error is returned. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FileCopy
		* Purpose:           Copys existingFilepath to newFilepath.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcExistingFilePath, the existing file and path.
		*                    tcNewFilePath, the path to copy the file onto.
		*                    tuErrorIfFileExists, whether or not 
		*                    to fail if the file already exists.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Copys existingFilepath to newFilepath. 
		** If failIfExists is 1 and newFilepath already exists, then an error is returned.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcExistingFilePath AS Character, ;
		tcNewFilePath AS Character, tuErrorIfFileExists AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liErrorIfFileExists AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liErrorIfFileExists
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liErrorIfFileExists = .LogicalToBit(m.tuErrorIfFileExists)
		
		    TRY
		
		      STORE m.loChilkatObject.FileCopy(m.tcExistingFilePath, ;
		      m.tcNewFilePath, m.liErrorIfFileExists) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

