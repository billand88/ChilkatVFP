	HIDDEN PROCEDURE untarmaxcount_access		&& Access method used to retrieve the Chilkat TAR UnTarMaxCount property.
		*==============================================================================
		* Method:            UnTarMaxCount_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat TAR UnTarMaxCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnTarMaxCount
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Limits the number of files extracted during an untar to this count. 
		** The default value is 0 to indicate no maximum. 
		** To untar a single file, one might set the UntarMatchPattern 
		** such that it will match only the file to be extracted, 
		** and also set UntarMaxCount equal to 1. 
		** This causes an untar to scan the TAR archive 
		** until it finds the matching file, extract it, and then return.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE untarmaxcount_assign		&& Assign method used to hold a reference to the UnTarMaxCount property.
		*==============================================================================
		* Method:            UnTarMaxCount_Assign
		* Purpose:           Assign method used to hold a reference to the UnTarMaxCount property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the UnTarMaxCount property.
		* Returns:           
		* Date Added:        05/07/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

