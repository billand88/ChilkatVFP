	HIDDEN PROCEDURE usexpkcs7_access		&& Access method used to retrieve the Chilkat MIME UseXPKCS7 property.
		*==============================================================================
		* Method:            UseXPKCS7_Access
		* Purpose:           Access method used to retrieve 
		*                    the UseXPKCS7 property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UseXPKCS7
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** If 1, then the Content-Type header fields created by Chilkat 
		** will use "x-pkcs7" instead of simply "pkcs7" . For example:
		** 
		**   Content-Type: multipart/signed;
		**     boundary="----=_NextPart_af8_0422_dbec3a60.7178e470";
		**     protocol="application/x-pkcs7-signature"; micalg=sha1
		** 
		**   or
		**   
		**   Content-Type: application/x-pkcs7-mime; name="smime.p7m"
		** 
		** If 0, then the "pcks7" is used. For example:
		** 
		**   Content-Type: multipart/signed;
		**     boundary="----=_NextPart_af8_0422_dbec3a60.7178e470";
		**     protocol="application/pkcs7-signature"; micalg=sha1
		**   
		**   or
		**   
		**   Content-Type: application/pkcs7-mime; name="smime.p7m"
		**
		** The default value of this property is 1, meaning that "x-" is used by default.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE usexpkcs7_assign		&& Assign method used to hold a reference to the UseXPKCS7 property.
		*==============================================================================
		* Method:            UseXPKCS7_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the UseXPKCS7 property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the UseXPKCS7 property.
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat MIME VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/25/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE verify		&& Verifies PKCS7 signed MIME and "unwraps" the signature. The MIME is restored to the original structure that it would have originally had prior to signing. The Verify method works with both detached signatures, as well as opaque/attached signatures.
		*==============================================================================
		* Method:            Verify
		* Purpose:           Verifies PKCS7 signed MIME and "unwraps" the signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Verifies PKCS7 signed MIME and "unwraps" the signature. 
		** The MIME is restored to the original structure 
		** that it would have originally had prior to signing. 
		** The Verify method works with both detached signatures, as well as opaque/attached signatures.
		** 
		** A PKCS7 signature usually embeds both the signing certificate with its public key. 
		** Therefore, it is usually possible to verify a signature without the need 
		** to already have the certificate installed. If the signature does not embed the certificate, 
		** the Verify method will automatically locate and use the certificate 
		** if it was correctly pre-installed on the computer.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.Verify() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS ntlm AS ibasechilkat OF "chilkatvfp.vcx" 		&& API for implemeting both client and server sides of the NTLM protocol/algorithm. The Chilkat NTLM API is included as part of the "Chilkat Crypt" license.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: clientchallenge_access		&& Access method used to retrieve the Chilkat NTLM ClientChallenge property.
		*m: clientchallenge_assign		&& Assign method used to hold a reference to the ClientChallenge property.
		*m: comparetype3		&& Compares the internal contents of two Type3 messages to verify that the LM and NTLM response parts match. A server would typically compute the Type3 message by calling GenType3, and then compare it with the Type3 message received from the client.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat NTLM DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: dnscomputername_access		&& Access method used to retrieve the Chilkat NTLM DNSComputerName property.
		*m: dnscomputername_assign		&& Assign method used to hold a reference to the DNSComputerName property.
		*m: dnsdomainname_access		&& Access method used to retrieve the Chilkat NTLM DNSDomainName property.
		*m: dnsdomainname_assign		&& Assign method used to hold a reference to the DNSDomainName property.
		*m: domain_access		&& Access method used to retrieve the Chilkat NTLM Domain property.
		*m: domain_assign		&& Assign method used to hold a reference to the Domain property.
		*m: encodingmode_access		&& Access method used to retrieve the Chilkat NTLM EncodingMode property.
		*m: encodingmode_assign		&& Assign method used to hold a reference to the EncodingMode property.
		*m: flags_access		&& Access method used to retrieve the Chilkat NTLM Flags property.
		*m: flags_assign		&& Assign method used to hold a reference to the Flags property.
		*m: gentype1		&& Generates the Type 1 message. The Type 1 message is sent from Client to Server and initiates the NTLM authentication exchange. Returns Nothing on failure.
		*m: gentype2		&& Generates a Type2 message from a received Type1 message. The server-side generates the Type2 message and sends it to the client. This is the 2nd step in the NTLM protocol.
		*m: gentype3		&& Generates the final message in the NTLM authentication exchange. This message is sent from the client to the server. The Type 2 message received from the server is passed to GenType3.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat NTLM LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat NTLM LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat NTLM LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat NTLM LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat NTLM LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat NTLM LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat NTLM LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtype3		&& The server-side should call this method with the Type 3 message received from the client. The LoadType3 method sets the following properties: Username, Domain, Workstation, and ClientChallenge, all of which are embedded within the Type 3 message.
		*m: netbioscomputername_access		&& Access method used to retrieve the Chilkat NTLM NetBIOSComputerName property.
		*m: netbioscomputername_assign		&& Assign method used to hold a reference to the NetBIOSComputerName property.
		*m: netbiosdomainname_access		&& Access method used to retrieve the Chilkat NTLM NetBIOSDomainName property.
		*m: netbiosdomainname_assign		&& Assign method used to hold a reference to the NetBIOSDomainName property.
		*m: ntlmversion_access		&& Access method used to retrieve the Chilkat NTLM NTLMVersion property.
		*m: ntlmversion_assign		&& Assign method used to hold a reference to the NTLMVersion property.
		*m: oemcodepage_access		&& Access method used to retrieve the Chilkat NTLM OEMCodePage property.
		*m: oemcodepage_assign		&& Assign method used to hold a reference to the OEMCodePage property.
		*m: parsetype1		&& For informational purposes only. Allows for the server-side to parse a Type 1 message to get human-readable information about the contents. Returns Nothing on failure
		*m: parsetype2		&& For informational purposes only. Allows for the client-side to parse a Type 2 message to get human-readable information about the contents. Returns Nothing on failure.
		*m: parsetype3		&& For informational purposes only. Allows for the server-side to parse a Type 3 message to get human-readable information about the contents. Returns Nothing on failure.
		*m: password_access		&& Access method used to retrieve the Chilkat NTLM Password property.
		*m: password_assign		&& Assign method used to hold a reference to the Password property.
		*m: serverchallenge_access		&& Access method used to retrieve the Chilkat NTLM ServerChallenge property.
		*m: serverchallenge_assign		&& Assign method used to hold a reference to the ServerChallenge property.
		*m: setflag		&& Sets one of the negotiate flags to be used in the Type 1 message sent by the client. It should normally be unnecessary to modify the default flag settings. For more information about flags, see the description for the Flags property above.
		*m: targetname_access		&& Access method used to retrieve the Chilkat NTLM TargetName property.
		*m: targetname_assign		&& Assign method used to hold a reference to the TargetName property.
		*m: username_access		&& Access method used to retrieve the Chilkat NTLM UserName property.
		*m: username_assign		&& Assign method used to hold a reference to the UserName property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat NTLM VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: workstation_access		&& Access method used to retrieve the Chilkat NTLM WorkStation property.
		*m: workstation_assign		&& Assign method used to hold a reference to the WorkStation property.
		*p: clientchallenge		&& The ClientChallenge is passed in the Type 3 message from the client to the server. It must contain exactly 8 bytes.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: dnscomputername		&& Optional. This is information that would be set by the server for inclusion in the "Target Info" internal portion of the Type 2 message.
		*p: dnsdomainname		&& Optional. This is information that would be set by the server for inclusion in the "Target Info" internal portion of the Type 2 message.
		*p: domain		&& Optional. May be set by the client for inclusion in the Type 1 message.
		*p: encodingmode		&& Determines the encoding mode used for getting/setting various properties, such as ClientChallenge.
		*p: flags		&& The negotiate flags that are set in the Type 1 message generated by the client and sent to the server. These flags have a default value and should ONLY be set by a programmer that is an expert in the NTLM protocol and knows what they mean
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: netbioscomputername		&& Optional. This is information that would be set by the server for inclusion in the "Target Info" internal portion of the Type 2 message.
		*p: netbiosdomainname		&& Optional. This is information that would be set by the server for inclusion in the "Target Info" internal portion of the Type 2 message.
		*p: ntlmversion		&& The version of the NTLM protocol to be used. Must be set to either 1 or 2. The default value is 1 (for NTLMv1). Setting this property equal to 2 selects NTLMv2.
		*p: oemcodepage		&& If the "A" flag is unset, then Unicode strings are not used internally in the NTLM messages.
		*p: password		&& The password corresponding to the username of the account to be authenticated. This must be set by the client prior to generating and sending the Type 3 message.
		*p: serverchallenge		&& This is similar to the ClientChallenge in that it must contain 8 bytes. The ServerChallenge is passed in the Type 2 message from the server to the client.
		*p: targetname		&& The authentication realm in which the authenticating account has membership, such as a domain for domain accounts, or a server name for local machine accounts. The TargetName is used in the Type2 message sent from the server to the client.
		*p: username		&& The username of the account to be authenticated. This must be set by the client prior to generating and sending the Type 3 message.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: workstation		&& The value to be used in the optional workstation field in Type 1 message.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Ntlm
		clientchallenge = 
		debuglogfilepath = 
		dnscomputername = 
		dnsdomainname = 
		domain = 
		encodingmode = base64
		flags = ABCHMQ
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "ntlm"
		netbioscomputername = 
		netbiosdomainname = 
		ntlmversion = 1
		oemcodepage = 0
		password = 
		serverchallenge = 
		targetname = 
		username = 
		verboselogging = 0
		workstation = 
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/06/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 67
		
		  Fixed some HTTP NTLM proxy authorization issues, especially when TLS is involved.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE clientchallenge_access		&& Access method used to retrieve the Chilkat NTLM ClientChallenge property.
		*==============================================================================
		* Method:            ClientChallenge_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat NTLM ClientChallenge property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ClientChallenge
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** The ClientChallenge is passed in the Type 3 message from the client to the server. 
		** It must contain exactly 8 bytes. Because this is a string property, 
		** the bytes are get/set in encoded form (such as hex or base64) 
		** based on the value of the EncodingMode property. 
		** For example, if the EncodingMode property = "hex", then a hex representation 
		** of 8 bytes should be used to set the ClientChallenge.
		** 
		** Note: Setting the ClientChallenge is optional. 
		** If the ClientChallenge remains unset, it will be automatically set to 8 random bytes 
		** when the GenType3 method is called.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE clientchallenge_assign		&& Assign method used to hold a reference to the ClientChallenge property.
		*==============================================================================
		* Method:            ClientChallenge_Assign
		* Purpose:           Assign method used to hold
		*                    the ClientChallenge of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ClientChallenge property.
		* Returns:           
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE comparetype3		&& Compares the internal contents of two Type3 messages to verify that the LM and NTLM response parts match. A server would typically compute the Type3 message by calling GenType3, and then compare it with the Type3 message received from the client.
		*==============================================================================
		* Method:            CompareType3
		* Purpose:           Compares the internal contents of two Type3 messages 
		*                    to verify that the LM and NTLM response parts match.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMessage1 -- the first message to compare.
		*                    tcMessage2 -- the second message to compare.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/16/2022
		*==============================================================================
		
		**
		** Compares the internal contents of two Type3 messages to verify 
		** that the LM and NTLM response parts match. A server would typically compute 
		** the Type3 message by calling GenType3, and then compare it with 
		** the Type3 message received from the client. 
		** The method returns 1 if the responses match, and 0 if they do not.
		**
		
		LPARAMETERS tcMessage1 AS Character, tcMessage2 AS Character
		
		LOCAL loChilkatObject AS CHILKAT_NTLM_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      STORE m.loChilkatObject.CompareType3(m.tcMessage1, m.tcMessage2) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_NTLM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat NTLM DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat NTLM DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/15/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat NTLM DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

