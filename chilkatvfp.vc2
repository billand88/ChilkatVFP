		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/14/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS fileaccess AS ibasechilkat OF "chilkatvfp.vcx" 		&& API for reading and writing files, creating and deleting directories, deleting directory trees, splitting and re-joining large files, etc. This is a freeware class. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: appendansi		&& Appends a string using the ANSI character encoding to the currently open file. Returns 1 for success, 0 for failure.
		*m: appendbd		&& Introduced in version 9.5.0.76. Appends the contents of bd to the currently open file. Returns 1 for success, 0 for failure.
		*m: appendsb		&& Introduced in version 9.5.0.76. Appends the contents of sb using the character encoding (such as "utf-8") specified by charset to the currently open file. Returns 1 for success, 0 for failure.
		*m: appendtext		&& Appends a string using the character encoding specified by str to the currently open file. Returns 1 for success, 0 for failure.
		*m: appendunicodebom		&& Appends the 2-byte Unicode BOM (little endian) to the currently open file. Returns 1 for success, 0 for failure.
		*m: appendutf8bom		&& Appends the 3-byte utf-8 BOM to the currently open file. Returns 1 for success, 0 for failure.
		*m: currentdir_access		&& Access method used to retrieve the Chilkat FileAccess CurrentDir property.
		*m: currentdir_assign		&& Assign method used to hold the Chilkat FileAccess CurrentDir property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat FileAccess DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold the Chilkat FileAccess DebugLogFiilePath property.
		*m: dirautocreate		&& Same as DirEnsureExists, except the argument is a file path (the last part of the path is a filename and not a directory). Creates all missing directories such that filePath may be created. Returns 1 for success, 0 for failure.
		*m: dircreate		&& Creates a new directory specified by dirPath. Returns 1 for success, 0 for failure.
		*m: dirdelete		&& Deletes the directory specified by dirPath. It is only possible to delete a directory if it contains no files or subdirectories. Returns 1 for success, 0 for failure.
		*m: dirensureexists		&& Creates all directories necessary such that the entire dirPath exists. Returns 1 for success, 0 for failure.
		*m: direxists_access		&& Access method used to retrieve the Chilkat FileAccess DirExists property.
		*m: direxists_assign		&& Assign method used to hold the Chilkat FileAccess DirExists property.
		*m: endoffile_access		&& Access method used to retrieve the Chilkat FileAccess EndOfFile property.
		*m: endoffile_assign		&& Assign method used to hold the Chilkat FileAccess EndOfFile property.
		*m: fileclose		&& Closes the currently open file.
		*m: filecontentsequal		&& Compares the contents of two files and returns 1 if they are equal and otherwise returns 0. The actual contents of the files are only compared if the sizes are equal. The files are not entirely loaded into memory.
		*m: filecopy		&& Copys existingFilepath to newFilepath. If failIfExists is 1 and newFilepath already exists, then an error is returned. Returns 1 for success, 0 for failure.
		*m: filedelete		&& Deletes the file specified by filePath. Returns 1 for success, 0 for failure.
		*m: fileexists		&& Returns 1 if filePath exists, otherwise returns 0.
		*m: fileexists3		&& Introduced in version 9.5.0.45. Returns 1 if the file exists, 0 if the file does not exist, and -1 if unable to check because of directory permissions or some other error that prevents the ability to obtain the information.
		*m: fileopen		&& This method should only be called on Windows operating systems. It's arguments are similar to the Windows Platform SDK function named CreateFile.
		*m: fileopenerrormsg_access		&& Access method used to retrieve the Chilkat FileAccess FileOpenErrorMsg property.
		*m: fileopenerrormsg_assign		&& Assign method used to hold the Chilkat FileAccess FileOpenErrorMsg property.
		*m: fileopenerror_access		&& Access method used to retrieve the Chilkat FileAccess FileOpenError property.
		*m: fileopenerror_assign		&& Assign method used to hold the Chilkat FileAccess FileOpenError property.
		*m: fileread		&& Reads bytes from the currently open file. maxNumBytes specifies the maximum number of bytes to read. Returns an empty byte array on error. Returns a zero-length byte array (as a Variant) on failure.
		*m: filereadbd		&& Introduced in version 9.5.0.64. Reads bytes from the currently open file. maxNumBytes specifies the maximum number of bytes to read. Appends the bytes to the binData. Returns 1 for success, 0 for failure.
		*m: filerename		&& Renames a file from existingFilepath to newFilepath. Returns 1 for success, 0 for failure.
		*m: fileseek		&& Sets the file pointer for the currently open file. The offset is an offset in bytes from the origin.
		*m: filesize		&& Returns the size, in bytes, of a file. Returns -1 for failure. Note: This method returns a signed 32-bit integer, which is not large enough to handle files greater than 2GB in size.
		*m: filesize64		&& Introduced in version 9.5.0.88. Returns the size, in bytes, of a file. Returns -1 for failure.
		*m: filesizestr		&& Introduced in version 9.5.0.80. Returns the size of the file in decimal string format. Returns Nothing on failure
		*m: filetype		&& Introduced in version 9.5.0.77. Examines the file at path and returns one of the following values: (-1-4, 99). Additional file types may be added in the future as needed.
		*m: filewrite		&& Writes bytes to the currently open file. Returns 1 for success, 0 for failure.
		*m: filewritebd		&& Introduced in version 9.5.0.64. Writes the contents of binData to the currently open file. To specify the entire contents of binData, set both offset and numBytes equal to 0.
		*m: genblockid		&& Introduced in version 9.5.0.58. This is purely a utility/convenience method -- initially created to help with block file uploads to Azure Blob storage.
		*m: getdirectoryname		&& Introduced in version 9.5.0.64. Returns the directory information for the specified path string.
		*m: getextension		&& Introduced in version 9.5.0.64. Returns the extension of the specified path string.
		*m: getfilename		&& Introduced in version 9.5.0.64. Returns the file name and extension of the specified path string.
		*m: getfilenamewithoutextension		&& Introduced in version 9.5.0.64. Returns the file name of the specified path string without the extension.
		*m: getfiletime		&& Introduced in version 9.5.0.71. Gets one of the following date/times for a file: 0: Last-modified 1: Last-access 2: Creation. The "path" argument indicates which time to return. The values can be 0, 1, or 2.
		*m: getfiletimestr		&& Introduced in version 11.0.0. Returns one of the following times for a file: 0: Last-modified 1: Last-access 2: Creation. The "path" argument indicates which time to return. Returns Nothing on failure.
		*m: getlastmodified		&& Introduced in version 9.5.0.66. Gets the last-modified date/time for a file. The accuracy of the last-modified data is to the number of seconds. Returns Nothing on failure.
		*m: getnumblocks		&& Introduced in version 9.5.0.58. Returns the number of blocks in the currently open file. The number of bytes per block is specified by blockSize.
		*m: gettempfilename		&& Creates a temporary filepath of the form dirPath\prefix_xxxx.TMP Where "xxxx" are random alpha-numeric chars. The returned filepath is guaranteed to not already exist. Returns Nothing on failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat FileAccess LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold the Chilkat FileAccess LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat FileAccess LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold the Chilkat FileAccess LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat FileAccess LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold the Chilkat FileAccess LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat FileAccess LastErrorXML; property.
		*m: lasterrorxml_assign		&& Assign method used to hold the Chilkat FileAccess LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat FileAccess LastMethodSuccess; property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold the Chilkat FileAccess LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat FileAccess LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold the Chilkat FileAccess LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat FileAccess LastStringResult; property.
		*m: laststringresult_assign		&& Assign method used to hold the Chilkat FileAccess LastStringResult property.
		*m: lockfileonopen_access		&& Access method used to retrieve the Chilkat FileAccess LockFileOnOpen property.
		*m: lockfileonopen_assign		&& Assign method used to hold the Chilkat FileAccess LockFileOnOpen property.
		*m: openforappend		&& Opens a file for appending. If filePath did not already exists, it is created. When an existing file is opened with this method, the contents will not be overwritten and the file pointer is positioned at the end of the file.
		*m: openforread		&& Opens a file for reading. The file may contain any type of data (binary or text) and it must already exist. If the open failed, then error information will be available in the FileOpenError and FileOpenErrorMsg properties.
		*m: openforreadwrite		&& Opens a file for reading/writing. If filePath did not already exists, it is created. When an existing file is opened with this method, the contents will not be overwritten, but the file pointer is positioned at the beginning of the file.
		*m: openforwrite		&& Opens a file for writing. If filePath did not already exists, it is created. When an existing file is opened with this method, the contents will be overwritten.
		*m: readbinarytoencoded		&& Reads the entire contents of a binary file and returns it as an encoded string (using an encoding such as Base64, Hex, etc.) The encoding may be one of the following strings: base64, hex, qp, or url. Returns Nothing on failure
		*m: readblock		&& Introduced in version 9.5.0.58. Reads the Nth block of a file, where the size of each block is specified by blockSize.
		*m: readblockbd		&& Introduced in version 9.5.0.79. Reads the Nth block of a file, where the size of each block is specified by blockSize. The first block is at blockIndex 0.
		*m: readentirefile		&& Reads the entire contents of a binary file and returns the data. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: readentiretextfile		&& Reads the entire contents of a text file, interprets the bytes according to the character encoding specified by charset, and returns the text file as a string. Returns Nothing on failure
		*m: readnextfragment		&& Introduced in version 9.5.0.80. Scans the currently open file (opened by calling OpenForRead) for the next chunk of text delimited by beginMarker and endMarker. The matched text, including the beginMarker and endMarker are appended to sb.
		*m: reassemblefile		&& Reassembles a file previously split by the SplitFile method. Returns 1 for success, 0 for failure.
		*m: replacestrings		&& Replaces all occurrences of existingString with replacementString in a file. The character encoding, such as utf-8, ansi, etc. is specified by charset.
		*m: setcurrentdir		&& Sets the current working directory for the calling process to dirPath. Returns 1 for success, 0 for failure.
		*m: setfiletimes		&& Sets the create date/time, the last-access date/time, and the last-modified date/time for a file. For non-Windows filesystems where create times are not implemented, the createTime is ignored.
		*m: setlastmodified		&& Sets the last-modified date/time for a file.
		*m: splitfile		&& Splits a file into chunks. To reassemble a split file, see the ReassembleFile method. Please refer to the example below: Returns 1 for success, 0 for failure.
		*m: symlinkcreate		&& Introduced in version 9.5.0.77. Creates a symbolic link. Note: On Windows systems, this is not the same as creating a shortcut. A Windows symbolic link and a Windows shortcut are two different things.
		*m: symlinktarget		&& Introduced in version 9.5.0.77. Returns the full pathname of the file at the end of the linkPath. Also handles Windows shortcut files by returning the absolute path of the target. Returns Nothing on failure
		*m: treedelete		&& Deletes an entire directory tree (all files and sub-directories). Returns 1 for success, 0 for failure.
		*m: truncate		&& Introduced in version 9.5.0.80. Truncates the currently open file at the current file position. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat FileAccess VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold the Chilkat FileAccess VerboseLogging property.
		*m: writeentirefile		&& Opens/creates filePath, writes fileData, and closes the file. Returns 1 for success, 0 for failure.
		*m: writeentiretextfile		&& Opens filePath, writes textData using the character encoding specified by charset, and closes the file. If includedPreamble is 1 and the charset is Unicode or utf-8, then the BOM is included at the beginning of the file.
		*p: currentdir		&& The current working directory of the calling process.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: direxists		&& Introduced in version 10.0.0. Returns 1 if the dirPath exists.
		*p: endoffile		&& Returns 1 if the current open file is at the end-of-file.
		*p: fileopenerror		&& This property is set by the following methods: FileOpen, OpenForRead, OpenForWrite, OpenForReadWrite, and OpenForAppend. It provides an error code indicating the failure reason.
		*p: fileopenerrormsg		&& The error message text associated with the FileOpenError code.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: lockfileonopen		&& Introduced in version 9.5.0.80. Note: This property only applies for applications running on Windows. If 1, then the following methods open files for exclusive-access: OpenForAppend, OpenForRead, OpenForReadWrite, OpenForWrite.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = FileAccess
		currentdir = 
		debuglogfilepath = 
		direxists = .F.
		endoffile = 0
		fileopenerror = 0
		fileopenerrormsg = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		lockfileonopen = 0
		Name = "fileaccess"
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE appendansi		&& Appends a string using the ANSI character encoding to the currently open file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendANSI
		* Purpose:           Appends a string using the ANSI character 
		*                    encoding to the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcText, the text to append.
		* Returns:           Character
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Appends a string using the ANSI character encoding to the currently open file.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcText AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendANSI(m.tcText) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendbd		&& Introduced in version 9.5.0.76. Appends the contents of bd to the currently open file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendFromBd
		* Purpose:           Appends the contents of bd to the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Appends the contents of bd to the currently open file.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AppendFromBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendsb		&& Introduced in version 9.5.0.76. Appends the contents of sb using the character encoding (such as "utf-8") specified by charset to the currently open file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendSb
		* Purpose:           Appends the contents of sb using the character encoding 
		*                    specified by charset to the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat String Builder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Appends the contents of sb using the character encoding (such as "utf-8") 
		** specified by charset to the currently open file.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AppendSb(m.loChilkatStringBuilder, m.tcCharset) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendtext		&& Appends a string using the character encoding specified by str to the currently open file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendText
		* Purpose:           Appends a string using the character encoding 
		*                    specified by str to the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcText, the text to append.
		*                    tcCharset, the charset of the appended text
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Appends a string using the character encoding 
		** specified by str to the currently open file.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcText AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendText(m.tcText, m.tcCharset) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendunicodebom		&& Appends the 2-byte Unicode BOM (little endian) to the currently open file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendUnicodeBOM
		* Purpose:           Appends the 2-byte Unicode BOM (little endian) to the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/18/2022
		*==============================================================================
		
		**
		** Appends the 2-byte Unicode BOM (little endian) to the currently open file.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendUnicodeBOM() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

