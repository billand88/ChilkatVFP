	PROCEDURE loadjwk		&& Introduced in version 9.5.0.66. Loads a private key from an JWK (JSON Web Key) string.
		*==============================================================================
		* Method:            LoadJWK
		* Purpose:           Loads a private key from an JWK (JSON Web Key) string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSON, the JSON strong to load.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Loads a private key from an JWK (JSON Web Key) string.
		** RSA keys have this JWK format:
		** 
		**          {"kty":"RSA",
		**           "n":"0vx7agoebGcQ ... JzKnqDKgw",
		**           "e":"AQAB",
		**           "d":"X4cTteJY_gn4F ... 4jfcKoAC8Q",
		**           "p":"83i-7IvMGXoMX ... vn7O0nVbfs",
		**           "q":"3dfOR9cuYq-0S ... 4vIcb6yelxk",
		**           "dp":"G4sPXkc6Ya9 ... 8YeiKkTiBj0",
		**           "dq":"s9lAH9fggBso ... w494Q_cgk",
		**           "qi":"GyM_p6JrXySi ... zTKhAVRU"}
		** 
		** ECC keys have this JWK format.
		** 
		**          {"kty":"EC",
		**           "crv":"P-256",
		**           "x":"MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4",
		**           "y":"4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM",
		**           "d":"870MB6gfuTJ4HtUnUvYMyJpr5eUZNP4Bk43bVdj3eAE"}
		** 
		** Ed25519 keys (added in v9.5.0.83) have this JWK format.
		** 
		**          {"kty": "OKP",
		**          "crv": "Ed25519",
		**          "x": "SE2Kne5xt51z1eciMH2T2ftDQp96Gl6FhY6zSQujiP0",
		**          "d": "O-eRXewadF0sNyB0U9omcnt8Qg2ZmeK3WSXPYgqe570",
		**          "use": "sig"}
		** 
		** Note: Each of the private key Load* methods will auto-recognize 
		** the content and will parse appropriately. 
		** The private key should be successfully loaded 
		** even when the wrong format data is passed to the wrong method.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcJSON AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadJWK(m.tcJSON) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpem		&& Loads the private key from an in-memory PEM string. If the PEM contains an encrypted private key, then the LoadEncryptedPem method should instead be called.
		*==============================================================================
		* Method:            LoadPEM
		* Purpose:           Loads the private key from an in-memory PEM string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMString, the JSON strong to load.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Loads the private key from an in-memory PEM string. 
		** If the PEM contains an encrypted private key, 
		** then the LoadEncryptedPem method should instead be called. 
		** This method is for loading an unencrypted private key stored in PEM using PKCS#1 or PKCS#8.
		** 
		** A private key stored in PKCS#1 format begins and ends with the tags:
		** 
		**   -----BEGIN RSA PRIVATE KEY-----
		**   BASE64 ENCODED DATA
		**   -----END RSA PRIVATE KEY-----
		** 
		** For those requiring a deeper understanding, the PKCS1 base64 contains ASN.1 
		** in DER encoding with the following structure:
		** 
		**   RSAPrivateKey ::= SEQUENCE {
		**     version           Version,
		**     modulus           INTEGER,  -- n
		**     publicExponent    INTEGER,  -- e
		**     privateExponent   INTEGER,  -- d
		**     prime1            INTEGER,  -- p
		**     prime2            INTEGER,  -- q
		**     exponent1         INTEGER,  -- d mod (p-1)
		**     exponent2         INTEGER,  -- d mod (q-1)
		**     coefficient       INTEGER,  -- (inverse of q) mod p
		**     otherPrimeInfos   OtherPrimeInfos OPTIONAL
		**     }
		** 
		** A private key stored in PKCS#8 format begins and ends with the tags:
		** 
		**   -----BEGIN PRIVATE KEY-----
		**   BASE64 ENCODED DATA
		**   -----END PRIVATE KEY-----
		** 
		** For those requiring a deeper understanding, the PKCS8 base64 contains ASN.1 
		** in DER encoding with the following structure:
		** 
		**   PrivateKeyInfo ::= SEQUENCE {
		**     version         Version,
		**     algorithm       AlgorithmIdentifier,
		**     PrivateKey      BIT STRING
		**   }
		** 
		**   AlgorithmIdentifier ::= SEQUENCE {
		**     algorithm       OBJECT IDENTIFIER,
		**     parameters      ANY DEFINED BY algorithm OPTIONAL
		**   }
		** 
		** Note: Each of the private key Load* methods willl auto-recognize 
		** the content and will parse appropriately. The private key should be 
		** successfully loaded even when the wrong format data is passed to the wrong method.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPEMString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadPEM(m.tcPEMString) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadpemfile		&& Loads a private key from a PEM file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadPEMFile
		* Purpose:           Loads a private key from a PEM file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMFilePath, the path to the PEM file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Loads a private key from a PEM file.
		** 
