	PROCEDURE parsedaterfc3339		&& Converts the date string (in RFC 3339 format) to a Date type.
		*==============================================================================
		* Method:            ParseDateRFC3339
		* Purpose:           Converts the date string (in RFC 3339 format) to a Date type.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           lcDateTime, the date time value in RFC 3339 format
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Converts the date string (in RFC 3339 format) to a Date type.
		** 
		** Note: In limited testing, the return value is the same as the value
		** submitted by the AppendDateFC3339 method. So if you submit 
		** a VFP Date or DateTime value, that's the data type you get back.
		**
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, lcDateTime AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcDateTime = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		     lcDateTime = m.loChilkatObject.ParseDateRFC3339()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcDateTime
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

