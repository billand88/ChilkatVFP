		*                    format signature in encoded string format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTextString -- the text string to convert.
		* Returns:           The encoded PKCS7/CMS format signature string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Digitally signs a string and returns a PKCS7/CMS format signature 
		** in encoded string format (such as base64 or hex). 
		** This is a signature that contains both the original data 
		** as well as the signature. A certificate must be set by 
		** calling SetSigningCert prior to calling this method. 
		** The Charset property controls the character encoding of the string that is signed. 
		** (Languages such as VB.NET, C#, and Visual Basic work with Unicode strings.) 
		** To sign Unicode data (2 bytes per char), set the Charset property to "Unicode". 
		** To implicitly convert the string to a mutlibyte charset such as "iso-8859-1", 
		** "Shift_JIS", "utf-8", or something else, then set the Charset property 
		** to the name of the charset before signing. 
		** The complete list of charsets is listed in the EncryptString method description.
		** 
		** The EncodingMode property controls the output encoding, 
		** which can be "Base64", "QP","Hex", etc. (See the EncodingMode property.)
		**
		** Fixed for Version 72: 
		** Fixed certain cases where creating PKCS7 signatures embedded the same certificate twice.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcTextString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedSignatureString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedSignatureString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedSignatureString = ;
		      m.loChilkatObject.OpaqueSignStringENC(m.tcTextString)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedSignatureString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE opaquesignstringencasync		&& Creates an asynchronous task to call the OpaqueSignStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            OpaqueSignStringENCAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    OpaqueSignStringENC method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string to sign. 
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the OpaqueSignStringENC method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Fixed for Version 72: 
		** Fixed certain cases where creating PKCS7 signatures embedded the same certificate twice.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.OpaqueSignStringENCAsync(m.tcString)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE opaqueverifybd		&& Introduced in version 9.5.0.67. In-place verifies and unwraps the PKCS7/CMS contents of bd. If the signature is verified, the contents of bd will be replaced with the original data, and the method returns 1.
		*==============================================================================
		* Method:            OpaqueVerifyBd
		* Purpose:           In-place verifies and unwraps the PKCS7/CMS contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** In-place verifies and unwraps the PKCS7/CMS contents of bd. 
		** If the signature is verified, the contents of bd will be replaced 
		** with the original data, and the method returns 1. If the signature is not verified, 
		** then the contents of bd remain unchanged and the method returns 0.
		** 
		** Note: The signer certificates can be retrieved after any Verify* method call 
		** by using the NumSignerCerts property and the GetSignerCert method.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.OpaqueVerifyBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE opaqueverifybytes		&& Verifies an opaque signature and returns the original data. If the signature verification fails, the returned data will be 0 bytes in length.
		*==============================================================================
		* Method:            OpaqueVerifyBytes
		* Purpose:           Verifies an opaque signature and returns the original data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqOpaqueSignature -- the opaque signature to verify.
		* Returns:           The original data.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Verifies an opaque signature and returns the original data. 
		** If the signature verification fails, the returned data will be 
		** 0 bytes in length.
		** 
		** Note: The signer certificates can be retrieved after 
		** any Verify* method call by using the NumSignerCerts property 
		** and the GetSignerCert method.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqOpaqueSignature AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqOriginalData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqOriginalData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqOriginalData = ;
		      m.loChilkatObject.OpaqueVerifyBytes(m.tqOpaqueSignature)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqOriginalData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

