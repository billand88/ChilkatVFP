	PROCEDURE setmailflag		&& Sets a flag for a single message on the IMAP server. The UID of the email object is used to find the message on the IMAP server that is to be affected. If value = 1, the flag is turned on, if value = 0, the flag is turned off.
		*==============================================================================
		* Method:            SetMailFlag
		* Purpose:           Sets a flag for a single message on the IMAP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail -- a Chilkat Email object.
		*                    tcFlagName -- the flag name to set the value against.
		*                    tuValue, whether or not it is set to on or off.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Sets a flag for a single message on the IMAP server. 
		** The UID of the email object is used to find the message 
		** on the IMAP server that is to be affected. 
		** If value = 1, the flag is turned on, if value = 0, the flag is turned off.
		** 
		** Both standard system flags as well as custom flags may be set. 
		** Standard system flags typically begin with a backslash character, 
		** such as "\Deleted", "\Seen", "\Answered", "\Flagged", "\Draft", and "\Answered". 
		** Custom flags can be anything, such as "NonJunk", "$label1", "$MailFlagBit1", etc..
		** 
		** Note: When the Chilkat IMAP component downloads an email from an IMAP server, 
		** it inserts a "ckx-imap-uid" header field in the email object. 
		** This is subsequently used by this method to get the UID associated with the email. 
		** The "ckx-imap-uid" header must be present for this method to be successful.
		** 
		** Note: Calling this method is identical to calling the SetFlag method, 
		** except the UID is automatically obtained from the email object.
		** 
		** Important: Setting the "Deleted" flag does not remove the email from the mailbox. 
		** Emails marked "Deleted" are removed when the Expunge method is called.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		tcFlagName AS Character, tuValue AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, liValue AS Integer
		
		STORE 0 TO m.liValue, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liValue = .LogicalToBit(m.tuValue)
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		 
		      STORE m.loChilkatObject.SetMailFlag(m.loChilkatEmail, ;
		      m.tcFlagName, m.liValue) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setmailflagasync		&& Creates an asynchronous task to call the SetMailFlag method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            SetMailFlagAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    SetMailFlag method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail -- a Chilkat Email object.
		*                    tcFlagName -- the flag name to set the value against.
		*                    tuValue, whether or not it is set to on or off.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the SetMailFlag method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		tcFlagName AS Character, tuValue AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, liValue AS Integer ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE 0 TO m.liValue, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatTask, m.loParkParameterEmail, m.loChilkatEmail
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liValue = .LogicalToBit(m.tuValue)
		
		      loParkParameterEmail = ;
		       NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.SetMailFlagAsync(m.loChilkatEmail, m.tcFlagName, m.liValue)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		  
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setquota		&& Introduced in version 9.5.0.58. Sets the quota for a quotaRoot. The resource should be one of two keywords:"STORAGE" or "MESSAGE". Use "STORAGE" to set the maximum capacity of the combined messages in quotaRoot.
		*==============================================================================
		* Method:            SetQuota
		* Purpose:           Sets the quota for a quotaRoot. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcQuotaRoot -- the quota root.
		*                    tcResource -- the resource to set the quota.
		*                    tiQuota -- the quota amount.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Sets the quota for a quotaRoot. 
		** The resource should be one of two keywords:"STORAGE" or "MESSAGE". 
		** Use "STORAGE" to set the maximum capacity of the combined messages in quotaRoot. 
		** Use "MESSAGE" to set the maximum number of messages allowed.
		** 
		** If setting a STORAGE quota, the quota is in units of 1024 octets. 
		** For example, to specify a limit of 500,000,000 bytes, set quota equal to 500,000.
		** 
		** This feature is only possible with IMAP servers that support the QUOTA extension/capability. 
		** If an IMAP server supports the QUOTA extension, it likely supports the STORAGE resource. 
		** The MESSAGE resource is less commonly supported.
		**
		
		LPARAMETERS tcQuotaRoot AS Character, tcResource AS Character, tiQuota AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetQuota(m.tcQuotaRoot, m.tcResource, m.tiQuota) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

