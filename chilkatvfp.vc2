	PROCEDURE addrelatedstring		&& Adds a related item to the email. A related item is typically an image or style sheet referenced by an HTML tag within the HTML email body.
		*==============================================================================
		* Method:            AddRelatedString
		* Purpose:           Adds a related item to the email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileNameInHTML -- file name to be used within the HTML.
		*                    tcContent -- the contents of the related item.
		*                    tcCharset -- the charset to be used for the text content.
		* Returns:           ContentID if successful.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds a related item to the email. 
		** A related item is typically an image or style sheet referenced 
		** by an HTML tag within the HTML email body. 
		** The contents of the related item are passed str.
		** nameInHtml specifies the filename that should be used within the HTML, 
		** and not an actual filename on the local filesystem. 
		** Charset specifies the Charset that should be used for the text content of the related item. 
		** Returns the content-ID generated for the added item.
		**
		** Fixed for Version 46: Minor fix to suppress the unintentional creation 
		** of an empty plain-text body in the MIME in some circumstances 
		** (which is usually harmless).
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileNameInHTML AS Character, tcContent AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcContentID AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcContentID = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcContentID = m.loChilkatObject.AddRelatedString(m.tcFileNameInHTML, m.tcContent, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcContentID
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addrelatedstring2		&& Adds a related item to the email from an in-memory string. Related items are things such as images and style sheets that are embedded within an HTML email.
		*==============================================================================
		* Method:            AddRelatedString2
		* Purpose:           Adds a related item to the email from an in-memory string.
