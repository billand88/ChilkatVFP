		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        10/13/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of ChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		loVersioning = NULL
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Version 82 or greater test
		      IF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 82)
		
		        .EnableCompression = 0
		
		      ENDIF m.liCalculatedBuildNumber >= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 82)
		      ** End version 82 or greater test
		
		    ELSE
		
		      llReturn = .F.
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have a good object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loVersioning = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	HIDDEN PROCEDURE isconnected_access		&& Access method used to retrieve the Chilkat SSH IsConnected property.
		*==============================================================================
		* Method:            IsConnected_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH IsConnected property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IsConnected
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** Returns 1 if the last known state of the connection with the SSH server is "connected".
		**
		** Note: The IsConnected property is set to 1 
		** after successfully completing the Connect method call. 
		** The IsConnected property will only be set to 0 by calling Disconnect, 
		** or by the failure of another method call such that the disconnection is detected.
		**
		** If the last communications with the SSH server was successful 
		** and then a long time passes with no communications, 
		** and the server disconnects because of inactivity, 
		** then IsConnected will still indicate 1. 
		** A better way of testing the connection is to call SendIgnore 
		** after checking to see if IsConnected is 1. 
		** (If IsConnected is 0, then there is surely no connection.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE isconnected_assign		&& Assign method used to hold a reference to the SSH IsConnected property.
