	PROCEDURE signstringenc		&& Digitally signs a string and returns the PKCS7 detached digital signature as an encoded string. A certificate must be set by calling SetSigningCert prior to calling this method.
		*==============================================================================
		* Method:            SignStringENC
		* Purpose:           Digitally signs a string and returns the PKCS7 
		*                    detached digital signature as an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the text string to sign.
		* Returns:           The PKCS7 detached digital signature.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Digitally signs a string and returns the PKCS7 detached digital signature as an encoded string. 
		** A certificate must be set by calling SetSigningCert prior to calling this method. 
		** The Charset property controls the character encoding of the string that is signed. 
		** (Languages such as VB.NET, C#, and Visual Basic work with Unicode strings.) 
		** To sign Unicode data (2 bytes per char), set the Charset property to "Unicode". 
		** To implicitly convert the string to a mutlibyte charset such as "iso-8859-1", 
		** "Shift_JIS", "utf-8", or something else, then set the Charset property 
		** to the name of the charset before signing. The complete list of charsets 
		** is listed in the EncryptString method description.
		** 
		** The encoding of the output string is controlled by the EncodingMode property, 
		** which can be set to "Base64", "QP", or "Hex".
		**
		** Fixed for Version 72: 
		** Fixed certain cases where creating PKCS7 signatures embedded the same certificate twice.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedSignature AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedSignature = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedSignature = m.loChilkatObject.SignStringENC(m.tcString)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedSignature
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

