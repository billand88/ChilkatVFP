	PROCEDURE gencsrbd		&& Introduced in version 9.5.0.65. Generate a CSR and return the binary DER in csrData. The privKey can be an RSA or ECDSA private key. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GenCSRBd
		* Purpose:           Generate a CSR and return the binary DER in csrData.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPrivateKey, a Chilkat Private Key object.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Generate a CSR and return the binary DER in csrData. 
		** The privKey can be an RSA or ECDSA private key.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CSR_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		 
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenCSRBd(m.loChilkatPrivateKey, ;
		        m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSR_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL) 
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE gencsrpem		&& Introduced in version 9.5.0.65. Generate a CSR and return it as a PEM string. The privKey can be an RSA or ECDSA private key. Returns Nothing on failure.
		*==============================================================================
		* Method:            GenCSRPEM
		* Purpose:           Generate a CSR and return the binary DER in csrData.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           The PEM string.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Generate a CSR and return it as a PEM string. 
		** The privKey can be an RSA or ECDSA private key.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CSR_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, lcPEM AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		lcPEM = []
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        lcPEM = m.loChilkatObject.GenCSRPEM(m.loChilkatPrivateKey)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.lcPEM
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSR_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getextensionrequest		&& Introduced in version 9.5.0.91. Gets the 1.2.840.113549.1.9.14 extensionRequest from the previously loaded CSR. The extensionReqXml will be loaded with the extension request XML if one exists. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetExtensionRequest
		* Purpose:           Gets the 1.2.840.113549.1.9.14 extensionRequest 
		*                    from the previously loaded CSR.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML, a Chilkat XML object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		**
		** Gets the 1.2.840.113549.1.9.14 extensionRequest from the previously loaded CSR. 
		** The extensionReqXml will be loaded with the extension request XML if one exists.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CSR_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		llImplemented = .F.
		liIntroducedInBuild = 91
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterXml = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		      loChilkatXml = m.loParkParameterXml.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetExtensionRequest(m.loChilkatXML) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatXml = ;
		      m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSR_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getpublickey		&& Introduced in version 9.5.0.76. Returns the CSR's public key in the pubkey. Returns 1 for success, 0 for failure.
		*==============================================================================
