	PROCEDURE sethtmlbody		&& Sets the HTML body of an email.
		*==============================================================================
		* Method:            SetHTMLBody
		* Purpose:           Sets the HTML body of an email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHTML, the HTML to set.
		* Returns:           
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Sets the HTML body of an email.
		**
		** Fixed for Version 55: Fixed: When a new email is created, 
		** if an attachment is first added prior to calling SetHtmlBody, 
		** the resultant email did not have the correct MIME structure.
		**
		** Fixed for Version 56: Fixed a SetHtmlBody problem.
		**
		** Fixed for Version 59: Fixed email structure problems 
		** for certain situations when this method was called.
		**
		** Fixed for Version 73: This method, in certain circumstances, 
		** would incorrectly set the top-level MIME header to text/html for multipart messages. 
		**
		
		LPARAMETERS tcHTML AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.SetHTMLBody(m.tcHTML)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

