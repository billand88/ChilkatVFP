	PROCEDURE sethmackey		&& Introduced in version 9.5.0.69. Sets the HMAC key to be used if the Signature used an HMAC signing algorithm.
		*==============================================================================
		* Method:            SetHMACKey
		* Purpose:           Sets the HMAC key to be used if the Signature 
		*                    used an HMAC signing algorithm.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHMACKey, the HMAC key to set.
		*                    tcEncoding, the encoding of the HMAC key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Sets the HMAC key to be used if the Signature used an HMAC signing algorithm. 
		** The encoding specifies the encoding of key, and can be "hex", "base64", "ascii", 
		** or any of the binary encodings supported by Chilkat in the link below.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHMACKey AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetHMACKey(m.tcHMACKey, m.tcEncoding) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sethttpobj		&& Introduced in version 9.5.0.90. Sets the HTTP object to be used to communicate with OCSP responders, CRL distribution points, or timestamp authority (TSA) servers if needed.
		*==============================================================================
		* Method:            SetHTTPObj
		* Purpose:           Sets the HTTP object to be used to communicate with OCSP responders, 
		*                    CRL distribution points, or timestamp authority servers if needed.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatHTTP, a Chilkat HTTP object.
		* Returns:           
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.90
		**
		** Sets the HTTP object to be used to communicate with OCSP responders, 
		** CRL distribution points, or timestamp authority (TSA) servers if needed. 
		** The http is used to send the requests, and it allows 
		** for connection related settings and timeouts to be set. 
		** For example, if HTTP or SOCKS proxies are required, 
		** these features can be specified on the http.
		**
		** Enhancement in Version 94: Chilkat improved OCSP requests 
		** (used in various parts of the Chilkat API) to satisfy some servers 
		** that are more picky about certain parts of the OCSP protocol which should be optional.
		** 
		** Fixed for Version 10: Fixed a problem having to do 
		** with sending OCSP requests for ECDSA based certificates.
		**
		
		LPARAMETERS toChilkatHTTP AS CHILKAT_HTTP_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterHttp AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatHttp AS CHILKAT_HTTP_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHttp, m.loChilkatHttp
		
		llImplemented = .F.
		liIntroducedInBuild = 90
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterHttp = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHttp)
		
		      loChilkatHttp = m.loParkParameterHttp.GetObject()
		
		      TRY
		
		        m.loChilkatObject.SetHTTPObj(m.loChilkatHTTP)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatHttp = ;
		      m.loParkParameterHttp.SetObject(m.toChilkatHttp, m.loChilkatHttp)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHttp, m.loChilkatHttp
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  toChilkatHTTP = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loParkParameterHttp = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatHttp = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setpublickey		&& Introduced in version 9.5.0.69. Sets the public key to be used for verifying the signature indicated by the Selector property.
		*==============================================================================
		* Method:            SetPublicKey
		* Purpose:           Sets the public key to be used for verifying the signature 
		*                    indicated by the Selector property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPublicKey, a Chilkat Public Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Sets the public key to be used for verifying the signature indicated 
		** by the Selector property. A public key only needs to be explicitly provided 
		** by the application for those XML signatures where the public key 
		** is not already available within the KeyInfo of the Signature. 
		** In some cases, the KeyInfo within the Signature contains information 
		** about what public key was used for signing. The application can use 
		** this information to retrieve the matching public key and provide it via this method.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPublicKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPublicKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPublicKey)
		
		      loChilkatPublicKey = m.loParkParameterPublicKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetPublicKey(m.loChilkatPublicKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPublicKey = ;
		      m.loParkParameterPublicKey.SetObject(m.toChilkatPublicKey, m.loChilkatPublicKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  toChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loParkParameterPublicKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPublicKey = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

