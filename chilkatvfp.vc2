	PROCEDURE filewritebd		&& Introduced in version 9.5.0.64. Writes the contents of binData to the currently open file. To specify the entire contents of binData, set both offset and numBytes equal to 0.
		*==============================================================================
		* Method:            FileWriteBd
		* Purpose:           Writes the contents of binData to the currently open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		*                    tiOffSet -- the file offset to start writing.
		*                    tiNumBytes -- the number of bytes to write.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.64
		**
		** Writes the contents of binData to the currently open file. 
		** To specify the entire contents of binData, set both offset and numBytes equal to 0. 
		** To write all remaining data starting at offset, then set numBytes equal to 0.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		tiOffSet AS Integer, tiNumBytes AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 64
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FileWriteBd(m.loChilkatBinData, ;
		        m.tiOffSet, m.tiNumBytes) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE genblockid		&& Introduced in version 9.5.0.58. This is purely a utility/convenience method -- initially created to help with block file uploads to Azure Blob storage.
		*==============================================================================
		* Method:            GenBlockID
		* Purpose:           This is purely a utility/convenience method -- initially 
		*                    created to help with block file uploads to Azure Blob storage.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiOffset, the current file path.
		*                    tiLength, the length of the block.
		*                    tcEncoding, the block encoding.
		* Returns:           The block ID
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		** 
		** This is purely a utility/convenience method -- initially created 
		** to help with block file uploads to Azure Blob storage. 
		** It generates a block ID string that is the decimal representation 
		** of the index in length chars, and then encoded according to encoding 
		** (which can be an encoding such as "base64", "hex", "ascii", etc.) 
		** For example, if index = 8, length = 12, and encoding = "base64", 
		** then the string "00000012" is returned base64 encoded.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiIndex AS Integer, tiLength AS Integer, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcBlockID AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcBlockID = []
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcBlockID = ;
		        m.loChilkatObject.GenBlockID(m.tiIndex, m.tiLength, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcBlockID
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getdirectoryname		&& Introduced in version 9.5.0.64. Returns the directory information for the specified path string.
