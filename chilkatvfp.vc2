		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_VARBINARY
		
		      ** Have a good parameter test
