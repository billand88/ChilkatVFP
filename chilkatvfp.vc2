	PROCEDURE listxml		&& Scans a TAR archive and returns XML detailing the files and directories found within the TAR. Returns Nothing on failure.
		*==============================================================================
		* Method:            ListXML
		* Purpose:           Scans a TAR archive and returns XML detailing 
		*                    the files and directories found within the TAR.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTARPath -- the path to the TAR archive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Scans a TAR archive and returns XML detailing 
		** the files and directories found within the TAR.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTARPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, ;
		loException AS Exception, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcXML = m.loChilkatObject.ListXML(m.tcTARPath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE listxmlasync		&& Creates an asynchronous task to call the ListXml method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            ListXMLAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    ListXML method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTARPath -- the path to the TAR archive.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the ListXML method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTARPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.ListXMLAsync(m.tcTARPath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadTaskCaller
		* Purpose:           Loads the caller of the task's async method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTask, a Chilkat Task object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Loads the caller of the task's async method.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatTask AS CHILKAT_TASK_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		loParkParameterTask AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTask = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTask)
		
		      loChilkatTask = m.loParkParameterTask.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadTaskCaller(m.loChilkatTask) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTask = ;
		      m.loParkParameterTask.SetObject(m.toChilkatTask, m.loChilkatTask)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TAR_COM_CALL)
		  toChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loParkParameterTask = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE matchcasesensitive_access		&& Access method used to retrieve the Chilkat TAR MatchCaseSensitive property.
		*==============================================================================
