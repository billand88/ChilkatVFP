	ENDPROC

	PROCEDURE downloadfileasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the DownloadFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            DownloadFileAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    DownloadFile method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePath, the path to the remote file.
		*                    tcLocalPath, the path to the locally downloaded file.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		**
		** Creates an asynchronous task to call the DownloadFile method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Fixed for Version 58: This method did not close the channel.
		**
		** Fixed for Version 77: This method did not succeed if the remote filename contained a SPACE char.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemotePath AS Character, tcLocalPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCP_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask 
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 51
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.DownloadFileAsync(m.tcRemotePath, m.tcLocalPath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

