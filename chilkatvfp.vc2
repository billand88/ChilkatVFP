	PROCEDURE asyncacceptstart		&& Undocumented method! Initiates a background thread to wait for and accept the next incoming TCP connection. The method will fail if an asynchronous operation is already in progress. The timeout (in milliseconds) is passed in maxWaitMs.
		*==============================================================================
		* Method:            AsyncAcceptStart
		* Purpose:           Undocumented method! Call this to abort an asynchronous socket connect 
		*                    that is running in a background thread. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaxWaitMs -- the maximum wait to start.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Undocumented method! 
		**
		** Initiates a background thread to wait for and accept the next incoming TCP
		** connection. The method will fail if an asynchronous operation is already in
		** progress. The timeout (in milliseconds) is passed in maxWaitMs. To wait indefinitely,
		** set maxWaitMs to 0. Asynchronous accept operations can be aborted by calling
		** AsyncAcceptAbort. When the async accept operation completes, the
		** AsyncAcceptFinished property will become true. If the accept was successful,
		** the AsyncAcceptSuccess property is set to true and the connected socket can be
		** retrieved via the AsyncAcceptSocket method. A debug log is available in the
		** AsyncAcceptLog property.
		** 
		** This functionality is replaced by the new model for asynchronous programming
		** introduced in Chilkat v9.5.0.52. Applications should use the new model, which is
		** identified by methods having names ending with "Async" and return a task object.
		**
		
		LPARAMETERS tiMaxWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.AsyncAcceptStart(m.tiMaxWaitMs) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

