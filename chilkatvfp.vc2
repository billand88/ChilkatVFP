	PROCEDURE addattachmentbd		&& Adds an attachment using the contents of a BinData object. If contentType is empty, then the content-type will be inferred from the filename extension. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddAttachmentBd
		* Purpose:           Adds an attachment using the contents of a BinData object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the attachment file name.
		*                    toChilkatBinData -- a Chilkat binary data object.
		*                    tcContentType -- the content type.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.63
		**
		** Adds an attachment using the contents of a BinData object. 
		** If contentType is empty, then the content-type will be inferred from the filename extension.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFileName AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tcContentType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, loException AS Exception
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 63
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddAttachmentBd(m.tcFileName, m.loChilkatBinData, ;
		        m.tcContentType) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End not implemented yet test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addattachmentheader		&& Adds or replaces a MIME header field in one of the email attachments. If the header field does not exist, it is added. Otherwise it is replaced.
		*==============================================================================
		* Method:            AddAttachmentHeader
		* Purpose:           Adds or replaces a MIME header field in one of the email attachments.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the attachment index in the array.
		*                    tcFieldName -- a MIME header field name.
		*                    tcFieldValue -- the value to store.
		* Returns:           Nothing
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds or replaces a MIME header field in one of the email attachments. 
		** If the header field does not exist, it is added. Otherwise it is replaced.
		**
		
		LPARAMETERS tiIndex AS Integer, tcFieldName AS Character, tcFieldValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      m.loChilkatObject.AddAttachmentHeader(m.tiIndex, m.tcFieldName, m.tcFieldValue)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addbcc		&& Adds a recipient to the blind carbon-copy list. emailAddress is required, but friendlyName may be empty. To add multiple BCC recipients, call this method once per recipient. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddBCC
		* Purpose:           Adds a recipient to the blind carbon-copy list. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFriendlyName -- the "friendly" name.
		*                    tcEmailAddress -- an email address
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds a recipient to the blind carbon-copy (BCC) list. emailAddress is required; 
		** friendlyName is optional. Call this method separately for each BCC recipient.
		**
		** Note: Before v11.0.0, BCC addresses are not added to the MIME header. 
		** After v11.0.0, BCC addresses are included in the MIME header. 
		** Most email servers remove the BCC header before delivering the message to regular recipients. 
		** The NoBccHeader keyword can be used in UncommonOptions to prevent BCC email addresses 
		** in the MIME passed to the SMTP server. If your application specifies NoBccHeader, 
		** do so before adding BCC addresses.
		**
		** The recipient is added to the in-memory message only. The message is not transmitted 
		** until it is passed to a sending method of MailMan.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFriendlyName AS Character, tcEmailAddress AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		 
		    TRY
		
		      STORE m.loChilkatObject.AddBCC(m.tcFriendlyName, m.tcEmailAddress) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

