	PROCEDURE pop3connect		&& Explicitly establishes a connection to the POP3 server, which includes establishing a secure TLS channel if required, and receives the initial greeting.
		*==============================================================================
		* Method:            POP3Connect
		* Purpose:           Explicitly establishes a connection to the POP3 server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Explicitly establishes a connection to the POP3 server, 
		** which includes establishing a secure TLS channel if required, and receives the initial greeting. 
		** This method stops short of authenticating. 
		** The Pop3Authenticate method should be called after a successful call to this method.
		**
		** Note 1: The Pop3BeginSession method both connects and authenticates. 
		** It is the equivalent of calling Pop3Connect followed by Pop3Authenticate.
		**
		** Note 2: All methods that communicate with the POP3 server, such as FetchEmail, 
		** will automatically connect and authenticate if not already connected and authenticated.
		**
		** Important: All TCP-based Internet communications, regardless of the protocol 
		** (such as HTTP, FTP, SSH, IMAP, POP3, SMTP, etc.), and regardless of SSL/TLS, 
		** begin with establishing a TCP connection to a remote host:port. 
		** External security-related infrastructure such as software firewalls (Windows Firewall), 
		** hardware firewalls, anti-virus, at either source or destination (or both) can block the connection. 
		** If the connection fails, make sure to check all potential external causes of blockage.
		** 
		** Fixed for Version 53: A fix was made for some sitatuions 
		** where a server immediately wishes to renegotiate after connecting.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.POP3Connect() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		    ** Process successful test
		    IF m.liReturn = 1
		
		      .AutoFixSettings()
		
		    ENDIF m.liReturn = 1
		    ** End process successful test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

