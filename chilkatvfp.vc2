	PROCEDURE getmailattachfilename		&& Returns the Nth attachment filename. Indexing begins at 0. Returns Nothing on failure
		*==============================================================================
		* Method:            GetMailAttachFileName
		* Purpose:           Returns the Nth attachment filename. Indexing begins at 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail -- a Chilkat Email object.
		*                    tiAttachIndex -- the attachment index.
		* Returns:           The attachment file name.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Returns the Nth attachment filename. Indexing begins at 0.
		**
		** Fixed for version 69: Fixed this method for cases where Q/B encoding was used in an IMAP response.
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, tiAttachIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcAttachmentFileName AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
