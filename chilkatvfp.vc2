	PROCEDURE verifytimestampreply		&& Verifies a timestamp reply received from a timestamp authority (TSA).
		*==============================================================================
		* Method:            VerifyTimeStampReply
		* Purpose:           Verifies a timestamp reply received from a timestamp authority (TSA).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData -- a Chilkat Binary Data object.
		*                    toChilkatCert -- a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.75
		**
		** Verifies a timestamp reply received from a timestamp authority (TSA). 
		** Returns the following possible integer values:
		**
		** -1: The timestampReply does not contain a valid timestamp reply.
		** -2: The timestampReply is a valid timestamp reply, but failed verification using the public key of the tsaCert.
		** 0: Granted and verified.
		** 1: Granted and verified, with mods (see RFC 3161)
		** 2: Rejected.
		** 3: Waiting.
		** 4: Revocation Warning
		** 5: Revocation Notification
		** 
		** If the timestamp reply (timestampReply) is known to be from a trusted source, 
		** then the tsaCert may be empty. 
		** If tsaCert is empty (never loaded with a certificate), 
		** then the verification will use the certificate embedded in the timestamp reply.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterCert, ;
		m.loParkParameterBinData, m.loChilkatCert, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 75
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        liReturn = ;
		        m.loChilkatObject.VerifyTimeStampReply(m.loChilkatBinData, m.loChilkatCert)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterCert, ;
		m.loParkParameterBinData, m.loChilkatCert, m.loChilkatBinData
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE wasredirected_access		&& Access method used to retrieve the Chilkat HTTP WasRedirected roperty.
		*==============================================================================
		* Method:            WasRedirected_Access
		* Purpose:           Access method used to retrieve 
		*                    the WasRedirected property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.WasRedirected
		* Date Added:        01/31/2022
		*==============================================================================
		
		** 
		** Indicates whether the last HTTP request was redirected 
		** (i.e. the redirect was automatically followed). 
		** If FollowRedirects is 0 and the response status code is 301, 302, 303, 307, or 308, 
		** then this property will remain 0 but the FinalRedirectUrl 
		** will contain the redirect URL that was not automatically followed.
		**
		** Fixed for Version 47: This property was not working correctly.
		**
		** Fixed for Version 82: The QuickGetObj and QuickGet methods did not properly 
		** set the property when redirects are automatically followed. 
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE wasredirected_assign		&& Assign method used to hold a reference to the WasRedirected property.
		*==============================================================================
		* Method:            WasRedirected_Assign
		* Purpose:           Assign method used to hold
		*                    the WasRedirected of the referenced Chilkat object.
		* Author:            Bill Anderson
