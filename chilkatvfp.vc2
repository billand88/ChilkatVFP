		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS ssh AS ibasechilkat OF "chilkatvfp.vcx" 		&& A client-side SSH2 implementation for executing commands and shell sessions on Unix/Windows SSH servers.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat SSH AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: authenticatepk		&& Authenticates with the SSH server using public-key authentication. The corresponding public key must have been installed on the SSH server for the username. Authentication will succeed if the matching privateKey is provided.
		*m: authenticatepkasync		&& Creates an asynchronous task to call the AuthenticatePk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authenticatepw		&& Authenticates with the SSH server using a login and password.
		*m: authenticatepwasync		&& Creates an asynchronous task to call the AuthenticatePw method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authenticatepwpk		&& Authentication for SSH servers that require both a password and private key. (Most SSH servers are configured to require one or the other, but not both.)
		*m: authenticatepwpkasync		&& Creates an asynchronous task to call the AuthenticatePwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authenticatesecpw		&& Introduced in version 9.5.0.71. The same as AuthenticatePw, except the login and passwords strings are passed in secure string objects. Returns 1 for success, 0 for failure.
		*m: authenticatesecpwasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the AuthenticateSecPw method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authenticatesecpwpk		&& Introduced in version 9.5.0.71. The same as AuthenticatePwPk, except the login and passwords strings are passed in secure string objects. Returns 1 for success, 0 for failure.
		*m: authenticatesecpwpkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the AuthenticateSecPwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: authfailreason_access		&& Access method used to retrieve the Chilkat SSH AuthFailReason property.
		*m: authfailreason_assign		&& Assign method used to hold a reference to the AuthFailReason property.
		*m: caretcontrol_access		&& Access method used to retrieve the Chilkat SSH CaretControl property.
		*m: caretcontrol_assign		&& Assign method used to hold a reference to the CaretControl property.
		*m: channelisopen		&& Returns 1 if the channel indicated by channelNum is open. Otherwise returns 0.
		*m: channelopenfailcode_access		&& Access method used to retrieve the Chilkat SSH ChannelOpenFailCode property.
		*m: channelopenfailcode_assign		&& Assign method used to hold a reference to the ChannelOpenFailCode property.
		*m: channelopenfailreason_access		&& Access method used to retrieve the Chilkat SSH ChannelOpenFailReason property.
		*m: channelopenfailreason_assign		&& Assign method used to hold a reference to the ChannelOpenFailReason property.
		*m: channelpoll		&& Polls for incoming data on an open channel. This method will read a channel, waiting at most pollTimeoutMs milliseconds for data to arrive. Return values are as follows:
		*m: channelpollasync		&& Creates an asynchronous task to call the ChannelPoll method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelread		&& Reads incoming data on an open channel. This method will read a channel, waiting at most IdleTimeoutMs milliseconds for data to arrive.
		*m: channelreadandpoll		&& Reads incoming data on an open channel and continues reading until no data arrives for pollTimeoutMs milliseconds. The first read will wait a max of IdleTimeoutMs milliseconds before timing out.
		*m: channelreadandpoll2		&& The same as ChannelReadAndPoll, except this method will return as soon as maxNumBytes is exceeded.
		*m: channelreadandpoll2async		&& Creates an asynchronous task to call the ChannelReadAndPoll2 method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelreadandpollasync		&& Creates an asynchronous task to call the ChannelReadAndPoll method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelreadasync		&& Creates an asynchronous task to call the ChannelRead method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelreceivedclose		&& 1 if a CLOSE message has been received on the channel indicated by channelNum. When a CLOSE is received, no subsequent data should be sent in either direction -- the channel is closed in both directions.
		*m: channelreceivedeof		&& 1 if an EOF message has been received on the channel indicated by channelNum. When an EOF is received, no more data will be forthcoming on the channel. However, data may still be sent in the opposite direction.
		*m: channelreceivedexitstatus		&& 1 if an exit status code was received on the channel. Otherwise 0.
		*m: channelreceivetoclose		&& Reads incoming data on an open channel until the channel is closed by the server. If successful, the number of bytes available to be "picked up" can be determined by calling GetReceivedNumBytes.
		*m: channelreceivetocloseasync		&& Creates an asynchronous task to call the ChannelReceiveToClose method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelreceiveuntilmatch		&& Reads incoming text data on an open channel until the received data matches the matchPattern. For example, to receive data until the string "Hello World" arrives, set matchPattern equal to "*Hello World*".
		*m: channelreceiveuntilmatchasync		&& Creates an asynchronous task to call the ChannelReceiveUntilMatch method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelreceiveuntilmatchn		&& The same as ChannelReceiveUntilMatch except that the method returns when any one of the match patterns specified in matchPatterns are received on the channel.
		*m: channelreceiveuntilmatchnasync		&& Creates an asynchronous task to call the ChannelReceiveUntilMatchN method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelrelease		&& Introduced in version 9.5.0.44. Releases the internal memory resources for a channel previously opened by OpenSessionChannel, OpenCustomChannel, or OpenDirectTcpIpChannel.
		*m: channelsendclose		&& Sends a CLOSE message to the server for the channel indicated by channelNum. This closes both directions of the bidirectional channel. Returns 1 for success, 0 for failure.
		*m: channelsendcloseasync		&& Creates an asynchronous task to call the ChannelSendClose method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelsenddata		&& Sends byte data on the channel indicated by channelNum. Returns 1 for success, 0 for failure.
		*m: channelsenddataasync		&& Creates an asynchronous task to call the ChannelSendData method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelsendeof		&& Sends an EOF for the channel indicated by channelNum. Once an EOF is sent, no additional data may be sent on the channel. However, the channel remains open and additional data may still be received from the server. Returns 1 for success, 0 for failure.
		*m: channelsendeofasync		&& Creates an asynchronous task to call the ChannelSendEof method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: channelsendstring		&& Sends character data on the channel indicated by channelNum. The text is converted to the charset indicated by charset prior to being sent. A list of supported charset values may be found on this page: Supported Charsets.
		*m: channelsendstringasync		&& Creates an asynchronous task to call the ChannelSendString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: checkconnection		&& Introduced in version 9.5.0.46. Returns 1 if the underlying TCP socket is connected to the SSH server.
		*m: clearttymodes		&& Clears the collection of TTY modes that are sent with the SendReqPty method.
		*m: clientidentifier_access		&& Access method used to retrieve the Chilkat SSH ClientIdentifier property.
		*m: clientidentifier_assign		&& Assign method used to hold a reference to the ClientIdentifier property.
		*m: clientipaddress_access		&& Access method used to retrieve the Chilkat SSH ClientIPAddress property.
		*m: clientipaddress_assign		&& Assign method used to hold a reference to the ClientIPAddress property.
		*m: clientport_access		&& Access method used to retrieve the Chilkat SSH ClientPort property.
		*m: clientport_assign		&& Assign method used to hold a reference to the ClientPort property.
		*m: connect		&& Connects to the SSH server at domainName:port The domainName may be a domain name or an IPv4 or IPv6 address in string format.
		*m: connectasync		&& Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: connectthroughssh		&& Introduced in version 9.5.0.55. Connects to an SSH server through an existing SSH connection. The ssh is an existing connected and authenticated SSH object. The connection to hostname:port is made through the existing SSH connection via port-forwarding.
		*m: connectthroughsshasync		&& Introduced in version 9.5.0.55. Creates an asynchronous task to call the ConnectThroughSsh method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: connecttimeoutms_access		&& Access method used to retrieve the Chilkat SSH ConnectTimeoutMs property.
		*m: connecttimeoutms_assign		&& Assign method used to hold a reference to the ConnectTimeoutMs property.
		*m: continuekeyboardauth		&& Introduced in version 9.5.0.46. Continues keyboard-interactive authentication with the SSH server.
		*m: continuekeyboardauthasync		&& Introduced in version 9.5.0.46. Creates an asynchronous task to call the ContinueKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SSH DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: disconnect		&& Disconnects from the SSH server.
		*m: disconnectcode_access		&& Access method used to retrieve the Chilkat SSH DisconnectCode property.
		*m: disconnectcode_assign		&& Assign method used to hold a reference to the SSH DisconnectCode property.
		*m: disconnectreason_access		&& Access method used to retrieve the Chilkat SSH DisconnectReason property.
		*m: disconnectreason_assign		&& Assign method used to hold a reference to the SSH DisconnectReason property.
		*m: enablecompression_access		&& Access method used to retrieve the Chilkat SSH EnableCompression property.
		*m: enablecompression_assign		&& Assign method used to hold a reference to the SSH EnableCompression property.
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat SSH EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the SSH EnableSecrets property.
		*m: forcecipher_access		&& Access method used to retrieve the Chilkat SSH ForceCipher property.
		*m: forcecipher_assign		&& Assign method used to hold a reference to the SSH ForceCipher property.
		*m: getauthmethods		&& Introduced in version 9.5.0.78. Queries the SSH server to find out which authentication methods it supports. Returns a string such as "publickey,password,keyboard-interactive". This method should be called after connecting, but prior to authenticating.
		*m: getauthmethodsasync		&& Introduced in version 9.5.0.78. Creates an asynchronous task to call the GetAuthMethods method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getchannelexitstatus		&& Returns the exit status code for a channel. This method should only be called if an exit status has been received. You may check to see if the exit status was received by calling ChannelReceivedExitStatus.
		*m: getchannelnumber		&& Returns the channel number for the Nth open channel. Indexing begins at 0, and the number of currently open channels is indicated by the NumOpenChannels property. Returns -1 if the index is out of range.
		*m: getchanneltype		&& Returns a string describing the channel type for the Nth open channel. Channel types are: "session", "x11", "forwarded-tcpip", and "direct-tcpip". Returns Nothing on failure.
		*m: gethostkeyfp		&& Introduced in version 9.5.0.92. Returns the host key fingerprint of the server, which is automatically set after connecting to an SSH/SFTP server.
		*m: getreceivedbd		&& Introduced in version 11.4.0. Appends the accumulated data received on the channel indicated by channelNum to bd, and clears the channel's internal receive buffer. Returns 1 for success, 0 for failure.
		*m: getreceiveddata		&& Returns the accumulated data received on the channel indicated by channelNum and clears the channel's internal receive buffer. Returns a zero-length byte array (as a Variant) on failure.
		*m: getreceiveddatan		&& Same as GetReceivedData, but a maximum of maxNumBytes bytes is returned. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: getreceivednumbytes		&& Returns the number of bytes available in the internal receive buffer for the specified channelNum. The received data may be retrieved by calling GetReceivedData or GetReceivedText.
		*m: getreceivedsb		&& Introduced in version 11.6.0. Decodes and appends to sb all text currently accumulated in the normal receive buffer for channelNum, using charset. The receive buffer is cleared after the text is returned. Returns 1 for success, 0 for failure.
		*m: getreceivedstderr		&& Introduced in version 9.5.0.48. Returns the accumulated stderr bytes received on the channel indicated by channelNum and clears the channel's internal stderr receive buffer.
		*m: getreceivedstderrtext		&& Returns the accumulated stderr text received on the channel indicated by channelNum and clears the channel's internal receive buffer. The charset indicates the charset of the character data in the internal receive buffer.
		*m: getreceivedtext		&& Returns the accumulated text received on the channel indicated by channelNum and clears the channel's internal receive buffer. The charset indicates the charset of the character data in the internal receive buffer.
		*m: getreceivedtexts		&& The same as GetReceivedText, except only the text up to and including substr is returned. The text returned is removed from the internal receive buffer.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat SSH HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the SSH HeartbeatMs property.
		*m: hostkeyalg_access		&& Access method used to retrieve the Chilkat SSH HostKeyAlg property.
		*m: hostkeyalg_assign		&& Assign method used to hold a reference to the SSH HostKeyAlg property.
		*m: hostkeyfingerprint_access		&& Access method used to retrieve the Chilkat SSH HostKeyFingerpring property.
		*m: hostkeyfingerprint_assign		&& Assign method used to hold a reference to the SSH HostKeyFingerprint property.
		*m: httpproxyauthmethod_access		&& Access method used to retrieve the Chilkat SSH HTTPProxyAuthMethod property.
		*m: httpproxyauthmethod_assign		&& Assign method used to hold a reference to the SSH HTTPProxyAuthMethod property.
		*m: httpproxydomain_access		&& Access method used to retrieve the Chilkat SSH HTTPProxyDomain property.
		*m: httpproxydomain_assign		&& Assign method used to hold a reference to the SSH HTTPProxyDomain property.
		*m: httpproxyhostname_access		&& Access method used to retrieve the Chilkat SSH HTTPProxyHostName property.
		*m: httpproxyhostname_assign		&& Assign method used to hold a reference to the SSH HTTPProxyHostName property.
		*m: httpproxypassword_access		&& Access method used to retrieve the Chilkat SSH HTTPProxyPassword property.
		*m: httpproxypassword_assign		&& Assign method used to hold a reference to the SSH HTTPProxyPassword property.
		*m: httpproxyport_access		&& Access method used to retrieve the Chilkat SSH HTTPProxyPort property.
		*m: httpproxyport_assign		&& Assign method used to hold a reference to the SSH HTTPProxyPort property.
		*m: httpproxyusername_access		&& Access method used to retrieve the Chilkat SSH HTTPUserName property.
		*m: httpproxyusername_assign		&& Assign method used to hold a reference to the SSH HTTPProxyUserName property.
		*m: idletimeoutms_access		&& Access method used to retrieve the Chilkat SSH IdleTimeoutMs property.
		*m: idletimeoutms_assign		&& Assign method used to hold a reference to the SSH IdleTimeout property.
		*m: isconnected_access		&& Access method used to retrieve the Chilkat SSH IsConnected property.
		*m: isconnected_assign		&& Assign method used to hold a reference to the SSH IsConnected property.
		*m: keepsessionlog_access		&& Access method used to retrieve the Chilkat SSH KeepSessionLog property.
		*m: keepsessionlog_assign		&& Assign method used to hold a reference to the SSH KeepSessionLog property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SSH LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the SSH LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat SSH LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the SSH LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat SSH LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the SSH LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat SSH LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the SSH LastErrorXML property.
		*m: lastjsondata		&& Introduced in version 9.5.0.79. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData. Returns Nothing on failure.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SSH LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the SSH LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SSH LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the SSH LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SSH LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the SSH LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: maxpacketsize_access		&& Access method used to retrieve the Chilkat SSH MaxPacketSize property.
		*m: maxpacketsize_assign		&& Assign method used to hold a reference to the SSH MaxPacketSize property.
		*m: numopenchannels_access		&& Access method used to retrieve the Chilkat SSH NumOpenChannels property.
		*m: numopenchannels_assign		&& Assign method used to hold a reference to the SSH NumOpenChannels property.
		*m: opencustomchannel		&& Opens a custom channel with a custom server that uses the SSH protocol. The channelType is application-defined.
		*m: opencustomchannelasync		&& Creates an asynchronous task to call the OpenCustomChannel method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: opendirecttcpipchannel		&& Open a direct-tcpip channel for port forwarding. Data sent on the channel via ChannelSend* methods is sent to the SSH server and then forwarded to targetHostname:targetPort.
		*m: opendirecttcpipchannelasync		&& Creates an asynchronous task to call the OpenDirectTcpIpChannel method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: opensessionchannel		&& Opens a new session channel. Almost everything you will do with the Chilkat SSH component will involve opening a session channel.
		*m: opensessionchannelasync		&& Creates an asynchronous task to call the OpenSessionChannel method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: passwordchangerequested_access		&& Access method used to retrieve the Chilkat SSH PasswordChangeRequested property.
		*m: passwordchangerequested_assign		&& Assign method used to hold a reference to the SSH PasswordChanged property.
		*m: peekreceivedtext		&& This is the same as GetReceivedText, except the internal receive buffer is not cleared. Returns Nothing on failure.
		*m: preferipv6_access		&& Access method used to retrieve the Chilkat SSH PreferIPV6 property.
		*m: preferipv6_assign		&& Assign method used to hold a reference to the SSH PreferIPV6 property.
		*m: quickcmdcheck		&& Introduced in version 9.5.0.65. Returns a channel number for a completed command that was previously sent via QuickCmdSend. Returns -1 if no commands have yet completed.
		*m: quickcmdcheckasync		&& Introduced in version 9.5.0.65. Creates an asynchronous task to call the QuickCmdCheck method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: quickcmdsend		&& Introduced in version 9.5.0.65. Sends a command and returns the channel number for the command that has started. This is the equivalent of calling OpenSessionChannel, followed by SendReqExec. A value of -1 is returned on failure.
		*m: quickcmdsendasync		&& Introduced in version 9.5.0.65. Creates an asynchronous task to call the QuickCmdSend method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: quickcommand		&& Introduced in version 9.5.0.65. Simplified method for executing a remote command and getting the complete output. This is the equivalent of calling OpenSessionChannel, followed by SendReqExec, then ChannelReceiveToClose, and finally GetReceivedText.
		*m: quickcommandasync		&& Introduced in version 9.5.0.65. Creates an asynchronous task to call the QuickCommand method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: quickshell		&& Introduced in version 9.5.0.65. Simplified method for starting a remote shell session. It is the equivalent of calling OpenSessionChannel, followed by SendReqPty, and finally SendReqShell.
		*m: quickshellasync		&& Introduced in version 9.5.0.65. Creates an asynchronous task to call the QuickShell method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: readtimeoutms_access		&& Access method used to retrieve the Chilkat SSH ReadTimeoutMs property.
		*m: readtimeoutms_assign		&& Assign method used to hold a reference to the SSH ReadTimeout property.
		*m: rekey		&& Initiates a re-key with the SSH server. The ReKey method does not return until the key re-exchange is complete.
		*m: rekeyasync		&& Creates an asynchronous task to call the ReKey method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: reqexeccharset_access		&& Access method used to retrieve the Chilkat SSH ReqExecCharset property.
		*m: reqexeccharset_assign		&& Assign method used to hold a reference to the SSH ReqExecCharset property.
		*m: sendignore		&& Sends an IGNORE message to the SSH server. This is one way of verifying that the connection to the SSH server is open and valid. The SSH server does not respond to an IGNORE message. It simply ignores it.
		*m: sendignoreasync		&& Creates an asynchronous task to call the SendIgnore method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqexec		&& Initiates execution of a command on the channel specified by channelNum. The commandLine contains the full command line including any command-line parameters (just as you would type the command at a shell prompt).
		*m: sendreqexecasync		&& Creates an asynchronous task to call the SendReqExec method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqpty		&& Requests a pseudo-terminal for a session channel. If the termType is a character oriented terminal ("vt100" for example), then widthInChars and heightInChars would be set to non-zero values, while widthInPixels and heightInPixels may be set to 0.
		*m: sendreqptyasync		&& Creates an asynchronous task to call the SendReqPty method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqsetenv		&& Sets an environment variable in the remote shell. Returns 1 for success, 0 for failure.
		*m: sendreqsetenvasync		&& Creates an asynchronous task to call the SendReqSetEnv method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqshell		&& Starts a shell on an open session channel. Some SSH servers require that a PTY (pseudo-terminal) first be requested prior to starting a shell. In that case, call SendReqPty prior to calling this method.
		*m: sendreqshellasync		&& Creates an asynchronous task to call the SendReqShell method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqsignal		&& Delivers a signal to the remote process/service. signalName is one of the following: ABRT, ALRM, FPE, HUP, ILL, INT, KILL, PIPE, QUIT, SEGV, TERM, USR1, USR2.
		*m: sendreqsignalasync		&& Creates an asynchronous task to call the SendReqSignal method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqsubsystem		&& Executes a pre-defined subsystem. The SFTP protocol (Secure File Transfer Protocol) is started by the Chilkat SFTP component by starting the "sftp" subsystem. Returns 1 for success, 0 for failure.
		*m: sendreqsubsystemasync		&& Creates an asynchronous task to call the SendReqSubsystem method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqwindowchange		&& When the client-side window (terminal) size changes, this message may be sent to the server to inform it of the new size.
		*m: sendreqwindowchangeasync		&& Creates an asynchronous task to call the SendReqWindowChange method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqx11forwarding		&& Allows the client to send an X11 forwarding request to the server. Chilkat only provides this functionality because it is a message defined in the SSH connection protocol. Chilkat has no advice for when or why it would be needed.
		*m: sendreqx11forwardingasync		&& Creates an asynchronous task to call the SendReqX11Forwarding method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendreqxonxoff		&& This method should be ignored and not used.
		*m: sendreqxonxoffasync		&& Creates an asynchronous task to call the SendReqXonXoff method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: serveridentifier_access		&& Access method used to retrieve the Chilkat SSH ServerIdentifier property.
		*m: serveridentifier_assign		&& Assign method used to hold a reference to the SSH ServerIdentifier property.
		*m: sessionlog_access		&& Access method used to retrieve the Chilkat SSH SessionLog property.
		*m: sessionlog_assign		&& Assign method used to hold a reference to the SSH SessionLog property.
		*m: setallowedalgorithms		&& Introduced in version 9.5.0.99. Provides a way to specific the exact set of algorithms allowed for the connection. Returns 1 for success, 0 for failure.
		*m: setttymode		&& Sets a TTY mode that is included in the SendReqPty method call. Most commonly, it is not necessary to call this method at all. Chilkat has no recommendations or expertise as to why or when a particular mode might be useful.
		*m: sockshostname_access		&& Access method used to retrieve the Chilkat SSH SOCKSHostName property.
		*m: sockshostname_assign		&& Assign method used to hold a reference to the SSH SOCKSHostName property.
		*m: sockspassword_access		&& Access method used to retrieve the Chilkat SSH SOCKSPassword property.
		*m: sockspassword_assign		&& Assign method used to hold a reference to the SSH SOCKSPassword property.
		*m: socksport_access		&& Access method used to retrieve the Chilkat SSH SOCKSPort property.
		*m: socksport_assign		&& Assign method used to hold a reference to the SSH SOCKSPort property.
		*m: socksusername_access		&& Access method used to retrieve the Chilkat SSH SOCKSUserName property.
		*m: socksusername_assign		&& Assign method used to hold a reference to the SSH SOCKSUserName property.
		*m: socksversion_access		&& Access method used to retrieve the Chilkat SSH SOCKSVersion property.
		*m: socksversion_assign		&& Assign method used to hold a reference to the SSH SOCKSVersion property.
		*m: sorcvbuf_access		&& Access method used to retrieve the Chilkat SSH SoRcvBuf property.
		*m: sorcvbuf_assign		&& Assign method used to hold a reference to the SSH SoRcvBuf property.
		*m: sosndbuf_access		&& Access method used to retrieve the Chilkat SSH SoSndBuf property.
		*m: sosndbuf_assign		&& Assign method used to hold a reference to the SSH SoSndBuf property.
		*m: startkeyboardauth		&& Introduced in version 9.5.0.46. Begins keyboard-interactive authentication with the SSH server. Returns an XML string providing the name, instruction, and prompts.
		*m: startkeyboardauthasync		&& Introduced in version 9.5.0.46. Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: stderrtostdout_access		&& Access method used to retrieve the Chilkat SSH StdErrToStdOut property.
		*m: stderrtostdout_assign		&& Assign method used to hold a reference to the SSH StdErrToStdOut property.
		*m: stripcolorcodes_access		&& Access method used to retrieve the Chilkat SSH StripColorCodes property.
		*m: stripcolorcodes_assign		&& Assign method used to hold a reference to the SSH StripColorCodes property.
		*m: tcpnodelay_access		&& Access method used to retrieve the Chilkat SSH TCPNoDelay property.
		*m: tcpnodelay_assign		&& Assign method used to hold a reference to the SSH TCPNoDelay property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat SSH UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the SSH UncommonOptions property.
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: userauthbanner_access		&& Access method used to retrieve the Chilkat SSH UserAuthBanner property.
		*m: userauthbanner_assign		&& Assign method used to hold a reference to the SSH UserAuthBanner property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat SSH VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the SSH VerboseLogging property.
		*m: waitforchannelmessage		&& Introduced in version 9.5.0.48. The pollTimeoutMs is the number of milliseconds to wait. To poll, pass a value of 0 in pollTimeoutMs. Waits for an incoming message on any channel. This includes data, EOF, CLOSE, etc.
		*m: waitforchannelmessageasync		&& Introduced in version 9.5.0.48. Creates an asynchronous task to call the WaitForChannelMessage method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*p: abortcurrent		&& When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: authfailreason		&& Introduced in version 9.5.0.52. Set to one of the following values if a call to AuthenticatePw, AuthenticatePk, or AuthenticatePwPk returns a failed status.
		*p: caretcontrol		&& Introduced in version 9.5.0.49. Controls whether the caret character '^' is interpreted as indicating a control character. The default value of this property is 0.
		*p: channelopenfailcode		&& If a request to open a channel fails, this property contains a code that identifies the reason for failure. The reason codes are defined in RFC 4254 and are reproduced here:
		*p: channelopenfailreason		&& The descriptive text corresponding to the ChannelOpenFailCode property.
		*p: clientidentifier		&& The client-identifier string to be used when connecting to an SSH/SFTP server. Defaults to "SSH-2.0-PuTTY_Release_0.63". (This string is used to mimic PuTTY because some servers are known to disconnect from clients with unknown client identifiers.)
		*p: clientipaddress		&& The IP address to use for computers with multiple network interfaces or IP addresses. For computers with a single network interface (i.e. most computers), this property should not be set.
		*p: clientport		&& Introduced in version 9.5.0.75. Normally left at the default value of 0, in which case a unique port is assigned with a value between 1024 and 5000. This property would only be changed if it is specifically required.
		*p: connecttimeoutms		&& Maximum number of milliseconds to wait when connecting to an SSH server.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: disconnectcode		&& If the SSH server sent a DISCONNECT message when closing the connection, this property contains the "reason code" as specified in RFC 4253:
		*p: disconnectreason		&& If the SSH/ server sent a DISCONNECT message when closing the connection, this property contains a descriptive string for the "reason code" as specified in RFC 4253.
		*p: enablecompression		&& Introduced in version 9.5.0.56. Enables or disables the use of compression w/ the SSH connection. The default value is 1, meaning that compression is used if the server supports it.
		*p: enablesecrets		&& Introduced in version 11.5.0. This property that automatic resolution of credentials from the operating system’s secure storage. The default value is 0.
		*p: forcecipher		&& Set to one of the following encryption algorithms to force that cipher to be used. By default, the component will automatically choose the first cipher supported by the server in the order listed here:
		*p: heartbeatms		&& This is the number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any SSH operation prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: hostkeyalg		&& Indicates the preferred host key algorithm to be used in establishing the SSH secure connection. The default is "DSS". It may be changed to "RSA" if needed. Chilkat recommends not changing this unless a problem warrants the change.
		*p: hostkeyfingerprint		&& Set after connecting to an SSH server. The format of the fingerprint looks like this: "ssh-rsa 1024 68:ff:d1:4e:6c:ff:d7:b0:d6:58:73:85:07:bc:2e:d5"
		*p: httpproxyauthmethod		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy authentication method name. Valid choices are "Basic" or "NTLM".
		*p: httpproxydomain		&& The NTLM authentication domain (optional) if NTLM authentication is used w/ the HTTP proxy.
		*p: httpproxyhostname		&& If an HTTP proxy is to be used, set this property to the HTTP proxy hostname or IPv4 address (in dotted decimal notation).
		*p: httpproxypassword		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy password.
		*p: httpproxyport		&& If an HTTP proxy is to be used, set this property to the HTTP proxy port number. (Two commonly used HTTP proxy ports are 8080 and 3128.)
		*p: httpproxyusername		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy login name.
		*p: idletimeoutms		&& Causes SSH operations to fail when progress for sending or receiving data halts for more than this number of milliseconds. Setting IdleTimeoutMs = 0 (the default) allows the application to wait indefinitely.
		*p: isconnected		&& Returns 1 if the last known state of the connection with the SSH server is "connected". Note: The IsConnected property is set to 1 after successfully completing the Connect method call.
		*p: keepsessionlog		&& Controls whether communications to/from the SSH server are saved to the SessionLog property. The default value is 0. If this property is set to 1, the contents of the SessionLog property will continuously grow as SSH activity transpires.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: maxpacketsize		&& The maximum packet length to be used in the SSH transport protocol. The default value is 8192. Note: If a large amount of data is to be flowing to/from the SSH server, then setting the MaxPacketSize equal to 32768 may improve performance.
		*p: numopenchannels		&& The number of currently open channels.
		*p: passwordchangerequested		&& PasswordChangeRequested As Long (read-only)
		*p: preferipv6		&& If 1, then use IPv6 over IPv4 when both are supported for a particular domain. The default value of this property is 0, which will choose IPv4 over IPv6.
		*p: readtimeoutms		&& The maximum amount of time to allow for reading messages/data from the SSH server. This is different from the IdleTimeoutMs property. The IdleTimeoutMs is the maximum amount of time to wait while no incoming data is arriving.
		*p: reqexeccharset		&& Introduced in version 9.5.0.47. Indicates the charset to be used for the command sent via the SendReqExec method. The default is "ANSI". A likely alternate value would be "utf-8".
		*p: serveridentifier		&& Introduced in version 9.5.0.71. The server-identifier string received from the server during connection establishment. For example, a typical value would be similar to "SSH-2.0-OpenSSH_7.2p2 Ubuntu-4ubuntu2.2".
		*p: sessionlog		&& Contains a log of the messages sent to/from the SSH server. To enable session logging, set the KeepSessionLog property = 1. Note: This property is not a filename -- it is a string property that contains the session log data.
		*p: sockshostname		&& The SOCKS4/SOCKS5 hostname or IPv4 address (in dotted decimal notation). This property is only used if the SocksVersion property is set to 4 or 5).
		*p: sockspassword		&& The SOCKS5 password (if required). The SOCKS4 protocol does not include the use of a password, so this does not apply to SOCKS4.
		*p: socksport		&& The SOCKS4/SOCKS5 proxy port. The default value is 1080. This property only applies if a SOCKS proxy is used (if the SocksVersion property is set to 4 or 5).
		*p: socksusername		&& The SOCKS4/SOCKS5 proxy username. This property is only used if the SocksVersion property is set to 4 or 5).
		*p: socksversion		&& SocksVersion May be set to one of the following integer values: 0 - No SOCKS proxy is used. This is the default. 4 - Connect via a SOCKS4 proxy. 5 - Connect via a SOCKS5 proxy.
		*p: sorcvbuf		&& Sets the receive buffer size socket option. Normally, this property should be left unchanged. The default value is 4194304. This property can be increased if download performance seems slow. It is recommended to be a multiple of 4096.
		*p: sosndbuf		&& Sets the send buffer size socket option. Normally, this property should be left unchanged. The default value is 262144. This property can be increased if upload performance seems slow. It is recommended to be a multiple of 4096.
		*p: stderrtostdout		&& If 1, then stderr is redirected to stdout. In this case, channel output for both stdout and stderr is combined and retrievable via the following methods: GetReceivedData, GetReceivedDataN, GetReceivedText, GetReceivedTextS.
		*p: stripcolorcodes		&& Introduced in version 9.5.0.67. If 1, then terminal color codes are stripped from the received text. The default value of this property is 1. (Color codes are non-printable escape sequences that provide information about color for text in a terminal.)
		*p: tcpnodelay		&& Controls whether the TCP_NODELAY socket option is used for the underlying TCP/IP socket. The default value is 1. This disables the Nagle algorithm and allows for better performance when small amounts of data are sent to/from the SSH server.
		*p: uncommonoptions		&& Introduced in version 9.5.0.73. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: userauthbanner		&& Introduced in version 9.5.0.46. If a user authentication banner message is received during authentication, it will be made available here. An application can check to see if this property contains a banner string after calling StartKeyboardAuth.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		authfailreason = 0
		caretcontrol = 0
		cchilkatclass = Ssh
		ceventhandlerclass = iBaseEventHandler
		channelopenfailcode = 
		channelopenfailreason = 
		clientidentifier = SSH-2.0-PuTTY_Release_0.63
		clientipaddress = 
		clientport = 0
		connecttimeoutms = 0
		debuglogfilepath = 
		disconnectcode = 0
		disconnectreason = 
		enablecompression = 1
		enablesecrets = 0
		forcecipher = 
		heartbeatms = 0
		hostkeyalg = DSS
		hostkeyfingerprint = 
		httpproxyauthmethod = 
		httpproxydomain = 
		httpproxyhostname = 
		httpproxypassword = 
		httpproxyport = 0
		httpproxyusername = 
		idletimeoutms = 30000
		isconnected = 0
		keepsessionlog = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		maxpacketsize = 8192
		Name = "ssh"
		numopenchannels = 0
		passwordchangerequested = 0
		preferipv6 = 0
		readtimeoutms = 0
		reqexeccharset = ANSI
		serveridentifier = 
		sessionlog = 
		sockshostname = 
		sockspassword = 
		socksport = 1080
		socksusername = 
		socksversion = 0
		sorcvbuf = 4194304
		sosndbuf = 262144
		stderrtostdout = 1
		stripcolorcodes = 1
