	HIDDEN PROCEDURE tlspref_access		&& Access method used to retrieve the Chilkat DNS TLSPref property.
		*==============================================================================
		* Method:            TLSPref_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DNS TLSPref property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.TLSPref
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Specifies the TLS preference. Possible values are:
		** 
		** 0 = No TLS
		** 1 = Prefer TLS if possible.
		** 2 = Require TLS
		** The default value is 0. If TLS is preferred then DNS nameservers with TLS capability will be tried first. 
		** If none succeed, then UDP/TCP will be tried. If TLS is required, then only TLS capable nameservers 
		** will be tried and all DNS queries will use TLS.
		** 
		** Note: To use TLS, your application needs to first specify nameservers by calling AddNameserver 
		** once per nameserver with the supportsTls argument set to 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 96
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE tlspref_assign		&& Assign method used to hold a reference to the TLSPref property.
		*==============================================================================
		* Method:            TLSPref_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat DNS TLSPref property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the TLSPref property.
		* Returns:           
		* Date Added:        10/30/2023
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 96
		
		lcValidationMethod = [TLSPref]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat DNS UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the UncommonOptions property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        04/09/2026
		*==============================================================================
		
		** 
		** Introduced in version 11.4.0
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 4
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncomonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the UncommonOptions of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the last error message in text format.
		* Returns:           
		* Date Added:        04/09/2026
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 4
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat DNS VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        10/30/2023
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 96
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        10/30/2023
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 96
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS dsa AS ibasechilkat OF "chilkatvfp.vcx" 		&& The Digital Signature Algorithm (DSA) is a United States Federal Government standard or FIPS for digital signatures. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat DSA DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: fromder		&& Loads a DSA private key from in-memory DSA DER-encoded bytes. Returns 1 for success, 0 for failure.
		*m: fromderbd		&& Introduced in version 11.0.0. Loads a DSA private key from DER contained in bd. Returns 1 for success, 0 for failure.
		*m: fromderfile		&& Loads a DSA private key from in-memory DSA DER-encoded bytes. Returns 1 for success, 0 for failure.
		*m: fromencryptedpem		&& Loads a DSA private key from an in-memory encrypted PEM-formatted string. If the PEM passed to this method is unencrypted, the password is ignored and the PEM is simply loaded. Returns 1 for success, 0 for failure.
		*m: frompem		&& Loads a DSA private key from an in-memory unencrypted PEM-formatted string. Returns 1 for success, 0 for failure.
		*m: frompublicder		&& Loads a DSA public key from an in-memory DER-encoded byte array. Returns 1 for success, 0 for failure.
		*m: frompublicderbd		&& Introduced in version 11.0.0. Loads a DSA public key from an DER-encoded data in bd. Returns 1 for success, 0 for failure.
		*m: frompublicderfile		&& Loads a DSA public key from a DER-encoded file. Returns 1 for success, 0 for failure.
		*m: frompublicpem		&& Loads a DSA public-key from an in-memory PEM string. Returns 1 for success, 0 for failure.
		*m: fromxml		&& Loads a DSA public or private key from an in-memory XML string. Returns 1 for success, 0 for failure.
		*m: genkey		&& Generates a new DSA key that is numBits bits in length. The numBits should be at least 1024 bits and a multiple of 64. Typical values are 1024 and 2048. The newly generated key may be exported by calling one of the To* methods.
		*m: genkey2		&& Introduced in version 9.5.0.90. Generates a new DSA key that is keyLenBits bits in length with a modulus of size modLenBits bits.
		*m: genkeyfromparamsder		&& Generates a new DSA key from in-memory DER parameters created by OpenSSL. The newly generated key may be exported by calling one of the To* methods. Returns 1 for success, 0 for failure.
		*m: genkeyfromparamsderbd		&& Introduced in version 11.0.0. Generates a new DSA key using the binary OpenSSL formatted DER parameters in bd. The key can be exported using any of the To* methods. Returns 1 for success, 0 for failure.
		*m: genkeyfromparamsderfile		&& Generates a new DSA key from a DER-format parameters file created by OpenSSL.
		*m: genkeyfromparamspem		&& Generates a new DSA key from parameters (PEM formatted string) created by OpenSSL. The newly generated key may be exported by calling one of the To* methods. Returns 1 for success, 0 for failure.
		*m: genkeyfromparamspemfile		&& Generates a new DSA key from a PEM parameters file created by OpenSSL.
		*m: genkeyfrompqg		&& Introduced in version 9.5.0.90. Generates a new DSA key from pre-chosen P, Q, and G params. Returns 1 for success, 0 for failure.
		*m: getencodedhash		&& Returns the bytes of the Hash property as a hex or base64 encoded string. The encoding should be set to either "hex" or "base64". Returns Nothing on failure
		*m: getencodedsignature		&& Returns the bytes of the Signature property as a hex or base64 encoded string. The encoding should be set to either "hex" or "base64". The Signature property is set when SignHash is called. Returns Nothing on failure.
		*m: groupsize_access		&& Access method used to retrieve the Chilkat DSA GroupSize property.
		*m: groupsize_assign		&& Assign method used to hold a reference to the GroupSize property.
		*m: hash_access		&& Access method used to retrieve the Chilkat DSA Hash property.
		*m: hash_assign		&& Assign method used to hold a reference to the Hash property.
		*m: hexg_access		&& Access method used to retrieve the Chilkat DSA HexG property.
		*m: hexg_assign		&& Assign method used to hold a reference to the HexG property.
		*m: hexp_access		&& Access method used to retrieve the Chilkat DSA HexP property.
		*m: hexp_assign		&& Assign method used to hold a reference to the HexP property.
		*m: hexq_access		&& Access method used to retrieve the Chilkat DSA HexQ property.
		*m: hexq_assign		&& Assign method used to hold a reference to the HexQ property.
		*m: hexx_access		&& Access method used to retrieve the Chilkat DSA HexX property.
		*m: hexx_assign		&& Assign method used to hold a reference to the HexX property.
		*m: hexy_access		&& Access method used to retrieve the Chilkat DSA HexY property.
		*m: hexy_assign		&& Assign method used to hold a reference to the HexY property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat DSA LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat DSA LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat DSA LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat DSA LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat DSA LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat DSA LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat DSA LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtext		&& Convenience method to load the entire contents of a text file into a string. It is assumed that the text contains ANSI encoded character data. Returns Nothing on failure.
		*m: savetext		&& Convenience method to save a string to a text file. The text is saved using the ANSI character encoding. Returns 1 for success, 0 for failure.
		*m: setencodedhash		&& Provides a way to set the Hash property by passing an encoded string. The encoding can be "hex" or "base64". The encodedHash contains the encoded bytes of the hash that will be signed or verified via the SignHash and Verify methods.
		*m: setencodedsignature		&& Sets the bytes of the Signature property. (The signature must be specified prior to calling the Verify method.) This method allows for the signature to be set via a hex or base64 encoded string. The encoding should be set to either "hex" or "base64".
		*m: setencodedsignaturers		&& Sets the bytes of the Signature property by providing the R and S values in encoded form. (The signature must be specified prior to calling the Verify method.) The R and S values may be set via a hex or base64 encoded string.
		*m: setkeyexplicit		&& Sets the DSA object's private key from explicitly provided pHex, qHex, gHex, and xHex values. The groupSizeInBytes specifies the group size (in bytes). It is typically equal to 20, which is the length of the underlying hash function (SHA-1) for signing.
		*m: setpubkeyexplicit		&& Sets the DSA object's public key from explicitly provided pHex, qHex, gHex, and yHex values. The groupSizeInBytes specifies the group size (in bytes). It is typically equal to 20, which is the length of the underlying hash function (SHA-1) for signing.
		*m: signature_access		&& Access method used to retrieve the Chilkat DSA Signature property.
		*m: signature_assign		&& Assign method used to hold a reference to the Signature property.
		*m: signhash		&& Signs a hash using the digital signature algorithm. Before calling this method, set the hash to be signed by either calling SetEncodedHash or by setting the Hash property.
		*m: toder		&& Writes the DSA private key to a DER-encoded byte array. Returns a zero-length byte array (as a Variant) on failure.
		*m: toderbd		&& Introduced in version 11.0.0. Writes the DSA private key to DER-encoded bytes in the bd. Returns 1 for success, 0 for failure.
		*m: toderfile		&& Writes the DSA private key to a DER-format file.
		*m: toencryptedpem		&& Writes the DSA private key to an in-memory encrypted PEM string. Returns Nothing on failure.
		*m: topem		&& Writes the DSA private key to an in-memory PEM string. Returns Nothing on failure.
		*m: topublicder		&& Writes the DSA public key to a DER-encoded byte array. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: topublicderbd		&& Introduced in version 11.0.0. Writes the DSA public key to a DER-encoded bytes in bd. Returns 1 for success, 0 for failure.
		*m: topublicderfile		&& Writes the DSA public key to a DER-format file. Returns 1 for success, 0 for failure.
		*m: topublicpem		&& Writes the DSA public key to an in-memory PEM string. Returns Nothing on failure
		*m: toxml		&& Writes the DSA private or public key to an in-memory XML string. The bPublicOnly determines whether the public or private key is written. Returns Nothing on failure.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat DSA UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat DSA VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verify		&& Verifies a DSA signature. The Hash and Signature properties must be set prior to calling this method. (These properties may also be set via the SetEncodedHash and SetEncodedSignature methods.) Returns 1 for success, 0 for failure.
		*m: verifykey		&& Verifies that the public or private key contained in the calling Dsa object is valid. Returns 1 if valid, otherwise returns 0.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: groupsize		&& The group size (in bits) to be used in DSA key generation. The default value is 160 and corresponds to the fact that SHA-1 is used in signature generation. This property setting should not be changed.
		*p: hash		&& The hash to be signed or verified via the SignHash and Verify methods. In both cases, the Hash should be set prior to calling SignHash or Verify. This property may also be set via the SetEncodedHash method.
		*p: hexg		&& The "G" part of a public or private DSA key returned as a hex-encoded SSH1-format bignum. The "G" is the generator. DSA key params consist of G, P, and Q.
		*p: hexp		&& The "P" part of a public or private DSA key returned as a hex-encoded SSH1-format bignum. The "P" is a large prime. DSA key params consist of G, P, and Q.
		*p: hexq		&& The "Q" part of a public or private DSA key returned as a hex-encoded SSH1-format bignum. DSA key params consist of G, P, and Q.
		*p: hexx		&& The "X" part of a DSA private key returned as a hex-encoded SSH1-format bignum.
		*p: hexy		&& The "Y" part of a DSA public key returned as a hex-encoded SSH1-format bignum. (The "Y" value is also accessible w/ a private key, but the "X" value is not available in a DSA public key.)
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: signature		&& The signature created by calling SignHash. If verifying a signature, this may be set prior to calling the Verify method.
		*p: uncommonoptions		&& Introduced in version 9.5.0.90. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Dsa
		debuglogfilepath = 
		groupsize = 160
		hash = .NULL.
		hexg = 
		hexp = 
		hexq = 
		hexx = 
		hexy = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "dsa"
		signature = .NULL.
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/07/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Removed the UnlockComponent method.
		
		  Added the FromDerBd, FromPublicDerBd, ToDerBd and ToPublicDerBd methods.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 40
		
		  Fix relating to DSA signature verification internal to PKCS7.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat DSA DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DSA DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/22/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

