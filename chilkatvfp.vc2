		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		
		la_IntroducedInBuild(1) = 10
		la_IntroducedInBuild(2) = 0
		la_IntroducedInBuild(3) = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(@m.la_IntroducedInBuild)
		
		  ** Method implemented test
