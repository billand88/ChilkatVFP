	ENDPROC

	HIDDEN PROCEDURE xmlcharset_access		&& Access method used to retrieve the Chilkat HTMLToXML XMLCharset property.
		*==============================================================================
		* Method:            XMLCharset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XMLCharsetToXML XMLCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.XMLCharset
		* Date Added:        06/13/2022
		*==============================================================================
		
		** 
		** The charset, such as "utf-8" or "iso-8859-1" of the XML to be created. 
		** If XmlCharset is empty, the XML is created in the same character encoding as the HTML. 
		** Otherwise the HTML is converted XML and converted to this charset.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE xmlcharset_assign		&& Assign method used to hold a reference to the XMLCharset property.
		*==============================================================================
		* Method:            XMLCharset_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat XMLCharsetToText XMLCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the XMLCharset property.
		* Returns:           
		* Date Added:        06/13/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS http AS ibasechilkat OF "chilkatvfp.vcx" 		&& Class for sending HTTP requests and receiving server responses.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat HTTP AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: acceptcharset_access		&& Access method used to retrieve the Chilkat HTTP AcceptCharset property.
		*m: acceptcharset_assign		&& Assign method used to hold a reference to the AcceptCharset property.
		*m: acceptlanguage_access		&& Access method used to retrieve the Chilkat HTTP AcceptLanguage property.
		*m: acceptlanguage_assign		&& Assign method used to hold a reference to the AcceptLanguage property.
		*m: accept_access		&& Access method used to retrieve the Chilkat HTTP Accept property.
		*m: accept_assign		&& Assign method used to hold a reference to the Accept property.
		*m: addcacheroot		&& This method must be called at least once if disk caching is to be used. The file path (including drive letter) such as "E:\MyHttpCache\" is passed to AddCacheRoot to specify the root directory.
		*m: allowgzip_access		&& Access method used to retrieve the Chilkat HTTP AllowGZip property.
		*m: allowgzip_assign		&& Assign method used to hold a reference to the AllowGZip property.
		*m: allowheaderfolding_access		&& Access method used to retrieve the Chilkat HTTP AllowHeaderFolding property.
		*m: allowheaderfolding_assign		&& Assign method used to hold a reference to the AllowHeaderFolding property.
		*m: authsignature_access		&& Access method used to retrieve the Chilkat HTTP AuthSignature property.
		*m: authsignature_assign		&& Assign method used to hold a reference to the AuthSignature property.
		*m: authtoken_access		&& Access method used to retrieve the Chilkat HTTP AuthToken property.
		*m: authtoken_assign		&& Assign method used to hold a reference to the AuthToken property.
		*m: autoaddhostheader_access		&& Access method used to retrieve the Chilkat HTTP AutoAddHostHeader property.
		*m: autoaddhostheader_assign		&& Assign method used to hold a reference to the AuthHostHeader property.
		*m: awsaccesskey_access		&& Access method used to retrieve the Chilkat HTTP AWSAccess property.
		*m: awsaccesskey_assign		&& Assign method used to hold a reference to the AWSAccess property.
		*m: awsendpoint_access		&& Access method used to retrieve the Chilkat HTTP AWSEndPoint property.
		*m: awsendpoint_assign		&& Assign method used to hold a reference to the AWSEndpoint property.
		*m: awsregion_access		&& Access method used to retrieve the Chilkat HTTP AWSRegion property.
		*m: awsregion_assign		&& Assign method used to hold a reference to the AWSRegion property.
		*m: awssecretkey_access		&& Access method used to retrieve the Chilkat HTTP AWSSecretKey property.
		*m: awssecretkey_assign		&& Assign method used to hold a reference to the AWSSecretKey property.
		*m: awssessiontoken_access		&& Access method used to retrieve the Chilkat HTTP AWSSessionToken property.
		*m: awssessiontoken_assign		&& Assign method used to hold a reference to the AWSSessionToken property.
		*m: awssignatureversion_access		&& Access method used to retrieve the Chilkat HTTP AWSSignatureVersion property.
		*m: awssignatureversion_assign		&& Assign method used to hold a reference to the AWSSignatureVersion property.
		*m: awssubresources_access		&& Access method used to retrieve the Chilkat HTTP AWSSubResources property.
		*m: awssubresources_assign		&& Assign method used to hold a reference to the AWSSubResources property.
		*m: bandwidththrottledown_access		&& Access method used to retrieve the Chilkat HTTP BandwidthThrottleDown property.
		*m: bandwidththrottledown_assign		&& Assign method used to hold a reference to the BandwidthThrottleDown property.
		*m: bandwidththrottleup_access		&& Access method used to retrieve the Chilkat HTTP BandwidthThrottleUp property.
		*m: bandwidththrottleup_assign		&& Assign method used to hold a reference to the BandwidthThrottleUp property.
		*m: basicauth_access		&& Access method used to retrieve the Chilkat HTTP BasicAuth property.
		*m: basicauth_assign		&& Assign method used to hold a reference to the BasicAuth property.
		*m: bglasterrortext_access		&& Access method used to retrieve the Chilkat HTTP BgLastErrorText property.
		*m: bglasterrortext_assign		&& Assign method used to hold a reference to the BgLastErrorText property.
		*m: bgpercentdone_access		&& Access method used to retrieve the Chilkat HTTP BgPercentDone property.
		*m: bgpercentdone_assign		&& Assign method used to hold a reference to the BgPercentDone property.
		*m: bgresponseobject		&& Undocumented method! If a backgrounded method returns an Http response object, it may be retrieved by calling this method. The caller is responsible for deleting the object returned by this method.
		*m: bgresultdata_access		&& Access method used to retrieve the Chilkat HTTP BgResultData property.
		*m: bgresultdata_assign		&& Assign method used to hold a reference to the BgResultData property.
		*m: bgresultint_access		&& Access method used to retrieve the Chilkat HTTP BgResultInt property.
		*m: bgresultint_assign		&& Assign method used to hold a reference to the BgResultInt property.
