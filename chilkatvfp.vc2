	HIDDEN PROCEDURE immediatedelete_access		&& Access method used to retrieve the Chilkat MailMan ImmediateDelete property.
		*==============================================================================
		* Method:            ImmediateDelete_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan ImmediateDelete property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ImmediateDelete
		* Date Added:        01/07/2022
		*==============================================================================
		
		**
		** If 1 (the default) then any method that deletes an email from the POP3 server 
		** will also issue a QUIT command to close the session to ensure the message is deleted immediately.
		**
		** The POP3 protocol is such that the DELE command marks a message for deletion. 
		** It is not actually deleted until the QUIT command is sent and the session is closed. 
		** If ImmediateDelete is 1, then any Chilkat MailMan method that marks a message 
		** (or messages) for deletion will also followup with a QUIT command and close the session. 
		** If your program sets ImmediateDelete to 0, it must make sure to call Pop3EndSession 
		** to ensure that messages marked for deletion are actually deleted.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE immediatedelete_assign		&& Assign method used to hold a reference to the ImmediateDelete property.
