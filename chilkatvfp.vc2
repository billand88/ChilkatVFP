	PROCEDURE fetchmsgset		&& Introduced in version 11.0.0. Downloads messages or their headers from the IMAP server based on the given arguments. If headersOnly is 1, only the message headers specified by msgSet are downloaded. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FetchMsgSet
		* Purpose:           Downloads messages or their headers 
		*                    from the IMAP server based on the given arguments. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuHeaderOnly -- whether or not to download just the header.
		*                    toMessageSet -- a Chilkat MessageSet object.
		*                    toChilkatEmailBundle -- a Chilkat EmailBundle object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Downloads messages or their headers from the IMAP server based on the given arguments. 
		** If headersOnly is 1, only the message headers specified by msgSet are downloaded. 
		** The retrieved messages are then stored in bundle.
		** 
		** Note: Downloaded emails are appended to bundle. 
		** (bundle is not cleared prior to downloading email.)
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuHeaderOnly AS Unknown, toChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, ;
		toChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liHeaderOnly AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterMessageSet AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterEMailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL, llImplemented AS Logical, ;
		loChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn, m.liHeaderOnly
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEmailBundle, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liHeaderOnly = .LogicalToBit(m.tuHeaderOnly)
		
		      loParkParameterMessageSet = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		      loChilkatMessageSet = m.loParkParameterMessageSet.GetObject()
		
		      loParkParameterEMailBundle = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmailBundle)
		
		      loChilkatEmailBundle = m.loParkParameterEMailBundle.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FetchMsgSet(m.liHeaderOnly, ;
		        m.loChilkatMessageSet, m.loChilkatEmailBundle) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatMessageSet = m.loParkParameterMessageSet.SetObject(;
		      m.toChilkatMessageSet, m.loChilkatMessageSet)
		
		      toChilkatEmailBundle = m.loParkParameterEMailBundle.SetObject(;
		      m.toChilkatEmailBundle, m.loChilkatEmailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet, ;
		m.loParkParameterEMailBundle, m.loChilkatEmailBundle
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMessageSet  = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loParkParameterMessageSet = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  toChilkatEmailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterEMailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

