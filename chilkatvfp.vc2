	HIDDEN PROCEDURE clientipaddress_access		&& Access method used to retrieve the Chilkat HTTP ClientIPAddress property.
		*==============================================================================
		* Method:            ClientIPAddress_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP ClientIPAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ClientIPAddress
		* Date Added:        01/27/2022
		*==============================================================================
		
		** 
		** The IP address to use for computers with multiple network interfaces or IP addresses. 
		** For computers with a single network interface (i.e. most computers), 
		** this property should not be set. 
		** For multihoming computers, the default IP address is 
		** automatically used if this property is not set.
		**
		** The IP address is a string such as in dotted notation using numbers, 
		** not domain names, such as "165.164.55.124".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE clientipaddress_assign		&& Assign method used to hold a reference to the ClientIPAddress property.
		*==============================================================================
		* Method:            ClientIPAddress_Assign
		* Purpose:           Assign method used to hold a reference to the ClientIPAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ClientIPAddress property.
		* Returns:           
		* Date Added:        01/27/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE closeallconnections		&& Closes all connections still open from previous HTTP requests.
		*==============================================================================
		* Method:            CloseAllConnections
		* Purpose:           Closes all connections still open from previous HTTP requests.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** Closes all connections still open from previous HTTP requests.
		**
		** An HTTP object instance will maintain up to 10 connections. 
		** If the HTTP server's response does not include a "Connection: Close" header, 
		** the connection will remain open and will be re-used if possible 
		** for the next HTTP request to the same hostname:port. 
		** (It uses the IP address (in string form) or the domain name, 
		** whichever is used in the URL provided by the application.) 
		** If 10 connections are already open and another is needed, 
		** the object will close the least recently used connection.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CloseAllConnections() ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE closeallconnectionsasync		&& Creates an asynchronous task to call the CloseAllConnections method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            CloseAllConnectionsAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    CloseAllConnections method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        01/31/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the CloseAllConnections method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integr, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.CloseAllConnectionsAsync()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE connectfailreason_access		&& Access method used to retrieve the Chilkat HTTP ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP ConnectFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectFailReason
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** This property will be set to the status of the last connection made 
		** (or failed to be made) by any method.
		**
		** Possible values are:
		** 
		** 0 = success
		** 
		** Normal (non-TLS) sockets:
		** 1 = empty hostname
		** 2 = DNS lookup failed
		** 3 = DNS timeout
		** 4 = Aborted by application.
		** 5 = Internal failure.
		** 6 = Connect Timed Out
		** 7 = Connect Rejected (or failed for some other reason)
		** 50 = HTTP proxy authentication failure.
		** 98 = Async operation in progress.
		** 99 = Product is not unlocked.
		** 
		** SSL/TLS:
		** 100 = TLS internal error.
		** 101 = Failed to send client hello.
		** 102 = Unexpected handshake message.
		** 103 = Failed to read server hello.
		** 104 = No server certificate.
		** 105 = Unexpected TLS protocol version.
		** 106 = Server certificate verify failed 
		** (the server certificate is expired or the cert's signature verification failed).
		** 107 = Unacceptable TLS protocol version.
		** 109 = Failed to read handshake messages.
		** 110 = Failed to send client certificate handshake message.
		** 111 = Failed to send client key exchange handshake message.
		** 112 = Client certificate's private key not accessible.
		** 113 = Failed to send client cert verify handshake message.
		** 114 = Failed to send change cipher spec handshake message.
		** 115 = Failed to send finished handshake message.
		** 116 = Server's Finished message is invalid.
		** 125 = TLS Pin Set Mismatch. (Added in version 78)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Assign
		* Purpose:           Assign method used to hold 
		*                    the ConnectFailReason property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ConnectFailReason property.
		* Returns:           
		* Date Added:        01/27/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 56
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE connection_access		&& Access method used to retrieve the Chilkat HTTP Connection property.
		*==============================================================================
		* Method:            Connection_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP Connection property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Connection
		* Date Added:        01/27/2022
		*==============================================================================
		
		** 
		** The Connection header field to be automatically 
		** included with GET requests issued by QuickGet or QuickGetStr. 
		** The default value is "Keep-Alive". 
		** To prevent the Connection header from being added to the HTTP header, 
		** set this property to the empty string.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connection_assign		&& Assign method used to hold a reference to the Connection property.
		*==============================================================================
