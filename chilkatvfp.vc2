	HIDDEN PROCEDURE connecttimeoutms_access		&& Access method used to retrieve the Chilkat SSH ConnectTimeoutMs property.
		*==============================================================================
		* Method:            ConnectTimeoutMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH ConnectTimeoutMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectTimeoutMs
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Maximum number of milliseconds to wait when connecting to an SSH server.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connecttimeoutms_assign		&& Assign method used to hold a reference to the ConnectTimeoutMs property.
		*==============================================================================
		* Method:            ConnectTimeoutMs_Assign
		* Purpose:           Assign method used to hold a reference to the ConnectTimeoutMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the ConnectTimeoutMs property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE continuekeyboardauth		&& Introduced in version 9.5.0.46. Continues keyboard-interactive authentication with the SSH server.
		*==============================================================================
		* Method:            ContinueKeyboardAuth
		* Purpose:           Continues keyboard-interactive authentication with the SSH server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcResponse -- the server response.
		* Returns:           Character
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		**
		** Continues keyboard-interactive authentication with the SSH server. 
		** The response is typically the password. If multiple responses are required 
		** (because there were multiple prompts in the infoRequest XML returned by StartKeyboardAuth), 
		** then the response should be formatted as XML (as shown below) 
		** otherwise the response simply contains the single response string.
		** 
		** <response>
		**     <response1>response to first prompt</response1>
		**     <response2>response to second prompt</response2>
		**     ...
		**     <responseN>response to Nth prompt</responseN>
		** </response>
		** If the interactive authentication completed with success or failure, the XML response will be:
		** 
		** <success>success_message</success>
		** 
		** or
		** 
		** <error>error_message</error>
		**
		** If additional steps are required to complete the interactive authentication, 
		** then an XML string that provides the name, instruction, and prompts is returned. 
		** The XML has the following format:
		** 
		**    <infoRequest numPrompts="N">
		**       <name>name_string</name>
		**       <instruction>instruction_string</instruction>
		**       <prompt1 echo="1_or_0">prompt_string</prompt1>
		**       ...
		**       <promptN echo="1_or_0">prompt_string</promptN>
		**   </infoRequest>
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcResponse AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		lcPostResponse AS Character, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcPostResponse = []
		llImplemented = .F.
		liIntroducedInBuild = 46
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcPostResponse = m.loChilkatObject.ContinueKeyboardAuth(m.tcResponse)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcPostResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

