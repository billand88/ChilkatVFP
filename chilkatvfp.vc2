		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS oauth1 AS ibasechilkat OF "chilkatvfp.vcx" 		&& OAuth 1.0a signature generator.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addparam		&& Introduced in version 9.5.0.53. Adds an extra name/value parameter to the OAuth1 signature. Returns 1 for success, 0 for failure.
		*m: authorizationheader_access		&& Access method used to retrieve the Chilkat OAuth1 AuthorizationHeader property.
		*m: authorizationheader_assign		&& Assign method used to hold the Chilkat OAuth1 AuthorizationHeader property.
		*m: basestring_access		&& Access method used to retrieve the Chilkat OAuth1 BaseString property.
		*m: basestring_assign		&& Assign method used to hold the Chilkat OAuth1 BaseString property.
		*m: consumerkey_access		&& Access method used to retrieve the Chilkat OAuth1 ConsumerKey property.
		*m: consumerkey_assign		&& Assign method used to hold the Chilkat OAuth1 ConsumerKey property.
		*m: consumersecret_access		&& Access method used to retrieve the Chilkat OAuth1 ConsumerSecret property.
		*m: consumersecret_assign		&& Assign method used to hold the Chilkat OAuth1 ConsumerSecret property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat OAuth1 DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold the Chilkat OAuth1 DebugLogFilePath property.
		*m: encodedsignature_access		&& Access method used to retrieve the Chilkat OAuth1 EncodedSignature property.
		*m: encodedsignature_assign		&& Assign method used to hold the Chilkat OAuth1 EncodedSignature property.
		*m: generate		&& Introduced in version 9.5.0.53. Generate the signature based on the property settings. Input properties are OauthVersion, OauthMethod, Url, ConsumerKey, ConsumerSecret, Token, TokenSecret, Nonce, and Timestamp.
		*m: generatedurl_access		&& Access method used to retrieve the Chilkat OAuth1 GeneratedURL property.
		*m: generatedurl_assign		&& Assign method used to hold the Chilkat OAuth1 GeneratedURL property.
		*m: gennonce		&& Introduced in version 9.5.0.55. Generates a random nonce numBytes in length and sets the Nonce property to the hex encoded value. Returns 1 for success, 0 for failure.
		*m: gentimestamp		&& Introduced in version 9.5.0.55. Sets the Timestamp property to the current date/time. Returns 1 for success, 0 for failure.
		*m: hmackey_access		&& Access method used to retrieve the Chilkat OAuth1 HMACKey property.
		*m: hmackey_assign		&& Assign method used to hold the Chilkat OAuth1 HMACKey property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat OAuth1 LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold the Chilkat OAuth1 LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat OAuth1 LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold the Chilkat OAuth1 LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat OAuth1 LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold the Chilkat OAuth1 LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat OAuth1 LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold the Chilkat OAuth1 LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat OAuth1 LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold the Chilkat OAuth1 LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat OAuth1 LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold the Chilkat OAuth1 LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat OAuth1 LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold the Chilkat OAuth1 LastStringResult property.
		*m: nonce_access		&& Access method used to retrieve the Chilkat OAuth1 Nonce property.
		*m: nonce_assign		&& Assign method used to hold the Chilkat OAuth1 Nonce property.
		*m: oauthmethod_access		&& Access method used to retrieve the Chilkat OAuth1 OAuthMethod property.
		*m: oauthmethod_assign		&& Assign method used to hold the Chilkat OAuth1 OAuthMethod property.
		*m: oauthurl_access		&& Access method used to retrieve the Chilkat OAuth1 OAuthURL property.
		*m: oauthurl_assign		&& Assign method used to hold the Chilkat OAuth1 OAuthURL property.
		*m: oauthversion_access		&& Access method used to retrieve the Chilkat OAuth1 OAuthVersion property.
		*m: oauthversion_assign		&& Assign method used to hold the Chilkat OAuth1 OAuthVersion property.
		*m: querystring_access		&& Access method used to retrieve the Chilkat OAuth1 QueryString property.
		*m: querystring_assign		&& Assign method used to hold the Chilkat OAuth1 QueryString property.
		*m: realm_access		&& Access method used to retrieve the Chilkat OAuth1 Realm property.
		*m: realm_assign		&& Assign method used to hold the Chilkat OAuth1 Realm property.
		*m: removeparam		&& Introduced in version 9.5.0.53. Removes a name/value parameter from the OAuth1 signature. Returns 1 for success, 0 for failure.
		*m: setrsakey		&& Introduced in version 9.5.0.64. Sets the RSA key to be used when the SignatureMethod is set to "RSA-SHA1" or "RSA-SHA2". Returns 1 for success, 0 for failure.
		*m: signaturemethod_access		&& Access method used to retrieve the Chilkat OAuth1 SignatureMethod property.
		*m: signaturemethod_assign		&& Assign method used to hold the Chilkat OAuth1 SignatureMethod property.
		*m: signature_access		&& Access method used to retrieve the Chilkat OAuth1 Signature property.
		*m: signature_assign		&& Assign method used to hold the Chilkat OAuth1 Signature property.
		*m: timestamp_access		&& Access method used to retrieve the Chilkat OAuth1 TimeStamp property.
		*m: timestamp_assign		&& Assign method used to hold the Chilkat OAuth1 TimeStamp property.
		*m: tokensecret_access		&& Access method used to retrieve the Chilkat OAuth1 TokenSecret property.
		*m: tokensecret_assign		&& Assign method used to hold the Chilkat OAuth1 TokenSecret property.
		*m: token_access		&& Access method used to retrieve the Chilkat OAuth1 Token property.
		*m: token_assign		&& Assign method used to hold the Chilkat OAuth1 Token property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat OAuth1 UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold the Chilkat OAuth1 UncommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat OAuth1 VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold the Chilkat OAuth1 VerboseLogging property.
		*p: authorizationheader		&& Introduced in version 9.5.0.53. The authorization header. This is what would be included in the Authorization HTTP request header if it is going to be used as the means for providing the OAuth1 authorization information.
		*p: basestring		&& Introduced in version 9.5.0.53. This is the exact string that was signed. For example, if the signature method is HMAC-SHA1, the BaseString is the exact string that passed to the HMAC-SHA1. An application does not set the BaseString property.
		*p: consumerkey		&& Introduced in version 9.5.0.53. The consumer key.
		*p: consumersecret		&& Introduced in version 9.5.0.53. The consumer secret.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: encodedsignature		&& Introduced in version 9.5.0.53. The URL encoded representation of the Signature property.
		*p: generatedurl		&& Introduced in version 9.5.0.53. The URL that includes the OAuth1 query params.
		*p: hmackey		&& Introduced in version 9.5.0.53. The exact HMAC key used to sign the BaseString. An application does not directly set the HmacKey. The HmacKey property is read-only and is provided for debugging to see the exact HMAC key used to sign the BaseString.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: nonce		&& Introduced in version 9.5.0.53. The nonce.
		*p: oauthmethod		&& Introduced in version 9.5.0.53. The HTTP method, such as "GET", "POST", "PUT", "DELETE", or "HEAD". Defaults to "GET".
		*p: oauthurl		&& Introduced in version 9.5.0.53. The OAuth URL, such as "http://echo.lab.madgex.com/echo.ashx". See http://bettiolo.github.io/oauth-reference-page/ to compare Chilkat results with another tool's results.
		*p: oauthversion		&& Introduced in version 9.5.0.53. The oauth_version. Defaults to "1.0". May be set to the empty string to exclude.
		*p: querystring		&& Introduced in version 9.5.0.53. Contains the normalized set of request parameters that are signed. This is a read-only property made available for debugging purposes.
		*p: realm		&& Introduced in version 9.5.0.70. The realm (optional).
		*p: signature		&& Introduced in version 9.5.0.53. The generated base64 signature.
		*p: signaturemethod		&& Introduced in version 9.5.0.53. The signature method. Defaults to "HMAC-SHA1". Other possible choices are "HMAC-SHA256", "RSA-SHA1", and "RSA-SHA256" (or the equivalent "RSA-SHA2").
		*p: timestamp		&& Introduced in version 9.5.0.53. The timestamp, such as "1441632569".
		*p: token		&& Introduced in version 9.5.0.53. The token.
		*p: tokensecret		&& Introduced in version 9.5.0.53. The token secret.
		*p: uncommonoptions		&& Introduced in version 9.5.0.85. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		authorizationheader = 
		basestring = 
		cchilkatclass = OAuth1
		consumerkey = 
		consumersecret = 
		debuglogfilepath = 
		encodedsignature = 
		generatedurl = 
		hmackey = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "oauth1"
		nonce = 
		oauthmethod = GET
		oauthurl = 
		oauthversion = 
		querystring = 
		realm = 
		signature = 
		signaturemethod = HMAC-SHA1
		timestamp = 
		token = 
		tokensecret = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addparam		&& Introduced in version 9.5.0.53. Adds an extra name/value parameter to the OAuth1 signature. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddParam
		* Purpose:           Adds an extra name/value parameter to the OAuth1 signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcParameterName, the parameter name to add.
		*                    tcParameterValue, the parameter value to add.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.53
		** 
		** Adds an extra name/value parameter to the OAuth1 signature.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcParameterName AS Character, tcParameterValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH1_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 53
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddParam(m.tcParameterName, m.tcParameterValue) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH1_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

