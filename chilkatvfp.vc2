	PROCEDURE addencryptcert		&& Allows for certificates to be explicitly specified for sending encrypted email to one or more recipients. Call this method once per certificate to be used. The ClearEncryptCerts method may be called to clear the list of explicitly-specified certificates.
		*==============================================================================
		* Method:            AddEncryptCert
		* Purpose:           Allows for certificates to be explicitly specified 
		*                    for sending encrypted email to one or more recipients.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Allows for certificates to be explicitly specified 
		** for sending encrypted email to one or more recipients. 
		** Call this method once per certificate to be used. 
		** The ClearEncryptCerts method may be called 
		** to clear the list of explicitly-specified certificates.
		**
		** Note: It is possible to send encrypted email without explicitly specifying the certificates. 
		** On Windows computers, the registry-based Current-User 
		** and Local-Machine certificate stores are automatically 
		** searched for certs matching each of the recipients (To, CC, and BCC recipients).
		**
		** Note: The SetEncryptCert method is equivalent 
		** to calling ClearEncryptCerts followed by AddEncryptCert.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddEncryptCert(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addfileattachment		&& Adds a file as an attachment to the email. Returns the MIME content-type of the attachment, which is inferred based on the filename extension. Returns Nothing on failure.
		*==============================================================================
		* Method:            AddFileAttachment
		* Purpose:           Adds a file as an attachment to the email. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file to attach.
		* Returns:           Character
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Adds a file as an attachment to the email. 
		** Returns the MIME content-type of the attachment, 
		** which is inferred based on the filename extension.
		**
		** Fixed in version 11.3.0: A problem that started in v11.2.0 was fixed. 
		** Chilkat’s internal and automatic file extension to MIME Content-Type logic
		** was outdated (because Chilkat has been in existence for over 20 years). 
		** This was updated and a bug was introduced that caused the mapping to be invalid.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		lcMIMEContent AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcMIMEContent = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcMIMEContent = m.loChilkatObject.AddFileAttachment(m.tcFilePath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcMIMEContent
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addfileattachment2		&& Same as AddFileAttachment, but the content type can be explicitly specified. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddFileAttachment2
		* Purpose:           Same as AddFileAttachment, 
		*                    but the content type can be explicitly specified.
		* Author:            Bill Anderson
