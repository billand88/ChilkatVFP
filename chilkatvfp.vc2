	PROCEDURE unziptosb		&& Introduced in version 9.5.0.67. Unzips a text file to the sb. The contents of sb are appended with the unzipped file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UnZipToSb
		* Purpose:           Unzips a text file to the sb.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        tiLineEndingBehavior, how to end the line
		*                    tcCharSet, the charset of the source string
		*                    toChilkatStringBuilder, a Chilkat String Builder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		** 
		** Unzips a text file to the sb. 
		** The contents of sb are appended with the unzipped file. 
		** The lineEndingBehavior is as follows:
		** 
		** 0 = leave unchanged.
		** 1 = convert all to bare LF's
		** 2 = convert all to CRLF's
		** 
		** The srcCharset tells the component how to interpret the bytes 
		** of the uncompressed file -- i.e. as utf-8, utf-16, windows-1252, etc.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiLineEndingBehavior AS Integer, tcCharSet AS Character, ;
		toChilkatStringBuilder AS [Chilkat.StringBuilder]
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS [Chilkat.StringBuilder], ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UnZipToSb(m.tiLineEndingBehavior, ;
		        m.tcCharSet, m.loChilkatStringBuilder) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder])
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

