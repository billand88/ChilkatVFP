		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Returns the request parameters in URL encoded form 
		** (i.e. in the exact form that would be sent if the ContentType property 
		** was application/x-www-form-urlencoded). 
		** For example, if a request has two params: param1="abc 123" and param2="abc-123", 
		** then GetUrlEncodedParams would return "abc+123
		**
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, ;
		loException AS Exception, lcParameters AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcParameters = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcParameters = m.loChilkatObject.GetURLEncodedParams()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcParameters
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE httpverb_access		&& Access method used to retrieve the Chilkat HTTPRequest HTTPVerb property.
		*==============================================================================
		* Method:            HTTPVerb_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTPRequest HTTPVerb property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HTTPVerb
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** The HttpVerb property should be set to the name of the HTTP method 
		** that appears on the "start line" of an HTTP request, 
		** such as GET, POST, PUT, DELETE, etc. 
		** It is also possible to use the various WebDav verbs such as 
		** PROPFIND, PROPPATCH, MKCOL, COPY, MOVE, LOCK, UNLOCK, etc. 
		** In general, the HttpVerb may be set to anything, 
		** even custom verbs recognized by a custom server-side app.
		**
		** Fixed for Version 38: Fixed a problem with the HTTP SyncrhonousRequest method 
		** where the request body of the HttpRequest object was being sent when 
		** this property equals GET or HEAD. Normally, one would not set the HttpRequest body, 
		** but this was discovered when an HttpRequest object instance 
		** was re-used after a previous POST request.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE httpverb_assign		&& Assign method used to hold a reference to the HTTPVerb property.
