	HIDDEN PROCEDURE appendfromdir_access		&& Access method used to retrieve the Chilkat ZIP AppendFromDir property.
		*==============================================================================
		* Method:            AppendFromDir_Access
		* Purpose:           When files are added to a Zip archive, 
		*                    they are appended from this directory.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AppendFromDir
		* Date Added:        04/28/2022
		*==============================================================================
		
		**
		** When files are added to a Zip archive, they are appended from this directory. 
		** For example, to add all the files under c:/abc/123/myAppDir, 
		** this property could be set to "c:/abc/123", and "myAppDir/*" 
		** would be passed to AppendFiles. 
		** The path that is saved in the .zip would be "myAppDir/". 
		** (The value of the AppendFromDir property does not become part 
		** of the file path saved in the .zip.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE appendfromdir_assign		&& Assign method used to hold a reference to the AppendFromDir property.
		*==============================================================================
		* Method:            AppendFromDir_Assign
		* Purpose:           Assign method used to hold a reference to the AppendFromDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold 
		*                    a reference to the AppendFromDir property.
		* Returns:           
		* Date Added:        04/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE appendhex		&& Creates a new Zip entry and initializes it with already-compressed data that is hexidecimal encoded. (The ZipEntry.CopyHex method can be used to retrieve the compressed data in Hex format.)
		*==============================================================================
		* Method:            AppendHex
		* Purpose:           Creates a new Zip entry and initializes it 
		*                    with already-compressed data that is hexidecimal encoded.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to append.
		*                    tcEncodedCompressionData -- the data to append to the file.
		* Returns:           toChilkatZipEntry, a Chilkat Zip Entry object.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Creates a new Zip entry and initializes it with 
		** already-compressed data that is hexidecimal encoded. 
		** (The ZipEntry.CopyHex method can be used to retrieve the compressed data in Hex format.)
		**
		** Note 1: This method only updates the zip object. 
		** To update (rewrite) a zip file, either the WriteZip 
		** or WriteZipAndClose method would need to be called.
		**
		** Note 2: It is assumed that the compressed data is unencrypted deflated data. 
		** (Meaning data compressed using the "deflate" compression algorithm.)
		**
		** Update for Version 10: This method is now decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character, tcEncodedCompressionData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, ;
		loException AS Exception, loChilkatZipEntry AS CHILKAT_ZIPENTRY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatZipEntry
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatZipEntry = ;
		      m.loChilkatObject.AppendHex(m.tcFileName, m.tcEncodedCompressionData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatZipEntry
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendmultiple		&& This method is the same as calling AppendFiles multiple times - once for each file pattern in fileSpecs. Note: This method only updates the zip object.
		*==============================================================================
		* Method:            AppendMultiple
		* Purpose:           This method is the same as calling AppendFiles
		*                    multiple times - once for each file pattern in fileSpecs
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringArray -- the Chilkat String Array object.
		*                    tuRecursive -- whether or not to recurse subdirectories.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** This method is the same as calling AppendFiles 
		** multiple times - once for each file pattern in fileSpecs
		**
		** Note: This method only updates the zip object. 
		** To update (rewrite) a zip file, either the WriteZip 
		** or WriteZipAndClose method would need to be called.
		**
		** Update for Version 10: This method is now decremented.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, tuRecursive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown, liRecursive AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liRecursive
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liRecursive = .LogicalToBit(m.tuRecursive)
		
		    loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AppendMultiple(m.loChilkatStringArray, m.liRecursive) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatStringArray = m.loParkParameterStringArray.SetObject(;
		    m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendmultipleasync		&& Creates an asynchronous task to call the AppendMultiple method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
