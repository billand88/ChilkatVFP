		LPARAMETERS tcCacheKey AS Character, tcExpireDateTime AS Character, ;
		tcETag AS Character, tqCacheData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CACHE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SaveToCacheStr(m.tcCacheKey, ;
		      m.tcExpireDateTime, m.tcETag, m.tqCacheData) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CACHE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE updateexpiration		&& Undocumented method!  Assumed that the second parameter is a VFP DateTime value. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UpdateExpiration
		* Purpose:           Undocumented method! 
		* Author:            Bill Anderson
