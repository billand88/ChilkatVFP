		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liDontSearchBetweenDoubleQuotes = .LogicalToBit(m.tuDontSearchBetweenDoubleQuotes)
		      liEscapeNotADelimiter = .LogicalToBit(m.tuEscapeNotADelimiter)
		
		      TRY
		
		        STORE m.loChilkatObject.SetNth(m.tiMatch, m.tcValue, m.tcDelimiter, ;
		        m.liDontSearchBetweenDoubleQuotes, m.liEscapeNotADelimiter) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
