	PROCEDURE setwrappingkey		&& Introduced in version 9.5.0.66. Sets the AES wrapping key for encryption or decryption. This is for the case where the content encryption key (CEK) is encrypted using AES Key Wrap or AES GCM.
		*==============================================================================
		* Method:            SetWrappingKey
		* Purpose:           Sets the AES wrapping key for encryption or decryption.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the recipient key array value.
		*                    tcEncodedKey, the password to set.
		*                    tcEncoding, the encoding of the wrapping key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Sets the AES wrapping key for encryption or decryption. 
		** This is for the case where the content encryption key (CEK) is encrypted 
		** using AES Key Wrap or AES GCM. An AES key should be used in the cases 
		** where the "alg" header parameter value is equal to one of the following:
		** 
		**   A128KW
		**   A192KW
		**   A256KW
		**   A128GCMKW
		**   A192GCMKW
		**   A256GCMKW
		**   dir
		** 
		** The index is the index of the recipient, where the 1st recipient is at index 0. 
		** (The typical use case for JWEs is for a single recipient.)
		** 
		** Note: This method also sets the shared direct symmetric key for the case 
		** when the "alg" is equal to "dir". In this case, the key specified 
		** is not actualy a key encryption key, but is the direct content encryption key.
		** 
		** The encoding indicates the representation, such as "base64", "hex", 
		** "base64url", etc. of the encodedKey.
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.**
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tcEncodedKey AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JWE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetWrappingKey(m.tiIndex, ;
		        m.tcEncodedKey, m.tcEncoding) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat JWE VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/20/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/20/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 66
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS jws AS ibasechilkat OF "chilkatvfp.vcx" 		&& An API for JSON Web Signature (JWS). Provides the ability to create and verify JWSs.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: createjws		&& Introduced in version 9.5.0.66. Creates and returns the JWS containing one or more signatures according to the previously set payload, headers, and keys. Returns Nothing on failure.
		*m: createjwssb		&& Introduced in version 9.5.0.66. Creates and returns the JWS by appending it to the contents of sbJws. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat JWS DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getpayload		&& Introduced in version 9.5.0.66. Returns the JWS payload. The charset specifies the byte representation to be used in interpreting the bytes of the payload. (For example, "utf-8", "windows-1252", "utf-16", etc.) Returns Nothing on failure.
		*m: getpayloadbd		&& Introduced in version 9.5.0.66. Returns the JWS payload by appending it to the binData. Returns 1 for success, 0 for failure.
		*m: getpayloadsb		&& Introduced in version 9.5.0.66. Returns the JWS payload by appending it to the sbPayload. The charset specifies the byte representation to be used in interpreting the bytes of the payload. (For example, "utf-8", "windows-1252", "utf-16", etc.)
		*m: getprotectedh		&& Introduced in version 11.0.0. Returns in json the protected header of the signature at the specified index. The first signature is at index 0. Typically, a JWS has a single signature at index 0. Returns 1 for success, 0 for failure.
		*m: getprotectedheader		&& Introduced in version 9.5.0.66. Returns the protected header for the Nth signature. The index is the index of the signature. The 1st signature is at index 0. In most cases, a JWS contains a single signature at index 0. Returns Nothing on failure.
		*m: getunprotectedh		&& Introduced in version 11.0.0. Returns in json the original unprotected header of the signature at the specified index. The first signature is at index 0. Typically, a JWS has a single signature at index 0. Returns 1 for success, 0 for failure.
		*m: getunprotectedheader		&& Introduced in version 9.5.0.66. Returns the optional unprotected header for the Nth signature. The index is the index of the signature. The 1st signature is at index 0. In most cases, a JWS contains a single signature at index 0.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat JWS LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat JWS LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat JWS LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat JWS LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat JWS LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat JWS LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat JWS LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadjws		&& Introduced in version 9.5.0.66. Loads a JWS contained in jwsStr. Returns 1 for success, 0 for failure.
		*m: loadjwssb		&& Introduced in version 9.5.0.66. Loads a JWS from the contents of sbJws. Returns 1 for success, 0 for failure.
		*m: numsignatures_access		&& Access method used to retrieve the Chilkat JWS NumSignatures property.
		*m: numsignatures_assign		&& Assign method used to hold a reference to the NumSignatures property.
		*m: prefercompact_access		&& Access method used to retrieve the Chilkat JWS PreferCompact property.
		*m: prefercompact_assign		&& Assign method used to hold a reference to the PreferCompact property.
		*m: preferflattened_access		&& Access method used to retrieve the Chilkat JWS PreferFlattened property.
		*m: preferflattened_assign		&& Assign method used to hold a reference to the PreferFlattened property.
		*m: setmackey		&& Introduced in version 9.5.0.66. Sets the MAC key to be used for creating or validating a signature for the algorithms "HS256", "HS384", or "HS512". The key is an encoded string representation of the MAC key bytes.
		*m: setmackeybd		&& Introduced in version 9.5.0.66. Sets the MAC key to be used for creating or validating a signature for the algorithms "HS256", "HS384", or "HS512". The key contains the binary bytes of the MAC key for the Nth signature.  The 1st signature is at index 0.
		*m: setpayload		&& ntroduced in version 9.5.0.66. Sets the JWS payload from the contents of payload. The charset specifies the byte representation to be used for the string that is to be the payload. (For example, "utf-8", "windows-1252", "utf-16", etc.).
		*m: setpayloadbd		&& Introduced in version 9.5.0.66. Sets the JWS payload from the contents of binData. Returns 1 for success, 0 for failure.
		*m: setpayloadsb		&& Introduced in version 9.5.0.66. Sets the JWS payload from the contents of sbPayload. The charset specifies the byte representation to be used for the string that is to be the payload. (For example, "utf-8", "windows-1252", "utf-16", etc.).
		*m: setprivatekey		&& Introduced in version 9.5.0.66. Sets the private key (ECC or RSA) to be used in creating a signature for the following algorithms: RS256, RS384, RS512, ES256, ES384, ES512, PS256, PS384, PS512.
		*m: setprotectedheader		&& Introduced in version 9.5.0.66. Sets a signature's protected header. The index is the index of the signature. The 1st signature is at index 0. In most cases, a JWS contains a single signature at index 0. Returns 1 for success, 0 for failure.
		*m: setpublickey		&& Introduced in version 9.5.0.66. Sets the public key (ECC or RSA) to be used in validating a signature for the following algorithms: RS256, RS384, RS512, ES256, ES384, ES512, PS256, PS384, PS512. Returns 1 for success, 0 for failure.
		*m: setsigningcert		&& Introduced in version 11.5.0. Use the certificate's private key (ECC or RSA) when signing for the following algorithms: RS256, RS384, RS512, ES256, ES384, ES512, PS256, PS384, PS512
		*m: setunprotectedheader		&& Introduced in version 9.5.0.66. Sets a signature's optional unprotected header. The index is the index of the signature. The 1st signature is at index 0. In most cases, a JWS contains a single signature at index 0. Returns 1 for success, 0 for failure.
		*m: validate		&& Introduced in version 9.5.0.66. Validates the Nth signature or MAC using the Nth public key or MAC key. Returns 1 if the signature was validated, thus verifying that the signer used the same MAC key or the matching private key.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat JWS VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numsignatures		&& Introduced in version 9.5.0.66. The number of signatures contained in this JWS.
		*p: prefercompact		&& Introduced in version 9.5.0.66. Controls whether to use the JWS Compact Serialization or JWS JSON Serialization when creating JWSs. The default value is 1, which is to choose the compact serialization when possible.
		*p: preferflattened		&& Introduced in version 9.5.0.66. Controls whether to use the flattened or general JWE JSON Serialization when creating JWSs. The default value is 1, which is to choose the flattened serialization when possible.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Jws
		debuglogfilepath = 
		iinstancepatch = 66
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "jws"
		numsignatures = 0
		prefercompact = 1
		preferflattened = 1
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  Fixed: CreateJwsSb now respects PreferCompact and PreferFlattened. 
		  Previously it always produced the general JSON serialization, 
		  even when compact output was requested. 
		  To keep the old always-general output, set PreferCompact = false 
		  (and, for a single signature, PreferFlattened = false).
		
		** Version 11.5.0
		
		  Added the SetSigningCert method.
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 11.0.0
		
		  Added the GetProtetedH and GetUnprotectedH methods.
		
		  Decremented the GetProtectedHeader and GetUnprotectedHeader methods.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 83
		
		  Improved support for ECDSA certs.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 75
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		  Added RSASSA-PSS and RSAES-OAEP capabilities for signed and encrypted email.
		  This was spurred by customer needs to satisfy new requirements in Germany
		  that apparently go into effect on 1-June-2017 regarding email signatures and encryption.
		
		** Version 66
		
		  Added the Jwe and Jws classes for JSON Web Encryption and JSON Web Signatures.
		
		** Version 65
		
		  Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		  See https://www.example-code.com/foxpro/edifact_eda_syntax_level_A_encoding.asp
		  Also see: https://cknotes.com/chilkat-binary-encoding-list/
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE createjws		&& Introduced in version 9.5.0.66. Creates and returns the JWS containing one or more signatures according to the previously set payload, headers, and keys. Returns Nothing on failure.
		*==============================================================================
		* Method:            CreateJWS
		* Purpose:           Creates and returns the JWS containing one or more signatures.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The Java Web Store.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Creates and returns the JWS containing one or more signatures 
		** according to the previously set payload, headers, and keys.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcJavaWebStore AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcJavaWebStore = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcJavaWebStore = m.loChilkatObject.CreateJWS()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcJavaWebStore
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE createjwssb		&& Introduced in version 9.5.0.66. Creates and returns the JWS by appending it to the contents of sbJws. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CreateJWSSb
		* Purpose:           Creates and returns the JWS by appending it to the contents of sbJws.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat String Builder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Creates and returns the JWS by appending it to the contents of sbJws.
		** 
		** Returns 1 for success, 0 for failure.
		**
		** Fixed for Version 11.6.0: CreateJwsSb now respects PreferCompact and PreferFlattened. 
		** Previously it always produced the general JSON serialization, even when compact output 
		** was requested. To keep the old always-general output, set PreferCompact = false 
		** (and, for a single signature, PreferFlattened = false).
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CreateJWSSb(m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat JWS DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/20/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Crypt2 DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/20/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 66
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE getpayload		&& Introduced in version 9.5.0.66. Returns the JWS payload. The charset specifies the byte representation to be used in interpreting the bytes of the payload. (For example, "utf-8", "windows-1252", "utf-16", etc.) Returns Nothing on failure.
		*==============================================================================
		* Method:            GetPayload
		* Purpose:           Returns the JWS payload. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
