		** Creates an asynchronous task to call the HttpSReq method with the arguments provided. 
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcDomain AS Character, tiPort AS Integer, tuSSL AS Unknown, ;
		toChilkatHTTPRequest AS CHILKAT_HTTPREQUEST_COM_CALL, toChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterHttpRequest AS [iParkParameter OF ChilkatVFP.VCX], liSSL AS Integer, ;
		loChilkatHTTPRequest AS CHILKAT_HTTPREQUEST_COM_CALL, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatTask, m.loParkParameterBinData, m.loChilkatHTTPRequest, ;
		m.loParkParameterHttpRequest, m.loChilkatHTTPResponse
		
		liSSL = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSSL = .LogicalToBit(m.tuSSL)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHTTPRequest)
		
		      loChilkatHTTPRequest = m.loParkParameterBinData.GetObject()
		
		      loParkParameterHttpRequest = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHTTPResponse)
		
		      loChilkatHTTPResponse = m.loParkParameterHttpRequest.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.HttpSReqAsync(m.tcDomain, m.tiPort, ;
		        m.liSSL, m.loChilkatHTTPResponse, m.loChilkatHTTPResponse)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatHTTPRequest = m.loParkParameterBinData.SetObject(;
		      m.toChilkatHTTPRequest, m.loChilkatHTTPRequest)
		
		      toChilkatHTTPResponse = m.loParkParameterHttpRequest.SetObject(;
		      m.toChilkatHTTPResponse, m.loChilkatHTTPResponse)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatHTTPRequest, ;
		m.loParkParameterHttpRequest, m.loChilkatHTTPResponse
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatHTTPRequest = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  toChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterHttpRequest = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatHTTPRequest = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE httpstr		&& Introduced in version 11.0.0. Sends an HTTP request to url using the specified verb (e.g., POST, PUT, PATCH). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            HttpStr
		* Purpose:           Sends an HTTP request to url using the specified verb (e.g., POST, PUT, PATCH).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb -- the verb for the HTTP request.
		*                    tcURL -- the URL to retrieve.
		*                    tcBodyString -- the passed text.
		*                    tcCharSet -- the character set.
		*                    tcContentType -- the content type.
		*                    toChilkatHTTPResponse -- a Chilkat HTTP Request object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Sends an HTTP request to url using the specified verb (e.g., POST, PUT, PATCH). 
		** The request body contains the text passed in bodyStr, 
		** and the content type is specified by contentType (e.g., text/xml, application/json). 
		** The charset defines the text encoding, such as utf-8 or iso-8859-1.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character, ;
		tcBodyString AS Character, tcCharSet AS Character, tcContentType AS Character, ;
		toChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterHTTPResponse AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHTTPResponse, m.loChilkatHTTPResponse
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterHTTPResponse = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatHTTPResponse)
		
		      loChilkatHTTPResponse = m.loParkParameterHTTPResponse.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.HttpStr(m.tcVerb, m.tcURL, m.tcBodyString, ;
		        m.tcCharset, m.tcContentType, m.loChilkatHTTPResponse) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatHTTPResponse = m.loParkParameterHTTPResponse.SetObject(;
		      m.toChilkatHTTPResponse, m.loChilkatHTTPResponse)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterHTTPResponse, m.loChilkatHTTPResponse
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loParkParameterHTTPResponse = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

