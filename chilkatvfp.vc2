		RETURN
	ENDPROC

	PROCEDURE pkcs7extractdigest		&& Undocumented method! Extracts the signature digest contained within a PKCS7 signature. The PKCS7 is passed in the encoding determined by the EncodingMode property (such as base64, hex, etc.) an the signature digest is returned in the same encoding.
		*==============================================================================
		* Method:            PKCS7ExtractDigest
		* Purpose:           Undocumented method!
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the signature index value
		*                    tcPKCS7Sig -- the PKCS7 signature.
		* Returns:           The signature digest.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Undocumented method!
		**
		** Extracts the signature digest contained within a PKCS7 signature. The PKCS7 is
		** passed in the encoding determined by the EncodingMode property (such as base64,
		** hex, etc.) an the signature digest is returned in the same encoding.
		** 
		
		LPARAMETERS tiIndex AS Integer, tcPKCS7Sig AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcSignatureDigest AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcSignatureDigest = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        lcSignatureDigest = m.loChilkatObject.PKCS7ExtractDigest(m.tiIndex, m.tcPKCS7Sig)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcSignatureDigest
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

