	PROCEDURE encode		&& Encode binary data to base64, hex, quoted-printable, or URL-encoding.
		*==============================================================================
		* Method:            Encode
		* Purpose:           Encode binary data to base64, hex, quoted-printable, or URL-encoding.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to encode. 
		*                    tcEncoding -- the encoding mechanism.
		* Returns:           The encoded bytes
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Encode binary data to base64, hex, quoted-printable, or URL-encoding. 
		** The encoding can be set to any of the following strings: "base64", "hex", 
		** "quoted-printable" (or "qp"), "url", "base32", "Q", "B", "url_rc1738", 
		** "url_rfc2396", "url_rfc3986", "url_oauth", "uu", "modBase64", or "html" 
		** (for HTML entity encoding).
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tqData AS VarBinary, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedBytes AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedBytes = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedBytes = m.loChilkatObject.Encode(m.tqData, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encodeint		&& Introduced in version 9.5.0.77. Encodes an integer to N bytes and returns in the specified encoding. If littleEndian is 1, then little endian byte ordering is used. Otherwise big-endian byte order is used. Returns Nothing on failure.
		*==============================================================================
		* Method:            EncodeInt
		* Purpose:           Encodes an integer to N bytes and returns in the specified encoding.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue -- the integer value to encode.
		*                    tiNumBytes -- the number of bytes to encode the integer.
		*                    tuLittleEndian -- whether or not little endian byte ordering is used.
		*                    tcEncoding -- the encoding mechanism.
		* Returns:           The encoded bytes
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Encodes an integer to N bytes and returns in the specified encoding. 
		** If littleEndian is 1, then little endian byte ordering is used. 
		** Otherwise big-endian byte order is used.
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiValue AS Integer, tiNumBytes AS Integer, ;
		tuLittleEndian AS Unknown, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedBytes AS Character, ;
		liLittleEndian AS Integer, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE 0 TO m.liLittleEndian, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedBytes = []
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liLittleEndian = .BitToLogical(m.tuLittleEndian)
		
		      TRY
		
		        lcEncodedBytes = m.loChilkatObject.EncodeInt(;
		        m.tiValue, m.tiNumBytes, m.liLittleEndian, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encodestring		&& Encodes a string.
		*==============================================================================
		* Method:            EncodeString
		* Purpose:           Encodes a string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcStringToEncode -- the string to encode.
		*                    tcCharset -- the string charset
		*                    tcEncoding -- the strig encoding.
		* Returns:           The encoded string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Encodes a string. The toEncodingName can be set to any of the following strings: 
		** "base64", "hex", "quoted-printable", "url", "base32", "Q", "B", "url_rc1738", 
		** "url_rfc2396", "url_rfc3986", "url_oauth", "uu", "modBase64", or "html" 
		** (for HTML entity encoding). The charsetName is important, 
		** and usually you'll want to specify "ansi". 
		** For example, if the string "ABC" is to be encoded to "hex" using ANSI, 
		** the result will be "414243". However, if "unicode" is used, the result is "410042004300".
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcStringToEncode AS Character, ;
		tcCharset AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedString = ;
		      m.loChilkatObject.EncodeString(m.tcStringToEncode, m.tcCharset, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE encodingmode_access		&& Access method used to retrieve the Chilkat Crypt2 EncodingMode property.
		*==============================================================================
		* Method:            EncodingMode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 EncodingMode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EncodingMode
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** Controls the encoding of binary data to a printable string for many methods. 
		** The valid modes are "Base64", "modBase64", "base64url", "Base32", 
		** "Base58", "UU", "QP" (for quoted-printable), "URL" (for url-encoding), 
		** "Hex", "Q", "B", "url_oauth", "url_rfc1738", "url_rfc2396", "url_rfc3986", 
		** "fingerprint", or "decimal".
		** 
		** The default value is "base64"
		** 
		** The "fingerprint" and"decimal" encodings are introduced in Chilkat v9.5.0.55.
		** 
		** The "fingerprint" encoding is a lowercase hex encoding where each hex digit 
		** is separated by a colon character. For example: 6a:de:e0:af:56:f8:0c:04:11:5b:ef:4d:49:ad:09:23
		** 
		** The "decimal" encoding is for converting large decimal integers to/from 
		** a big-endian binary representation. For example, the decimal string "72623859790382856" 
		** converts to the bytes 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08.
		**
		** Enchancement for Version 49: Added Base58 encoding as an additional choice 
		** for all places where an encoding (such as “base64”, “hex”, etc.) can be selected.
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE encodingmode_assign		&& Assign method used to hold a reference to the EncodingMode property.
		*==============================================================================
		* Method:            EncodingMode_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Crypt2 EncodingMode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the EncodingMode property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [EncodingMode_Crypt2]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE encryptbd		&& Introduced in version 9.5.0.67. In-place encrypts the contents of bd. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey.
		*==============================================================================
		* Method:            EncryptBd
		* Purpose:           In-place encrypts the contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** In-place encrypts the contents of bd. The minimal set of properties 
		** that should be set before encrypting are: CryptAlgorithm, SecretKey. 
		** Other properties that control encryption are: CipherMode, PaddingScheme, 
		** KeyLength, IV. When decrypting, all property settings must match 
		** otherwise the result is garbled data.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.EncryptBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encryptbytes		&& Encrypts a byte array. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey.
		*==============================================================================
		* Method:            EncryptBytes
		* Purpose:           Encrypts a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to encrypt. 
		* Returns:           The encrypted binary data bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Encrypts a byte array. The minimal set of properties that should 
		** be set before encrypting are: CryptAlgorithm, SecretKey. 
		** Other properties that control encryption are: CipherMode, PaddingScheme, 
		** KeyLength, IV. When decrypting, all property settings must match 
		** otherwise garbled data is returned.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqEncryptedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDecryptedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqEncryptedBytes = m.loChilkatObject.EncryptBytes(m.tqData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqEncryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encryptbytesenc		&& Encrypts a byte array and returns the encrypted data as an encoded (printable) string.
		*==============================================================================
		* Method:            EncryptBytesENC
		* Purpose:           Encrypts a byte array and returns the encrypted data 
		*                    as an encoded (printable) string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to encrypt. 
		* Returns:           The encrypted bytes
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Encrypts a byte array and returns the encrypted data as an encoded (printable) string. 
		** The minimal set of properties that should be set before encrypting are: 
		** CryptAlgorithm, SecretKey, EncodingMode. Other properties that control encryption are: 
		** CipherMode, PaddingScheme, KeyLength, IV. When decrypting, all property settings 
		** must match otherwise garbled data is returned. The encoding of the string that 
		** is returned is controlled by the EncodingMode property, 
