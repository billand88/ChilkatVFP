	PROCEDURE addchildtree		&& Adds an entire subtree as a child. If the child was a subtree within another Xml document then the subtree is effectively transferred from one XML document to another.
		*==============================================================================
		* Method:            AddChildTree
		* Purpose:           Adds an entire subtree as a child.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML -- a Chilkat XML object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Adds an entire subtree as a child. 
		** If the child was a subtree within another Xml document 
		** then the subtree is effectively transferred from one XML document to another.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AddChildTree(m.loChilkatXML) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

