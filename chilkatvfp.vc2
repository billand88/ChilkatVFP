	PROCEDURE lowercase		&& Converts a string to lowercase. Returns Nothing on failure.
		*==============================================================================
		* Method:            LowerCase
		* Purpose:           Converts a string to lowercase.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the input string.
		* Returns:           A lowercased string.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Converts a string to lowercase.
		** 
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tcString AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, lcLowerCaseString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcLowerCaseString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcLowerCaseString = m.loChilkatObject.LowerCase(m.tcString)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcLowerCaseString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readfile		&& Convenience method for reading the entire contents of a file into a byte array. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
		* Method:            ReadFile
		* Purpose:           Convenience method for reading 
		*                    the entire contents of a file into a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file to read.
		* Returns:           Binary byte array.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Convenience method for reading the entire contents of a file into a byte array.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, lqConvertedData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqByteArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqByteArray = m.loChilkatObject.ReadFile(m.tcFilePath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqByteArray
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readfiletostring		&& Reads a text file and returns the text converted to a Unicode string. The filename is specified by the first method argument, and the charset of the text data is specified by the 2nd method argument. Returns Nothing on failure.
		*==============================================================================
		* Method:            ReadFileToString
		* Purpose:           Reads a text file and returns the text converted to a Unicode string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSourceFilePath, the path to the file.
		*                    tcCharset, the charset of the file.
		* Returns:           Unicode string
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Reads a text file and returns the text converted to a Unicode string. 
		** The filename is specified by the first method argument, 
		** and the charset of the text data is specified by the 2nd method argument.
		** 
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS tcSourceFilePath AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, lcUnicode AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcUnicode = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcUnicode = ;
		      m.loChilkatObject.ReadFileToString(m.tcSourceFilePath, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcUnicode 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE savelast_access		&& Access method used to retrieve the Chilkat Charset SaveLast property.
		*==============================================================================
		* Method:            SaveLast_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Charset SaveLast property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SaveLast
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Tells the component to keep the input/output byte data in memory 
		** after a conversion is complete so the data can be examined 
		** via the LastInputAsHex/QP and LastOutputAsHex/QP properties. (for debugging purposes)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE savelast_assign		&& Assign method used to hold a reference to the SaveLast property.
