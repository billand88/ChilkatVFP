	HIDDEN PROCEDURE authfailreason_access		&& Access method used to retrieve the Chilkat SFTP AuthFailReason property.
		*==============================================================================
		* Method:            AuthFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP AuthFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AuthFailReason
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Set to one of the following values if a call to 
		** AuthenticatePw, AuthenticatePk, or AuthenticatePwPk returns a failed status.
		** 
		** 1: Transport failure. This is a failure to communicate with the server 
		** (i.e. the connection was lost, or a read or write failed or timed out).
		** 2: Invalid key for public key authentication. 
		** The key was not a valid format, not a valid key, 
		** not a private key, or not the right type of key.
		** 3: No matching authentication methods were available.
		** 4: SSH authentication protocol error - an unexpected or invalid message was received.
		** 5: The incorrect password or private key was provided.
		** 6: Already authenticated. The SSH session is already authenticated.
		** 7: Password change request: The server requires the password to be changed.
		**
		** Fixed in version 99: The AuthFailReason was not getting set 
		** when authentication failed. This is fixed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE authfailreason_assign		&& Assign method used to hold a reference to the AuthFailReason property.
		*==============================================================================
		* Method:            AuthFailReason_Assign
		* Purpose:           Assign method used to hold a reference to the AuthFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the AuthFailReason property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE bandwidththrottledown_access		&& Access method used to retrieve the Chilkat SFTP BandwidthThrottleDown property.
		*==============================================================================
		* Method:            BandwidthThrottleDown_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP BandwidthThrottleDown property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BandwidthThrottleDown
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** If non-zero, limits (throttles) the download bandwidth to approximately 
		** this maximum number of bytes per second. The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

