	PROCEDURE encryptstring		&& Encrypts a string using the RSA encryption algorithm. usePrivateKey should be set to 1 if the private key is to be used for encrypting. Otherwise it should be set to 0 if the public key is to be used for encrypting.
		*==============================================================================
		* Method:            EncryptString
		* Purpose:           Encrypts a string using the RSA encryption algorithm.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string to encrypt. 
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           The encrypted bytes
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Encrypts a string using the RSA encryption algorithm. 
		** usePrivateKey should be set to 1 if the private key is to be used for encrypting. 
		** Otherwise it should be set to 0 if the public key is to be used for encrypting. 
		** The string is first converted (if necessary) to the character encoding 
		** specified by the Charset property before encrypting. The encrypted bytes are returned.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		** 
		** Note: Except for special situations, the public key should always be used for encrypting, 
		** and the private key for decrypting. This makes sense because an encrypted message 
		** is sent to a recipient, and the recipient is the only one in possession of the private key, 
		** and therefore the only one that can decrypt and read the message.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcString AS Character, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, liUsePrivateKey AS Integer, ;
		loException AS Exception, lqEncryptedBytes AS Varbinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqEncryptedBytes
		
		liUsePrivateKey = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		    TRY
		
		      lqEncryptedBytes = m.loChilkatObject.EncryptString(m.tcString, m.liUsePrivateKey)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqEncryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encryptstringenc		&& Same as EncryptString, except the output is an encoded string. The encoding is specified by the EncodingMode property, which can have values such as "base64", "hex", "quoted-printable", "url", etc.
		*==============================================================================
		* Method:            EncryptStringENC
		* Purpose:           Same as EncryptString, except the output is an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcData -- the string data to encrypt. 
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           The encrypted encoded string bytes.
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** Same as EncryptString, except the output is an encoded string. 
		** The encoding is specified by the EncodingMode property, 
		** which can have values such as "base64", "hex", "quoted-printable", "url", etc.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		** 
		** Note: Except for special situations, the public key should always be used for encrypting, 
		** and the private key for decrypting. This makes sense because an encrypted message 
		** is sent to a recipient, and the recipient is the only one in possession of the private key, 
		** and therefore the only one that can decrypt and read the message.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcData AS Character, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, lcEncryptedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncryptedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		    TRY
		
		      lcEncryptedString = m.loChilkatObject.EncryptStringENC(m.tcData, m.tuUsePrivateKey)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncryptedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

