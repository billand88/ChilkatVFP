	PROCEDURE fetchrange		&& Introduced in version 11.0.0. Retrieves a specified range of emails from the POP3 server. If keepOnServer is 1, the emails remain on the server. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FetchRange
		* Purpose:           Retrieves a specified range of emails from the POP3 server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuKeepOnServer -- whether to keep on the server or not.
		*                    tuHeadersOnly -- whether or not to download just the header.
		*                    tiNumBodyLines -- the number of body lines to download.
		*                    tiStartingIndex -- the starting index number to retrieve.
		*                    tiEndingIndex -- the starting index number to retrieve.
		*                    toChilkatEMailBundle -- a Chilkat EmailBundle object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Retrieves a specified range of emails from the POP3 server. 
		** If keepOnServer is 1, the emails remain on the server. 
		** If headersOnly is 1, only the headers and the first numBodyLines lines of each email 
		** are downloaded, without attachments. Otherwise, the entire emails, including attachments, 
		** are downloaded. The range of emails to download is determined by startIndex and endIndex. 
		** The GetMailboxCount method returns the total number of emails in the POP3 mailbox, 
		** with the first email at index 0. The downloaded emails are stored in bundle.
		** 
		** Note: keepOnServer only applies when downloading full emails (not headers-only). 
		** Downloading headers-only will not cause the email to be deleted from the server, 
		** regardless of keepOnServer.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuKeepOnServer AS Unknown, tuHeadersOnly AS Unknown, ;
		tiNumBodyLines AS Integer, tiStartingIndex AS Integer, ;
		tiEndingIndex AS Integer, toChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, liHeadersOnly AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterEMailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL, liKeepOnServer AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liKeepOnServer, m.liHeadersOnly
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liKeepOnServer = .LogicalToBit(m.tuKeepOnServer)
		      liHeadersOnly = .LogicalToBit(m.tuHeadersOnly)
		
		      loParkParameterEMailBundle = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMailBundle)
		
		      loChilkatEMailBundle = m.loParkParameterEMailBundle.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FetchRange(m.liKeepOnServer, m.liHeadersOnly, ;
		        m.tiNumBodyLines, m.tiStartingIndex, m.tiEndingIndex, m.loChilkatEMailBundle) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEMailBundle = m.loParkParameterEMailBundle.SetObject(;
		      m.toChilkatEMailBundle, m.loChilkatEMailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEMailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterEMailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEMailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

