	PROCEDURE setoutputschema		&& Introduced in version 11.6.0. Requests schema-constrained JSON output (structured output) for subsequent calls to Ask. name is a short schema name (letters, digits, underscores, and hyphens) used as an identifier by some providers.
		*==============================================================================
		* Method:            SetOutputSchema
		* Purpose:           Requests schema-constrained JSON output for subsequent calls to Ask.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName - a short schema name.
		*                    toChilkatJsonObject, a Chilkat Json object.
		*                    tuStrict - Strict conformance flag.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		**
		** Requests schema-constrained JSON output (structured output) for subsequent calls to Ask. 
		** name is a short schema name (letters, digits, underscores, and hyphens) 
		** used as an identifier by some providers. schema is the desired output shape as a JSON Schema. 
		** strict (strict) requests strict conformance where the provider supports it.
		** 
		** Pass an empty string for name to clear a previously-set schema, which disables structured output.
		** 
		** When strict (strict) is 1, Chilkat automatically augments the schema for the providers 
		** that require it — adding "additionalProperties": false and marking every property required 
		** on each object — so an ordinary JSON Schema can be supplied. For example, schema might be:
		** 
		** {
		**   "type": "object",
		**   "properties": {
		**     "name": { "type": "string" },
		**     "age": { "type": "integer" }
		**   },
		**   "required": ["name", "age"]
		** }
		** 
		** After Ask, the model's JSON is available as text from GetOutputText or parsed from GetOutputJson.
		** 
		** Provider support: OpenAI, Anthropic Claude, Google Gemini, xAI Grok, Mistral, and Perplexity 
		** return schema-conforming JSON. DeepSeek supports JSON-object mode only 
		** (a valid JSON object is returned, but the schema is not enforced).
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcName AS Character, toChilkatJsonObject AS [Chilkat.JsonObject], tuStrict AS Unknown
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJson AS [Chilkat.JsonObject], liReturn AS Integer, luReturn AS Unknown, ;
		liStrict AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liStrict
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJson
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liStrict = .LogicalToBit(m.tuStrict)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatJson)
		
		      loChilkatJson = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetOutputSchema(m.tcName, ;
		        m.loChilkatJson, m.liStrict) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterBinData.SetObject(m.oChilkatJson, m.loChilkatJson)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJson
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJson = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

