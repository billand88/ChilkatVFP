DEFINE CLASS ai AS ibasechilkat OF "chilkatvfp.vcx" 		&& Chilkat’s AI API acts as a unified interface for working with multiple AI providers.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: apikeyheader_access		&& Access method used to retrieve the Chilkat AI APIKeyHeader property.
