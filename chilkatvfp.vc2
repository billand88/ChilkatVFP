		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		loParkParameterEmailPartial AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmailPartial AS CHILKAT_EMAIL_COM_CALL, ;
