	HIDDEN PROCEDURE laststringresult_access		&& Access method used to retrieve the Chilkat RSS LastStringResult property.
		*==============================================================================
		* Method:            LastStringResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastStringResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastStringResult
		* Date Added:        06/27/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.52
		**
		** The string return value of the last (string returning) method called. 
		** Only available if Chilkat.Global.KeepStringResult is set to 1. 
		** This provides a means for obtaining large string results in the SQL Server environment 
		** (where limitations exist in getting long strings returned by method calls, 
		** but where temp tables can be used for string properties).
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*==============================================================================
		* Method:            LastStringResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastStringResult of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the last string result in text format.
		* Returns:           
		* Date Added:        06/27/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE loadrssfile		&& Load an RSS document from a file. Returns 1 for success, 0 for failure.
