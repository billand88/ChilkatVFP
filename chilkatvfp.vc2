	PROCEDURE updatemetadata		&& Introduced in version 10.1.0. Updates or adds XMP metdata to a PDF. The metadata is passed in sb. If successful, the PDF with updated or inserted metadata is written to outFilePath. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UpdateMetadata
		* Purpose:           Updates or adds XMP metdata to a PDF. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat StringBuilder object.
		*                    tcFilePath, the output file path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/16/2025
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		**
		** Updates or adds XMP metdata to a PDF. The metadata is passed in sb. 
		** If successful, the PDF with updated or inserted metadata is written to outFilePath.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		loParkParameterStringBuilderObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilderObject, m.loChilkatStringBuilder
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilderObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilderObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UpdateMetadata(m.loChilkatStringBuilder, m.tcFilePath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilderObject.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilderObject, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilderObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE updatemetadatabd		&& Introduced in version 10.1.0. Updates or adds XMP metdata to a PDF. The metadata is passed in sb. If successful, the PDF with updated or inserted metadata is written to bd. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UpdateMetadataBd
		* Purpose:           Signs the open PDF and if successful writes the signed PDF to the bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat StringBuilder object.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/16/2025
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		**
		** Updates or adds XMP metdata to a PDF. The metadata is passed in sb. 
		** If successful, the PDF with updated or inserted metadata is written to bd.
		**
		** Fixed in version 11.3.0: The output bd argument was always 0 bytes.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringBuilderObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterStringBuilderObject, ;
		m.loChilkatStringBuilder, m.loParkParameterBinData, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilderObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilderObject.GetObject()
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UpdateMetadataBd(m.loChilkatStringBuilder, ;
		        m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilderObject.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilderObject, m.loChilkatStringBuilder, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterStringBuilderObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE userpassword_access		&& Access method used to retrieve the Chilkat PDF UserPassword property.
		*==============================================================================
		* Method:            UserPassword_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PDF UserPassword property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UserPassword
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** The PDF owner password, if required.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE userpassword_assign		&& Assign method used to hold a reference to the UserPassword property.
		*==============================================================================
		* Method:            UserPassword_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat PDF UserPassword property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UserPassword property.
		* Returns:           
		* Date Added:        05/07/2025
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat PDF VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/08/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/08/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 85
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE verifysignature		&& Introduced in version 9.5.0.85. Verifies the Nth signature contained in the PDF, where the 1st signature is indicated by an index of 0. Returns 1 if the signature valid, otherwise returns 0.
		*==============================================================================
		* Method:            VerifySignature
		* Purpose:           Verifies the Nth signature contained in the PDF.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the signature array index value.
		*                    toChilkatJsonObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.85
		**
		** Verifies the Nth signature contained in the PDF, 
		** where the 1st signature is indicated by an index of 0. 
		** Returns 1 if the signature valid, otherwise returns 0. 
		** The sigInfo is an output argument and is populated with information 
		** about the validated or unvalidated signature.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 85
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.VerifySignature(m.tiIndex, ;
		        m.loChilkatJsonObject) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS pem AS ibasechilkat OF "chilkatvfp.vcx" 		&& For creating, loading, parsing, converting, and saving in the PEM format. Note: There are many types of objects that can be stored in PEM format. Chilkat supports certificates, private keys, and public keys. There is still much more to do. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addcert		&& Introduced in version 9.5.0.49. Adds a certificate, and potentially the certs in its chain of authentication to the PEM. If includeChain is 1, then certificates in the cert's chain of authentication up to and including the root are automatically added.
		*m: additem		&& Introduced in version 9.5.0.59. Adds a certificate, private key, public key, or csr to the PEM. The possible values for itemType are "certificate" (or "cert"), "privateKey", "publicKey", or "csr".
		*m: addp7b		&& Introduced in version 11.0.0. Loads the PEM from the contents of an PKCS7 container (.p7b) contained in bd. Common Use: Used to bundle intermediate and root certificates for things like SSL certificate chains. Returns 1 for success, 0 for failure.
		*m: addprivatekey		&& Introduced in version 9.5.0.49. Adds a private key to the PEM object. Returns 1 for success, 0 for failure.
		*m: addprivatekey2		&& Introduced in version 9.5.0.49. Adds a private key and it's associated certificate chain to the PEM object. Returns 1 for success, 0 for failure.
		*m: addpublickey		&& Introduced in version 9.5.0.49. Adds a public key to the PEM object. Returns 1 for success, 0 for failure.
		*m: appendmode_access		&& Access method used to retrieve the Chilkat PEM AppendMode property.
		*m: appendmode_assign		&& Assign method used to hold a reference to the AppendMode property.
		*m: certat		&& Introduced in version 11.0.0. Returns in cert the Nth certificate from the PEM. The first certificate is at index 0. Returns 1 for success, 0 for failure.
		*m: clear		&& Introduced in version 9.5.0.49. Removes all content from this PEM object. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat PEM DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getcert		&& Introduced in version 9.5.0.49. Returns the Nth certificate from the PEM. The first certificate is at index 0. Returns Nothing on failure.
		*m: getencodeditem		&& Introduced in version 9.5.0.50. Returns the encoded contents of the Nth item of a particular type (0-based index). The possible values for itemType are "certificate" (or "cert"), "privateKey", "publicKey", or "csr".
		*m: getprivatekey		&& Introduced in version 9.5.0.49. Returns the Nth private key from the PEM. The first private key is at index 0. Returns Nothing on failure.
		*m: getpublickey		&& Introduced in version 9.5.0.49. Returns the Nth public key from the PEM. The first public key is at index 0. Returns Nothing on failure.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat PEM HeartBeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat PEM LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat PEM LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat PEM LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat PEM LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat PEM LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat PEM LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat PEM LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadp7b		&& Introduced in version 9.5.0.49. Loads the PEM from the contents of an in-memory PKCS7 container (.p7b). Returns 1 for success, 0 for failure.
		*m: loadp7basync		&& Introduced in version 9.5.0.49. Creates an asynchronous task to call the LoadP7b method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: loadp7bfile		&& Introduced in version 9.5.0.49. Loads the contents of a PKCS7 container (.p7b file). Returns 1 for success, 0 for failure.
		*m: loadp7bfileasync		&& Introduced in version 9.5.0.49. Creates an asynchronous task to call the LoadP7bFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: loadpem		&& Introduced in version 9.5.0.49. Loads the PEM from a PEM string. If encrypted, then the password is required for decryption. Otherwise, an empty string (or any string) may be passed for the password. Returns 1 for success, 0 for failure.
		*m: loadpemasync		&& Introduced in version 9.5.0.49. Creates an asynchronous task to call the LoadPem method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: loadpemfile		&& Introduced in version 9.5.0.49. Loads the PEM from a PEM file. If encrypted, then the password is required for decryption. Otherwise, an empty string (or any string) may be passed for the password. Returns 1 for success, 0 for failure.
		*m: loadpemfileasync		&& Introduced in version 9.5.0.49. Creates an asynchronous task to call the LoadPemFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: numcerts_access		&& Access method used to retrieve the Chilkat PEM NumCerts property.
		*m: numcerts_assign		&& Assign method used to hold a reference to the NumCerts property.
		*m: numcrls_access		&& Access method used to retrieve the Chilkat PEM NumCRLs property.
		*m: numcrls_assign		&& Assign method used to hold a reference to the NumCRLs property.
		*m: numcsrs_access		&& Access method used to retrieve the Chilkat PEM NumCSRs property.
		*m: numcsrs_assign		&& Assign method used to hold a reference to the NumCSRs property.
		*m: numprivatekeys_access		&& Access method used to retrieve the Chilkat PEM NumPrivateKeys property.
		*m: numprivatekeys_assign		&& Assign method used to hold a reference to the NumPrivateKeys property.
		*m: numpublickeys_access		&& Access method used to retrieve the Chilkat PEM NumPublicKeys property.
		*m: numpublickeys_assign		&& Assign method used to hold a reference to the NumPublicKeys property.
		*m: privatekeyat		&& Introduced in version 11.0.0. Returns in privKey the Nth private key from the PEM. The first private key is at index 0. Returns 1 for success, 0 for failure.
		*m: privatekeyformat_access		&& Access method used to retrieve the Chilkat PEM PrivateKeyFormat property.
		*m: privatekeyformat_assign		&& Assign method used to hold a reference to the PrivateKeyFormat property.
		*m: publickeyat		&& Introduced in version 11.0.0. Returns in pubKey the Nth public key from the PEM. The first public key is at index 0. Returns 1 for success, 0 for failure.
		*m: publickeyformat_access		&& Access method used to retrieve the Chilkat PEM PublicKeyFormat property.
		*m: publickeyformat_assign		&& Assign method used to hold a reference to the PublicKeyFormat property.
		*m: removecert		&& Introduced in version 9.5.0.49. Removes the Nth certificate from the PEM. The first certificate is at index 0. Returns 1 for success, 0 for failure.
		*m: removeprivatekey		&& Introduced in version 9.5.0.49. Removes the Nth private key from the PEM. The first private key is at index 0. Returns 1 for success, 0 for failure.
		*m: tojks		&& Introduced in version 9.5.0.49. Converts the PEM to JKS and returns the Java KeyStore object. If the alias is non-empty, the 1st object (private key or certificate) will use the alias, and all others (if any) will receive auto-generated aliases.
		*m: tojksobj		&& Introduced in version 11.0.0. This function converts this PEM to a Java KeyStore (JKS) object and stores it in jksObj. Returns 1 for success, 0 for failure.
		*m: topem		&& Introduced in version 9.5.0.47. Write the PFX to a PEM formatted string. The resultant PEM will contain the private key, as well as the certs in the chain of authentication (or whatever certs are available in the PFX).
		*m: topemex		&& Introduced in version 9.5.0.49. Write the PFX to a PEM formatted string. If extendedAttrs is 1, then extended properties (Bag Attributes and Key Attributes) are output. If noKeys is 1, then no private keys are output.
		*m: topfx		&& Introduced in version 9.5.0.49. Converts the PEM to PKCS12 and returns the PFX object. The PFX object has method for saving to a file, exporting to an encoded string, converting to a JKS (Java Keystore), or even converting back to PEM.
		*m: topfxobj		&& Introduced in version 11.0.0. Converts this PEM object, which must contain at least one private key, to PKCS12 and returns the PFX in pfxObj. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat PEM VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: appendmode		&& Introduced in version 9.5.0.49. When set to 1, each of the Load* methods appends to the current contents of this PEM object. When set to 0, a Load* method replaces the contents of this PEM object. The default is 0.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: heartbeatms		&& Introduced in version 9.5.0.49. This is the number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any event-enabled methods prior to completion.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcerts		&& Introduced in version 9.5.0.49 The number of certificates in the loaded PEM. To get the 1st certificate, call GetCert(0).
		*p: numcrls		&& Introduced in version 9.5.0.77. The number of certificate revocation lists (CRLs) in the loaded PEM.
		*p: numcsrs		&& Introduced in version 9.5.0.50. The number of certificate signing requests (CSRs) in the loaded PEM.
		*p: numprivatekeys		&& Introduced in version 9.5.0.49. The number of private keys in the loaded PEM. To get the 1st private key, call GetPrivateKey(0).
		*p: numpublickeys		&& Introduced in version 9.5.0.49. The number of public keys in the loaded PEM. To get the 1st public key, call GetPublicKey(0).
		*p: privatekeyformat		&& Introduced in version 9.5.0.49. Controls the format to be used for unencrypted private keys when writing a PEM. Possible values are "pkcs1" and "pkcs8". (OpenSSL typically uses the "pkcs8" format.)
		*p: publickeyformat		&& Introduced in version 9.5.0.49. Controls the format to be used for public keys when writing a PEM. Possible values are "pkcs1" and "pkcs8". (OpenSSL typically uses the "pkcs8" format.) The default is "pkcs8".
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		appendmode = 0
		cchilkatclass = Pem
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		heartbeatms = 0
		iinstancepatch = 49
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "pem"
		numcerts = 0
		numcrls = 0
		numcsrs = 0
		numprivatekeys = 0
		numpublickeys = 0
		privatekeyformat = pkcs8
		publickeyformat = pkcs8
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addcert		&& Introduced in version 9.5.0.49. Adds a certificate, and potentially the certs in its chain of authentication to the PEM. If includeChain is 1, then certificates in the cert's chain of authentication up to and including the root are automatically added.
		*==============================================================================
		* Method:            AddCert
		* Purpose:           Adds a certificate, and potentially the certs 
		*                    in its chain of authentication to the PEM.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tuIncludeChain, whether or not the cerficate has a private key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		** 
		** Adds a certificate, and potentially the certs in its chain of authentication to the PEM. 
		** If includeChain is 1, then certificates in the cert's chain of authentication 
		** up to and including the root are automatically added.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, tuIncludeChain AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, luReturn AS Unknown, ;
		liIncludeChain AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeChain, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeChain = .LogicalToBit(m.tuIncludeChain)
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddCert(m.loChilkatCert, m.liIncludeChain) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		       m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE additem		&& Introduced in version 9.5.0.59. Adds a certificate, private key, public key, or csr to the PEM. The possible values for itemType are "certificate" (or "cert"), "privateKey", "publicKey", or "csr".
		*==============================================================================
		* Method:            AddItem
		* Purpose:           Adds a certificate, private key, public key, or csr to the PEM.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcItemType -- the item type to add.
		*                    tcEncoding -- the encoding for the itemdata.
		*                    tcItemData -- the encoded ASN.1 data 
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		**
		** Adds a certificate, private key, public key, or csr to the PEM. 
		** The possible values for itemType are "certificate" (or "cert"), 
		** "privateKey", "publicKey", or "csr". The encoding can be "Base64", 
		** "modBase64", "Base32", "QP" (for quoted-printable), "URL" (for url-encoding), 
		** "Hex", "url_oauth", "url_rfc1738", "url_rfc2396", and "url_rfc3986". 
		** The itemData contains the ASN.1 data in string format according to the encoding specified in encoding.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcItemType AS Character, tcEncoding AS Character, tcItemData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 59
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddItem(m.tcItemType, m.tcEncoding, m.tcItemData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addp7b		&& Introduced in version 11.0.0. Loads the PEM from the contents of an PKCS7 container (.p7b) contained in bd. Common Use: Used to bundle intermediate and root certificates for things like SSL certificate chains. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddP7B
		* Purpose:           Loads the PEM from the contents of an PKCS7 container (.p7b) contained in bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Loads the PEM from the contents of an PKCS7 container (.p7b) contained in bd.
		**
		** A .p7b (or .p7c) file contains a PKCS#7 container, which may include:
		**
		** 1) One or more X.509 certificates (a certificate chain)
		** 2) Optionally, CRLs (Certificate Revocation Lists)
		** 3) No private key
		**
		** Common Use: Used to bundle intermediate and root certificates 
		** for things like SSL certificate chains.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData 
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddP7B(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addprivatekey		&& Introduced in version 9.5.0.49. Adds a private key to the PEM object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddPrivateKey
		* Purpose:           Adds a private key to the PEM object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
