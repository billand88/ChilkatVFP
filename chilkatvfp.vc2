	PROCEDURE totp		&& Introduced in version 9.5.0.77. Implements RFC 6238: TOTP: Time-Based One-Time Password Algorithm.
		*==============================================================================
		* Method:            TOTP
		* Purpose:           Implements RFC 6238: TOTP: Time-Based One-Time Password Algorithm.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedSecret -- the path to the file to hash.
		*                    tcEncoding -- the encoding of the encoded secret 
		*                    tcUnixTime0 -- the 8-byte counter in hexidecimal format.
		*                    tcUnixTimeNow -- the number of digits to return
		*                    tiTimeStep -- the number of decimal digits to return.
		*                    tiNumDigits -- the hash algorithm used.
		*                    tiTruncationOffset -- the truncation offset.
		*                    tcHashAlgorithm -- the hash algorithm to use
		* Returns:           The generated password.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.77
		**
		** Implements RFC 6238: TOTP: Time-Based One-Time Password Algorithm. 
		** The arguments to this method are:
		**
		**   secret: The shared secret in an enocded representation such as base64, hex, ascii, etc.
		**   secretEnc: The encoding of the shared secret, such as "base64"
		**   t0: The Unix time to start counting time steps. It is a number in decimal string form. 
		**       A Unix time is the number of seconds elapsed since midnight UTC of January 1, 1970. 
		**       "0" is a typical value used for this argument.
		**   tNow: The current Unix time in decimal string form. To use the current system date/time, 
		**         pass an empty string for this argument.
		**   tStep: The time step in seconds. A typical value is 30. Note: Both client and server 
		**          must pre-agree on the secret, the t0, and the tStep.
		**   numDigits: The number of decimal digits to return.
		**   truncOffset: Normally set this to -1 for dynamic truncation. 
		**                Otherwise can be set in the range 0..15.
		**   hashAlg: Normally set to "sha1". Can be set to other hash algorithms such as 
		**            "sha256", "sha512", etc.
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Fixed for Version 90: Fixed issues with certain Base32 keys.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncodedSecret AS Character, tcEncoding AS Character, ;
		tcUnixTime0 AS Character, tcUnixTimeNow AS Character, tiTimeStep AS Integer, ;
		tiNumDigits AS Integer, tiTruncationOffset AS Integer, tcHashAlgorithm AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcPassword AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcPassword = []
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcPassword = m.loChilkatObject.TOTP(m.tcEncodedSecret, ;
		        m.tcEncoding, m.tcUnixTime0, m.tcUnixTimeNow, m.tiTimeStep, ;
		        m.tiNumDigits, m.tiTruncationOffset, m.tcHashAlgorithm)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcPassword
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE trimendingwith		&& Trim a string ending with a specific substring until the string no longer ends with that substring. Returns Nothing on failure.
		*==============================================================================
		* Method:            TrimEndingWith
		* Purpose:           Trim a string ending with a specific substring 
		*                    until the string no longer ends with that substring.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcStringToTrim -- the string to trim.
		*                    tcEndingStringToTrim -- the hash algorithm used for the hash.
		* Returns:           The trimmed string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Trim a string ending with a specific substring until the string 
		** no longer ends with that substring.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcStringToTrim AS Character, tcEndingStringToTrim AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcTrimmedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcTrimmedString = ;
		      m.loChilkatObject.TrimEndingWith(m.tcStringToTrim, m.tcEndingStringToTrim)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcTrimmedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat Crypt2 UncommonOptions  property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        06/30/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.83
		** 
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty.
		**
		** Can be set to a list of the following comma separated keywords:
		**
		** "UseConstructedOctets" - Introduced in v9.5.0.83. When creating opaque CMS signatures 
		** (signatures that embed the data being signed), will use the "constructed octets" 
		** form of the ASN.1 that holds the data. This is to satify some validators 
		** that are brittle/fragile/picky and require a particular format, 
		** such as for the ICP-Brazil Digital Signature Standard.
		**
		** Introduced in version 95: NoCmsAlgorithmProtection. It's required to send 
		** P7M/P7S files to https://vol.postecert.poste.it/verificatore/it with successful validation.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Crypt2 UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        06/30/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		lcValidationMethod = [UncommonOptions_Crypt2]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE unlockcomponent		&& Undocumented method! Unlocks the component. This must be called once prior to calling any other method.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE usecertvault		&& Introduced in version 9.5.0.40. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*==============================================================================
		* Method:            UseCertVault
		* Purpose:           Adds an XML certificate vault to the object's internal list 
		*                    of sources to be searched for certificates and private keys.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXMLCertVault, a Chilkat XML Certificate Vault object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Adds an XML certificate vault to the object's internal list of sources to be searched 
		** for certificates and private keys when encrypting/decrypting or signing/verifying. 
		** Unlike the AddPfxSourceData and AddPfxSourceFile methods, 
		** only a single XML certificate vault can be used. 
		** If UseCertVault is called multiple times, only the last certificate vault will be used, 
		** as each call to UseCertVault will replace the certificate vault provided in previous calls.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatXMLCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterXmlCertVault AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXmlCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterXmlCertVault = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXmlCertVault)
		
		      loChilkatXmlCertVault = m.loParkParameterXmlCertVault.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseCertVault(m.loChilkatXMLCertVault) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatXmlCertVault = m.loParkParameterXmlCertVault.SetObject(;
		      m.toChilkatXmlCertVault, m.loChilkatXmlCertVault)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatXMLCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loParkParameterXmlCertVault = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXmlCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uufilename_access		&& Access method used to retrieve the Chilkat Crypt2 UUFileName  property.
		*==============================================================================
		* Method:            UUFileName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 UUFileName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UUFileName
		* Date Added:        06/30/2022
		*==============================================================================
		
		** 
		** When UU encoding, this is the filename to be embedded in UU encoded output. 
		** The default is "file.dat". When UU decoding, 
		** this is the filename found in the UU encoded input.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

