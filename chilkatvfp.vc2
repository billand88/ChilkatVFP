		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setpayload		&& ntroduced in version 9.5.0.66. Sets the JWS payload from the contents of payload. The charset specifies the byte representation to be used for the string that is to be the payload. (For example, "utf-8", "windows-1252", "utf-16", etc.).
		*==============================================================================
		* Method:            SetPayload
		* Purpose:           Sets the JWS payload from the contents of payload.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPayload, the payload to set.
		*                    tcCharset, the charset of the payload.
		*                    tuIncludeBOM, whether or not to include the BOM.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Sets the JWS payload from the contents of payload. 
		** The charset specifies the byte representation to be used 
		** for the string that is to be the payload. 
		** (For example, "utf-8", "windows-1252", "utf-16", etc.). 
		** If includeBom is 1, then the byte-order-mark (BOM), also known as preamble, 
		** if one exists for the given charset, is included in the payload. 
		** Normally, includeBom should be set to 0.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPayload AS Character, ;
		tcCharset AS Character, tuIncludeBOM AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liIncludeBOM AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeBOM, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeBOM = .LogicalToBit(m.tuIncludeBOM)
		
		      TRY
		
		        STORE m.loChilkatObject.SetPayload(m.tcPayload, ;
		        m.tcCharset, m.liIncludeBOM) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setpayloadbd		&& Introduced in version 9.5.0.66. Sets the JWS payload from the contents of binData. Returns 1 for success, 0 for failure.
