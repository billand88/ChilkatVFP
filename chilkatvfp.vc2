		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE contains		&& Introduced in version 9.5.0.58. Returns 1 if the str is contained within this object. For case sensitive matching, set caseSensitive equal to 1. For case-insensitive, set caseSensitive equal to 0.
		*==============================================================================
		* Method:            Contains
		* Purpose:           Returns 1 if the str is contained within this object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the string to test
		*                    tuCaseSensitivity, the case sensitivity setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58.
		**
		** Returns 1 if the str is contained within this object. 
		** For case sensitive matching, set caseSensitive equal to 1. 
		** For case-insensitive, set caseSensitive equal to 0.
		** 
		
		LPARAMETERS tcString AS Character, tuCaseSensitivity AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown, loException AS Exception, ;
		liCaseSensitivity AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild, m.liCaseSensitivity
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCaseSensitivity = .LogicalToBit(m.tuCaseSensitivity)
		
		      TRY
		
		        STORE m.loChilkatObject.Contains(m.tcString, m.liCaseSensitivity) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
