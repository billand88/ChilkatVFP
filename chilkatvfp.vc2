	HIDDEN PROCEDURE pkcspadding_access		&& Access method used to retrieve the Chilkat RSA PKCSPadding property.
		*==============================================================================
		* Method:            PkcsPadding_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat RSA PkcsPadding property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PkcsPadding
		* Date Added:        05/08/2025
		*==============================================================================
		
		** 
		** Introduced in version 11.0.0
		** 
		** This property controls padding for both signing and encryption. 
		** The default value is true, which is to use PKCS#1 v1.5 padding. 
		** If set to false, then PSS padding is used for signatures 
		** and OAEP padding is used for encryption.
		**
		** This property replaces the decremented OaepPadding property. 
		** Until the OaepPadding property is removed, setting this property 
		** will automatically set OaepPadding to the opposite, and vice-versa. 
		** This is to maintain backward compatibility until applications 
		** can switch to using this new property.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, ;
		m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE pkcspadding_assign		&& Assign method used to hold a reference to the PKCSPadding property.
		*==============================================================================
		* Method:            PkcsPadding_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat RSA PkcsPadding property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the PkcsPadding property.
		* Returns:           
		* Date Added:        05/08/2025
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE psssaltlen_access		&& Access method used to retrieve the Chilkat RSA PSSSaltLen property.
		*==============================================================================
		* Method:            PSSSaltLen_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat RSA PSSSaltLen property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PSSSaltLen
		* Date Added:        07/11/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Selects the PSS salt length when RSASSA-PSS padding is selected for signatures. 
		** The default value is -1 to indicate that the length of the hash function should be used. 
		** For example, if the hash function is SHA256, then the PSS salt length will be 32 bytes. 
		** Can be optionally set to a value such as 20 if a specific salt length is required. 
		** This property should normally remain at the default value.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE psssaltlen_assign		&& Assign method used to hold a reference to the PSSSaltLen property.
		*==============================================================================
		* Method:            PSSSaltLen_Assign
		* Purpose:           Assign method used to hold a reference to the PSSSaltLen property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the PSSSaltLen property.
		* Returns:           
		* Date Added:        07/11/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 80
		
		lcValidationMethod = [PSSSaltLen]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE setx509cert		&& Introduced in version 9.5.0.73. Provides the private or public key indirectly through a certificate. This method is especially useful on Windows computers where the private key is installed as non-exportable (such as on a hardware token).
		*==============================================================================
		* Method:            SetX509Cert
		* Purpose:           Provides the private or public key indirectly through a certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/11/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.73
		**
		** Provides the private or public key indirectly through a certificate. 
		** This method is especially useful on Windows computers where the private key 
		** is installed as non-exportable (such as on a hardware token).
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, luReturn AS Unknown, ;
		liUsePrivateKey AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUsePrivateKey, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 73
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetX509Cert(m.loChilkatCert, m.liUsePrivateKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signbd		&& Introduced in version 9.5.0.77. Creates an RSA digital signature by hashing the contents of bdData and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512".
		*==============================================================================
		* Method:            SignBd
		* Purpose:           Creates an RSA digital signature by hashing 
		*                    the contents of bdData and then signing the hash.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinDataIn, a Chilkat Binary Data object.
		*                    tcHashAlgorithm, the hash algorithm used to decrypt.
		*                    toChilkatBinDataSigned, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Creates an RSA digital signature by hashing the contents of bdData 
		** and then signing the hash. The hash algorithm is specified by hashAlgorithm, 
		** which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". 
		** The resulting signature is returned in bdSig.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0. 
		** (The LittleEndian property should also be set to 0 to match Amazon web services, such as CloudFront.)
		** 
		** A private key is required to create digital signatures.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		** 
		
		LPARAMETERS toChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, ;
		tcHashAlgorithm AS Character, toChilkatBinDataSigned AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, liReturn AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinDataIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown, ;
		loParkParameterBinDataSigned AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataSigned AS CHILKAT_BINDATA_COM_CALL, loException AS Exception
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataIn, m.loChilkatBinDataIn, ;
		m.loParkParameterBinDataSigned, m.loChilkatBinDataSigned
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinDataIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataIn)
		
		      loParkParameterBinDataSigned = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataSigned)
		
		      loChilkatBinDataIn = m.loParkParameterBinDataIn.GetObject()
		      loChilkatBinDataSigned = m.loParkParameterBinDataSigned.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SignBd(m.loChilkatBinDataIn, ;
		        m.tcHashAlgorithm, m.loChilkatBinDataSigned) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinDataIn = ;
		      m.loParkParameterBinDataIn.SetObject(m.toChilkatBinDataIn, m.loChilkatBinDataIn)
		
		      toChilkatBinDataSigned = m.loParkParameterBinDataSigned.SetObject(;
		      m.toChilkatBinDataSigned, m.loChilkatBinDataSigned)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataIn, m.loChilkatBinDataIn, ;
		m.loParkParameterBinDataSigned, m.loChilkatBinDataSigned
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  toChilkatBinDataIn = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatBinDataSigned = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinDataIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinDataSigned = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinDataIn = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatBinDataSigned = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signbytes		&& Creates an RSA digital signature by hashing binaryData and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*==============================================================================
		* Method:            SignBytes
		* Purpose:           Creates an RSA digital signature by hashing binaryData and then signing the hash.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the binary data to hash.
		*                    tcHashAlgorithm, the hash algorithm used to decrypt.
		* Returns:           The binary signature bytes.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Creates an RSA digital signature by hashing binaryData and then signing the hash. 
		** The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", 
		** "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0. 
		** (The LittleEndian property should also be set to 0 to match Amazon web services, such as CloudFront.)
		** 
		** A private key is required to create a digital signature.
		** 
		** An error is indicated when a byte array of 0 length is returned.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		** 
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		** 
		
		LPARAMETERS tqData AS VarBinary, tcHashAlgorithm AS Character
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, lqSignatureBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqSignatureBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqSignatureBytes = m.loChilkatObject.SignBytes(m.tqData, m.tcHashAlgorithm)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqSignatureBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signbytesenc		&& Creates an RSA digital signature by hashing binaryData and then signing the hash. The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*==============================================================================
		* Method:            SignBytesENC
		* Purpose:           Creates an RSA digital signature by hashing binaryData and then signing the hash.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the binary data to hash.
		*                    tcHashAlgorithm, the hash algorithm used to decrypt.
		* Returns:           The encoded signature.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Creates an RSA digital signature by hashing binaryData and then signing the hash. 
		** The hash algorithm is specified by hashAlgorithm, which may be "SHA-1", "MD5", 
		** "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0. 
		** (The LittleEndian property should also be set to 0 to match Amazon web services, such as CloudFront.)
		** 
		** A private key is required to create a digital signature.
		** 
		** An error is indicated when a byte array of 0 length is returned.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		** 
		** 
		
		LPARAMETERS tqData AS VarBinary, tcHashAlgorithm AS Character
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, lcEncodedSignature AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedSignature = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedSignature = m.loChilkatObject.SignBytesENC(m.tqData, m.tcHashAlgorithm)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedSignature
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE signhash		&& The same as the SignBytes method, except the hash to be signed is passed directly. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
