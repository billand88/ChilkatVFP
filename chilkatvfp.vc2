	PROCEDURE setaad		&& Introduced in version 9.5.0.66. Sets the optional Additional Authenticated Data. This is only used for non-compact serializations.
		*==============================================================================
		* Method:            SetAAD
		* Purpose:           Sets the optional Additional Authenticated Data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAADString, the AAD data as a string.
		*                    tcCharset, the charset of the AAD data.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Sets the optional Additional Authenticated Data. 
		** This is only used for non-compact serializations. 
		** The charset specifies the character encoding (such as "utf-8") to be used 
		** for the byte representation for the additional authenticated data.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcAADString AS Integer, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JWE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild  
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetAAD(m.tcAADString, m.tcCharset) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setaadbd		&& Introduced in version 9.5.0.66. Sets the optional Additional Authenticated Data. This is only used for non-compact serializations. This method provides a way for binary (non-text) additional authenticated data to be used.
		*==============================================================================
		* Method:            SetAADBd
