		** End design time IntelliSense test
	ENDPROC

	PROCEDURE xmlrpcputasync		&& Creates an asynchronous task to call the XmlRpcPut method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            XMLRPCPutAsync
		* Purpose:           Creates an asynchronous task to call
		*                    the XMLRPCPut method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURLEndpoint -- the URL to post to
		*                    tcXMLIn -- the XML string
		* Returns:           Chilkat Task object or NULL
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the XMLRPCPut method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURLEndpoint AS Character, tcXMLIn AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.XMLRPCPutAsync(m.tcURLEndpoint, m.tcXMLIn)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS httpcurl AS ibasechilkat OF "chilkatvfp.vcx" 		&& A class for running curl commands within your application. Mirrors the curl command syntax. It is not derived from curl/libcurl, and does not wrap libcurl.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addfunction		&& Introduced in version 11.5.0. Adds a named curl function that can be used in dependency resolution. Inputs required by the curl function are indicated by the variable names enclosed in {{ and }}.
		*m: addoutput		&& Introduced in version 11.5.0. Adds a defined output for a dependency resolution curl function previously defined by calling AddFunction.
		*m: addoutput2		&& Introduced in version 11.5.0. Adds or updates an output variable definition for a dependency-resolution curl function previously created by calling AddFunction. Returns 1 for success, 0 for failure.
		*m: addtargetoutput		&& Introduced in version 11.5.0. Adds an automatically mapped variable for the target curl command.
		*m: cleartargetoutput		&& Introduced in version 11.5.0. Clears (undefines) the target output for the specified varName. If varName equals "*", then all target outputs are cleared.
		*m: clearvar		&& Introduced in version 11.5.0. Undefines the variable with the specified name. If varName equals "*", then all variables are cleared. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat HttpCurl DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: doyourthing		&& Introduced in version 11.5.0. Runs a the curl command specified in targetCurl. Returns success (1) if a response was received, in which case the response status code will be available in StatusCode
		*m: doyourthingasync		&& Introduced in version 11.5.0. Creates an asynchronous task to call the DoYourThing method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: enablebodyvars_access		&& Access method used to retrieve the Chilkat HttpCurl EnableBodyvars property.
		*m: enablebodyvars_assign		&& Assign method used to hold a reference to the EnableBodyVars property.
		*m: examineplan		&& Introduced in version 11.5.0. Used for debugging. Returns in json the plan of execution that would occur for the curl based on the variables that are either unknown or already known.
		*m: failedcurl_access		&& Access method used to retrieve the Chilkat HttpCurl FailedCurl property.
		*m: failedcurl_assign		&& Assign method used to hold a reference to the FailedCurl property.
		*m: failreason_access		&& Access method used to retrieve the Chilkat HttpCurl FailReason property.
		*m: failreason_assign		&& Assign method used to hold a reference to the FailReason property.
		*m: getallvars		&& Introduced in version 11.5.0. Returns all defined variables in json.
		*m: getresponsebd		&& Introduced in version 11.5.0. Writes to bd the HTTP response body from the last call to DoYourThing. Returns 1 for success, 0 for failure.
		*m: getresponsejarr		&& Introduced in version 11.5.0. Writes to jarr the HTTP response body from the last call to DoYourThing. Returns 1 for success, 0 for failure.
		*m: getresponsejson		&& Introduced in version 11.5.0. Writes to json the HTTP response body from the last call to DoYourThing. Returns 1 for success, 0 for failure.
		*m: getresponsesb		&& Introduced in version 11.5.0. Writes to sb the HTTP response body from the last call to DoYourThing. Returns 1 for success, 0 for failure.
		*m: getresponsexml		&& Introduced in version 11.5.0. Writes to xml the HTTP response body from the last call to DoYourThing. Returns 1 for success, 0 for failure.
		*m: getvar		&& Introduced in version 11.5.0. Retrieves the current value of the variable specified by varName.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat HttpCurl HeartBeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat HttpCurl LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat HttpCurl LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat HttpCurl LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat HttpCurl LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat HttpCurl LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat HttpCurl LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat HttpCurl LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: responsebodystr_access		&& Access method used to retrieve the Chilkat HttpCurl ResponseBody property.
		*m: responsebodystr_assign		&& Assign method used to hold a reference to the ResponseBody property.
		*m: responsefilepath_access		&& Access method used to retrieve the Chilkat HttpCurl ResponseFilePath property.
		*m: responsefilepath_assign		&& Assign method used to hold a reference to the ResponseFilePath property.
		*m: setauth		&& Introduced in version 11.5.0. Sets authorization information that is applied to all calls to DoYourThing. Returns 1 for success, 0 for failure.
		*m: setvar		&& Introduced in version 11.5.0. Sets the value of a variable to be replaced in curl commands. Variable names are enclosed in {{ and }} and can occur in the path, query params, or the body of the request. Returns 1 for success, 0 for failure.
		*m: statuscode_access		&& Access method used to retrieve the Chilkat HttpCurl StatusCode property.
		*m: statuscode_assign		&& Assign method used to hold a reference to the StatusCode property.
		*m: torawrequest		&& Introduced in version 11.5.0. Used for debugging purposes.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat HTTPCurl UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: vardefined		&& Introduced in version 11.5.0. Returns 1 if the varName is defined, otherwise returns 0. Setting varName to "!" checks whether all target output variables have been defined.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat HttpCurl VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: enablebodyvars		&& Introduced in version 11.5.0. Enables variable substitution in the body of the request. The default value is 1.
		*p: failedcurl		&& Introduced in version 11.5.0. Set to the specific curl command in the execution plan that failed.
		*p: failreason		&& Introduced in version 11.5.0. Set to an integer value indicating the reason for failure for the methods DoYourThing and ExaminePlan
		*p: heartbeatms		&& Introduced in version 11.5.0. Specifies the interval, in milliseconds, between AbortCheck event callbacks. This allows an application to periodically decide whether a long-running operation should be aborted. The default value is 0.
		*p: lastbinaryresult		&& This property is mainly used in SQL Server stored procedures to retrieve binary data from the last method call that returned binary data. It is only accessible if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides HTML-formatted information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lasterrortext		&& Provides plain text information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lasterrorxml		&& Provides XML-formatted information about the last called method or property. If a method call fails or behaves unexpectedly, check this property for details. Note that information is available regardless of the method call's success.
		*p: lastmethodsuccess		&& Indicates the success or failure of the most recent method call: 1 means success, 0 means failure. This property remains unchanged by property setters or getters.
		*p: laststringresult		&& In SQL Server stored procedures, this property holds the string return value of the most recent method call that returns a string. It is accessible only when Chilkat.Global.KeepStringResult is set to TRUE.
		*p: laststringresultlen		&& The length, in characters, of the string contained in the LastStringResult property.
		*p: responsebodystr		&& Introduced in version 11.5.0. Returns the HTTP response body from the last call to DoYourThing .
		*p: responsefilepath		&& Introduced in version 11.5.0. Set this property to the path of a file to stream the response body to a file. If the response is streamed to a file, it will not be available in ResponseBodyStr , GetResponseSb , or GetResponseBd .
		*p: statuscode		&& Introduced in version 11.5.0. Returns the HTTP status code from the last call to DoYourThing. A value of 0 indicates no response header was received
		*p: uncommonoptions		&& Introduced in version 11.5.0. Provides a comma-separated list of uncommon option keywords. This property defaults to an empty string and should normally remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = HttpCurl
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		enablebodyvars = 1
		failedcurl = 
		failreason = 0
		heartbeatms = 0
		iinstancemajor = 11
		iinstanceminor = 5
		lastbinaryresult = <fb2p_value>.NULL.&#13;</fb2p_value>
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 0
		laststringresult = 
		laststringresultlen = 0
		Name = "httpcurl"
		responsebodystr = 
		responsefilepath = 
		statuscode = 0
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addfunction		&& Introduced in version 11.5.0. Adds a named curl function that can be used in dependency resolution. Inputs required by the curl function are indicated by the variable names enclosed in {{ and }}.
		*==============================================================================
		* Method:            AddFunction
		* Purpose:           Adds a named curl function that can be used in dependency resolution.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFunctionName - the function name to add
		*                    tcCurl, the Curl code to be resolved.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/15/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Adds a named curl function that can be used in dependency resolution. 
		** Inputs required by the curl function are indicated 
		** by the variable names enclosed in {{ and }}. 
		** Outputs are defined in one or more calls to AddOutput .
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFunctionName AS Character, tcCurl AS Character 
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddFunction(m.tcFunctionName, m.tcCurl) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.HttpCurl])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE addoutput		&& Introduced in version 11.5.0. Adds a defined output for a dependency resolution curl function previously defined by calling AddFunction.
		*==============================================================================
		* Method:            AddOutput
		* Purpose:           Adds a defined output for a dependency resolution curl 
		*                    function previously defined by calling AddFunction.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFunctionName - the function name to call
		*                    tcJsonPath, the response body JSON path where 
		*                    the variable name's value is located.
		*                    tcVariableName, the variable name.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/15/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Adds a defined output for a dependency resolution curl function 
		** previously defined by calling AddFunction. The jsonPath is the JSON path 
		** in the JSON response body where the varName's value is located.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFunctionName AS Character, tcJsonPath AS Character, tcVariableName AS Character  
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddOutput(m.tcFunctionName, ;
		        m.tcJsonPath, m.tcVariableName) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.HttpCurl])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE addoutput2		&& Introduced in version 11.5.0. Adds or updates an output variable definition for a dependency-resolution curl function previously created by calling AddFunction. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddOutput2
		* Purpose:           Adds or updates an output variable definition for a 
		*                    dependency-resolution curl function previously created 
		*                    by calling AddFunction.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFunctionName - the JSON path identifying 
		*                    the array of records within the JSON response.
		*                    tcArrayPath - the JSON path identifying the array 
		*                    of records within the JSON response.
		*                    tcWherePath - a relative JSON path within each array element 
		*                    used to locate the matching record.
		*                    tcWhereValue - the value to match against the 
		*                    JSON value found at wherePath.
		*                    tuCaseSensitive - whether or not the comparison 
		*                    between whereValue and the JSON value is case-sensitive. 
		*                    tcSubPath - a relative JSON path within 
		*                    the matched array element identifying the value to extract.
		*                    tcVariableName - the name of the variable 
		*                    that will receive the extracted value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/03/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Adds or updates an output variable definition for a dependency-resolution 
		** curl function previously created by calling AddFunction. 
		** Use this method when the curl response is JSON containing an array of objects, 
		** and a value needs to be extracted from one specific array element.
		** 
		** The method searches the array located at arrayPath, 
		** finds the array element where the value at wherePath matches whereValue, 
		** and then extracts the value at subPath.
		** The extracted value is assigned to the variable named by varName.
		** 
		** The wherePath and subPath values are paths relative to each individual array element. 
		** The comparison between whereValue and the JSON value found at wherePath 
		** is either case-sensitive or case-insensitive depending on the value of caseSensitive.
		** 
		** Parameters
		** 
		**   funcName — The name of the curl function previously added by calling AddFunction. 
		**   The output definition is associated with this function.
		**   arrayPath — The JSON path identifying the array of records within the JSON response.
		**   wherePath — A relative JSON path within each array element used to locate the matching record.
		**   whereValue — The value to match against the JSON value found at wherePath.
		**   caseSensitive — If 1, the comparison between whereValue a
		**   and the JSON value is case-sensitive. If 0, the comparison is case-insensitive.
		**   subPath — A relative JSON path within the matched array element identifying the value to extract.
		**   varName — The name of the variable that will receive the extracted value.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFunctionName AS Character, tcArrayPath AS Character, ;
		tcWherePath AS Character, tcWhereValue AS Character, tuCaseSensitive AS Unknown, ;
		tcSubPath AS Character, tcVariableName AS Character
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		liCaseSensitive AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		 
		      liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		      TRY
		
		        STORE m.loChilkatObject.AddOutput2(m.tcFunctionName, ;
		        m.tcArrayPath, m.tcWherePath, m.tcWhereValue, ;
		        m.liCaseSensitive, m.tcSubPath, m.tcVariableName) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.HttpCurl])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE addtargetoutput		&& Introduced in version 11.5.0. Adds an automatically mapped variable for the target curl command.
		*==============================================================================
		* Method:            AddTargetOutput
		* Purpose:           Adds an automatically mapped variable for the target curl command.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJsonPath - the Json path to extract.
		*                    tcVariableName, the variable to be mapped.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/15/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Adds an automatically mapped variable for the target curl command. 
		** When a JSON response is received from a curl request, 
		** the value at the JSON path specified by jsonPath is extracted (if present) 
		** and assigned to the variable named by varName.
		** 
		** This is useful in common workflows where one request returns an identifier 
		** (such as an `id`) that must be reused in a subsequent curl request.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcJsonPath AS Character, tcVariableName AS Character 
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddTargetOutput(m.tcJsonPath, m.tcVariableName) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.HttpCurl])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        06/02/2026
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.5.0
		
		  A new Chilkat class has been added: HttpCurl
		
		  The Chilkat.HttpCurl class executes curl commands and can automatically resolve dependent values needed by a request.
		
		  Variables such as {{access_token}}, {{site_id}}, or {{drive_id}} may appear 
		  in URLs, headers, query parameters, or request bodies. If a variable is not yet known, 
		  HttpCurl builds an execution plan from previously defined curl functions, 
		  runs the required steps, extracts values from JSON responses, and then executes the final target request.
		
		  Use AddFunction with AddOutput or AddOutput2 to define how prerequisite values are obtained. 
		  Use SetVar to provide known values, ClearVar to invalidate them, 
		  and ExaminePlan to inspect the dependency plan before running it.
		
		  After DoYourThing completes, the response can be read as text, binary data, 
		  JSON, XML, or streamed directly to a file. Diagnostic properties such as StatusCode, FailReason, 
		  FailedCurl, and LastErrorText help troubleshoot failures.
		
		  Note: Chilkat's HttpCurl is not derived from curl/libcurl, and does not wrap libcurl.
		
		ENDTEXT
		
		#ENDIF .F
	ENDPROC

