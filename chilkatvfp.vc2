	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat XML VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        05/10/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        05/10/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE zipcontent		&& Applies Zip compression to the content of an XML node and replaces the content with base64-encoded compressed data. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ZipContent
		* Purpose:           Applies Zip compression to the content of an XML node 
		*                    and replaces the content with base64-encoded compressed data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Applies Zip compression to the content of an XML node 
		** and replaces the content with base64-encoded compressed data.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ZipContent() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ziptree		&& Zip compresses the content and entire subtree rooted at the calling XML node and replaces the current content with base64-encoded Zip compressed data.
		*==============================================================================
		* Method:            ZipTree
		* Purpose:           Zip compresses the content and entire subtree 
		*                    with base64-encoded Zip compressed data. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Zip compresses the content and entire subtree 
		** rooted at the calling XML node and replaces the current content 
		** with base64-encoded Zip compressed data. 
		** The node and subtree can be restored by calling UnzipTree. 
		** Note that the node name and attributes are unaffected.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ZipTree() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS xmlcertvault AS ibasechilkat OF "chilkatvfp.vcx" 		&& Contains a collection of certificates and PFX files saved in an XML format.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addcert		&& Introduced in version 9.5.0.40. Adds a certificate to the XML vault. Returns 1 for success, 0 for failure.
		*m: addcertbinary		&& Introduced in version 9.5.0.40. Adds a certificate to the XML vault from any binary format, such as DER. Returns 1 for success, 0 for failure.
		*m: addcertchain		&& Introduced in version 9.5.0.40. Adds a chain of certificates to the XML vault. Returns 1 for success, 0 for failure.
		*m: addcertencoded		&& Introduced in version 9.5.0.40. Adds a certificate to the XML vault where certificate is passed directly from encoded bytes (such as Base64, Hex, etc.). The encoding is indicated by encoding. Returns 1 for success, 0 for failure.
		*m: addcertfile		&& Introduced in version 9.5.0.40. Adds a certificate to the XML vault. Returns 1 for success, 0 for failure.
		*m: addcertstring		&& Introduced in version 9.5.0.40. Adds a certificate from any string representation format such as PEM. Returns 1 for success, 0 for failure.
		*m: addpemfile		&& Introduced in version 9.5.0.40. Adds the contents of a PEM file to the XML vault. The PEM file may be encrypted, and it may contain one or more certificates and/or private keys.
		*m: addpfx		&& Introduced in version 9.5.0.40. Adds a PFX (PKCS12) to the XML vault. Returns 1 for success, 0 for failure.
		*m: addpfxbinary		&& Introduced in version 9.5.0.40. Adds a PFX to the XML vault where PFX is passed directly from in-memory binary bytes. Returns 1 for success, 0 for failure.
		*m: addpfxencoded		&& Adds a PFX to the XML vault where PFX is passed directly from encoded bytes (such as Base64, Hex, etc.). The encoding is indicated by encoding. Returns 1 for success, 0 for failure.
		*m: addpfxfile		&& Introduced in version 9.5.0.40. Adds a PFX file to the XML vault. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat XMLCertVault DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugFilePath property.
		*m: getxml		&& Introduced in version 9.5.0.40. Returns the contents of the cert vault as an XML string. Returns Nothing on failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat XMLCertVault LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat XMLCertVault LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat XMLCertVault LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat XMLCertVault LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat XMLCertVault LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat XMLCertVault LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat XMLCertVault LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadxml		&& Introduced in version 9.5.0.40. Loads from an XML string. Returns 1 for success, 0 for failure.
		*m: loadxmlfile		&& Introduced in version 9.5.0.40. Loads from an XML file. Returns 1 for success, 0 for failure.
		*m: masterpassword_access		&& Access method used to retrieve the Chilkat XMLCertVault MasterPassword property.
		*m: masterpassword_assign		&& Assign method used to hold a reference to the MasterPassword property.
		*m: savexml		&& Introduced in version 9.5.0.40. Saves the contents to an XML file. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat XMLCertVault VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: masterpassword		&& Introduced in version 9.5.0.40. The master password for the vault. Certificates are stored unencrypted, but private keys are stored 256-bit AES encrypted using the individual PFX passwords.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = XmlCertVault
		debuglogfilepath = 
		iinstancepatch = 40
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		masterpassword = 
		Name = "xmlcertvault"
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addcert		&& Introduced in version 9.5.0.40. Adds a certificate to the XML vault. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddCert
		* Purpose:           Adds a certificate to the XML vault.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Adds a certificate to the XML vault.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddCert(m.loChilkatCert) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addcertbinary		&& Introduced in version 9.5.0.40. Adds a certificate to the XML vault from any binary format, such as DER. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddCertBinary
		* Purpose:           Adds a certificate to the XML vault 
		*                    from any binary format, such as DER.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqCertificateBytes, the certificate bytes.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Adds a certificate to the XML vault from any binary format, such as DER.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqCertificateBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddCertBinary(m.tqCertificateBytes) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addcertchain		&& Introduced in version 9.5.0.40. Adds a chain of certificates to the XML vault. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddCertChain
		* Purpose:           Adds a chain of certificates to the XML vault.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCertChain, a Chilkat Certificate Chain object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Adds a chain of certificates to the XML vault.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCertChain AS CHILKAT_CERTCHAIN_COM_CALL
		
