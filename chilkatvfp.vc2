	PROCEDURE updateelementdt		&& Replaces the content of a date-formatted element.
		*==============================================================================
		* Method:            UpdateElementDt
		* Purpose:           Replaces the content of a date-formatted element.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTag -- the tag name to reference.
		*                    tiIndex -- the index value of the tag to reference.
		*                    toChilkatCkDateTime -- the Chikate Date Time object.
		* Returns:           
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Replaces the content of a date-formatted element.
		**
		
		LPARAMETERS tcTag AS Character, tiIndex AS Character, ;
		toChilkatCkDateTime AS [Chilkat_9_5_0.CkDateTime]
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Atom], loException AS Exception, ;
		loParkParameterCkDateTime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTime AS [Chilkat_9_5_0.CkDateTime]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCkDateTime = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTime)
		
		    loChilkatCkDateTime = m.loParkParameterCkDateTime.GetObject()
		
		    TRY
		
		      m.loChilkatObject.UpdateElementDt(m.tcTag, m.tiIndex, m.loChilkatCkDateTime)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCkDateTime = ;
		    m.loChilkatCkDateTime.SetObject(m.toChilkatCkDateTime, m.loChilkatCkDateTime)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Atom])
		  toChilkatCkDateTime = NEWOBJECT([Chilkat_9_5_0.CkDateTime])
		  loParkParameterCkDateTime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCkDateTime = NEWOBJECT([Chilkat_9_5_0.CkDateTime])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

