	PROCEDURE exporttopfxbd		&& Introduced in version 9.5.0.70. Exports the certificate and private key (if available) to pfxData. The password is what will be required to access the PFX contents at a later time.
		*==============================================================================
		* Method:            ExportToPFXBd
		* Purpose:           Exports the certificate and private key (if available) to pfxData.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword, the password to access the PFX contents.
		*                    tiIncludeCertChain, whether or not the certificates 
		*                    in the chain of authority are also included
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Exports the certificate and private key (if available) to pfxData. 
		** The password is what will be required to access the PFX contents at a later time. 
		** If includeCertChain is 1, then the certificates in the chain of authority 
		** are also included in the PFX.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcPassword AS Character, ;
		tuIncludeCertChain AS Unknown, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, liIncludeCertChain AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeCertChain, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData  
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      liIncludeCertChain = .LogicalToBit(m.tuIncludeCertChain)
		
		      TRY
		
		        STORE m.loChilkatObject.ExportToPFXBd(m.tcPassword, ;
		        m.liIncludeCertChain, m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE exporttopfxdata		&& Introduced in version 9.5.0.31. Exports the certificate and private key (if available) to an in-memory PFX image. The password is what will be required to access the PFX contents at a later time.
		*==============================================================================
		* Method:            ExportToPFXData
		* Purpose:           Exports the certificate and private key to an in-memory PFX image.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword, the password to access the PFX contents.
		*                    tiIncludeCertChain, whether or not the certificates 
		*                    in the chain of authority are also included
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.31
		**
		** Exports the certificate and private key (if available) to an in-memory PFX image. 
		** The password is what will be required to access the PFX contents at a later time. 
		** If includeCertChain is 1, then the certificates in the chain of authority 
		** are also included in the PFX.
		** 
		** Fixed in Version 66: Fixed exporting ECC private keys from PFX to other formats.
		** 
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tcPassword AS Character, tuIncludeCertChain AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown, liIncludeCertChain AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeCertChain, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 31
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeCertChain = .LogicalToBit(m.tuIncludeCertChain)
		
		      TRY
		
		        STORE m.loChilkatObject.ExportToPFXData(m.tcPassword, ;
		        m.liIncludeCertChain) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE exporttopfxfile		&& Exports the certificate and private key (if available) to a PFX (.pfx or .p12) file. The output PFX is secured using the pfxPassword. If bIncludeCertChain is 1, then the certificates in the chain of authority are also included in the PFX output file.
		*==============================================================================
		* Method:            ExportToPFXFile
		* Purpose:           Exports the certificate and private key to a PFX file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPFXFilePath, the path to the PFX file.
		*                    tcPassword, the password to access the PFX contents.
		*                    tiIncludeCertChain, whether or not the certificates 
		*                    in the chain of authority are also included.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Exports the certificate and private key (if available) to a PFX 
		** (.pfx or .p12) file. The output PFX is secured using the pfxPassword. 
		** If bIncludeCertChain is 1, then the certificates in the chain of authority 
		** are also included in the PFX output file.
		** 
		** Fixed in Version 66: Fixed exporting ECC private keys from PFX to other formats.
		** 
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcPFXFilePath AS Character, ;
		tcPassword AS Character, tuIncludeCertChain AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIncludeCertChain AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeCertChain
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liIncludeCertChain = .LogicalToBit(m.tuIncludeCertChain)
		
		    TRY
		
		      STORE m.loChilkatObject.ExportToPFXFile(m.tcPFXFilePath, ;
		      m.tcPassword, m.liIncludeCertChain) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE extendedkeyusage_access		&& Access method used to retrieve the Chilkat Cert ExtendedKeyUsage property.
		*==============================================================================
		* Method:            ExtendedKeyUsage_Access
		* Purpose:           Access method used to retrieve 
		*                    the ExtendedKeyUsage property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ExtendedKeyUsage
		* Date Added:        07/28/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.85
		**
		** Returns a string containing a comma separated list of keywords 
		** with the extended key usages of the certificate. 
		** The list of possible extended key usages are:
		** 
		**  serverAuth - TLS WWW server authentication
		**  clientAuth - TLS WWW client authentication
		**  codeSigning - Signing of downloadable executable code
		**  emailProtection - Email protection
		**  timeStamping - Binding the hash of an object to a time
		**  OCSPSigning - Signing OCSP responses
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 85
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE extendedkeyusage_assign		&& Assign method used to hold a reference to the ExtendedKeyUsage property.
		*==============================================================================
		* Method:            ExtendedKeyUsage_Assign
		* Purpose:           Assign method used to hold
		*                    the ExtendedKeyUsage of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ExtendedKeyUsage property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 85
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE findissuer		&& Finds and returns the issuer certificate. If the certificate is a root or self-issued, then the certificate returned is a copy of the caller certificate. (The IsRoot property can be check to see if the certificate is a root (or self-issued) certificate.)
		*==============================================================================
		* Method:            FindIssuer
		* Purpose:           Finds and returns the issuer certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat Certificate object.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Finds and returns the issuer certificate. If the certificate is a root or self-issued, 
		** then the certificate returned is a copy of the caller certificate. 
		** (The IsRoot property can be check to see if the certificate is a root 
		** (or self-issued) certificate.)
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.FindIssuer()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE forclientauthentication_access		&& Access method used to retrieve the Chilkat Cert ForClientAuthentication property.
		*==============================================================================
