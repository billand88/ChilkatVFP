	HIDDEN PROCEDURE signatureverified_access		&& Access method used to retrieve the Chilkat Cert SignatureVerified property.
		*==============================================================================
		* Method:            SignatureVerified_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert SignatureVerified property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SignatureVerified
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Returns 1 if the certificate and all certificates 
		** in the chain of authority have valid signatures, otherwise returns 0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE signatureverified_assign		&& Assign method used to hold a reference to the SignatureVerified property.
		*==============================================================================
		* Method:            SignatureVerified_Assign
		* Purpose:           Assign method used to hold a reference to the SignatureVerified property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the SignatureVerified property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE silent_access		&& Access method used to retrieve the Chilkat Cert Silent property.
		*==============================================================================
		* Method:            Silent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert Silent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Silent
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** (Relevant only when running on a Microsoft Windows operating system.)
		** 
		** If the HasKeyContainer property is 1, then the certificate is linked 
		** to a key container and this property indicates that the key container 
		** will attempt to open any keys silently without any user interface prompts.
		** 
		** When a certificate is linked to a key container, the following properties 
		** will provide information about the key container and private key: 
		** CspName, KeyContainerName, MachineKeyset, and Silent.
		**
		** Version 11.0.0: Property removed.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [LongBitReadOnly]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 0
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		  
	ENDPROC

	HIDDEN PROCEDURE silent_assign		&& Assign method used to hold a reference to the Silent property.
		*==============================================================================
		* Method:            Silent_Assign
		* Purpose:           Assign method used to hold a reference to the Silent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the Silent property.
		* Returns:           
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Version 11.0.0: Property removed.
		**
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    lcValidationMethod = []
		    lcMethodToCall = [LongBitReadOnly]
		
		    .CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE smartcardfailreason_access		&& Access method used to retrieve the Chilkat Cert SmartCardFailReason property.
		*==============================================================================
		* Method:            SmartCardFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert SmartCardFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SmartCardFailReason
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		**
		** Set after calling LoadFromSmartcard. Possible values are:
		**
		** 0 - No failure. The call to LoadFromSmartcard was successful.
		** 1 - No smartcard or USB token was detected.
		** 2 - The SmartCardPin was provided and the PIN login failed. 
		**     (Note: Chilkat only PIN authenticates if PKCS11 was the chosen means for communicating with the smartcard.)
		** 3 - The certificate matching the specified criteria was not found.
		** 99 - Some other undefined failure. Consult the LastErrorText for more information.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_Implemented[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_Implemented[1] = 10
		la_Implemented[2] = 1
		la_Implemented[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_Implemented)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE smartcardfailreason_assign		&& Assign method used to hold a reference to the SmartCardFailReason property.
		*=============s=================================================================
		* Method:            SmartCardFailReason_Assign
		* Purpose:           Assign method used to hold a reference to the SmartCardFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the SmartCardFailReason property.
		* Returns:           
		* Date Added:        05/18/2025
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE smartcardnodialog_access		&& Access method used to retrieve the Chilkat Cert SmartCardNoDialog property.
		*==============================================================================
		* Method:            SmartCardNoDialog_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cert SmartCardNoDialog property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SmartCardNoDialog
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** If set to 1, then no dialog will automatically popup 
		** if the SmartCardPin is incorrect. Instead, the method requiring the private key 
		** on the smart card will fail. The default value of this property is 0, 
		** which means that if the SmartCardPin property is incorrect, 
		** a dialog with prompt will be displayed.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 77
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE smartcardnodialog_assign		&& Assign method used to hold a reference to the SmartCardNoDialog property.
