DEFINE CLASS jwe AS ibasechilkat OF "chilkatvfp.vcx" 		&& An API for JSON Web Encryption (JWE). Provides the ability to create (encrypt) and decrypt JWE's.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat JWE DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugFilePath property.
		*m: decrypt		&& Introduced in version 9.5.0.66. Decrypts a JWE and returns the original (decrypted) string content. The byte representation of the decrypted bytes is indicated by charset (such as "utf-8").
		*m: decryptbd		&& Introduced in version 9.5.0.66. Decrypts the loaded JWE and appends the decrypted bytes to the contents of bd. The index specifies which recipient key is used for decryption. (Most JWEs have only a single recipent, and thus the index is typically 0.)
		*m: decryptsb		&& Introduced in version 9.5.0.66. Decrypts the loaded JWE and appends the decrypted content to contentSb. The byte representation of the decrypted bytes is indicated by charset (such as "utf-8").
		*m: encrypt		&& Introduced in version 9.5.0.66. Encrypts string content to produce a JWE. The byte representation of the content is indicated by charset (such as "utf-8").
		*m: encryptbd		&& Introduced in version 9.5.0.66. Encrypts the contents of contentBd to produce a JWE that is appended to the contents of jweSb. (This method provides the means to produce a JWE from binary content.)  Returns 1 for success, 0 for failure.
		*m: encryptsb		&& Introduced in version 9.5.0.66. Encrypts the contents of contentSb to produce a JWE that is appended to the contents of jweSb. The byte representation of the string to be encrypted is indicated by charset (such as "utf-8").
		*m: findrecipient		&& Introduced in version 9.5.0.66. Finds the index of the recipient with a header parameter (paramName) equal to a specified value (paramValue). Returns -1 if no recipient contains a header with the given name/value.
		*m: getheader		&& Introduced in version 9.5.0.89. Returns the JSON header from the JWE. The JSON header is loaded into json. Returns 1 for success, 0 for failure.
		*m: getprotectedheader		&& Introduced in version 9.5.0.89. Returns the shared protected JSON header from the JWE. The shared protected header is loaded into json. Returns 1 for success, 0 for failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat JWE LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat JWE LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat JWE LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat JWE LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat JWE LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat JWE LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat JWE LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadjwe		&& Introduced in version 9.5.0.66. Loads the contents of a JWE. Returns 1 for success, 0 for failure.
		*m: loadjwesb		&& Introduced in version 9.5.0.66. Loads the contents of a JWE from a StringBuilder object. Returns 1 for success, 0 for failure.
		*m: numrecipients_access		&& Access method used to retrieve the Chilkat JWE NumRecipients property.
		*m: numrecipients_assign		&& Assign method used to hold a reference to the NumRecipients property.
		*m: prefercompact_access		&& Access method used to retrieve the Chilkat JWE PreferCompact property.
		*m: prefercompact_assign		&& Assign method used to hold a reference to the PreferCompact property.
		*m: preferflattened_access		&& Access method used to retrieve the Chilkat JWE PreferFlattened property.
		*m: preferflattened_assign		&& Assign method used to hold a reference to the PreferFlattened property.
		*m: setaad		&& Introduced in version 9.5.0.66. Sets the optional Additional Authenticated Data. This is only used for non-compact serializations.
		*m: setaadbd		&& Introduced in version 9.5.0.66. Sets the optional Additional Authenticated Data. This is only used for non-compact serializations. This method provides a way for binary (non-text) additional authenticated data to be used.
		*m: setpassword		&& Introduced in version 9.5.0.66. Sets the PBES2 password for key encryption or decryption. This is for the case where the content encryption key (CEK) is encrypted using PBES2.
		*m: setprivatekey		&& Introduced in version 9.5.0.66. Sets a private key for RSA key unwrapping/decryption. This is for the case where the content encryption key (CEK) is encrypted using RSA.
		*m: setprotectedheader		&& Introduced in version 9.5.0.66. Sets the JWE Protected Header. Returns 1 for success, 0 for failure.
		*m: setpublickey		&& Introduced in version 9.5.0.66. Sets a public key for RSA key wrapping encryption. This is for the case where the content encryption key (CEK) is encrypted using RSA.
		*m: setrecipientheader		&& Introduced in version 9.5.0.66. Sets a per-recipient unprotected header. This method would only be called if the JWE is for multiple recipients. The 1st recipient is at index 0. Returns 1 for success, 0 for failure.
		*m: setunprotectedheader		&& Introduced in version 9.5.0.66. Sets the JWE Shared Unprotected Header. Returns 1 for success, 0 for failure.
		*m: setwrappingkey		&& Introduced in version 9.5.0.66. Sets the AES wrapping key for encryption or decryption. This is for the case where the content encryption key (CEK) is encrypted using AES Key Wrap or AES GCM.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat JWE VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numrecipients		&& Introduced in version 9.5.0.66. The number of recipients for this JWE.
		*p: prefercompact		&& Introduced in version 9.5.0.66. Controls whether the JWE Compact Serialization or JWE JSON Serialization is preferred when creating JWEs. The default value is 1, which is to use compact serialization when possible.
		*p: preferflattened		&& Introduced in version 9.5.0.66. Controls whether the flattened serialization is preferred when JWE JSON Serialization is used. The default value is 1, which is to use the flattened serialization when possible.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Jwe
		debuglogfilepath = 
		iinstancepatch = 66
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 1
		laststringresultlen = 0
		Name = "jwe"
		numrecipients = 0
		prefercompact = 1
		preferflattened = 1
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  JWE — ECDH-ES key wrapping. ECDH-ES+A128KW / A192KW / A256KW now produce standards-compliant, 
		  interoperable output in all cases. The content-encryption key had been sized to twice 
		  the key-wrap key length instead of the size required by the chosen enc algorithm, 
		  so behavior depended on whether the two happened to line up:
		
		  Unaffected  Valid & interoperable — “aligned” pairings: A128KW+A128CBC-HS256, A192KW+A192CBC-HS384, 
		  A256KW+A256CBC-HS512, and A128KW+A256GCM
		
		  Failed  CBC-HMAC enc whose required size didn’t match — e.g. A128KW+A256CBC-HS512
		
		  Wrong output  AES-GCM enc pairings where sizes didn’t align (non-interoperable, or failed)
		
		  The content-encryption key is now always generated at the correct size and wrapped correctly. 
		  Only JWEs from the affected combinations need to be regenerated; 
		  those from the unaffected pairings remain fully compatible.
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 92
		
		  Fixed problem (failure) when a secp521r1 is used for the CEK (content encryption key).
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 75
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 72
		
		  Encrypting 0 bytes for block cipher algorithms with padding
		  now results in one block of output, rather than 0 bytes.
		  (Decrypting the 16-byte block will return the original 0 bytes.)
		  This only applies to block ciphers operating in modes such as ECB, CBC, etc.
		  This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		
		** Version 71
		
		  Fixed problem with RSA-OAEP-256. Also added support for RSA-OAEP-384 and RSA-OAEP-512.
		
		  Fixed to internally restrict IV’s to 96 bits as standards dictate.
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		** Version 66
		
		  Added the Jwe and Jws classes for JSON Web Encryption and JSON Web Signatures.
		
		** Version 65
		
		  Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		  See https://www.example-code.com/foxpro/edifact_eda_syntax_level_A_encoding.asp
		  Also see: https://cknotes.com/chilkat-binary-encoding-list/
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat JWE DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat JWE DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/20/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat JWE DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/20/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 66
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE decrypt		&& Introduced in version 9.5.0.66. Decrypts a JWE and returns the original (decrypted) string content. The byte representation of the decrypted bytes is indicated by charset (such as "utf-8").
		*==============================================================================
		* Method:            Decrypt
		* Purpose:           Decrypts a JWE and returns the original (decrypted) string content.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the recipient key array value.
		*                    tcCharset, the charset of the decrypted bytes.
		* Returns:           The original string.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Decrypts a JWE and returns the original (decrypted) string content. 
		** The byte representation of the decrypted bytes is indicated by charset 
		** (such as "utf-8"). (The charset tells Chilkat how to intepret 
		** the decrypted bytes as characters.)
		** 
		** The index specifies which recipient key is used for decryption. 
		** (Most JWEs have only a single recipent, and thus the index is typically 0.)
		** 
		** Supported Algorithms:
		** 
		** RSAES OAEP 256 (using SHA-256 and MGF1 with SHA-256) 
		** encryption with A128CBC-HS256, A192CBC-HS384, A256CBC-HS512, 
		** A128GCM, A192GCM, A256GCM
		** 
		** RSAES OAEP (using SHA-1 and MGF1 with SHA-1) encryption with A128CBC-HS256, 
		** A192CBC-HS384, A256CBC-HS512, A128GCM, A192GCM, A256GCM
		** 
		** RSAES-PKCS1-V1_5 encryption with A128CBC-HS256, A192CBC-HS384, A256CBC-HS512, 
		** A128GCM, A192GCM, A256GCM
		** 
		** Direct symmetric key encryption with pre-shared key A128CBC-HS256, 
		** A192CBC-HS384, A256CBC-HS512, A128GCM, A192GCM and A256GCM
		** 
		** A128KW, A192KW, A256KW encryption with A128CBC-HS256, A192CBC-HS384, 
		** A256CBC-HS512, A128GCM, A192GCM, A256GCM
		** 
		** A128GCMKW, A192GCMKW, A256GCMKW encryption with A128CBC-HS256, 
		** A192CBC-HS384, A256CBC-HS512, A128GCM, A192GCM, A256GCM
		** 
		** PBES2-HS256+A128KW, PBES2-HS384+A192KW, PBES2-HS512+A256KW 
		** with A128CBC-HS256, A192CBC-HS384, A256CBC-HS512, A128GCM, A192GCM, A256GCM
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JWE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcOriginalString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcOriginalString = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcOriginalString = m.loChilkatObject.Decrypt(m.tiIndex, m.tcCharset) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcOriginalString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptbd		&& Introduced in version 9.5.0.66. Decrypts the loaded JWE and appends the decrypted bytes to the contents of bd. The index specifies which recipient key is used for decryption. (Most JWEs have only a single recipent, and thus the index is typically 0.)
		  *==============================================================================
		* Method:            DecryptBd
		* Purpose:           Decrypts the loaded JWE and appends the decrypted bytes 
		*                    to the contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the recipient key array value.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Decrypts the loaded JWE and appends the decrypted bytes to the contents of bd. 
		** The index specifies which recipient key is used for decryption. 
		** (Most JWEs have only a single recipent, and thus the index is typically 0.)
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.DecryptBd(m.tiIndex, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWE_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptsb		&& Introduced in version 9.5.0.66. Decrypts the loaded JWE and appends the decrypted content to contentSb. The byte representation of the decrypted bytes is indicated by charset (such as "utf-8").
		*==============================================================================
		* Method:            DecryptSb
		* Purpose:           Decrypts the loaded JWE and appends the decrypted content to contentSb.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the recipient key array value.
		*                    tcCharset, the charset of the contents.
		*                    toChilkatStringBuilder, a Chilkat String Builder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Decrypts the loaded JWE and appends the decrypted content to contentSb. 
		** The byte representation of the decrypted bytes is indicated by charset (such as "utf-8"). 
		** (This tells Chilkat how to interpret the bytes as characters.)
		**
		** The index specifies which recipient key is used for decryption. 
		** (Most JWEs have only a single recipent, and thus the index is typically 0.)
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tcCharset AS Character, ;
		toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
