	PROCEDURE cosign		&& Introduced in version 9.5.0.89. Co-sign's an existing CMS signature. bdIn contains the existing CMS signature. If successful, cert is the output co-signed CMS signature. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CoSign
		* Purpose:           Co-sign's an existing CMS signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinDataIn, a Chilkat Binary Data object.
		*                    toChilkatCert, a Chilkat Certificate object.
		*                    toChilkatBinDataOut, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.89
		**
		** Co-sign's an existing CMS signature. bdIn contains the existing CMS signature. 
		** If successful, cert is the output co-signed CMS signature.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, ;
		toChilkatCert AS CHILKAT_CERT_COM_CALL, toChilkatBinDataOut AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinDataIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		loParkParameterBinDataOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataOut AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataIn, m.loChilkatBinDataIn, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterBinDataOut, m.loChilkatBinDataOut
		
		llImplemented = .F.
		liIntroducedInBuild = 89
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinDataIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataIn)
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loParkParameterBinDataOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataOut)
		
		      loChilkatBinDataIn = m.loParkParameterBinDataIn.GetObject()
		      loChilkatCert = m.loParkParameterCert.GetObject()
		      loChilkatBinDataOut = m.loParkParameterBinDataOut.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CoSign(m.loChilkatBinDataIn, ;
		        m.loChilkatCert, m.loChilkatBinDataOut) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinDataIn = ;
		      m.loParkParameterBinDataIn.SetObject(m.toChilkatBinDataIn, m.loChilkatBinDataIn)
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		      toChilkatBinDataOut = ;
		      m.loParkParameterBinDataOut.SetObject(m.toChilkatBinDataOut, m.loChilkatBinDataOut)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataIn, m.loChilkatBinDataIn, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterBinDataOut, m.loChilkatBinDataOut
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatBinDataIn = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatBinDataOut = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinDataIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinDataIn = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterBinDataOut = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinDataOut = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE crcbd		&& Introduced in version 11.0.0. Computes a CRC for data contained in crcAlg, which can be either crc-32 used in the Zip file format, or crc8 for the CRC8 algorithm.
		*==============================================================================
		* Method:            CrcBd
		* Purpose:           Computes a CRC for data contained in crcAlg.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCrcAlgorithm, the CRC algorithm, either crc-32/crc8
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Computes a CRC for data contained in crcAlg, which can be either crc-32 
		** used in the Zip file format, or crc8 for the CRC8 algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCrcAlgorithm AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CrcBd(m.tcCrcAlgorithm, ;
		        m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = m.loParkParameterBinData.SetObject(;
		      m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE crcbytes		&& Introduced in version 9.5.0.38. Calculates a CRC for in-memory byte data. To compute the CRC used in the Zip file format, pass "CRC-32" (or CRC32, case insensitive) for the crcAlg.
