	PROCEDURE verifysignature		&& Introduced in version 9.5.0.97. Verifies the signature of a Windows executable or DLL. The path to the executable/DLL is passed in path. Information about the signature is returned in sigInfo.
		*==============================================================================
		* Method:            VerifySignature
		* Purpose:           Verifies the signature of a Windows executable or DLL. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.97.
		**
		** Verifies the signature of a Windows executable or DLL. 
		** The path to the executable/DLL is passed in path. 
		** Information about the signature is returned in sigInfo. 
		** Returns 1 if the signature is verified indicating the EXE or DLL can be trusted. 
		** Otherwise returns 0.
		**
		** Returns 1 for success, 0 for failure.
		**
		** Fixed in version 11.5.0: Fixed a problem with VerifySignature where an uncommonly encountered 
		** countersignature was present. Chilkat did not recognize the OID or ASN.1 format for the countersignature.
		** 
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CODESIGN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical, loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX]
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject  
		
		llImplemented = .F.
		liIntroducedInBuild = 97
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.VerifySignature(m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CODESIGN_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS compression AS ibasechilkat OF "chilkatvfp.vcx" 		&& Implements the Bzip2, Deflate, and LZW compression algorithms.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: algorithm_access		&& Access method used to retrieve the Chilkat Compression Algorithm property.
		*m: algorithm_assign		&& Assign method used to hold a reference to the Algorithm property.
		*m: begincompressbytes		&& Large amounts of binary byte data may be compressed in chunks by first calling BeginCompressBytes, followed by 0 or more calls to MoreCompressedBytes, and ending with a final call to EndCompressBytes.
		*m: begincompressbytesasync		&& Creates an asynchronous task to call the BeginCompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: begincompressbytesenc		&& Large amounts of binary byte data may be compressed in chunks by first calling BeginCompressBytesENC, followed by 0 or more calls to MoreCompressedBytesENC, and ending with a final call to EndCompressBytesENC.
		*m: begincompressbytesencasync		&& Creates an asynchronous task to call the BeginCompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: begincompressstring		&& Large amounts of string data may be compressed in chunks by first calling BeginCompressString, followed by 0 or more calls to MoreCompressedString, and ending with a final call to EndCompressString.
		*m: begincompressstringasync		&& Creates an asynchronous task to call the BeginCompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: begincompressstringenc		&& Large amounts of string data may be compressed in chunks by first calling BeginCompressStringENC, followed by 0 or more calls to MoreCompressedStringENC, and ending with a final call to EndCompressStringENC.
		*m: begincompressstringencasync		&& Creates an asynchronous task to call the BeginCompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: begindecompressbytes		&& A compressed data stream may be decompressed in chunks by first calling BeginDecompressBytes, followed by 0 or more calls to MoreDecompressedBytes, and ending with a final call to EndDecompressBytes.
		*m: begindecompressbytesasync		&& Creates an asynchronous task to call the BeginDecompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: begindecompressbytesenc		&& The input to this method is an encoded string containing compressed data. The EncodingMode property should be set prior to calling this method. The input string is decoded according to the EncodingMode (hex, base64, etc.) and then decompressed.
		*m: begindecompressbytesencasync		&& Creates an asynchronous task to call the BeginDecompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: begindecompressstring		&& A compressed data stream may be decompressed in chunks by first calling BeginDecompressString, followed by 0 or more calls to MoreDecompressedString, and ending with a final call to EndDecompressString.
		*m: begindecompressstringasync		&& Creates an asynchronous task to call the BeginDecompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: begindecompressstringenc		&& The input to this method is an encoded string containing compressed data. The EncodingMode property should be set prior to calling this method. The input string is decoded according to the EncodingMode (hex, base64, etc.) and then decompressed.
		*m: begindecompressstringencasync		&& Creates an asynchronous task to call the BeginDecompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: charset_access		&& Access method used to retrieve the Chilkat Compression Charset property.
		*m: charset_assign		&& Assign method used to hold a reference to the Charset property.
		*m: compressbd		&& Introduced in version 9.5.0.66. Compresses the data contained in a BinData object. Returns 1 for success, 0 for failure.
		*m: compressbd2		&& Introduced in version 11.0.0. This method compresses the data in bdIn without modifying it and appends the compressed data to bdOut. It is also FirstChunk/LastChunk aware. Returns 1 for success, 0 for failure.
		*m: compressbd2async		&& Introduced in version 11.0.0. Creates an asynchronous task to call the CompressBd2 method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: compressbdasync		&& Introduced in version 9.5.0.66. Creates an asynchronous task to call the CompressBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressbytes		&& Compresses byte data. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: compressbytesasync		&& Creates an asynchronous task to call the CompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressbytesenc		&& Compresses bytes and returns the compressed data encoded to a string. The encoding (hex, base64, etc.) is determined by the EncodingMode property setting. Returns Nothing on failure.
		*m: compressbytesencasync		&& Creates an asynchronous task to call the CompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressencryptfile		&& Introduced in version 9.5.0.99. Performs file-to-file compression and encryption. Files of any size may be compressed because the file is compressed and encrypted internally in streaming mode. Returns 1 for success, 0 for failure.
		*m: compressencryptfileasync		&& Introduced in version 9.5.0.99. Creates an asynchronous task to call the CompressEncryptFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: compressfile		&& Performs file-to-file compression. Files of any size may be compressed because the file is compressed internally in streaming mode. Returns 1 for success, 0 for failure.
		*m: compressfileasync		&& Creates an asynchronous task to call the CompressFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compresssb		&& Introduced in version 9.5.0.73. Compresses the contents of sb and appends the compressed bytes to binData. Returns 1 for success, 0 for failure.
		*m: compresssbasync		&& Introduced in version 9.5.0.73. Creates an asynchronous task to call the CompressSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressstr		&& Introduced in version 11.0.0. Compresses a string and appends to bd. The byte representation (character encoding) of the actual bytes to be compressed is determined by the Charset property. This method is FirstChunk / LastChunk aware.
		*m: compressstrasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the CompressStr method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: compressstream		&& Introduced in version 9.5.0.56. Compresses a stream. Internally, the strm's source is read, compressed, and the compressed data written to the strm's sink. It does this in streaming fashion.
		*m: compressstreamasync		&& Introduced in version 9.5.0.56. Creates an asynchronous task to call the CompressStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressstring		&& Compresses a string. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: compressstringasync		&& Creates an asynchronous task to call the CompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressstringenc		&& Compresses a string and returns the compressed data encoded to a string. The output encoding (hex, base64, etc.) is determined by the EncodingMode property setting. Returns Nothing on failure.
		*m: compressstringencasync		&& Creates an asynchronous task to call the CompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Compression DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: decompressbd		&& Introduced in version 9.5.0.66. Decompresses the data contained in a BinData object. Returns 1 for success, 0 for failure.
		*m: decompressbd2		&& Introduced in version 11.0.0. This method decompresses the data in bdIn without modifying it and appends the decompressed data to bdOut. It is also FirstChunk/LastChunk aware. Returns 1 for success, 0 for failure.
		*m: decompressbd2async		&& Introduced in version 11.0.0. Creates an asynchronous task to call the DecompressBd2 method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: decompressbdasync		&& Introduced in version 9.5.0.66. Creates an asynchronous task to call the DecompressBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decompressbytes		&& The opposite of CompressBytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: decompressbytesasync		&& Creates an asynchronous task to call the DecompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decompressbytesenc		&& The opposite of CompressBytesENC. encodedCompressedData contains the compressed data as an encoded string (hex, base64, etc) as specified by the EncodingMode property setting. Returns a zero-length byte array (as a Variant) on failure.
		*m: decompressbytesencasync		&& Creates an asynchronous task to call the DecompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decompressfile		&& Performs file-to-file decompression (the opposite of CompressFile). Internally the file is decompressed in streaming mode which allows files of any size to be decompressed. Returns 1 for success, 0 for failure.
		*m: decompressfileasync		&& Creates an asynchronous task to call the DecompressFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decompresssb		&& Introduced in version 9.5.0.73. Decompresses the contents of binData and appends the decompressed string to sb. Returns 1 for success, 0 for failure.
		*m: decompresssbasync		&& Introduced in version 9.5.0.73. Creates an asynchronous task to call the DecompressSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decompressstream		&& Introduced in version 9.5.0.56. Decompresses a stream. Internally, the strm's source is read, decompressed, and the decompressed data written to the strm's sink. It does this in streaming fashion.
		*m: decompressstreamasync		&& Introduced in version 9.5.0.56. Creates an asynchronous task to call the DecompressStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decompressstring		&& Takes compressed bytes, decompresses, and returns the resulting string. Returns Nothing on failure.
		*m: decompressstringasync		&& Creates an asynchronous task to call the DecompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decompressstringenc		&& The opposite of CompressStringENC. encodedCompressedData contains the compressed data as an encoded string (hex, base64, etc) as specified by the EncodingMode property setting. Returns Nothing on failure.
		*m: decompressstringencasync		&& Creates an asynchronous task to call the DecompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: decryptdecompressfile		&& Introduced in version 9.5.0.99. Performs file-to-file decryption and decompression. Returns 1 for success, 0 for failure.
		*m: decryptdecompressfileasync		&& Introduced in version 9.5.0.99. Creates an asynchronous task to call the DecryptDecompressFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deflatelevel_access		&& Access method used to retrieve the Chilkat Compression DeflateLevel property.
		*m: deflatelevel_assign		&& Assign method used to hold a reference to the DeflateLevel property.
		*m: encodingmode_access		&& Access method used to retrieve the Chilkat Compression EncodingMode property.
		*m: encodingmode_assign		&& Assign method used to hold a reference to the EncodingMode property.
		*m: endcompressbytes		&& Must be callled to finalize a compression stream. Returns any remaining (buffered) compressed data. (See BeginCompressBytes) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: endcompressbytesasync		&& Creates an asynchronous task to call the EndCompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: endcompressbytesenc		&& Must be callled to finalize a compression stream. Returns any remaining (buffered) compressed data. (See BeginCompressBytesENC) Returns Nothing on failure.
		*m: endcompressbytesencasync		&& Creates an asynchronous task to call the EndCompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: endcompressstring		&& Must be callled to finalize a compression stream. Returns any remaining (buffered) compressed data. (See BeginCompressString)  Returns a zero-length byte array (as a Variant) on failure.
		*m: endcompressstringasync		&& Creates an asynchronous task to call the EndCompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: endcompressstringenc		&& Must be callled to finalize a compression stream. Returns any remaining (buffered) compressed data. (See BeginCompressStringENC) Returns Nothing on failure.
		*m: endcompressstringencasync		&& Creates an asynchronous task to call the EndCompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: enddecompressbytes		&& Called to finalize the decompression stream and return any remaining (buffered) decompressed data. (See BeginDecompressBytes) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: enddecompressbytesasync		&& Creates an asynchronous task to call the EndDecompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: enddecompressbytesenc		&& Called to finalize the decompression stream and return any remaining (buffered) decompressed data. The input to this method is an encoded string containing compressed data. The EncodingMode property should be set prior to calling this method.
		*m: enddecompressbytesencasync		&& Creates an asynchronous task to call the EndDecompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: enddecompressstring		&& Called to finalize the decompression stream and return any remaining (buffered) decompressed data. (See BeginDecompressString) Returns Nothing on failure.
		*m: enddecompressstringasync		&& Creates an asynchronous task to call the EndDecompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: enddecompressstringenc		&& Called to finalize the decompression stream and return any remaining (buffered) decompressed data. The input to this method is an encoded string containing compressed data. The EncodingMode property should be set prior to calling this method.
		*m: enddecompressstringencasync		&& Creates an asynchronous task to call the EndDecompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: firstchunk_access		&& Access method used to retrieve the Chilkat Compression FirstChunk property.
		*m: firstchunk_assign		&& Assign method used to hold a reference to the FirstChunk property.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat Compression HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Compression LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lastchunk_access		&& Access method used to retrieve the Chilkat Compression LastChunk property.
		*m: lastchunk_assign		&& Assign method used to hold a reference to the LastChunk property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Compression LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Compression LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Compression LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Compression LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Compression LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Compression LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: morecompressbytes		&& (See BeginCompressBytes) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: morecompressbytesasync		&& Creates an asynchronous task to call the MoreCompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: morecompressbytesenc		&& (See BeginCompressBytesENC) Returns Nothing on failure.
		*m: morecompressbytesencasync		&& Creates an asynchronous task to call the MoreCompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: morecompressstring		&& (See BeginCompressString) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: morecompressstringasync		&& Creates an asynchronous task to call the MoreCompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: morecompressstringenc		&& (See BeginCompressStringENC) Returns Nothing on failure.
		*m: morecompressstringencasync		&& Creates an asynchronous task to call the MoreCompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: moredecompressbytes		&& (See BeginDecompressBytes) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: moredecompressbytesasync		&& Creates an asynchronous task to call the MoreDecompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: moredecompressbytesenc		&& The input to this method is an encoded string containing compressed data. The EncodingMode property should be set prior to calling this method. The input string is decoded according to the EncodingMode (hex, base64, etc.) and then decompressed.
		*m: moredecompressbytesencasync		&& Creates an asynchronous task to call the MoreDecompressBytesENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: moredecompressstring		&& (See BeginDecompressString) Returns Nothing on failure.
		*m: moredecompressstringasync		&& Creates an asynchronous task to call the MoreDecompressString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: moredecompressstringenc		&& The input to this method is an encoded string containing compressed data. The EncodingMode property should be set prior to calling this method. The input string is decoded according to the EncodingMode (hex, base64, etc.) and then decompressed.
		*m: moredecompressstringencasync		&& Creates an asynchronous task to call the MoreDecompressStringENC method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat Compression UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Compression VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: algorithm		&& The compression algorithm to be used. Should be set to either "ppmd", "deflate", "zlib", "bzip2", or "lzw". Note: The PPMD compression algorithm is only available for 32-bit builds. It is not available for 64-bit implementations.
		*p: charset		&& Only applies to methods that compress or decompress strings. This specifies the character encoding that the string should be converted to before compression. Many programming languages use Unicode (2 bytes per char) for representing characters.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: deflatelevel		&& Introduced in version 9.5.0.73. This property allows for customization of the compression level for the "deflate" and "zlib" compression algoirthms. ("zlib" is just the deflate algorithm with a zlib header.)
		*p: encodingmode		&& Controls the encoding expected by methods ending in "ENC", such as CompressBytesENC. Valid values are "base64", "hex", "url", and "quoted-printable".
		*p: firstchunk		&& Introduced in version 11.0.0. This property applies to FirstChunk and LastChunk aware compression and decompression methods. It signifies that the data being compressed is the first of multiple chunks. The default value is 1.
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any method call prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lastchunk		&& Introduced in version 11.0.0. This property applies to FirstChunk and LastChunk aware compression and decompression methods. It signifies that the data being compressed is the last of multiple chunks. The default value is 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: uncommonoptions		&& Introduced in version 11.0.0. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		algorithm = ppmd
		cchilkatclass = Compression
		ceventhandlerclass = iBaseEventHandler
		charset = 
		debuglogfilepath = 
		deflatelevel = 6
		encodingmode = base64
		firstchunk = 1
		heartbeatms = 0
		lastbinaryresult = .NULL.
		lastchunk = 1
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "compression"
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE algorithm_access		&& Access method used to retrieve the Chilkat Compression Algorithm property.
		*==============================================================================
		* Method:            Algorithm_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Compression Algorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Algorithm
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** The compression algorithm to be used. 
		** Should be set to either "ppmd", "deflate", "zlib", "bzip2", or "lzw".
		** 
		** Note: The PPMD compression algorithm is only available for 32-bit builds. 
		** It is not available for 64-bit implementations. 
		** Also, this PPMD implementation is the "J" variant.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE algorithm_assign		&& Assign method used to hold a reference to the Algorithm property.
		*==============================================================================
		* Method:            Algorithm_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Compression Algorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Algorithm property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Algorithm_Compression]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE begincompressbytes		&& Large amounts of binary byte data may be compressed in chunks by first calling BeginCompressBytes, followed by 0 or more calls to MoreCompressedBytes, and ending with a final call to EndCompressBytes.
		*==============================================================================
		* Method:            BeginCompressBytes
		* Purpose:           See description.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqByteData, the byte data to compress.
		* Returns:           Compressed binary data.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Large amounts of binary byte data may be compressed 
		** in chunks by first calling BeginCompressBytes, 
		** followed by 0 or more calls to MoreCompressedBytes, 
		** and ending with a final call to EndCompressBytes. 
		** Each call returns 0 or more bytes of compressed data which may be output 
		** to a compressed data stream (such as a file, socket, etc.).
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		
		LPARAMETERS tqByteData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, lqCompressedData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqCompressedData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqCompressedData = m.loChilkatObject.BeginCompressBytes(m.tqByteData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqCompressedData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE begincompressbytesasync		&& Creates an asynchronous task to call the BeginCompressBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            BeginCompressBytesAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    BeginCompressBytes method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqByteData, the byte data to compress.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Creates an asynchronous task to call the BeginCompressBytes method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tqByteData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask 
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.BeginCompressBytesAsync(m.tqByteData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE begincompressbytesenc		&& Large amounts of binary byte data may be compressed in chunks by first calling BeginCompressBytesENC, followed by 0 or more calls to MoreCompressedBytesENC, and ending with a final call to EndCompressBytesENC.
		*==============================================================================
		* Method:            BeginCompressBytesENC
		* Purpose:           See description.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqByteData, the byte data to compress.
		* Returns:           Encoded compressed character data.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Large amounts of binary byte data may be compressed in chunks 
