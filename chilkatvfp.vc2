	PROCEDURE getmime		&& Return the email as MIME text containing the email header, body (or bodies), related items (if any), and all attachments. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetMIME
		* Purpose:           Return the email as MIME text.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           lcMIMEText, the generated file name.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Return the email as MIME text containing the email header, 
		** body (or bodies), related items (if any), and all attachments
		**
		** Enhancement for Version 73: 
		** Added more internal flexibility for handling mixtures of CRLF and bare-LF line endings.
		**
		** Returns Nothing on failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcMIMEText AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcMIMEText = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcMIMEText = m.loChilkatObject.GetMIME()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcMIMEText
		
		** Design time IntelliSense test
