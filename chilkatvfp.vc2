		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the UncompressString method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tqInMemoryData AS VarBinary, tcInMemoryCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.UncompressStringAsync(m.tqInMemoryData, m.tcInMemoryCharset)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE uncompressstringenc		&& The same as UncompressString, except the compressed data is provided in encoded string form based on the value of encoding.
		*==============================================================================
		* Method:            UncompressStringEnc
		* Purpose:           The same as UncompressString, except the compressed data 
		*                    is provided in encoded string form based on the value of encoding.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string name to uncompress
		*                    tcCharset -- the string charset
		*                    tcEncoding -- the encoding of the returned string
		* Returns:           Character
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** The same as UncompressString, except the compressed data is provided 
		** in encoded string form based on the value of encoding. 
		** The encoding can be "Base64", "modBase64", "Base32", "UU", "QP" (for quoted-printable), 
		** "URL" (for url-encoding), "Hex", "Q", "B", "url_oath", "url_rfc1738", "url_rfc2396", 
		** and "url_rfc3986".
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcString AS Character, tcCharset AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, lcEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedString = ;
		      m.loChilkatObject.UncompressStringEnc(m.tcString, m.tcCharset, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE untargz		&& Unpacks a .tar.gz file. The ungzip and untar occur in streaming mode. There are no temporary files and the memory footprint is constant (and small) while untarring. bNoAbsolute may be 1 or 0. A value of 1 protects from untarring to absolute paths.
		*==============================================================================
		* Method:            UnTarGz
		* Purpose:           Unpacks a .tar.gz file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcGZipFileName -- the file name on disk to compress
		*                    tcDestinationDir -- the destination directory for the file.
		*                    tuNoAbsolutePaths -- whether or not UnTar via absolute pathing.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Unpacks a .tar.gz file. The ungzip and untar occur in streaming mode. 
		** There are no temporary files and the memory footprint is constant 
		** (and small) while untarring. bNoAbsolute may be 1 or 0. 
		** A value of 1 protects from untarring to absolute paths. 
		** (For example, imagine the trouble if the tar contains files with absolute paths 
		** beginning with /Windows/system32)
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcGZipFileName AS Character, ;
		tcDestinationDir AS Character, tuNoAbsolutePaths AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liNoAbsolutePaths AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liNoAbsolutePaths
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liNoAbsolutePaths = .LogicalToBit(m.tuNoAbsolutePaths)
		
		    TRY
		
		      STORE m.loChilkatObject.UnTarGz(m.tcGZipFileName, ;
		      m.tcDestinationDir, m.liNoAbsolutePaths) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE untargzasync		&& Creates an asynchronous task to call the UnTarGz method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            UnTarGzAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the UnTarGz method with the arguments provided. 
		* Author:            Bill Anderson
