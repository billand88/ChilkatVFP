		*==============================================================================
		
		**
		** (Relevant only when running on a Microsoft Windows operating system.) 
		** Opens a Zip embedded in an MS Windows EXE.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEXEFileName AS Character, tcResourceName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.OpenEmbedded(m.tcEXEFileName, m.tcResourceName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE openfrombytedata		&& Same as OpenFromMemory. When a zip is opened, the PasswordProtect and Encryption properties will be appropriately set. If the zip is password protected (i.e. uses older Zip 2.0 encrypion), then the PasswordProtect property will be set to 1.
		*==============================================================================
		* Method:            OpenFromByteData
		* Purpose:           Same as OpenFromMemory.
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqByteData -- the byte data to open from.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Same as OpenFromMemory.
		**
		** When a zip is opened, the PasswordProtect 
		** and Encryption properties will be appropriately set. 
		** If the zip is password protected (i.e. uses older Zip 2.0 encrypion), 
		** then the PasswordProtect property will be set to 1. 
		** If the zip is strong encrypted, the Encryption property will be set 
		** to a value 1 through 4, where 4 indicates WinZip compatible AES encryption.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqByteData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.OpenFromByteData(m.tqByteData) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE openfrommemory		&& Open a Zip that is completely in-memory. This allows for Zip files to be opened from non-filesystem sources, such as a database. When a zip is opened, the PasswordProtect and Encryption properties will be appropriately set.
		*==============================================================================
		* Method:            OpenFromMemory
		* Purpose:           Open a Zip that is completely in-memory.
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqInMemoryData -- the byte data to open from.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Open a Zip that is completely in-memory. 
		** This allows for Zip files to be opened from non-filesystem sources, such as a database.
		**
		** When a zip is opened, the PasswordProtect 
		** and Encryption properties will be appropriately set. 
		** If the zip is password protected (i.e. uses older Zip 2.0 encrypion), 
		** then the PasswordProtect property will be set to 1. 
		** If the zip is strong encrypted, 
		** the Encryption property will be set to a value 1 through 4, 
		** where 4 indicates WinZip compatible AES encryption.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqInMemoryData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.OpenFromMemory(m.tqInMemoryData) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE openmyembedded		&& (Relevant only when running on a Microsoft Windows operating system.) Opens a Zip embedded within the caller's MS Windows EXE. Returns 1 for success, 0 for failure.
		*==============================================================================
