	PROCEDURE savetofile		&& Introduced in version 9.5.0.62. Saves the string table to a file. The charset is the character encoding to use, such as "utf-8", "iso-8859-1", "windows-1252", "Shift_JIS", "gb2312", etc.
		*==============================================================================
		* Method:            SaveToFile
		* Purpose:           Saves the string table to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset, the charset of the file to save.
		*                    tuCRLF, the number of strings to retrieve.
		*                    tcFilePath, the path to the saved file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62
		**
		** Saves the string table to a file. The charset is the character encoding to use, 
		** such as "utf-8", "iso-8859-1", "windows-1252", "Shift_JIS", "gb2312", etc. 
		** If bCrlf is 1, then CRLF line endings are used, otherwise LF-only line endings are used.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCharset AS Integer, ;
		tuCRLF AS Unknown, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_STRINGTABLE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liCRLF AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCRLF, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 62
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCRLF = .LogicalToBit(m.tuCRLF)
		
		      TRY
		
		        STORE m.loChilkatObject.SaveToFile(m.tcCharset, m.liCRLF, m.tcFilePath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sort		&& Introduced in version 9.5.0.87. Sorts the strings in the collection in ascending or descending order. To sort in ascending order, set ascending to 1, otherwise set ascending equal to 0. Returns 1 for success, 0 for failure.
