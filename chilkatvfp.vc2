	PROCEDURE getowner		&& Introduced in version 9.5.0.50. Returns owner name, if available, for the Nth file. If empty, then no owner information is available. Note: When MLSD is used to get directory listings, it is likely that the owner and group information is not transmitted
		*==============================================================================
		* Method:            GetOwner
		* Purpose:           Returns owner name, if available, for the Nth file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the file array.  
		* Returns:           lcOwner, the owner name of the file.
		* Date Added:        03/03/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		**
		** Returns owner name, if available, for the Nth file. 
		** If empty, then no owner information is available.
		**
		** Note: When MLSD is used to get directory listings, 
		** it is likely that the owner and group information is not transmitted. 
		** In cases where the FTP server is on a UNIX/Linux system, 
		** the AllowMlsd property can be set to 0 
		** to force UNIX directory listings instead of MLSD directory listings. 
		** This should result in being able to obtain owner/group information. 
		** However, it may sacrifice the quality and accuracy 
		** of the various date/time values that are returned.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		lcOwner AS Character, llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 50
		lcOwner = []
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcOwner = m.loChilkatObject.GetOwner(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcOwner
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

