		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendonefileordir		&& Appends a single file or directory to the Zip object. The saveExtraPath applies when fileOrDirPath is an absolute (non-relative) path. If saveExtraPath is 1, then the absolute path is made relative and saved in the zip.
		*==============================================================================
		* Method:            AppendOneFileOrDir
		* Purpose:           Appends a single file or directory to the Zip object. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileOrDirectoryPath -- the path to the file/directory.
		*                    tuSaveExtraPath -- whether or not to save the full path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Appends a single file or directory to the Zip object. 
		** The saveExtraPath applies when fileOrDirPath is an absolute (non-relative) path. 
		** If saveExtraPath is 1, then the absolute path is made relative and saved in the zip. 
		** For example, if the fileOrDirPath is "C:/temp/xyz/test.txt" 
		** and saveExtraPath is 1, then the path in the zip will be "./temp/xyz/test.txt". 
		** If however, fileOrDirPath contains a relative path, then saveExtraPath has no effect.
		**
		** Fixed for version 69: Fixed this method for the case when a UNC path is passed.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFileOrDirectoryPath AS Character, tuSaveExtraPath AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liSaveExtraPath AS Integer
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liSaveExtraPath = .LogicalToBit(m.tuSaveExtraPath)
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.AppendOneFileOrDir(m.tcFileOrDirectoryPath, m.liSaveExtraPath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

