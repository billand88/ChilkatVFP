	PROCEDURE unobfuscate		&& Introduced in version 9.5.0.80. Unobfuscates the string.
		*==============================================================================
		* Method:            UnObfuscate
		* Purpose:           UnObfuscates the string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the string to UnObfuscate
		* Returns:           
		* Date Added:        03/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80.
		**
		** Unobfuscates the string.
		**
		** The Chilkat string obfuscation algorithm works by taking the utf-8 bytes of the string, 
		** base64 encoding it, and then scrambling the letters of the base64 encoded string. 
		** It is deterministic in that the same string will always obfuscate to the same result. 
		** It is not a secure way of encrypting a string. 
		** It is only meant to be a simple means of transforming a string into something unintelligible.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.UnObfuscate()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE writefile		&& Introduced in version 9.5.0.62. Writes the contents to a file. If emitBom is 1, then the BOM (also known as a preamble), is emitted for charsets that define a BOM (such as utf-8, utf-16, utf-32, etc.). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            WriteFile
		* Purpose:           Writes the contents to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the written file.
		*                    tcCharset, the charset used in decoding the bytes.
		*                    tuBOMNeeded, whether a BOM is necessary.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62.
		**
		** Writes the contents to a file. 
		** If emitBom is 1, then the BOM (also known as a preamble), 
		** is emitted for charsets that define a BOM (such as utf-8, utf-16, utf-32, etc.)
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath AS Character, tcCharset AS Integer, tuBOMNeeded AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown, ;
		loException AS Exception, liBOMNeeded AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild, m.liBOMNeeded
