		** Returns the password-based encryption (PBE) salt bytes as an encoded string. 
		** The encoding argument can be set to any of the following strings: 
		** "base64", "hex", "quoted-printable", or "url".
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedSalt AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedSalt = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedSalt = m.loChilkatObject.GetEncodedSalt(m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedSalt
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getlastcert		&& Returns the last certificate used when verifying a signature. This method is decremented. Applications should instead call GetSignerCert with an index of 0. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetLastCert
		* Purpose:           Returns the last certificate used when verifying a signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat Certificate object.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Returns the last certificate used when verifying a signature. 
		** This method is decremented. Applications should instead call 
		** GetSignerCert with an index of 0.
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.GetLastCert()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loChilkatCert  = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData.
		*==============================================================================
		* Method:            GetLastJsonData
		* Purpose:           Adds a certificate to be used for public-key encryption.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Provides information about what transpired in the last method called. 
		** For many methods, there is no information. For some methods, 
		** details about what transpired can be obtained via LastJsonData.
		**
		** Fixed in Version 11.2.0: Many classes have a GetLastJsonData method. 
		** This method was fixed to avoid clearing the contents of the LastErrorText.
		** 
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatJSONObject
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		    loChilkatJSONObject = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      m.loChilkatObject.GetLastJsonData(m.loChilkatJSONObject)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatJSONObject = ;
		    m.loParkParameterCert.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatJSONObject
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsignaturesigningtime		&& Undocumented method! This method can be called after a digital signature is verified to retrieve the signing time of the Nth certificate used for signing. The 1st certificate/signing time is at index 0.
		*==============================================================================
		* Method:            GetSignatureSigningTime
		* Purpose:           Undocumented mehtod!
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the signature index value
		* Returns:           The random encoded bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		** 
		** Undocumented method! Assumed to return a VFP DateTime value.
		**
		**  This method can be called after a digital signature is verified to retrieve the
		**  signing time of the Nth certificate used for signing. The 1st
		**  certificate/signing time is at index 0. The NumSignerCerts property contains the
		**  total number of signing certificates. (Typically, a single certificate is used
		**  in creating a digital signature.)
		**  
		**  Note: An application should first check to see if a signing date/time is
		**  available for the Nth certificate by calling the HasSignatureSigningTime method.
		**  The indices for which there is no signing time available should be skipped.
		** 
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, ltSigning AS DateTime
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		ltSigning = {/:}
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        ltSigning = m.loChilkatObject.GetSignatureSigningTime(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.ltSigning
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsignaturesigningtimestr		&& The same as GetSignatureSigningTime, except the date/time is returned in RFC822 string format. Returns Nothing on failure
		*==============================================================================
		* Method:            GetSignatureSigningTimeStr
		* Purpose:           The same as GetSignatureSigningTime, 
		*                    except the date/time is returned in RFC822 string format.
		* Author:            Bill Anderson
