	PROCEDURE opensession		&& Introduced in version 9.5.0.88. Opens a session on the token (i.e. smart card). The slotId is the ID of the slot (not the index). Set slotId equal to -1 to choose the first available non-empty slot.
		*==============================================================================
		* Method:            OpenSession
		* Purpose:           Opens a session on the token (i.e. smart card).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiSlotID, the slot ID of the token's slot.
		*                    tuIsReadWrite, whether or not the session is read-write.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.88
		** 
		** Opens a session on the token (i.e. smart card). 
		** The slotId is the ID of the slot (not the index). 
		** Set slotId equal to -1 to choose the first available non-empty slot. 
		** The readWrite indicates whether the session should be read-only or read-write.
		** 
		** The PKCS11 terminology is confusing:
		** 
		**   A "slot" corresponds to a connected smart card reader or USB hardware token, 
		**   such as a Feitian ePass3003Auto token.
		**
		**   A "token" corresponds to the smart card inserted into the reader. 
		**   If we have a USB hardware token, such as the epass3003Auto (or many others), 
		**   then technically there is always a "smart card" inserted, 
		**   because the USB hardware token is effectively both the reader 
		**   and smart card wrapped in one inseparable device.
		**   
		**   The PKCS11 DLL (or .so shared lib, or .dylib) is the vendor supplied PKCS11 implementation 
		**   (driver) that provides the low-level "C" PKCS11 functions (called by Chilkat internally).
		**   
		**   Generally, the number of slots will equal the number of connected smart cards 
		**   or tokens belonging to the vendor of the DLL, or compatible with the DLL. 
		**   In most cases you'll have your single reader with a single smart card inserted, 
		**   and therefore only one slot exists.
		**   
		**   Some PKCS11 DLLs are provided by a 3rd party and support many smart cards. 
		**   For example, A.E.T. Europe B.V.'s "SafeSign Identity Client Standard Version 3.5" DLL 
		**   is "aetpkss1.dll". It supports the following tokens:
		**   
		**     Defensiepas
		**     Defensiepas 2
		**     G&D Convego Join 4.01 40k/80k
		**     G&D SkySIM Hercules
		**     G&D SkySIM Scorpius
		**     G&D Sm@rtCafé Expert 3.2
		**     G&D Sm@rtCafé Expert 4.0
		**     G&D Sm@rtCafé Expert 5.0
		**     G&D Sm@rtCafé Expert 6.0
		**     G&D Sm@rtCafé Expert 7.0
		**     G&D Sm@rtCafé Expert 64
		**     Gemalto Desineo ICP D72 FXR1 Java
		**     Gemalto IDCore 30
		**     Gemalto MultiApp ID v2.1
		**     Gemalto Optelio D72 FR1
		**     Gemalto TOP DL v2
		**     Infineon Oracle JCOS Ed.1
		**     JCOP21 v2.3
		**     Morpho IDealCitiz v2.1
		**     Morpho JMV ProCL V3.0
		**     NXP J2A080 / J2A081 (JCOP 2.4.1 R3)
		**     NXP JD081 (JCOP 2.4.1 R3)
		**     NXP J3A080 (JCOP 2.4.1 R3)
		**     NXP JCOP 2.4.2 R3
		**     NXP JCOP 3 SecID P60
		**     Oberthur IDOne Cosmo v7.0
		**     RDW ABR kaart
		**     Rijkspas
		**     Rijkspas 2
		**     Sagem YpsID s2
		**     Sagem YpsID s3
		**     StarSign Crypto USB Token S
		**     Swissbit PS-100u SE
		**     UZI-pas
		**     UZI-pas 2
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiSlotID AS Integer, tuIsReadWrite AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liIsReadWrite AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIsReadWrite, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 88
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIsReadWrite = .LogicalToBit(m.tuIsReadWrite)
		
		      TRY
		
		        STORE m.loChilkatObject.OpenSession(m.tiSlotID, m.liIsReadWrite) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE quicksession		&& Introduced in version 9.5.0.96. Quickly establishes a session on the 1st unempty slot, with or without login. If the pin is the empty string, then no login will take place.
		*==============================================================================
		* Method:            QuickSession
		* Purpose:           Quickly establishes a session on the 1st unempty slot, with or without login.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiUserType, the user type.
		*                    tcPIN, the PIN string.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		** 
		** Quickly establishes a session on the 1st unempty slot, with or without login. 
		** If the pin is the empty string, then no login will take place. 
		** The userType can be one of the following integer values:
		** 
		** Security Officer (0)
		** Normal User (1)
		** Context Specific (2)
		** 
		** Except for special circumstances, you should always select Normal User. 
		** If pin is the empty string, then no login takes place and userType is ignored.
		** 
		** Calling this method takes the place of making separate calls to Initialize, OpenSession, and Login.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiUserType AS Integer, tcPIN AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.QuickSession(m.tiUserType, m.tcPIN) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setpin		&& Introduced in version 9.5.0.89. Modifies the PIN of the user that is currently logged in, or the Normal User PIN if the session is not logged in. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetPIN
		* Purpose:           Modifies the PIN of the user that is currently logged in.
		*                    or the Normal User PIN if the session is not logged in.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOldPIN, the old PIN value.
		*                    tcNewPIN, the new PIN value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.89
		**
		** Modifies the PIN of the user that is currently logged in, 
		** or the Normal User PIN if the session is not logged in.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcOldPIN AS Character, tcNewPIN AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 89
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetPIN(m.tcOldPIN, m.tcNewPIN) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE sharedlibpath_access		&& Access method used to retrieve the Chilkat PKCS11 SharedLibPath property.
		*==============================================================================
		* Method:            SharedLibPath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PKCS11 SharedLibPath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SharedLibPath
		* Date Added:        07/12/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.88
		** 
		** On Windows systems, then should be set to the name of the DLL file 
		** (if the DLL is located in C:\Windows\System32), or it can be the full path to the DLL.
		** 
		** On Linux, MacOSX, or other non-Windows systems, 
		** this can also be either the full path to the .so or .dylib, 
		** or just the .so or .dylib filename. On these systems, 
		** Chilkat calls the dlopen system function to load the shared library. 
		** If just the filename is passed in, the directories searched are those indicated 
		** in the dlopen function description at https://man7.org/linux/man-pages/man3/dlopen.3.html
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 88
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE sharedlibpath_assign		&& Assign method used to hold a reference to the SharedLibPath property.
		*==============================================================================
		* Method:            SharedLibPath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PKCS11 SharedLibPath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SharedLibPath property.
		* Returns:           
		* Date Added:        07/12/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 88
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sigcontextpin_access		&& Access method used to retrieve the Chilkat PKCS11 SigContextPIN property.
		*==============================================================================
		* Method:            SigContextPIN_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PKCS11 SigContextPIN property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SigContextPIN
		* Date Added:        11/18/2023
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.97
		**
		** If the smart card or token requires a signature context login within the signing operation, 
		** then set this property to the context-specific signature PIN. 
		** Most smart cards do not need this. Don't set this property 
		** unless you know for sure your smart card needs it.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 97
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

