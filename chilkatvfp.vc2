	HIDDEN PROCEDURE filedatetimestr_access		&& Access method used to retrieve the Chilkat ZIPEntry FileDateTimeStr property.
		*==============================================================================
		* Method:            FileDateTimeStr_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIPEntry FileDateTimeStr property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        
		* Returns:           THIS.FileDateTimeStr
		* Date Added:        05/02/2022
		*==============================================================================
		
		**
		** The local last-modified date/time in RFC822 string format.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE filedatetimestr_assign		&& Assign method used to hold a reference to the FileDateTimeStr property.
		*==============================================================================
		* Method:            FileDateTimeStr_Assign
		* Purpose:           Assign method used to hold a reference to the FileDateTimeStr property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold 
		*                    a reference to the FileDateTimeStr property.
		* Returns:           
		* Date Added:        05/02/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE filedatetime_access		&& Access method used to retrieve the Chilkat ZIPEntry FileDateTime property.
		*==============================================================================
		* Method:            FileDateTime_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZipEntry FileDateTime property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FileDateTime
		* Date Added:        05/27/2022
		*==============================================================================
		
		**
		** Undocumented property! See FileDateTimeStr method. 
		** It is assumed that this method returns the value in a DateTime format.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [DateTime]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN {/:}
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		  
	ENDPROC

	HIDDEN PROCEDURE filedatetime_assign		&& Assign method used to hold a reference to the FileDateTime property.
		*==============================================================================
		* Method:            FileDateTime_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat ZipEntry FileDateTime property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        ttValue, datetime value 
		*                    used to hold a reference to the FileDateTime property.
		* Returns:           
		* Date Added:        05/27/2022
		*==============================================================================
		
		LPARAMETERS ttValue AS DateTime
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    lcValidationMethod = []
		    lcMethodToCall = [DateTime]
		
		    .CallAssignObject(m.ttValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

