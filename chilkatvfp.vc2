		    ** OK to continue test
		    IF m.liSkip = 0
		
		      llReturn = .BeginUploadFile_Process(m.lcPath, m.liSkip)
		
		      ** OK to continue test
		      IF m.liSkip = 0
		
		        llReturn = .BeginUploadFile_Post(m.lcPath, m.liSkip)
		
		      ENDIF m.liSkip = 0
		      ** End OK to continue test
		
