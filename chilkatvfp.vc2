		*                    used to hold a reference to the ProxyPort property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE ptext		&& Sends an HTTP request to the url. The verb can be "POST", "PUT", "PATCH", etc. The body of the HTTP request contains the text passed in textData. The contentType is a content type such as "text/xml", "application/json", etc.
		*==============================================================================
		* Method:            PText
		* Purpose:           Sends an HTTP request to the url.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb, the operation to run.
		*                    tcURL, the URL to send the request. 
		*                    tcTextData, the body of the HTTP request.
		*                    tcCharset, the character set of the HTTP request body.
		*                    tcContentType, the HTTP content type.
		*                    tuMD5Header, set to 1 to add MD5 header to tcLocalFilePath.
		*                    tuGZip, set to 1 if tcTextData is gZip compressed.
		* Returns:           Chilkat HTTP Response Object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		**
		** Sends an HTTP request to the url. 
		** The verb can be "POST", "PUT", "PATCH", etc. 
		** The body of the HTTP request contains the text passed in textData. 
		** The contentType is a content type such as "text/xml", "application/json", etc. 
		** If md5 is 1, then a Content-MD5 header is added with the base64 MD5 hash of the textData. 
		** Servers aware of the Content-MD5 header will perform 
		** a message integrity check to ensure that the data has not been corrupted. 
		** If gzip is 1, the contentType is compressed using the gzip algorithm. 
		** The HTTP request body will contain the GZIP compressed data, 
		** and a "Content-Encoding: gzip" header is automatically 
		** added to indicate that the request data needs to be ungzipped when received (at the server).
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fix for version 80: The PText method returned non-null (i.e. returned an HttpResponse object) 
		** when a failure occurred such that no response was ever received, 
		** and therefore the responseObject’s status code would be 0. The correct behavior is to return NULL.
		**
		** Starting in version 97: 
		**
		** If the HTTP verb is “OPTIONS”, then Chilkat will now allow for the path to be “*”. 
		** Previously, Chilkat forced the path in the HTTP start line to begin with a “/”. 
		** Also, when the HTTP verb is OPTIONS, no “Content-Length” header
		** will be included in the request.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Fixed in version 11.2.0: Fixed: The (deprecated) PText method returned null 
		** for response status codes in the 400’s when it should’ve returned the HttpResponse object.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character, tcTextData AS Character, ;
		tcCharset AS Character, tcContentType AS Character, tuMD5Header AS Unknown, ;
		tuGZip AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL, ;
		liMD5Header AS Integer, liGZip AS Integer
		
		STORE 0 TO m.liMD5Header, m.liGZip 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse
		
		llImplemented = .F.
		liIntroducedInBuild = 46
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liMD5Header = .LogicalToBit(m.tuMD5Header)
		      liGZip = .LogicalToBit(m.tuGZip)
		
		      TRY
		
		        loChilkatHTTPResponse = m.loChilkatObject.PText(m.tcVerb, ;
		        m.tcURL, m.tcTextData, m.tcCharset, m.tcContentType, m.liMD5Header, m.liGZip)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE ptextasync		&& Creates an asynchronous task to call the PText method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
