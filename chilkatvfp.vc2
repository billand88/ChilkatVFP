	PROCEDURE movemember		&& Introduced in version 9.5.0.80. Move the member from fromIndex to toIndex. If toIndex equals -1, then moves the member at position fromIndex to the last position. Set toIndex = 0 to move a member to the first position.
		*==============================================================================
		* Method:            MoveMember
		* Purpose:           Move the member from fromIndex to toIndex.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiFromIndex, the current JSON member location.
		*                    tiToIndex, the new JSON member location.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Move the member from fromIndex to toIndex. If toIndex equals -1, 
		** then moves the member at position fromIndex to the last position. 
		** Set toIndex = 0 to move a member to the first position.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiFromIndex AS Integer, tiToIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.MoveMember(m.tiFromIndex, m.tiToIndex) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
