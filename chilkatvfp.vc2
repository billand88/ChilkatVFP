		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FindObject(m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		 
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE geneckey		&& Introduced in version 9.5.0.96. Generate an EC key pair suitable for signing data and verifying signatures. The private key is created on the HSM (smart card or token), and the public key is returned in pubKey.
		*==============================================================================
		* Method:            GenEcKey
		* Purpose:           Generate an EC key pair suitable for signing data and verifying signatures.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONPublicAttrs, a Chilkat JSON object.
		*                    toChilkatJSONPrivateAttrs, a Chilkat JSON object.
		*                    toChilkatJSONOut, a Chilkat JSON object.
		*                    toChilkatPublicKey, a Chilkat Public Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		** 
		** Generate an EC key pair suitable for signing data and verifying signatures. 
		** The private key is created on the HSM (smart card or token), and the public key is returned in pubKey. 
		** The publicAttrs and privateAttrs contain attributes for the public and private keys respectively. 
		** The PKCS11 public and private key handles are returned in jsonOut. 
		** Handles are used to reference a PKCS11 object, such as a public or private key, 
		** and are valid during the PKCS11 session. To use the key in future PKCS11 sessions, 
		** your application would need to find the object to get a new handle.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJSONPublicAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatJSONPrivateAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatJSONOut AS CHILKAT_JSONOBJECT_COM_CALL, toChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PKCS11_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterJSONPublicAttrs AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONPublicAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterJSONPrivateAttrs AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONPrivateAttrs AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterJSONOut AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONOut AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterPublicKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPublicKey AS CHILKAT_PUBLICKEY_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONPublicAttrs, m.loChilkatJSONPublicAttrs, ;
		m.loParkParameterJSONPrivateAttrs, m.loChilkatJSONPrivateAttrs, ;
		m.loParkParameterJSONOut, m.loChilkatJSONOut, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONPublicAttrs = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONPublicAttrs)
		
		      loParkParameterJSONPrivateAttrs = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONPrivateAttrs)
		
		      loParkParameterJSONOut = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONOut)
		
		      loParkParameterPublicKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPublicKey)
		
		      loChilkatJSONPublicAttrs = m.loParkParameterJSONPublicAttrs.GetObject()
		      loChilkatJSONPrivateAttrs = m.loParkParameterJSONPrivateAttrs.GetObject()
		      loChilkatJSONOut = m.loParkParameterJSONOut.GetObject()
		      loChilkatJSONPublicKey = loParkParameterJSONPublicKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenEcKey(m.loChilkatJSONPublicAttrs, ;
		        m.loChilkatJSONPrivateAttrs, m.loChilkatJSONOut, m.loChilkatJSONPublicKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONPublicAttrs = loParkParameterJsonObject.SetObject(;
		      toParkParameterJSONPublicAttrs, m.loParkParameterJSONPublicAttrs)
		
		      toChilkatJSONPrivateAttrs = loParkParameterJsonObject.SetObject(;
		      toParkParameterJSONPrivateAttrs, m.loParkParameterJSONPrivateAttrs)
		
		      loChilkatJSONOut = ;
		      loParkParameterJsonObject.SetObject(m.toChilkatJSONOut, m.loChilkatJSONOut)
		
		      loChilkatPublicKey = ;
		      m.loParkParameterPublicKey.SetObject(m.toChilkatPublicKey, m.loChilkatPublicKey)
		  
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONPublicAttrs, m.loChilkatJSONPublicAttrs, ;
		m.loParkParameterJSONPrivateAttrs, m.loChilkatJSONPrivateAttrs, ;
		m.loParkParameterJSONOut, m.loChilkatJSONOut, ;
		m.loParkParameterPublicKey, m.loChilkatPublicKey
		
		RETURN m.luReturn
		
