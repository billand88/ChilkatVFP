	PROCEDURE getchildattrvalue		&& Introduced in version 9.5.0.77. Returns the content of a descendant child having a specified attribute. The tagPath can be a tag or a tag path. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetChildAttrValue
		* Purpose:           Returns the content of a descendant child having a specified attribute.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTagPath -- the tag or tagpath to search for.
		*                    tcAttributeName -- the attribute name to locate.
		* Returns:           The content
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Returns the content of a descendant child having a specified attribute. 
		** The tagPath can be a tag or a tag path.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTagPath AS Character, tcAttributeName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcContent AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcContent = []
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcContent = m.loChilkatObject.GetChildAttrValue(m.tcTagPath, m.tcAttributeName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcContent
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getchildboolvalue		&& Returns 0 if the node's content is "0", otherwise returns 1 if the node contains a non-zero integer. The tagPath can be a tag or a tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path.
		*==============================================================================
		* Method:            GetChildBoolValue
		* Purpose:           Returns 0 if the node's content is "0", otherwise 
		*                    returns 1 if the node contains a non-zero integer.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTagPath -- the tag or tagpath to search for.
		* Returns:           Returns 0 or 1.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Returns 0 if the node's content is "0", 
		** otherwise returns 1 if the node contains a non-zero integer. 
		** The tagPath can be a tag or a tag path.
		** Beginning in version 9.5.0.64, the tagPath can be a tag path. 
		**
		** A tag path is a series of tags separated by vertical bar characters. 
		** For example: "colors|primary|red".
		**
		
		LPARAMETERS tcTagPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.GetChildBoolValue(m.tcTagPath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getchildcontent		&& Returns the content of a child having a specified tag. The tagPath can be a tag or a tag path. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*==============================================================================
		* Method:            GetChildContent
		* Purpose:           Returns the content of a child having a specified tag.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTagPath -- the tag or tagpath to search for.
		* Returns:           The tag content
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Returns the content of a child having a specified tag. 
		** The tagPath can be a tag or a tag path.
		** 
		** Beginning in version 9.5.0.64, the tagPath can be a tag path. 
		** A tag path is a series of tags separated by vertical bar characters. 
		** For example: "colors|primary|red".
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTagPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, lcValue AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcValue = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
