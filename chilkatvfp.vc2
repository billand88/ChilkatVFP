	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat Socket AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        05/26/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE acceptfailreason_access		&& Access method used to retrieve the Chilkat Socket AcceptFailReason property.
		*==============================================================================
		* Method:            AcceptFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket AcceptFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AcceptFailReason
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		** 
		** If a AcceptNextConnection method fails, this property can be checked 
		** to determine the reason for failure.
		**
		** Note: If accepting a TLS connection, then this property can also have 
		** any of the values listed for the ReceiveFailReason and SendFailReason properties 
		** (because the TLS handshake involves sending/receiving on the initial TCP socket).
		** 
		** Possible values are:
		** 
		** 0 = Success
		** 1 = An async operation is  in progress.
		** 3 = An unspecified internal failure, perhaps out-of-memory, caused the failure.
		** 5 = Timeout.  No connections were accepted in the amount of time alotted.
		** 6 = The receive was aborted by the application in an event callback.
		** 9 = An unspecified fatal socket error occurred (less common).
		** 20 = Must first bind and listen on a port.
		** 99 = The component is not unlocked.
		** 
		** Errors Relating to the SSL/TLS Handshake:
		** 
		** 100 = TLS internal error.
		** 102 = Unexpected handshake message.
		** 109 = Failed to read handshake messages.
		** 114 = Failed to send change cipher spec handshake message.
		** 115 = Failed to send finished handshake message.
		** 116 = Client's Finished message is invalid.
		** 117 = Unable to agree on TLS protocol version.
		** 118 = Unable to agree on a cipher spec.
		** 119 = Failed to read the client's hello message.
		** 120 = Failed to send handshake messages.
		** 121 = Failed to process client cert message.
		** 122 = Failed to process client cert URL message.
		** 123 = Failed to process client key exchange message.
		** 124 = Failed to process certificate verify message.
		** 125 = Received and rejected an SSL 2.0 connection attempt.
		**
		** Fixed for Verison 52: Fixed and improved this property.
		** 
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 50
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE acceptfailreason_assign		&& Assign method used to hold a reference to the AcceptFailReason property.
		*==============================================================================
		* Method:            AcceptFailReason_Assign
		* Purpose:           Assign method used to hold a reference to the AcceptFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the AcceptFailReason property.
		* Returns:           
		* Date Added:        05/26/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 50
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE acceptnext		&& Introduced in version 11.0.0. This method accepts the next incoming connection and stores the result in socket. maxWaitMs specifies the maximum wait time in milliseconds; set it to 0 for an indefinite wait. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AcceptNext
		* Purpose:           This method accepts the next incoming connection 
		*                    and stores the result in socket.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaximumMillisecondWait , the maximum wait time.
		*                    toChilkatSocket, a Chilkat Socket object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** This method accepts the next incoming connection and stores the result in socket. 
		** maxWaitMs specifies the maximum wait time in milliseconds; set it to 0 for an indefinite wait.
		**
		** Important: For SSL/TLS connections, the TLS handshake, 
		** which establishes algorithms and a shared key, is part of the connection process. 
		** This involves several client-server message exchanges 
		** governed by the MaxReadIdleMs and MaxSendIdleMs settings. 
		** If these are set to 0 (the default unless changed by your application), 
		** the method may hang indefinitely during the handshake. 
		** Ensure these properties are set appropriately before using this method.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiMaximumMillisecondWait AS Integer, toChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, luReturn AS Unknown, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSocket)
		
		      loChilkatSocket = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AcceptNext(m.tiMaximumMillisecondWait, ;
		        m.loChilkatSocket) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSocket = ;
		      m.loParkParameterSocket.SetObject(m.toChilkatSocket, m.loChilkatSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  toChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE acceptnextasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the AcceptNext method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*==============================================================================
		* Method:            AcceptNextAsync
		* Purpose:           Creates an asynchronous task to call the AcceptNext 
		*                    method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSocket, a Chilkat Binary Data object.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the AcceptNext 
		** method with the arguments provided. 
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiMaximumMillisecondWait AS Integer, toChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSocket)
		
		      loChilkatSocket = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.AcceptNextAsync(;
		        m.tiMaximumMillisecondWait, m.loChilkatSocket)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSocket = ;
		      m.loParkParameterSocket.SetObject(m.toChilkatSocket, m.loChilkatSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  toChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT([Task])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE acceptnextconnection		&& Blocking call to accept the next incoming connection on the socket. maxWaitMs specifies the maximum time to wait (in milliseconds). Set this to 0 to wait indefinitely. If successful, a new socket object is returned.
		*==============================================================================
		* Method:            AcceptNextConnection
		* Purpose:           Blocking call to accept the next incoming connection on the socket.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaxWaitMs -- the maximum millisecond wait for a reply
		* Returns:           loChilkatSocket, a Chilkat Socket object.
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Blocking call to accept the next incoming connection on the socket. 
		** maxWaitMs specifies the maximum time to wait (in milliseconds). 
		** Set this to 0 to wait indefinitely. If successful, a new socket object is returned.
		** 
		** Important: If accepting an SSL/TLS connection, 
		** the SSL handshake is part of the connection establishment process. 
		** This involves a few back-and-forth messages between the client and server 
		** to establish algorithms and a shared key to create the secure channel. 
		** The sending and receiving of these messages are governed by the MaxReadIdleMs 
		** and MaxSendIdleMs properties. If these properties are set to 0 
		** (and this is the default unless changed by your application), 
		** then the AcceptNextConnection can hang indefinitely during the SSL handshake process. 
		** Make sure these properties are set to appropriate values before calling this method.
		**
		** Fixed for Version 41: A bug introduced in v9.5.0.40 in this method (for SSL/TLS) has been fixed. 
		** The bug caused the server certificates to not be sent during the SSL handshake.
		**
		** Fixed for Version 77: Fixed this method, which did not abort 
		** when a separate thread sets the AbortCurrent property. 
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiMaxWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, loChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatSocket 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatSocket = m.loChilkatObject.AcceptNextConnection(m.tiMaxWaitMs)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatSocket
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE acceptnextconnectionasync		&& Creates an asynchronous task to call the AcceptNextConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            AcceptNextConnectionAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the AcceptNextConnection method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaxWaitMs -- the maximum millisecond wait for a reply
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the AcceptNextConnection method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Fixed for Version 77: Fixed this method, which did not abort 
		** when a separate thread sets the AbortCurrent property. 
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiMaxWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.AcceptNextConnectionAsync(m.tiMaxWaitMs)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addsslacceptableclientcadn		&& If this object is a server-side socket accepting SSL/TLS connections,and wishes to require a client-side certificate for authentication,then it should make one or more calls to this method to identify the CA's it will accept for client-side certificates.
		*==============================================================================
		* Method:            AddSSLAcceptableClientCADN
		* Purpose:           Method to identify the CA's it will accept for client-side certificates.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCADN -- the maximum millisecond wait for a reply
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** If this object is a server-side socket accepting SSL/TLS connections, 
		** and wishes to require a client-side certificate for authentication, 
		** then it should make one or more calls to this method to identify 
		** the CA's it will accept for client-side certificates.
		** 
		** If no CA DN's are added by this method, then client certificates from any root CA are accepted.
		** 
		** Important: If calling this method, it must be called before calling InitSslServer.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCADN AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddSSLAcceptableClientCADN(m.tcCADN) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE alpnprotocol_access		&& Access method used to retrieve the Chilkat Socket ALPNProtocol property.
		*==============================================================================
		* Method:            ALPNProtocol_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket ALPNProtocol property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ALPNProtocol
		* Date Added:        05/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.82
		**
		** For TLS connections. Can be set to the name of an application layer protocol.  
		** This causes the ALPN extension to be added to the TLS ClientHello 
		** with the given ALPN protocol name.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 82
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE alpnprotocol_assign		&& Assign method used to hold a reference to the ALPNProtocol property.
		*==============================================================================
		* Method:            ALPNProtocol_Assign
		* Purpose:           Assign method used to hold a reference to the ALPNProtocol property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ALPNProtocol property.
		* Returns:           
		* Date Added:        05/26/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 82
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

