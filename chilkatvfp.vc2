		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE inflatebytes		&& Decompresses data that was compressed with CompressBytes.
		*==============================================================================
		* Method:            InflateBytes
		* Purpose:           Decompresses data that was compressed with CompressBytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the bytes to swap. 
		* Returns:           The decompressed bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Decompresses data that was compressed with CompressBytes.
		** 
		** This is a legacy method that should not be used in new development. 
		** It will not be marked as decremented or removed from future APIs 
		** because existing applications may have data already compressed using CompressBytes.
		** 
		** This method expects the input to begin with an 8-byte header 
		** composed of a 4-byte magic number (0xB394A7E1) 
		** and the 4-byte length of the uncompressed data.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqDecompressedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDecompressedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqDecompressedBytes = m.loChilkatObject.InflateBytes(m.tqData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDecompressedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

