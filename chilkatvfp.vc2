	HIDDEN PROCEDURE cmsoptions_access		&& Access method used to retrieve the Chilkat Crypt2 CMSOptions property.
		*==============================================================================
		* Method:            CMSOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 CMSOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CMSOptions
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.78
		**
		** A JSON string for controlling extra CMS (PKCS7) signature and validation options.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 78
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE cmsoptions_assign		&& Assign method used to hold a reference to the CMSOptions property.
		*==============================================================================
		* Method:            CMSOptions_Assign
		* Purpose:           Assign method used to hold a reference to the CMSOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CMSOptions property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 78
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE compressbytes		&& Bzip2 compresses a byte array and returns the compressed bytes. This is a legacy method that should not be used in new development.
		*==============================================================================
		* Method:            CompressBytes
		* Purpose:           Bzip2 compresses a byte array and returns the compressed bytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to compress. 
		* Returns:           The compressed binary data bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Bzip2 compresses a byte array and returns the compressed bytes.
		** 
		** This is a legacy method that should not be used in new development. 
		** It will not be marked as decremented or removed from future APIs 
		** because existing applications may have data already compressed using this method.
		** 
		** The output of this method includes an 8-byte header composed 
		** of a 4-byte magic number (0xB394A7E1) and the 4-byte length of the uncompressed data.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqCompressedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqCompressedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqCompressedBytes = m.loChilkatObject.CompressBytes(m.tqData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqCompressedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE compressbytesenc		&& Same as CompressBytes, except an encoded string is returned. The output encoding is specified by the EncodingMode property. Returns Nothing on failure.
		*==============================================================================
		* Method:            CompressBytesENC
		* Purpose:           Same as CompressBytes, except an encoded string is returned.
		* Author:            Bill Anderson
