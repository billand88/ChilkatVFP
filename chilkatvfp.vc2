	PROCEDURE unziptostream		&& Introduced in version 9.5.0.67. Unzips a file within a Zip to a stream. If called synchronously, the toStream must have a sink, such as a file or another stream object. If called asynchronously, then the foreground thread can read the stream.
		*==============================================================================
		* Method:            UnZipToStream
		* Purpose:           Unzips a file within a Zip to a stream.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        toChilkatStream, a Chilkat Stream object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** Unzips a file within a Zip to a stream. 
		** If called synchronously, the toStream must have a sink, 
		** such as a file or another stream object. 
		** If called asynchronously, then the foreground thread can read the stream.
		**
		** Fixed for version 73: Fixed reliability issues in this method.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatStream AS CHILKAT_STREAM_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterStream AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStream AS CHILKAT_STREAM_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStream = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStream)
		
		      loChilkatStream = m.loParkParameterStream.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UnZipToStream(m.loChilkatStream) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStream = ;
		      m.loParkParameterStream.SetObject(m.toChilkatStream, m.loChilkatStream)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  toChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loParkParameterStream = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

