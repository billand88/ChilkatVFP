	HIDDEN PROCEDURE lmfactor_access		&& Access method used to retrieve the Chilkat HTTP LMFactor property.
		*==============================================================================
		* Method:            LMFactor_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP LMFactor property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LMFactor
		* Date Added:        01/27/2022
		*==============================================================================
		
		** 
		** An integer between 1 and 100 that indicates the percentage of time 
		** from the HTTP page's last-modified date that will be used for the freshness period. 
		** The default value is 25. 
		** For example, if a page is fetched with a last-modified date of 4 weeks ago, 
		** and the LMFactor = 25, then the page will be considered fresh 
		** in the cache for 1 week (25% of 4 weeks).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lmfactor_assign		&& Assign method used to hold a reference to the LMFactor property.
		*==============================================================================
