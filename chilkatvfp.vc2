	PROCEDURE getmbheaderfield		&& Returns a header field's data in a byte array. If the field was Q or B encoded, this is automatically decoded, and the raw bytes of the field are returned. Call GetHeaderField to retrieve the header field as a Unicode string.
		*==============================================================================
		* Method:            GetMBHeaderField
		* Purpose:           Returns a header field's data in a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFieldName, the header field's name.
		*                    tcCharset, the character set to interpret the data.
		* Returns:           lqBinData, header field content in a byte array.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Returns a header field's data in a byte array. 
		** If the field was Q or B encoded, this is automatically decoded, 
		** and the raw bytes of the field are returned. 
		** Call GetHeaderField to retrieve the header field as a Unicode string.
		**
		** The 1st header field is at index 0. (All Chilkat indexing is 0-based.)
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcFieldName AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lqBinData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqBinData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqBinData = m.loChilkatObject.GetMBHeaderField(m.tcFieldName, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqBinData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getmbhtmlbody		&& Returns the HTML body converted to a specified charset. If no HTML body exists, the returned byte array is empty.
		*==============================================================================
		* Method:            GetMBHTMLBody
		* Purpose:           Returns the HTML body converted to a specified charset.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset, the character set to interpret the HTML body.
		* Returns:           lqBinData, the HTML body data in variant form.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Returns the HTML body converted to a specified charset. 
		** If no HTML body exists, the returned byte array is empty. 
		** The returned data will be such that not only is the character 
		** data converted (if necessary) to the convertToCharset, 
		** but the HTML is edited to add or modify the META tag 
		** that specifies the charset within the HTML.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		**
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lqBinData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqBinData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqBinData = m.loChilkatObject.GetMBHTMLBody(m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqBinData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

