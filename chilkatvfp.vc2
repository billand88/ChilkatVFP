	PROCEDURE createdeb		&& Introduced in version 9.5.0.66. Creates a .deb Debian binary package archive from a control.tar.gz and data.tar.gz. The controlPath is the path to the control.tar.gz file (or equivalent), and the dataPath is the path to the data.tar.gz file.
		*==============================================================================
		* Method:            CreateDeb
		* Purpose:           Creates a .deb Debian binary package archive 
		*                    from a control.tar.gz and data.tar.gz. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcControlPath -- path to the control.tar.gz file
		*                    tcDataPath -- data.tar.gz file
		*                    tcDebPath -- output file path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Creates a .deb Debian binary package archive from a control.tar.gz and data.tar.gz. 
		** The controlPath is the path to the control.tar.gz file (or equivalent), 
		** and the dataPath is the path to the data.tar.gz file. 
		** The output file path (.deb) is specified in debPath.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcControlPath AS Character, tcDataPath AS Character, tcDebPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_TAR_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.CreateDeb(m.tcControlPath, m.tcDataPath, m.tcDebPath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
