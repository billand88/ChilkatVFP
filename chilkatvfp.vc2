	HIDDEN PROCEDURE encodingmode_access		&& Access method used to retrieve the Chilkat RSA EncodingMode property.
		*==============================================================================
		* Method:            EncodingMode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat RSA EncodingMode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EncodingMode
		* Date Added:        07/11/2022
		*==============================================================================
		
		** 
		** Encoding mode to be used in methods ending in "ENC", such as EncryptStringENC. 
		** Valid EncodingModes are "base64", "hex", "url", or "quoted-printable" (or "qp"). 
		** Encryption methods ending in "ENC" will return encrypted data as a string 
		** encoded according to this property's value. 
		** Decryption methods ending in "ENC" accept an encoded string as specified by this property. 
		** The string is first decoded and then decrypted. The default value is "base64".
		** 
		** This property also applies to the "ENC" methods for creating and verifying digital signatures.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE encodingmode_assign		&& Assign method used to hold a reference to the EncodingMode property.
		*==============================================================================
		* Method:            EncodingMode_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat RSA EncodingMode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the EncodingMode property.
		* Returns:           
		* Date Added:        07/11/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE encryptbd		&& Introduced in version 9.5.0.76. RSA encrypts the contents of bd. usePrivateKey should be set to 1 if the private key is to be used for encrypting. Otherwise it should be set to 0 if the public key is to be used for encrypting.
		*==============================================================================
		* Method:            EncryptBd
		* Purpose:           RSA encrypts the contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** RSA encrypts the contents of bd. usePrivateKey should be set to 1 
		** if the private key is to be used for encrypting. 
		** Otherwise it should be set to 0 if the public key is to be used for encrypting.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		** 
		** Note: Except for special situations, the public key should always be used for encrypting, 
		** and the private key for decrypting. This makes sense because an encrypted message 
		** is sent to a recipient, and the recipient is the only one in possession of the private key, 
		** and therefore the only one that can decrypt and read the message.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown, ;
		liUsePrivateKey AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUsePrivateKey, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.EncryptBd(m.loChilkatBinData, m.liUsePrivateKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encryptbytes		&& Encrypts byte data using the RSA encryption algorithm. usePrivateKey should be set to 1 if the private key is to be used for encrypting. Otherwise it should be set to 0 if the public key is to be used for encrypting.
		*==============================================================================
		* Method:            EncryptBytes
		* Purpose:           Encrypts byte data using the RSA encryption algorithm.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to encrypt. 
		*                    tuUsePrivateKey, whether or not a private key is used to decrypt.
		* Returns:           The encrypted binary data bytes.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Encrypts byte data using the RSA encryption algorithm. 
		** usePrivateKey should be set to 1 if the private key is to be used for encrypting. 
		** Otherwise it should be set to 0 if the public key is to be used for encrypting.
		** 
		** Important: If trying to match OpenSSL results, set the LittleEndian property = 0.
		** 
		** Note: Except for special situations, the public key should always be used for encrypting,
		** and the private key for decrypting. This makes sense because an encrypted message 
		** is sent to a recipient, and the recipient is the only one in possession of the private key, 
		** and therefore the only one that can decrypt and read the message.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqData AS VarBinary, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, liUsePrivateKey AS Integer, lqEncryptedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqEncryptedBytes
		
		liUsePrivateKey = .F.
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		    TRY
		
		      lqEncryptedBytes = m.loChilkatObject.EncryptBytes(m.tqData, m.liUsePrivateKey)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqEncryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

