		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT([Task])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fetchuidlset		&& Introduced in version 11.0.0. Fetches the email headers or full emails from the POP3 server whose UIDL is present in the uidls. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FetchUidlSet
		* Purpose:           Fetches the email headers or full emails 
		*                    from the POP3 server whose UIDL is present in the uidls. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuKeepOnServer -- whether to keep on the server or not.
		*                    tuHeadersOnly -- whether or not to download just the header.
		*                    tiNumBodyLines -- the number of body lines to download.
		*                    toChilkatEMailBundle -- a Chilkat EmailBundle object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Fetches the email headers or full emails from the POP3 server whose UIDL is present in the uidls. 
		** If headersOnly is 1, only the headers and the first numBodyLines lines of each email are downloaded, 
		** excluding attachments. Otherwise, the entire emails with attachments are downloaded. 
		** The emails are stored in bundle. The downloaded emails are not deleted from the server.
		**
		** Fixed for Version 11.6.0: Fixed a crash bug.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, tuHeadersOnly AS Unknown, ;
		tiNumBodyLines AS Integer, toChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, liHeadersOnly AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterEMailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL, liKeepOnServer AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liHeadersOnly
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liHeadersOnly = .LogicalToBit(m.tuHeadersOnly)
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMailBundle)
		
		      loChilkatStringTable = m.loParkParameterEMailBundle.GetObject()
		
		      loParkParameterEMailBundle = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMailBundle)
		
		      loChilkatEMailBundle = m.loParkParameterEMailBundle.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FetchUidlSet(m.toChilkatStringTable, ;
		        m.liHeadersOnly, m.tiNumBodyLines, m.loChilkatEMailBundle) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = m.loParkParameterStringTable.SetObject(;
		      m.toChilkatStringTable, m.loChilkatStringTable)
		
		      toChilkatEMailBundle = m.loParkParameterEMailBundle.SetObject(;
		      m.toChilkatEMailBundle, m.loChilkatEMailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
