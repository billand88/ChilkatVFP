	PROCEDURE mxlookup		&& Performs a DNS MX lookup to return the mail server hostname based on an email address. Returns Nothing on failure
		*==============================================================================
		* Method:            MxLookup
		* Purpose:           Performs a DNS MX lookup to return the list of mail 
		*                    server hostnames based on an email address.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEmailAddress -- the email address to determine host name.
		* Returns:           Character
		* Date Added:        01/18/2022
		*==============================================================================
		
		**
		** Performs a DNS MX lookup to return the list of mail 
		** server hostnames based on an email address. 
		** The primary server is at index 0. 
		** In most cases, there is only one mail server for a given email address.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEmailAddress AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, lcMailServerHostName AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcMailServerHostName = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcMailServerHostName = m.loChilkatObject.MxLookup(m.tcEmailAddress)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcMailServerHostName
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE mxlookupall		&& Performs a DNS MX lookup to return the list of mail server hostnames based on an email address. The primary server is at index 0. In most cases, there is only one mail server for a given email address. Returns Nothing on failure.
		*==============================================================================
		* Method:            MxLookupAll
		* Purpose:           Performs a DNS MX lookup to return the list of mail 
		*                    server hostnames based on an email address.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEmailAddress -- the email address to determine host name.
		* Returns:           Character
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Performs a DNS MX lookup to return the list 
		** of mail server hostnames based on an email address. 
		** The primary server is at index 0. In most cases, 
		** there is only one mail server for a given email address.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEmailAddress AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatStringArray 
		
		lcMailServerHostName = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatStringArray = m.loChilkatObject.MxLookupAllAll(m.tcEmailAddress)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatStringArray
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE oauth2accesstoken_access		&& Access method used to retrieve the Chilkat MailMan oAuth2AccessToken property.
		*==============================================================================
		* Method:            OAuth2AccessToken_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan OAuth2AccessToken property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.OAuth2AccessToken
		* Date Added:        01/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** The OAUTH2 access token if OAUTH2 authentication is to be used for the authentication. 
		** For GMail, the Chilkat HTTP class/object's G_SvcOauthAccessToken method 
		** can be called to obtain an OAUTH2 access token for a GMail service account.
		**
		** Starting in v9.5.0.83, this property can be set to also do XOAUTH2 authentication 
		** for POP3 sessions (pop.gmail.com).
		** 
		** Fixed in version 10.1.2: Fixed SMTP XOAUTH2 authentication for SMTP servers 
		** that require two separate commands within the SMTP protocol. 
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 44
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE oauth2accesstoken_assign		&& Assign method used to hold the Chilkat MailMan oAuth2AccessToken property.
		*==============================================================================
