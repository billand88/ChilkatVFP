		*                    used to hold a reference to the StandAlone property.
		* Returns:           
		* Date Added:        05/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE strict_access
		*==============================================================================
		* Method:            Strict_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML Strict property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Strict
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** When Strict is true, the XML loading methods first check that the input is well-formed XML. 
		** If it is not, the load fails and the contents of this Xml object are left unchanged. The default is 0.
		**
		** This applies to LoadXml, LoadXml2, LoadSb, LoadBd, LoadXmlFile and LoadXmlFile2.
		**
		** Chilkat's XML parser is deliberately tolerant. By default it can accept input that is not well-formed, 
		** succeed, and leave a partially populated tree. That is convenient when the goal is a best-effort parse 
		** of imperfect input, but it is the wrong behavior when a silently dropped element or attribute changes 
		** what the application does.
		**
		** Set Strict to 1 for XML carrying configuration, credentials, signed content, or security parameters, 
		** where an element that quietly failed to load would be acted on as though it had never been present.
		**
		** The check is for XML 1.0 well-formedness only. It is not a validating parse: no DTD or schema is read, 
		** and the document is not checked against one. Markup declarations inside an internal DTD subset 
		** are skipped rather than parsed.
		**
		** Note: The default is 0 so that existing applications are unaffected. When a strict load is rejected, 
		** this Xml object keeps whatever it held before the call, so a failed reload never leaves the object empty.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	PROCEDURE strict_assign
		*==============================================================================
		* Method:            Strict_Assign
		* Purpose:           Assign method used to hold the Chilkat XML Strict property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the Strict property.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		LPARAMETERS tiValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE swapnode		&& Swaps another node's tag, content, and attributes with this one. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SwapNode
		* Purpose:           Swaps another node's tag, content, and attributes with this one.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML -- a Chilkat XML object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Swaps another node's tag, content, and attributes with this one.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], luReturn AS Unknown, ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SwapNode(m.loChilkatXML) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE swaptree		&& Swaps another node's tag, content, attributes, and children with this one. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SwapTree
		* Purpose:           Swaps another node's tag, content, attributes, and children with this one.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML -- a Chilkat XML object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Swaps another node's tag, content, attributes, and children with this one.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], luReturn AS Unknown, ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SwapTree(m.loChilkatXML) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE tagcontent		&& Returns the content of the 1st node found in the sub-tree rooted at the caller that has a given tag. (Note: The search for the node having tag ARG is not limited to the direct children of the caller.) Returns Nothing on failure.
		*==============================================================================
		* Method:            TagContent
		* Purpose:           Returns the content of the 1st node found 
		*                    in the sub-tree rooted at the caller that has a given tag.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTagName -- the tag to search for
		* Returns:           The matching content.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Returns the content of the 1st node found in the sub-tree rooted 
		** at the caller that has a given tag. 
		** (Note: The search for the node having tag ARG 
		** is not limited to the direct children of the caller.)
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcTagName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, lcContent AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcContent = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcContent = m.loChilkatObject.TagContent(m.tcTagName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcContent
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

