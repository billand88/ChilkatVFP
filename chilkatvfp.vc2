	PROCEDURE deletetree		&& Deletes the entire subtree and all files from the current remote FTP directory. To delete a subtree on the FTP server, your program would first navigate to the root of the subtree to be deleted by calling ChangeRemoteDir, and then call DeleteTree.
		*==============================================================================
		* Method:            DeleteTree
		* Purpose:           Deletes the entire subtree and all files
		*                    from the current remote FTP directory.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Deletes the entire subtree and all files from the current remote FTP directory. 
		** To delete a subtree on the FTP server, your program would first navigate 
		** to the root of the subtree to be deleted by calling ChangeRemoteDir, and then call DeleteTree. 
		** There are two event callbacks: VerifyDeleteFile and VerifyDeleteDir. 
		** Both are called prior to deleting each file or directory. 
		** The arguments to the callback include the full filepath of the file or directory, 
		** and an output-only "skip" flag. If your application sets the skip flag to true, 
		** the file or directory is NOT deleted. If a directory is not deleted, 
		** all files and sub-directories will remain. 
		** Example programs can be found at http://www.example-code.com/
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DeleteTree() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

