	PROCEDURE useconnection		&& Introduced in version 9.5.0.59. Calling this method is optional, and is only required if a proxy (HTTP or SOCKS), an SSH tunnel, or if special connection related socket options need to be used.
		*==============================================================================
		* Method:            UseConnection
		* Purpose:           Calling this method is optional, and is only required if a proxy, an SSH tunnel, 
		*                    or if special connection related socket options need to be used.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSocket, a Chilkat Socket object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		** 
		** Calling this method is optional, and is only required if a proxy (HTTP or SOCKS), 
		** an SSH tunnel, or if special connection related socket options need to be used. 
		** When UseConnection is not called, the connection to the token endpoint 
		** is a direct connection using TLS (or not) based on the TokenEndpoint. 
		** (If the TokenEndpoint begins with "https://", then TLS is used.)
		**
		** This method sets the socket object to be used for sending the requests 
		** to the token endpoint in the background thread. 
		** The sock can be an already-connected socket, 
		** or a socket object that is not yet connected. In some cases, such as for a connection 
		** through an SSH tunnel, the sock must already be connected. 
		** In other cases, an unconnected sock can be provided because the purpose 
		** for providing the socket object is to specify settings 
		** such as for HTTP or SOCKS proxies.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH2_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		llImplemented = .F.
		liIntroducedInBuild = 59
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSocket)
		
		      loChilkatSocket = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UseConnection(m.loChilkatSocket) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSocket = ;
		      m.loParkParameterSocket.SetObject(m.toChilkatSocket, m.loChilkatSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  toChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat oAuth2 VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/08/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/08/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 59
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS parkparameter AS ibase OF "chilkatvfp.vcx" 		&& Class used to park ChilkatVFP objects and send forward the contained Chilkat (oChilkat property) object, otherwise just pass what was sent.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: getobject
		*m: setobject
		*p: lchilkatvfpobject		&& Property used to determine if the passed parameter is a ChilkatVFP object.
		*p: oobject		&& Object property used to hold the passed object.
	*</DefinedPropArrayMethod>

	*<PropValue>
		lchilkatvfpobject = .F.
		Name = "parkparameter"
		oobject = .NULL.
	*</PropValue>
	
	PROCEDURE Destroy
		*==============================================================================
		* Method:            Destroy
		* Purpose:           Occurs when an object is released.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        12/29/2022
		*==============================================================================
		
		THIS.oObject = NULL
		
		RETURN DODEFAULT()
	ENDPROC

	PROCEDURE getobject
		*==============================================================================
		* Method:            GetObject
		* Purpose:           Method used to retrieve the object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Object
		* Date Added:        12/29/2022
		*==============================================================================
		
		LOCAL loReturn AS Object
		
		WITH THIS
		
		  ** ChilkatVFP object test
		  IF .lChilkatVFPObject
		
		    loReturn = .oObject.oChilkat
		
		  ELSE
		
		    loReturn = .oObject
		
		  ENDIF .lChilkatVFPObject
		  ** End ChilkatVFP object test
		
		ENDWITH
		
		RETURN m.loReturn
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toObject, the passed object.
		* Returns:           Logical, indicating success.
		* Date Added:        12/29/2022
		*==============================================================================
		
		LPARAMETERS toObject AS Object
		
		LOCAL loObject AS Object
		
		loObject = m.toObject
		
		WITH THIS
		
		  ** ChilkatVFP object test
		  IF VARTYPE(m.loObject) == T_OBJECT  ;
		  AND (NOT ISNULL(m.loObject)) ;
		  AND PEMSTATUS(m.loObject, [cVersion], 5) ;
		  AND PEMSTATUS(m.loObject, [oChilkat], 5)
		
		    .lChilkatVFPObject = .T.
		
		  ELSE
		
		    .lChilkatVFPObject = .F.
		
		  ENDIF VARTYPE(m.loObject) == T_OBJECT  ;
		  AND (NOT ISNULL(m.loObject)) ;
		  AND PEMSTATUS(m.loObject, [cVersion], 5) ;
		  AND PEMSTATUS(m.loObject, [oChilkat], 5)
		  ** End ChilkatVFP object test
		
		  .oObject = m.loObject
		
		ENDWITH
		
		RETURN DODEFAULT()
	ENDPROC

	PROCEDURE setobject
		*==============================================================================
		* Method:            SetObject
		* Purpose:           Method used to set the object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        12/29/2022
		*==============================================================================
		
		LPARAMETERS toMethodParameter AS Object, toChilkatObject AS Object
		
		IF PCOUNT() = 2 ;
		AND (VARTYPE(m.toMethodParameter) == T_OBJECT) ;
		AND (VARTYPE(m.toChilkatObject) == T_OBJECT)
		
		  WITH THIS
		
		    ** Chilkat VFP object test
		    IF .lChilkatVFPObject
		
		      toMethodParameter.oChilkat = m.toChilkatObject
		
		    ELSE
		
		      toMethodParameter = m.toChilkatObject
		
		    ENDIF .lChilkatVFPObject
		    ** End Chilkat VFP object test
		
		  ENDWITH
		  
		ENDIF PCOUNT() = 2 ;
		AND (VARTYPE(m.toMethodParameter) == T_OBJECT) ;
		AND (VARTYPE(m.toChilkatObject) == T_OBJECT)
		
		RETURN m.toMethodParameter
	ENDPROC

ENDDEFINE

DEFINE CLASS pdf AS ibasechilkat OF "chilkatvfp.vcx" 		&& A PDF class for various tasks such as signature verification, signing, encrypt, decrypt, etc.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addembeddedfiles		&& Introduced in version 9.5.0.97. Embeds one or more files in a PDF. The json specifies the files to be attached to the PDF.
		*m: addembeddedfilesbd		&& Introduced in version 9.5.0.97. The same as AddEmbeddedFiles, but writes the resultant PDF to the bd. Returns 1 for success, 0 for failure.
		*m: addsigningcert		&& Introduced in version 9.5.0.85. Adds a certificate to be used for PDF signing. To sign with more than one certificate, call AddSigningCert once per certificate. Note: This method is used to provide the ability to sign once with multiple certificates.
		*m: addverificationinfo		&& Introduced in version 9.5.0.93. Adds LTV verification information to the PDF, and saves the updated PDF to outFilePath. This create or update a DSS (Document Security Store) in the PDF with the needed certificates, OCSP responses, and CRL information.
		*m: addverificationinfoasync		&& Introduced in version 9.5.0.93. Creates an asynchronous task to call the AddVerificationInfo method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat PDF DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getdss		&& Introduced in version 9.5.0.85. Gets the contents of the PDF's Document Security Store (/DSS) if it exists. Returns the information in JSON format (in json). If there is no /DSS then an empty JSON document "{}" is returned in json.
		*m: getembeddedfilebd		&& Introduced in version 9.5.0.95. Loads the bd with the contents of the Nth embedded file contained in the currently open PDF. The index specifies the index of the embedded file. The 1st embedded file is at index 0. Returns 1 for success, 0 for failure.
		*m: getembeddedfileinfo		&& Introduced in version 9.5.0.95. Gets information about the Nth embedded file contained in the currently open PDF. The index specifies the index of the embedded file. The 1st embedded file is at index 0. Returns 1 for success, 0 for failure.
		*m: getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData.
		*m: getmetadata		&& Introduced in version 9.5.0.92. If the PDF contains Metadata, then loads the Metadata XML into sb and returns 1. If the PDF does not contain Metadata, then clears sb and returns 0. Returns 1 for success, 0 for failure.
		*m: getsignaturecontent		&& Introduced in version 9.5.0.92. Returns the CMS signature for the Nth signature contained in the PDF. The 1st signature is at index 0. Returns 1 for success, 0 for failure.
		*m: getsignercert		&& Introduced in version 9.5.0.87. This method can be used to get the signer certificate after calling VerifySignature. The index should be the same value as the index passed to VerifySignature.
		*m: getunsignedsigfields		&& Introduced in version 9.5.0.90. Returns JSON containing the name of each unsigned signature field found in the PDF. Returns 1 for success, 0 for failure.
		*m: hascertificationsig_access		&& Access method used to retrieve the Chilkat PDF HasCertificationSig property.
		*m: hascertificationsig_assign		&& Assign method used to hold a reference to the HasCertificationSig property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat PDF LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat PDF LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat PDF LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat PDF LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastjsondata		&& Introduced in version 9.5.0.88. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat PDF LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat PDF LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat PDF LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadbd		&& Introduced in version 9.5.0.85. Loads the PDF file contained in pdfData. Returns 1 for success, 0 for failure.
		*m: loadfile		&& Introduced in version 9.5.0.85. Load a PDF file into this object in memory. Returns 1 for success, 0 for failure.
		*m: numembeddedfiles_access		&& Access method used to retrieve the Chilkat PDF NumEmbeddedFiles property.
		*m: numembeddedfiles_assign		&& Assign method used to hold a reference to the NumEmbedded property.
		*m: numpages_access		&& Access method used to retrieve the Chilkat PDF NumPages property.
		*m: numpages_assign		&& Assign method used to hold a reference to the NumPages property.
		*m: numsignatures_access		&& Access method used to retrieve the Chilkat PDF NumSignatures property.
		*m: numsignatures_assign		&& Assign method used to hold a reference to the NumSignatures property.
		*m: ownerpassword_access		&& Access method used to retrieve the Chilkat PDF OwnerPassword property.
		*m: ownerpassword_assign		&& Assign method used to hold a reference to the OwnerPassword property.
		*m: sethttpobj		&& Introduced in version 9.5.0.85. Sets the HTTP object to be used to communicate with the timestamp authority (TSA) server for cases where long term validation (LTV) of signatures is desired.
		*m: setsignaturejpeg		&& Introduced in version 9.5.0.85. Provides an optional JPG image to be included in the signature appearance. The JPG data is passed in jpgData. Note: JPG images must use the BaseLine format and not the Progressive format.
		*m: setsigningcert		&& Introduced in version 9.5.0.85. Specifies a certificate to be used when signing the PDF. Signing requires both a certificate and private key.
		*m: setsigningcert2		&& Introduced in version 9.5.0.85. Specifies a digital certificate and private key to be used for signing the PDF. Returns 1 for success, 0 for failure.
		*m: sigallocatesize_access		&& Access method used to retrieve the Chilkat PDF SigAllocateSize property.
		*m: sigallocatesize_assign		&& Assign method used to hold a reference to the SigAllocateSize property.
		*m: signpdf		&& Introduced in version 9.5.0.85. Signs the open PDF and if successful writes the signed PDF to the ARG3. The jsonOptions contains information and instructions about the signature.
		*m: signpdfasync		&& Introduced in version 9.5.0.85. Creates an asynchronous task to call the SignPdf method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: signpdfbd		&& Introduced in version 9.5.0.94. Signs the open PDF and if successful writes the signed PDF to the bd. The jsonOptions contains information and instructions about the signature. Returns 1 for success, 0 for failure.
		*m: signpdfbdasync		&& Introduced in version 9.5.0.94. Creates an asynchronous task to call the SignPdfBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat PDF UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: updatemetadata		&& Introduced in version 10.1.0. Updates or adds XMP metdata to a PDF. The metadata is passed in sb. If successful, the PDF with updated or inserted metadata is written to outFilePath. Returns 1 for success, 0 for failure.
		*m: updatemetadatabd		&& Introduced in version 10.1.0. Updates or adds XMP metdata to a PDF. The metadata is passed in sb. If successful, the PDF with updated or inserted metadata is written to bd. Returns 1 for success, 0 for failure.
		*m: userpassword_access		&& Access method used to retrieve the Chilkat PDF UserPassword property.
		*m: userpassword_assign		&& Assign method used to hold a reference to the UserPassword property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat PDF VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifysignature		&& Introduced in version 9.5.0.85. Verifies the Nth signature contained in the PDF, where the 1st signature is indicated by an index of 0. Returns 1 if the signature valid, otherwise returns 0.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: hascertificationsig		&& Introduced in version 9.5.0.96. Returns 1 if the currently open PDF has a certification signature. PDF defines two types of signatures: approval and certification.
		*p: lastbinaryresult		&& The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& The length, in characters, of the string contained in the LastStringResult property.
		*p: numembeddedfiles		&& Introduced in version 9.5.0.95. The number of embedded files present in the currently open PDF.
		*p: numpages		&& Introduced in version 9.5.0.85. The number of pages in the currently open PDF.
		*p: numsignatures		&& Introduced in version 9.5.0.85. The number of digital signatures present in the currently open PDF.
		*p: ownerpassword		&& Introduced in version 11.0.0. The PDF owner password, if required.
		*p: sigallocatesize		&& Introduced in version 9.5.0.91. Defaults to 14400. This property should generally be left unchanged.
		*p: uncommonoptions		&& Introduced in version 9.5.0.85. This is a catch-all property to be used for uncommon needs.
		*p: userpassword		&& Introduced in version 11.0.0. The PDF user password, if required.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Pdf
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		hascertificationsig = 0
		iinstancepatch = 85
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "pdf"
		numembeddedfiles = 0
		numpages = 0
		numsignatures = 0
		ownerpassword = 
		sigallocatesize = 14400
		uncommonoptions = 
		userpassword = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addembeddedfiles		&& Introduced in version 9.5.0.97. Embeds one or more files in a PDF. The json specifies the files to be attached to the PDF.
		*==============================================================================
		* Method:            AddEmbeddedFiles
		* Purpose:           Embeds one or more files in a PDF.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObject, a Chilkat JSON object.
		*                    tcFilePath, the output file path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.97
		**
		** Embeds one or more files in a PDF.
		** 
		** The json specifies the files to be attached to the PDF. See the linked example below.
		** 
		** The json is a JSON object containing an array of JSON objects, where each object can contain the following members.
		** 
		** localFilePath: (required) The local file to be embedded in the PDF.
		**
		** description: (required) It is a short description of the embedded file.
		**
		** subType: (optional) Specifies the file type, such as application/xml, text/plain, etc. 
		** If not specified, then Chilkat will automatically choose a subType based on the file extension.
		**
		** embeddedFilename: (optional) Specifies the name of the file to be used 
		** within the PDF in the desire is for it to be different than the filename in the local filesystem. 
		** If not present, then the filename part of the localFilePath.
		**
		** AFRelationship: (optional starting in v11.1.0) Specifies specify the nature of the relationship 
		** of the embedded file. Possible values are Source, Data, Alternative, Supplement, and Unspecified. 
		** If unset, the default is Alternative.
		**
		** Fixed in version 99: Fixed Pdf.AddEmbeddedFiles to maintain 
		** A-3 compliance (if the PDF was already A-3 compliant).
		**
		** Fixed in version 11.5.0: Fixed a problem where attachments added by calling AddEmbeddedFiles 
		** were subsequently missing after signing
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 97
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddEmbeddedFiles(m.loChilkatJsonObject, m.tcFilePath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addembeddedfilesbd		&& Introduced in version 9.5.0.97. The same as AddEmbeddedFiles, but writes the resultant PDF to the bd. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddEmbeddedFilesBd
		* Purpose:           The same as AddEmbeddedFiles, but writes the resultant PDF to the bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObject, a Chilkat JSON object.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.97
		**
		** The same as AddEmbeddedFiles, but writes the resultant PDF to the bd.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJsonObject, ;
		m.loChilkatJsonObject, m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 97
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddEmbeddedFilesBd(m.loChilkatJsonObject, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addsigningcert		&& Introduced in version 9.5.0.85. Adds a certificate to be used for PDF signing. To sign with more than one certificate, call AddSigningCert once per certificate. Note: This method is used to provide the ability to sign once with multiple certificates.
		*==============================================================================
		* Method:            AddSigningCert
		* Purpose:           Adds a certificate to be used for PDF signing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.85
		**
		** Adds a certificate to be used for PDF signing. 
		** To sign with more than one certificate, call AddSigningCert once per certificate.
		** 
		** Note: This method is used to provide the ability 
		** to sign once with multiple certificates. 
		** This is different than signing with one certificate, 
		** and then signing again with a different certificate.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 85
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddSigningCert(m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		       m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addverificationinfo		&& Introduced in version 9.5.0.93. Adds LTV verification information to the PDF, and saves the updated PDF to outFilePath. This create or update a DSS (Document Security Store) in the PDF with the needed certificates, OCSP responses, and CRL information.
		*==============================================================================
		* Method:            AddVerificationInfo
		* Purpose:           Adds LTV verification information to the PDF, 
		*                    and saves the updated PDF to outFilePath.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObject, a Chilkat JSON object.
		*                    tcFilePath, the output file path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.93
		**
		** Adds LTV verification information to the PDF, and saves the updated PDF to outFilePath. 
		** This create or update a DSS (Document Security Store) in the PDF with the needed certificates, 
		** OCSP responses, and CRL information.
		** 
		** Pass an empty jsonOptions. The jsonOptions exists as a placeholder for adding options if needed.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 93
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddVerificationInfo(m.loChilkatJsonObject, m.tcFilePath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addverificationinfoasync		&& Introduced in version 9.5.0.93. Creates an asynchronous task to call the AddVerificationInfo method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            AddVerificationInfoAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    AddVerificationInfo method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		*                    tcFilePath, the output file path.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        10/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.93
		**
		** Creates an asynchronous task to call the AddVerificationInfo method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, tcFilePath AS Character 
		
		LOCAL loChilkatObject AS CHILKAT_PDF_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 93
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.AddVerificationInfoAsync(m.loChilkatJSONObject, m.tcFilePath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PDF_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.5.0
		
		  Fixed a problem where attachments added by calling AddEmbeddedFiles were subsequently missing after signing.
		
		** Version 11.4.0
		
		  Finding signatures — In very rare cases, some PDFs have signatures that are buried recursively 
		  in the PDF format (this is not normal). Chilkat now finds them for the purpose of verifying signatures.
		
		** Version 11.2.0
		
		  It is now possible to provide a bearer token for authentication with a timestamp server (TSA server) 
		  by doing: json.UpdateString("timestampToken.bearerToken","...");
		
		  Many classes have a GetLastJsonData method. This method was fixed 
		  to avoid clearing the contents of the LastErrorText.
		
		** Version 11.1.0
		
		  Added the AFRelationship JSON option.
		
		** Version 11.0.0
		
		  Added the OwnerPassword and UserPassword properties.
		
		  Added the GetLastJsonData method.
		
		  Decremented the LastJsonData method.
		
		** Version 10.0.1
		
		  Fixed non-us-ascii filename problems regarding the JSON returned by GetEmbeddedFileInfo
		
		** Version 10
		
		  Fixed: Did not recognize some occurrences of embedded files contained within a PDF.
		
		  Fixed case where LoadFile fails with pdfParseError: 3221
		
		  Fixed visual appearance for signatures in landscape oriented PDFs.
		
		  Fixed a problem having to do with sending OCSP requests for ECDSA based certificates.
		
		** Version 99
		
		  Fixed Pdf.AddEmbeddedFiles to maintain A-3 compliance (if the PDF was already A-3 compliant).
		
		** Version 97
		
		  Added the AddEmbeddedFiles method. This provides the ability to attach files to a PDF.
		
		  Fixed problems with auto-sizing the visual box containing the text and/or image for digital signatures.
		
		** Version 96
		
		  Added the HasCertificationSig property to make it easy to see if a PDF’s signature is a certification signature.
		
		  Added encryption and permissions information to the Pdf.LastJsonData for the call to Pdf.LoadFile and Pdf.LoadBd.
		  See https://www.example-code.com/csharp/pdf_get_encryption_and_permissions.asp
		
		** Version 95
		
		  Greatly improved the appearance of non-English text in visible PDF signatures.
		
		  Added the ability to extract embedded files from a PDF.
		  Two new methods were added: GetEmbeddedFileInfo and GetEmbeddedFileBd.
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		  Fixed OCSP requests for ECDSA certificates. This problem also caused PDF signatures
		  using ECDSA cerificates to not be LTV-enabled.
		
		** Version 94
		
		  Fixed problems when signing PDF’s for ICP Brasil (https://verificador.iti.br/).
		  The ICP Brasil validator is quite particular about the internal details of PKCS7
		  signed attributes, and everything must be done in a specific way to be acceptable.
		
		  Fixed visual positioning problems when the PDF is landscape instead of portrait.
		
		  Fixed an issue where certain signed PDF’s were categorized by Chilkat
		  as having an invalid internal signature hash.  (This was a rare condition.)
		
		  Chilkat improved OCSP requests (used in various parts of the Chilkat API)
		  to satisfy some servers that are more picky about certain parts
		  of the OCSP protocol which should be optional.
		
		  Added the SignPdfPb method to provide the ability to sign a PDF but keep it in memory.
		
		** Version 93
		
		  Fixed more issues with LTV signatures, where sometimes Acrobat DC
		  did not consider the signed PDF Long Term Validation enabled.
		
		  Added the AddVerificationInfo method. This is performs the same function as in Adobe Acrobat
		  when right-clicking on a signature and selecting “Add Verification Information”.
		
		  Fixed Brasil ICP signature problems to make the signed PDF pass
		  the verifier at https://verificador.iti.gov.br/verifier-2.10/
		  Note: The signed PDF produced by Chilkat was technically valid, but did not have the optional
		  have the optional features and/or did not do things in the specific way desired by Brasil ICP.
		
		  Fixed signing to produce signed PDF’s conforming to the needs of EU requirements
		  and validated at  https://ec.europa.eu/digital-building-blocks/DSS/webapp-demo/validation
		  Note: The signed PDF produced by Chilkat was technically valid, but did not have
		  the optional features and/or did not do things in the specific way desired by EU validator.
		
		  Also important: A signed PDF produced for the EU validator’s needs
		  would likely not satisfy the Brasil ICP’s needs, and vice-versa.
		
		  If the signed PDF does not satisfy your government’s validator,
		  contact Chilkat and we can determine what is needed by comparing a signed PDF
		  that satisfies a particular validator vs one produced by Chilkat.
		  Also, it may be that (in your particular case) Chilkat still does not produce signed PDF’s
		  that satisfy the above validators.  This means that Chilkat did not auto-recognize
		  the need to produce the signed PDF in that way, and the solution is to set special JSON config options,
		  or contact Chilkat so we can add your case for auto-recognition.
		
		  Fixed problems loading certain rarely encountered PDF’s using internal compression with non-standard settings.
		
		** Version 92
		
		  Fixed some issues with LTV signatures, where Acrobat DC did not consider the signed PDF Long Term Validation enabled.
		
		  Added the ability to specify an ICP Brasil policy profile to automatically set all needed policyId values correctly.
		
		  Fixed some cases where adding a 2nd or 3rd signature to a PDF
		  caused the original signatures to become invalid when viewed in Acrobat DC.
		
		  Added the GetMetadata function to be able to extract the Metadata from a PDF.
		
		** Version 91
		
		  Added the SigAllocateSize property.
		
		** Version 90
		
		  Fixed non-English issues with “reason” for signing.
		
		** Version 87
		
		  Chilkat would automatically choose to “certify” and lock a PDF document
		  when signing a PDF with no existing signatures.
		  This behavior was changed to instead (by default) add an “approval” signature.
		  If the application wishes to add a certification (author) signature (and lock the document),
		  then additional instructions can be added to the JSON to indicate this desire.
		  An example was added to the “PDF Signatures” category on example-code.com to demonstrate.
		
		  Added the GetSignerCert method.
		
		** Version 86
		
		  Immediately after releasing v9.5.0.85, it was discovered that many PDF’s
		  had the following error when viewed in Acrobat DC after signing:
		  “”The signature byte range is invalid””.
		  It was deemed important enough to fix and release v9.5.0.86.
		  Therefore, this version is the same as v9.5.0.85 with this additional fix.
		
		** Version 85
		
		  Added a Pdf class that initially contains methods
		  for cryptographically signing PDFs and for verifying PDF signatures.
		  The Pdf class will be extended in future versions to do many other tasks such as
		  text extraction, PDF compression, attachment extraction, encryption/decryption, etc.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat PDF DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PDF DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/08/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PDF DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        06/08/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 85
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

