	PROCEDURE todecimalstr		&& Introduced in version 9.5.0.56. Some programming languages do not support 64-bit integers. The following properties are implemented as 64-bit ints: Length, NumReceived, NumSent.
		*==============================================================================
		* Method:            ToDecimalStr
		* Purpose:           See fuller explanation below.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPropertyName, the property name to convert.
		* Returns:           The value in character form.
		* Date Added:        06/14/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Some programming languages do not support 64-bit integers. 
		** The following properties are implemented as 64-bit ints: Length, NumReceived, NumSent. 
		** The value of these properties can be retrieved in decimal string form 
		** by passing the property name in propertyName.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcPropertyName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_STREAM_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcValue AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcValue = []
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcValue = m.loChilkatObject.ToDecimalStr(m.tcPropertyName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
