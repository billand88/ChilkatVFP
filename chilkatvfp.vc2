	PROCEDURE enddecompressstringenc		&& Called to finalize the decompression stream and return any remaining (buffered) decompressed data. The input to this method is an encoded string containing compressed data. The EncodingMode property should be set prior to calling this method.
		*==============================================================================
		* Method:            EndDecompressStringENC
		* Purpose:           Called to finalize the decompression stream 
		*                    and return any remaining decompressed data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Encoded decompressed character data.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Called to finalize the decompression stream and return any remaining 
		** (buffered) decompressed data.
		** 
		** The input to this method is an encoded string containing compressed data. 
		** The EncodingMode property should be set prior to calling this method. 
		** The input string is decoded according to the EncodingMode (hex, base64, etc.) 
		** and then decompressed.
		** 
		** (See BeginDecompressStringENC)
		** 
		** Returns Nothing on failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, lcData AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcData = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcData = m.loChilkatObject.EndDecompressStringENC()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

