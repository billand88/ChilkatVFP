	PROCEDURE finalizethreadpool		&& Called to stop and finalize all threads in the thread pool, and causes the thread pool thread to exit.
		*==============================================================================
		* Method:            FinalizeThreadPool
		* Purpose:           Called to stop and finalize all threads in the thread pool, 
		*                    and causes the thread pool thread to exit.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Called to stop and finalize all threads in the thread pool, 
		** and causes the thread pool thread to exit.
		**
		** The following behaviors exist in v9.5.0.64 and later:
		**   All remaining asynchronous tasks are automatically canceled.
		**   Restores the thread pool to it's pristine state where no background threads are running.
		**
		** It is a good idea to call this method at the very end of a program, just before it exits. 
		** This is especially true for programs written in VBScript and VB6.
		**
		** Fixed in Version 64: This method will now cancel any asynchronous methods 
		** that are still running and causes all async background threads to exit.
		** There are certain problems that can happen if the main thread of a program exits 
		** while background threads remain running:
		**   If the program is a VBScript, then I’ve found that AVG Anti-Virus 
		**   will alert the user of a General Behavioral Threat. 
		**   Making sure that all async method calls have finished, 
		**   and that all thread pool threads have exited, should prevent this problem.
		**
		**   If running a VB6 program from the IDE, the IDE will hang on program exit 
		**   until all threads have exited.
		** 
		**   It is likely that exiting the main UI thread while background threads remain 
		**   will cause problems in many other programming environments. 
		**
		** Modified in Version 64: This method returns the software to the pristine initial state 
		** — where no background threads are running, and the thread pool thread is not yet started. 
		** Previously, after FinalizeThreadPool was called, it was not possible to continue 
		** using asynchronous Chilkat methods (without restarting the application). 
		** Now the FinalizeThreadPool method returns the application to the initial pristine state. 
		** A subsequent asynchronous method call will cause the thread pool thread to automatically restart, 
		** and everything proceeds as usual. (This is needed for cases where the ActiveX is used in debugging sessions 
		** within an IDE, because the ActiveX DLL is not loaded/unloaded between each debug run.)
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_GLOBAL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.FinalizeThreadPool() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GLOBAL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE keepbinaryresult_access		&& Access method used to retrieve the Chilkat Global KeepBinaryResult property.
		*==============================================================================
		* Method:            KeepBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Global KeepBinaryResult property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.KeepBinaryResult
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.53
		**
		** If set to 1, then the binary data returned by any method will be persisted 
		** in memory in the LastBinaryResult property. 
		** This allows for an ActiveX running in the SQL Server environment 
		** to access large varbinary return values via temp tables. 
		** The method would be called, and then the LastBinaryResult property 
		** would be fetched to get the full contents of the returned string.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 53
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE keepbinaryresult_assign		&& Assign method used to hold a reference to the KeepBinaryResult property.
		*==============================================================================
		* Method:            KeepBinaryResult_Assign
		* Purpose:           Assign method used to hold a reference to the KeepBinaryResult property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the KeepBinaryResult property.
		* Returns:           
		* Date Added:        01/26/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
