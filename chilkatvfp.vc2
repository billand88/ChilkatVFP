	PROCEDURE receivenbytesenc		&& The same as ReceiveBytesN, except the bytes are returned in encoded string form using the encoding specified by numBytes.
		*==============================================================================
		* Method:            ReceiveNBytesENC
		* Purpose:           The same as ReceiveBytesN, except the bytes are returned
		*                    in encoded string form using the encoding specified by numBytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiBytes, the number of bytes to receive
		*                    tcEncoding, the encoding algorithm.
		* Returns:           The received bytes.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** The same as ReceiveBytesN, except the bytes are returned 
		** in encoded string form using the encoding specified by numBytes. 
		** The numBytes can be "Base64", "modBase64", "Base32", "UU", "QP" (for quoted-printable), 
		** "URL" (for url-encoding), "Hex", "Q", "B", "url_oath", "url_rfc1738", 
		** "url_rfc2396", or "url_rfc3986".
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiBytes AS Integer, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, lcEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedString = m.loChilkatObject.ReceiveNBytesENC(m.tiBytes, m.tcEncoding) 
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

