		LPARAMETERS toChilkatJsonObject AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS [Chilkat.JsonObject], liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
