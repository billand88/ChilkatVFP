		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE authflowstate_access		&& Access method used to retrieve the Chilkat oAuth2 AuthFlowState property.
		*==============================================================================
		* Method:            AuthFlowState_Access
		* Purpose:           Access method used to retrieve 
		*                    the AuthFlowState property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AuthFlowState
		* Date Added:        06/08/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.59
		**
		** Indicates the current progress of the OAuth2 three-legged authorization flow. 
		** Possible values are:
		**
		** 0: Idle. No OAuth2 has yet been attempted.
		** 1: Waiting for Redirect. The OAuth2 background thread is waiting to receive 
		**    the redirect HTTP request from the browser.
		** 2: Waiting for Final Response. The OAuth2 background thread is waiting 
		**    for the final access token response.
		** 3: Completed with Success. The OAuth2 flow has completed, the background thread exited, 
		**    and the successful JSON response is available in AccessTokenResponse property.
		** 4: Completed with Access Denied. The OAuth2 flow has completed, the background thread exited, 
		**    and the error JSON is available in AccessTokenResponse property.
		** 5: Failed Prior to Completion. The OAuth2 flow failed to complete, the background thread exited,  
		**    and the error information is available in the FailureInfo property.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 59
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

