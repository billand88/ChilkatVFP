DEFINE CLASS ecc AS ibasechilkat OF "chilkatvfp.vcx" 		&& Elliptical Curve Cryptography class for generating ECDSA keys, computing shared secrets, and creating and verifying ECDSA signatures.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: asnformat_access		&& Access method used to retrieve the Chilkat ECC AsnFormat property.
		*m: asnformat_assign		&& Assign method used to hold a reference to the AsnFormat property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat ECC DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: genecckey		&& Introduced in version 9.5.0.52. Generates an ECDSA private key. The curveName specifies the curve name which determines the key size. The prng provides a source for generating the random private key.
		*m: genecckey2		&& Introduced in version 9.5.0.55. Generates an ECDSA private key using a specified value for K. The curveName specifies the curve name which determines the key size. The encodedK is the encoded value of the private key.
		*m: genkey		&& Introduced in version 11.0.0. Generates an ECDSA private key to privKey. The curveName specifies the curve name which determines the key size. Returns 1 for success, 0 for failure.
		*m: genkey2		&& Introduced in version 11.0.0. Generates an ECDSA private key in privKey using a specified value for K. The curveName specifies the curve name which determines the key size. The encodedK is the encoded value of the private key.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat ECC LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat ECC LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat ECC LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat ECC LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat ECC LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat ECC LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat ECC LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: sharedsecretenc		&& Introduced in version 9.5.0.52. Computes a shared secret given a private and public key.
		*m: signbd		&& Introduced in version 9.5.0.85. This method is the same as SignHashENC, except the actual data to be signed and the name of the hash algorithm is passed in. The following hash algorithms are supported: sha256, sha384, and sha512.
		*m: signbdusingcert		&& Introduced in version 9.5.0.91. Same as SignBd, but instead uses the private key of a certificate (assuming the cert's private key is ECDSA). Returns Nothing on failure
		*m: signhashenc		&& Introduced in version 9.5.0.52. Computes an ECDSA signature on a hash. ECDSA signatures are computed and verified on the hashes of data (such as SHA1, SHA256, etc.). The hash of the data is passed in encodedHash.
		*m: signhashusingcert		&& Introduced in version 10.1.0. Computes an ECDSA signature on a hash. ECDSA signatures are computed and verified on the hashes of data (such as SHA1, SHA256, etc.). The hash of the data is passed in encodedHash.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat ECC VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifybd		&& Introduced in version 9.5.0.85. This method is the same as VerifyHashENC, except the actual data to be verified and the name of the hash algorithm is passed in. The following hash algorithms are supported: sha256, sha384, and sha512.
		*m: verifyhashenc		&& Introduced in version 9.5.0.52. Verifies an ECDSA signature. ECDSA signatures are computed and verified on the hashes of data (such as SHA1, SHA256, etc.). The hash of the data is passed in encodedHash.
		*p: asnformat		&& Introduced in version 9.5.0.97. If 1, the ECDSA signatures produced by this object will use ASN.1 format. Otherwise the ECDSA signature will be a concatenation of the two raw byte arrays for r and s.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		asnformat = 1
		cchilkatclass = Ecc
		debuglogfilepath = 
		iinstancepatch = 52
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "ecc"
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE asnformat_access		&& Access method used to retrieve the Chilkat ECC AsnFormat property.
		*==============================================================================
		* Method:            AsnFormat_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ECC AsnFormat property..
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AsnFormat
		* Date Added:        01/17/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.97
		** 
		** If 1, the ECDSA signatures produced by this object will use ASN.1 format. 
		** Otherwise the ECDSA signature will be a concatenation of the two raw byte arrays for r and s.
		**
		** ECDSA signatures have two equal sized parts, r and s. 
		** There are two common formats for encoding the signature:
		**
		** (a) Concatenating the raw byte array of r and s
		** (b) Encoding both into a structured ASN.1 / DER sequence.
		** 
		** The default value of this property is 1, which is to use ASN.1, 
		** which is the behavior of earlier versions of Chilkat before this property was added.
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 97
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE asnformat_assign		&& Assign method used to hold a reference to the AsnFormat property.
		*==============================================================================
		* Method:            AsnFormat_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat ECC AsnFormat property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        01/17/2024
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 97
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 11.0.0
		
		  Added the GenKey and GenKey2 methods.
		
		  Decremented the GenEccKey and GenEccKey2 methods.
		
		** Version 10.1.0
		
		  Added the Ecc.SignHashUsingCert method.
		
		** Version 99
		
		  Added support for the secp160r1 curve.
		
		  Chilkat’s internal ASN.1 decoder needed an update to correctly handle 
		  0-length ASN.1 bit strings (which is something not normally encountered).
		
		** Version 97
		
		 Added the Ecc.AsnFormat property.
		
		** Version 95
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		** Version 85
		
		  Added the SignBd and VerifyBd methods.
		
		** Version 83
		
		  Improved support for ECDSA certs.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 75
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 66
		
		  Fixed exporting ECC private keys from PFX to other formats.
		
		** Version 65
		
		  Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		  See https://www.example-code.com/foxpro/edifact_eda_syntax_level_A_encoding.asp
		  Also see: https://cknotes.com/chilkat-binary-encoding-list/
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 56
		
		   Added the “base64url” encoding to the list of supported encodings.
		   See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 55
		
		  A new Chilkat encoding named “fingerprint” was added. The “fingerprint” encoding
		  is lowercase hex with each byte separated by a colon character.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP. 
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added a new Ecc class for elliptical curve cryptography.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat ECC DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ECC DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/22/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat ECC DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/22/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE genecckey		&& Introduced in version 9.5.0.52. Generates an ECDSA private key. The curveName specifies the curve name which determines the key size. The prng provides a source for generating the random private key.
		*==============================================================================
		* Method:            GenECCKey
		* Purpose:           Generates an ECDSA private key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCurveName, the curve name which determines the key size. 
		*                    toChilkatPrng, a Chilkat Pseudo Random Number Generator object.
		* Returns:           A Chilkat Private Key object, or NULL
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Generates an ECDSA private key. 
		** The curveName specifies the curve name which determines the key size. 
		** The prng provides a source for generating the random private key.
		** 
		** The following curve names are accepted:
		** 
		**   secp256r1 (also known as P-256 and prime256v1)
		**   secp384r1 (also known as P-384)
		**   secp521r1 (also known as P-521)
		**   secp256k1 (This is the curve used for Bitcoin)
		**   secp192r1
		**   secp224r1
		**   brainpoolP160r1
		**   brainpoolP192r1
		**   brainpoolP192r1
		**   brainpoolP224r1
		**   brainpoolP256r1
		**   brainpoolP320r1
		**   brainpoolP384r1
		**   brainpoolP512r1
		**
		** Enhancement for version 99: Added support for the secp160r1 curve.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcCurveName AS Character, toChilkatPrng AS CHILKAT_PRNG_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrng AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrng AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatPrivateKey, m.loParkParameterPrng, m.loChilkatPrng
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrng = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrng)
		
		      loChilkatPrng = m.loParkParameterPrng.GetObject()
		
		      TRY
		
		        loChilkatPrivateKey = ;
		        m.loChilkatObject.GenECCKey(m.tcCurveName, m.loChilkatPrng) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrng = ;
		      m.loParkParameterPrng.SetObject(m.toChilkatPrng, m.loChilkatPrng)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrng, m.loChilkatPrng
		
		RETURN m.loChilkatPrivateKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrng = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE genecckey2		&& Introduced in version 9.5.0.55. Generates an ECDSA private key using a specified value for K. The curveName specifies the curve name which determines the key size. The encodedK is the encoded value of the private key.
		*==============================================================================
		* Method:            GenECCKey2
		* Purpose:           Generates an ECDSA private key using a specified value for K.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCurveName, the curve name which determines the key size. 
		*                    tcEncodedK, the encoded value of the private key.
		*                    tcEncoding, the tcEncodedK encoding setting.
		* Returns:           A Chilkat Private Key object, or NULL
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Generates an ECDSA private key using a specified value for K. 
		** The curveName specifies the curve name which determines the key size. 
		** The encodedK is the encoded value of the private key. 
		** The encoding is the encoding used for encodedK, 
		** which can be "hex", "base64", "decimal", etc.
		** 
		** Note: This method is typically used for testing -- such as when the same private key 
		** is desired to produce results identical from run to run.
		** 
		** The following curve names are accepted:
		** 
		**   secp256r1 (also known as P-256 and prime256v1)
		**   secp384r1 (also known as P-384)
		**   secp521r1 (also known as P-521)
		**   secp256k1 (This is the curve used for Bitcoin)
		**   secp192r1
		**   secp224r1
		**   brainpoolP160r1
		**   brainpoolP192r1
		**   brainpoolP192r1
		**   brainpoolP224r1
		**   brainpoolP256r1
		**   brainpoolP320r1
		**   brainpoolP384r1
		**   brainpoolP512r1
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for version 99: Added support for the secp160r1 curve.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcCurveName AS Character, ;
		tcEncodedK AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatPrivateKey
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatPrivateKey = ;
		        m.loChilkatObject.GenECCKey2(m.tcCurveName, m.tcEncodedK, m.tcEncoding) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatPrivateKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE genkey		&& Introduced in version 11.0.0. Generates an ECDSA private key to privKey. The curveName specifies the curve name which determines the key size. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GenKey
		* Purpose:           Generates an ECDSA private key to privKey.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCurveName, the curve name.
		*                    toChilkatPrng, a Chilkat Prng object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Generates an ECDSA private key to privKey. 
		** The curveName specifies the curve name which determines the key size. 
		** The prng provides a source for generating the random private key.
		** 
		** The following curve names are accepted:
		** 
		** secp256r1 (also known as P-256 and prime256v1)
		** secp384r1 (also known as P-384)
		** secp521r1 (also known as P-521)
		** secp256k1 (This is the curve used for Bitcoin)
		** secp192r1
		** secp224r1
		** brainpoolP160r1
		** brainpoolP192r1
		** brainpoolP192r1
		** brainpoolP224r1
		** brainpoolP256r1
		** brainpoolP320r1
		** brainpoolP384r1
		** brainpoolP512r1
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCurveName AS Character, toChilkatPrng AS CHILKAT_PRNG_COM_CALL, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, llImplemented AS Logical, ;
		loParkParameterPrng AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrng AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrng, m.loChilkatPrng , ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrng = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrng)
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrng = m.loParkParameterPrng.GetObject()
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        lcEncodedString = m.loChilkatObject.GenKey(;
		        m.tcCurveName, m.loChilkatPrng, m.loChilkatPrivateKey) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrng = ;
		      m.loParkParameterPrng.SetObject(m.toChilkatPrng, m.loChilkatPrng)
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrng = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrng = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE genkey2		&& Introduced in version 11.0.0. Generates an ECDSA private key in privKey using a specified value for K. The curveName specifies the curve name which determines the key size. The encodedK is the encoded value of the private key.
		*==============================================================================
		* Method:            GenKey2
		* Purpose:           Generates an ECDSA private key in privKey using a specified value for K. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCurveName, specifies the curve name which determines the key size.
		*                    tcEncodedK, the encoded value of the private key.
		*                    tcEncoding, the encoding used for encodedK.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Logical
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Generates an ECDSA private key in privKey using a specified value for K. 
		** The curveName specifies the curve name which determines the key size. 
		** The encodedK is the encoded value of the private key. 
		** The encoding is the encoding used for encodedK, which can be "hex", "base64", "decimal", etc.
		** 
		** Note: This method is typically used for testing -- such as when the same private key 
		** is desired to produce results identical from run to run.
		** 
		** The following curve names are accepted:
		** 
		** secp256r1 (also known as P-256 and prime256v1)
		** secp384r1 (also known as P-384)
		** secp521r1 (also known as P-521)
		** secp256k1 (This is the curve used for Bitcoin)
		** secp192r1
		** secp224r1
		** brainpoolP160r1
		** brainpoolP192r1
		** brainpoolP192r1
		** brainpoolP224r1
		** brainpoolP256r1
		** brainpoolP320r1
		** brainpoolP384r1
		** brainpoolP512r1
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCurveName AS Character, tcEncodedK AS Character, ;
		tcEncoding AS Character, toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ECC_COM_CALL, llImplemented AS Logical, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GenKey2(m.tcCurveName, ;
		        m.tcEncodedK, m.tcEncoding, m.loChilkatPrivateKey) ;
		        TO liReturn, luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ECC_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat ECC LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

