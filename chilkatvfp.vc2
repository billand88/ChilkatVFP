	PROCEDURE quickputstrasync		&& Creates an asynchronous task to call the QuickPutStr method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            QuickPutStrAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the QuickPutStr method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the full URL.
		* Returns:           Chilkat Task object or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the QuickPutStr method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		** 
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		** 
		** Enhancement for version 83: The method will now automatically include the “Content-Length: 0” header.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.QuickPutStrAsync(m.tcURL)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE quickrequest		&& Sends an HTTP request with no body for a URL and returns the response object. The verb is typically "GET" or "DELETE". If the SendCookies property is 1, matching cookies previously persisted to the CookiesDir are automatically included in the request.
		*==============================================================================
		* Method:            QuickRequest
		* Purpose:           Sends an HTTP request with no body for a URL and returns the response object. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb -- the action to take.
		*                    tcURL -- the URL to request the content.
		* Returns:           Chilkat HTTP Response object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Sends an HTTP request with no body for a URL and returns the response object. 
		** The verb is typically "GET" or "DELETE".
		**
		** If the SendCookies property is 1, matching cookies previously persisted 
		** to the CookiesDir are automatically included in the request. 
		** If the FetchFromCache property is 1, the page could be fetched directly from cache.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatHTTPResponse = m.loChilkatObject.QuickRequest(m.tcVerb, m.tcURL)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

