DEFINE CLASS dkim AS ibasechilkat OF "chilkatvfp.vcx" 		&& DomainKeys API for creating and verifying DKIM-Signature and DomainKey-Signature MIME (email) header fields. This API is included with the "Chilkat MIME" license. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat DKIM AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: adddkimsignature		&& Undocumented method!
		*m: adddomainkeysignature		&& Undocumented method!
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat DKIM DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: dkimalg_access		&& Access method used to retrieve the Chilkat DKIM DKIMAlg property.
		*m: dkimalg_assign		&& Assign method used to hold a reference to the DKIMAlg property.
		*m: dkimbodylengthcount_access		&& Access method used to retrieve the Chilkat DKIM DKIMBodyLengthCount property.
		*m: dkimbodylengthcount_assign		&& Assign method used to hold a reference to the DKIMBodyLengthCount property.
		*m: dkimcanon_access		&& Access method used to retrieve the Chilkat DKIM DKIMCanon property.
		*m: dkimcanon_assign		&& Assign method used to hold a reference to the DKIMCanon property.
		*m: dkimdomain_access		&& Access method used to retrieve the Chilkat DKIM DKIMDomain property.
		*m: dkimdomain_assign		&& Assign method used to hold a reference to the DKIMDomain property.
		*m: dkimheaders_access		&& Access method used to retrieve the Chilkat DKIM DKIMHeaders property.
		*m: dkimheaders_assign		&& Assign method used to hold a reference to the DKIMHeaders property.
		*m: dkimselector_access		&& Access method used to retrieve the Chilkat DKIM DKIMSelector property.
		*m: dkimselector_assign		&& Assign method used to hold a reference to the DKIMSelector property.
		*m: dkimsign		&& Introduced in version 9.5.0.71. Constructs and prepends a DKIM-Signature header to the MIME passed in mimeData.
		*m: dkimverify		&& Introduced in version 9.5.0.71. Verifies the Nth DKIM-Signature header in the mimeData. (In most cases, there is only one signature.) The 1st signature is at sigIndex 0.
		*m: domainkeyalg_access		&& Access method used to retrieve the Chilkat DKIM DomainKeyAlg property.
		*m: domainkeyalg_assign		&& Assign method used to hold a reference to the DomainKeyAlg property.
		*m: domainkeycanon_access		&& Access method used to retrieve the Chilkat DKIM DomainKeyCanon property.
		*m: domainkeycanon_assign		&& Assign method used to hold a reference to the DomainKeyCanon property.
		*m: domainkeydomain_access		&& Access method used to retrieve the Chilkat DKIM DomainKeyDomain property.
		*m: domainkeydomain_assign		&& Assign method used to hold a reference to the DomainKeyDomain property.
		*m: domainkeyheaders_access		&& Access method used to retrieve the Chilkat DKIM DomainKeyHeaders property.
		*m: domainkeyheaders_assign		&& Assign method used to hold a reference to the DomainKeyHeaders property.
		*m: domainkeyselector_access		&& Access method used to retrieve the Chilkat DKIM DomainKeySelector property.
		*m: domainkeyselector_assign		&& Assign method used to hold a reference to the DomainKeySelector property.
		*m: domainkeysign		&& Introduced in version 9.5.0.71. Constructs and prepends a DomainKey-Signature header to the MIME passed in mimeData.
		*m: domainkeyverify		&& Introduced in version 9.5.0.71. Verifies the Nth DomainKey-Signature header in the mimeData. (In most cases, there is only one signature.) The 1st signature is at sigIndex 0.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat DKIM HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat DKIM LastBinaryReault property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat DKIM LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat DKIM LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat DKIM LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML: property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat DKIM LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat DKIM LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat DKIM LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loaddkimpk		&& Undocumented method!
		*m: loaddkimpkbytes		&& Undocumented method!
		*m: loaddkimpkfile		&& Undocumented method!
		*m: loaddomainkeypk		&& Undocumented method!
		*m: loaddomainkeypkbytes		&& Undocumented method!
		*m: loaddomainkeypkfile		&& Undocumented method!
		*m: loadpublickey		&& Caches a public key to be used for verifying DKIM and DomainKey signatures for a given selector and domain. The publicKey is a string containing an RSA public key in any text format, such as XML, PEM, etc.
		*m: loadpublickeyfile		&& Caches a public key to be used for verifying DKIM and DomainKey signatures for a given selector and domain. The publicKeyFilepath is a filepath of an RSA public key in any format.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: numdkimsignatures		&& Undocumented method! Note the similar NumDKIMSigs method.
		*m: numdkimsigs		&& Introduced in version 9.5.0.76. Returns the number of DKIM-Signature header fields found in mimeData.
		*m: numdomainkeysignatures		&& Undocumented method! Note the similar NumDomainKeySigs method.
		*m: numdomainkeysigs		&& Introduced in version 9.5.0.76. Returns the number of DomainKey-Signature header fields found in mimeData.
		*m: prefetchpublickey		&& Useful if your application is going to verify many emails from a single domain (or a few domains). This eliminates the need to do a DNS lookup to fetch the public key each time an email's DKIM or DomainKey signature is verified.
		*m: prefetchpublickeyasync		&& Creates an asynchronous task to call the PrefetchPublicKey method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: setdkimprivatekey		&& Introduced in version 9.5.0.71. Sets the private key file to be used for creating a DKIM-Signature. Returns 1 for success, 0 for failure.
		*m: setdomainkeyprivatekey		&& Introduced in version 9.5.0.71. Sets the private key file to be used for creating a DomainKey-Signature. Returns 1 for success, 0 for failure.
		*m: unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat DKIM VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifydkimsignature		&& Undocumented method!
		*m: verifydkimsignatureasync		&& Undocumented method! Creates an asynchronous task to call the VerifyDKIMSignature method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: verifydomainkeysignature		&& Undocumented method! See the related DomainKeyVerify method.
		*m: verifydomainkeysignatureasync		&& Undocumented method! Creates an asynchronous task to call the VerifyDomainKeySignature method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: verifyinfo_access		&& Access method used to retrieve the Chilkat DKIM VerifyInfo property.
		*m: verifyinfo_assign		&& Assign method used to hold a reference to the VerifyInfo property.
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: dkimalg		&& The signing algorithm to be used in creating the DKIM-Signature. Possible values are "rsa-sha256" and "rsa-sha1". The default value is "rsa-sha256".
		*p: dkimbodylengthcount		&& Optional body length count to set a maximum number of body bytes to be hashed when creating the DKIM-Signature field. The default value is 0, indicating that the entire body should be hashed.
		*p: dkimcanon		&& Canonicalization algorithm to be used for both header and body when creating the DKIM-Signature. Possible values are "simple" and "relaxed". The default value is "relaxed".
		*p: dkimdomain		&& The domain name of the signing domain when creating the DKIM-Signature.
		*p: dkimheaders		&& A colon-separated list of header field names that identify headers presented to the signing algorithm when creating the DKIM-Signature. The default value is: "mime-version:date:message-id:subject:from:to:content-type".
		*p: dkimselector		&& The selector to be used to form the DNS query for the public key. This property applies to creating a DKIM-Signature.
		*p: domainkeyalg		&& The signing algorithm to be used in creating the DomainKey-Signature. The only possible value is "rsa-sha1". The default value is "rsa-sha1".
		*p: domainkeycanon		&& Canonicalization algorithm to be used for when creating the DomainKey-Signature. Possible values are "simple" and "nofws". The default value is "nofws".
		*p: domainkeydomain		&& The domain name of the signing domain when creating the DomainKey-Signature.
		*p: domainkeyheaders		&& A colon-separated list of header field names that identify headers presented to the signing algorithm when creating the DomainKey-Signature. The default value is: "mime-version:date:message-id:subject:from:to:content-type".
		*p: domainkeyselector		&& The selector to be used to form the DNS query for the public key. This property applies to creating a DomainKey-Signature.
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any method call prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: verifyinfo		&& Introduced in version 9.5.0.76. Contains JSON with information about the last DKIM or DomainKey signature verified (or verification failure).
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 
		cchilkatclass = Dkim
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		dkimalg = rsa-sha256
		dkimbodylengthcount = 0
		dkimcanon = relaxed
		dkimdomain = 
		dkimheaders = mime-version:date:message-id:subject:from:to:content-type
		dkimselector = 
		domainkeyalg = rsa-sha1
		domainkeycanon = nofws
		domainkeydomain = 
		domainkeyheaders = mime-version:date:message-id:subject:from:to:content-type
		domainkeyselector = 
		heartbeatms = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "dkim"
		verboselogging = 0
		verifyinfo = 
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat DKIM AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DKIM AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        07/22/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE adddkimsignature		&& Undocumented method!
		*==============================================================================
		* Method:            AddDKIMSignature
		* Purpose:           Undocumented method!
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqMIMEData, MIME data to sign.
		* Returns:           A signed MIME with the DKIM signature added.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Undocumented method!
		** 
		
		LPARAMETERS tqMIMEData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_DKIM_COM_CALL, ;
		loException AS Exception, lqSignedMIME AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqSignedMIME 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        lqSignedMIME = m.loChilkatObject.AddDKIMSignature(m.tqMIMEData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqSignedMIME
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DKIM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

