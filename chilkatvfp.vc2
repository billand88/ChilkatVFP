	PROCEDURE exportconvo		&& Introduced in version 11.2.0. Exports the conversation specified by name to json, replacing json's contents with the exported transcript. You can later import a conversation using ImportConvo.
		*==============================================================================
		* Method:            ExportConvo
		* Purpose:           Exports the conversation specified by name to json.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcConversationName - the conversation name to export.
		*                    toChilkatJSON, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** Introduced in version 11.2.0.
		** 
		** Exports the conversation specified by name to json, 
		** replacing json's contents with the exported transcript. 
		** You can later import a conversation using ImportConvo. 
		** The currently selected conversation can be exported by passing * for the name.
		** 
		
		LPARAMETERS tcConversationName AS Character, toChilkatJSON AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJson AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS [Chilkat.JsonObject]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 2, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJson = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJson.GetObject()
		
		      TRY
		
		         m.loChilkatObject.ExportConvo(m.tcConversationName, m.loChilkatJSON)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJson.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		RETURN m.toChilkatJSON
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJson = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE fulltranscript_access		&& Access method used to retrieve the Chilkat AI FullTranscript property.
		*==============================================================================
		* Method:            FullTranscript_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat AI FullTranscript property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FullTranscript
		* Date Added:        11/03/2025
		*==============================================================================
		
		**  
		** Introduced in version 11.2.0
		**
		** For multimodal inputs like image data, image URLs, file data, and file URLs, 
		** the full data or URL is sent initially. If the property is set to 1, 
		** the full data/URL is re-sent in subsequent interactions. 
		** If set to 0, only the image or file summary is sent thereafter.
		**
		** By default, this property is 0.
		**
		** Full transcript style: always send the entire conversation (including files/images). 
		** This guarantees the model has all context, but can get expensive.
		**
		** Summarized transcript style: for previously sent multimodal items, 
		** sends the summary message (e.g. “Earlier, I uploaded a PDF with account statements”) 
		** instead of the raw file or url itself.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, ;
		m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE fulltranscript_assign		&& Assign method used to hold a reference to the FullTranscript property.
