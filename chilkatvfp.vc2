DEFINE CLASS authazuresas AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides general functionality for Azure Shared Access Signature (SAS) Authorization. This class is introduced in Chilkat v9.5.0.65.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: accesskey_access		&& Access method used to retrieve the Chilkat AuthAzureSAS AccessKey property.
		*m: accesskey_assign		&& Assign method used to hold a reference to the AccessKey property.
		*m: clear		&& Introduced in version 9.5.0.65. Clears all params set by the methods SetNonTokenParam and SetTokenParam. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat AuthAzureSAS DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: generatetoken		&& Introduced in version 9.5.0.65. Generates and returns the SAS token based on the defined StringToSign and params. Returns Nothing on failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat AuthAzureSAS LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat AuthAzureSAS LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat AuthAzureSAS LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat AuthAzureSAS LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat AuthAzureSAS LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat AuthAzureSAS LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat AuthAzureSAS LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property
		*m: setnontokenparam		&& Introduced in version 9.5.0.65. Adds a non-token parameter name/value. This is a value that is included in the string to sign, but is NOT included as a parameter in the Authorization header. Returns 1 for success, 0 for failure.
		*m: settokenparam		&& Introduced in version 9.5.0.65. Adds a token parameter name/value. This is a value that is included in the string to sign, and is also included as a parameter in the Authorization header. Returns 1 for success, 0 for failure.
		*m: stringtosign_access		&& Access method used to retrieve the Chilkat AuthAzureSAS StringToSign property.
		*m: stringtosign_assign		&& Assign method used to hold a reference to the StringToSign property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat AuthAzureSAS VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property
		*p: accesskey		&& Introduced in version 9.5.0.65. This is the signing key (access key) that must be kept private. It is a base64 string such as "abdTvCZFFoWUyre6erlNN+IOb9qhXgDsyhrxmZvpmxqFDwpl9oD0X9Fy0hIQa6L5UohznRLmkCtUYySO4Y2eaw=="
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult propert
		*p: stringtosign		&& Introduced in version 9.5.0.65. Defines the format of the string to sign.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		accesskey = 
		cchilkatclass = AuthAzureSAS
		debuglogfilepath = 
		iinstancepatch = 65
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "authazuresas"
		stringtosign = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE accesskey_access		&& Access method used to retrieve the Chilkat AuthAzureSAS AccessKey property.
		*==============================================================================
		* Method:            AccessKey_Access
		* Purpose:           Access method used to retrieve the 
		*                    Chilkat AuthAzureSAS AccessKey property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
