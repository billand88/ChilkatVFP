		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.SearchAllForContent2(m.loChilkatXML, m.tcContentPattern) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
