	PROCEDURE pkcs7cryptalg		&& Method run to validate the data for the PKCS7CryptAlg property.
		*==============================================================================
		* Method:            PKCS7CryptAlg
		* Purpose:           Method run to validate the data for 
		*                    the Crypt2 PKCS7CryptAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/13/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liMatch AS Integer, ;
		lcValue AS Character, llValidated AS Logical, liWord AS Integer ;
		liCalculatedBuildNumber AS Integer, liWords AS Integer, li AS Integer, ;
		lcWord AS Character, loVersioning AS [iVersioning OF ChilkatVFP.VCX]
		
		LOCAL ARRAY la_Values[5, 2]
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		lcValue = m.tcValue
		
		STORE 0 TO m.liWord, m.liWords, m.li, m.liMatch, m.liCalculatedBuildNumber
		STORE [] TO m.lcWord, m.la_Values
		
		llValidated = .F.
		liWords = GETWORDCOUNT(m.lcValue, [,])
		
		** Have a word to validate test (should be true)
		IF m.liWords = 1
		
		  WITH m.loChilkatWrapper
		
		    liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		      WITH m.loVersioning
		
		        ** Get rid of the spaces in the words...
		        lcValue = UPPER(STRTRAN(m.lcValue, [ ]))
		
		        la_Values[1, 1] = [AES]
		        la_Values[1, 2] = 0
		        la_Values[2, 1] = [AES-CGM]
		        la_Values[2, 2] = .GenerateVersionNumber(10, 0, 0)
		        la_Values[3, 1] = [DES]
		        la_Values[3, 2] = 0
		        la_Values[4, 1] = [3DES]
		        la_Values[4, 2] = 0
		        la_Values[5, 1] = [RC2]
		        la_Values[5, 2] = 0
		
		        ** Assume it's validated...
		        ** If we have an issue just kick it back to .F.
		        llValidated = .T. 
		
		        ** Walk through words loop
		        FOR li = 1 TO m.liWords
		
		          lcWord = GETWORDNUM(m.lcValue, m.li, [,])
		
		          liMatch = ASCAN(m.la_Values, m.lcWord, -1, -1, 1, 15)
		
		          ** No match or below current version test
		          IF m.liMatch = 0 ;
		          OR (m.liCalculatedBuildNumber < m.la_Values[m.liMatch, 2])
		
		            llValidated = .F.
		            EXIT
		
		          ENDIF m.liMatch = 0 ;
		          OR (m.liCalculatedBuildNumber < laValues[laMatch, 2])
		          ** End no match test
		
		        ENDFOR m.li = 1 TO m.liWords
		        ** End walk through words loop
		
		      ENDWITH
		
		    ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		    ** End have versioning object test
		
		  ENDWITH
		
		ENDIF m.liWords = 1
		** End have a word to validate test (should be true)
		
		STORE NULL TO m.loVersioning, m.loChilkatWrapper
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE pkcs7keylength		&& Method run to validate the data for the PKCS7KeyLength property.
		*==============================================================================
		* Method:            PKCS7KeyLength
		* Purpose:           Method run to validate the data for the PKCS7KeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        04/13/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], liValue AS Integer, ;
		llValidated AS Logical, lcPKCS7CryptAlgValue AS Character
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		liValue = m.tiValue
		
		llValidated = .F.
		
		** Have a good object with property (should be true) test
		IF TYPE([loChilkatWrapper.Name]) == T_CHARACTER ;
		AND PEMSTATUS(m.loChilkatWrapper, [PKCS7KeyLength], 5)
		
		  WITH m.loChilkatWrapper 
		 
		    lcPKCS7CryptAlgValue = UPPER(.PKCS7CryptAlg)
		
		    ** PKCS7 algorithm value processing branch
		    DO CASE
		
		      ** No value test
		      CASE EMPTY(m.lcPKCS7CryptAlgValue)
		        ** Nothing to do
		
		      ** AES encryption test
		      CASE m.lcPKCS7CryptAlgValue = [AES]
		
		        llValidated = INLIST(m.liValue, 128, 192, 256)
		
		      ** 3DES encryption test
		      CASE m.lcPKCS7CryptAlgValue = [3DES]
		
		        llValidated = (m.liValue = 192)
		
		      ** DES encryption test
		      CASE m.lcPKCS7CryptAlgValue = [DES]
		
		        llValidated = (m.liValue = 40)
		
		      ** AES encryption test
		      CASE m.lcPKCS7CryptAlgValue = [RC2]
		
		        llValidated = INLIST(m.liValue, 40, 56, 64, 128)
		
		    ENDCASE
		    ** End PKCS7 algorithm value processing branch   
		
		  ENDWITH
		
		ENDIF TYPE([loChilkatWrapper.Name]) == T_CHARACTER ;
		AND PEMSTATUS(m.loChilkatWrapper, [PKCS7KeyLength], 5)
		** End have a good object with property (should be true) test
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE pkcs8encryptalg		&& Method run to validate the data for the PKCS8EncryptAlg property.
		*==============================================================================
		* Method:            PKCS8EncryptAlg
