		**
		** Introduced in version 9.5.0.49
		**
		** Returns the Nth certificate from the PEM. The first certificate is at index 0.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatCert = m.loChilkatObject.GetCert(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getencodeditem		&& Introduced in version 9.5.0.50. Returns the encoded contents of the Nth item of a particular type (0-based index). The possible values for itemType are "certificate" (or "cert"), "privateKey", "publicKey", or "csr".
		*==============================================================================
		* Method:            GetEncodedItem
		* Purpose:           Returns the encoded contents of the Nth item of a particular type.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcItemType -- the item type to retrieve.
		*                    tcItemSubType -- the item sub type to retrieve.
		*                    tcEncoding -- the encoding
		*                    tiIndex -- the encoded contents of the item.
		* Returns:           The encoded item, or nothing.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		**
		** Returns the encoded contents of the Nth item of a particular type (0-based index). 
		** The possible values for itemType are "certificate" (or "cert"), "privateKey", 
		** "publicKey", or "csr". Input string args are case-insensitive. 
		** If the itemType is "privateKey", the itemSubType may be "der" or "pkcs8". 
		** If the itemType is "publicKey", the itemSubType may be "der" or "pkcs1". 
		** The itemSubType is ignored for other values of itemType. 
		** The valid encoding modes are "Base64", "modBase64", "Base32", "Base58", 
		** "QP" (for quoted-printable), "URL" (for url-encoding), "Hex", "url_oauth", 
		** "url_rfc1738", "url_rfc2396", and "url_rfc3986".
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcItemType AS Character, tcItemSubType AS Character, ;
		tcEncoding AS Character, tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		lcEncodedItem AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedItem = []
		llImplemented = .F.
		liIntroducedInBuild = 50
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcEncodedItem = m.loChilkatObject.GetEncodedItem(;
		        m.tcItemType, m.tcItemSubType, m.tcEncoding, m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedItem
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

