	HIDDEN PROCEDURE tocharset_access		&& Access method used to retrieve the Chilkat Charset ToCharset property.
		*==============================================================================
		* Method:            ToCharset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Charset ToCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ToCharset
		* Date Added:        07/26/2022
		*==============================================================================
		
		** 
		** Tells the charset converter the target charset for a conversion. 
		** Possible values are:
		** 
		**   <font size="2" face="MS Sans Serif">
		**   us-ascii
		**   unicode  (also known as UTF16LE or simply UTF16)
		**   unicodefffe  (also known as UTF16BE)
		**   ebcdic
		**   iso-8859-1
		**   iso-8859-2
		**   iso-8859-3
		**   iso-8859-4
		**   iso-8859-5
		**   iso-8859-6
		**   iso-8859-7
		**   iso-8859-8
		**   iso-8859-9
		**   iso-8859-13
		**   iso-8859-15
		**   windows-874
		**   windows-1250
		**   windows-1251
		**   windows-1252
		**   windows-1253
		**   windows-1254
		**   windows-1255
		**   windows-1256
		**   windows-1257
		**   windows-1258
		**   utf-7
		**   utf-8
		**   utf-32
		**   utf-32be
		**   shift_jis
		**   gb2312
		**   ks_c_5601-1987
		**   big5
		**   iso-2022-jp
		**   iso-2022-kr
		**   euc-jp
		**   euc-kr
		**   macintosh
		**   x-mac-japanese
		**   x-mac-chinesetrad
		**   x-mac-korean
		**   x-mac-arabic
		**   x-mac-hebrew
		**   x-mac-greek
		**   x-mac-cyrillic
		**   x-mac-chinesesimp
		**   x-mac-romanian
		**   x-mac-ukrainian
		**   x-mac-thai
		**   x-mac-ce
		**   x-mac-icelandic
		**   x-mac-turkish
		**   x-mac-croatian
		**   asmo-708
		**   dos-720
		**   dos-862
		**   ibm01140
		**   ibm01141
		**   ibm01142
		**   ibm01143
		**   ibm01144
		**   ibm01145
		**   ibm01146
		**   ibm01147
		**   ibm01148
		**   ibm01149
		**   ibm037
		**   ibm437
		**   ibm500
		**   ibm737
		**   ibm775
		**   ibm850
		**   ibm852
		**   ibm855
		**   ibm857
		**   ibm00858
		**   ibm860
		**   ibm861
		**   ibm863
		**   ibm864
		**   ibm865
		**   cp866
		**   ibm869
		**   ibm870
		**   cp875
		**   koi8-r
		**   koi8-u
		**   </font>
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

