	PROCEDURE appendtofile		&& Appends the contents of the string to a file. The string is first converted to the character encoding specified by charsetEncoding before being appended to the file.
		*==============================================================================
		* Method:            AppendToFile
		* Purpose:           Appends the contents of the string to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the multi-byte text to append.
		*                    tcEncoding, the character encoding of the file to append.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Appends the contents of the string to a file. 
		** The string is first converted to the character encoding 
		** specified by charsetEncoding before being appended to the file.
		** 
		
		LPARAMETERS tcFilePath AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendToFile(m.tcFilePath, m.tcEncoding) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

