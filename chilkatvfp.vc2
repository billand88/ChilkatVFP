		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE lastsignercert		&& Introduced in version 11.0.0. Returns the Nth certificate in index used to digitally sign this email. Signed emails are typically signed by a single signer, but it is possible to have multiple signers. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LastSignerCert
		* Purpose:           Returns the Nth certificate in index used to digitally sign this email. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the certificate index value.
		*                    toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/11/2025
		*==============================================================================
		
		** 
		** Introduced in version 11.0.0
		**
		** Returns the Nth certificate in index used to digitally sign this email. 
		** Signed emails are typically signed by a single signer, 
		** but it is possible to have multiple signers. The 1st signer is at index 0.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiIndex AS Integer, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		     loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.LastSignerCert(m.tiIndex, m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE laststringresultlen_access		&& Access method used to retrieve the Chilkat Email LastStringResultLen property.
		*==============================================================================
		* Method:            LastStringResultLen_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastStringResultLen property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastStringResultLen
		* Date Added:        01/21/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.53
		**
		** The length, in characters, of the string contained in the LastStringResult property.
		**
		** Fixed for version 65: This property incorrectly returned the size of the string in bytes (utf-16) 
		** rather than in number of characters. This is fixed to return the number of characters.  
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 53
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*==============================================================================
		* Method:            LastStringResultLen_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastStringResultLen property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the LastStringResultLen property.
		* Returns:           
		* Date Added:        01/21/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 53
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE laststringresult_access		&& Access method used to retrieve the Chilkat Email LastStringResult property.
		*==============================================================================
		* Method:            LastStringResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastStringResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastStringResult
		* Date Added:        01/21/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.52
		**
		** The string return value of the last (string returning) method called. 
		** Only available if Chilkat.Global.KeepStringResult is set to 1. 
		** This provides a means for obtaining large string results in the SQL Server environment 
		** (where limitations exist in getting long strings returned by method calls, 
		** but where temp tables can be used for string properties).
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*==============================================================================
		* Method:            LastStringResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastStringResult of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the last string result in text format.
		* Returns:           
