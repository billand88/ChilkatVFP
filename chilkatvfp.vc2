	HIDDEN PROCEDURE connectfailreason_access		&& Access method used to retrieve the Chilkat Socket ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket ConnectFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectFailReason
		* Date Added:        05/27/2022
		*==============================================================================
		
		**
		** If the Connect method fails, this property can be checked to determine the reason for failure.
		**
		** Possible values are:
		** 
		** 0 = success
		** 
		** Normal (non-SSL) sockets:
		** 1 = empty hostname
		** 2 = DNS lookup failed
		** 3 = DNS timeout
		** 4 = Aborted by application.
		** 5 = Internal failure.
		** 6 = Connect Timed Out
		** 7 = Connect Rejected (or failed for some other reason)
		** 
		** SSL/TLS:
		** 100 = TLS internal error.
		** 101 = Failed to send client hello.
		** 102 = Unexpected handshake message.
		** 103 = Failed to read server hello.
		** 104 = No server certificate.
		** 105 = Unexpected TLS protocol version.
		** 106 = Server certificate verify failed 
		** (the server certificate is expired or the cert's signature verification failed).
		** 107 = Unacceptable TLS protocol version.
		** 108 = App-defined server certificate requirements failure.
		** 109 = Failed to read handshake messages.
		** 110 = Failed to send client certificate handshake message.
		** 111 = Failed to send client key exchange handshake message.
		** 112 = Client certificate's private key not accessible.
		** 113 = Failed to send client cert verify handshake message.
		** 114 = Failed to send change cipher spec handshake message.
		** 115 = Failed to send finished handshake message.
		** 116 = Server's Finished message is invalid.
		** 125 = TLS Pin Set Mismatch. (Added in version 78)
		**
		** Fixed for Verison 52: Fixed and improved this property.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Assign
		* Purpose:           Assign method used to hold 
		*                    the ConnectFailReason property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ConnectFailReason property.
		* Returns:           
		* Date Added:        05/27/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE convertfromssl		&& Closes the secure (TLS/SSL) channel leaving the socket in a connected state where data sent and received is unencrypted. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ConvertFromSSL
		* Purpose:           Closes the secure (TLS/SSL) channel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Closes the secure (TLS/SSL) channel leaving the socket 
		** in a connected state where data sent and received is unencrypted.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ConvertFromSSL() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

