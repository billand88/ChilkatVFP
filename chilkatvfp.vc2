	PROCEDURE addheader		&& Adds a request header to the HTTP request. If a header having the same field name is already present, this method replaces it. Note: Never explicitly set the Content-Length header field.
		*==============================================================================
		* Method:            AddHeader
		* Purpose:           Adds a request header to the HTTP request.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName -- the header name
		*                    tcValue -- the header field value.
		* Returns:           
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Adds a request header to the HTTP request. 
		** If a header having the same field name is already present, this method replaces it.
		** 
		** Note: Never explicitly set the Content-Length header field. 
		** Chilkat will automatically compute the correct length 
		** and add the Content-Length header to all POST, PUT, or any other request 
		** where the Content-Length needs to be specified. 
		** (GET requests always have a 0 length body, 
		** and therefore never need a Content-Length header field.)
		**
		
		LPARAMETERS tcName AS Character, tcValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddHeader(m.tcName, m.tcValue)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addmwssignature		&& Introduced in version 9.5.0.66. Computes the Amazon MWS signature using the mwsSecretKey and adds the "Signature" parameter to the request. This method should be called for all Amazon Marketplace Web Service (Amazon MWS) HTTP requests.
		*==============================================================================
		* Method:            AddMWSSignature
		* Purpose:           Computes the Amazon MWS signature using the mwsSecretKey 
		*                    and adds the "Signature" parameter to the request.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDomain -- the domain of the request
		*                    tcMWSSecretKey -- the MWS secret key
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Computes the Amazon MWS signature using the mwsSecretKey 
		** and adds the "Signature" parameter to the request. 
		** This method should be called for all Amazon Marketplace Web Service 
		** (Amazon MWS) HTTP requests. It should be called after all request parameters have been added.
		**
		** Fixed in Version 69: Fixed problems with pre-signing URLs having to do with 
		** 8bit non-us-ascii chars in the filename, or “.” chars in the bucket name.
		** 
		** Important: The Chilkat v9.5.0.75 release accidentally breaks Amazon MWS 
		** (not AWS) authentication. If you need MWS with 9.5.0.75, 
		** send email to support@chilkatsoft.com for a hotfix, or revert back to v9.5.0.73, 
		** or update to a version after 9.5.0.75.
		** 
		** The domain should be the domain of the request, such as one of the following:
		** 
		** mws.amazonservices.com
		** mws-eu.amazonservices.com
		** mws.amazonservices.in
		** mws.amazonservices.com.cn
		** mws.amazonservices.jp
		** 
		** Note: This method automatically adds or replaces the existing Timestamp parameter 
		** to the current system date/time.
		**
		** Fix for version 77: Fixed the method. 
		** The “/” char in params did not get URL encoded to “%2F” as they should be.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcDomain AS Character, tcMWSSecretKey AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddMWSSignature(;
		        m.tcDomain, m.tcMWSSecretKey) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

