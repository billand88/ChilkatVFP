	PROCEDURE writefile		&& Introduced in version 9.5.0.87. Writes the entire file specified by dirName and fileName. dirName is the name of the directory that contains the file, or the empty string for root. The entire contents of bd are written to the file on the smart card.
		*==============================================================================
		* Method:            WriteFile
		* Purpose:           Writes the entire file specified by dirName and fileName.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryName, the directory name.
		*                    tcFileName, the file name within the directory (or root).
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Writes the entire file specified by dirName and fileName. 
		** dirName is the name of the directory that contains the file, 
		** or the empty string for root. 
		** The entire contents of bd are written to the file on the smart card.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcDirectoryName AS Character, ;
		tcFileName AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, luReturn AS Unknown, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.WriteFile(m.tcDirectoryName, ;
		        m.tcFileName, m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS scp AS ibasechilkat OF "chilkatvfp.vcx" 		&& An API for SCP over SSH. (SCP is the Secure Copy Protocol.) It is for transferring files or directory trees to or from remote servers. SCP is a simpler protocol than SFTP, and thus the functionality is more limited.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat SCP AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SCP DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: downloadbd		&& Introduced in version 9.5.0.77. Downloads a binary file from the SSH server and appends to the contents of bd. Returns 1 for success, 0 for failure.
		*m: downloadbdasync		&& Introduced in version 9.5.0.77. Creates an asynchronous task to call the DownloadBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: downloadbinary		&& Introduced in version 9.5.0.51. Downloads a binary file from the SSH server and returns the contents. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: downloadbinaryasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the DownloadBinary method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: downloadbinaryencoded		&& Introduced in version 9.5.0.51. Downloads a file from the SSH server returns the contents in an encoded string (using an encoding such as base64). Returns Nothing on failure.
		*m: downloadbinaryencodedasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the DownloadBinaryEncoded method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: downloadfile		&& Introduced in version 9.5.0.51. Downloads a file from the remote SSH server to the local filesystem. Returns 1 for success, 0 for failure.
		*m: downloadfileasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the DownloadFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: downloadstring		&& Introduced in version 9.5.0.51. Downloads a text file from the SSH server and returns the contents as a string. Returns Nothing on failure.
		*m: downloadstringasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the DownloadString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat SCP HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SCP LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat SCP LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat SCP LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat SCP LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SCP LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SCP LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SCP LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: percentdonescale_access		&& Access method used to retrieve the Chilkat SCP PercentDoneScale property.
		*m: percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*m: sendenv_access		&& Access method used to retrieve the Chilkat SCP SendEnv property.
		*m: sendenv_assign		&& Assign method used to hold a reference to the SendEnv property.
		*m: syncedfiles_access		&& Access method used to retrieve the Chilkat SCP SyncedFiles property.
		*m: syncedfiles_assign		&& Assign method used to hold a reference to the SyncedFiles property.
		*m: syncmustmatchdir_access		&& Access method used to retrieve the Chilkat SCP SyncMustMatchDir property.
		*m: syncmustmatchdir_assign		&& Assign method used to hold a reference to the SyncMustMatchDir property.
		*m: syncmustmatch_access		&& Access method used to retrieve the Chilkat SCP SyncMustMatch property.
		*m: syncmustmatch_assign		&& Assign method used to hold a reference to the SyncMustMatch property.
		*m: syncmustnotmatchdir_access		&& Access method used to retrieve the Chilkat SCP SyncMustNotMatchDir property.
		*m: syncmustnotmatchdir_assign		&& Assign method used to hold a reference to the SyncMustNotMatchDir property.
		*m: syncmustnotmatch_access		&& Access method used to retrieve the Chilkat SCP SyncMustNotMatch property.
		*m: syncmustnotmatch_assign		&& Assign method used to hold a reference to the SyncMustNotMatch property.
		*m: synctreedownload		&& Introduced in version 9.5.0.51. Downloads files from the SSH server to a local directory tree.
		*m: synctreedownloadasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the SyncTreeDownload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: synctreeupload		&& Introduced in version 9.5.0.51. Uploads a directory tree from the local filesystem to the SSH server.
		*m: synctreeuploadasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the SyncTreeUpload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat SCP UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unixpermoverride_access		&& Access method used to retrieve the Chilkat SCP UnixPermOverride property.
		*m: unixpermoverride_assign		&& Assign method used to hold a reference to the UnixPermOverride property.
		*m: uploadbd		&& Introduced in version 9.5.0.77. Uploads the contents of bd to a file on the SSH server. Returns 1 for success, 0 for failure.
		*m: uploadbdasync		&& Introduced in version 9.5.0.77. Creates an asynchronous task to call the UploadBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uploadbinary		&& Introduced in version 9.5.0.51. Uploads binary data to a file on the SSH server. Returns 1 for success, 0 for failure.
		*m: uploadbinaryasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the UploadBinary method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uploadbinaryencoded		&& Introduced in version 9.5.0.51. Uploads the binary data to a file on the remote SSH server. The binary data is passed in encoded string representation (such as base64, or hex). Returns 1 for success, 0 for failure.
		*m: uploadbinaryencodedasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the UploadBinaryEncoded method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: uploadfile		&& Introduced in version 9.5.0.51. Uploads a file from the local filesystem to the remote SSH server. Returns 1 for success, 0 for failure.
		*m: uploadfileasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the UploadFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uploadstring		&& Introduced in version 9.5.0.51. Uploads the contents of a string to a file on the remote SSH server. Returns 1 for success, 0 for failure.
		*m: uploadstringasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the UploadString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: usessh		&& Introduced in version 9.5.0.51. Uses the SSH connection of sshConnection for the SCP transfers.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat SCP VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: heartbeatms		&& This is the number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any SSH operation prior to completion.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: percentdonescale		&& Introduced in version 9.5.0.51. This property is only valid in programming environment and languages that allow for event callbacks. Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks.
		*p: sendenv		&& Introduced in version 9.5.0.79. A JSON string specifying environment variables that are to be set for each SCP upload or download.
		*p: syncedfiles		&& Introduced in version 9.5.0.51. The paths of the files uploaded or downloaded in the last call to SyncUploadTree or SyncDownloadTree. The paths are listed one per line.
		*p: syncmustmatch		&& Introduced in version 9.5.0.51. Can contain a wildcarded list of filename patterns separated by semicolons. For example, "*.xml; *.txt; *.csv".
		*p: syncmustmatchdir		&& Introduced in version 9.5.0.58. Can contain a wildcarded list of directory name patterns separated by semicolons. For example, "a*; b*; c*".
		*p: syncmustnotmatch		&& Introduced in version 9.5.0.51. Can contain a wildcarded list of filename patterns separated by semicolons. For example, "*.xml; *.txt; *.csv".
		*p: syncmustnotmatchdir		&& Introduced in version 9.5.0.58. Can contain a wildcarded list of directory name patterns separated by semicolons. For example, "a*; b*; c*".
		*p: uncommonoptions		&& Introduced in version 9.5.0.77. This is a catch-all property to be used for uncommon needs. The default value is the empty string.
		*p: unixpermoverride		&& Introduced in version 9.5.0.77. When Chilkat uploads a file by SCP, the UNIX permissions of the remote file are set based on the permissions of the local file being uploaded.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		cchilkatclass = Scp
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		heartbeatms = 0
		iinstancepatch = 51
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "scp"
		percentdonescale = 100
		sendenv = 
		syncedfiles = 
		syncmustmatch = 
		syncmustmatchdir = 
		syncmustnotmatch = 
		syncmustnotmatchdir = 
		uncommonoptions = 
		unixpermoverride = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat SCP AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SCP AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        07/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        07/08/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 87
		
		  Fixed: A zero-length local file was created when attempting to download a non-existent remote file.
		  The fix was to ensure the local file is removed if the remote file is non-existent.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		** Version 78
		
		  Fixed problems having to do with uploads where SPACE chars are in the directory or filename.
		
		  Fixed issue with SyncTreeUpload. Modes 1-5 would operate as mode 0 and upload all files.
		
		** Version 77
		
		  If an upload succeeds, but the only failure is in setting the remote file time,
		  then the method will return success rather than failure.
		
		  The DownloadFile, DownloadString, and DownloadBinary methods
		  did not succeed if the remote filename contained a SPACE char.
		
		  Added the DownloadBd and UploadBd methods.
		
		  Fixed SyncTreeUpload for modes > 0. No files were uploaded when the mode was > 0.
		
		** Version 75
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 67
		
		  Added the “base64_mime” to the list of possible encodings.
		  This is the same as “base64”, but causes the base64 to be emitted
		  in lines just like it would be found in MIME or in a PEM.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Added the AbortCurrent property to classes that can have event callbacks.
		
		  The DownloadFile method did not close the channel.
		
		** Version 56
		
		   Added the “base64url” encoding to the list of supported encodings.
		   See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 55
		
		  A new Chilkat encoding named “fingerprint” was added. The “fingerprint” encoding
		  is lowercase hex with each byte separated by a colon character.
		  See https://cknotes.com/chilkat-binary-encoding-list/
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 51
		
		  Added the Scp class (CkScp, Chilkat.Scp, CkoScp, etc.) for SSH Secure Copy.
		  The Scp class is included as part of the SSH/SFTP license.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat SCP DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SCP DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/09/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SCP DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/09/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
