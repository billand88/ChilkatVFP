	HIDDEN PROCEDURE lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*==============================================================================
		* Method:            LastErrorXML_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastErrorXML of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, the last error message in XML format.
		* Returns:           
		* Date Added:        01/07/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE lastjsondata		&& Provides information about what transpired in the last method called on this object instance. For many methods, there is no information.
		*==============================================================================
		* Method:            LastJSONData
		* Purpose:           Provides information about what transpired 
		*                    in the last method called on this object instance. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat JSON Object, or NULL
		* Date Added:        01/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Provides information about what transpired in the last method called on this object instance. 
		** For many methods, there is no information. 
		** However, for some methods, details about what occurred can be obtained 
		** by getting the LastJsonData right after the method call returns.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatJSON AS CHILKAT_JSONOBJECT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loExceptionm, m.loChilkatJSON
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatJSON = m.loChilkatObject.LastJSONData()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatJSON
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastmethodsuccess_access		&& Access method used to retrieve the Chilkat MailMan LastMethodSuccess property.
		*==============================================================================
		* Method:            LastMethodSuccess_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastMethodSuccess property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastMethodSuccess
		* Date Added:        01/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** Indicate whether the last method call succeeded or failed. 
		** A value of 1 indicates success, a value of 0 indicates failure. 
		** This property is automatically set for method calls. 
		** It is not modified by property accesses. 
		** The property is automatically set to indicate success for 
		** the following types of method calls:
		**
		** Any method that returns a string.
		** Any method returning a Chilkat object, binary bytes, or a date/time.
		** Any method returning a standard boolean status value where success = 1 and failure = 0.
		** Any method returning an integer where failure is defined by a return value less than zero.
		** Note: Methods that do not fit the above requirements will 
		** always set this property equal to 1. 
		** For example, a method that returns no value (such as a "void" in C++) 
		** will technically always succeed.
		** 
		** Fixed in version 60: Fixed problems with the LastMethodSuccess property. 
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*==============================================================================
		* Method:            LastMethodSuccess_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastMethodSuccess property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the LastMethodSuccess property.
		* Returns:           
		* Date Added:        01/07/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE lastsendqfilename_access		&& Access method used to retrieve the Chilkat MailMan LastSendQFileName property.
		*==============================================================================
		* Method:            LastSendQFileName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan LastSendQFileName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
