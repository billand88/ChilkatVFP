	PROCEDURE stringofequals		&& Introduced in version 9.5.0.96. Returns 1 if the string value at the specified jsonPath equals value. Otherwise returns 0.
		*==============================================================================
		* Method:            StringOfEquals
		* Purpose:           Returns 1 if the string value at the specified jsonPath equals value.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSONPath, the path to the JSON string.
		*                    tcValue, the value to match.
		*                    tuCaseSensitive, whether or not the search is case sensitive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Returns 1 if the string value at the specified jsonPath equals value. Otherwise returns 0.
		**
		** Fixed in Version 11.6.0: Case-sensitivity was reversed (behavior change). 
		** Previously caseSensitive = true compared case-insensitively and vice-versa. 
		** Now corrected: true = case-sensitive, false = case-insensitive. 
		** If you had compensated for the old behavior, review those calls.
		**
		
		LPARAMETERS tcJSONPath AS Character, tcValue AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, liCaseSensitive AS Integer, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		      TRY
		
		        STORE m.loChilkatObject.StringOfEquals(m.tcJSONPath, m.tcValue, m.liCaseSensitive) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

