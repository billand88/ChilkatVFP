	PROCEDURE genpresignedurl		&& Introduced in version 9.5.0.85. Generates a temporary pre-signed URL for an Amazon AWS service using AWS Signature V4. Requires that the SecretKey, AccessKey, and Region properties be set to valid values prior to calling this method.
		*==============================================================================
		* Method:            GenPresignedURL
		* Purpose:           Generates a temporary pre-signed URL 
		*                    for an Amazon AWS service using AWS Signature V4.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHTTPVerb, the HTTP verb to execute.
		*                    tuUseHTTPS, whether or not the returned URL contains "https://"
		*                    tcDomain, the domain to log into.
		*                    tcPath, the path to the resource.
		*                    tiSecondsValid, the number of seconds it is still valid.
		*                    tcAWSService, the AWS service to call.
		* Returns:           The AWS URL, or nothing.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Generates a temporary pre-signed URL for an Amazon AWS service 
		** using AWS Signature V4. Requires that the SecretKey, AccessKey, 
		** and Region properties be set to valid values prior to calling this method.
		** 
		** The URL that is generated has this format:
		** 
		**   https://<domain>/<path>
		**   ?X-Amz-Algorithm=AWS4-HMAC-SHA256
		**   &X-Amz-Credential=<AccessKey>/<currentDate>/<Region>/<awsService>/aws4_request
		**   &X-Amz-Date=<currentDateTime>
		**   &X-Amz-Expires=<numSecondsValid>
		**   &X-Amz-SignedHeaders=host
		**   &X-Amz-Signature=<signature-value>  
		**
		** The httpVerb is the HTTP verb such as "GET", "PUT", "POST", "DELETE", etc. 
		** The awsService is a string naming the AWS service, such as "s3", "execute-api", etc. 
		** If useHttps is 1, then the returned URL begins with "https://", 
		** otherwise it begins with "http://".
		**
		** Fixed in Version 66: AWS Signature V4 issues 
		** for some cases when query params are used with S3.
		**
		** Fixed in Version 69: Fixed problems with pre-signing URLs having to do 
		** with 8bit non-us-ascii chars in the filename, or “.” chars in the bucket name.
		** 
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS tcHTTPVerb AS Character, tuUseHTTPS AS Unknown, tcDomain AS Character, ;
		tcPath AS Character, tiSecondsValid AS Integer, tcAWSService AS Character
		
		LOCAL loChilkatObject AS CHILKAT_AUTHAWS_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liUseHTTPS AS Integer, lcURL AS Character
		
		STORE 0 TO m.liUseHTTPS, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcURL = []
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUseHTTPS = .LogicalToBit(m.tuUseHTTPS)
		
		      TRY
		
		        lcURL =m.loChilkatObject.GenPresignedURL(m.tcHTTPVerb, ;
		        m.liUseHTTPS, m.tcDomain, m.tcPath, m.tiSecondsValid, m.tcAWSService) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcURL
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_AUTHAWS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat AuthAWS LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		liIntroducedInBuild = 58 && 52
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
