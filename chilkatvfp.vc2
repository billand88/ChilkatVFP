	PROCEDURE streamchunkfromfile		&& Introduced in version 9.5.0.55. This method is the same as StreamBodyFromFile, but allows for an offset and number of bytes to be specified. The offset and numBytes are integers passed as strings. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            StreamChunkFromFile
		* Purpose:           This method is the same as StreamBodyFromFile, but allows 
		*                    for an offset and number of bytes to be specified.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath -- the path to the file to chunk
		*                    tiOffset -- the file offset
		*                    tiBytes -- the number of bytes to chunk from the offset.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		** 
		** This method is the same as StreamBodyFromFile, 
		** but allows for an offset and number of bytes to be specified. 
		** The offset and numBytes are integers passed as strings.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePath AS Character, tiOffset AS Integer, tiBytes AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_HTTPREQUEST_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 55
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.StreamChunkFromFile(m.tcFilePath, m.tiOffset, m.tiBytes) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPREQUEST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

