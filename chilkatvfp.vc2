	HIDDEN PROCEDURE protocolversion_access		&& Access method used to retrieve the Chilkat Mcp ProtocolVersion property.
		*==============================================================================
		* Method:            ProtocolVersion_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Mcp ProtocolVersion property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ProtocolVersion
		* Date Added:        09/06/2026
		*==============================================================================
		
		** 
		** Introduced in version 11.6.0
		**
		** The MCP protocol version. May be set before Connect to request a specific version; 
		** after Connect it reflects the version negotiated with the server 
		** and is sent in the MCP-Protocol-Version header of each request. 
		** The default is 2025-06-18.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE protocolversion_assign		&& Assign method used to hold a reference to the ProtocolVersion property.
		*==============================================================================
		* Method:            ProtocolVersion_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Mcp ProtocolVersion property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ProtocolVersion property.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE readresource		&& Introduced in version 11.6.0. Calls the MCP resources/read method for the resource identified by the URI in uri. Connect must be called first. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ReadResource
		* Purpose:           Calls the MCP resources/read method for the resource identified by the URI in uri.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUri - the resource identified to read.
		*                    toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Calls the MCP resources/read method for the resource identified by the URI in uri. 
		** On success, the result is placed in json, containing a contents array whose entries carry a uri, 
		** a mimeType, and either text (for text resources) or blob (base64 for binary resources).
		** 
		** Connect must be called first.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcUri AS Character, toChilkatJSONObject AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], llImplemented AS Logical, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS [Chilkat.JsonObject], loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ReadResource(m.tcUri, m.loChilkatJSONObject) ;
		        TO liReturn, luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  toChilkatJSONObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

