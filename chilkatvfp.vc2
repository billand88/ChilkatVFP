	PROCEDURE encrypt		&& Introduced in version 9.5.0.66. Encrypts string content to produce a JWE. The byte representation of the content is indicated by charset (such as "utf-8").
		*==============================================================================
		* Method:            Encrypt
		* Purpose:           Encrypts string content to produce a JWE.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcContent, the content to encrypt
		*                    tcCharset, the content's charset.
		* Returns:           The encrypted string.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Encrypts string content to produce a JWE. 
		** The byte representation of the content is indicated by charset (such as "utf-8").
		** 
		** Supported Algorithms:
		** 
		** RSAES OAEP 256 (using SHA-256 and MGF1 with SHA-256) encryption with A128CBC-HS256, 
		** A192CBC-HS384, A256CBC-HS512, A128GCM, A192GCM, A256GCM
		**
		** RSAES OAEP (using SHA-1 and MGF1 with SHA-1) encryption with A128CBC-HS256, 
		** A192CBC-HS384, A256CBC-HS512, A128GCM, A192GCM, A256GCM
		**
		** RSAES-PKCS1-V1_5 encryption with A128CBC-HS256, A192CBC-HS384, A256CBC-HS512, 
		** A128GCM, A192GCM, A256GCM
		**
		** Direct symmetric key encryption with pre-shared key A128CBC-HS256, A192CBC-HS384, 
		** A256CBC-HS512, A128GCM, A192GCM and A256GCM
		**
		** A128KW, A192KW, A256KW encryption with A128CBC-HS256, A192CBC-HS384, A256CBC-HS512, 
		** A128GCM, A192GCM, A256GCM
		**
		** A128GCMKW, A192GCMKW, A256GCMKW encryption with A128CBC-HS256, A192CBC-HS384, 
		** A256CBC-HS512, A128GCM, A192GCM, A256GCM
		**
		** PBES2-HS256+A128KW, PBES2-HS384+A192KW, PBES2-HS512+A256KW with A128CBC-HS256, 
		** A192CBC-HS384, A256CBC-HS512, A128GCM, A192GCM, A256GCM
		**
		** Update for Version 72: Modification: Encrypting 0 bytes for block cipher algorithms 
		** with padding now results in one block of output, rather than 0 bytes.
		** (Decrypting the 16-byte block will return the original 0 bytes.) 
		** This only applies to block ciphers operating in modes such as ECB, CBC, etc. 
		** This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcContent AS Integer, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JWE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcEncryptedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncryptedString = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcEncryptedString = m.loChilkatObject.Encrypt(m.tcContent, m.tcCharset) 
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncryptedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

