	PROCEDURE unzipmatchinginto		&& Unzips matching files into a single directory, ignoring all path information stored in the Zip.
		*==============================================================================
		* Method:            UnZipMatchingInto
		* Purpose:           Unzips matching files into a single directory, 
		*                    ignoring all path information stored in the Zip.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryPath -- the path to unzip the file.
		*                    tcPattern -- the pattern to match.
		*                    tuVerbose -- whether or not the unzipping is verbose.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Unzips matching files into a single directory, 
		** ignoring all path information stored in the Zip.
		**
		
		LPARAMETERS tcDirectoryPath AS Character, ;
		tcPattern AS Character, tuVerbose AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liVerbose AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liVerbose
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liVerbose = .LogicalToBit(m.tuVerbose)
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.UnZipMatchingInto(m.tcDirectoryPath, m.tcPattern, m.liVerbose) ;
		      TO m.liReturn, m.luReturn
		
