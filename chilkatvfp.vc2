	PROCEDURE setauthbasic		&& Introduced in version 9.5.0.58. Sets the username and password to be used for Basic authentication. This method should be called when Basic authentication is required. It should only be used with secure SSL/TLS connections.
		*==============================================================================
		* Method:            SetAuthBasic
		* Purpose:           Sets the username and password to be used for Basic authentication.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUserName, the user name.
		*                    tcPassword, the password to log in.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Sets the username and password to be used for Basic authentication. 
		** This method should be called when Basic authentication is required. 
		** It should only be used with secure SSL/TLS connections. 
		** Calling this method will cause the "Authorization: Basic ..." header 
		** to be automatically added to all requests. 
		**
		** In many cases, a REST API will support Basic authentication where the username 
		** is a client ID or account ID, and the password is a client secret or token.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUserName AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetAuthBasic(m.tcUserName, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

