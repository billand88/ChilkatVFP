		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		      TRY
		
		        liIndex = ;
		        m.loChilkatObject.FindSubstring(m.tiStartIndex, m.tcSubString, m.liCaseSensitive)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liIndex
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getstrings		&& Introduced in version 9.5.0.87. Return the number of strings specified by count, one per line, starting at startIdx. To return the entire table, pass 0 values for both startIdx and count.
		*==============================================================================
		* Method:            GetStrings
		* Purpose:           Return the number of strings specified by count, 
		*                    one per line, starting at startIdx.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiStartIndex, the starting index value.
		*                    tiCount, the number of strings to retrieve.
		*                    tuCRLF, whether or not the emit CRLF line endings.
		* Returns:           Returns the matching strings.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Return the number of strings specified by count, one per line, starting at startIdx. 
		** To return the entire table, pass 0 values for both startIdx and count. 
		** Set crlf equal to 1 to emit with CRLF line endings, 
		** or 0 to emit LF-only line endings. The last string is emitted includes the line ending.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiStartIndex AS Integer, ;
		tiCount AS Character, tuCRLF AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGTABLE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcMatchingStrings AS Character, ;
		liCRLF AS Integer
		
		STORE 0 TO m.liCRLF, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcMatchingStrings = []
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCRLF = .LogicalToBit(m.tuCRLF)
		
		      TRY
		
		        lcMatchingStrings = ;
		        m.loChilkatObject.GetStrings(m.tiStartIndex, m.tiCount, m.liCRLF)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcMatchingStrings
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

