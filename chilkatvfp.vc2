		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE deletematching		&& Deletes all the files in the current remote FTP directory matching the pattern. Returns the number of files deleted, or -1 for failure. The pattern is a string such as "*.txt", where any number of "*" wildcard characters can be used.
		*==============================================================================
		* Method:            DeleteMatching
		* Purpose:           Deletes all the files in the current 
		*                    remote FTP directory matching the pattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePattern -- the remote directory pattern.
		* Returns:           Returns the number of files deleted, or -1 for failure.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Deletes all the files in the current remote FTP directory matching the pattern. 
		** Returns the number of files deleted, or -1 for failure. 
		** The pattern is a string such as "*.txt", 
		** where any number of "*" wildcard characters can be used. 
		** "*" matches 0 or more of any character.
		**
		** For versions 97 and above:
		**
		** If an empty string is passed for the pattern, 
		** then it would match all files and all files would get deleted. 
		** Chilkat will now fail the call if the matching pattern is the empty string, 
		** and the LastErrorText will contain the message:  ” Your application passed in an empty string, 
		** which would’ve caused all files to be deleted. 
		** If you wish to delete all files, explicitly pass “*” instead. “
		**
		
		LPARAMETERS tcRemotePattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liReturn = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liReturn = m.loChilkatObject.DeleteMatching(m.tcRemotePattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

