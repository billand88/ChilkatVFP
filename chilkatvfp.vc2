	PROCEDURE getdircount		&& Introduced in version 9.5.0.44. Returns the number of files and sub-directories in the current remote directory that match the ListPattern property.
		*==============================================================================
		* Method:            GetDirCount
		* Purpose:           Returns the number of files 
		*                    and sub-directories in the current remote directory. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Integer, the number of files and subdirectories
		* Date Added:        03/02/2022
		*==============================================================================
		
		**
		** Returns the number of files and sub-directories in the current remote directory 
		** that match the ListPattern property.
		**
		** Important: Calling this method may cause the directory listing to be retrieved 
		** from the FTP server. For FTP servers that do not support the MLST/MLSD commands, 
		** this is technically a data transfer that requires a temporary data connection 
		** to be established in the same way as when uploading or downloading files. 
		** If your program hangs while calling this method, 
		** it probably means that the data connection could not be established. 
		** The most common solution is to switch to using Passive mode 
		** by setting the Passive property = 1, with the PassiveUseHostAddr property also set equal to 1. 
		** If this does not help, examine the contents of the LastErrorText property 
		** after this method finally returns (after timing out). 
		** Also, see this Chilkat blog post about FTP connection settings.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liReturn = m.loChilkatObject.GetDirCount()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

