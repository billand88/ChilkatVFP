	PROCEDURE appendnew		&& Appends a new and empty entry to the Zip object and returns the ZipEntry object. Data can be appended to the entry by calling ZipEntry.AppendData. Important: To append an already-existing file, call the AppendOneFileOrDir method.
		*==============================================================================
		* Method:            AppendNew
		* Purpose:           Appends a new and empty entry to the Zip object 
		*                    and returns the ZipEntry object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to append.
		* Returns:           toChilkatZipEntry, a Chilkat Zip Entry object.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Appends a new and empty entry to the Zip object and returns the ZipEntry object. 
		** Data can be appended to the entry by calling ZipEntry.AppendData.
		** 
		** Important: To append an already-existing file, call the AppendOneFileOrDir method. 
		** The AppendNew method inserts a new and empty file entry within the Zip object. 
		** The purpose of AppendNew is to either create an empty file within the Zip, 
		** or to create a new file entry which can then be filled with data by calling 
		** the entry's AppendData method.
		** 
		** Note: This method only updates the zip object. 
		** To update (rewrite) a zip file, either the WriteZip or WriteZipAndClose method 
		** would need to be called.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, ;
		loException AS Exception, loChilkatZipEntry AS CHILKAT_ZIPENTRY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatZipEntry
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatZipEntry = m.loChilkatObject.AppendNew(m.tcFileName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatZipEntry
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendnewdir		&& Adds an entry to the zip so that when it unzips, a new directory (with no files) is created. The directory does not need to exist on the local filesystem when calling this method.
