	PROCEDURE connect		&& Introduced in version 11.6.0. Connects to the MCP (Model Context Protocol) server at the Streamable HTTP endpoint URL in url (for example https://example.com/mcp) and performs the MCP initialize handshake. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Connect
		* Purpose:           Connects to the MCP server at the Streamable HTTP endpoint URL.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL, the URL to connect to.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Connects to the MCP (Model Context Protocol) server at the Streamable HTTP endpoint URL in url 
		** (for example https://example.com/mcp) and performs the MCP initialize handshake.
		**
		** On success, the SessionId, ProtocolVersion, ServerName, ServerVersion, 
		** and ServerInstructions properties are populated, and Connected becomes 1.
		**
		** If an AuthToken is set, it is sent as a bearer token on the request. 
		** The URL must begin with http:// or https://; the host, port, and path are taken from it. 
		** Only the Streamable HTTP transport is supported; the stdio transport is not.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcURL AS Character
		
		LOCAL loChilkatObject AS [Chilkat.Mcp], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.Connect(m.tcURL) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Mcp])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

