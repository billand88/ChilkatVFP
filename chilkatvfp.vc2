	PROCEDURE deletebymsgnum		&& Marks an email for deletion by message number. WARNING: Be very careful if calling this method. Message numbers are specific to a POP3 session.
		*==============================================================================
		* Method:            DeleteByMsgNum
		* Purpose:           Marks an email for deletion by message number.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMsgNum -- the email message number.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Marks an email for deletion by message number. 
		** WARNING: Be very careful if calling this method. 
		** Message numbers are specific to a POP3 session. 
		** If a maildrop has (for example) 10 messages, 
		** the message numbers will be 1, 2, 3, ... 10. 
		** If message number 1 is deleted and a new POP3 session is established, 
		** there will be 9 messages numbered 1, 2, 3, ... 9.
		** 
		** IMPORTANT: A POP3 must first be established by either calling Pop3BeginSession explicitly, 
		** or implicitly by calling some other method that automatically establishes the session. 
		** This method will not automatically establish a new POP3 session 
		** (because if it did, the message numbers would potentially 
		** be different than what the application expects).
		** 
		** This method only marks an email for deletion. 
		** It is not actually removed from the maildrop until the POP3 session 
		** is explicitly ended by calling Pop3EndSession.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiMsgNum AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DeleteByMsgNum(m.tiMsgNum) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

