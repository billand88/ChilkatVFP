		lcValidationMethod = [SSLProtocol]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sslservercertverified_access		&& Access method used to retrieve the Chilkat SSLServerCertVerified property.
		*==============================================================================
