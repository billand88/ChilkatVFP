	PROCEDURE verifysignature		&& Introduced in version 9.5.0.40. Verifies the certificate signature, as well as the signatures of all certificates in the chain of authentication to the trusted root. Returns 1 if all signatures are verified to the trusted root. Otherwise returns 0.
		*==============================================================================
		* Method:            VerifySignature
		* Purpose:           Verifies the certificate signature, as well as the signatures 
		*                    of all certificates in the chain of authentication to the trusted root.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Verifies the certificate signature, as well as the signatures of all certificates 
		** in the chain of authentication to the trusted root. Returns 1 if all signatures 
		** are verified to the trusted root. Otherwise returns 0.
		**
		** Fixed in Version 48: Fixed problem with this method when the cert is obtained 
		** by the Socket.GetSslServerCert method. The intermedate certs in the chain of authentication, 
		** received during the SSL/TLS handshake, were not (internally and automatically) 
		** made available to the Cert object returned by GetSslServerCert, 
		** and thus they were not accessible when trying to verify the cert signature.
		**
		** Fixed in Version 95: Fixed the method to successfully validate Ed25519 certificates.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.VerifySignature() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE x509pkipathv1		&& Introduced in version 9.5.0.77. Returns the base64 representation of an X509PKIPathv1 containing just the calling certificate. This is typically used in an X.509 Binary Security Token.
		*==============================================================================
		* Method:            X509PKIPathV1
		* Purpose:           Returns the base64 representation of an X509PKIPathv1 
		*                    containing just the calling certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The certificate chain's certificate path.
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Returns the base64 representation of an X509PKIPathv1 containing 
		** just the calling certificate. This is typically used in an X.509 Binary Security Token. 
		** It is a PKIPath that contains an ordered list of X.509 
		** public certificates packaged in a PKIPath. The X509PKIPathv1 token type may be used 
		** to represent a certificate path. (This is sometimes used in XAdES signatures.)
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CERTCHAIN_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, lcPath AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		lcPath = []
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcPath = m.loChilkatObject.X509PKIPathV1()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcPath
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS certchain AS ibasechilkat OF "chilkatvfp.vcx" 		&& Contains certificates in a chain of authentication to a trusted root.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: certat		&& Introduced in version 11.0.0. Returns the Nth certificate of the chain into cert. The 1st certificate is at index 0. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat CertChain DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getcert		&& Introduced in version 9.5.0.40. Returns the Nth certificate in the chain. Returns Nothing on failure.
		*m: isroottrusted		&& Introduced in version 9.5.0.40. Returns 1 if the root of the certificate chain is a certificate found in trustedRoots.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat CertChain LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat CertChain LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat CertChain LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat CertChain LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat CertChain LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat CertChain LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat CertChain LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadx5c		&& Introduced in version 9.5.0.66. Loads a certificate chain from the "x5c" parameter of a JWK (JSON Web Key). Returns 1 for success, 0 for failure.
		*m: numcerts_access		&& Access method used to retrieve the Chilkat CertChain NumCerts property.
		*m: numcerts_assign		&& Assign method used to hold a reference to the NumCerts property.
		*m: numexpiredcerts_access		&& Access method used to retrieve the Chilkat CertChain NumExpiredCerts property.
		*m: numexpiredcerts_assign		&& Assign method used to hold a reference to the NumExpiredCerts property.
		*m: reachesroot_access		&& Access method used to retrieve the Chilkat CertChain ReachesRoot property.
		*m: reachesroot_assign		&& Assign method used to hold a reference to the ReachesRoot property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat CertChain UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold the Chilkat CertChain UncommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat CertChain VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifycertsignatures		&& Introduced in version 9.5.0.40. Verifies the certificate signatures to the root. Returns 1 if all certificate signatures are valid.
		*m: x509pkipathv1		&& Introduced in version 9.5.0.88. Returns the base64 representation of an X509PKIPathv1 containing the certificates in this chain. This is typically used in an X.509 Binary Security Token.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcerts		&& Introduced in version 9.5.0.40. The number of certificates in the chain. The end-user subscriber certificate is at index 0.
		*p: numexpiredcerts		&& Introduced in version 9.5.0.40. Returns the number of certificates in the chain that have expired.
		*p: reachesroot		&& Introduced in version 9.5.0.44. 1 if this certificate chain extends all the way to the root certificate. The root certificate is either a trusted CA root or a self-signed certificate. In both cases, the issuer of a root certificate is itself.
		*p: uncommonoptions		&& Introduced in version 9.5.0.98. Can be set to a comma separated list of keywords to specify uncommon options.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = CertChain
		debuglogfilepath = 
		iinstancepatch = 40
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "certchain"
		numcerts = 0
		numexpiredcerts = 0
		reachesroot = 0
		uncommonoptions = 
		verboselogging = 
	*</PropValue>
	
	PROCEDURE certat		&& Introduced in version 11.0.0. Returns the Nth certificate of the chain into cert. The 1st certificate is at index 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CertAt
		* Purpose:           Returns the Nth certificate of the chain into cert. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		*                    tiCertificate, the certificate position in the array.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/04/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Returns the Nth certificate of the chain into cert. The 1st certificate is at index 0.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiCertificate AS Integer, toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERTCHAIN_COM_CALL, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CertAt(m.tiCertificate, m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = m.loParkParameterCert.SetObject(;
		      m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/06/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Added the CertAt method.
		
		  Decremented the GetCert method.
		
		** Version 99
		
		  Chilkat’s internal ASN.1 decoder needed an update to correctly handle 
		  0-length ASN.1 bit strings (which is something not normally encountered).
		
		** Version 98
		
		  Fixed: The CertChain.IsRootTrusted method did not also consult the Windows 
		  TrustedRoots registry certificate store, and thus caused IsRootTrusted to return false 
		  when it should’ve returned true.
		
		  Fixed the CertChain.X509PKIPathv1 method. It was returning the base64 ASN.1 
		  with the certs listed in the order that is the reverse as specified by the standard.
		
		** Version 69
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		  Fixed an issue with automatically locating pre-installed Windows certificates 
		  (for encryption) when the email address stored within the certificate used uppercase letters.
		
		** Version 67
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object..)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary, 
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		** Version 44
		
		  Added the CertChain.ReachesRoot property.
		
		** Version 41
		
		  Fixed the CertChain.IsRootTrusted property.
		
		** Version 40
		
		  Added new Chilkat object/classes: CertChain, XmlCertVault, and Pfx.
		  See the online reference documentation. Various methods were added to various Chilkat classes
		  to make it easy to obtain the full certificate chain, such as for an SSL server’s cert chain,
		  or a PKCS7 signer’s certificate chain. 
		  The XmlCertVault object provides a means for persisting a collection of certificates
		  and private keys to an XML file as a repository for an application to use.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat CertChain DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CertChain DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/27/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat CertChain DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/27/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 40
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE getcert		&& Introduced in version 9.5.0.40. Returns the Nth certificate in the chain. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetCertificate
		* Purpose:           Returns the Nth certificate in the chain.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the certificate array value.
		* Returns:           Chilkat Certificate object or NULL
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Returns the Nth certificate in the chain.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERTCHAIN_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatCert = m.loChilkatObject.GetCertificate(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE isroottrusted		&& Introduced in version 9.5.0.40. Returns 1 if the root of the certificate chain is a certificate found in trustedRoots.
		*==============================================================================
		* Method:            IsRootTrusted
		* Purpose:           Returns 1 if the root of the certificate chain 
		*                    is a certificate found in trustedRoots.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTrustedRoots, a Chilkat Trusted Roots object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Fixed for Version 41: Fixed the property.
		**
		** Returns 1 if the root of the certificate chain is a certificate found in trustedRoots.
		**
		** Fixed for Version 98: The CertChain.IsRootTrusted method did not also consult 
		** the Windows TrustedRoots registry certificate store, 
		** and thus caused IsRootTrusted to return false when it should’ve returned true.
		** 
		
		LPARAMETERS toChilkatTrustedRoots AS CHILKAT_TRUSTEDROOTS_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERTCHAIN_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterTrustedRoots AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTrustedRoots AS CHILKAT_TRUSTEDROOTS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTrustedRoots, m.loChilkatTrustedRoots
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTrustedRoots = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTrustedRoots)
		
		      loChilkatTrustedRoots = m.loParkParameterTrustedRoots.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.IsRootTrusted(m.loChilkatTrustedRoots) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTrustedRoots = m.loParkParameterTrustedRoots.SetObject(;
		      m.toChilkatTrustedRoots, m.loChilkatTrustedRoots)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTrustedRoots, m.loChilkatTrustedRoots
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  toChilkatTrustedRoots = NEWOBJECT(CHILKAT_TRUSTEDROOTS_COM_CALL)
		  loParkParameterTrustedRoots = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTrustedRoots = NEWOBJECT(CHILKAT_TRUSTEDROOTS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_access		&& Access method used to retrieve the Chilkat CertChain LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastBinaryResult
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** The binary data returned by the last (binary data returning) method called. 
		** Only available if Chilkat.Global.KeepBinaryResult is set to 1. 
		** This provides a means for obtaining large varbinary results in the SQL Server 
		** environment (where limitations exist in getting large amounts of data returned 
		** by method calls, but where temp tables can be used for binary properties).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [VariantReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*==============================================================================
		* Method:            LastBinaryResult_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastBinaryResult property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLastBinaryResult, the last binary result.
		* Returns:           
		* Date Added:        07/27/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
