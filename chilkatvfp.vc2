	PROCEDURE qencodebytes		&& Takes a byte array of multibyte (non-Unicode) data and returns a Unicode Q-Encoded string. Returns Nothing on failure
		*==============================================================================
		* Method:            QEncodeBytes
		* Purpose:           Takes a byte array of multibyte (non-Unicode) 
		*                    data and returns a Unicode B-Encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqInData -- the array of data.
		*                    tcCharset -- the Charset of the input data.
		* Returns:           lcUnicodeString, a Unicode Q-Encoded string.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Takes a byte array of multibyte (non-Unicode) data and returns a Unicode Q-Encoded string.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tqInData AS VarBinary, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcUnicodeString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcUnicodeString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcUnicodeString = m.loChilkatObject.QEncodeBytes(m.tqInData, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcUnicodeString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE qencodestring		&& Takes a Unicode string, converts it to the charset specified in the 2nd parameter, Q-Encodes the converted multibyte data, and returns the encoded Unicode string. Returns Nothing on failure
		*==============================================================================
		* Method:            QEncodeString
		* Purpose:           Encodes a Unicode string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnicodeString -- the array of data.
		*                    tcCharset -- the Charset used to convert the Unicode String.
		* Returns:           lcUnicodeString, the encoded Unicode string.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Takes a Unicode string, converts it to the charset specified in the 2nd parameter, 
		** Q-Encodes the converted multibyte data, and returns the encoded Unicode string.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcUnicodeString AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcUnicodeString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcUnicodeString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lcUnicodeString = m.loChilkatObject.QEncodeString(m.tcUnicodeString, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcUnicodeString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

