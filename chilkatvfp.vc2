	PROCEDURE fetchone		&& Introduced in version 11.0.0. Retrieves a complete message or header by its message number and stores it in msgNum. The first email has a message number of 1. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FetchOne
		* Purpose:           Retrieves a complete message or header by its message number and stores it in msgNum.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuHeadersOnly -- whether or not to download just the header.
		*                    tiNumBodyLines -- the number of body lines to download.
		*                    toChilkatEMail -- a Chilkat Email object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Retrieves a complete message or header by its message number and stores it in msgNum. 
		** The first email has a message number of 1. Messages fetched by this method remain on the server.
		** 
		** Note: Message numbers are unique to each POP3 session.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuHeadersOnly AS Unknown, tiNumBodyLines AS Integer, ;
		tiMessageNumber AS Integer, toChilkatEMail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, liHeadersOnly AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterEMail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMail AS CHILKAT_EMAIL_COM_CALL, liKeepOnServer AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liHeadersOnly
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMail, m.loChilkatEMail
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liHeadersOnly = .LogicalToBit(m.tuHeadersOnly)
		
		      loParkParameterEMail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMail)
		
		      loChilkatEMail = m.loParkParameterEMail.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FetchOne(m.liHeadersOnly, m.tiNumBodyLines, ;
		        m.tiMessageNumber, m.loChilkatEMail) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEMail = m.loParkParameterEMail.SetObject(;
		      m.toChilkatEMail, m.loChilkatEMail)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMail, m.loChilkatEMail
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEMail  = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEMail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEMail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

