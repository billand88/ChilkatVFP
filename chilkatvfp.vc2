	HIDDEN PROCEDURE synccreatealllocaldirs_access		&& Access method used to retrieve the Chilkat SFTP SyncCreateAllLocalDirs property.
		*==============================================================================
		* Method:            SyncCreateAllLocalDirs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 SyncCreateAllLocalDirs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SyncCreateAllLocalDirs
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** If 1, then empty directories on the server 
		** are created locally when doing a download synchronization. ;
		** If 0, then only directories containing files that are downloaded are auto-created.
		**
		** The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 76
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE synccreatealllocaldirs_assign		&& Assign method used to hold a reference to the SyncCreateAllLocalDirs property.
		*==============================================================================
		* Method:            SyncCreateAllLocalDirs_Assign
		* Purpose:           Assign method used to hold a reference to the SyncCreateAllLocalDirs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
