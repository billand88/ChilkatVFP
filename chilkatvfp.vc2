	PROCEDURE dtof		&& Introduced in version 9.5.0.73. Fills the dt with the date/time string located at jsonPath. If bLocal is 1, then dt is filled with the local date/time values, otherwise it is filled with the UTC/GMT values.
		*==============================================================================
		* Method:            DtOf
		* Purpose:           Fills the dt with the date/time string located at jsonPath.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSONPath, the JSON path to the date.
		*                    tuLocal, whether or not the local date/time is used.
		*                    toChilkatDtObj, a Chilkat DateTime object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.73
		** 
		** Fills the dt with the date/time string located at jsonPath. 
		** If bLocal is 1, then dt is filled with the local date/time values, 
		** otherwise it is filled with the UTC/GMT values. 
		** Auto-recognizes the following date/time string formats: ISO-8061 Timestamp 
		** (such as "2009-11-04T19:55:41Z"), RFC822 date/time format 
		** (such as "Wed, 18 Apr 2018 15:51:55 -0400"), or Unix timestamp integers.
		**
		** Fix for version 76: This method will now parse date/time strings 
		** having the Microsoft JSON Date (AJAX Date), such as “/Date(12348721342)/” 
		** or “/Date(1224043200000-0600)/” where ‘1224043200000’ are the number
		** of milliseconds since January 1, 1970 in Universal Coordinated Time (UTC).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcJSONPath AS Character, tuLocal AS Unknown, ;
		toChilkatDtObj AS CHILKAT_DTOBJ_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, liLocal AS Integer ;
		loParkParameterDtObj AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatDtObj AS CHILKAT_DTOBJ_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liLocal, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterDtObj, m.loChilkatDtObj
		
		llImplemented = .F.
		liIntroducedInBuild = 73
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liLocal = .LogicalToBit(m.tuLocal)
		
		      loParkParameterDtObj = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatDtObj)
		
		      loChilkatDtObj = m.loParkParameterDtObj.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.DtOf(m.tcJSONPath, m.liLocal, m.loChilkatDtObj) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterDtObj, m.loChilkatDtObj
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatDtObj = NEWOBJECT(CHILKAT_DTOBJ_COM_CALL)
		  loParkParameterDtObj = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatDtObj = NEWOBJECT(CHILKAT_DTOBJ_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

