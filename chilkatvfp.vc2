	PROCEDURE getfilecreatedt		&& Returns the create date/time for a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*==============================================================================
		* Method:            GetFileCreateDt
		* Purpose:           Returns the create date/time for a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathOrHandle -- the file path or handle to file
		*                    tuFollowLinks, whether or not server symbolic links are followed.
		*                    tuIsHandle, whether or not the first parameter is a handle.
		* Returns:           toChilkatCkDateTime, a Chilkat Date Time object.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Returns the create date/time for a file. 
		**
		** pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. 
		** If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0. 
		** If bFollowLinks is 1, then symbolic links will be followed on the server.
		**
		** Note: Servers running the SFTP v3 protocol or lower do not have 
		** the ability to return a file's creation date/time.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcPathOrHandle AS Character, ;
		tuFollowLinks AS Unknown, tuIsHandle AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL, liFollowLinks AS Integer, ;
		liIsHandle AS Integer
		
		STORE 0 TO m.liFollowLinks, m.liIsHandle  
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCkDateTime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liFollowLinks = .LogicalToBit(m.tuFollowLinks)
		    liIsHandle = .LogicalToBit(m.tuIsHandle)
		
		    TRY
		
		      loChilkatCkDateTime = ;
		      m.loChilkatObject.GetFileCreateDt(m.tcPathOrHandle, m.liFollowLinks, m.liIsHandle)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCkDateTime
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

