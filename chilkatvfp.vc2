		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE s3_downloadbdasync		&& Creates an asynchronous task to call the S3_DownloadBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            S3_DownloadBdAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    S3_DownloadBd method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBucketPath -- the Amazon S3 bucket path.
		*                    tcObjectName -- the object to download.
		*                    toChilkatBinData, a Chilkat binary data object.
		* Returns:           Chilkat Task object or NULL
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Creates an asynchronous task to call the S3_DownloadBd method with the arguments provided.
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcBucketPath AS Character, tcObjectName AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatTask, m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.S3_DownloadBdAsync(m.tcBucketPath, m.tcObjectName, m.loChilkatBinData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE s3_downloadbytes		&& The same as DownloadFile, except the file data is returned directly in-memory instead of being written to a local file. Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            S3_DownloadBytes
		* Purpose:           The same as DownloadFile, except the file data is returned 
		*                    directly in-memory instead of being written to a local file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBucketPath -- the Amazon S3 bucket path.
		*                    tcObjectName -- the object to download.
		* Returns:           VarBinary
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** The same as DownloadFile, except the file data is returned 
		** directly in-memory instead of being written to a local file.
		**
		** Fixed for Version 66: Fixed AWS Signature V4 issues 
		** for some cases when query params are used with S3.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed in Version 69:   Fixed problems with pre-signing URLs having to do with 
		** 8bit non-us-ascii chars in the filename, or “.” chars in the bucket name.
		** 
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		**
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcBucketPath AS Character, tcObjectName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, ;
		loException AS Exception, lqBinData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqBinData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqBinData = m.loChilkatObject.S3_DownloadBytes(m.tcBucketPath, m.tcObjectName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqBinData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

