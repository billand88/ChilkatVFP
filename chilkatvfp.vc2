	PROCEDURE sendbytesenc		&& The same as SendBytes, except the bytes are provided in encoded string form as specified by encodingAlg.
		*==============================================================================
		* Method:            SendBytesENC
		* Purpose:           The same as SendBytes, except the bytes are provided 
		*                    in encoded string form as specified by encodingAlg.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedBytes -- the encoded bytes to send.
		*                    tcEncodingAlg -- the encoding algorithm.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** The same as SendBytes, except the bytes are provided in encoded 
		** string form as specified by encodingAlg. 
		** The encodingAlg can be "Base64", "modBase64", "Base32", "Base58", "UU", 
		** "QP" (for quoted-printable), "URL" (for url-encoding), "Hex", "Q", "B", 
		** "url_oauth", "url_rfc1738", "url_rfc2396", and "url_rfc3986".
		**
		
		LPARAMETERS tcEncodedBytes AS Character, tcEncodingAlg AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE ;
		      m.loChilkatObject.SendBytesENC(m.tcEncodedBytes, m.tcEncodingAlg) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

