	PROCEDURE loadpublickey		&& Caches a public key to be used for verifying DKIM and DomainKey signatures for a given selector and domain. The publicKey is a string containing an RSA public key in any text format, such as XML, PEM, etc.
		*==============================================================================
		* Method:            LoadPublicKey
		* Purpose:           Caches a public key to be used for verifying DKIM 
		*                    and DomainKey signatures for a given selector and domain.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSelector, a DKIM selector value.
		*                    tcDomain, a DKIM domain value.
		*                    tcPublicKey, the RSA public key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Caches a public key to be used for verifying DKIM and DomainKey signatures 
		** for a given selector and domain. The publicKey is a string containing 
		** an RSA public key in any text format, such as XML, PEM, etc. 
		** This method will automatically detect the format and load the public key correctly. 
		** This method is useful for testing DKIM and DomainKey verification 
		** when your public key has not yet been installed in DNS.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSelector AS Character, ;
		tcDomain AS Character, tcPublicKey AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DKIM_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadPublicKey(m.tcSelector, ;
		      m.tcDomain, m.tcPublicKey) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DKIM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

