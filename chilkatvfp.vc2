	PROCEDURE loadtaskresult		&& Introduced in version 9.5.0.52. Loads the mailboxes object from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadTaskResult
		* Purpose:           Loads the email object from a completed asynchronous task.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTask, a Chilkat Task object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Loads the email object from a completed asynchronous task.
		**
		** Fix for Version 58: This method always returned 0, regardless of success/failure.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatTask AS CHILKAT_TASK_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILBOXES_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer, llImplemented AS Logical, ;
		loParkParameterTask AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTask = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTask)
		
		      loChilkatTask = m.loParkParameterTask.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadTaskResult(m.loChilkatTask) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTask = ;
		      m.loParkParameterTask.SetObject(m.toChilkatTask, m.loChilkatTask)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILBOXES_COM_CALL)
		  toChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loParkParameterTask = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS mailman AS ibasechilkat OF "chilkatvfp.vcx" 		&& The Chilkat MailMan class is reponsible for sending email though SMTP and receiving/managing email on POP3 servers.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat MailMan AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: addpfxsourcebd		&& Introduced in version 11.0.0. Adds a PFX file to the object's list of sources for locating certificates and private keys during decryption or signing. To add multiple PFX sources, call this method for each file. Returns 1 for success, 0 for failure.
		*m: addpfxsourcedata		&& Adds a PFX to the object's internal list of sources to be searched for certificates and private keys when decrypting or when creating signed email for sending. Multiple PFX sources can be added by calling this method once for each.
		*m: addpfxsourcefile		&& Adds a PFX file to the object's internal list of sources to be searched for certificates and private keys when decrypting or when sending signed email. Multiple PFX files can be added by calling this method once for each.
		*m: allornone_access		&& Access method used to retrieve the Chilkat MailMan AllOrNone property.
		*m: allornone_assign		&& Assign method used to hold a reference to the AllOrNone property.
		*m: autofixsettings		&& Method to run after a connection is made to the server and the AutoFix property is set to 1.
		*m: autofix_access		&& Access method used to retrieve the Chilkat MailMan AutoFix property.
		*m: autofix_assign		&& Assign method used to hold a reference to the AutoFix property.
		*m: autogenmessageid_access		&& Access method used to retrieve the Chilkat MailMan AutoGenMessageID property.
		*m: autogenmessageid_assign		&& Assign method used to hold a reference to the AutoGenMessageID property.
		*m: autosmtprset_access		&& Access method used to hold a reference to the AutoSMTPRSet property.
		*m: autosmtprset_assign		&& Assign method used to hold a reference to the AutoSMTPRSet property.
		*m: autounwrapsecurity_access		&& Access method used to hold a reference to the AutoUnwrapSecurity property.
		*m: autounwrapsecurity_assign		&& Assign method used to hold a reference to the AutoUnwrapSecurity property.
		*m: checkmail		&& Returns the number of emails available on the POP3 server. Returns -1 on error.
		*m: checkmailasync		&& Creates an asynchronous task to call the CheckMail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: clearbademailaddresses		&& Clears the list of bad email addresses stored within the Mailman object. When an email-sending method is called, any email addresses rejected by the SMTP server will be cached within the Mailman object.
		*m: clearpop3sessionlog		&& Clears the contents of the Pop3SessionLog property.
		*m: clearsmtpsessionlog		&& Clears the contents of the SmtpSessionLog property.
		*m: clientipaddress_access		&& Access method used to retrieve the Chilkat MailMan ClientIPAddress property.
		*m: clientipaddress_assign		&& Assign method used to hold a reference to the ClientIPAddress property.
		*m: closesmtpconnection		&& The mailman object automatically opens an SMTP connection (if necessary) whenever an email-sending method is called. The connection is kept open until explicitly closed by this method. Calling this method is entirely optional.
		*m: closesmtpconnectionasync		&& Creates an asynchronous task to call the CloseSmtpConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: connectfailreason_access		&& Access method used to retrieve the Chilkat MailMan ConnectFailReason property.
		*m: connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*m: connecttimeout_access		&& Access method used to retrieve the Chilkat MailMan ConnectTimeout property.
		*m: connecttimeout_assign		&& Assign method used to hold a reference to the ConnectTimeout property.
		*m: copymail		&& Copy the email from a POP3 server into a EmailBundle. This does not remove the email from the POP3 server. Returns Nothing on failure
		*m: copymailasync		&& Creates an asynchronous task to call the CopyMail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat MailMan DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deletebundle		&& Marks multiple emails on the POP3 server for deletion. (Each email in emailBundle that is also present on the server is marked for deletion.) To complete the deletion of the emails, a "QUIT" message must be sent and the POP3 session ended.
		*m: deletebundleasync		&& Creates an asynchronous task to call the DeleteBundle method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deletebymsgnum		&& Marks an email for deletion by message number. WARNING: Be very careful if calling this method. Message numbers are specific to a POP3 session.
		*m: deletebymsgnumasync		&& Creates an asynchronous task to call the DeleteByMsgnum method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deletebyuidl		&& Marks an email on the POP3 server for deletion. To complete the deletion of an email, a "QUIT" message must be sent and the POP3 session ended. This will happen automatically when the ImmediateDelete property equals 1, which is the default.
		*m: deletebyuidlasync		&& Creates an asynchronous task to call the DeleteByUidl method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deleteemail		&& Marks an email on the POP3 server for deletion. To complete the deletion of an email, a "QUIT" message must be sent and the POP3 session ended.
		*m: deleteemailasync		&& Creates an asynchronous task to call the DeleteEmail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deletemultiple		&& Marks multiple emails on the POP3 server for deletion. (Any email on the server having a UIDL equal to a UIDL found in uidlArray is marked for deletion.) To complete the deletion of the emails, a "QUIT" message must be sent and the POP3 session ended.
		*m: deletemultipleasync		&& Creates an asynchronous task to call the DeleteMultiple method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: deleteuidlset		&& Introduced in version 11.1.0. Marks multiple emails for deletion on the POP3 server when their UIDL matches any in stUidls. To finalize deletions, a QUIT message must be sent and the POP3 session closed.
		*m: deleteuidlsetasync		&& Introduced in version 11.1.0. Creates an asynchronous task to call the DeleteUidlSet method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: dsnenvid_access		&& Access method used to retrieve the Chilkat MailMan DSNEnvID property.
		*m: dsnenvid_assign		&& Assign method used to hold a reference to the DSNEnvID property.
		*m: dsnnotify_access		&& Access method used to retrieve the Chilkat MailMan DSNNotify property.
		*m: dsnnotify_assign		&& Assign method used to hold a reference to the DSNNotify property.
		*m: dsnret_access		&& Access method used to retrieve the Chilkat MailMan DSNRet property.
		*m: dsnret_assign		&& Assign method used to hold a reference to the DSNRet property.
		*m: embedcertchain_access		&& Access method used to retrieve the Chilkat MailMan EmbedCertChain property.
		*m: embedcertchain_assign		&& Assign method used to hold a reference to the EmbedCertChain property.
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat Mailman EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: fetchall		&& Introduced in version 11.0.0. Retrieves all emails from the POP3 server. If keepOnServer is 1, emails remain on the server. Returns 1 for success, 0 for failure.
		*m: fetchallasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchAll method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: fetchbymsgnum		&& Fetches an email by message number. WARNING: Be very careful if calling this method. Message numbers are specific to a POP3 session.
		*m: fetchbymsgnumasync		&& Creates an asynchronous task to call the FetchByMsgnum method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchbyuidl		&& Introduced in version 11.0.0. Retrieves either the complete email or just the header along with the first N lines of the message body. Returns 1 for success, 0 for failure.
		*m: fetchbyuidlasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchByUidl method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: fetchemail		&& Fetches an email from the POP3 mail server given its UIDL. Calling this method does not remove the email from the server.
		*m: fetchemailasync		&& Creates an asynchronous task to call the FetchEmail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchfull		&& Introduced in version 11.0.0. If a partial email (header-only) was retrieved, this method will download and return the full email from the server using the partial email as an argument. Returns 1 for success, 0 for failure.
		*m: fetchfullasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchFull method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: fetchmime		&& Fetches an email by UIDL and returns the MIME source of the email in a byte array.
		*m: fetchmimeasync		&& Creates an asynchronous task to call the FetchMime method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchmimebd		&& Introduced in version 9.5.0.73. Fetches an email by UIDL and returns the MIME source of the email in uidl. Returns 1 for success, 0 for failure.
		*m: fetchmimebdasync		&& Creates an asynchronous task to call the FetchMimeBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchmimebymsgnum		&& Fetches an email by message number and returns the MIME source of the email in a byte array. WARNING: Message sequend numbers are specific to a POP3 session.
		*m: fetchmimebymsgnumasync		&& Creates an asynchronous task to call the FetchMimeByMsgnum method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchmimebymsgnumbd		&& Introduced in version 11.0.0. Retrieves an email by its message number and provides the MIME source in bd. Note: Message numbers are unique to each POP3 session. Returns 1 for success, 0 for failure.
		*m: fetchmimebymsgnumbdasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchMimeByMsgnumBd method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: fetchmultiple		&& Given an array of UIDL strings, fetches all the emails from the POP3 server whose UIDL is present in the array, and returns the emails in a bundle. Returns Nothing on failure
		*m: fetchmultipleasync		&& Creates an asynchronous task to call the FetchMultiple method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchmultipleheaders		&& Given an array of UIDL strings, fetches all the email headers from the POP3 server whose UIDL is present in the array.
		*m: fetchmultipleheadersasync		&& Creates an asynchronous task to call the FetchMultipleHeaders method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchmultiplemime		&& Given an array of UIDL strings, fetches all the emails from the POP3 server whose UIDL is present in the array, and returns the MIME source of each email in an "stringarray".
		*m: fetchmultiplemimeasync		&& Creates an asynchronous task to call the FetchMultipleMime method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchone		&& Introduced in version 11.0.0. Retrieves a complete message or header by its message number and stores it in msgNum. The first email has a message number of 1. Returns 1 for success, 0 for failure.
		*m: fetchoneasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchOne method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: fetchrange		&& Introduced in version 11.0.0. Retrieves a specified range of emails from the POP3 server. If keepOnServer is 1, the emails remain on the server. Returns 1 for success, 0 for failure.
		*m: fetchrangeasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchRange method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: fetchsingleheader		&& Fetches a single header by message number. Returns an email object on success, or a null reference on failure.
		*m: fetchsingleheaderasync		&& Creates an asynchronous task to call the FetchSingleHeader method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchsingleheaderbyuidl		&& Fetches a single header by UIDL. Returns an email object on success, or a null reference on failure.
		*m: fetchsingleheaderbyuidlasync		&& Creates an asynchronous task to call the FetchSingleHeaderByUidl method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: fetchuidls		&& Introduced in version 11.0.0. Returns the UIDLs of the emails currently stored on the POP3 server. POP3 UIDLs (Unique ID Listings) are persistent, unique identifiers assigned by a mail server to each email message in a mailbox.
		*m: fetchuidlsasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchUidls method with the arguments provided. Note: Async method event callbacks happen in the background thread. Returns Nothing on failure.
		*m: fetchuidlset		&& Introduced in version 11.0.0. Fetches the email headers or full emails from the POP3 server whose UIDL is present in the uidls. Returns 1 for success, 0 for failure.
		*m: fetchuidlsetasync		&& Introduced in version 11.0.0. Creates an asynchronous task to call the FetchUidlSet method with the arguments provided. Note: Async method event callbacks happen in the background thread.
		*m: filter_access		&& Access method used to retrieve the Chilkat MailMan Filter property.
		*m: filter_assign		&& Assign method used to hold a reference to the Filter property.
		*m: getallheaders		&& Returns all the emails from the POP3 server, but only the first numBodyLines lines of the body. Attachments are not returned.
		*m: getallheadersasync		&& Creates an asynchronous task to call the GetAllHeaders method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getbademailaddresses		&& Returns a string array object containing a list of failed and invalid email addresses that have accumulated during SMTP sends.
		*m: getfullemail		&& If a partial email was obtained using GetHeaders or GetAllHeaders, this method will take the partial email as an argument, and download the full email from the server.
		*m: getfullemailasync		&& If a partial email was obtained using GetHeaders or GetAllHeaders, this method will take the partial email as an argument, and download the full email from the server. A new email object (separate from the partial email) is returned.
		*m: getheaders		&& The same as the GetAllHeaders method, except only the emails from fromIndex to toIndex on the POP3 server are returned. The first email on the server is at index 0. Returns Nothing on failure
		*m: getheadersasync		&& Creates an asynchronous task to call the GetHeaders method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called on this object instance. For many methods, there is no information.
		*m: getmailboxcount		&& Returns the number of emails on the POP3 server, or -1 for failure. This method is identical to CheckMail. It was added for clarity.
		*m: getmailboxcountasync		&& Creates an asynchronous task to call the GetMailboxCount method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getmailboxinfoxml		&& Returns an XML document with information about the emails in a POP3 mailbox. The XML contains the UIDL and size (in bytes) of each email in the mailbox. Returns Nothing on failure
		*m: getmailboxinfoxmlasync		&& Creates an asynchronous task to call the GetMailboxInfoXml method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getmailboxsize		&& Returns the total combined size in bytes of all the emails in the POP3 mailbox. This is also known as the "mail drop" size. Returns -1 on failure.
		*m: getmailboxsizeasync		&& Creates an asynchronous task to call the GetMailboxSize method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getpop3sslservercert		&& Returns the POP3 server's SSL certificate. This is available after connecting via SSL to a POP3 server. (To use POP3 SSL, set the PopSsl property = 1.) Returns a null reference if no POP3 SSL certificate is available. Returns Nothing on failure.
		*m: getsenttoemailaddrs		&& Returns the list of successful email addresses in the last call to a mail sending method, such as SendEmail.
		*m: getservercert		&& Introduced in version 11.0.0. If the current connection is SSL/TLS, this method returns the digital certificate of the SMTP or POP3 server specified by useSmtp. The certificate is returned in cert. Returns 1 for success, 0 for failure.
		*m: getsizebyuidl		&& Returns the size of an email (including attachments) given the UIDL of the email on the POP3 server. Returns -1 for failure.
		*m: getsizebyuidlasync		&& Creates an asynchronous task to call the GetSizeByUidl method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: getsmtpsslservercert		&& If using SSL/TLS, this method returns the SMTP server's digital certificate used with the secure connection. Returns Nothing on failure
		*m: getuidls		&& Returns the UIDLs of the emails currently stored on the POP3 server. Returns Nothing on failure
		*m: getuidlsasync		&& Creates an asynchronous task to call the GetUidls method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat MailMan HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: helohostname_access		&& Access method used to retrieve the Chilkat MailMan HeloHostName property.
		*m: helohostname_assign		&& Assign method used to hold a reference to the HeloHostName property.
		*m: httpproxyauthmethod_access		&& Access method used to retrieve the Chilkat MailMan HTTPProxyAuthMethod property.
		*m: httpproxyauthmethod_assign		&& Assign method used to hold a reference to the HTTPProxyAuthMethod property.
		*m: httpproxydomain_access		&& Access method used to retrieve the Chilkat MailMan HTTPProxyDomain property.
		*m: httpproxydomain_assign		&& Assign method used to hold a reference to the HTTPProxyDomain property.
		*m: httpproxyhostname_access		&& Access method used to retrieve the Chilkat MailMan HTTPProxyHostname property.
		*m: httpproxyhostname_assign		&& Assign method used to hold a reference to the HTTPProxyHostName property.
		*m: httpproxypassword_access		&& Access method used to retrieve the Chilkat MailMan HTTPProxyPassword property.
		*m: httpproxypassword_assign		&& Assign method used to hold a reference to the HTTPProxyPassword property.
		*m: httpproxyport_access		&& Access method used to retrieve the Chilkat MailMan HTTPProxyPort property.
		*m: httpproxyport_assign		&& Assign method used to hold a reference to the HTTPProxyPort property.
		*m: httpproxyusername_access		&& Access method used to retrieve the Chilkat MailMan HTTPProxyUserName property.
		*m: httpproxyusername_assign		&& Assign method used to hold a reference to the HTTPProxyUserName property.
		*m: immediatedelete_access		&& Access method used to retrieve the Chilkat MailMan ImmediateDelete property.
		*m: immediatedelete_assign		&& Assign method used to hold a reference to the ImmediateDelete property.
		*m: includerootcert_access		&& Access method used to retrieve the Chilkat MailMan IncludeRootCert property.
		*m: includerootcert_assign		&& Assign method used to hold a reference to the ImmediateRootCert property.
		*m: ispop3connected_access		&& Access method used to retrieve the Chilkat MailMan IsPOP3Connected property.
		*m: ispop3connected_assign		&& Assign method used to hold a reference to the IsPOP3Connected property.
		*m: issmtpconnected_access		&& Access method used to retrieve the Chilkat MailMan IsSMTPConnected property.
		*m: issmtpconnected_assign		&& Assign method used to hold a reference to the IsSMTPConnected property.
		*m: issmtpdsncapable		&& Contacts the SMTP server and determines if it supports the DSN (Delivery Status Notification) features specified by RFC 3461 and supported by the DsnEnvid, DsnNotify, and DsnRet properties.
		*m: issmtpdsncapableasync		&& Creates an asynchronous task to call the IsSmtpDsnCapable method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: isunlocked		&& Undocumented method! Returns true if the class has been unlocked. It is necessary to call UnlockComponent before calling any other methods. Passing any string to UnlockComponent will automatically activate a 30-day trial period.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat MailMan LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat MailMan LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat MailMan LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat MailMan LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastjsondata		&& Provides information about what transpired in the last method called on this object instance. For many methods, there is no information.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat MailMan LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: lastsendqfilename_access		&& Access method used to retrieve the Chilkat MailMan LastSendQFileName property.
		*m: lastsendqfilename_assign		&& Assign method used to hold a reference to the LastSendQFileName property.
		*m: lastsmtpstatusmsg_access		&& Access method used to retrieve the Chilkat MailMan LastSMTPStatusMsg property.
		*m: lastsmtpstatusmsg_assign		&& Assign method used to hold a reference to the LastSMTPStatusMsg property.
		*m: lastsmtpstatus_access		&& Access method used to retrieve the Chilkat MailMan LastSMTPStatus property.
		*m: lastsmtpstatus_assign		&& Assign method used to hold a reference to the LastSMTPStatus property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat MailMan LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat MailMan LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loademl		&& Loads an email from a .eml file. (EML files contain the MIME source of an email.) Returns a null reference on failure. Note: MHT files can be loaded into an email object by calling this method. Returns Nothing on failure
		*m: loadmbx		&& Loads a .mbx file containing emails and returns an email bundle. If a Filter is present, only emails matching the filter are returned. Returns Nothing on failure.
		*m: loadmbxfile		&& Introduced in version 11.0.0. Loads a .mbx file containing emails and returns in bundle. If a Filter is present, only emails that match the filter are returned. Returns 1 for success, 0 for failure.
		*m: loadmime		&& Creates and loads an email from a MIME string. Returns a null reference on failure. Returns Nothing on failure
		*m: loadqueuedemail		&& Undocumented method! Loads an email previously written to a Chilkat SMTPQ file via the SendQ/SendQ2 methods. When SendQ or SendQ2 writes an email to a queue directory, the .eml created contains special MIME header fields used by the SMTPQ process.
		*m: loadtaskcaller		&& Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: loadxmlemail		&& Loads an XML file containing a single email and returns an email object. Returns a null reference on failure. Returns Nothing on failure
		*m: loadxmlemailstring		&& Loads an XML string containing a single email and returns an email object. Returns a null reference on failure. Returns Nothing on failure.
		*m: loadxmlfile		&& Loads an XML file containing one or more emails and returns an email bundle. If a Filter is present, only emails matching the filter are returned. Returns a null reference on failure. Returns Nothing on failure
		*m: loadxmlstring		&& Loads from an XML string containing emails and returns an email bundle. If a Filter is present, only emails matching the filter are returned. Returns Nothing on failure.
		*m: logmailreceivedfilename_access		&& Access method used to retrieve the Chilkat MailMan LogMailReceivedFileName property.
		*m: logmailreceivedfilename_assign		&& Assign method used to hold a reference to the LogMailReceivedFileName property..
		*m: logmailsentfilename_access		&& Access method used to retrieve the Chilkat MailMan LogMailSentFileName property.
		*m: logmailsentfilename_assign		&& Assign method used to hold the Chilkat MailMan LogMailSentFileName property.
		*m: mailhost_access		&& Access method used to retrieve the Chilkat MailMan MailHost property.
		*m: mailhost_assign		&& Assign method used to hold the Chilkat MailMan MailHost property.
		*m: mailport_access		&& Access method used to retrieve the Chilkat MailMan MailPort property.
		*m: mailport_assign		&& Assign method used to hold the Chilkat MailMan MailPort property.
		*m: maxcount_access		&& Access method used to retrieve the Chilkat MailMan MaxCount property.
		*m: maxcount_assign		&& Assign method used to hold the Chilkat MailMan MaxCount property.
		*m: mxlookup		&& Performs a DNS MX lookup to return the mail server hostname based on an email address. Returns Nothing on failure
		*m: mxlookupall		&& Performs a DNS MX lookup to return the list of mail server hostnames based on an email address. The primary server is at index 0. In most cases, there is only one mail server for a given email address. Returns Nothing on failure.
		*m: oauth2accesstoken_access		&& Access method used to retrieve the Chilkat MailMan oAuth2AccessToken property.
		*m: oauth2accesstoken_assign		&& Assign method used to hold the Chilkat MailMan oAuth2AccessToken property.
		*m: opaquesigning_access		&& Access method used to retrieve the Chilkat MailMan OpaqueSigning property.
		*m: opaquesigning_assign		&& Assign method used to hold a reference to the Chilkat Mailman object.
		*m: opensmtpconnection		&& Explicitly opens a connection to the SMTP server and authenticates (if a username/password was specified).
		*m: opensmtpconnectionasync		&& Creates an asynchronous task to call the OpenSmtpConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: p7mencryptattachfilename_access		&& Access method used to retrieve the Chilkat MailMan P7mEncryptAttachFileName property.
		*m: p7mencryptattachfilename_assign		&& Assign method used to hold the Chilkat MailMan P7mEncryptAttachFileName property.
		*m: p7msigattachfilename_access		&& Access method used to retrieve the Chilkat MailMan P7MSigAttachFileName property.
		*m: p7msigattachfilename_assign		&& Assign method used to hold the Chilkat MailMan P7mSigAttachFileName property.
		*m: p7ssigattachfilename_access		&& Access method used to retrieve the Chilkat MailMan P7sSigAttachFileName property.
		*m: p7ssigattachfilename_assign		&& Assign method used to hold the Chilkat MailMan P7sSigAttachFileName property.
		*m: percentdonescale_access		&& Access method used to retrieve a reference to the PercentDone property.
		*m: percentdonescale_assign		&& Assign method used to hold a reference to the PercentDone property.
		*m: pop3authenticate		&& Authenticates with the POP3 server using the property settings such as PopUsername, PopPassword, etc. This method should only be called after a successful call to Pop3Connect.
		*m: pop3authenticateasync		&& Creates an asynchronous task to call the Pop3Authenticate method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3beginsession		&& Call to explicitly begin a POP3 session. It is not necessary to call this method because any method requiring an established POP3 session will automatically connect and login if a session is not already open.
		*m: pop3beginsessionasync		&& Creates an asynchronous task to call the Pop3BeginSession method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3connect		&& Explicitly establishes a connection to the POP3 server, which includes establishing a secure TLS channel if required, and receives the initial greeting.
		*m: pop3connectasync		&& Creates an asynchronous task to call the Pop3Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3endsession		&& Call to explicitly end a POP3 session. If the ImmediateDelete property is set to 0, and emails marked for deletion will be deleted at this time. Returns 1 for success, 0 for failure.
		*m: pop3endsessionasync		&& Creates an asynchronous task to call the Pop3EndSession method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3endsessionnoquit		&& This method is identical to Pop3EndSession, but no "QUIT" command is sent. The client simply disconnects from the POP3 server. This method should always return 1.
		*m: pop3endsessionnoquitasync		&& Creates an asynchronous task to call the Pop3EndSessionNoQuit method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3noop		&& Sends a NOOP command to the POP3 server. This may be a useful method to call periodically to keep a connection open, or to verify that the POP3 connection (session) is open and functioning. Returns 1 for success, 0 for failure.
		*m: pop3noopasync		&& Creates an asynchronous task to call the Pop3Noop method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3reset		&& Sends a RSET command to the POP3 server. If any messages have been marked as deleted by the POP3 server, they are unmarked. Calling Pop3Reset resets the POP3 session to a valid, known starting point. Returns 1 for success, 0 for failure.
		*m: pop3resetasync		&& Creates an asynchronous task to call the Pop3Reset method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3sendrawcommand		&& Sends a raw command to the POP3 server and returns the POP3 server's response.
		*m: pop3sendrawcommandasync		&& Creates an asynchronous task to call the Pop3SendRawCommand method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: pop3sessionid_access		&& Access method used to retrieve a reference to the POP3SessionID property.
		*m: pop3sessionid_assign		&& Assign method used to hold a reference to the POP3SessionID property.
		*m: pop3sessionlog_access		&& Access method used to retrieve a reference to the POP3SessionLog property.
		*m: pop3sessionlog_assign		&& Assign method used to hold a reference to the POP3SessionLog property.
		*m: pop3spa_access		&& Access method used to retrieve a reference to the POP3SPA property.
		*m: pop3spa_assign		&& Assign method used to hold a reference to the POP3SPA property.
		*m: pop3sslservercertverified_access		&& Access method used to retrieve a reference to the POP3SSLServerCertVerified property.
		*m: pop3sslservercertverified_assign		&& Assign method used to hold a reference to the POP3SSLServerCertVerified property.
		*m: pop3stlsifpossible_access		&& Access method used to retrieve a reference to the POP3SSTLSIfPossible property.
		*m: pop3stlsifpossible_assign		&& Assign method used to hold a reference to the POP3SSTLSIfPossible property.
		*m: pop3stls_access		&& Access method used to retrieve a reference to the POP3SSTLS property.
		*m: pop3stls_assign		&& Assign method used to hold a reference to the POP3SSTLS property.
		*m: poppasswordbase64_access		&& Access method used to retrieve a reference to the POPPasswordBase64 property.
		*m: poppasswordbase64_assign		&& Assign method used to hold a reference to the POPPasswordBase64 property.
		*m: poppassword_access		&& Access method used to retrieve a reference to the POPPassword property.
		*m: poppassword_assign		&& Assign method used to hold a reference to the POPPassword property.
		*m: popssl_access		&& Access method used to retrieve a reference to the POPSSL property.
		*m: popssl_assign		&& Assign method used to hold a reference to the POPSSL property.
		*m: popusername_access		&& Access method used to retrieve a reference to the POPUserName property.
		*m: popusername_assign		&& Assign method used to hold a reference to the POPUserName property.
		*m: preferipv6_access		&& Access method used to retrieve a reference to the PreferIPV6 property.
		*m: preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*m: quicksend		&& A quick way to send an email to a single recipient without having to explicitly create an email object. Returns 1 for success, 0 for failure.
		*m: quicksendasync		&& Creates an asynchronous task to call the QuickSend method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: readtimeout_access		&& Access method used to retrieve a reference to the ReadTimeout property.
		*m: readtimeout_assign		&& Assign method used to hold a reference to the ReadTimeout property.
		*m: rendertomime		&& When an email is sent by calling SendEmail, it is first "rendered" according to the values of the email properties and contents. The rendered MIME string is returned on success.
		*m: rendertomimebd		&& The same as RenderToMimeBytes, except the MIME is rendered into renderedMime. The rendered MIME is appended to renderedMime. Returns 1 for success, 0 for failure.
		*m: rendertomimebytes		&& This method is the same as RenderToMime, but the MIME is returned in a byte array. If an email uses an 8bit or binary MIME encoding, then calling RenderToMime may introduce errors because it is not possible to return non-text binary data as a string.
		*m: rendertomimesb		&& The same as RenderToMime, except the MIME is rendered into renderedMime. The rendered MIME is appended to renderedMime. Returns 1 for success, 0 for failure.
		*m: requirehostnamematch_access		&& Access method used to retrieve a reference to the RequireHostNameMatch property.
		*m: requirehostnamematch_assign		&& Assign method used to hold a reference to the RequireHostNameMatch property.
		*m: requiresslcertverify_access		&& Access method used to retrieve a reference to the RequireSSLCertVerify property.
		*m: requiresslcertverify_assign		&& Assign method used to hold a reference to the RequireSSLCertVerify property.
		*m: resetdateonload_access		&& Access method used to retrieve a reference to the ResetDateOnLoad property.
		*m: resetdateonload_assign		&& Assign method used to hold a reference to the ResetDateOnLoad property.
		*m: sendbuffersize_access		&& Access method used to retrieve a reference to the SendBufferSize property.
		*m: sendbuffersize_assign		&& Assign method used to hold a reference to the SendBufferSize property.
		*m: sendbundle		&& Sends a bundle of emails. This is identical to calling SendEmail for each email in the bundle.
		*m: sendbundleasync		&& Creates an asynchronous task to call the SendBundle method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendemail		&& Sends a single email. The connection to the SMTP server will remain open so that a subsequent call to SendEmail (or other email-sending methods) can re-use the same connection.
		*m: sendemailasync		&& Creates an asynchronous task to call the SendEmail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendindividual_access		&& Access method used to retrieve a reference to the SendIndividual property.
		*m: sendindividual_assign		&& Assign method used to hold a reference to the SendIndividual property.
		*m: sendmime		&& Provides complete control over the email that is sent. The MIME text passed in mimeSource (the MIME source of an email) is passed exactly as-is to the SMTP server.
		*m: sendmimeasync		&& Creates an asynchronous task to call the SendMime method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendmimebd		&& This method is the same as SendMimeBytes, except the MIME is passed in an object (mimeData) rather than explicitly passing the bytes. Returns 1 for success, 0 for failure.
		*m: sendmimebdasync		&& Creates an asynchronous task to call the SendMimeBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendmimebytes		&& This method is the same as SendMime, except the MIME is passed in a byte array. This can be important if the MIME uses a binary encoding, or if a DKIM/DomainKey signature is included.
		*m: sendmimebytesasync		&& Creates an asynchronous task to call the SendMimeBytes method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendmimebytesq		&& Undocumented method! This method is the samem as SendMimeQ, except the MIME is passed in a byte array argument instead of a string argument.
		*m: sendmimeq		&& Undocumented method! ame as SendMime, except the email is written to the Chilkat SMTPQ's queue directory for background sending from the SMTPQ service. Important: The SMTPQ functionality is decremented and will be removed in a future version.
		*m: sendmimetolist		&& Same as SendMime, but the recipient list is read from a text file (distListFilename) containing one email address per line. Returns 1 for success, 0 for failure.
		*m: sendmimetolistasync		&& Creates an asynchronous task to call the SendMimeToList method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sendq		&& Undocumented function! Queues an email to be sent using the Chilkat SMTP queue service. This is the same as SendEmail, except the email is written to the SMTPQ's queue directory.
		*m: sendq2		&& Undocumented method! Same as SendQ, but the queue directory can be explicitly specified in a method argument.
		*m: setcsp		&& Undocumented method! This is not commonly used because the default Microsoft CSP is typically appropriate. One instance where SetCSP is necessary is when using the Crypto-Pro CSP for the GOST R 34.10-2001 and GOST R 34.10-94 providers.
		*m: setdecryptcert		&& Explicitly specifies the certificate to be used for decrypting encrypted email. Returns 1 for success, 0 for failure.
		*m: setdecryptcert2		&& Explicitly specifies the certificate and associated private key to be used for decrypting S/MIME encrypted email.
		*m: setpassword		&& Provides a more secure way of setting either the POP3 or SMTP password.
		*m: setsslclientcert		&& Sets the client-side certificate to be used with SSL connections. This is typically not required, as most SSL connections are such that only the server is authenticated while the client remains unauthenticated. Returns 1 for success, 0 for failure.
		*m: setsslclientcertpem		&& Allows for a client-side certificate to be used for the SSL / TLS connection. Returns 1 for success, 0 for failure.
		*m: setsslclientcertpfx		&& Allows for a client-side certificate to be used for the SSL / TLS connection. Returns 1 for success, 0 for failure.
		*m: sizelimit_access		&& Access method used to retrieve a reference to the SizeLimit property.
		*m: sizelimit_assign		&& Assign method used to hold a reference to the SizeLimit property.
		*m: smtpauthenticate		&& Authenticates with the SMTP server using the property settings such as SmtpUsername, SmtpPassword, etc. This method should only be called after a successful call to SmtpConnect.
		*m: smtpauthenticateasync		&& Creates an asynchronous task to call the SmtpAuthenticate method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: smtpauthmethod_access		&& Access method used to retrieve a reference to the SMTPAuthMethod property.
		*m: smtpauthmethod_assign		&& Assign method used to hold a reference to the SMTPAuthMethod property.
		*m: smtpconnect		&& Explicitly establishes a connection to the SMTP server, which includes establishing a secure TLS channel if required, and receives the initial greeting. This method stops short of authenticating.
		*m: smtpconnectasync		&& Creates an asynchronous task to call the SmtpConnect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: smtpfailreason_access		&& Access method used to retrieve a reference to the SMTPFailReason property.
		*m: smtpfailreason_assign		&& Assign method used to hold a reference to the SMTPFailReason property.
		*m: smtphost_access		&& Access method used to retrieve a reference to the SMTPHost property.
		*m: smtphost_assign		&& Assign method used to hold a reference to the SMTPHost property.
		*m: smtplogindomain_access		&& Access method used to retrieve a reference to the SMTPLoginDomain property.
		*m: smtplogindomain_assign		&& Assign method used to hold a reference to the SMTPLoginDomain property.
		*m: smtpmailfrom_access		&& Access method used to retrieve a reference to the SMTPMailFrom property.
		*m: smtpmailfrom_assign		&& Assign method used to hold a reference to the SMTPMailFrom property.
		*m: smtpnoop		&& Sends a no-op to the SMTP server. Calling this method is good for testing to see if the connection to the SMTP server is working and valid. The SmtpNoop method will automatically establish the SMTP connection if it does not already exist.
		*m: smtpnoopasync		&& Creates an asynchronous task to call the SmtpNoop method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: smtppassword_access		&& Access method used to retrieve a reference to the SMTPPassword property.
		*m: smtppassword_assign		&& Assign method used to hold a reference to the SMTPPassword property.
		*m: smtppipelining_access		&& Introduced in version 9.5.0.49. Access method used to retrieve the Chilkat MailMan SMTPPipelining property.
		*m: smtppipelining_assign		&& Assign method used to hold a reference to the SMTPPipelining property.
		*m: smtpport_access		&& Access method used to retrieve the Chilkat MailMan SMTPPort property.
		*m: smtpport_assign		&& Assign method used to hold a reference to the SMTPPort property.
		*m: smtprecipientslog		&& Introduced in version 11.0.0. Returns a list of email addresses rejected or accepted by the SMTP server from the last call of an email-sending method, like SendEmail. Returns rejected email addresses if rejected is 1.
		*m: smtpreset		&& Sends an RSET command to the SMTP server. This method is rarely needed. The RSET command resets the state of the connection to the SMTP server to the initial state (so that the component can proceed with sending a new email).
		*m: smtpresetasync		&& Creates an asynchronous task to call the SmtpReset method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: smtpsendrawcommand		&& Sends a raw command to the SMTP server and returns the SMTP server's response.
		*m: smtpsendrawcommandasync		&& Creates an asynchronous task to call the SmtpSendRawCommand method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: smtpsessionlog_access		&& Access method used to retrieve the Chilkat MailMan SMTPSessionLog property.
		*m: smtpsessionlog_assign		&& Assign method used to hold a reference to the SMTPSessionLog property.
		*m: smtpsslservercertverified_access		&& Access method used to retrieve a reference to the SMTPSSLServerCertVerified property.
		*m: smtpsslservercertverified_assign		&& Assign method used to hold a reference to the SMTPSSLServerCertVerified property.
		*m: smtpssl_access		&& Access method used to retrieve a reference to the SMTPSSL property.
		*m: smtpssl_assign		&& Assign method used to hold a reference to the SMTPSSL property.
		*m: smtpusername_access		&& Access method used to retrieve a reference to the SMTPUserName property.
		*m: smtpusername_assign		&& Assign method used to hold a reference to the SMTPUserName property.
		*m: snihostname_access		&& Access method used to retrieve a reference to the SNIHostName property.
		*m: snihostname_assign		&& Assign method used to hold a reference to the SNIHostName property.
		*m: sockshostname_access		&& Access method used to retrieve a reference to the SOCKSHostName property.
		*m: sockshostname_assign		&& Assign method used to hold a reference to the SOCKSHostName property.
		*m: sockspassword_access		&& Access method used to retrieve a reference to the SOCKSPassword property.
		*m: sockspassword_assign		&& Assign method used to hold a reference to the SOCKSPassword property.
		*m: socksport_access		&& Access method used to retrieve a reference to the SOCKSPort property.
		*m: socksport_assign		&& Assign method used to hold a reference to the SOCKSPort property.
		*m: socksusername_access		&& Access method used to retrieve a reference to the SOCKSUserName property.
		*m: socksusername_assign		&& Assign method used to hold a reference to the SOCKSUserName property.
		*m: socksversion_access		&& Access method used to retrieve a reference to the SOCKSVersion property.
		*m: socksversion_assign		&& Assign method used to hold a reference to the SOCKSVersion property.
		*m: sorcvbuf_access		&& Access method used to retrieve a reference to the SoRcvBuf property.
		*m: sorcvbuf_assign		&& Assign method used to hold a reference to the SoRcvBuf property.
		*m: sosndbuf_access		&& Access method used to retrieve a reference to the SoSndBuf property.
		*m: sosndbuf_assign		&& Assign method used to hold a reference to the SoSndBuf property.
		*m: sshauthenticatepk		&& Authenticates with the SSH server using public-key authentication. The corresponding public key must have been installed on the SSH server for the sshLogin. Authentication will succeed if the matching sshUsername is provided.
		*m: sshauthenticatepkasync		&& Creates an asynchronous task to call the SshAuthenticatePk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sshauthenticatepw		&& Authenticates with the SSH server using a sshLogin and sshPassword. An SSH tunneling (port forwarding) session always begins by first calling SshTunnel to connect to the SSH server, then calling either AuthenticatePw or AuthenticatePk to authenticate.
		*m: sshauthenticatepwasync		&& Creates an asynchronous task to call the SshAuthenticatePw method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sshclosetunnel		&& Closes the SSH tunnel for SMTP or POP3. Returns 1 for success, 0 for failure.
		*m: sshclosetunnelasync		&& Creates an asynchronous task to call the SshCloseTunnel method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sshopentunnel		&& Connects to an SSH server and creates a tunnel for SMTP or POP3. The sshHostname is the hostname (or IP address) of the SSH server. The sshPort is typically 22, which is the standard SSH port number.
		*m: sshopentunnelasync		&& Creates an asynchronous task to call the SshOpenTunnel method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: sshtunnel		&& Undocumented method!
		*m: sslallowedciphers_access		&& Access method used to retrieve a reference to the SSLAllowedCiphers property.
		*m: sslallowedciphers_assign		&& Assign method used to hold a reference to the SSLAllowedCiphers property.
		*m: sslprotocol_access		&& Access method used to retrieve a reference to the SSLProtocol property.
		*m: sslprotocol_assign		&& Assign method used to hold a reference to the SSLProtocol property.
		*m: starttlsifpossible_access		&& Access method used to retrieve a reference to the StartTLSIfPossible property.
		*m: starttlsifpossible_assign		&& Assign method used to hold a reference to the StartTLSIfPossible property
		*m: starttls_access		&& Access method used to retrieve a reference to the StartTLS property.
		*m: starttls_assign		&& Assign method used to hold a reference to the StartTLS property.
		*m: tlsciphersuite_access		&& Access method used to retrieve a reference to the TLSCipherSuite property.
		*m: tlsciphersuite_assign		&& Assign method used to hold a reference to the TLSCipherSuite property
		*m: tlspinset_access		&& Access method used to retrieve a reference to the TLSPinSet property.
		*m: tlspinset_assign		&& Assign method used to hold a reference to the TLSPinSet property
		*m: tlsversion_access		&& Access method used to retrieve a reference to the TLSVersion property.
		*m: tlsversion_assign		&& Assign method used to hold a reference to the TLSVersion property
		*m: transfermail		&& Downloads and removes all email from a POP3 server. A bundle containing the emails is returned. A null reference is returned on failure. Returns Nothing on failure
		*m: transfermailasync		&& Creates an asynchronous task to call the TransferMail method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: transfermultiplemime		&& Same as FetchMultipleMime except that the downloaded emails are also deleted from the server. Returns a null reference on failure. Returns Nothing on failure
		*m: transfermultiplemimeasync		&& Creates an asynchronous task to call the TransferMultipleMime method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: uncommonoptions_access		&& Access method used to retrieve a reference to the UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: useapop_access		&& Access method used to retrieve a reference to the UseAPOP property.
		*m: useapop_assign		&& Assign method used to hold a reference to the UseAPOP property
		*m: usecertvault		&& Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*m: usessh		&& Uses an existing SSH tunnel for the connections to the POP3 andSMTP servers. This method is identical to the UseSshTunnel method, except the SSH connection is obtained from an SSH object instead of a Socket object.
		*m: usesshtunnel		&& Uses an existing SSH tunnel. This is useful for sharing an existing SSH tunnel connection wth other objects.
		*m: verboselogging_access		&& Access method used to retrieve a reference to the VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property
		*m: verifypopconnection		&& Return 1 if a TCP/IP connection can be established with the POP3 server, otherwise returns 0.
		*m: verifypopconnectionasync		&& Creates an asynchronous task to call the VerifyPopConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: verifypoplogin		&& Return 1 if a TCP/IP connection and login is successful with the POP3 server. Otherwise return 0.
		*m: verifypoploginasync		&& Creates an asynchronous task to call the VerifyPopLogin method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: verifyrecips		&& Initiates sending an email, but aborts just after passing all recipients (TO, CC, BCC) to the SMTP server. This allows your program to collect email addresses flagged as invalid by the SMTP server.
		*m: verifyrecipsasync		&& Creates an asynchronous task to call the VerifyRecips method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: verifysmtpconnection		&& Return 1 if a TCP/IP connection can be established with the SMTP server, otherwise returns 0.
		*m: verifysmtpconnectionasync		&& Creates an asynchronous task to call the VerifySMTPConnection method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: verifysmtplogin		&& Return 1 if a TCP/IP connection and login is successful with the SMTP server. Otherwise returns 0.
		*m: verifysmtploginasync		&& Creates an asynchronous task to call the VerifySmtpLogin method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*p: abortcurrent		&& Introduced in version 9.5.0.58. Numeric property when set to 1, causes the currently running method to abort.
		*p: allornone		&& Numeric property that prevents sending any email if any of the addresses in the recipient list are rejected by the SMTP server.
		*p: autofix		&& Numeric property that sets the SmtpSSL or PopSSL properties.
		*p: autogenmessageid		&& Controls whether a unique Message-ID header is auto-generated for each email sent.
		*p: autosmtprset		&& If 1, then the SMTP "RSET" command is automatically sent to ensure that the SMTP connection is in a valid state when a new email is about to be sent on an already established connection. The default value is 0.
		*p: autounwrapsecurity		&& If 1, then digitally signed and/or encrypted email when downloaded from a mail server is automatically "unwrapped" and the results of the signature validation and decryption are available in various email object properties and methods. 
		*p: clientipaddress		&& The IP address to use for computers with multiple network interfaces or IP addresses. For computers with a single network interface (i.e. most computers), this property should not be set.
		*p: connectfailreason		&& This property will be set to the status of the last connection made (or failed to be made) by any method.
		*p: connecttimeout		&& The time (in seconds) to wait before while trying to connect to a mail server (POP3 or SMTP). The default value is 30.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: dsnenvid		&& (An SMTP DSN service extension feature) An arbitrary string that will be used as the ENVID property when sending email. See RFC 3461 for more details.
		*p: dsnnotify		&& A string that will be used as the NOTIFY parameter when sending email. (See RFC 3461 for more details. ) This string can be left blank, or can be set to "NEVER", or any combination of a comma-separated list of "SUCCESS", "FAILURE", or "NOTIFY".
		*p: dsnret		&& A string that will be used as the RET parameter when sending email. (See RFC 3461 for more details. ) This string can be left blank, or can be set to "FULL" to receive entire-message DSN notifications, or "HDRS" to receive header-only DSN notifications
		*p: embedcertchain		&& If 1, causes the digital certificate chain to be embedded in signed emails. The certificates in the chain of authentication are embedded up to but not including the root certificate.
		*p: enablesecrets		&& Introduced in version 11.5.0. This property that automatic resolution of credentials from the operating system’s secure storage. The default value is 0.
		*p: filter		&& An expression that is applied to any of the following method calls when present: LoadXmlFile, LoadXmlString, LoadMbx, CopyMail, and TransferMail.
		*p: heartbeatms		&& The time interval, in milliseconds, between AbortCheck event callbacks. The heartbeat provides a means for an application to monitor a mail-sending and/or mail-reading method call, and to abort it while in progress.
		*p: helohostname		&& Specifies the hostname to be used for the EHLO/HELO command sent to an SMTP server. By default, this property is an empty string which causes the local hostname to be used.
		*p: httpproxyauthmethod		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy authentication method name. Valid choices are "Basic" or "NTLM".
		*p: httpproxydomain		&& The NTLM authentication domain (optional) if NTLM authentication is used.
		*p: httpproxyhostname		&& If an HTTP proxy is to be used, set this property to the HTTP proxy hostname or IPv4 address (in dotted decimal notation).
		*p: httpproxypassword		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy password.
		*p: httpproxyport		&& If an HTTP proxy is to be used, set this property to the HTTP proxy port number. (Two commonly used HTTP proxy ports are 8080 and 3128.)
		*p: httpproxyusername		&& If an HTTP proxy requiring authentication is to be used, set this property to the HTTP proxy login name.
		*p: immediatedelete		&& If 1 (the default) then any method that deletes an email from the POP3 server will also issue a QUIT command to close the session to ensure the message is deleted immediately.
		*p: includerootcert		&& Controls whether the root certificate in the chain of authentication (i.e. the CA root certificate) is included within the S/MIME signature of a signed email. Note: This property only applies if the EmbedCertChain property is also 1.
		*p: ispop3connected		&& Returns 1 if still connected to the POP3 server. Otherwise returns 0.
		*p: issmtpconnected		&& Returns 1 if still connected to the SMTP server. Otherwise returns 0 (if there was never a connection in the first place, or if the connection was lost). Note: Accessing this property does not trigger any communication with the SMTP server.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: lastsendqfilename		&& Undocumented property! The name of the file created in the SMTPQ's queue directory for the last email sent via SendQ, SendQ2, or SendMimeQ.
		*p: lastsmtpstatus		&& Returns the last SMTP diagnostic status code. This can be checked after sending an email. SMTP reply codes are defined by RFC 821 - Simple Mail Transfer Protocol.
		*p: lastsmtpstatusmsg		&& Returns the last SMTP status message associated with the last SMTP status code received. This can be checked after sending an email.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: logmailreceivedfilename		&& A log filename where the MailMan will log each message in the exact form it was received from a POP3 server. This property is provided for help in debugging.
		*p: logmailsentfilename		&& A log filename where the MailMan will log the exact message sent to the SMTP server. This property is helpful in debugging.
		*p: mailhost		&& The domain name of the POP3 server. Do not include "http://" in the domain name. This property may also be set to an IP address string, such as "168.144.70.227". Both IPv4 and IPv6 address formats are supported.
		*p: mailport		&& The port number of the POP3 server. Only needs to be set if the POP3 server is running on a non-standard port. The default value is 110.
		*p: maxcount		&& Limits the number of messages the MailMan will try to retrieve from the POP3 server in a single method call. If you are trying to read a large mailbox, you might set this to a value such as 100 to download 100 emails at a time.
		*p: oauth2accesstoken		&& The OAUTH2 access token if OAUTH2 authentication is to be used for the authentication. For GMail, the Chilkat HTTP class/object's G_SvcOauthAccessToken method can be called to obtain an OAUTH2 access token for a GMail service account.
		*p: opaquesigning		&& When set to 1, signed emails are sent using opaque signing. The default is to send clear-text (multipart/signed) emails.
		*p: p7mencryptattachfilename		&& Introduced in version 9.5.0.30. The filename attribute to be used in the Content-Disposition header field when sending a PCKS7 encrypted email. The default value is "smime.p7m".
		*p: p7msigattachfilename		&& Introduced in version 9.5.0.30. The filename attribute to be used in the Content-Disposition header field when sending a PCKS7 opaque signed email. The default value is "smime.p7m".
		*p: p7ssigattachfilename		&& Introduced in version 9.5.0.30. The filename attribute to be used in the Content-Disposition header field when sending a signed email with a detached PKCS7 signature. The default value is "smime.p7s"
		*p: percentdonescale		&& This property is only valid in programming environment and languages that allow for event callbacks.
		*p: pop3sessionid		&& 0 if no POP3 session is active. Otherwise a positive integer that is incremented with each new POP3 session. It may be used to determine if a new POP3 session has been established.
		*p: pop3sessionlog		&& This string property accumulates the raw commands sent to the POP3 server, and the raw responses received from the POP3 server. This property is read-only, but it may be cleared by calling ClearPop3SessionLog.
		*p: pop3spa		&& Controls whether SPA authentication for POP3 is used or not. To use SPA authentication, set this propoerty = 1. No other programming changes are required. The default value is 0.
		*p: pop3sslservercertverified		&& When connecting via SSL, this property is 1 if the POP3 server's SSL certificate was verified. Otherwise it is set to 0.
		*p: pop3stls		&& If 1, then an unencrypted connection (typically on port 110) is automatically converted to a secure TLS connection via the STLS command (see RFC 2595) when connecting. This should only be used with POP3 servers that support the STLS capability.
		*p: pop3stlsifpossible		&& Introduced in version 9.5.0.92. If 1, then an unencrypted connection (typically on port 110) is automatically converted to a secure TLS connection via the STLS command if the mail server supports the STLS command.
		*p: poppassword		&& The POP3 password. If the Pop3SPA property is set, the PopUsername and PopPassword properties may be set to the string "default" to cause the component to use the current logged-on credentials (of the calling process) for authentication.
		*p: poppasswordbase64		&& Provides a way to specify the POP3 password from a Base64-encoded string.
		*p: popssl		&& Numeric value which controls whether TLS/SSL is used when reading email from a POP3 server.
		*p: popusername		&& The POP3 login name. If the Pop3SPA property is set, the PopUsername and PopPassword properties may be set to the string "default" to cause the component to use the current logged-on credentials (of the calling process) for authentication.
		*p: preferipv6		&& If 1, then use IPv6 over IPv4 when both are supported for a particular domain. The default value of this property is 0, which will choose IPv4 over IPv6.
		*p: readtimeout		&& The maximum time to wait, in seconds, if the POP3 or SMTP server stops responding. The default value is 30 seconds.
		*p: requirehostnamematch		&& Introduced in version 11.6.0. Determines whether the hostname used for the TLS connection must match a name in the server certificate's Subject Alternative Name (SAN) extension. The default value is 0.
		*p: requiresslcertverify		&& If 1, then the mailman will verify the SMTP or POP3 server's SSL certificate when connecting. The certificate is expired, or if the cert's signature is invalid, the connection is not allowed. The default value of this property is 0.
		*p: resetdateonload		&& Controls whether the Date header field is reset to the current date/time when an email is loaded from LoadMbx, LoadEml, LoadMime, LoadXml, or LoadXmlString. The default is 0 (to not reset the date).
		*p: sendbuffersize		&& The buffer size to be used with the underlying TCP/IP socket for sending. The default value is 32767.
		*p: sendindividual		&& Determines how emails are sent to distribution lists. If 1, emails are sent to each recipient in the list one at a time, with the "To"header field containing the email address of the recipient
		*p: sizelimit		&& The MailMan will not try to retrieve mail messages from a POP3 server that are greater than this size limit. The default value is 0 indicating no size limit. The SizeLimit is specified in number of bytes.
		*p: smtpauthmethod		&& This property should usually be left empty. The MailMan will by default choose the most secure login method available to prevent unencrypted username and passwords from being transmitted if possible.
		*p: smtpfailreason		&& A keyword that indicates the cause of failure (or success) for the last SMTP related method called.
		*p: smtphost		&& The domain name of the SMTP server. Do not include "http://" in the domain name. This property may also be set to an IP address string, such as "168.144.70.227". Both IPv4 and IPv6 address formats are supported.
		*p: smtplogindomain		&& The Windows domain for logging into the SMTP server. Use this only if your SMTP server requires NTLM authentication, which means your SMTP server uses Integrated Windows Authentication. If there is no domain, this can be left empty.
		*p: smtpmailfrom		&& Introduced in version 11.0.0. This is the email address passed in the MAIL FROM command in the SMTP protocol.
		*p: smtppassword		&& The password for logging into the SMTP server. Use this only if your SMTP server requires authentication. Chilkat Email.NET supports the LOGIN, PLAIN, CRAM-MD5, and NTLM login methods, and it will automatically choose the most secure method available.
		*p: smtppipelining		&& Controls whether SMTP pipelining is automatically used when the SMTP server indicates support for it. The default is 1. Setting this property equal to 0 will prevent the SMTP pipelining feature from being used.
		*p: smtpport		&& The port number of the SMTP server used to send email. Only needs to be set if the SMTP server is running on a non-standard port. The default value is 25. If SmtpSsl is set to 1, this property should be set to 465.
		*p: smtpsessionlog		&& This string property accumulates the raw commands sent to the SMTP server, and the raw responses received from the SMTP server. This property is read-only, but it may be cleared by calling ClearSmtpSessionLog.
		*p: smtpssl		&& When set to 1, causes the mailman to connect to the SMPT server via the TLS/SSL protocol.
		*p: smtpsslservercertverified		&& If using SSL, this property will be set to 1 if the SMTP server's SSL certificate was verified when establishing the connection. Otherwise it is set to 0.
		*p: smtpusername		&& The login for logging into the SMTP server. Use this only if your SMTP server requires authentication.
		*p: snihostname		&& Introduced in version 11.6.0. Specifies the DNS hostname sent in the Server Name Indication (SNI) extension of the TLS handshake for SMTP and POP3 connections. The default value is the empty string.
		*p: sockshostname		&& The SOCKS4/SOCKS5 hostname or IPv4 address (in dotted decimal notation). This property is only used if the SocksVersion property is set to 4 or 5).
		*p: sockspassword		&& The SOCKS5 password (if required). The SOCKS4 protocol does not include the use of a password, so this does not apply to SOCKS4.
		*p: socksport		&& The SOCKS4/SOCKS5 proxy port. The default value is 1080. This property only applies if a SOCKS proxy is used (if the SocksVersion property is set to 4 or 5).
		*p: socksusername		&& The SOCKS4/SOCKS5 proxy username. This property is only used if the SocksVersion property is set to 4 or 5).
		*p: socksversion		&& May be set to one of the following integer values: 0 - No SOCKS proxy is used. This is the default. 4 - Connect via a SOCKS4 proxy. 5 - Connect via a SOCKS5 proxy.
		*p: sorcvbuf		&& Sets the receive buffer size socket option. Normally, this property should be left unchanged. The default value is 4194304. This property can be increased if download performance seems slow. It is recommended to be a multiple of 4096.
		*p: sosndbuf		&& Sets the send buffer size socket option. Normally, this property should be left unchanged. The default value is 262144. This property can be increased if upload performance seems slow. It is recommended to be a multiple of 4096.
		*p: sslallowedciphers		&& Introduced in version 9.5.0.48. Provides a means for setting a list of ciphers that are allowed for SSL/TLS connections. The default (empty string) indicates that all implemented ciphers are possible.
		*p: sslprotocol		&& Introduced in version 9.5.0.46. Selects the secure protocol to be used for secure (SSL/TLS) connections (for both SMTP and POP3).
		*p: starttls		&& When set to 1, causes the mailman to issue a STARTTLS command to switch over to a secure SSL/TLS connection prior to authenticating and sending email. The default value is 0.
		*p: starttlsifpossible		&& When set to 1, causes the mailman to do STARTTLS (if possible and supported by the server) to convert to a secure SSL/TLS connection prior to authenticating and sending email. The default value is 1.
		*p: tlsciphersuite		&& Contains the current or last negotiated TLS cipher suite. If no TLS connection has yet to be established, or if a connection as attempted and failed, then this will be empty.
		*p: tlspinset		&& Specifies a set of pins for Public Key Pinning for TLS connections. This property lists the expected SPKI fingerprints for the server certificates.
		*p: tlsversion		&& Contains the current or last negotiated TLS protocol version. If no TLS connection has yet to be established, or if a connection as attempted and failed, then this will be empty.
		*p: uncommonoptions		&& This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: useapop		&& If 1, will automatically use APOP authentication if the POP3 server supports it. The default value of this property is 0.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		allornone = 0
		autofix = 1
		autogenmessageid = 0
		autosmtprset = 0
		autounwrapsecurity = 1
		cchilkatclass = MailMan
		ceventhandlerclass = iMailManEventHandler
		clientipaddress = 
