	PROCEDURE sshopentunnel		&& Introduced in version 9.5.0.50. Connects to an SSH server and creates a tunnel for port forwarding. The sshHostname is the hostname (or IP address) of the SSH server. The sshPort is typically 22, which is the standard SSH port number.
		*==============================================================================
		* Method:            SSHOpenTunnel
		* Purpose:           Connects to an SSH server and creates a tunnel for port forwarding.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSSHHostName -- the SSH Login name.
		*                    tiPort -- the SSH Password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/31/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		**
		** Connects to an SSH server and creates a tunnel for port forwarding. 
		** The sshHostname is the hostname (or IP address) of the SSH server. 
		** The sshPort is typically 22, which is the standard SSH port number.
		**
		** An SSH tunneling (port forwarding) session always begins 
		** by first calling SshOpenTunnel to connect to the SSH server, 
		** followed by calling either SshAuthenticatePw or SshAuthenticatePk to authenticate. 
		** A program would then call SshOpenChannel to connect to the destination server (via the SSH tunnel). 
		** Any number of channels can be opened over the same SSH tunnel.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSSHHostName AS Character, tiPort AS String
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 50
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SSHOpenTunnel(m.tcSSHHostName, m.tiPort) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

