	PROCEDURE sendreqx11forwarding		&& Allows the client to send an X11 forwarding request to the server. Chilkat only provides this functionality because it is a message defined in the SSH connection protocol. Chilkat has no advice for when or why it would be needed.
		*==============================================================================
		* Method:            SendReqX11Forwarding
		* Purpose:           Allows the client to send an X11 forwarding request to the server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		*                    tuSingleConnection, single/multiple connections
		*                    tcAuthorizationProtocol, the X11 protocol
		*                    tcAuthorizationCookie, an X11 cookie sent to machine
		*                    tiScreenNumbr, the screen number to send information
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Allows the client to send an X11 forwarding request to the server. 
		** Chilkat only provides this functionality because it is a message 
		** defined in the SSH connection protocol. 
		** Chilkat has no advice for when or why it would be needed.
		**
		
		LPARAMETERS tiChannel AS Integer, tuSingleConnection AS Unknown, ;
		tcAuthorizationProtocol AS Character, tcAuthorizationCookie AS Character, ;
		tiScreenNumber AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liSingleConnection AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liSingleConnection
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		 
		    liSingleConnection = .LogicalToBit(m.tuSingleConnection)
		
		    TRY
		
		      STORE m.loChilkatObject.SendReqX11Forwarding(m.tiChannel, m.liSingleConnection, ;
		      m.tcAuthorizationProtocol, m.tcAuthorizationCookie, m.tiScreenNumber) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

