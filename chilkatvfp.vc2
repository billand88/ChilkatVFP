	PROCEDURE getfileowner		&& Returns the owner of a file. pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0.
		*==============================================================================
		* Method:            GetFileOwner
		* Purpose:           Returns the owner of a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathOrHandle -- the file path or handle to file
		*                    tuFollowLinks, whether or not server symbolic links are followed.
		*                    tuIsHandle, whether or not the first parameter is a handle.
		* Returns:           The file owner
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Returns the owner of a file. 
		** pathOrHandle may be a remote filepath or an open handle string as returned by OpenFile. 
		** If pathOrHandle is a handle, then bIsHandle must be set to 1, otherwise it should be 0. 
		** If bFollowLinks is 1, then symbolic links will be followed on the server.
		**
		** Note: Servers running the SFTP v3 protocol or lower do not have the ability 
		** to return a file's owner name. Instead, the decimal UID of the file is returned.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcPathOrHandle AS Character, ;
		tuFollowLinks AS Unknown, tuIsHandle AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		lcOwner AS Character, liFollowLinks AS Integer, liIsHandle AS Integer
		
		STORE 0 TO m.liFollowLinks, m.liIsHandle
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcOwner = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liFollowLinks = .LogicalToBit(m.tuFollowLinks)
		    liIsHandle = .LogicalToBit(m.tuIsHandle)
		
		    TRY
		
		      lcOwner = ;
		      m.loChilkatObject.GetFileOwner(m.tcPathOrHandle, m.liFollowLinks, m.liIsHandle)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcOwner
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

