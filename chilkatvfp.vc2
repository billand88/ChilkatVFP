	HIDDEN PROCEDURE deflatelevel_access		&& Access method used to retrieve the Chilkat Compression DeflateLevel property.
		*==============================================================================
		* Method:            DeflateLevel_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Compression DeflateLevel property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DeflateLevel
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.73
		** 
		** This property allows for customization of the compression level 
		** for the "deflate" and "zlib" compression algoirthms. 
		** ("zlib" is just the deflate algorithm with a zlib header.) 
		** A value of 0 = no compression, while 9 = maximum compression. The default is 6.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 73
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE deflatelevel_assign		&& Assign method used to hold a reference to the DeflateLevel property.
		*==============================================================================
		* Method:            DeflateLevel_Assign
		* Purpose:           Assign method used to hold a reference to the DeflateLevel property.
		* Author:            Bill Anderson
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the DeflateLevel property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 73
		
		lcValidationMethod = [DeflateLevel]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE encodingmode_access		&& Access method used to retrieve the Chilkat Compression EncodingMode property.
		*==============================================================================
		* Method:            EncodingMode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Compression EncodingMode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EncodingMode
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** Controls the encoding expected by methods ending in "ENC", such as CompressBytesENC. 
		** Valid values are "base64", "hex", "url", and "quoted-printable". 
		** Compression methods ending in ENC return the binary compressed data 
		** as an encoded string using this encoding. Decompress methods 
		** expect the input string to be this encoding.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE encodingmode_assign		&& Assign method used to hold a reference to the EncodingMode property.
		*==============================================================================
		* Method:            EncodingMode_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Compression EncodingMode property.
		* Author:            Bill Anderson
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the EncodingMode property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [EncodingMode_Compression]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE endcompressbytes		&& Must be callled to finalize a compression stream. Returns any remaining (buffered) compressed data. (See BeginCompressBytes) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
		* Method:            EndCompressBytes
		* Purpose:           Must be callled to finalize a compression stream.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Compressed binary data.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Must be callled to finalize a compression stream. 
		** Returns any remaining (buffered) compressed data.
		** 
		** (See BeginCompressBytes)
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, lqCompressedData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqCompressedData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqCompressedData = m.loChilkatObject.EndCompressBytes()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqCompressedData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

