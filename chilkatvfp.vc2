	PROCEDURE sort		&& Sorts the strings in the collection in ascending or descending order. To sort in ascending order, set ascending to 1, otherwise set ascending equal to 0.
		*==============================================================================
		* Method:            Sort
		* Purpose:           Sorts the strings in the collection in ascending or descending order.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuAscending, whether or not to sort in ascending order.
		* Returns:           
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Sorts the strings in the collection in ascending or descending order. 
		** To sort in ascending order, set ascending to 1, otherwise set ascending equal to 0.
		**
		
		LPARAMETERS tuAscending AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, liAscending AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liAscending = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liAscending = .LogicalToBit(m.tuAscending)
		
		    TRY
		
		      m.loChilkatObject.Sort(m.liAscending)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

