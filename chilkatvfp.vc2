	PROCEDURE downloadtree		&& Downloads an entire tree from the FTP server and recreates the directory tree on the local filesystem. This method downloads all the files and subdirectories in the current remote directory
		*==============================================================================
		* Method:            DownloadTree
		* Purpose:           Downloads an entire tree from the FTP server 
		*                    and recreates the directory tree on the local filesystem.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalRoot -- the remote root directory.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/01/2022
		*==============================================================================
		
		**
		** Downloads an entire tree from the FTP server 
		** and recreates the directory tree on the local filesystem.
		** 
		** This method downloads all the files and subdirectories in the current remote directory. 
		** An application would first navigate to the directory to be downloaded 
		** via ChangeRemoteDir and then call this method.
		**
		** Note: Starting in version 9.5.0.47, the SyncMustMatch and SyncMustNotMatch properties 
		** apply to this method.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcLocalRoot AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DownloadTree(m.tcLocalRoot) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

