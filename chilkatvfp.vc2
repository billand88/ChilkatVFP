	PROCEDURE downloadfile		&& Introduced in version 9.5.0.51. Downloads a file from the remote SSH server to the local filesystem. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DownloadFile
		* Purpose:           Downloads a file from the remote SSH server to the local filesystem.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePath, the path to the remote file.
		*                    tcLocalPath, the path to the locally downloaded file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		**
		** Downloads a file from the remote SSH server to the local filesystem.
		**
		** Fixed for Version 58: This method did not close the channel.
		**
		** Fixed for Version 77: This method did not succeed if the remote filename contained a SPACE char.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcRemotePath AS Character, tcLocalPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCP_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 51
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.DownloadFile(m.tcRemotePath, m.tcLocalPath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
