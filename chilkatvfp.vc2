	PROCEDURE setownerandgroup		&& Sets the owner and group for a file on the server. The pathOrHandle may be a filepath or the handle of a currently open file. isHandle should be set to 1 if the pathOrHandle is a handle, otherwise set isHandle to 0.
		*==============================================================================
		* Method:            SetOwnerAndGroup
		* Purpose:           Sets the owner and group for a file on the server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathOrHandle -- the path or handle to the file.
		*                    tuIsHandle -- determines whether or not the first 
		*                    parameter is a path or a handle to a file
		*                    tcOwner, the owner of the file.
		*                    tcGroup, the group for the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Sets the owner and group for a file on the server. 
		** The pathOrHandle may be a filepath or the handle of a currently open file. 
		** isHandle should be set to 1 if the pathOrHandle is a handle, 
		** otherwise set isHandle to 0.
		** 
		** Note: Servers running version 3 or lower of the SFTP protocol 
		** do not support setting the owner and group.
		**
		** Fixed for version 92: Updated the method to correctly 
		** handle decimal string owner/group values for SFTP v3 servers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPathOrHandle AS Character, tuIsHandle AS Unknown, ;
		tcOwner AS Character, tcGroup AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIsHandle AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIsHandle
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liIsHandle = .LogicalToBit(m.tuIsHandle)
		
		    TRY
		
		      STORE m.loChilkatObject.SetOwnerAndGroup(m.tcPathOrHandle, ;
		      m.liIsHandle, m.tcOwner, m.tcGroup) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

