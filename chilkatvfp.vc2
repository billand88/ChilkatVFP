		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addsigningcert		&& Introduced in version 9.5.0.83. Adds a certificate to be used for signing. To sign with more than one certificate, call AddSigningCert once per certificate. Note: This method was added in v9.5.0.83.
		*==============================================================================
		* Method:            AddSigningCert
		* Purpose:           Adds a certificate to be used for signing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Adds a certificate to be used for signing. 
		** To sign with more than one certificate, call AddSigningCert once per certificate.
		** 
		** Note: This method was added in v9.5.0.83. 
		** The SetSigningCert and SetSigningCert2 methods are used 
		** to set the signing certificate for signatures with one signer.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert 
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddSigningCert(m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE aeskeyunwrap		&& Introduced in version 9.5.0.66. Implements the AES Key Wrap Algorithm (RFC 3394) for unwrapping. The kek is the Key Encryption Key (the AES key used to unwrap the wrappedKeyData).
		*==============================================================================
		* Method:            AESKeyUnwrap
		* Purpose:           Implements the AES Key Wrap Algorithm (RFC 3394) for unwrapping.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyEncryptionKey -- The kek, or Key Encryption Key
		*                    tcWrappedKeyData -- the key data to unwrap
		*                    tcEncoding -- the string encoding.
		* Returns:           The unwrapped data. 
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Implements the AES Key Wrap Algorithm (RFC 3394) for unwrapping. 
		** The kek is the Key Encryption Key (the AES key used to unwrap the wrappedKeyData). 
		** The arguments and return value are binary encoded strings 
		** using the encoding specified by encoding 
		** (which can be "base64", "hex", "base64url", etc.) 
		** The full list of supported encodings is available at the link below.
		** 
		** The kek should be an AES key of 16 bytes, 24 bytes, or 32 bytes 
		** (i.e. 128-bits, 192- bits, or 256-bits). For example, if passed as a hex string, 
		** then the kek should be 32 chars in length, 48 chars, 
		** or 64 chars (because each byte is represented as 2 chars in hex).
		** 
		** The wrappedKeyData contains the data to be unwrapped. 
		** The result, if decoded, is 8 bytes less than the wrapped key data. 
		** For example, if a 256-bit AES key (32 bytes) is wrapped, 
		** the size of the wrapped key data is 40 bytes. 
		** Unwrapping restores it to the original 32 bytes.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Fixed in version 99: The AesKeyUnwrap method was not unpadding the result. 
		** This caused the returned value to include the 8-byte padding.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcKeyEncryptionKey AS Character, ;
		tcWrappedKeyData AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcUnWrappedData AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcUnWrappedData = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcUnWrappedData = m.loChilkatObject.AESKeyUnwrap(;
		        m.tcKeyEncryptionKey, m.tcWrappedKeyData, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcUnWrappedData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE aeskeyunwrapwithpadding		&& Introduced in version 9.5.0.96. Implements the AES Key Wrap with Padding Algorithm (RFC 5649) for unwrapping. The kek is the Key Encryption Key (the AES key used to unwrap the wrappedKeyData).
		*==============================================================================
		* Method:            AESKeyUnwrapWithPadding
		* Purpose:           Implements the AES Key Wrap with Padding Algorithm (RFC 5649) for unwrapping.
		* Author:            Bill Anderson
