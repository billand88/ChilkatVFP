		  loParkParameterDtObj = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatDtObj = NEWOBJECT(CHILKAT_DTOBJ_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
