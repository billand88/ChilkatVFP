	PROCEDURE runstream		&& Introduced in version 9.5.0.56. Runs the stream to completion.
		*==============================================================================
		* Method:            RunStream
		* Purpose:           Runs the stream to completion.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/14/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Runs the stream to completion. This method should only be called 
		** when the source of the string has been set by any of the following methods: 
		** SetSourceBytes, SetSourceString, or SetSourceStream, 
		** or when the SourceFile property has been set (giving the stream a file source).
		** 
		** This method will read the stream source and forward to the sink 
		** until the end-of-stream is reached, and all data has been written to the sink.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		** Note: For version 98 this method is decremented 
		** and temporarily stubbed out to do nothing. 
		**
		
		LOCAL loChilkatObject AS CHILKAT_STREAM_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.RunStream() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

