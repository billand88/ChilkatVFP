	HIDDEN PROCEDURE level_access		&& Access method used to retrieve the Chilkat Cache Level property.
		*==============================================================================
		* Method:            Level_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cache Level property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Level
		* Date Added:        06/28/2022
		*==============================================================================
		
		**
		** The number of directory levels in the cache. Possible values are:
		** 
		** 0: All cache files are in a single directory (the cache root).
		** 
		** 1: Cache files are located in 256 sub-directories 
		**    numbered 0 .. 255 directly under the cache root.
		** 
		** 2: There are two levels of sub-directories under the cache root. 
		**    The 1st level has 256 sub-directories numbered 0 .. 255 directly under the cache root. 
		**    The 2nd level allows for up to 256 sub-directories (0..255) under each level-1 directory. 
		**    Cache files are stored in the leaf directories.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE level_assign		&& Assign method used to hold a reference to the Level property.
		*==============================================================================
		* Method:            Level_Assign
		* Purpose:           Assign method used to hold a reference to the Level property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the Level property.
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Level]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

