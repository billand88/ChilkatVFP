	PROCEDURE autofixsettings		&& Method to run after a connection is made to the server and the AutoFix property is set to 1.
		*==============================================================================
		* Method:            AutoFixSettings
		* Purpose:           Method to run after a connection is made to the server 
		*                    and the AutoFix property is set to 1.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:          
		* Date Added:        06/23/2022
		* Note:              Not a native Chilkat method.
		*==============================================================================
		
		LOCAL liReturn AS Integer, luReturn AS Unknown, liPort AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liPort
		
		WITH THIS
		
		  luReturn = .AutoFix
		  liReturn = .LogicalToBit(m.luReturn)
		
		  ** AutoFix On test
		  IF m.liReturn = 1
		
		    liPort = .Port
		
		    ** Mail Port processing branch
		    DO CASE
		
		      ** Port = 993 test
		      CASE m.liPort = 993
		
		        .StartTLS = 0
		        .SSL = 1
		
		      ** Port = 143 test
		      CASE m.liPort = 143 
		
		        .SSL = 0
		
		    ENDCASE
		    ** End mail Port processing branch
		
		  ENDIF m.liReturn = 1
		  ** End AutoFix On test
		
		ENDWITH
		
		RETURN
		
	ENDPROC

	HIDDEN PROCEDURE autofix_access		&& Access method used to retrieve the Chilkat IMAP AutoFix property.
		*==============================================================================
		* Method:            AutoFix_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP AutoFix property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoFix
		* Date Added:        06/15/2022
		*==============================================================================
		
		** If 1, then the following will occur when a connection is made to an IMAP server:
		** 
		** 1) If the Port property = 993, then sets StartTls = 0 and Ssl = 1
		** 2) If the Port property = 143, sets Ssl = 0
		** 
		** The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

