		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Compresses a string to an in-memory image of a .Z file. 
		** Prior to compression, the string is converted 
		** to the character encoding specified by charset. 
		** The charset can be any one of a large number of character encodings, 
		** such as "utf-8", "iso-8859-1", "Windows-1252", "ucs-2", etc.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcString AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_UNIXCOMPRESS_COM_CALL, ;
		loException AS Exception, lqInMemoryImage AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqInMemoryImage
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqInMemoryImage = ;
		      m.loChilkatObject.CompressString(m.tcString, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqInMemoryImage
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UNIXCOMPRESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

