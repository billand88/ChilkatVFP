		liProgressInfo = m.tiProgressInfo 
		liAbort = m.tiAbort 
		
		RETURN
		
	ENDPROC

	PROCEDURE progressinfo_pre		&& Template ProgressInfo pre-processing method.
		*==============================================================================
		* Method:            ProgressInfo_Pre
		* Purpose:           Template ProgressInfo pre-processing method. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
