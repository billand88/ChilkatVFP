	PROCEDURE determineproxymethod		&& Automatically determines the ProxyMethod that should be used with an FTP proxy server. Tries each of the five possible ProxyMethod settings and returns the value (1-5) of the ProxyMethod that succeeded.
		*==============================================================================
		* Method:            DetermineProxyMethod
		* Purpose:           Automatically determines the ProxyMethod 
		*                    that should be used with an FTP proxy server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePattern -- the remote directory pattern.
		* Returns:           Integer
		* Date Added:        03/01/2022
		*==============================================================================
		
		**
		** Automatically determines the ProxyMethod that should be used with an FTP proxy server. 
		** Tries each of the five possible ProxyMethod settings and returns the value 
		** (1-5) of the ProxyMethod that succeeded.
		**
		** This method may take a minute or two to complete. 
		** Returns 0 if no proxy methods were successful. 
		** Returns -1 to indicate an error (i.e. it was unable to test all proxy methods.)
		**
		** Update to Version 11.6.0: Method decremented.
		**
		
		LPARAMETERS tcRemotePattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liReturn = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liReturn = m.loChilkatObject.DetermineProxyMethod(m.tcRemotePattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

