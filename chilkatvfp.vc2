	PROCEDURE startkeyboardauth		&& Introduced in version 9.5.0.78. Begins keyboard-interactive authentication with the SSH server. Returns an XML string providing the name, instruction, and prompts.
		*==============================================================================
		* Method:            StartKeyboardAuth
		* Purpose:           Begins keyboard-interactive authentication with the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLogin -- the login name.
		* Returns:           Character, in XML format.
		* Date Added:        07/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.78
		** 
		** Begins keyboard-interactive authentication with the SSH server. 
		** Returns an XML string providing the name, instruction, and prompts. 
		** The XML has the following format:
		** 
		**    <infoRequest numPrompts="N">
		**       <name>name_string</name>
		**       <instruction>instruction_string</instruction>
		**       <prompt1 echo="1_or_0">prompt_string</prompt1>
		**       ...
		**       <promptN echo="1_or_0">prompt_string</promptN>
		**   </infoRequest>
		** 
		** If the authentication immediately succeeds because no password is required, 
		** or immediately fails, the XML response can be:
		** 
		**   <success>success_message</success>
		** 
		** or
		** 
		**   <error>error_message</error>
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLogin AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHTUNNEL_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		llImplemented = .F.
		liIntroducedInBuild = 78
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcXML = m.loChilkatObject.StartKeyboardAuth(m.tcLogin)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE startkeyboardauthasync		&& Introduced in version 9.5.0.78. Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            StartKeyboardAuthAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    StartKeyboardAuth method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLogin -- the login name.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.78
		**
		** Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLogin AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHTUNNEL_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 78
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.StartKeyboardAuthAsync(m.tcLogin)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE stopaccepting		&& Stops the listen background thread. It is possible to continue accepting connections by re-calling BeginAccepting. If waitForThread is 1, the method will wait for the listen thread to exit before returning.
		*==============================================================================
		* Method:            StopAccepting
		* Purpose:           Stops the listen background thread.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuWaitForAllThreadExits, whether or not to wait
		*                    for all threads to exit before closing.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/08/2022
		*==============================================================================
		
		**
		** Stops the listen background thread. It is possible to continue 
		** accepting connections by re-calling BeginAccepting. 
		** If waitForThread is 1, the method will wait for the listen thread 
		** to exit before returning.
		**  
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuWaitForAllThreadExits AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SSHTUNNEL_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liWaitForAllThreadExits AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liWaitForAllThreadExits
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liWaitForAllThreadExits = .LogicalToBit(m.tuWaitForAllThreadExits)
		
		    TRY
		
		      STORE m.loChilkatObject.StopAccepting(m.liWaitForAllThreadExits) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE tcpnodelay_access		&& Access method used to retrieve the Chilkat SSHTunnel TCPNoDelay property.
		*==============================================================================
		* Method:            TCPNoDelay_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSHTunnel TCPNoDelay property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.TCPNoDelay
		* Date Added:        07/07/2022
		*==============================================================================
		
		**
		** Controls whether the TCP_NODELAY socket option is used 
		** for the underlying TCP/IP socket. The default value is 0. 
		** Setting this property equal to 1 disables the Nagle algorithm 
		** and allows for better performance when small amounts of data are sent.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

