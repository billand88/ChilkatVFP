	PROCEDURE leavecontext		&& Introduced in version 9.5.0.44. Leaves the current context. A context that is entered and exited without any logging within the context is automatically removed from the log.
		*==============================================================================
		* Method:            LeaveContext
		* Purpose:           Leaves the current context. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Leaves the current context. A context that is entered and exited 
		** without any logging within the context is automatically removed from the log. 
		** (To say it another way: Empty contexts 
		** are automaticallly removed from the log upon leaving the context.)
		**
		
		LOCAL loChilkatObject AS CHILKAT_LOG_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.LeaveContext()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_LOG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE logdata		&& Introduced in version 9.5.0.44. Adds a tagged message to the log (i.e. a name/value pair).
		*==============================================================================
		* Method:            LogData
		* Purpose:           Adds a tagged message to the log (i.e. a name/value pair).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTag, the context tag.
		*                    tcMessage, the tagged message to log.
		* Returns:           
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Adds a tagged message to the log (i.e. a name/value pair).
		**
		
		LPARAMETERS tcTag AS Character, tcMessage AS Character
		
		LOCAL loChilkatObject AS CHILKAT_LOG_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
