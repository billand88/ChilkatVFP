	PROCEDURE getmaxuncompressedsize		&& Introduced in version 9.5.0.96. Returns the size of the file contained within the Zip that has the largest uncompressed size.
		*==============================================================================
		* Method:            GetMaxUncompressedSize
		* Purpose:           Returns the size of the file contained within the Zip 
		*                    that has the largest uncompressed size.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Character version of 32-bit unsigned integer
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Returns the size of the file contained within the Zip that has the largest uncompressed size. 
		** The size is returned in string form because it could be larger 
		** than what can be held in a 32-bit unsigned integer, and we leave it to the application 
		** to convert the string to an integer number. 
		** (If necessary. Perhaps your application is only interested in the order of magnitude, 
		** which can be known by the length of the string.)
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, liIntroducedinBuild AS Integer, ;
		loException AS Exception, lcMaxSize AS Character, llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcMaxSize = []
		llImplemented = .F.
		liIntroducedinBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcMaxSize = m.loChilkatObject.GetMaxUncompressedSize()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcMaxSize
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE haszipformaterrors_access		&& Access method used to retrieve the Chilkat ZIP HasZIPFormatErrors property.
		*==============================================================================
		* Method:            HasZIPFormatErrors_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP HasZIPFormatErrors property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HasZIPFormatErrors
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** 1 if the opened zip contained file format errors 
		** (that were not severe enough to prevent the zip from being opened and parsed).
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE haszipformaterrors_assign		&& Assign method used to hold a reference to the HasZIPFormatErrors property.
		*==============================================================================
		* Method:            HasZIPFormatErrors_Assign
		* Purpose:           Assign method used to hold a reference to the HasZIPFormatErrors property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the HasZIPFormatErrors property.
		* Returns:           
		* Date Added:        04/29/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat ZIP HeartBeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP HeartbeatMs property.
		* Author:            Bill Anderson
