	PROCEDURE unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE unpackdirect_access		&& Access method used to retrieve the Chilkat MHT UnpackDirect property.
		*==============================================================================
		* Method:            UnpackDirect_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MHT UnpackDirect property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnpackDirect
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.47
		**
		** If 1, then the UnpackMHT and UnpackMHTString methods will unpack the MHT directly 
		** with no transformations. Normally, the related parts are unpacked 
		** to a "parts" sub-directory, and the unpacked HTML is edited to update references 
		** to point to the unpacked image and script files. When unpacking direct, 
		** the HTML is not edited, and the related parts are unpacked to sub-directories 
		** rooted in the directory where HTML file is created (i.e. the unpack directory). 
		** When unpacking direct, the "partsSubDir" argument of the UnpackMHT* methods is unused.
		** 
		** Note: It is only possible to directly unpack MHT files 
		** where the Content-Location headers DO NOT contain URLs. 
		** The MHT must be such that the Content-Location headers of the related items 
		** contain relative paths.
		** 
		** Note: The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 47
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE unpackdirect_assign		&& Assign method used to hold a reference to the MHT UnpackDirect property.
		*==============================================================================
		* Method:            UnpackDirect_Assign
		* Purpose:           Assign method used to hold a reference to the UnpackDirect property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the UnpackDirect property.
		* Returns:           
		* Date Added:        07/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 47
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE unpackmht		&& Unpacks the contents of a MHT file. The destination directory is specified by unpackDir.
		*==============================================================================
		* Method:            UnpackMHT
		* Purpose:           Unpacks the contents of a MHT file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName, the file name to unpack.
		*                    tcUnpackDirectory, the directory for the unpacked MHT.
		*                    tcHTMLFileName, the HTML file to be created.
		*                    tcPartsSubDirectory, the subdirectory to place the HTML parts.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Unpacks the contents of a MHT file. The destination directory is specified by unpackDir. 
		** The name of the HTML file created is specified by htmlFilename, 
		** and supporting files (images, javascripts, etc.) are created in partsSubDir, 
		** which is automatically created if it does not already exist.
		**
		** Fixed for Version 49: UnpackUseRelPaths (the second parameter) was ignored.
		**
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFileName AS Character, tcUnpackDirectory AS Character, ;
		tcHTMLFileName AS Character, tcPartsSubDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.UnpackMHT(m.tcFileName, m.tcUnpackDirectory, ;
		      m.tcHTMLFileName, m.tcPartsSubDirectory) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE unpackmhtstring		&& Same as UnpackMHT, except the MHT is passed in as an in-memory string. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UnpackMHTString
		* Purpose:           Same as UnpackMHT, except the MHT is passed in as an in-memory string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMHTString, the HMT string to unpack.
		*                    tcUnpackDirectory, the directory for the unpacked MHT.
		*                    tcHTMLFileName, the HTML file to be created.
		*                    tcPartsSubDirectory, the subdirectory to place the HTML parts.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Same as UnpackMHT, except the MHT is passed in as an in-memory string.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMHTString AS Character, tcUnpackDirectory AS Character, ;
		tcHTMLFileName AS Character, tcPartsSubDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.UnpackMHTString(m.tcMHTString, m.tcUnpackDirectory, ;
		      m.tcHTMLFileName, m.tcPartsSubDirectory) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE unpackuserelpaths_access		&& Access method used to retrieve the Chilkat MHT UnpackUseRelPaths property.
		*==============================================================================
		* Method:            UnpackUserRelPaths_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MHT UnpackUserRelPaths property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnpackUserRelPaths
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Controls whether absolute or relative paths are used when referencing images 
		** in the unpacked HTML. The default value is 1 indicating 
		** that relative paths will be used. To use absolute paths, 
		** set this property value equal to 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

