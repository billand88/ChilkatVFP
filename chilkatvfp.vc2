	PROCEDURE sendcontrol		&& Introduced in version 9.50.87. Sends a command directly to the IFD Handler (reader driver) to be processed by the reader.
		*==============================================================================
		* Method:            SendControl
		* Purpose:           Sends a command directly to the IFD Handler 
		*                    (reader driver) to be processed by the reader.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiControlCode, the control code to send.
		*                    toChilkatBinDataSend, a Chilkat Binary Data object.
		*                    toChilkatBinDataReceived, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Sends a command directly to the IFD Handler (reader driver) to be processed by the reader.
		** 
		** This is useful for creating client side reader drivers 
		** for functions like PIN pads, biometrics, or other extensions 
		** to the normal smart card reader that are not normally handled by PC/SC.
		** 
		** The command data is sent in bdSend. The response is written to bdRecv.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiControlCode AS Integer, ;
		toChilkatBinDataSend AS CHILKAT_BINDATA_COM_CALL, ;
		toChilkatBinDataReceived AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterBinDataSend AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataSend AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown, ;
		loParkParameterBinDataReceived AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataReceived AS CHILKAT_BINDATA_COM_CALL, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataSend, m.loChilkatBinDataSend, ;
		m.loParkParameterBinDataReceived, m.loChilkatBinDataReceived
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinDataSend = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataSend)
		
		      loParkParameterBinDataReceived = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataReceived)
		
		      loChilkatBinDataSend = m.loParkParameterBinDataSend.GetObject()
		      loChilkatBinDataReceived = m.loParkParameterBinDataReceived.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SendControl(m.tiControlCode, ;
		        m.loChilkatBinDataSend, m.loChilkatBinDataReceived) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinDataSend = m.loParkParameterBinDataSend.SetObject(;
		      m.toChilkatBinDataSend, m.loChilkatBinDataSend)
		
		      toChilkatBinDataReceived = m.loParkParameterBinDataReceived.SetObject(;
		      m.toChilkatBinDataReceived, m.loChilkatBinDataReceived)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataSend, m.loChilkatBinDataSend, ;
		m.loParkParameterBinDataReceived, m.loChilkatBinDataReceived
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  toChilkatBinDataSend = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatBinDataReceived = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinDataSend = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinDataReceived = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinDataSend = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatBinDataReceived = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendcontrolhex		&& Introduced in version 9.50.87. Sends a command directly to the IFD Handler (reader driver) to be processed by the reader.
		*==============================================================================
		* Method:            SendControlHex
		* Purpose:           Sends a command directly to the IFD Handler 
		*                    (reader driver) to be processed by the reader.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiControlCode, the control code to send.
		*                    tcSendData, the command data to send.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Sends a command directly to the IFD Handler (reader driver) to be processed by the reader.
		** 
		** This is useful for creating client side reader drivers for functions 
		** like PIN pads, biometrics, or other extensions 
		** to the normal smart card reader that are not normally handled by PC/SC.
		** 
		** The command data is provided as a hex string in sendData. The response is written to bdRecv.
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiControlCode AS Integer, tcSendData AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SendControlHex(m.tiControlCode, ;
		        m.tcSendData, m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE transmit		&& Introduced in version 9.50.87. Sends an APDU to the smart card contained in the currently connected reader. The protocol can be "T0", "T1", or "raw". The APDU to be sent is contained in bdSend.  The response from the card is contained in bdRecv.
		*==============================================================================
		* Method:            Transmit
		* Purpose:           Sends an APDU to the smart card contained in the currently connected reader.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcProtocol, the control code to send.
		*                    toChilkatBinDataSend, a Chilkat Binary Data object.
		*                    toChilkatBinDataRecvd, a Chilkat Binary Data object.
		*                    tiMaximumBytesToReceive, the maximum number of bytes to receive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Sends an APDU to the smart card contained in the currently connected reader. 
		** The protocol can be "T0", "T1", or "raw". The APDU to be sent is contained in bdSend. 
		** The response from the card is contained in bdRecv. 
		** The maxRecvLen is the maximum response size (in bytes) willing to be accepted.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcProtocol AS Character, ;
		toChilkatBinDataSend AS CHILKAT_BINDATA_COM_CALL, ;
		toChilkatBinDataReceived AS CHILKAT_BINDATA_COM_CALL, ;
		tiMaximumBytesToReceive AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterBinDataSend AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataSend AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown, ;
		loParkParameterBinDataReceived AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataReceived AS CHILKAT_BINDATA_COM_CALL, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataSend, m.loChilkatBinDataSend, ;
		m.loParkParameterBinDataReceived, m.loChilkatBinDataReceived
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinDataSend = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataSend)
		
		      loParkParameterBinDataReceived = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataReceived)
		
		      loChilkatBinDataSend = m.loParkParameterBinDataSend.GetObject()
		      loChilkatBinDataReceived = m.loParkParameterBinDataReceived.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.Transmit(m.tcProtocol, m.loChilkatBinDataSend, ;
		        m.loChilkatBinDataReceived, m.tiMaximumBytesToReceive) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinDataSend = m.loParkParameterBinDataSend.SetObject(;
		      m.toChilkatBinDataSend, m.loChilkatBinDataSend)
		
		      toChilkatBinDataReceived = m.loParkParameterBinDataReceived.SetObject(;
		      m.toChilkatBinDataReceived, m.loChilkatBinDataReceived)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataSend, m.loChilkatBinDataSend, ;
		m.loParkParameterBinDataReceived, m.loChilkatBinDataReceived
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  toChilkatBinDataSend = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatBinDataReceived = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinDataSend = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinDataReceived = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinDataSend = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatBinDataReceived = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE transmithex		&& Introduced in version 9.50.87. Sends an APDU to the smart card contained in the currently connected reader. The protocol can be "T0", "T1", or "raw". The APDU (in hexadecimal) to be sent is passed in apduHex.
		*==============================================================================
		* Method:            TransmitHex
		* Purpose:           Sends an APDU to the smart card contained 
		*                    in the currently connected reader.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcProtocol, the control code to send.
		*                    tcAPDUHexValue, the APDU hex value to send.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		*                    tiMaximumBytesToReceive, the maximum number of bytes to receive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Sends an APDU to the smart card contained in the currently connected reader. 
		** The protocol can be "T0", "T1", or "raw". The APDU (in hexadecimal) 
		** to be sent is passed in apduHex. The response from the card is contained in bdRecv. 
		** The maxRecvLen is the maximum response size (in bytes) willing to be accepted.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcProtocol AS Character, tcAPDUHexValue AS Character, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tiMaximumBytesToReceive AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SCARD_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.TransmitHex(m.tcProtocol, m.tcAPDUHexValue, ;
		        m.loChilkatBinData, m.tiMaximumBytesToReceive) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCARD_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat SCard VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/10/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/10/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS scminidriver AS ibasechilkat OF "chilkatvfp.vcx" 		&& A wrapper around the Microsoft Smart Card Minidriver API. This class is specific to Windows. This class is introduced in Chilkat v9.5.0.87.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: acquirecontext		&& Introduced in version 9.5.0.87. Initializes communication with the card inserted in the given reader. Reader names can be discovered via the SCard.ListReaders or SCard.FindSmartcards methods. If successful, the Atr and CardName properties will be set.
		*m: atr_access		&& Access method used to retrieve the Chilkat SCMiniDriver ATR property.
		*m: atr_assign		&& Assign method used to hold a reference to the ATR property.
		*m: carddeletefile		&& Introduced in version 9.5.0.88. Deletes the file specified by dirName and fileName. dirName is the name of the directory that contains the file, or the empty string for root. Returns 1 for success, 0 for failure.
		*m: cardname_access		&& Access method used to retrieve the Chilkat SCMiniDriver CardName property.
		*m: cardname_assign		&& Assign method used to hold a reference to the CardName property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat SCMiniDriver DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deletecert		&& Introduced in version 9.5.0.88. Deletes a certificate and optionally its associated private key from the smart card. If delPrivKey is 1, then the associated private key, if it exists, is also deleted. Returns 1 for success, 0 for failure.
		*m: deletecontext		&& Introduced in version 9.5.0.87. This function reverses the effect of AcquireContext and severs the communication between the Base CSP/KSP and the card minidriver. The Atr and CardName properties are cleared. Returns 1 for success, 0 for failure.
		*m: deletekeycontainer		&& Introduced in version 9.5.0.87. Deletes the key container at the given containerIndex. This deletes both the "signature" and "key exchange" keys that may be contained in the specified key container. Returns 1 for success, 0 for failure.
		*m: enumfiles		&& Introduced in version 9.5.0.87. Get the list of files in the directory specified by dirName. Pass the empty string for the root directory. The filenames are returned in st. Returns 1 for success, 0 for failure.
		*m: findcert		&& Introduced in version 9.5.0.87. Finds the certificate where the given certPart equals the partValue. Possible values for certPart are: "subjectDN", "subjectDN_withTags", "subjectCN", "serial", or "serial:issuerCN".
		*m: generatekey		&& Introduced in version 9.5.0.87. Generates a key to be stored in either the "signature" or "key exchange" location within a key container. Creates the key container if it does not already exist. Otherwise replaces the key in the key container.
		*m: getcardproperties		&& Introduced in version 9.5.0.87. Gets all card properties and returns them in json. See the example below. Returns 1 for success, 0 for failure.
		*m: getcert		&& Introduced in version 9.5.0.87. Get the certificate at the specified containerIndex and keySpec. The keySpec can be "sig" or "kex" to specify either the "signature" or "key exchange" location within the container.
		*m: getcontainerkeys		&& Introduced in version 9.5.0.87. Queries a key container to get the keys that are present. If the signature public key is present, it is returned in sigKey. If the key exchange key is present, it is returned in kexKey.
		*m: getcspcontainermap		&& Introduced in version 9.5.0.87. Returns the contents of the CSP container map file (cmapfile). The information is returned in the json. This gives an overview of what key containers and certificates exist in the smart card from a CSP's point of view.
		*m: importcert		&& Introduced in version 9.5.0.87. Imports a certificate with its private key onto the smart card.
		*m: importkey		&& Introduced in version 9.5.0.87. Imports a key to be stored in either the "signature" or "key exchange" location within a key container. Creates the key container if it does not already exist. Otherwise replaces the specified key in the key container.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSucdess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastStrintResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat SCMiniDriver LastStrintResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: listcerts		&& Introduced in version 9.5.0.87. Lists the certs found on the smart card. The certPart indicates the information to be returned from each certificate. Possible values are: "subjectDN", "subjectDN_withTags", "subjectCN", "serial", or "serial:issuerCN".
		*m: maxcontainers_access		&& Access method used to retrieve the Chilkat SCMiniDriver MaxContainers property.
		*m: maxcontainers_assign		&& Assign method used to hold a reference to the MaxContainers property.
		*m: pinauthenticate		&& Introduced in version 9.5.0.87. Performs regular PIN authentication. The pinId can be "user", "admin", or "3" through "7". (It is typically "user".) The pin is the alphanumeric PIN. Returns 0 for success.
		*m: pinauthenticatehex		&& Introduced in version 9.5.0.87. The same as PinAutheneticate, but the PIN is passed as a hex string. For example, to pass a PIN of 0x01, 0x02, 0x03, 0x04, pass "01020304".
		*m: pinchange		&& Introduced in version 9.5.0.87. Changes a PIN. The pinId can be "user", "admin", or "3" through "7". (It is typically "user".) The currentPin is the current alphanumeric PIN. The newPin is the new PIN. Returns 0 for success.
		*m: pindeauthenticate		&& Introduced in version 9.5.0.87. Reverses a previous PIN authentication without resetting the card. The pinId can be "user", "admin", or "3" through "7". (It is typically "user".) Returns 1 for success, 0 for failure.
		*m: readfile		&& Introduced in version 9.5.0.87. Reads the entire file specified by dirName and fileName into bd. dirName is the name of the directory that contains the file, or the empty string for root. Returns 1 for success, 0 for failure.
		*m: rsapaddinghash_access		&& Access method used to retrieve the Chilkat SCMiniDriver RSAPaddingHash property.
		*m: rsapaddinghash_assign		&& Assign method used to hold a reference to the RSAPaddingHash property.
		*m: rsapaddingscheme_access		&& Access method used to retrieve the Chilkat SCMiniDriver RSAPaddingScheme property.
		*m: rsapaddingscheme_assign		&& Assign method used to hold a reference to the RSAPaddingScheme property.
		*m: signdata		&& Introduced in version 9.5.0.87. Signs the data passed in bdData. The hashDataAlg can be "sha1", "sha256", "sha384", "sha512", or "none". If not equal to "none", then the hash of the data passed in bdData is signed.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat SCMiniDriver UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat SCMiniDriver VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: writefile		&& Introduced in version 9.5.0.87. Writes the entire file specified by dirName and fileName. dirName is the name of the directory that contains the file, or the empty string for root. The entire contents of bd are written to the file on the smart card.
		*p: atr		&& Introduced in version 9.5.0.87. The ATR of the card in the reader. This property is set by the AcquireContext method.
		*p: cardname		&& Introduced in version 9.5.0.87. The name of the card in the reader. This property is set by the AquireContext method.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: maxcontainers		&& Introduced in version 9.5.0.87. The maximum number of key containers available. The 1st key container is at index 0. Each key container can potentially contain one signature key, and one key exchange key.
		*p: rsapaddinghash		&& !ntroduced in version 9.5.0.87. If an RSA key is used for signing, this is the hash algorithm to used in conjunction with the padding scheme. It can be "SHA1", "SHA256", "SHA384", or "SHA512". The default is "SHA256".
		*p: rsapaddingscheme		&& Introduced in version 9.5.0.87. If an RSA key is used for signing, this is the padding scheme to use. It can be "PKCS" or "PSS". The default is "PSS".
		*p: uncommonoptions		&& Introduced in version 9.5.0.87. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		atr = 
		cardname = 
		cchilkatclass = ScMinidriver
		debuglogfilepath = 
		iinstancepatch = 87
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		maxcontainers = 0
		Name = "scminidriver"
		rsapaddinghash = SHA256
		rsapaddingscheme = PSS
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE acquirecontext		&& Introduced in version 9.5.0.87. Initializes communication with the card inserted in the given reader. Reader names can be discovered via the SCard.ListReaders or SCard.FindSmartcards methods. If successful, the Atr and CardName properties will be set.
		*==============================================================================
		* Method:            AcquireContext
		* Purpose:           Initializes communication with the card inserted in the given reader.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcReaderName, the card reader name.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Initializes communication with the card inserted in the given reader. 
		** Reader names can be discovered via the SCard.ListReaders or SCard.FindSmartcards methods. 
		** If successful, the Atr and CardName properties will be set.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcReaderName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AcquireContext(m.tcReaderName) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE atr_access		&& Access method used to retrieve the Chilkat SCMiniDriver ATR property.
		*==============================================================================
		* Method:            ATR_Access
		* Purpose:           Access method used to retrieve 
		*                    the ATR property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ATR
		* Date Added:        07/09/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.87
		**
		** The ATR of the card in the reader. 
		** This property is set by the AcquireContext method.
		**
		** Enhancement in version 99: Added to Chilkat’s internal list 
		** of recognized smartcard ATR’s to also recognize Giesecke & Devrient Sm@rtCafe 7.0 CC.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
