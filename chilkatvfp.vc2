		      liExceptEscapedDelimiter = .LogicalToBit(m.tuExceptEscapedDelimiter)
		
		      TRY
		
		        STORE m.loChilkatObject.SplitAndAppend(m.tcStringToSplit, m.tcDelimiterCharacter, ;
