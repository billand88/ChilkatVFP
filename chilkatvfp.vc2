		RETURN
	ENDPROC

	PROCEDURE loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadTaskCaller
		* Purpose:           Loads the caller of the task's async method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTask, a Chilkat Task object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/03/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Loads the caller of the task's async method.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatTask AS CHILKAT_TASK_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ZIPCRC_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterTask AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn  
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTask = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTask)
		
		       loChilkatTask = m.loParkParameterTask.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadTaskCaller(m.loChilkatTask) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTask = ;
		      m.loParkParameterTask.SetObject(m.toChilkatTask, m.loChilkatTask)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPCRC_COM_CALL)
		  toChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loParkParameterTask = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE moredata		&& Adds additional data to the CRC currently being calculated. (See BeginStream for more information.)
		*==============================================================================
		* Method:            MoreData
		* Purpose:           Adds additional data to the CRC currently being calculated.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData, the data to calculate the CRC against.
		* Returns:           The CRC value.
		* Date Added:        06/03/2022
		*==============================================================================
		
		**
		** Adds additional data to the CRC currently being calculated. 
		** (See BeginStream for more information.)
		**
		
		LPARAMETERS tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_ZIPCRC_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.MoreData(m.tqData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPCRC_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE tohex		&& Converts a 32-bit integer to a hex string. Returns Nothing on failure.
		*==============================================================================
		* Method:            ToHex
		* Purpose:           Converts a 32-bit integer to a hex string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiCRC32, a 32 bit integer value
		* Returns:           CRC32
		* Date Added:        06/03/2022
		*==============================================================================
		
		**
		** Converts a 32-bit integer to a hex string.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiCRC32 AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_ZIPCRC_COM_CALL, ;
		loException AS Exception,lcHex AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHex = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcHex = m.loChilkatObject.ToHex(m.tiCRC32)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHex
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPCRC_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat ZipCRC VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/03/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/03/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS zipentry AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a single file or directory entry within a Chilkat Zip object. A zip entry can be one of 5 types (see the description of the EntryType property below).
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: appenddata		&& Appends binary data to the zip entry's file contents. Returns 1 for success, 0 for failure.
		*m: appenddataasync		&& Creates an asynchronous task to call the AppendData method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: appendstring		&& Appends text data to the zip entry's file contents. The text is appended using the character encoding specified by the charset, which can be "utf-8", "ansi", etc. Returns 1 for success, 0 for failure.
		*m: appendstringasync		&& Creates an asynchronous task to call the AppendString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: comment_access		&& Access method used to retrieve the Chilkat ZIPEntry Comment property.
		*m: comment_assign		&& Assign method used to hold a reference to the Comment property.
		*m: compressedlengthstr_access		&& Access method used to retrieve the Chilkat ZIPEntry CompressedLengthStr property.
		*m: compressedlengthstr_assign		&& Assign method used to hold a reference to the CompressedLengthStr property.
		*m: compressedlength_access		&& Access method used to retrieve the Chilkat ZIP CompressedLength property.
		*m: compressedlength_assign		&& Assign method used to hold a reference to the CompressedLength property.
		*m: compressionlevel_access		&& Access method used to retrieve the Chilkat ZIPEntry CompressedLevel property.
		*m: compressionlevel_assign		&& Assign method used to hold a reference to the CompressionLevel property.
		*m: compressionmethod_access		&& Access method used to retrieve the Chilkat ZIPEntry CompressedMethod property.
		*m: compressionmethod_assign		&& Assign method used to hold a reference to the CompressionMethod property.
		*m: copy		&& Returns the compressed data as a byte array. Note: The Copy method can only be called if the zip entry already contains compressed data (i.e. it is a "mapped entry").
		*m: copytobase64		&& Returns the compressed data as a Base64-encoded string. It is only possible to retrieve the compressed data from a pre-existing .zip that has been opened or after writing the .zip but not closing it.
		*m: copytohex		&& Returns the compressed data as a hexidecimal encoded string. It is only possible to retrieve the compressed data from a pre-existing .zip that has been opened or after writing the .zip but not closing it.
		*m: crc_access		&& Access method used to retrieve the Chilkat ZIPEntry CRC property.
		*m: crc_assign		&& Access method used to retrieve the Chilkat ZIP CRC property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat ZIPEntry DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: encryptionkeylen_access		&& Access method used to retrieve the Chilkat ZIPEntry EncryptionKeyLen property.
		*m: encryptionkeylen_assign		&& Assign method used to hold a reference to the EncryptionKeyLen property.
		*m: entryid_access		&& Access method used to retrieve the Chilkat ZIPEntry EntryID property.
		*m: entryid_assign		&& Assign method used to hold a reference to the EntryID property.
		*m: entrytype_access		&& Access method used to retrieve the Chilkat ZIPEntry EntryType property.
		*m: entrytype_assign		&& Assign method used to hold a reference to the EntryType property.
		*m: extract		&& Unzips this entry into the specified base directory. The file is unzipped to the subdirectory according to the relative path stored with the entry in the Zip.
		*m: extractasync		&& Creates an asynchronous task to call the Extract method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: extractinto		&& Unzip a file into a specific directory. If this entry is a directory, then nothing occurs. (An application can check the IsDirectory property and instead call Extract if it is desired to create the directory.) Returns 1 for success, 0 for failure.
		*m: extractintoasync		&& Creates an asynchronous task to call the ExtractInto method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: filedatetimestr_access		&& Access method used to retrieve the Chilkat ZIPEntry FileDateTimeStr property.
		*m: filedatetimestr_assign		&& Assign method used to hold a reference to the FileDateTimeStr property.
		*m: filedatetime_access		&& Access method used to retrieve the Chilkat ZIPEntry FileDateTime property.
		*m: filedatetime_assign		&& Assign method used to hold a reference to the FileDateTime property.
		*m: filenamehex_access		&& Access method used to retrieve the Chilkat ZIPEntry FileNameHex property.
		*m: filenamehex_assign		&& Assign method used to hold a reference to the FileNameHex property.
		*m: filename_access		&& Access method used to retrieve the Chilkat ZIPEntry FileName property.
		*m: filename_assign		&& Assign method used to hold a reference to the FileName property.
		*m: getdt		&& Returns the last-modified date/time of this zip entry. Returns Nothing on failure.
		*m: getnext		&& Introduced in version 11.0.0. Updates this object to the next entry (file or directory) within this zip. Returns 1 for success, 0 for failure.
		*m: getnextmatch		&& Introduced in version 11.0.0. Updates this object to the next matching entry (file or directory) within this zip. The "*" characters matches 0 or more of any character. Returns 1 for success, 0 for failure.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat ZIPEntry HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: inflate		&& Inflate a file within a Zip directly into memory. Returns a zero-length byte array (as a Variant) on failure.
		*m: inflateasync		&& Creates an asynchronous task to call the Inflate method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: isaesencrypted_access		&& Access method used to retrieve the Chilkat ZIPEntry IsAESEncrypted property.
		*m: isaesencrypted_assign		&& Assign method used to hold a reference to the IsAESEncrypted property.
		*m: isdirectory_access		&& Access method used to retrieve the Chilkat ZIPEntry IsDirectory property.
		*m: isdirectory_assign		&& Assign method used to hold a reference to the IsDirectory property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat ZIPEntry LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat ZIPEntry LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat ZIPEntry LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat ZIPEntry LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat ZIPEntry LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat ZIPEntry LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat ZIPEntry LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: nextentry		&& Return the next entry (file or directory) within the Zip. Returns Nothing on failure.
		*m: nextmatchingentry		&& Introduced in version 9.5.0.50. Returns the next entry having a filename matching the matchStr. The "*" characters matches 0 or more of any character. The full filename, including path, is used when matching against the pattern.
		*m: replacedata		&& Replaces the zip entry's existing contents with new data. Returns 1 for success, 0 for failure.
		*m: replacestring		&& Replaces the zip entry's existing contents with new text data. The text will be stored using the character encoding as specified by charset, which can be "utf-8", "ansi", etc. Returns 1 for success, 0 for failure.
		*m: setdt		&& Sets the last-modified date/time for this zip entry.
		*m: textflag_access		&& Access method used to retrieve the Chilkat ZIPEntry TextFlag property.
		*m: textflag_assign		&& Assign method used to hold a reference to the TextFlag property.
		*m: uncompressedlengthstr_access		&& Access method used to retrieve the Chilkat ZIPEntry UncompressedLengthStr property.
		*m: uncompressedlengthstr_assign		&& Assign method used to hold a reference to the UncompressedLengthStr property.
		*m: uncompressedlength_access		&& Access method used to retrieve the Chilkat ZIPEntry UncompressedLength property
		*m: uncompressedlength_assign		&& Assign method used to hold a reference to the UncompressedLength property.
		*m: unziptobd		&& Introduced in version 9.5.0.67. Unzips the entry contents into the binData. Returns 1 for success, 0 for failure.
		*m: unziptobdasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the UnzipToBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: unziptosb		&& Introduced in version 9.5.0.67. Unzips a text file to the sb. The contents of sb are appended with the unzipped file. Returns 1 for success, 0 for failure.
		*m: unziptosbasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the UnzipToSb method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: unziptostream		&& Introduced in version 9.5.0.67. Unzips a file within a Zip to a stream. If called synchronously, the toStream must have a sink, such as a file or another stream object. If called asynchronously, then the foreground thread can read the stream.
		*m: unziptostreamasync		&& Introduced in version 9.5.0.67. Creates an asynchronous task to call the UnzipToStream method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: unziptostring		&& Inflate and return the uncompressed data as a string The lineEndingBehavior is as follows: 0 = leave unchanged.
		*m: unziptostringasync		&& Creates an asynchronous task to call the UnzipToString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat ZIPEntry VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: compressedlength		&& The size in bytes of this entry's file data when compression is applied.
		*p: compressedlengthstr		&& The size in decimal string format of this file when Zip compression is applied.
		*p: compressionlevel		&& The compression level. 0 = no compression, while 9 = maximum compression. The default is 6.
		*p: compressionmethod		&& Set to 0 for no compression, or 8 for the Deflate algorithm. The Deflate algorithm is the default algorithm of the most popular Zip utility programs, such as WinZip.
		*p: crc		&& The CRC for the zip entry. For AES encrypted entries, the CRC value will be 0. (See http://www.winzip.com/aes_info.htm#CRC )
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: encryptionkeylen		&& If this entry is AES encrypted, then this property contains the AES key length (128, 192, or 256). If the entry is not AES encrypted, then the value is 0.
		*p: entryid		&& A unique ID assigned to the entry while the object is instantiated in memory.
		*p: entrytype		&& Indicates the origin of the entry. When the zip is written by calling WriteZip or WriteToMemory, all of the zip entries are transformed into mapped entries. They become entries that contain the compressed data within the .zip that was just created.
		*p: filedatetime		&& Undocumented property! See FileDateTimeStr method. It is assumed that this method returns the value in a DateTime format.
		*p: filedatetimestr		&& The local last-modified date/time in RFC822 string format.
		*p: filename		&& The file name of the Zip entry.
		*p: filenamehex		&& A string containing the hex encoded raw filename bytes found in the Zip entry.
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort inflate/extract/unzip calls prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: isaesencrypted		&& Introduced in version 9.5.0.69. 1 if the entry is AES encrypted. This property can only be 1 for entries already contained in a .zip (i.e. entries obtained from a zip archive that was opened via OpenZip, OpenBd, OpenFromMemory, etc.)
		*p: isdirectory		&& True if the Zip entry is a directory, false if it is a file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: textflag		&& Controls whether the "text flag" of the internal file attributes for this entry within the zip is set. This is a bit flag that indicates whether the file contents are text or binary.
		*p: uncompressedlength		&& The size in bytes of this entry's file data when uncompressed.
		*p: uncompressedlengthstr		&& The size in bytes (in decimal string format) of this zip entry's data when uncompressed.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = ZipEntry
		ceventhandlerclass = iBaseEventHandler
		compressedlength = 0
		compressedlengthstr = 
		compressionlevel = 6
		compressionmethod = 0
		crc = 0
		debuglogfilepath = 
		encryptionkeylen = 0
		entryid = 0
		entrytype = 0
		filedatetime = ({/:})
		filedatetimestr = 
		filename = 
		filenamehex = 
		heartbeatms = 0
		isaesencrypted = 0
		isdirectory = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "zipentry"
		textflag = 0
		uncompressedlength = 0
		uncompressedlengthstr = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE appenddata		&& Appends binary data to the zip entry's file contents. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendData
		* Purpose:           Appends binary data to the zip entry's file contents.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqBinData -- the data to append to the object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Appends binary data to the zip entry's file contents.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tqBinData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendData(m.tqBinData) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appenddataasync		&& Creates an asynchronous task to call the AppendData method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            AppendDataAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    AppendData method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        tqBinData -- the data to append to the object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the AppendData method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tqBinData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.AppendDataAsync(m.tqBinData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendstring		&& Appends text data to the zip entry's file contents. The text is appended using the character encoding specified by the charset, which can be "utf-8", "ansi", etc. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendString
		* Purpose:           Appends text data to the zip entry's file contents.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        tcContent -- the string to append.
		*                    tcCharset -- the charset of the string.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Appends text data to the zip entry's file contents. 
		** The text is appended using the character encoding specified by the charset, 
		** which can be "utf-8", "ansi", etc.
		**
		** Fixed for version 70: The charset argument for these method was getting ignored.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcContent AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AppendString(m.tcContent, m.tcCharset) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

