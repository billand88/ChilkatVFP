	HIDDEN PROCEDURE filenamecharset_access		&& Access method used to retrieve the Chilkat SFTP FileNameCharset property.
		*==============================================================================
		* Method:            FileNameCharset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP FileNameCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FileNameCharset
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** Automatically set during the InitializeSftp method if the server sends 
		** a filename-charset name-value extension. Otherwise, may be set directly 
		** to the name of a charset, such as "utf-8", "iso-8859-1", "windows-1252", etc. 
		** ("ansi" is also a valid choice.) Incoming filenames are interpreted as utf-8 
		** if no FilenameCharset is set. Outgoing filenames are sent using utf-8 by default. 
		** Otherwise, incoming and outgoing filenames use the charset specified by this property.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE filenamecharset_assign		&& Assign method used to hold a reference to the FileNameCharset property.
		*==============================================================================
		* Method:            FileNameCharset_Assign
		* Purpose:           Assign method used to hold a reference to the FileNameCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold 
		*                    a reference to the FileNameCharset property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE forcecipher_access		&& Access method used to retrieve the Chilkat SFTP ForceCipher property.
		*==============================================================================
		* Method:            ForceCipher_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP ForceCipher property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ForceCipher
		* Date Added:        04/19/2022
		*==============================================================================
		
		** 
		** Set to one of the following encryption algorithms to force that cipher to be used. 
		** By default, the component will automatically choose 
		** the first cipher supported by the server in the order listed here: 
		** "aes256-ctr", "aes128-ctr", "aes256-cbc", "aes128-cbc", "twofish256-cbc", 
		** "twofish128-cbc", "blowfish-cbc", "3des-cbc", "arcfour128", "arcfour256". 
		** (If blowfish is chosen, the encryption strength is 128 bits.)
		**
		** Important: If this is property is set and the server 
		** does NOT support then encryption algorithm, then the Connect will fail.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE forcecipher_assign		&& Assign method used to hold a reference to the ForceCipher property.
		*==============================================================================
		* Method:            ForceCipher_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat SFTP ForceCipher property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ForceCipher property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [ForceCipher]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE forcev3_access		&& Access method used to retrieve the Chilkat SFTP ForceV3 property.
		*==============================================================================
		* Method:            ForceV3_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP ForceV3 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ForceV3
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** If set to 1, forces the client to choose version 3 of the SFTP protocol, 
		** even if the server supports a higher version. 
		** The default value of this property is 1.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE forcev3_assign		&& Assign method used to hold a reference to the ForceV3 property.
		*==============================================================================
		* Method:            ForceV3_Assign
		* Purpose:           Assign method used to hold a reference to the ForceV3 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the ForceV3 property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE fsync		&& Introduced in version 9.5.0.71. Causes the SFTP server to do an fsync on the open file. Specifically, this is directing the SFTP server to call fsync (https://linux.die.net/man/2/fsync) on the open file.
		*==============================================================================
		* Method:            FSync
		* Purpose:           Causes the SFTP server to do an fsync on the open file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Causes the SFTP server to do an fsync on the open file. 
		** Specifically, this is directing the SFTP server to call fsync 
		** (https://linux.die.net/man/2/fsync) on the open file.
		**
		** This method uses the fsync@openssh.com and only works for servers 
		** supporting the fsync@openssh.com extension.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHandle AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.FSync(m.tcHandle) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		     .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

