	PROCEDURE createdetachedsignature		&& Digitally signs a file and writes the digital signature to a separate output file (a PKCS#7 signature file). The input file (inFilePath) is unmodified.
		*==============================================================================
		* Method:            CreateDetachedSignature
		* Purpose:           Digitally signs a file and writes the digital signature 
		*                    to a separate output file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileToSign -- the file that needs digital signing.
		*                    tcSignedFilePath -- the destination of the digitally signed file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Digitally signs a file and writes the digital signature to a separate output file 
		** (a PKCS#7 signature file). The input file (inFilePath) is unmodified. 
		** A certificate for signing must be specified by calling SetSigningCert 
		** or SetSigningCert2 prior to calling this method.
		** 
		** This method is equivalent to CreateP7S. The CreateP7S method was added 
		** to clarify the format of the signature file that is created.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFileToSign AS Character, tcSignedFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CreateDetachedSignature(;
		      m.tcFileToSign, m.tcSignedFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE createp7m		&& Digitally signs a file and creates a .p7m (PKCS #7 Message) file that contains both the signature and original file content. The input file (inFilename) is unmodified.
		*==============================================================================
		* Method:            CreateP7M
		* Purpose:           Digitally signs a file and creates a .p7m (PKCS #7 Message) file
		*                    that contains both the signature and original file content.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileToSign -- the file that needs digital signing.
		*                    tcP7MSignedFilePath -- the destination of the digitally P7M signed file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Digitally signs a file and creates a .p7m (PKCS #7 Message) file 
		** that contains both the signature and original file content. 
		** The input file (inFilename) is unmodified. 
		** A certificate for signing must be specified by calling SetSigningCert 
		** or SetSigningCert2 prior to calling this method.
		** 
		** To sign with a particular hash algorithm, set the HashAlgorithm property. 
		** Valid hash algorithms for signing are "sha256", "sha1", "sha384", 
		** "sha512", "md5", and "md2".
		** 
		** Note: The CreateP7M method creates an opaque signature. 
		** To do the same thing entirely in memory, 
		** your application would call any of the OpaqueSign* methods, 
		** such as OpaqueSignBd, OpaqueSignString, OpaqueSignStringENC, etc.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFileToSign AS Character, tcP7MSignedFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CreateP7M(;
		      m.tcFileToSign, m.tcP7MSignedFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

