	PROCEDURE sshnewchannel		&& Introduced in version 11.0.0. Opens a new channel within an SSH tunnel and provides the socket connected to the specified destination host:port through SSH port forwarding in channel. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SSHNewChannel
		* Purpose:           Opens a new channel within an SSH tunnel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHostName -- the host name.
		*                    tiPort -- the port to use.
		*                    tuSSL -- whether or not SSL/TLS is used.
		*                    tiMaxWaitMs -- the maximum millisecond wait
		*                    toChilkatSocket -- a Chilkat Socket object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Opens a new channel within an SSH tunnel and provides the socket 
		** connected to the specified destination host:port through SSH port forwarding in channel. 
		** If ssl is 1, the connection uses TLS within the SSH tunnel. 
		** Multiple channels can be opened within one SSH tunnel, 
		** each possibly forwarding to different remote host:port endpoints.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcHostName AS Character, tiPort AS Integer, tuSSL AS Unknown, ;
		tiMaxWaitMs AS Integer, toChilkatSocket AS CHILKAT_SOCKET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, liSSL AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterSocket AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSocket AS CHILKAT_SOCKET_COM_CALL, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liSSL 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSSL = .LogicalToBit(m.liSSL)
		
		      loParkParameterSocket = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSocket)
		
		      loChilkatSocket = m.loParkParameterSocket.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SSHNewChannel(m.tcHostName, m.tiPort, ;
		        m.liSSL, m.tiMaxWaitMs, m.loChilkatSocket) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSocket = ;
		      m.loParkParameterSocket.SetObject(m.toChilkatSocket, m.loChilkatSocket)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSocket, m.loChilkatSocket
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  toChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loParkParameterSocket = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSocket = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

