	HIDDEN PROCEDURE syncedfiles_access		&& Access method used to retrieve the Chilkat SyncedFiles property.
		*==============================================================================
		* Method:            SyncedFiles_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 SyncedFiles property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SyncedFiles
		* Date Added:        02/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		**
		** The paths of the files uploaded or downloaded in the last call to 
		** SyncDeleteTree, SyncLocalDir, SyncLocalTree, SyncRemoteTree, or SyncRemoteTree2. 
		** The paths are listed one per line. 
		** In both cases (for upload and download) each line contains 
		** the paths relative to the root synced directory.
		**
		** Version 11.0.0: Property removed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [String]
		
		  la_IntroducedInBuild[1] = 9
		  la_IntroducedInBuild[2] = 5
		  la_IntroducedInBuild[3] = 51
		
		  THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN []
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test
		
		  
	ENDPROC

	HIDDEN PROCEDURE syncedfiles_assign		&& Assign method used to hold a reference to the SyncedFiles property.
		*==============================================================================
