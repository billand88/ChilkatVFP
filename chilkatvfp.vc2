		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.PBinaryBdAsync(;
		        m.tcVerb, m.tcURL, m.loChilkatBinData, m.tcContentType, m.liMD5Header, m.liGZip)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE percentdonescale_access		&& Access method used to retrieve the Chilkat HTTP PercentDoneScale property.
		*==============================================================================
		* Method:            PercentDoneScale_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP PercentDoneScale property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PercentDoneScale
		* Date Added:        01/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** This property is only valid in programming environment and languages that allow for event callbacks.
		**
		** Sets the value to be defined as 100% complete for the purpose of PercentDone event callbacks. 
		** The defaut value of 100 means that at most 100 event PercentDone callbacks will occur 
		** in a method that (1) is event enabled and (2) is such that it is possible 
		** to measure progress as a percentage completed. This property may be set to larger numbers 
		** to get more fine-grained PercentDone callbacks. For example, setting this property equal 
		** to 1000 will provide callbacks with .1 percent granularity. 
		** For example, a value of 453 would indicate 45.3% competed. 
		** This property is clamped to a minimum value of 10, and a maximum value of 100000.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE percentdonescale_assign		&& Assign method used to hold a reference to the PercentDoneScale property.
		*==============================================================================
		* Method:            PercentDoneScale_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat HTTP PercentDoneScale property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the PercentDoneScale property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = [PercentDoneScale]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE pfile		&& Sends an HTTP/HTTPS request to the url. The verb can be "POST", "PUT", "PATCH", etc. The url can begin with "http://" or "https://" depending if TLS is desired. The body of the HTTP request is streamed directly from the localFilePath.
		*==============================================================================
		* Method:            PFile
		* Purpose:           Sends an HTTP/HTTPS request to the url. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb, the operation to run.
		*                    tcURL, the URL to receive the request. 
		*                    tcLocalFilePath, the HTTP request is streamed from this file.
		*                    tcContentType, the content type of the request.
		*                    tuMD5Header, set to 1 to add MD5 header to tcLocalFilePath.
		*                    tuGZip, set to 1 if tcLocalFilePath is gZip compressed.
		* Returns:           Chilkat HTTP Response Object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Sends an HTTP/HTTPS request to the url. 
		** The verb can be "POST", "PUT", "PATCH", etc. 
		** The url can begin with "http://" or "https://" depending if TLS is desired. 
		** The body of the HTTP request is streamed directly from the localFilePath. 
		** The contentType is a content type such as "image/gif", "application/pdf", "text/xml", etc. 
		** If md5 is 1, then a Content-MD5 header is added with the base64 MD5 hash of the localFilePath. 
		** Servers aware of the Content-MD5 header will perform 
		** a message integrity check to ensure that the data has not been corrupted. 
		** If gzip is 1, the localFilePath is compressed using the gzip algorithm. 
		** The HTTP request body will contain the GZIP compressed data, 
		** and a "Content-Encoding: gzip" header is automatically 
		** added to indicate that the request data needs to be ungzipped when received (at the server).
		**
		** Fixed in Version 95: This method was fixed. The last argument, “gzip”, which can be true/false, 
		** indicates whether the HTTP request body should be sent gzipped or not. 
		** Chilkat was not paying attention to the argument and was always sending non-gzipped.
		**
		** Starting in Version 96: 
		**
		** The body of the request was 0 bytes if the gzip argument was true. 
		** Fixed to correctly send the gzipped file as the body of the HTTP request.
		**
		** Starting in Version 97: 
		**
		** If the HTTP verb is “OPTIONS”, then Chilkat will now allow for the path to be “*”. 
		** Previously, Chilkat forced the path in the HTTP start line to begin with a “/”. 
		** Also, when the HTTP verb is OPTIONS, no “Content-Length” header
		** will be included in the request.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character, tcLocalFilePath AS Character, ;
		tcContentType AS Character, tuMD5Header AS Unknown, tuGZip AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liMD5Header AS Integer, liGZip AS Integer, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL
		
		STORE 0 TO m.liMD5Header, m.liGZip, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liMD5Header = .LogicalToBit(m.tuMD5Header)
		      liGZip = .LogicalToBit(m.tuGZip)
		
		      TRY
		
		        loChilkatHTTPResponse = m.loChilkatObject.PFile(;
		        m.tcVerb, m.tcURL, m.tcLocalFilePath, m.tcContentType, m.liMD5Header, m.liGZip)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE pfileasync		&& Creates an asynchronous task to call the PFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            PFileAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the PFile method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcVerb, the operation to run.
		*                    tcURL, the URL to receive the request. 
		*                    tcLocalFilePath, the HTTP request is streamed from this file.
		*                    tcContentType, the content type of the request.
		*                    tuMD5Header, set to 1 to add MD5 header to tcLocalFilePath.
		*                    tuGZip, set to 1 if tcLocalFilePath is gZip compressed.
