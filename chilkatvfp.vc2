		*                    tiSkip, the skip setting.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** Fired just prior to recursively descending into a directory tree for uploading. 
		** The subtree can be skipped by setting the skip output-only argument equal to 1.
		**
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		*!*  ? [VerifyUploadDir Event!]
		*!*  ? [VerifyUploadDir: Path = ] + lcPath + [, Skip = ] + STR(liSkip)
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liSkip = 0
		
		    .VerifyUploadDir_Pre(m.lcPath, m.liSkip)
		
		    ** OK to continue test
		    IF m.liSkip = 0
		
		      .VerifyUploadDir_Process(m.lcPath, m.liSkip)
		
		      ** OK to continue test
		      IF m.liSkip = 0
		
		        .VerifyUploadDir_Post(m.lcPath, m.liSkip)
		
		      ENDIF m.liSkip = 0
		      ** End OK to continue test
		
		    ENDIF m.liSkip = 0
		    ** End OK to continue test
		
		  ENDIF m.liSkip = 0
		  ** End OK to continue test
		
		ENDWITH
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN
	ENDPROC

	PROCEDURE verifyuploaddir_post		&& VerifyUploadDir post-processing method.
		*==============================================================================
		* Method:            VerifyUploadDir_Post
		* Purpose:           VerifyUploadDir post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the directory to upload.
		*                    tiSkip, the skip setting.
		* Returns:           liSkip, the skip setting.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN m.liSkip
	ENDPROC

	PROCEDURE verifyuploaddir_pre		&& VerifyUploadDir pre-processing method.
		*==============================================================================
		* Method:            VerifyUploadDir_Pre
		* Purpose:           VerifyUploadDir pre-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the directory to upload.
		*                    tiSkip, the skip setting.
		* Returns:           liSkip, the skip setting.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN m.liSkip
	ENDPROC

	PROCEDURE verifyuploaddir_process		&& VerifyUploadDir processing method.
		*==============================================================================
		* Method:            VerifyUploadDir_Process
		* Purpose:           VerifyUploadDir processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPath, the path to the directory to upload.
		*                    tiSkip, the skip setting.
		* Returns:           liSkip, the skip setting.
		* Date Added:        10/21/2022
		*==============================================================================
		
		LPARAMETERS tcPath AS Character, tiSkip AS Integer
		
		LOCAL lcPath AS Character, liSkip AS Integer
		
		lcPath = m.tcPath
		liSkip = m.tiSkip
		
		tcPath = m.lcPath
		tiSkip = m.liSkip
		
		RETURN m.liSkip
	ENDPROC

ENDDEFINE

DEFINE CLASS global AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides a means for updating global settings that affect all types of Chilkat objects across all instances.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: ansicodepage_access		&& Access method used to retrieve the Chilkat Global ANSICodePage property.
		*m: ansicodepage_assign		&& Assign method used to hold a reference to the ANSICodePage property.
		*m: autoqbdecode_access		&& Access method used to retrieve the Chilkat Global AutoQBDecode  property.
		*m: autoqbdecode_assign		&& Assign method used to hold a reference to the AutoQBDecode property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Global DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: defaultntlmversion_access		&& Access method used to retrieve the Chilkat Global DefaultNTLMVersion property.
		*m: defaultntlmversion_assign		&& Assign method used to hold a reference to the DefaultNTLMVersion property.
		*m: defaultutf8_access		&& Access method used to retrieve the Chilkat Global DefaultUTF8 property.
		*m: defaultutf8_assign		&& Assign method used to hold a reference to the DefaultUTF8 property.
		*m: dnsclearcache		&& Clears the global DNS cache. Returns 1 for success, 0 for failure.
		*m: dnstimetolive_access		&& Access method used to retrieve the Chilkat Global DMSTimeToLive property.
		*m: dnstimetolive_assign		&& Assign method used to hold a reference to the DNSTimeToLive property.
		*m: enablednscaching_access		&& Access method used to retrieve the Chilkat Global EnableDNSCaching property.
		*m: enablednscaching_assign		&& Assign method used to hold a reference to the EnableDNSCaching property.
		*m: finalizethreadpool		&& Called to stop and finalize all threads in the thread pool, and causes the thread pool thread to exit.
		*m: keepbinaryresult_access		&& Access method used to retrieve the Chilkat Global KeepBinaryResult property.
		*m: keepbinaryresult_assign		&& Assign method used to hold a reference to the KeepBinaryResult property.
		*m: keepstringresult_access		&& Access method used to retrieve the Chilkat Global KeepStringResult property.
		*m: keepstringresult_assign		&& Assign method used to hold a reference to the KeepStringResult property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Global LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Global LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Global LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Global LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Global LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Global LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Global LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: maxthreads_access		&& Access method used to retrieve the Chilkat Global MaxThreads property.
		*m: maxthreads_assign		&& Assign method used to hold a reference to the MaxThreads property.
		*m: preferipv6_access		&& Access method used to retrieve the Chilkat Global PreferIPV6 property.
		*m: preferipv6_assign		&& Assign method used to hold a reference to the PreferIPV6 property.
		*m: threadpoollogline		&& Logs a line to the thread pool log file. Returns 1 for success, 0 for failure.
		*m: threadpoollogpath_access		&& Access method used to retrieve the Chilkat Global ThreadPoolLogPath property.
		*m: threadpoollogpath_assign		&& Assign method used to hold a reference to the ThreadPoolLogPath property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat Global UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unlockbundle		&& Unlocks the entire Chilkat API for all classes. This should be called once at the beginning of a program. Once unlocked, objects of any Chilkat class may be instantiated and used.
		*m: unlockstatus_access		&& Access method used to retrieve the Chilkat Global UnlockStatus property.
		*m: unlockstatus_assign		&& Assign method used to hold a reference to the UnlockStatus property.
		*m: usepkcsconstructedencoding_access		&& Access method used to retrieve the Chilkat Global UsePKCSConstructedEncoding property.
		*m: usepkcsconstructedencoding_assign		&& Assign method used to hold a reference to the UsePKCSConstructedEncoding property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Global VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verbosetls_access		&& Access method used to retrieve the Chilkat Global VerboseTLS property.
		*m: verbosetls_assign		&& Assign method used to hold a reference to the VerboseTLS property.
		*p: ansicodepage		&& The default ANSI code page is determined at runtime based on the computer where the application happens to be running.
		*p: autoqbdecode		&& Introduced in version 10.0.0. If set to 1, then "Q" or "B" encoded strings can be passed in any string argument to any Chilkat method, and Chilkat will automatically decode the string before using it.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: defaultntlmversion		&& Selects the default NTLM protocol version to use for NTLM authentication for HTTP, POP3, IMAP, SMTP, and HTTP proxies. The default value is 2. This property may optionally be set to 1.
		*p: defaultutf8		&& Applies only to programming languages where each class has the Utf8 property, and where strings are passed and returned as multibyte (null-terminated sequences of bytes).
		*p: dnstimetolive		&& If DNS caching is enabled, this is the time-to-live (in seconds) for a cached DNS lookup. A DNS lookup result older than this expiration time is discarded, and causes a new DNS lookup to occur. A value of 0 indicates an infinite time-to-live.
		*p: enablednscaching		&& Controls whether DNS domain lookups (to resolve to IP addresses) are cached in memory. The default value is 0, meaning that DNS caching is disabled.
		*p: keepbinaryresult		&& If set to 1, then the binary data returned by any method will be persisted in memory in the LastBinaryResult property. This allows for an ActiveX running in the SQL Server environment to access large varbinary return values via temp tables.
		*p: keepstringresult		&& If set to 1, then the string returned by any method will be persisted in memory in the LastStringResult property. This allows for an ActiveX running in the SQL Server environment to access large string return values via temp tables.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: maxthreads		&& The maximum number of thread pool threads. The default value is 100. The maximum value is 500. Note: Asynchronous worker threads are created on as needed up to the maximum.
		*p: preferipv6		&& If 1, then use IPv6 over IPv4 when both are supported for a particular domain. The default value of this property is 0, which will choose IPv4 over IPv6.
		*p: threadpoollogpath		&& If set, indicates the path of a log file to be used by the thread pool thread and each of the pool worker threads for logging async activity.
		*p: uncommonoptions		&& Introduced in version 9.5.0.90. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: unlockstatus		&& Indicates the unlocked status for the last call to UnlockBundle, or any UnlockComponent call. The possible values are: (1) Not unlocked. (Still in locked state.) (2) Unlocked with in fully-functional trial mode. (3) Unlocked using a valid purchased unl
		*p: usepkcsconstructedencoding		&& This property should typically be left at the default value of 0. If set to 1, then Chilkat will use a constructed ASN.1 encoding for PCKS7 data.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: verbosetls		&& Introduced in version 9.5.0.78. If set to 1, then causes extremely verbose logging (in LastErrorText) all TLS connections in any Chilkat class. This property should only be used for troubleshooting TLS problems. The default value is 0.
	*</DefinedPropArrayMethod>

	*<PropValue>
		ansicodepage = Windows-1252
		autoqbdecode = 0
		cchilkatclass = Global
		debuglogfilepath = 
		defaultntlmversion = 2
		defaultutf8 = 0
		dnstimetolive = 0
		enablednscaching = 0
		iinstancepatch = 49
		keepbinaryresult = 0
		keepstringresult = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		maxthreads = 100
		Name = "global"
		preferipv6 = 0
		threadpoollogpath = 
		uncommonoptions = 
		unlockstatus = 0
		usepkcsconstructedencoding = 0
		verboselogging = 0
		verbosetls = 0
	*</PropValue>
	
	HIDDEN PROCEDURE ansicodepage_access		&& Access method used to retrieve the Chilkat Global ANSICodePage property.
		*==============================================================================
		* Method:            ANSICodePage_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Global ANSICodePage property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ANSICodePage
		* Date Added:        01/26/2022
		*==============================================================================
		
		**  
		** Introduced in version 9.5.0.49
		** 
		** The default ANSI code page is determined at runtime based 
		** on the computer where the application happens to be running. 
		** For example, the ANSI code page for an application running on a Japanese computer 
		** is likely to be Shift_JIS (code page 932), 
		** whereas on a US-English computer it would be iso-8859-1 
		** (or Windows-1252 which is essentially a superset of iso-8859-1).
		**
		** If there is a desire for the Chilkat library to use a specific ANSI code page regardless of locale, 
		** then this property should be set to the desired code page. 
		** The default value of this property is the ANSI code page of the local computer.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE ansicodepage_assign		&& Assign method used to hold a reference to the ANSICodePage property.
		*==============================================================================
		* Method:            ANSICodePage_Assign
		* Purpose:           Assign method used to hold a reference to the ANSICodePage property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ANSICodePage property.
		* Returns:           
		* Date Added:        01/26/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE autoqbdecode_access		&& Access method used to retrieve the Chilkat Global AutoQBDecode  property.
		*==============================================================================
		* Method:            AutoQBDecode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Global AutoQBDecode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoQBDecode
		* Date Added:        09/27/2024
		*==============================================================================
		
		**  
		** Introduced in version 10.0.0
		**
		** If set to 1, then "Q" or "B" encoded strings can be passed in any string argument to any Chilkat method, 
		** and Chilkat will automatically decode the string before using it. This is meant to be a convenient way 
		** to use non-usascii literal strings in your source code. 
		** See the links below for an example and for a discussion about non-usascii literal strings.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild(3)
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, ;
		m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild(1) = 10
		la_IntroducedInBuild(2) = 0
		la_IntroducedInBuild(3) = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autoqbdecode_assign		&& Assign method used to hold a reference to the AutoQBDecode property.
		*==============================================================================
		* Method:            AutoQBDecode_Assign
		* Purpose:           Assign method used to hold a reference to the AutoQBDecode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoQBDecode property.
		* Returns:           
		* Date Added:        09/27/2024
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild(3)
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild(1) = 10
		la_IntroducedInBuild(2) = 0
		la_IntroducedInBuild(3) = 0
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/06/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  The UnlockBundle method is now Secrets aware. It can accept a secret specification string 
		  (beginning with !!) in place of a literal value, and Chilkat resolves it 
		  from the Windows Credential Manager (Windows) or Apple Keychain (macOS). 
		  Secrets are identified by the structured format !![appName|]service[|domain]|username, 
		  letting applications resolve credentials at runtime instead of embedding them in code.
		
		
		** Version 10.0.0
		
		  Global: Added the AutoQbDecode property.  One should avoid putting non-usascii 
		  literal strings in source code.  Instead, you can insert Q or B encoded literal strings 
		  and pass them to any Chilkat function.  
		  If AutoQbDecode is true, then Chilkat will automatically decode the Q/B encoded string 
		  that is passed in.
		
		** Version 70
		
		  Added internal re-try functionality to cope with various situations
		  for IPv4-only and IPv6-only networks.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 64
		
		  Fixed: The Global.FinalizeThreadPool method will now cancel any asynchronous methods
		  that are still running and causes all async background threads to exit.
		  There are certain problems that can happen if the main thread
		  of a program exits while background threads remain running:
		
		    If the program is a VBScript, then I’ve found that
		    AVG Anti-Virus will alert the user of a General Behavioral Threat.
		    Making sure that all async method calls have finished,
		    and that all thread pool threads have exited, should prevent this problem.
		
		    If running a VB6 program from the IDE, the IDE will hang on program exit until all threads have exited.
		    It is likely that existing the main UI thread while background threads
		    remain will cause problems in many other programming environments.
		
		  Modified: The Global.FinalizeThreadPool method returns the software to the pristine initial state —
		  where no background threads are running, and the thread pool thread is not yet started.
		  Previously, after FinalizeThreadPool was called, it was not possible to continue
		  using asynchronous Chilkat methods (without restarting the application).
		  Now the FinalizeThreadPool method returns the application to the initial pristine state.
		  A subsequent asynchronous method call will cause the thread pool thread to automatically restart,
		  and everything proceeds as usual. (This is needed for cases where the ActiveX is used
		  in debugging sessions within an IDE, because the ActiveX DLL is not loaded/unloaded between each debug run.)
		
		** Version 62
		
		  Added the Global.UnlockStatus property to allow applications to programmatically know if the UnlockBundle
		  (or UnlockComponent) method call succeeded because of the 30-day trial or a recognized/purchased unlock code.
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object..)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		  Added the KeepStringResult and LastStringResult properties to the Global object for ActiveX.
		  This allows for an ActiveX running in the SQL Server environment
		  to access large string return values via temp tables.
		
		  Added the Chilkat.Global.DefaultNtlmVersion property.
		  The default NTLM protocol version is 2. It may optionally be set to 1.
		  This determines the version of the NTLM protocol used by
		  SMTP, HTTP, IMAP, POP3, and HTTP proxies whenever NTLM authentication is used.
		
		** Version 49
		
		  Added the Chilkat.Global class.
		
		  Added DnsCaching capabilities in the new Chilkat.Global / CkGlobal class.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat Global DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Global DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        01/26/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold a reference to the DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        01/26/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

