		      liPadWithSpace = .LogicalToBit(m.tuPadWithSpace)
		
		      TRY
		
		        STORE m.loChilkatObject.AppendPadded(m.tcString, ;
		        m.tcCharset, m.tuPadWithSpace, m.tiFieldLength) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
