		RETURN
	ENDPROC

	PROCEDURE readfile		&& Convenience method to read an entire file and return as a byte array. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
		* Method:            ReadFile
		* Purpose:           Convenience method to read an entire file and return as a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the string to verify. 
		* Returns:           The binary bytes of the file.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Convenience method to read an entire file and return as a byte array.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqFileBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqFileBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqFileBytes = m.loChilkatObject.ReadFile(m.tcFileName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqFileBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE reencode		&& Provides a means for converting from one encoding to another (such as base64 to hex). This is helpful for programming environments where byte arrays are a real pain-in-the-***.
		*==============================================================================
		* Method:            ReEncode
		* Purpose:           Provides a means for converting from one encoding to another.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedData -- the encoded data to re-encode.
		*                    tcFromEncoding -- the current encoding.
		*                    tcToEncoding -- the new encoding.
		* Returns:           The re-encoded string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Provides a means for converting from one encoding to another (such as base64 to hex). 
		** This is helpful for programming environments where byte arrays are a real pain-in-the-***. 
		** The fromEncoding and toEncoding may be (case-insensitive) "Base64", "modBase64", 
		** "Base32", "Base58", "UU", "QP" (for quoted-printable), "URL" (for url-encoding), 
		** "Hex", "Q", "B", "url_oauth", "url_rfc1738", "url_rfc2396", and "url_rfc3986".
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncodedData AS Character, ;
		tcFromEncoding AS Character, tcToEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcReEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcReEncodedString = ;
		      m.loChilkatObject.ReEncode(m.tcEncodedData, m.tcFromEncoding, m.tcToEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE salt_access		&& Access method used to retrieve the Chilkat Crypt2 Salt property.
		*==============================================================================
		* Method:            Salt_Access
		* Purpose:           Access method used to retrieve 
		*                    the Salt property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Salt
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** The salt to be used with password-based encryption (PBE). 
		** Password-based encryption is defined in the PKCS5 Password-Based 
		** Cryptography Standard at http://www.rsa.com/rsalabs/node.asp?id=2127
		** 
		** To clarify: This property is used in encryption when the CryptAlgorithm 
		** is set to "pbes1" or "pbes2". Also note that it is not used 
		** by the Pbkdf1 or Pbkdf2 methods, as the salt is passed in an argument to those methods.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Variant]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE salt_assign		&& Assign method used to hold a reference to the Salt property.
		*==============================================================================
		* Method:            Salt_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the Salt property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqValue, the salt value to use.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Variant]
		
		THIS.CallAssignObject(m.tqValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE secretkey_access		&& Access method used to retrieve the Chilkat Crypt2 SecretKey property.
		*==============================================================================
		* Method:            SecretKey_Access
		* Purpose:           Access method used to retrieve 
		*                    the SecretKey property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SecretKey
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** The binary secret key used for symmetric encryption 
		** (Aes, Blowfish, Twofish, ChaCha20, ARC4, 3DES, RC2, etc.). 
		** The secret key must be identical for decryption to succeed. 
		** The length in bytes of the SecretKey must equal the KeyLength/8.
		**
		** Fix for Version 58: The value of the KeyLength property should always 
		** be in agreement with the number of bytes of key material provided by the application.
		** The SetEncodedKey method correctly has the side-effect of also setting the KeyLength property. 
		** However, setting the SecretKey property directly did not also have this desired side-effect.
		** This was fixed. If the SecretKey property is set with 16 bytes of data (128 bits) 
		** then the KeyLength property is automatically updated to 128.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Variant]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE secretkey_assign		&& Assign method used to hold a reference to the SecretKey property.
		*==============================================================================
		* Method:            SecretKey_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the SecretKey property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqValue, the SecretKey value to use.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character, ;
		liCalculatedBuildNumber AS Integer, liSecretKeyLength AS Integer, ;
		loVersioning AS [iVersioning OF iChilkat.VCX]
		
		STORE 0 TO m.liCalculatedBuildNumber, m.liSecretKeyLength
		
		lcValidationMethod = []
		lcMethodToCall = [Variant]
		loVersioning = NULL
		
		WITH THIS
		
		  .CallAssignObject(m.tqValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		  loVersioning = .oVersioning
		
		  ** Have versioning object test
		  IF TYPE([loVersioning.Name]) == T_CHARACTER
		
		    ** Build before version 58 test
		    IF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 58)
		
		      liSecretKeyLength = NVL(LENC(.SecretKey), 0)
		
		      ** Set (and by definition update) the VFP KeyLength property...
		      .KeyLength = (m.liSecretKeyLength / 8)
		
		    ELSE && Chilkat fixes this in version 58
		
		      ** Update the VFP KeyLength property..
		      .KeyLength = .KeyLength 
		
		    ENDIF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 58)
		    ** End build before version 58 test
		
		    loVersioning.Release()
		
		  ENDIF TYPE([loVersioning.Name]) == T_CHARACTER
		  ** End have versioning object test
		
		ENDWITH
		
		loVersioning = NULL
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test 
	ENDPROC

	PROCEDURE setdecryptcert		&& Sets the digital certificate to be used for decryption when the CryptAlgorithm property is set to "PKI". A private key is required for decryption.
		*==============================================================================
		* Method:            SetDecryptCert
		* Purpose:           Sets the digital certificate to be used for decryption
		*                    when the CryptAlgorithm property is set to "PKI".
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Sets the digital certificate to be used for decryption 
		** when the CryptAlgorithm property is set to "PKI". 
		** A private key is required for decryption. 
		** Because this method only specifies the certificate, a prerequisite is that 
		** the certificate w/ private key must have been pre-installed on the computer. 
		** Private keys are stored in the Windows Protected Store 
		** (either a user account specific store, or the system-wide store). 
		** The Chilkat component will automatically locate and find the certificate's 
		** corresponding private key from the protected store when decrypting.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, luReturn AS Unknown, ;
		loException AS Exception, liReturn AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetDecryptCert(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setdecryptcert2		&& Sets the digital certificate to be used for decryption when the CryptAlgorithm property is set to "PKI". The private key is supplied in the 2nd argument to this method, so there is no requirement
		*==============================================================================
		* Method:            SetDecryptCert2
		* Purpose:           Sets the digital certificate to be used for decryption 
		*                    when the CryptAlgorithm property is set to "PKI".
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChikatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Sets the digital certificate to be used for decryption 
		** when the CryptAlgorithm property is set to "PKI". 
		** The private key is supplied in the 2nd argument to this method, 
		** so there is no requirement that the certificate be pre-installed 
		** on a computer before decrypting (if this method is called).
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		toChikatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetDecryptCert2(m.loChilkatCert, loChikatPrivateKey) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setencodedaad		&& Introduced in version 9.5.0.55. Sets the authenticated additional data from an encoded string. The authenticated additional data (AAD), if any, is used in authenticated encryption modes such as GCM.
		*==============================================================================
		* Method:            SetEncodedAAD
		* Purpose:           Sets the authenticated additional data from an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAADString -- the AAD string to encode
		*                    tcEncoding -- the encoding to use.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** Sets the authenticated additional data from an encoded string. 
		** The authenticated additional data (AAD), if any, 
		** is used in authenticated encryption modes such as GCM. 
		** The aadStr argument can be set to any of the following strings: 
		** "base64", "hex", "quoted-printable", "ascii", or "url".
		** 
		** The Aad is used when the CipherMode is "gcm" (Galois/Counter Mode), 
		** which is a mode valid for symmetric ciphers that have a block size of 16 bytes, 
		** such as AES or Twofish.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcAADString AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 55
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetEncodedAAD(;
		        m.tcAADString, m.tcEncoding) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setencodedauthtag		&& Introduced in version 9.5.0.55. Sets the expected authenticated tag from an encoded string. The authenticated tag is used in authenticated encryption modes such as GCM.
		*==============================================================================
		* Method:            SetEncodedAuthTag
		* Purpose:           Sets the expected authenticated tag from an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAuthenticatedTag -- the AAD string to encode
		*                    tcEncoding -- the encoding to use.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** Sets the expected authenticated tag from an encoded string. 
		** The authenticated tag is used in authenticated encryption modes such as GCM. 
		** An application would set the expected authenticated tag prior to decrypting. 
		** The authTagStr argument can be set to any of the following strings: 
		** "base64", "hex", "quoted-printable", "ascii", or "url".
		** 
		** The authenticated tag plays a role when the CipherMode is "gcm" (Galois/Counter Mode), 
		** which is a mode valid for symmetric block ciphers that have a block size of 16 bytes, 
		** such as AES or Twofish.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcAuthenticatedTag AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 55
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
