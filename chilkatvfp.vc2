		*                    tcURL, the URL to send the request. 
		*                    toChilkatStringBuilder, a Chilkat String Builder object.
		*                    tcCharset, the character set of the HTTP request body.
		*                    tcContentType, the HTTP content type.
		*                    tuMD5Header, set to 1 to add MD5 header to tcLocalFilePath.
		*                    tuGZip, set to 1 if toChilkatStringBuilder is gZip compressed.
		* Returns:           Chilkat HTTP Response Object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** The same as PText, but the data to be uploaded is passed in textData.
		**
		** Starting in version 97: 
		**
		** If the HTTP verb is “OPTIONS”, then Chilkat will now allow for the path to be “*”. 
		** Previously, Chilkat forced the path in the HTTP start line to begin with a “/”. 
		** Also, when the HTTP verb is OPTIONS, no “Content-Length” header
		** will be included in the request.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcVerb AS Character, tcURL AS Character, ;
		toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, tcCharset AS Character, ;
		tcContentType AS Character, tuMD5Header AS Unknown, tuGZip AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loChilkatHTTPResponse AS CHILKAT_HTTPRESPONSE_COM_CALL, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		liMD5Header AS Integer, liGZip AS Integer
		
		STORE 0 TO m.liMD5Header, m.liGZip 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatHTTPResponse, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liMD5Header = .LogicalToBit(m.tuMD5Header)
		      liGZip = .LogicalToBit(m.tuGZip)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        loChilkatHTTPResponse = m.loChilkatObject.PTextSb(m.tcVerb, m.tcURL, ;
		        m.loChilkatStringBuilder, m.tcCharset, m.tcContentType, m.liMD5Header, m.liGZip)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.loChilkatHTTPResponse
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loChilkatHTTPResponse = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

