	PROCEDURE todsn		&& Introduced in version 11.0.0. Creates a new Delivery Status Notification (DSN) email in the format specified by RFC 3464. The DSN email is generated in dsnEmail. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ToDSN
		* Purpose:           Creates a new Delivery Status Notification (DSN) email 
		*                    in the format specified by RFC 3464. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcExplanation -- the explanation / notification
		*                    tcStatusFields -- the relevant status fields
		*                    tuHeaderOnly -- Flag to determine if a header only email
		*                    toChilkatEmail -- A Chilkat Email object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Creates a new Delivery Status Notification (DSN) email in the format specified by RFC 3464. 
		** The DSN email is generated in dsnEmail.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcExplanation AS Character, tcStatusFields AS Character, ;
		tuHeaderOnly AS Unknown, toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liHeaderOnly AS Integer, llImplemented AS Logical, liReturn AS Integer, ;
		luReturn AS Unknown, loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX]
		
		STORE 0 TO m.liReturn, m.luReturn, m.liHeaderOnly
		STORE NULL TO m.loChilkatObject, m.loChilkatEmail, m.loParkParameterEmail, m.loException
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liHeaderOnly = .LogicalToBit(m.tuHeaderOnly)
		
		      loParkParameterEmail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ToDSN(m.tcExplanation, ;
		        m.tcStatusFields, m.liHeaderOnly, m.loChilkatEmail) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
