	PROCEDURE signhashenc		&& Introduced in version 9.5.0.90. Digitally signs a hash and returns the PKCS7 detached digital signature as an encoded string. The hash to be signed is passed in encodedHash.
		*==============================================================================
		* Method:            SignHashENC
		* Purpose:           Digitally signs a hash and returns the PKCS7 
		*                    detached digital signature as an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedHash -- the encoded hash to sign.
		*                    tcHashAlgorithm -- the hash algorithm used for the hash.
		*                    tcHashEncoding -- the hash encoding.
		* Returns:           The encoded signed string.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.90
		**
		** Digitally signs a hash and returns the PKCS7 detached digital signature as an encoded string. 
		** The hash to be signed is passed in encodedHash. The type of hash is passed in hashAlg, 
		** which can be "sha1", "sha256", "sha384", "sha512", etc. 
		** The hashEncoding specifies the encoding of the hash passed in encodedHash, 
		** such as "base64", "hex", etc.
		** 
		** A certificate must be set by calling SetSigningCert prior to calling this method. 
		** The Charset property controls the character encoding of the string that is signed. 
		** To sign Unicode data (2 bytes per char), set the Charset property to "Unicode". 
		** To implicitly convert the string to a mutlibyte charset such as "iso-8859-1", 
		** "Shift_JIS", "utf-8", or something else, then set the Charset property 
		** to the name of the charset before signing.
		** 
		** The encoding of the output string is controlled by the EncodingMode property, 
		** which can be set to "base64", "hex", etc.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncodedHash AS Character, ;
		tcHashAlgorithm AS Character, tcHashEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 90
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcEncodedString = ;
		        m.loChilkatObject.SignHashENC(m.tcEncodedHash, m.tcHashAlgorithm, m.tcHashEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

