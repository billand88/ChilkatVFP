	PROCEDURE createremotedir		&& Creates a directory on the FTP server. If the directory already exists, a new one is not created and 0 is returned. If the remoteDirPath contains non-English characters, it may be necessary to set the DirListingCharset property equal to "utf-8".
		*==============================================================================
		* Method:            CreateRemoteDir
		* Purpose:           Creates a directory on the FTP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteDirectory -- the remote directory.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates a directory on the FTP server. If the directory already exists, 
		** a new one is not created and 0 is returned.
		**
		** If the remoteDirPath contains non-English characters, 
		** it may be necessary to set the DirListingCharset property equal to "utf-8". 
		** Please refer to the documentation for the DirListingCharset property.
		**
		** Fix for version 98: Fixed situation where CreateRemoteDir is called, 
		** but the remote directory already exists. 
		** In this case, CreateRemoteDir will now return success.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcRemoteDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CreateRemoteDir(m.tcRemoteDirectory) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE createremotedirasync		&& Creates an asynchronous task to call the CreateRemoteDir method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            CreateRemoteDirAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    CreateRemoteDir method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteDirectory, the remote directory to change.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the CreateRemoteDir method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Fix for version 98: Fixed situation where CreateRemoteDir is called, 
		** but the remote directory already exists. 
		** In this case, CreateRemoteDir will now return success.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemoteDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.CreateRemoteDirAsync(m.tcRemoteDirectory)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE crlfmode_access		&& Access method used to retrieve the Chilkat CRLFMode property.
		*==============================================================================
		* Method:            CRLFMode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 CRLFMode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CRLFMode
		* Date Added:        02/24/2022
		*==============================================================================
		
		**
		** Used to control CRLF line endings when downloading text files in ASCII mode. 
		** The default value is 0.
		**
		** Possible values are:
		**
		** 0 = Do nothing.  The line-endings are not modified as received from the FTP server.
		** 1 = Convert all line-endings to CR+LF
		** 2 = Convert all line-endings to bare LF's
		** 3 = Convert all line-endings to bare CR's
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE crlfmode_assign		&& Assign method used to hold a reference to the CRLFMode property.
		*==============================================================================
		* Method:            CRLFMode_Assign
		* Purpose:           Assign method used to hold a reference to the CRLFMode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the CRLFMode property.
		* Returns:           
		* Date Added:        02/24/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [CRLFMode]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

