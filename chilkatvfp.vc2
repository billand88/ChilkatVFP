		m.loParkParameterSecureStringUserName, m.loChilkatSecureStringUserName, ;
		m.loParkParameterSecureStringPassword, m.loChilkatSecureStringPassword, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  toChilkatSecureStringUserName = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatSecureStringPassword = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loParkParameterSecureStringUserName = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterSecureStringPassword = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterSshKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureStringUserName = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loChilkatSecureStringPassword = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE authenticatesecpwpkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the AuthenticateSecPwPk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            AuthenticateSecPwPKAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    AuthenticateSecPwPK method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSecureStringUserName, 
		*                    a Chilkat Secure String object holding the user name.
		*                    toChilkatSecureStringPassword, 
		*                    a Chilkat Secure String object holding the password.
		*                    toChilkatSshKey, a Chilkat SSH Key.
		* Returns:           loChilkatTask, a Chilkat Task object.
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Creates an asynchronous task to call the AuthenticateSecPwPK method 
		** with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatSecureStringUserName AS CHILKAT_SECURESTRING_COM_CALL, ;
		toChilkatSecureStringPassword AS CHILKAT_SECURESTRING_COM_CALL, ;
		toChilkatSshKey AS CHILKAT_SSHKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		loParkParameterSecureStringUserName AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureStringUserName AS CHILKAT_SECURESTRING_COM_CALL, ;
		loParkParameterSecureStringPassword AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureStringPassword AS CHILKAT_SECURESTRING_COM_CALL, ;
		loParkParameterSshKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSshKey AS CHILKAT_SSHKEY_COM_CALL, llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, ;
		m.loParkParameterSecureStringUserName, m.loChilkatSecureStringUserName, ;
		m.loParkParameterSecureStringPassword, m.loChilkatSecureStringPassword, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSecureStringUserName = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureStringUserName)
		
		      loParkParameterSecureStringPassword = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureStringPassword)
		
		      loParkParameterSshKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSshKey)
		
		      loChilkatSecureStringUserName = m.loParkParameterSecureStringUserName.GetObject()
		      loChilkatSecureStringPassword = m.loParkParameterSecureStringPassword.GetObject()
		      loChilkatSshKey = m.loParkParameterSshKey.GetObject()
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.AuthenticateSecPwPKAsync(;
		        m.loChilkatSecureStringUserName, m.loChilkatSecureStringPassword, m.loChilkatSshKey)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSecureStringUserName = m.loParkParameterSecureStringUserName.SetObject(;
		      m.toChilkatSecureStringUserName, m.loChilkatSecureStringUserName)
		
		      toChilkatSecureStringPassword = m.loParkParameterSecureStringPassword.SetObject(;
		      m.toChilkatSecureStringPassword, m.loChilkatSecureStringPassword)
		
		      toChilkatSshKey = m.loParkParameterSshKey.SetObject(m.toChilkatSshKey, m.loChilkatSshKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureStringUserName, m.loChilkatSecureStringUserName, ;
		m.loParkParameterSecureStringPassword, m.loChilkatSecureStringPassword, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  toChilkatSecureStringUserName = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatSecureStringPassword = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loParkParameterSecureStringUserName = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterSecureStringPassword = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterSshKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureStringUserName = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loChilkatSecureStringPassword = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE authfailreason_access		&& Access method used to retrieve the Chilkat SSH AuthFailReason property.
		*==============================================================================
		* Method:            AuthFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH AuthFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AuthFailReason
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Set to one of the following values if a call to 
		** AuthenticatePw, AuthenticatePk, or AuthenticatePwPk returns a failed status.
		** 
		** 1: Transport failure. This is a failure to communicate with the server 
		** (i.e. the connection was lost, or a read or write failed or timed out).
		** 2: Invalid key for public key authentication. 
		** The key was not a valid format, not a valid key, 
		** not a private key, or not the right type of key.
		** 3: No matching authentication methods were available.
		** 4: SSH authentication protocol error - an unexpected or invalid message was received.
		** 5: The incorrect password or private key was provided.
		** 6: Already authenticated. The SSH session is already authenticated.
		** 7: Password change request: The server requires the password to be changed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE authfailreason_assign		&& Assign method used to hold a reference to the AuthFailReason property.
		*==============================================================================
		* Method:            AuthFailReason_Assign
		* Purpose:           Assign method used to hold a reference to the AuthFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the AuthFailReason property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE caretcontrol_access		&& Access method used to retrieve the Chilkat SSH CaretControl property.
		*==============================================================================
		* Method:            CaretControl_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH CaretControl property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CaretControl
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Controls whether the caret character '^' is interpreted as indicating a control character. 
		** The default value of this property is 0. 
		** If set to 1, then the following sequences are interpreted as control characters 
		** in any string passed to SendReqExec or ChannelSendString.
		** 
		** ^@   00   00   NUL    Null
		** ^A   01   01   SOH    Start of Heading
		** ^B   02   02   STX    Start of Text
		** ^C   03   03   ETX    End of Text
		** ^D   04   04   EOT    End of Transmission
		** ^E   05   05   ENQ    Enquiry
		** ^F   06   06   ACK    Acknowledge
		** ^G   07   07   BEL    Bell
		** ^H   08   08   BS     Backspace
		** ^I   09   09   HT     Character Tabulation, Horizontal Tabulation
		** ^J   10   0A   LF     Line Feed
		** ^K   11   0B   VT     Line Tabulation, Vertical Tabulation
		** ^L   12   0C   FF     Form Feed
		** ^M   13   0D   CR     Carriage Return
		** ^N   14   0E   SO     Shift Out
		** ^O   15   0F   SI     Shift In
		** ^P   16   10   DLE    Data Link Escape
		** ^Q   17   11   DC1    Device Control One (XON)
		** ^R   18   12   DC2    Device Control Two
		** ^S   19   13   DC3    Device Control Three (XOFF)
		** ^T   20   14   DC4    Device Control Four
		** ^U   21   15   NAK    Negative Acknowledge
		** ^V   22   16   SYN    Synchronous Idle
		** ^W   23   17   ETB    End of Transmission Block
		** ^X   24   18   CAN    Cancel
		** ^Y   25   19   EM     End of medium
		** ^Z   26   1A   SUB    Substitute
		** ^[   27   1B   ESC    Escape
		** ^\   28   1C   FS     File Separator
		** ^]   29   1D   GS     Group Separator
		** ^^   30   1E   RS     Record Separator
		** ^_   31   1F   US     Unit Separator
		** ^?   127  7F   DEL    Delete
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE caretcontrol_assign		&& Assign method used to hold a reference to the CaretControl property.
		*==============================================================================
		* Method:            CaretControl_Assign
		* Purpose:           Assign method used to hold a reference to the CaretControl property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the CaretControl property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE channelisopen		&& Returns 1 if the channel indicated by channelNum is open. Otherwise returns 0.
		*==============================================================================
		* Method:            ChannelIsOpen
		* Purpose:           Returns 1 if the channel indicated by channelNum is open.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** Returns 1 if the channel indicated by channelNum is open. Otherwise returns 0.
		**
		
		LPARAMETERS tiChannel AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ChannelIsOpen(m.tiChannel) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE channelopenfailcode_access		&& Access method used to retrieve the Chilkat SSH ChannelOpenFailCode property.
		*==============================================================================
		* Method:            ChannelOpenFailCode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH ChannelOpenFailCode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ChannelOpenFailCode
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** If a request to open a channel fails, 
		** this property contains a code that identifies the reason for failure. 
		** The reason codes are defined in RFC 4254 and are reproduced here:
		** 
		**              Symbolic name                           reason code
		**              -------------                           -----------
		**             SSH_OPEN_ADMINISTRATIVELY_PROHIBITED          1
		**             SSH_OPEN_CONNECT_FAILED                       2
		**             SSH_OPEN_UNKNOWN_CHANNEL_TYPE                 3
		**             SSH_OPEN_RESOURCE_SHORTAGE                    4
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE channelopenfailcode_assign		&& Assign method used to hold a reference to the ChannelOpenFailCode property.
		*==============================================================================
		* Method:            ChannelOpenFailCode_Assign
		* Purpose:           Assign method used to hold a reference to the ChannelOpenFailCode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the ChannelOpenFailCode property.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

