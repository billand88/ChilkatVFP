	PROCEDURE getpkcs8		&& Gets the private key in unencrypted PKCS8 format.
		*==============================================================================
		* Method:            GetPKCS8
		* Purpose:           Gets the private key in unencrypted PKCS8 format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The private key in PEM format.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Gets the private key in unencrypted PKCS8 format.
		** 
		** RSA keys are returned in PKCS8 ASN.1 DER format:
		** 
		**   SEQUENCE                  // PrivateKeyInfo
		**   +- INTEGER                // Version - 0 (v1998)
		**   +- SEQUENCE               // AlgorithmIdentifier
		**      +- OID                 // 1.2.840.113549.1.1.1
		**      +- NULL                // Optional Parameters
		**   +- OCTETSTRING            // PrivateKey
		**      +- SEQUENCE            // RSAPrivateKey
		**         +- INTEGER(0)       // Version - v1998(0)
		**         +- INTEGER(N)       // N
		**         +- INTEGER(E)       // E
		**         +- INTEGER(D)       // D
		**         +- INTEGER(P)       // P
		**         +- INTEGER(Q)       // Q
		**         +- INTEGER(DP)      // d mod p-1
		**         +- INTEGER(DQ)      // d mod q-1
		**         +- INTEGER(Inv Q)   // INV(q) mod p
		** 
		** DSA keys are returned in this ASN.1 DER format:
		** 
		**   SEQUENCE                 // PrivateKeyInfo
		**   +- INTEGER                 // Version
		**   +- SEQUENCE              // AlgorithmIdentifier
		**       +- OID                       // 1.2.840.10040.4.1
		**       +- SEQUENCE           // DSS-Params (Optional Parameters)
		**     +- INTEGER(P)      // P
		**     +- INTEGER(Q)      // Q
		**     +- INTEGER(G)      // G
		**       +- OCTETSTRING             // PrivateKey
		**     +- INTEGER(X)      // DSAPrivateKey X
		** 
		** ECC keys are returned in this ASN.1 DER format:
		** 
		**   (from RFC 5915)
		**   ECPrivateKey ::= SEQUENCE {
		**       version        INTEGER { ecPrivkeyVer1(1) } (ecPrivkeyVer1),
		**       privateKey     OCTET STRING,
		**       parameters [0] ECParameters {{ NamedCurve }} OPTIONAL,
		**       publicKey  [1] BIT STRING OPTIONAL (This is the ANSI X9.63 public key format.)
		**
		** Fixed in version 99: Chilkat’s internal ASN.1 decoder 
		** needed an update to correctly handle 0-length ASN.1 
		** bit strings (which is something not normally encountered).
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, lqPEMPrivateKey AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqPEMPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqPEMPrivateKey = m.loChilkatObject.GetPKCS8()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqPEMPrivateKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getpkcs8enc		&& Introduced in version 9.5.0.52. Gets the private key in unencrypted PKCS8 format and returned in an encoded string, as specified by the encoding argument. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetPKCS8ENC
		* Purpose:           Gets the private key in unencrypted PKCS8 format 
		*                    and returned in an encoded string as specified by the encoding argument.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncoding, the private key encoding.
		* Returns:           The private character encoded PKCS8 key.
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Gets the private key in unencrypted PKCS8 format and returned in an encoded string,
		** as specified by the encoding argument.
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRIVATEKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcEncodedPrivatePKCS8Key AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedPrivatePKCS8Key = []
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcEncodedPrivatePKCS8Key = m.loChilkatObject.GetPKCS8ENC(m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedPrivatePKCS8Key
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

