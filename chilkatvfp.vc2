	PROCEDURE transfermultiplemime		&& Same as FetchMultipleMime except that the downloaded emails are also deleted from the server. Returns a null reference on failure. Returns Nothing on failure
		*==============================================================================
		* Method:            TransferMultipleMIME
		* Purpose:           Same as TransferMIME except that the downloaded 
		*                    emails are also deleted from the server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringArray, a Chilkat String Array object.
		* Returns:           Chilkat String Array object, or NULL
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Same as TransferMIME except that the downloaded emails are also deleted from the server. 
		** Returns a null reference on failure.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterStringArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL, ;
		loException AS Exception, loChilkatStringArrayTransfer AS CHILKAT_STRINGARRAY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatStringArrayTransfer, m.loParkParameterStringArray, m.loChilkatStringArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		     loParkParameterStringArray = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringArray)
		
		    loChilkatStringArray = m.loParkParameterStringArray.GetObject()
		
		    TRY
		
		      loChilkatStringArrayTransfer = ;
		      m.loChilkatObject.TransferMultipleMIME(m.loChilkatStringArray)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatStringArray = m.loParkParameterStringArray.SetObject(;
		    m.toChilkatStringArray, m.loChilkatStringArray)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringArray, m.loChilkatStringArray
		
		RETURN m.loChilkatStringArrayTransfer
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL) 
		  loParkParameterStringArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loChilkatStringArrayTransfer = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

