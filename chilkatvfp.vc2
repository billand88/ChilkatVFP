	ENDPROC

	PROCEDURE smtprecipientslog		&& Introduced in version 11.0.0. Returns a list of email addresses rejected or accepted by the SMTP server from the last call of an email-sending method, like SendEmail. Returns rejected email addresses if rejected is 1.
		*==============================================================================
		* Method:            SmtpRecipientsLog
		* Purpose:           Returns a list of email addresses 
		*                    rejected or accepted by the SMTP server.
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageNumber - the email message number to retrieve.
		*                    toChilkatStringTable, a Chilkat String Table object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/07/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Returns a list of email addresses rejected or accepted by the SMTP server 
		** from the last call of an email-sending method, like SendEmail. 
		** Returns rejected email addresses if rejected is 1. 
		** Otherwise returns accepted email addresses.
		**
		** Invalid email addresses identified by the SMTP server are stored in a bad email addresses list, 
		** while valid ones are stored in a good email addresses list within the object. 
		** Both lists reset automatically at the beginning of each new mail-sending call, 
		** allowing you to track which addresses were accepted or rejected.
		** 
		** Note: A the time of the SMTP session, the SMTP server can only verify 
		** the validity of an email address within its own domain because it has access 
		** to its internal user database or mailbox configuration. 
		** Addresses outside its domain, are implicitly accepted and the validity 
		** of the email address won't be discovered until arrives at the destination mail server.
		** 
		
		LPARAMETERS tuRejections AS Unknown, toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL, liReturn AS Integer, ;
		liRejections AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liRejections
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liRejections = .LogicalToBit(m.tuRejections)
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SmtpRecipientsLog(m.liRejections, ;
		        m.loChilkatStringTable) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = ;
		      m.loParkParameterStringTable.SetObject(m.toChilkatStringTable, m.loChilkatStringTable)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE smtpreset		&& Sends an RSET command to the SMTP server. This method is rarely needed. The RSET command resets the state of the connection to the SMTP server to the initial state (so that the component can proceed with sending a new email).
		*==============================================================================
		* Method:            SMTPReset
		* Purpose:           Sends an RSET command to the SMTP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Sends an RSET command to the SMTP server. This method is rarely needed. 
		** The RSET command resets the state of the connection to the SMTP server to the initial state 
		** (so that the component can proceed with sending a new email). 
		** The SmtpReset method would only be needed if a mail-sending method failed 
		** and left the connection with the SMTP server open and in a non-initial state. 
		** (A situation that is probably not even possible with the Chilkat mail component.)
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SMTPReset() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE smtpresetasync		&& Creates an asynchronous task to call the SmtpReset method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SMTPResetAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    SmtpReset method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the SmtpReset method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.SMTPResetAsync()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE smtpsendrawcommand		&& Sends a raw command to the SMTP server and returns the SMTP server's response.
		*==============================================================================
		* Method:            SMTPSendRawCommand
		* Purpose:           Sends a raw command to the SMTP server and returns the SMTP server's response.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRawCommand -- the Raw command to send
		*                    tcCharacterSet -- character set to be used in sending the command
		*                    tuEncodeBase64 -- return value in Base64 encoded format.
		* Returns:           Character
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Sends a raw command to the SMTP server and returns the SMTP server's response. 
		** If non-us-ascii characters are included in command, then charset indicates 
		** the charset to be used in sending the command 
		** (such as "utf-8", "ansi", "iso-8859-1", "Shift_JIS", etc.)
		**
		** If bEncodeBase64 is 1, then the response is returned in Base64-encoded format. 
		** Otherwise the raw response is returned.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRawCommand AS Character, ;
		tcCharacterSet AS Character, tuEncodeBase64 AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liEncodeBase64 AS Integer, lcReturn AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		liEncodeBase64 = 0
		lcReturn = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liEncodeBase64 = .LogicalToBit(m.tuEncodeBase64)
		
		    TRY
		
		      lcReturn = m.loChilkatObject.SMTPSendRawCommand(;
		      m.tcRawCommand, m.tcCharacterSet, m.liEncodeBase64)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

