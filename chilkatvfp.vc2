	PROCEDURE openzip		&& Opens a Zip archive. Encrypted and password-protected zips may be opened without providing the password, but their contents may not be unzipped unless the correct password is provided via the DecryptPassword proprety, or the SetPassword method.
		*==============================================================================
		* Method:            OpenZIP
		* Purpose:           Opens a Zip archive.
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEmbeddedZIPFile -- the embedded ZIP file to open.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Opens a Zip archive. 
		** Encrypted and password-protected zips may be opened without providing the password, 
		** but their contents may not be unzipped unless the correct password is provided 
		** via the DecryptPassword proprety, or the SetPassword method.
		** 
		** When a zip is opened, the PasswordProtect 
		** and Encryption properties will be appropriately set. 
		** If the zip is password protected (i.e. uses older Zip 2.0 encrypion), 
		** then the PasswordProtect property will be set to 1. 
		** If the zip is strong encrypted, 
		** the Encryption property will be set to a value 1 through 4, 
		** where 4 indicates WinZip compatible AES encryption.
		**
		** Fix for version 87: Fixed ZIP64 problems encountered 
		** when opening a ZIP64 file, removing entries, and rewriting. 
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEmbeddedZIPFile AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.OpenZIP(m.tcEmbeddedZIPFile) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE openzipasync		&& Creates an asynchronous task to call the OpenZip method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            OpenZIPAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    OpenZIP method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcZIPDirectoryPath -- the directory path to the ZIP file.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        05/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the OpenZIP method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Fixed in Version 55: Fixed a problem with this method 
		** where the 1st call would succeed, but subsequent calls would fail.
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Fix for version 87: Fixed ZIP64 problems encountered 
		** when opening a ZIP64 file, removing entries, and rewriting. 
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcZIPDirectoryPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.OpenZIPAsync(m.tcZIPDirectoryPath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE overwriteexisting_access		&& Access method used to retrieve the Chilkat ZIP OverwriteExisting property.
		*==============================================================================
		* Method:            OverwriteExisting_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIP OverwriteExisting property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.OverwriteExisting
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** Determines whether existing files are overwritten during unzipping. 
		** The default is 1, which means that already-existing files will be overwritten. 
		** Set this property = 0 to prevent existing files 
		** from being overwritten when unzipping.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE overwriteexisting_assign		&& Assign method used to hold a reference to the OverwriteExisting property.
		*==============================================================================
		* Method:            OverwriteExisting_Assign
