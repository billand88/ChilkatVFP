	PROCEDURE getoutputjson		&& Introduced in version 11.6.0. Returns the model's structured JSON output from the most recent Ask, parsed into json. Use this after setting a schema with SetOutputSchema . Returns 1 and populates json when the output is valid JSON.
		*==============================================================================
		* Method:            GetOutputJson
		* Purpose:           Returns the model's structured JSON output from the most recent Ask.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObject, a Chilkat Json object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Returns the model's structured JSON output from the most recent Ask, parsed into json. 
		** Use this after setting a schema with SetOutputSchema. Returns 1 and populates json 
		** when the output is valid JSON. Returns 0 if the model refused to produce the output 
		** (in which case LastResponseRefused is 1 and RefusalText contains the explanation), 
		** if there is no output, or if the output is not valid JSON. 
		**
		** The raw JSON text is also available from GetOutputText.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJsonObject AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJson AS [Chilkat.JsonObject], liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJson
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatJson)
		
		      loChilkatJson = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetOutputJson(m.loChilkatJson) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterBinData.SetObject(m.oChilkatJson, m.loChilkatJson)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJson
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJson = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getoutputtext		&& Introduced in version 11.2.0. Returns the text output from the last call to Ask. Returns Nothing on failure
		*==============================================================================
		* Method:            GetOutputText
		* Purpose:           Returns the text output from the last call to Ask.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           lcTextOutput, the text output.
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** Introduced in version 11.2.0.
		**
		** Returns the text output from the last call to Ask.
		**
		** Returns nothing on failure.
		** 
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, lcTextOutput AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcTextOutput = []
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 2, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcTextOutput = m.loChilkatObject.GetOutputText()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcTextOutput
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

