	PROCEDURE resumedownloadfilebyname		&& Resumes an SFTP download. The size of the localFilePath is checked and the download begins at the appropriate position in the remoteFilePath. If localFilePath is empty or non-existent, then this method is identical to DownloadFileByName.
		*==============================================================================
		* Method:            ResumeDownloadFileByName
		* Purpose:           Resumes an SFTP download.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteFilePath -- the remote file to download.
		*                    tcLocalFilePath, the path to the local file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Resumes an SFTP download. 
		** The size of the localFilePath is checked and the download begins 
		** at the appropriate position in the remoteFilePath. 
		** If localFilePath is empty or non-existent, 
		** then this method is identical to DownloadFileByName. 
		** If the localFilePath is already fully downloaded, 
		** then no additional data is downloaded and the method will return 1.
		**
		** Fixed for Version 23: If the complete file already exists locally 
		** such that nothing needed to be downloaded, 
		** the method incorrectly returned a failed status. This has been fixed.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcRemoteFilePath AS Character, tcLocalFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ResumeDownloadFileByName(;
		      m.tcRemoteFilePath, m.tcLocalFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

