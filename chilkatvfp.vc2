	PROCEDURE saveallattachments		&& Save all the attachments of an email to files in a directory specified by dirPath. The OverwriteExisting property controls whether existing files are allowed to be overwritten.
		*==============================================================================
		* Method:            SaveAllAttachments
		* Purpose:           Save all the attachments of an email 
		*                    to files in a directory specified by dirPath.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectoryPath, the directory path to the save the attachments.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Save all the attachments of an email to files in a directory specified by dirPath. 
		** The OverwriteExisting property controls whether existing files are allowed to be overwritten.
		**
		** Note: Email attachment filenames can be renamed or modified prior to saving. 
		** The number of attachments is available in the NumAttachments property. 
		** An application can loop over the attachments to get the filename 
		** for each by calling GetAttachmentFilename(index). 
		** Each attachment's filename can be set by calling SetAttachmentFilename(index, newFilename).
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcDirectoryPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SaveAllAttachments(m.tcDirectoryPath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

