	PROCEDURE haschildwithtag		&& Returns 1 if the node has a child with the given tag (or tag path). Otherwise returns 0. Beginning in version 9.5.0.64, the tagPath can be a tag path. A tag path is a series of tags separated by vertical bar characters.
		*==============================================================================
		* Method:            HasChildWithTag
		* Purpose:           Returns 1 if the node has a child with the given tag (or tag path).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTagPath -- the tag or tagpath to search for.
		* Returns:           Returns 1 for true, 0 for false.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Returns 1 if the node has a child with the given tag (or tag path). Otherwise returns 0.
		** 
		** Beginning in version 9.5.0.64, the tagPath can be a tag path. 
		** A tag path is a series of tags separated by vertical bar characters. 
		** For example: "tagA|tagB|tagC".
		**
		** Fix for version 76: If the tagPath ended with array brackets, then the method failed. 
		** For example, if the tagPath was “something[i]”, then it did not work. 
		** If however, the tagPath was “something[i]|another”, then it worked.
		**
		
		LPARAMETERS tcTagPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.HasChildWithTag(m.tcTagPath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

