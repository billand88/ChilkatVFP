		*                    ttExpiration, an expiration DateTime value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Undocumented method! 
		**
		** Assumed that the second parameter is a VFP DateTime value.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCacheKey AS Character, ttExpiration AS DateTime
		
		LOCAL loChilkatObject AS CHILKAT_CACHE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UpdateExpiration(m.tcCacheKey, m.ttExpiration) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CACHE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE updateexpirationdt		&& The same as UpdateExpiration, except the expireDateTime is passed as a CkDateTime. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UpdateExpirationDt
		* Purpose:           The same as UpdateExpiration, 
		*                    except the expireDateTime is passed as a CkDateTime.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCacheKey -- the key to against.
		*                    toChilkatCkDateTime, a Chilkat Date Time object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** The same as UpdateExpiration, except the expireDateTime is passed as a CkDateTime.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCacheKey AS Character, toChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CACHE_COM_CALL, ;
		loParkParameterCkDateTime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterStringBuilder = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTime)
		
		    loChilkatCkDateTime = m.loParkParameterCkDateTime.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.UpdateExpirationDt(m.tcCacheKey, m.loChilkatCkDateTime) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCkDateTime = m.loParkParameterCkDateTime.SetObject(;
		    m.toChilkatCkDateTime, m.loChilkatCkDateTime)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CACHE_COM_CALL)
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loParkParameterCkDateTime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE updateexpirationstr		&& The same as UpdateExpiration, except the expireDateTime is passed in RFC822 string format. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UpdateExpirationStr
		* Purpose:           The same as UpdateExpiration, except the expireDateTime 
