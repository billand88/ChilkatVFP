		RETURN
	ENDPROC

	PROCEDURE decode		&& Decodes an encoded string and returns the original data. The encoding mode is determined by encoding. It may be "base64", "hex", "quoted-printable", or "url". Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            Decode
		* Purpose:           Decodes an encoded string and returns the original data.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedString -- the string name to compress
		*                    tcEncoding -- the string charset
		* Returns:           The unencoded data.
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Decodes an encoded string and returns the original data. 
		** The encoding mode is determined by encoding. 
		** It may be "base64", "hex", "quoted-printable", or "url".
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcEncodedString AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, lqData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqData = m.loChilkatObject.Decode(m.tcEncodedString, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE deflatestringenc		&& Provides the ability to use the zip/gzip's deflate algorithm directly to compress a string. Internal to this method, inString is first converted to the charset specified by charsetName.
		*==============================================================================
		* Method:            DeflateStringEnc
		* Purpose:           Provides the ability to use the zip/gzip's deflate 
		*                    algorithm directly to compress a string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string name to compress
		*                    tcCharset -- the string charset
		*                    tcEncoding -- the encoding of the returned string
		* Returns:           Character
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Provides the ability to use the zip/gzip's deflate algorithm 
		** directly to compress a string. Internal to this method, 
		** inString is first converted to the charset specified by charsetName. 
		** The data is then compressed using the deflate compression algorithm. 
		** The binary output is then encoded according to outputEncoding. 
		** Possible values for outputEncoding are "hex", "base64", "url", and "quoted-printable".
		** 
		** Note: The output of this method is compressed data with no Gzip file format. 
		** Use the Compress* methods to produce Gzip file format output.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcString AS Character, tcCharset AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, lcEncodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedString = ;
		      m.loChilkatObject.DeflateStringEnc(m.tcString, m.tcCharset, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

