	PROCEDURE gethostkeyfp		&& Introduced in version 9.5.0.92. Returns the host key fingerprint of the server, which is automatically set after connecting to an SSH/SFTP server.
		*==============================================================================
		* Method:            GetHostKeyFP
		* Purpose:           Returns the host key fingerprint of the server, 
		*                    which is automatically set after connecting to an SSH/SFTP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHashAlgorithm -- a supported Chilkat Hash Algorithm
		*                    tuIncludeKeyType, whether or not to include the key type.
		*                    tuIncludeHashName, whether or not to include the hash name.
		* Returns:           The host key fingerprint of the server.
		* Date Added:        08/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.92
		**
		** Returns the host key fingerprint of the server, which is automatically set 
		** after connecting to an SSH/SFTP server. The hashAlg can be any hash algorithm 
		** supported by Chilkat, such as "SHA256", "SHA384", "SHA512", "SHA1", "MD5", 
		** "SHA3-224", "SHA3-256", "SHA3-384", "SHA3-512", etc.
		** 
		** If both includeKeyType and includeHashName are 1, 
		** then the fingerprint string is formatted like this:
		** 
		**   ssh-rsa SHA256:L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** If includeKeyType is 1 and includeHashName is 0:
		** 
		**   ssh-rsa L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** If includeKeyType is 0 and includeHashName is 1:
		** 
		**   SHA256:L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** If includeKeyType is 0 and includeHashName is 0:
		** 
		**   L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** SSH host key types can be: ssh-rsa, ecdsa-*-* (such as ecdsa-sha2-nistp256), 
		** ssh-ed25519, and ssh-dss.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Fixed for Version 11.4.0: There was a problem in the coalescing of SSH curve names to the standard curve names 
		** used by OpenSSH in the creation of the blob that is hashed to create the fingerprint. 
		** Also, the trailing “=” chars are now automatically stripped. 
		** (Stripping the “=” padding in SSH SHA256 fingerprints is now the de-facto standard behavior 
		** across SSH implementations. )
		** 
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tcHashAlgorithm AS Character, ;
		tuIncludeKeyType AS Unknown, tuIncludeHashName AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		lcFingerPrint AS Character, liIncludeKeyType AS Integer, liIncludeHashName AS Integer, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical
		
		STORE 0 TO m.liIncludeKeyType, m.liIncludeHashName, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 92
		
		lcFingerPrint = []
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeKeyType = .LogicalToBit(m.tuIncludeKeyType)
		      liIncludeHashName = .LogicalToBit(m.tuIncludeHashName)
		
		      TRY
		
		        lcFingerPrint = ;
		        m.loChilkatObject.GetHostKeyFP(m.tcHashAlgorithm, m.liIncludeKeyType, m.liIncludeHashName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFingerPrint
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getlastjsondata		&& Introduced in version 11.0.0. Provides information about what transpired in the last method called. For many methods, there is no information. For some methods, details about what transpired can be obtained via LastJsonData.
		*==============================================================================
		* Method:            GetLastJsonData
		* Purpose:           Provides information about what transpired in the last method called.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Provides information about what transpired in the last method called. 
		** For many methods, there is no information. For some methods, details 
		** about what transpired can be obtained via LastJsonData.
		**
		** Fixed in Version 11.2.0: Many classes have a GetLastJsonData method. 
		** This method was fixed to avoid clearing the contents of the LastErrorText.
		**
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatJSONObject
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		    loChilkatJSONObject = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      m.loChilkatObject.GetLastJsonData(m.loChilkatJSONObject)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatJSONObject = ;
		    m.loParkParameterCert.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatJSONObject
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getsyncedfiles		&& Introduced in version 10.0.0. Appends to strTab the paths of the files uploaded or downloaded in the last call to SyncTreeUpload or SyncTreeDownload.
		*==============================================================================
		* Method:            GetSyncedFiles
		* Purpose:           Appends to strTable the paths of the files uploaded 
		*                    or downloaded in the last call to SyncTreeUpload or SyncTreeDownload.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringTable, a Chilkat StringTable object.
		* Returns:           
		* Date Added:        09/27/2024
		*==============================================================================
		
		**
		** Introduced in version 10.0.0
		**
		** Appends to strTab the paths of the files uploaded or downloaded in the last call 
		** to SyncTreeUpload or SyncTreeDownload. In both cases (for upload and download) 
		** each path is relative to the root synced directory.
		** 
		** Note: For SyncTreeDownload, some of entires can be the paths of local directories that were created. 
		** Local directory paths will be terminated with a "/" char to disinguish a directory from an actual file.
		** 
		
		LPARAMETERS toChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loParkParameterStringTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringTable AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL ARRAY la_Implemented(3)
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		llImplemented = .F.
		
		la_Implemented(1) = 10
		la_Implemented(2) = 0
		la_Implemented(3) = 0
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(@m.la_Implemented)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringTable = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringTable)
		
		      loChilkatStringTable = m.loParkParameterStringTable.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetSyncedFiles(m.loChilkatStringTable) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringTable = ;
		      m.loParkParameterStringTable.SetObject(m.toChilkatStringTable, m.loChilkatStringTable)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringTable, m.loChilkatStringTable
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loParkParameterStringTable = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringTable = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE hardlink		&& Introduced in version 9.5.0.71. Creates a hard link on the server using the hardlink@openssh.com extension. This only works for SFTP servers that support the hardlink@openssh.com extension.
		*==============================================================================
		* Method:            HardLink
		* Purpose:           Creates a hard link on the server 
		*                    using the hardlink@openssh.com extension.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOldPath -- the old (current) path to the file
		*                    tcNewPath, the new hard link file name
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Creates a hard link on the server using the hardlink@openssh.com extension. 
		** This only works for SFTP servers that support the hardlink@openssh.com extension.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcOldPath AS Character, tcNewPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.HardLink(m.tcOldPath, m.tcNewPath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE hardlinkasync		&& Introduced in version 9.5.0.71. Creates an asynchronous task to call the HardLink method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            HardLinkAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    HardLink method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOldPath -- the old (current) path to the file
		*                    tcNewPath, the new hard link file name
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the HardLink method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcOldPath AS Character, tcNewPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.HardLinkAsync(m.tcOldPath, m.tcNewPath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat SFTP HeartBeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        04/19/2022
		*==============================================================================
		
		**
		** This is the number of milliseconds between each AbortCheck event callback. 
		** The AbortCheck callback allows an application 
		** to abort any SSH operation prior to completion. 
		** If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
