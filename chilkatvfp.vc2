		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the PBESPassword property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE pbkdf1		&& Implements the PBKDF1 algorithm (Password Based Key Derivation Function #1). The password is converted to the character encoding represented by charset before being passed (internally) to the key derivation function.
		*==============================================================================
		* Method:            PBKDF1
		* Purpose:           Implements the PBKDF1 algorithm.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- the password to generate the hex key.
		*                    tcCharset -- the charset of the password.
		*                    tcHashAlgorithm -- the hash algorithm to use.
		*                    tcSalt -- the salt value to add.
		*                    tiIterations -- the number of iterations.
		*                    tiOutputKeyLength -- the size of the output hex key.
		*                    tcEncoding -- the encoding of the Salt and the output.
		* Returns:           The derived hex key.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Implements the PBKDF1 algorithm (Password Based Key Derivation Function #1). 
		** The password is converted to the character encoding represented by charset 
		** before being passed (internally) to the key derivation function. 
		** The hashAlg may be "md5", "sha1", "md2", etc. 
		** The salt should be random data at least 8 bytes (64 bits) in length. 
		** (The GenRandomBytesENC method is good for generating a random salt value.) 
		** The iterationCount should be no less than 1000. 
		** The length (in bits) of the derived key output 
		** by this method is controlled by outputKeyBitLen. 
		** The encoding argument may be "base64", "hex", etc. 
		** It controls the encoding of the output, and the expected encoding of the salt. 
		** The derived key is returned.
		** 
		** Note: Starting in version 9.5.0.47, if the charset is set to one of the keywords 
		** "hex" or "base64", then the password will be considered binary data 
		** that is hex or base64 encoded. The bytes will be decoded 
		** and used directly as a binary password. 
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcPassword AS Character, tcCharset AS Character, ;
		tcHashAlgorithm AS Character, tcSalt AS Character, ;
		tiIterations AS Integer, tiOutputKeyLength AS Integer, ;
		tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcHexKey AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHexKey = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcHexKey = m.loChilkatObject.PBKDF1(m.tcPassword, m.tcCharset, ;
		      m.tcHashAlgorithm, m.tcSalt, m.tiIterations, m.tiOutputKeyLength, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHexKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE pbkdf2		&& Implements the PBKDF2 algorithm (Password Based Key Derivation Function #2). The password is converted to the character encoding represented by charset before being passed (internally) to the key derivation function.
		*==============================================================================
		* Method:            PBKDF2
		* Purpose:           Implements the PBKDF2 algorithm.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- the password to generate the hex key.
		*                    tcCharset -- the charset of the password.
		*                    tcHashAlgorithm -- the hash algorithm to use.
		*                    tcSalt -- the salt value to add.
		*                    tiIterations -- the number of iterations.
		*                    tiOutputKeyLength -- the size of the output hex key.
		*                    tcEncoding -- the encoding of the Salt and the output.
		* Returns:           The derived hex key.
		* Date Added:        07/01/2022
		*==============================================================================
		
		** 
		** Implements the PBKDF2 algorithm (Password Based Key Derivation Function #2). 
		** The password is converted to the character encoding represented 
		** by charset before being passed (internally) to the key derivation function. 
		** The hashAlg may be "sha256", "sha384", "sha512", "md5", "sha1", "md2", 
		** or any hash algorithm listed in the HashAlgorithm property. 
		** The salt should be random data at least 8 bytes (64 bits) in length. 
		** (The GenRandomBytesENC method is good for generating a random salt value.) 
		** The iterationCount should be no less than 1000. 
		** The length (in bits) of the derived key output by this method 
		** is controlled by outputKeyBitLen. The encoding argument may be "base64", "hex", etc. 
		** It controls the encoding of the output, and the expected encoding of the salt. 
		** The derived key is returned.
		**
		** Note: The PBKDF2 function (internally) utilizes a PRF that is 
		** a pseudorandom function that is a keyed HMAC. 
		** The hash algorithm specified by hashAlg determines this PRF. 
		** If hashAlg is "SHA256", then HMAC-SHA256 is used for the PRF. 
		** Likewise, if the hash function is "SHA1", then HMAC-SHA1 is used. 
		** HMAC can be used with any hash algorithm.
		** 
		** Note: Starting in version 9.5.0.47, if the charset is set to one of the keywords 
		** "hex" or "base64", then the password will be considered binary data 
		** that is hex or base64 encoded. 
		** The bytes will be decoded and used directly as a binary password.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcPassword AS Character, tcCharset AS Character, ;
		tcHashAlgorithm AS Character, tcSalt AS Character, ;
		tiIterations AS Integer, tiOutputKeyLength AS Integer, ;
		tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcHexKey AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHexKey = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcHexKey = m.loChilkatObject.PBKDF2(m.tcPassword, m.tcCharset, ;
		      m.tcHashAlgorithm, m.tcSalt, m.tiIterations, m.tiOutputKeyLength, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHexKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE pkcs7cryptalg_access		&& Access method used to retrieve the Chilkat Crypt2 PKCS7CryptAlg property.
		*==============================================================================
		* Method:            PKCS7CryptAlg_Access
		* Purpose:           Access method used to retrieve the Chilkat Crypt2 PKCS7CryptAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PKCS7CryptAlg
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** When the CryptAlgorithm property is "PKI" to select PKCS7 public-key encryption, 
		** this selects the underlying symmetric encryption algorithm.
		** Possible values are: "aes", "des", "3des", and "rc2". The default value is "aes".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

