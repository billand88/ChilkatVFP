	PROCEDURE setencodedsignaturers		&& Sets the bytes of the Signature property by providing the R and S values in encoded form. (The signature must be specified prior to calling the Verify method.) The R and S values may be set via a hex or base64 encoded string.
		*==============================================================================
		* Method:            SetEncodedSignatureRS
		* Purpose:           Sets the bytes of the Signature property 
		*                    by providing the R and S values in encoded form.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncoding, the encoding for the hash
		*                    tcEncodedR, the encoded R value.
		*                    tcEncodedS, the encoded S value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Sets the bytes of the Signature property by providing the R and S values in encoded form. 
		** (The signature must be specified prior to calling the Verify method.) 
		** The R and S values may be set via a hex or base64 encoded string. 
		** The encoding should be set to either "hex" or "base64".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcEncoding AS Character, tcEncodedR AS Character, tcEncodedS AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetEncodedSignatureRS(m.tcEncoding, ;
		      m.tcEncodedR, m.tcEncodedS) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setkeyexplicit		&& Sets the DSA object's private key from explicitly provided pHex, qHex, gHex, and xHex values. The groupSizeInBytes specifies the group size (in bytes). It is typically equal to 20, which is the length of the underlying hash function (SHA-1) for signing.
		*==============================================================================
		* Method:            SetKeyExplicit
		* Purpose:           Sets the DSA object's private key from explicitly 
		*                    provided pHex, qHex, gHex, and xHex values.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiGroupSizeBytes, the group size in bytes.
		*                    tcPHex, the Hex P value.
		*                    tcQHex, the Hex Q value.
		*                    tcGHex, the Hex G value.
		*                    tcXHex, the Hex X value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Sets the DSA object's private key from explicitly provided pHex, qHex, gHex, and xHex values. 
		** The groupSizeInBytes specifies the group size (in bytes). 
		** It is typically equal to 20, which is the length of the underlying hash function 
		** (SHA-1) for signing. The pHex, qHex, gHex, and xHex values are hex-encoded SSH1-format bignums.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiGroupSizeBytes AS Integer, tcPHex AS Character, ;
		tcQHex AS Character, tcGHex AS Character, tcXHex AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetKeyExplicit(m.tiGroupSizeBytes, ;
		      m.tcPHex, m.tcQHex, m.tcGHex, m.tcXHex) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

