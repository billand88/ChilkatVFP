	PROCEDURE linkpkcs11		&& Introduced in version 9.5.0.96. Links to the certificate's private key located on an HSM (smart card, token, or cloud HSM). Once linked, the certificate can be used for signing where the signing occurs on the HSM.
		*==============================================================================
		* Method:            LinkPKCS11
		* Purpose:           Links to the certificate's private key located on an HSM.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatPkcs11, a Chilkat PKCS11 object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        10/30/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.96
		**
		** Links to the certificate's private key located on an HSM (smart card, token, or cloud HSM). 
		** Once linked, the certificate can be used for signing where the signing occurs on the HSM. 
		** See the example below for more detailed information.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatPkcs11 AS CHILKAT_PKCS11_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterPkcs11 AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPkcs11 AS CHILKAT_PKCS11_COM_CALL, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPkcs11, m.loChilkatPkcs11  
		
		llImplemented = .F.
		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPkcs11 = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPkcs11)
		
		      loChilkatPkcs11 = m.loParkParameterPkcs11.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LinkPKCS11(m.loChilkatPkcs11) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPkcs11 = ;
		      m.loParkParameterPkcs11.SetObject(m.toChilkatPkcs11, m.loChilkatPkcs11)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPkcs11, m.loChilkatPkcs11
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPkcs11 = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loParkParameterPkcs11 = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPkcs11 = NEWOBJECT(CHILKAT_PKCS11_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadbycommonname		&& (Relevant only when running on a Microsoft Windows operating system.) Searches the Windows Local Machine and Current User registry-based certificate stores for a certificate having the common name specified.
		*==============================================================================
		* Method:            LoadByCommonName
		* Purpose:           Searches the Windows Local Machine and Current User registry-based 
		*                    certificate stores for a certificate having the common name specified. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCommonName, the common name to load.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/28/2022
		*==============================================================================
		
		**
		** (Relevant only when running on a Microsoft Windows operating system.) 
		** Searches the Windows Local Machine and Current User registry-based 
		** certificate stores for a certificate having the common name specified. 
		** If found, the certificate is loaded and ready for use.
		**
		** Fixed for Version 41: Fixed a problem.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCommonName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoadByCommonName(m.tcCommonName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

