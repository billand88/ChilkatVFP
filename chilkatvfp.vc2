		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE lastreadfailed		&& Returns 1 if the last read on the specified handle failed. Otherwise returns 0.
		*==============================================================================
		* Method:            LastReadFailed
		* Purpose:           Returns 1 if the last read on the specified handle failed.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Returns 1 if the last read on the specified handle failed. 
		** Otherwise returns 0.
		**
		
		LPARAMETERS tcHandle AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LastReadFailed(m.tcHandle) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE lastreadnumbytes		&& Returns the number of bytes received by the last read on a specified channel.
		*==============================================================================
		* Method:            LastReadNumBytes
		* Purpose:           Returns the number of bytes received 
		*                    by the last read on a specified channel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		* Returns:           The number of bytes read.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Returns the number of bytes received by the last read on a specified channel.
		**
		** Fixed for version 75: Fixed this method which always returned 0.
		**
		
		LPARAMETERS tcHandle AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, liBytes AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liBytes = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liBytes = m.loChilkatObject.LastReadNumBytes(m.tcHandle)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE laststatuscode_access		&& Access method used to retrieve the Chilkat SFTP LastStatusCode property.
		*==============================================================================
		* Method:            LastStatusCode_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP LastStatusCode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastStatusCode
		* Date Added:        05/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.85
		** Contains the numeric last status code received 
		** in an SSH_FXP_STATUS message received from the SFTP server. 
		** Status codes are defined in the SFTP protocol specification as follows:
		** 
		** (See https://tools.ietf.org/id/draft-ietf-secsh-filexfer-13.txt)
		** 
		** SSH_FX_OK                            0
		** SSH_FX_EOF                           1
		** SSH_FX_NO_SUCH_FILE                  2
		** SSH_FX_PERMISSION_DENIED             3
		** SSH_FX_FAILURE                       4
		** SSH_FX_BAD_MESSAGE                   5
		** SSH_FX_NO_CONNECTION                 6
		** SSH_FX_CONNECTION_LOST               7
		** SSH_FX_OP_UNSUPPORTED                8
		** SSH_FX_INVALID_HANDLE                9
		** SSH_FX_NO_SUCH_PATH                  10
		** SSH_FX_FILE_ALREADY_EXISTS           11
		** SSH_FX_WRITE_PROTECT                 12
		** SSH_FX_NO_MEDIA                      13
		** SSH_FX_NO_SPACE_ON_FILESYSTEM        14
		** SSH_FX_QUOTA_EXCEEDED                15
		** SSH_FX_UNKNOWN_PRINCIPAL             16
		** SSH_FX_LOCK_CONFLICT                 17
		** SSH_FX_DIR_NOT_EMPTY                 18
		** SSH_FX_NOT_A_DIRECTORY               19
		** SSH_FX_INVALID_FILENAME              20
		** SSH_FX_LINK_LOOP                     21
		** SSH_FX_CANNOT_DELETE                 22
		** SSH_FX_INVALID_PARAMETER             23
		** SSH_FX_FILE_IS_A_DIRECTORY           24
		** SSH_FX_BYTE_RANGE_LOCK_CONFLICT      25
		** SSH_FX_BYTE_RANGE_LOCK_REFUSED       26
		** SSH_FX_DELETE_PENDING                27
		** SSH_FX_FILE_CORRUPT                  28
		** SSH_FX_OWNER_INVALID                 29
		** SSH_FX_GROUP_INVALID                 30
		** SSH_FX_NO_MATCHING_BYTE_RANGE_LOCK   31
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 85
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE laststatuscode_assign		&& Assign method used to hold a reference to the LastStatusCode property.
		*==============================================================================
		* Method:            LastStatusCode_Assign
		* Purpose:           Assign method used to hold a reference to the LastStatusCode property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the LastStatusCode property.
		* Returns:           
		* Date Added:        04/19/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 85
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE laststatusmessage_access		&& Access method used to retrieve the Chilkat SFTP LastStatusMessage property.
		*==============================================================================
		* Method:            LastStatusMessage_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SFTP LastStatusMessage property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastStatusMessage
		* Date Added:        05/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.85
		**
		** Contains the message text received 
		** in the last SSH_FXP_STATUS message received from the SFTP server. 
		** The actual text of the message can vary depending on the SFTP server implementation. 
		** The integer status code is available in the LastStatusCode property.
		**
		** Fixed in version 11.1.0
		**
		** Fixed the Failed to parse FXP message data length error 
		** that sometimes occurred only with the SSH-2.0-AWS_SFTP_1.2 server.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 85
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE laststatusmessage_assign		&& Assign method used to hold a reference to the LastStatusMessage property.
		*==============================================================================
