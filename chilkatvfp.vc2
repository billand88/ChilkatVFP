	PROCEDURE synctreedownload		&& Introduced in version 9.5.0.51. Downloads files from the SSH server to a local directory tree.
		*==============================================================================
		* Method:            SyncTreeDownload
		* Purpose:           Downloads files from the SSH server to a local directory tree.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteRoot, the path to the remote root.
		*                    tcLocalRoot, the path to the local root.
		*                    tiMode, the download mode type.
		*                    tuRecurse, whether or not to recurse branches.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		**
		** Downloads files from the SSH server to a local directory tree. Synchronization modes include:
		** 
		**   mode=0: Download all files
		**   mode=1: Download all files that do not exist on the local filesystem.
		**   mode=2: Download newer or non-existant files.
		**   mode=3: Download only newer files. If a file does not already exist 
		**           on the local filesystem, it is not downloaded from the server.
		**   mode=5: Download only missing files or files with size differences.
		**   mode=6: Same as mode 5, but also download newer files.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcRemoteRoot AS Character, ;
		tcLocalRoot AS Character, tiMode AS Integer, tuRecurse AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SCP_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liRecurse AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liRecurse, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 51
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liRecurse = .LogicalToBit(m.tuRecurse)
		
		      TRY
		
		        STORE m.loChilkatObject.SyncTreeDownload(m.tcRemoteRoot, ;
		        m.tcLocalRoot, m.tiMode, m.liRecurse) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE synctreedownloadasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the SyncTreeDownload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            SyncTreeDownloadAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    SyncTreeDownload method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteRoot, the path to the remote root.
		*                    tcLocalRoot, the path to the local root.
		*                    tiMode, the download mode type.
		*                    tuRecurse, whether or not to recurse branches.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		**
		** Creates an asynchronous task to call the SyncTreeDownload method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemoteRoot AS Character, ;
		tcLocalRoot AS Character, tiMode AS Integer, tuRecurse AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SCP_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liRecurse AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE 0 TO m.liRecurse, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask 
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 51
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liRecurse = .LogicalToBit(m.tuRecurse)
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.SyncTreeDownloadAsync(;
		        tcRemotePath, m.tcLocalRoot, m.tiMode, m.liRecurse)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE synctreeupload		&& Introduced in version 9.5.0.51. Uploads a directory tree from the local filesystem to the SSH server.
		*==============================================================================
		* Method:            SyncTreeUpload
		* Purpose:           Uploads a directory tree from the local filesystem to the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteBaseDir, the path to the remote base directory.
		*                    tcLocalBaseDir, the path to the local base directory.
		*                    tiMode, the download mode type.
		*                    tuRecurse, whether or not to recurse branches.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		**
		** Uploads a directory tree from the local filesystem to the SSH server. 
		** Synchronization modes include:
		** 
		**   mode=0: Upload all files
		**   mode=1: Upload all files that do not exist on the FTP server.
		**   mode=2: Upload newer or non-existant files.
		**   mode=3: Upload only newer files. If a file does not already exist 
		**           on the FTP server, it is not uploaded.
		**   mode=4: transfer missing files or files with size differences.
		**   mode=5: same as mode 4, but also newer files.
		**
		** Fixed in version 77: Fixed this method for modes > 0. No files were uploaded when the mode was > 0.
		**
		** Fixed in version 78: Modes 1-5 would operate as mode 0 and upload all files.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcRemoteBaseDir AS Character, ;
		tcLocalBaseDir AS Character, tiMode AS Integer, tuRecurse AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SCP_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liRecurse AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liRecurse, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 51
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liRecurse = .LogicalToBit(m.tuRecurse)
		
		      TRY
		
		        STORE m.loChilkatObject.SyncTreeUpload(m.tcRemoteBaseDir, ;
		        m.tcLocalBaseDir, m.tiMode, m.liRecurse) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE synctreeuploadasync		&& Introduced in version 9.5.0.51. Creates an asynchronous task to call the SyncTreeUpload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
