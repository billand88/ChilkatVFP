	PROCEDURE unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_BZ2_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BZ2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat Bz2 VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/29/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/29/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS cache AS ibasechilkat OF "chilkatvfp.vcx" 		&& A disk-based cache class for storing and retrieving text or binary items by unique key.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addroot		&& Must be called once for each cache root.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Cache DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deleteall		&& Deletes all items in the cache. This method completely clears the cache. All files in the cache are deleted. (If the cache is multi-level, existing sub-directories are not deleted.) eturns the number of items (i.e. cache files) deleted.
		*m: deleteallexpired		&& Deletes all expired items from the cache. Returns the number of items (i.e. cache files) deleted.
		*m: deletefromcache		&& Deletes a single item from the disk cache. Returns 0 if the item exists in cache but could not be deleted. Otherwise returns 1. Returns 1 for success, 0 for failure.
		*m: deleteolder		&& Undocumented method! Assumed that the parameter is a VFP DateTime value.
		*m: deleteolderdt		&& The same as DeleteOlder, except the dateTime is passed as a CkDateTime.
		*m: deleteolderstr		&& The same as DeleteOlder, except the dateTimeStr is passed as a date/time in RFC822 format.
		*m: fetchbd		&& Introduced in version 9.5.0.91. Fetches an item from cache and returns in bd. The key may be any length and may include any characters. It should uniquely identify the cached item. (No two items in the cache should have the same key.)
		*m: fetchfromcache		&& Fetches an item from cache. The key may be any length and may include any characters. It should uniquely identify the cached item. (No two items in the cache should have the same key.) Returns a zero-length byte array (as a Variant) on failure.
		*m: fetchsb		&& Introduced in version 9.5.0.91. Fetches a text item from the cache and returns in sb. The key may be any length and may include any characters. It should uniquely identify the cached item. (No two items in the cache should have the same key.)
		*m: fetchtext		&& Fetches a text item from the cache and returns it's text content. The key may be any length and may include any characters. It should uniquely identify the cached item. (No two items in the cache should have the same key.) Returns Nothing on failure.
		*m: getetag		&& Returns the eTag for an item in the cache. Returns Nothing on failure
		*m: getexpiration		&& Undcoumented method!
		*m: getexpirationdt		&& Returns the expiration date/time for an item in the cache as a CkDateTime object. Returns Nothing on failure.
		*m: getexpirationstr		&& Returns the expiration date/time for an item in the cache in RFC822 string format. Returns Nothing on failure.
		*m: getfilename		&& Returns the absolute file path of the cache file associated with the key. Returns Nothing on failure.
		*m: getroot		&& Returns the directory path of the Nth cache root. (Indexing begins at 0.) Returns Nothing on failure.
		*m: iscached		&& Returns 1 if the item is found in the cache, otherwise returns 0.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Cache LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Cache LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Cache LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Cache LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastetagfetched_access		&& Access method used to retrieve the Chilkat Cache LastETagFetched property.
		*m: lastetagfetched_assign		&& Assign method used to hold a reference to the LastETagFetched property.
		*m: lastexpirationfetchedstr_access		&& Access method used to retrieve the Chilkat Cache LastExpirationFetchedDStr property.
		*m: lastexpirationfetchedstr_assign		&& Assign method used to hold a reference to the LastExpirationFetchedStr property.
		*m: lastexpirationfetched_access		&& Access method used to retrieve the Chilkat Cache LastExpirationFetched property.
		*m: lastexpirationfetched_assign		&& Assign method used to hold a reference to the LastExpirationFetched property.
		*m: lasthitexpired_access		&& Access method used to retrieve the Chilkat Cache LastHitExpired property.
		*m: lasthitexpired_assign		&& Assign method used to hold a reference to the LastHitExpired property.
		*m: lastkeyfetched_access		&& Access method used to retrieve the Chilkat Cache LastKeyFetched property.
		*m: lastkeyfetched_assign		&& Assign method used to hold a reference to the LastKeyFetched property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Cache LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Cache LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Cache LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: level_access		&& Access method used to retrieve the Chilkat Cache Level property.
		*m: level_assign		&& Assign method used to hold a reference to the Level property.
		*m: numroots_access		&& Access method used to retrieve the Chilkat Cache NumRoots property.
		*m: numroots_assign		&& Assign method used to hold a reference to the NumRoots property.
		*m: savebd		&& Introduced in version 11.0.0. Saves the contents of bd to the cache. expiration is the expiration date/time in RFC822 format; use an empty string if there is no expiration date.
		*m: savetext		&& Undocumented method!  Assumed that the second parameter is a VFP DateTime value. Returns 1 for success, 0 for failure.
		*m: savetextdt		&& The same as SaveText, except the expire date/time is passed as a CkDateTime object. Returns 1 for success, 0 for failure.
		*m: savetextnoexpire		&& Inserts or replaces an text item in the cache with no expiration date/time. The eTag is optional and may be set to a zero-length string. Applications may use it as a place to save additional information about the cached item.
		*m: savetextstr		&& The same as SaveText, except the expire date/time is passed as a string in RFC822 format. Returns 1 for success, 0 for failure.
		*m: savetocache		&& Undocumented method! Assumed that the second parameter is a VFP DateTime value. Returns 1 for success, 0 for failure.
		*m: savetocachedt		&& The same as SaveToCache, except the expire date/time is passed as a CkDateTime object. Returns 1 for success, 0 for failure.
		*m: savetocachenoexpire		&& Inserts or replaces an item in the cache. The cached item will have no expiration. The eTag is optional and may be set to a zero-length string. Applications may use it as a place to save additional information about the cached item.
		*m: savetocachestr		&& The same as SaveToCache, except the expire date/time is passed in RFC822 string format. Returns 1 for success, 0 for failure.
		*m: updateexpiration		&& Undocumented method!  Assumed that the second parameter is a VFP DateTime value. Returns 1 for success, 0 for failure.
		*m: updateexpirationdt		&& The same as UpdateExpiration, except the expireDateTime is passed as a CkDateTime. Returns 1 for success, 0 for failure.
		*m: updateexpirationstr		&& The same as UpdateExpiration, except the expireDateTime is passed in RFC822 string format. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Cache VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastetagfetched		&& The ETag of the last item fetched from cache.
		*p: lastexpirationfetched		&& Undocumented property! Assumed to return the VFP expiration date/time value of the last item fetched.
		*p: lastexpirationfetchedstr		&& Expiration date/time of the last item fetched from cache in RFC822 string format.
		*p: lasthitexpired		&& 1 if the LastExpirationFetched is before the current date/time. Otherwise 0.
		*p: lastkeyfetched		&& The key of the last item fetched from cache. (For web pages, the key is typically the canonicalized URL. Otherwise, the key is a unique identifer used to access the cached item.)
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: level		&& The number of directory levels in the cache.
		*p: numroots		&& The number of root directories composing the cache. A typical multi-root cache would place each root on a separate hard drive.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Cache
		debuglogfilepath = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastetagfetched = 
		lastexpirationfetched = 
		lastexpirationfetchedstr = 
		lasthitexpired = 0
		lastkeyfetched = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		level = 0
		Name = "cache"
		numroots = 0
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addroot		&& Must be called once for each cache root.
		*==============================================================================
		* Method:            AddRoot
		* Purpose:           This method must be called at least once if disk caching is to be used. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDirectory, the cache root directory to add.
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		**
		** This method must be called at least once if disk caching is to be used. 
		** The file path (including drive letter) such as "E:\MyHttpCache\" 
		** is passed to AddCacheRoot to specify the root directory. 
		** The cache can be spread across multiple disk drives by calling AddCacheRoot multiple times, 
		** each with a directory path on a separate disk drive.
		**
		
		LPARAMETERS tcDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CACHE_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.AddRoot(m.tcDirectory)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CACHE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Added the SaveBd method.
		  
		  Decremented the GetExpirationDt method.
		
		** Version 97
		
		  Chilkat was mistakenly trying to use backslash chars for directory separators
		  on non-Windows systems. This has been fixed.
		
		** Version 93
		
		  Fixed a problem with the UpdateExpirationDt method.
		
		** Version 87
		
		  Fixed a bug where GetETag would return null/empty if the item data was less than 4 bytes.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only. 
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object..)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat Cache DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Cache DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/28/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Cache DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE deleteall		&& Deletes all items in the cache. This method completely clears the cache. All files in the cache are deleted. (If the cache is multi-level, existing sub-directories are not deleted.) eturns the number of items (i.e. cache files) deleted.
		*==============================================================================
		* Method:            DeleteAll
		* Purpose:           Deletes all items in the cache.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The number of cache files deleted.
		* Date Added:        06/28/2022
		*==============================================================================
		
		**
		** Deletes all items in the cache. This method completely clears the cache. 
		** All files in the cache are deleted. (If the cache is multi-level, 
		** existing sub-directories are not deleted.)
		** 
		** Returns the number of items (i.e. cache files) deleted.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CACHE_COM_CALL, ;
		loException AS Exception, liDeletedCacheFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liDeletedCacheFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liDeletedCacheFiles = m.loChilkatObject.DeleteAll()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liDeletedCacheFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CACHE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE deleteallexpired		&& Deletes all expired items from the cache. Returns the number of items (i.e. cache files) deleted.
		*==============================================================================
		* Method:            DeleteAllExpired
		* Purpose:           Deletes all expired items in the cache.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The number of cache files deleted.
		* Date Added:        06/28/2022
		*==============================================================================
		
		**
		** Deletes all expired items from the cache.
		** 
		** Returns the number of items (i.e. cache files) deleted.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CACHE_COM_CALL, ;
		loException AS Exception, liDeletedCacheFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liDeletedCacheFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liDeletedCacheFiles = m.loChilkatObject.DeleteAllExpired()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liDeletedCacheFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CACHE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE deletefromcache		&& Deletes a single item from the disk cache. Returns 0 if the item exists in cache but could not be deleted. Otherwise returns 1. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DeleteFromCache
		* Purpose:           Deletes a single item from the disk cache.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCacheKey -- the key to delete
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/28/2022
		*==============================================================================
		
		**
		** Deletes a single item from the disk cache. 
		** Returns 0 if the item exists in cache but could not be deleted. Otherwise returns 1.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCacheKey AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CACHE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DeleteFromCache(m.tcCacheKey) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
