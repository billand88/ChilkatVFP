	PROCEDURE unwrapsecurity		&& Decrypts and/or verifies all digital signatures contained within the MIME message, and returns 1 if all decryptions and verifications succeeded. Otherwise returns 0.
		*==============================================================================
		* Method:            UnwrapSecurity
		* Purpose:           Decrypts and/or verifies all digital signatures contained 
		*                    within the MIME message, and returns 1 if all decryptions 
		*                    and verifications succeeded.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Decrypts and/or verifies all digital signatures contained within the MIME message, 
		** and returns 1 if all decryptions and verifications succeeded. Otherwise returns 0. 
		** After unwrapping, the information regarding security and certificates 
		** can be obtained by the methods GetSignerCert and GetEncryptCert, 
		** and the properties NumEncryptCerts and NumSignerCerts.
		** 
		** The MIME is restored to the original structure/content prior 
		** to all signing and/or encryption.
		** 
		** The difference between UnwrapSecurity and methods such as Verify or Decrypt 
		** is that UnwrapSecurity will recursively traverse the MIME to decrypt and/or verify 
		** all parts. Also, UnwrapSecurity will unwrap layers until no further 
		** encrypted/signed content is found. For example, if a MIME message 
		** was encrypted and then subsequently signed, then UnwrapSecurity 
		** will verify and unwrap the detached signature/signed-data layer, 
		** and then decrypt the "enveloped data".
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.UnwrapSecurity() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE urlencodebody		&& URL encodes the MIME body. The charset is important.
		*==============================================================================
		* Method:            URLEncodeBody
		* Purpose:           Sets the MIME body content to a text string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset -- the charset of the encoding.
		* Returns:           
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** URL encodes the MIME body. The charset is important. For example, consider this MIME:
		** 
		**   Content-Type: text/plain
		**   Content-Transfer-Encoding: 8bit
		** 
		**   Société
		** 
		** If the charset is set to "utf-8", then the following is produced:
		** 
		**   Content-Type: text/plain
		**   Content-Transfer-Encoding: 8bit
		** 
		**   Soci%C3%A9t%C3%A9
		** 
		** However, if the charset is set to "ansi", then the following is the result:
		** 
		**   Content-Type: text/plain
		**   Content-Transfer-Encoding: 8bit
		** 
		**   Soci%E9t%E9
		**
		** Fixed for Version 11.6.0: URL-encoded text now replaces 
		** the existing body instead of being appended; 
		** invalid charset names no longer duplicate the body.
		**
		
		LPARAMETERS tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.URLEncodeBody(m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE usecertvault		&& Adds an XML certificate vault to the object's internal list of sources to be searched for certificates and private keys when encrypting/decrypting or signing/verifying.
		*==============================================================================
		* Method:            UseCertVault
		* Purpose:           Adds an XML certificate vault to the object's internal list of sources.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCertVault, a Chilkat Certificate Vault object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Adds an XML certificate vault to the object's internal list 
		** of sources to be searched for certificates and private keys 
		** when encrypting/decrypting or signing/verifying. 
		** Unlike the AddPfxSourceData and AddPfxSourceFile methods, 
		** only a single XML certificate vault can be used. 
		** If UseCertVault is called multiple times, 
		** only the last certificate vault will be used, 
		** as each call to UseCertVault will replace the certificate vault provided in previous calls.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatXMLCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		oParkParameterXmlCertVault AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXmlCertVault AS CHILKAT_XMLCERTVAULT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXmlCertVault = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXmlCertVault)
		
		    loChilkatXmlCertVault = m.loParkParameterXmlCertVault.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.UseCertVault(m.loChilkatXMLCertVault) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		     toChilkatXmlCertVault = m.loParkParameterXmlCertVault.SetObject(;
		     m.toChilkatXmlCertVault, m.loChilkatXmlCertVault)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXmlCertVault, m.loChilkatXmlCertVault
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatXMLCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loParkParameterXmlCertVault = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXmlCertVault = NEWOBJECT(CHILKAT_XMLCERTVAULT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

