	PROCEDURE secstrequals		&& Introduced in version 9.5.0.71. Returns 1 if the secStr equals the contents of this secure string. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SecStrEquals
		* Purpose:           Returns 1 if the secStr equals the contents of this secure string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSecureString, a Chilkat Secure String object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Returns 1 if the secStr equals the contents of this secure string.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SECURESTRING_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterSecureString AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSecureString = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureString)
		
		      loChilkatSecureString = m.loParkParameterSecureString.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SecStrEquals(m.loChilkatSecureString) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSecureString = m.loParkParameterSecureString.SetObject(;
		      m.toChilkatSecureString, m.loChilkatSecureString)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loParkParameterSecureString = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE verifyhash		&& Introduced in version 9.5.0.71. Verifies the hashVal against the hash value stored for the current value of this secure string. The MaintainHash property must've previously been set for this secure string to maintain an internal hash.
		*==============================================================================
		* Method:            VerifyHash
		* Purpose:           Verifies the hashVal against the hash value stored 
		*                    for the current value of this secure string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file.
		*                    tcCharset, the charset of the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.71
		**
		** Verifies the hashVal against the hash value stored 
		** for the current value of this secure string. 
		** The MaintainHash property must've previously been set for this 
		** secure string to maintain an internal hash. 
		** The encoding specifies the encoding of the hashVal. 
		** It can be any of the binary encoding algorithms, such as "base64", "hex", 
		** and many more listed at Chilkat Binary Encodings
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SECURESTRING_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 71
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.VerifyHash(m.tcFilePath, m.tcCharset) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
		
		
		
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS serversentevent AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a server-sent event (SSE) received from an HTTP text/event-stream.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: data_access		&& Access method used to retrieve the Chilkat ServerSentEvent Data property.
		*m: data_assign		&& Assign method used to hold a reference to the Data property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat ServerSentEvent DebugLogFilePath property.
		*m: debuglogfilepath_assign
		*m: eventname_access		&& Access method used to retrieve the Chilkat ServerSentEvent EventName property.
		*m: eventname_assign		&& Assign method used to hold a reference to the EventName property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat ServerSentEvent LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasteventid_access		&& Access method used to retrieve the Chilkat ServerSentEvent LastEventID property.
		*m: lasteventid_assign		&& Assign method used to hold a reference to the LastEventID property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat ServerSentEvent LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastlMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat ServerSentEvent LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat ServerSentEvent LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadevent		&& Introduced in version 9.5.0.58. Loads the multi-line event text into this object.
		*m: retry_access		&& Access method used to retrieve the Chilkat ServerSentEvent Retry property.
		*m: retry_assign		&& Assign method used to hold a reference to the Retry property.
		*p: data		&& Introduced in version 9.5.0.58. The data for the server-side event. (If the "data" field was empty, then this will be empty.)
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: eventname		&& Introduced in version 9.5.0.58. The name of the server-side event. (If the "event" field was not present, then this will be empty.)
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1
		*p: lasteventid		&& Introduced in version 9.5.0.58. The content of the "id" field, if present.
		*p: lastmethodsuccess		&& Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: retry		&& Introduced in version 9.5.0.58. The integer value of the "retry" field, if present. Otherwise 0.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = ServerSentEvent
		data = 
		debuglogfilepath = 
		eventname = 
		iinstancepatch = 58
		lastbinaryresult = .NULL.
		lasteventid = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "serversentevent"
		retry = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/07/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  Added the ServerSentEvent class.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE data_access		&& Access method used to retrieve the Chilkat ServerSentEvent Data property.
