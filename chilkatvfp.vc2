	PROCEDURE decompressbd2		&& Introduced in version 11.0.0. This method decompresses the data in bdIn without modifying it and appends the decompressed data to bdOut. It is also FirstChunk/LastChunk aware. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DecompressBd2
		* Purpose:           This method decompresses the data in bdIn without modifying it 
		*                    and appends the decompressed data to bdOut.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinDataIn, a Chilkat Binary Data object.
		*                    toChilkatBinDataOut, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This method decompresses the data in bdIn without modifying it 
		** and appends the decompressed data to bdOut. 
		** It is also FirstChunk/LastChunk aware.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, toChilkatBinDataOut AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, llImplemented AS Logical, ;
		loParkParameterBinDataIn AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataIn AS CHILKAT_BINDATA_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, loChilkatBinDataOut AS CHILKAT_BINDATA_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterBinDataIn, ;
		m.loParkParameterBinDataOut, m.loChilkatBinDataIn, m.loChilkatBinDataOut
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinDataIn = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinDataIn)
		
		      loChilkatBinDataIn = m.loParkParameterBinDataIn.GetObject()
		      loChilkatBinDataOut = m.loParkParameterBinDataOut.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.DecompressBd2(m.loChilkatBinDataIn, m.loChilkatBinDataOut) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinDataIn = ;
		      m.loParkParameterBinDataIn.SetObject(m.toChilkatBinDataIn, m.loChilkatBinDataIn)
		
		      toChilkatBinDataOut = ;
		      m.loParkParameterBinDataOut.SetObject(m.toChilkatBinDataOut, m.loChilkatBinDataOut)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataIn, m.loChilkatBinDataIn, ;
		m.loParkParameterBinDataOut, m.loChilkatBinDataOut
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  toChilkatBinDataIn = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatBinDataOut = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinDataIn = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinDataOut = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinDataIn = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatBinDataOut = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

