		RETURN
	ENDPROC

	PROCEDURE openforappend		&& Opens a file for appending. If filePath did not already exists, it is created. When an existing file is opened with this method, the contents will not be overwritten and the file pointer is positioned at the end of the file.
		*==============================================================================
		* Method:            OpenForAppend
		* Purpose:           Opens a file for appending.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Opens a file for appending. If filePath did not already exists, it is created. 
		** When an existing file is opened with this method, 
		** the contents will not be overwritten and the file pointer is positioned 
		** at the end of the file.
		**
		** If the open/create failed, then error information will be available 
		** in the FileOpenError and FileOpenErrorMsg properties.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.OpenForAppend(m.tcFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE openforread		&& Opens a file for reading. The file may contain any type of data (binary or text) and it must already exist. If the open failed, then error information will be available in the FileOpenError and FileOpenErrorMsg properties.
		*==============================================================================
