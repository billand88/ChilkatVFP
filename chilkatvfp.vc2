	PROCEDURE copy		&& Copies a message from the selected mailbox to copyToMailbox. If bUid is 1, then msgId represents a UID. If bUid is 0, then msgId represents a sequence number.  Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Copy
		* Purpose:           Copies a message from the selected mailbox to copyToMailbox.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMessageID -- the message ID of the copied message.
		*                    tuUID -- whether or not the message ID is a UID.
		*                    tcToMailBox -- the mailbox name to receive the message.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Copies a message from the selected mailbox to copyToMailbox. 
		** If bUid is 1, then msgId represents a UID. 
		** If bUid is 0, then msgId represents a sequence number.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiMessageID AS Integer, ;
		tuUID AS Unknown, tcToMailBox AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liUID AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUID
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liUID = .LogicalToBit(m.tuUID)
		
		    TRY
		
		      STORE m.loChilkatObject.Copy(m.tiMessageID, m.liUID, m.tcToMailBox) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

