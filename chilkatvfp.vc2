		          la_Values[2, 2] = .GenerateVersionNumber(9, 5, 83) && Not clear when this actually came in...
		          la_Values[3, 1] = [NOCMSALGORITHMPROTECTION]
		          la_Values[3, 2] = .GenerateVersionNumber(9, 5, 95)
		
		          ** See example for Create ICP-Brasil Compliant CMS Signature 
		          ** which uses the OmitAlgorithmIdNull keyword.
		
		          ** Assume it's validated...
