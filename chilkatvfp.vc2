	HIDDEN PROCEDURE bigendian_access		&& Access method used to retrieve the Chilkat Socket BigEndian property.
		*==============================================================================
		* Method:            BigEndian_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket BigEndian property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BigEndian
		* Date Added:        05/27/2022
		*==============================================================================
		
		**
		** Applies to the SendCount and ReceiveCount methods. 
		** If BigEndian is set to 1 (the default) then the 4-byte count is in big endian format. 
		** Otherwise it is little endian.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE bigendian_assign		&& Assign method used to hold a reference to the BigEndian property.
		*==============================================================================
		* Method:            BigEndian_Assign
		* Purpose:           Assign method used to hold a reference to the BigEndian property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the BigEndian property.
		* Returns:           
		* Date Added:        05/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE bindandlisten		&& Binds a TCP socket to a port and configures it to listen for incoming connections. The size of the backlog is passed in backLog
		*==============================================================================
		* Method:            BindAndListen
		* Purpose:           Binds a TCP socket to a port and 
		*                    configures it to listen for incoming connections. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiPort -- the binding port
		*                    tiMaxBacklog -- the maximum connection backlog to handle.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** Binds a TCP socket to a port and configures it to listen for incoming connections. 
		** The size of the backlog is passed in backLog. 
		** The backLog is necessary when multiple connections arrive at the same time, 
		** or close enough in time such that they cannot be serviced immediately. 
		** (A typical value to use for backLog is 5.) 
		** This method should be called once prior to receiving incoming connection 
		** requests via the AcceptNextConnection or AsyncAcceptStart methods.
		** 
		** Note: This method will find a random unused port to listen on if you bind to port 0. 
		** The chosen port is available via the read-only ListenPort property 
		** after this method returns successful.
		** 
		** To bind and listen using IPv6, set the ListenIpv6 property = 1 prior to calling this method.
		** 
		** What is a reasonable value for backLog? 
		** The answer depends on how many simultaneous incoming connections could be expected, 
		** and how quickly your application can process an incoming connection 
		** and then return to accept the next connection.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiPort AS Integer, tiMaxBacklog AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.BindAndListen(m.tiPort, m.tiMaxBacklog) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

