		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat CSP UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve the Chilkat CSP UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        06/11/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		** 
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string, and should typically remain empty.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat CSP UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        06/11/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 83
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat CSP VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/11/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/11/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS csr AS ibasechilkat OF "chilkatvfp.vcx" 		&& A class for generating Certificate Signing Requests (CSR) or for reading an existing CSR.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addsan		&& Introduced in version 9.5.0.84. Adds a SAN value (Subject Alternative Name) to the CSR to be generated. This method can be called multiple times -- one per subject alternative name to be added.
		*m: commonname_access		&& Access method used to retrieve the Chilkat CSR CommonName property.
		*m: commonname_assign		&& Assign method used to hold a reference to the CommonName property.
		*m: companydivision_access		&& Access method used to retrieve the Chilkat CSR CompanyDivision property.
		*m: companydivision_assign		&& Assign method used to hold a reference to the CompanyDivision property.
		*m: company_access		&& Access method used to retrieve the Chilkat CSR Company property.
		*m: company_assign		&& Assign method used to hold a reference to the Company property.
		*m: country_access		&& Access method used to retrieve the Chilkat CSR Country property.
		*m: country_assign		&& Assign method used to hold a reference to the Country property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat CSR DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: emailaddress_access		&& Access method used to retrieve the Chilkat CSR EmailAddress property.
		*m: emailaddress_assign		&& Assign method used to hold a reference to the EmailAddress property.
		*m: gencsrbd		&& Introduced in version 9.5.0.65. Generate a CSR and return the binary DER in csrData. The privKey can be an RSA or ECDSA private key. Returns 1 for success, 0 for failure.
		*m: gencsrpem		&& Introduced in version 9.5.0.65. Generate a CSR and return it as a PEM string. The privKey can be an RSA or ECDSA private key. Returns Nothing on failure.
		*m: getextensionrequest		&& Introduced in version 9.5.0.91. Gets the 1.2.840.113549.1.9.14 extensionRequest from the previously loaded CSR. The extensionReqXml will be loaded with the extension request XML if one exists. Returns 1 for success, 0 for failure.
		*m: getpublickey		&& Introduced in version 9.5.0.76. Returns the CSR's public key in the pubkey. Returns 1 for success, 0 for failure.
		*m: getsans		&& Introduced in version 9.5.0.91. Gets the SANS (Subject Alternative Names) of the currently loaded CSR. The information is written to the passed-in sans object. Returns 1 for success, 0 for failure.
		*m: getsubjectfield		&& Introduced in version 9.5.0.65. Gets a subject field by OID, such as "2.5.4.9". See http://www.alvestrand.no/objectid/2.5.4.html for OID values and meanings. Returns Nothing on failure.
		*m: hashalgorithm_access		&& Access method used to retrieve the Chilkat CSR HashAlgorithm property.
		*m: hashalgorithm_assign		&& Assign method used to hold a reference to the HashAlgorithm property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat CSR LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat CSR LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat CSR LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat CSR LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat CSR LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat CSR LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat CSR LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadcsrpem		&& Introduced in version 9.5.0.65. Loads this CSR object with a CSR PEM. All properties are set to the values found within the CSR. Returns 1 for success, 0 for failure.
		*m: locality_access		&& Access method used to retrieve the Chilkat CSR Locality property.
		*m: locality_assign		&& Assign method used to hold a reference to the Locality property.
		*m: mgfhashalg_access		&& Access method used to retrieve the Chilkat CSR MGFHashAlg property.
		*m: mgfhashalg_assign		&& Assign method used to hold a reference to the MGFHashAlg property.
		*m: psspadding_access		&& Access method used to retrieve the Chilkat CSR PSSPadding property.
		*m: psspadding_assign		&& Assign method used to hold a reference to the PSSPadding property.
		*m: setextensionrequest		&& Introduced in version 9.5.0.91. Adds a 1.2.840.113549.1.9.14 extensionRequest to the CSR. The extensionReqXml contains the ASN.1 in XML format of the extension request to be added. Returns 1 for success, 0 for failure.
		*m: setsubjectfield		&& Introduced in version 9.5.0.65. Sets a subject field by OID, such as "2.5.4.9". See http://www.alvestrand.no/objectid/2.5.4.html for OID values and meanings. The asnType can be "UTF8String", "IA5String", or "PrintableString".
		*m: state_access		&& Access method used to retrieve the Chilkat CSR State property.
		*m: state_assign		&& Assign method used to hold a reference to the State property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat CSR VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifycsr		&& Introduced in version 9.5.0.83. Verify the signature in the CSR. Return 1 if the signature is valid. Returns 1 for success, 0 for failure.
		*p: commonname		&& Introduced in version 9.5.0.65. The common name of the certificate to be generated. For SSL/TLS certificates, this would be the domain name. For email certificates this would be the email address.
		*p: company		&& Introduced in version 9.5.0.65. The company or organization name for the certificate to be generated. It is the value for "O" in the certificate's Subject's distinguished name (DN). (This is the value for OID "2.5.4.10") This property is optional.
		*p: companydivision		&& Introduced in version 9.5.0.65. The company division or organizational unit name for the certificate to be generated. It is the value for "OU" in the certificate's Subject's distinguished name (DN). (This is the value for OID "2.5.4.11")
		*p: country		&& Introduced in version 9.5.0.65. The two-letter uppercase country abbreviation, such as "US", for the certificate to be generated. It is the value for "C" in the certificate's Subject's distinguished name (DN). (This is the value for OID "2.5.4.6")
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: emailaddress		&& Introduced in version 9.5.0.65. The email address for the certificate to be generated. It is the value for "E" in the certificate's Subject's distinguished name (DN). (This is the value for OID "1.2.840.113549.1.9.1") This property is optional.
		*p: hashalgorithm		&& Introduced in version 9.5.0.82. The hash algorithm to be used when creating the CSR. The default is SHA256. Can be set to SHA1, SHA384, SHA256, or SHA512.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: locality		&& Introduced in version 9.5.0.65. The locality (city or town) name for the certificate to be generated. It is the value for "L" in the certificate's Subject's distinguished name (DN). (This is the value for OID "2.5.4.7") This property is optional.
		*p: mgfhashalg		&& Introduced in version 9.5.0.83. If the private key is RSA and PssPadding equals 1 (RSASSA-PSS padding is used for the RSA signature), then this property controls the MGF hash algorithm used in the RSASSA-PSS padding. The default is "sha256".
		*p: psspadding		&& Introduced in version 9.5.0.83. If _CKTRUE_, and if the private key is RSA, then uses RSASSA-PSS padding for the signature.
		*p: state		&& Introduced in version 9.5.0.65. The state or province for the certificate to be generated. It is the value for "S" (or "ST") in the certificate's Subject's distinguished name (DN). (This is the value for OID "2.5.4.8") This property is optional.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Csr
		commonname = common_name
		company = 
		companydivision = 
		country = 
		debuglogfilepath = 
		emailaddress = 
		hashalgorithm = SHA256
		iinstancepatch = 65
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		locality = 
		mgfhashalg = sha256
		Name = "csr"
		psspadding = 0
		state = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addsan		&& Introduced in version 9.5.0.84. Adds a SAN value (Subject Alternative Name) to the CSR to be generated. This method can be called multiple times -- one per subject alternative name to be added.
		*==============================================================================
		* Method:            AddSAN
		* Purpose:           Adds a SAN value to the CSR to be generated.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSANType, the SAN type to add.
		*                    tcSANValue, the SAN value to add
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.84
		**
		** Adds a SAN value (Subject Alternative Name) to the CSR to be generated. 
		** This method can be called multiple times -- one per subject alternative name to be added.
		** 
		** The sanType specifies the type of SAN, and can be one of the following strings:
		** 
		**   otherName
		**   rfc822Name
		**   dnsName
		**   x400Address
		**   directoryName
		**   ediPartyName
		**   uniformResourceIndicator
		**   IPAddress
		**   registeredID
		** 
		** The sanValue is the value. For example, if the sanType is "dsnName", 
		** the sanValue might be "example.com". If the sanType is "IPAddress", 
		** then the sanValue might be "69.12.122.63".
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcSANType AS Character, tcSANValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CSR_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 84
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddSAN(m.tcSANType, m.tcSANValue) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSR_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 99
		
		  Chilkat’s internal ASN.1 decoder needed an update to correctly handle 
		  0-length ASN.1 bit strings (which is something not normally encountered).
		
		** Version 95
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		** Version 91
		
		  Added the GetSans method to get the list of SANS (Subject Alternative Names) contained in a CSR.
		
		  Added the GetExtensionRequest and SetExensionRequest methods.
		  See the online reference documentation and linked examples.
		
		** Version 84
		
		  Added the AddSan method to allow for 1 or more Subject Alternative Names
		  to be added to the CSR that is generated.
		
		** Version 83
		
		  Improved support for ECDSA certs.
		
		** Version 76
		
		  The Certificate Signing Request class (Csr) now supports ECC based certificates.
		
		  Added the GetPublicKey method.
		
		  Fixed some ASN.1 decoding issues involving subject alternative names.
		
		** Version 69
		
		  Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		
		** Version 67
		
		  Chilkat now fully supports ECC certificates in all ways.
		
		** Version 47
		
		  When finding the issuer (internally), Chilkat will always first check for an authority key identifier,
		  and if found will search for the cert with the matching subject key identifier.
		  Otherwise it will locate the issuer by distinguished name.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE commonname_access		&& Access method used to retrieve the Chilkat CSR CommonName property.
		*==============================================================================
		* Method:            CommonName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSR CommonName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CommonName
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.65
		**
		** The common name of the certificate to be generated. For SSL/TLS certificates, 
		** this would be the domain name. For email certificates this would be the email address.
		** 
		** It is the value for "CN" in the certificate's Subject's distinguished name (DN). 
		** (This is the value for OID "2.5.4.3")
		** 
		** This property is required for a CSR.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 65
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE commonname_assign		&& Assign method used to hold a reference to the CommonName property.
		*==============================================================================
		* Method:            CommonName_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat CSR CommonName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CommonName property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 65
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE companydivision_access		&& Access method used to retrieve the Chilkat CSR CompanyDivision property.
		*==============================================================================
		* Method:            CompanyDivision_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSR CompanyDivision property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CompanyDivision
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.65
		**
		** The company division or organizational unit name for the certificate to be generated.
		** 
		** It is the value for "OU" in the certificate's Subject's distinguished name (DN). 
		** (This is the value for OID "2.5.4.11")
		** 
		** This property is optional. It may left empty.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 65
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

