DEFINE CLASS stringtable AS ibasechilkat OF "chilkatvfp.vcx" 		&& A memory efficient class for holding a large number of strings (accessible by index). The primary use is as a read-only table of strings that is built once and then used by the application. This class is introduced in Chilkat v9.5.0.62.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: append		&& Introduced in version 9.5.0.62. Appends a string to the table. Returns 1 for success, 0 for failure.
		*m: appendfromfile		&& Introduced in version 9.5.0.62. Appends strings, one per line, from a file. Each line in the path should be no longer than the length specified in maxLineLen.
		*m: appendfromsb		&& Introduced in version 9.5.0.62. Appends strings, one per line, from the contents of a StringBuilder object. Returns 1 for success, 0 for failure.
		*m: clear		&& Introduced in version 9.5.0.62. Removes all the strings from the table.
		*m: count_access		&& Access method used to retrieve the Chilkat StringTable Count property.
		*m: count_assign		&& Assign method used to hold a reference to the Count property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat StringTable DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: findmatch		&& Introduced in version 11.1.0. This string table object holds strings with wildcards. The method returns the index of the wildcarded string that matches the text in sb, or -1 if no match is found.
		*m: findsubstring		&& Introduced in version 9.5.0.77. Return the index of the first string in the table containing substr. Begins searching strings starting at startIndex. If caseSensitive is 1, then the search is case sensitive.
		*m: getstrings		&& Introduced in version 9.5.0.87. Return the number of strings specified by count, one per line, starting at startIdx. To return the entire table, pass 0 values for both startIdx and count.
		*m: intat		&& Introduced in version 9.5.0.63. Returns the Nth string in the table, converted to an integer value. The index is 0-based. (The first string is at index 0.) Returns -1 if no string is found at the specified index.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat StringTable LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat StringTable LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat StringTable LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat StringTable LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat StringTable LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat StringTable LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat StringTable LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: savetofile		&& Introduced in version 9.5.0.62. Saves the string table to a file. The charset is the character encoding to use, such as "utf-8", "iso-8859-1", "windows-1252", "Shift_JIS", "gb2312", etc.
		*m: sort		&& Introduced in version 9.5.0.87. Sorts the strings in the collection in ascending or descending order. To sort in ascending order, set ascending to 1, otherwise set ascending equal to 0. Returns 1 for success, 0 for failure.
		*m: splitandappend		&& Introduced in version 9.5.0.62. Splits a string into parts based on a single character delimiterChar. If exceptDoubleQuoted is 1, then the delimiter char found between double quotes is not treated as a delimiter.
		*m: stringat		&& Introduced in version 9.5.0.62. Returns the Nth string in the table. The index is 0-based. (The first string is at index 0. Returns Nothing on failure
		*m: stringatsb		&& Introduced in version 11.2.0. Appends the Nth string in the table to sb. The index is 0-based. (The first string is at index 0.) Returns 1 for success, 0 for failure.
		*m: tosb		&& Introduced in version 11.3.0. Appends the entire string table to sb using CRLF line endings. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat StringTable VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: wordfollowing		&& Introduced in version 11.1.0. The method performs a case-insensitive search to return the index of a table entry matching sb, or -1 if there is no match.
		*p: count		&& Introduced in version 9.5.0.62. The number of strings in the table.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = StringTable
		count = 0
		debuglogfilepath = 
		iinstancepatch = 62
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "stringtable"
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE append		&& Introduced in version 9.5.0.62. Appends a string to the table. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Append
		* Purpose:           Appends a string to the table.
