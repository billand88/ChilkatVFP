	ENDPROC

ENDDEFINE

DEFINE CLASS atom AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents an Atom document. The Atom API allows one to download, create and modify Atom documents. Decremented in version 10.1.0.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat Atom AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: addelement		&& Adds a new element to the Atom document. The tag is a string such as "title", "subtitle", "summary", etc. Returns the index of the element added, or -1 for failure.
		*m: addelementdate		&& Undocumented method! It is assumed that the second parameter can accept a VFP DateTime value.
		*m: addelementdatestr		&& Adds a new date-formatted element to the Atom document. The tag is a string such as "created", "modified", "issued", etc. The dateTimeStr should be an RFC822 formatted date/time string such as "Tue, 25 Sep 2012 12:25:32 -0500".
		*m: addelementdt		&& Adds a new date-formatted element to the Atom document. The tag is a string such as "created", "modified", "issued", etc. Returns the index of the element added, or -1 for failure.
		*m: addelementhtml		&& Adds a new HTML formatted element to the Atom document. Returns the index of the element added, or -1 for failure.
		*m: addelementxhtml		&& Adds a new XHTML formatted element to the Atom document. Returns the index of the element added, or -1 for failure.
		*m: addelementxml		&& Adds a new XML formatted element to the Atom document. Returns the index of the element added, or -1 for failure.
		*m: addentry		&& Adds an "entry" Atom XML document to the caller's Atom document.
		*m: addlink		&& Adds a link to the Atom document.
		*m: addperson		&& Adds a person to the Atom document. The tag should be a string such as "author", "contributor", etc. If a piece of information is not known, an empty string or NULL value may be passed.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Atom DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deleteelement		&& Removes the Nth occurrence of a given element from the Atom document. Indexing begins at 0. For example, to remove the 2nd category, set tag = "category" and index = 1.
		*m: deleteelementattr		&& Remove an attribute from an element.The index should be 0 unless there are multiple elements having the same tag, in which case it selects the Nth occurrence based on the index ( 0 = first occurrence ).
		*m: deleteperson		&& Deletes a person from the Atom document. The tag is a string such as "author". The index should be 0 unless there are multiple elements having the same tag, in which case it selects the Nth occurrence based on the index.
		*m: downloadatom		&& Download an Atom feed from the Internet and load it into the Atom object. Returns 1 for success, 0 for failure.
		*m: downloadatomasync		&& Creates an asynchronous task to call the DownloadAtom method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getelement		&& Returns the content of the Nth element having a specified tag. Returns Nothing on failure.
		*m: getelementattr		&& Returns the value of an element's attribute. The element is selected by the tag name and the index (the Nth element having a specific tag) and the attribute is selected by name. Returns Nothing on failure.
		*m: getelementcount		&& The number of elements having a specific tag.
		*m: getelementdate		&& Undocumented method! Assumed to return a VFP Datetime value.
		*m: getelementdatestr		&& Returns an element's value as a date/time in an RFC822 formatted string, such as such as "Tue, 25 Sep 2012 12:25:32 -0500". Returns Nothing on failure.
		*m: getelementdt		&& Returns an element's value as a date/time object. Returns Nothing on failure.
		*m: getentry		&& Returns the Nth entry as an Atom object. (Indexing begins at 0) Returns Nothing on failure.
		*m: getlinkhref		&& Returns the href attribute of the link having a specified "rel" attribute (such as "service.feed", "alternate", etc.). Returns Nothing on failure.
		*m: getpersoninfo		&& Returns a piece of information about a person. To get the 2nd author's name, call GetPersonInfo("author",1,"name"). Returns Nothing on failure.
		*m: gettopattr		&& Returns the value of an attribute on the top-level XML node. The tag of a top-level Atom XML node is typically "feed" or "entry", and it might have attributes such as "xmlns" and "xml:lang". Returns Nothing on failure.
		*m: haselement		&& True (1) if the element exists in the Atom document. Otherwise 0.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Atom LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Atom LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Atom LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Atom LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Atom LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Atom LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Atom LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: loadxml		&& Loads the Atom document from an XML string. Returns 1 for success, 0 for failure.
		*m: newentry		&& Initializes the Atom document to be a new "entry".
		*m: newfeed		&& Initializes the Atom document to be a new "feed".
		*m: numentries_access		&& Access method used to retrieve the Chilkat Atom NumEntries property.
		*m: numentries_assign		&& Assign method used to hold a reference to the NumEntries property
		*m: setelementattr		&& Adds or replaces an attribute on an element.
		*m: settopattr		&& Adds or replaces an attribute on the top-level XML node of the Atom document.
		*m: toxmlstring		&& Serializes the Atom document to an XML string. Returns Nothing on failure.
		*m: updateelement		&& Replaces the content of an element.
		*m: updateelementdate		&& Undocumented method! Assumed to accept a VFP date time value as the third parameter.
		*m: updateelementdatestr		&& Replaces the content of a date-formatted element. The index should be an RFC822 formatted date/time string.
		*m: updateelementdt		&& Replaces the content of a date-formatted element.
		*m: updateelementhtml		&& Replaces the content of an HTML element.
		*m: updateelementxhtml		&& Replaces the content of an XHTML element.
		*m: updateelementxml		&& Replaces the content of an XML element.
		*m: updateperson		&& Replaces the content of a person. To update the 3rd author, call UpdatePerson("author",2,"new name","new URL","new email"). If a piece of information is not known, pass an empty string or a NULL.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Atom VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult propert
		*p: numentries		&& Number of entries in the Atom document.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		cchilkatclass = Atom
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		iretirementmajor = 11
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "atom"
		numentries = 
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat Atom AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Assign method used to retrieve 
		*                    the AbortCurrent property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        07/30/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. Methods that always 
		** finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls 
		** can be aborted. (A synchronous method call could be aborted by setting 
		** this property from a separate thread.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold 
		*                    the AbortCurrent property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        07/30/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE addelement		&& Adds a new element to the Atom document. The tag is a string such as "title", "subtitle", "summary", etc. Returns the index of the element added, or -1 for failure.
		*==============================================================================
		* Method:            AddElement
		* Purpose:           Adds a new element to the Atom document.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTag -- the tag name to add.
		*                    tcValue -- the tag's value.
		* Returns:           Returns the index of the element added, or -1 for failure.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Adds a new element to the Atom document. The tag is a string such as "title", 
		** "subtitle", "summary", etc. Returns the index of the element added, or -1 for failure.
		**
		
		LPARAMETERS tcTag AS Character, tcValue AS Character
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Atom], ;
		loException AS Exception, liElementIndex AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liElementIndex = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liElementIndex = m.loChilkatObject.AddElement(m.tcTag, m.tcValue)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liElementIndex
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Atom])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addelementdate		&& Undocumented method! It is assumed that the second parameter can accept a VFP DateTime value.
