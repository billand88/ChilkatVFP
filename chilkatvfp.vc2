DEFINE CLASS mailmaneventhandler AS ibaseeventhandler OF "chilkatvfp.vcx" 		&& Event Handler for the Chilkat object associated with the MailMan class.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: emailreceived		&& Called just after an email has been received. This is useful for methods that download more than one email.
		*m: emailreceived_post		&& EmailReceived post-processing method.
		*m: emailreceived_pre		&& EmailReceived pre-processing method.
		*m: emailreceived_process		&& EmailReceived processing method.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "mailmaneventhandler"
	*</PropValue>
	
	PROCEDURE emailreceived		&& Called just after an email has been received. This is useful for methods that download more than one email.
		*==============================================================================
		* Method:            EmailReceived
		* Purpose:           Called just after an email has been received.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSubject, the email subject line.
		*                    tcFromAddress, the email from address.
		*                    tcFromName, the email from name
		*                    tcReturnPath, the email return path (bounce addresses)
		*                    tcDate, the email date
		*                    tcUIDL, the email UIDL (Unique ID Listing)
		*                    tiEmailSize, the email size in bytes.
		* Returns:           
		* Date Added:        10/22/2022
		*==============================================================================
		
		**
		** Called just after an email has been received. 
		** This is useful for methods that download more than one email.
		**
		
		LPARAMETERS tcSubject AS Character, tcFromAddress AS Character, tcFromName AS Character, ;
		tcReturnPath AS Character, tcDate AS Character, tcUIDL AS Character, tiEmailSize AS Integer
		
		LOCAL lcSubject AS Character, lcFromAddress AS Character, lcFromName AS Character, ;
		lcReturnPath AS Character, lcDate AS Character, lcUIDL AS Character, ;
		liEmailSize AS Integer, llReturn AS Logical
		
		lcSubject = m.tcSubject
		lcFromAddress = m.tcFromAddress
		lcFromName = m.tcFromName
		lcReturnPath = tcReturnPeth
		lcDate = m.tcDate
		lcUIDL = m.tcUIDL
		liEmailSize = m.tiEmailSize
		
		llReturn = .T.
		
		*!*
		*!*  ? [EmailReceived Event!]
		*!*  ? [EmailReceived: Subject = ] + lcSubject
		*!*  ? [EmailReceived: From Address = ] + lcFromAddress
		*!*  ? [EmailReceived: From Name = ] + lcFromName
		*!*  ? [EmailReceived: Return Path = ] + lcReturnPath
		*!*  ? [EmailReceived: Email Date = ] + lcDate
		*!*  ? [EmailReceived: Email UIDL = ] + lcUIDL
		*!*  ? [EmailReceived: Email Size = ] + ALLTRIM(STR(liEmailSize))
		*!*
		
		WITH THIS
		
		  llReturn = .EmailReceived_Pre(m.lcSubject, m.lcFromAddress, ;
		  m.lcFromName, m.lcReturnPath, m.lcDate, m.lcUIDL, m.liEmailSize)
		
		  ** OK to continue test
		  IF m.llReturn 
		
		    llReturn = .EmailReceived_Process(m.lcSubject, m.lcFromAddress, ;
		    m.lcFromName, m.lcReturnPath, m.lcDate, m.lcUIDL, m.liEmailSize)
		
		    ** OK to continue test
		    IF m.llReturn 
		
		      llReturn = .EmailReceived_Post(m.lcSubject, m.lcFromAddress, ;
		      m.lcFromName, m.lcReturnPath, m.lcDate, m.lcUIDL, m.liEmailSize)
		
		    ENDIF m.llReturn 
		    ** End OK to continue test
		
		  ENDIF m.llReturn 
		  ** End OK to continue test
		
		ENDWITH
		
		tcSubject = m.lcSubject
		tcFromAddress = m.lcFromAddress
		tcFromName = m.lcFromName
		tcReturnPath = lcReturnPeth
		tcDate = m.lcDate
		tcUIDL = m.lcUIDL
		tiEmailSize = m.liEmailSize
		
		RETURN
	ENDPROC

	PROCEDURE emailreceived_post		&& EmailReceived post-processing method.
		*==============================================================================
		* Method:            EmailReceived_Post
		* Purpose:           EmailReceived post-processing method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSubject, the email subject line.
		*                    tcFromAddress, the email from address.
		*                    tcFromName, the email from name
		*                    tcReturnPath, the email return path (bounce addresses)
		*                    tcDate, the email date
		*                    tcUIDL, the email UIDL (Unique ID Listing)
		*                    tiEmailSize, the email size in bytes.
		* Returns:           Logical, indicating success
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tcSubject AS Character, tcFromAddress AS Character, tcFromName AS Character, ;
		tcReturnPath AS Character, tcDate AS Character, tcUIDL AS Character, tiEmailSize AS Integer
		
		LOCAL lcSubject AS Character, lcFromAddress AS Character, lcFromName AS Character, ;
		lcReturnPath AS Character, lcDate AS Character, lcUIDL AS Character, ;
		liEmailSize AS Integer, llReturn AS Logical
		
		lcSubject = m.tcSubject
		lcFromAddress = m.tcFromAddress
		lcFromName = m.tcFromName
		lcReturnPath = tcReturnPeth
		lcDate = m.tcDate
		lcUIDL = m.tcUIDL
		liEmailSize = m.tiEmailSize
		
		llReturn = .T.
		
		tcSubject = m.lcSubject
		tcFromAddress = m.lcFromAddress
		tcFromName = m.lcFromName
		tcReturnPath = lcReturnPeth
		tcDate = m.lcDate
		tcUIDL = m.lcUIDL
		tiEmailSize = m.liEmailSize
		
		RETURN m.llReturn
	ENDPROC

