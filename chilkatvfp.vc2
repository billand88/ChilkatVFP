		*                    the Chilkat FTP2 ClientIPAddress property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the ClientIPAddress property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE commandcharset_access		&& Access method used to retrieve the Chilkat CommandCharset property.
		*==============================================================================
		* Method:            CommandCharset_Access
		* Purpose:           Access method used to retrieve the Chilkat FTP2 CommandCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CommandCharset
		* Date Added:        02/23/2022
		*==============================================================================
		
		** 
		** Indicates the charset to be used for commands sent to the FTP server. 
		** The command charset must match what the FTP server is expecting 
		** in order to communicate non-English characters correctly. 
		** The default value of this property is "ansi".
		**
		** This property may be updated to "utf-8" after connecting 
		** because a "FEAT" command is automatically sent to get the features of the FTP server. 
		** If UTF8 is indicated as a feature, then this property is automatically changed to "utf-8".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE commandcharset_assign		&& Assign method used to hold a reference to the CommandCharset property.
		*==============================================================================
