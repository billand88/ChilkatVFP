		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE convertdata		&& Converts character data from one charset to another. Before calling ConvertData, the FromCharset and ToCharset properties must be set to the source and destination charset names, such as "iso-8859-1" or "Shift_JIS".
		*==============================================================================
		* Method:            ConvertData
		* Purpose:           Converts character data from one charset to another.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqDataIn, the byte data to convert.
		* Returns:           Converted byte data.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Converts character data from one charset to another. Before calling ConvertData, 
		** the FromCharset and ToCharset properties must be set to the source 
		** and destination charset names, such as "iso-8859-1" or "Shift_JIS".
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tqDataIn AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, lqDataOut AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDataOut
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqDataOut = m.loChilkatObject.ConvertData(m.tqDataIn)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDataOut
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE convertfile		&& Converts a file from one character encoding to another. The FromCharset and ToCharset properties specify the source and destination character encodings. If the ToCharset is utf-16 or utf-8, then the preamble (also known as BOM) is included in the output.
		*==============================================================================
		* Method:            ConvertFile
		* Purpose:           Converts a file from one character encoding to another. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSourceFilePath, the path to the source file.
		*                    tcDestinationFilePath, the path to the converted file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Converts a file from one character encoding to another. 
		** The FromCharset and ToCharset properties specify the source 
		** and destination character encodings. If the ToCharset is utf-16 or utf-8, 
		** then the preamble (also known as BOM) is included in the output. 
		** (Call ConvertFileNoPreamble to suppress the output of the BOM.)
		**
		** Fixed in version 99: The Charset.ConvertFile method did not 
		** correctly recognize the “no-bom” if converting to “no-bom-utf8” 
		** (which is the utf-8 encoding without the utf-8 preamble 
		** consisting of the 3-bytes EF BB BF). In other words, 
		** Chilkat was adding the EF BB BF preamble when it should not.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSourceFilePath AS Character, tcDestinationFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ConvertFile(m.tcSourceFilePath, ;
		      m.tcDestinationFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE convertfilenopreamble		&& Converts a file from one character encoding to another. The FromCharset and ToCharset properties specify the source and destination character encodings. No preamble (also known as BOM) is included in the output.
		*==============================================================================
		* Method:            ConvertFileNoPreamble
		* Purpose:           Converts a file from one character encoding to another. 
		* Author:            Bill Anderson
