	PROCEDURE getbademailaddresses		&& Returns a string array object containing a list of failed and invalid email addresses that have accumulated during SMTP sends.
		*==============================================================================
		* Method:            GetBadEmailAddresses
		* Purpose:           Returns a string array object containing a list of failed 
		*                    and invalid email addresses that have accumulated during SMTP sends.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat String Array object, or NULL
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** Returns a string array object containing a list of failed 
		** and invalid email addresses that have accumulated during SMTP sends. 
		** The list will not contain duplicates. 
		** Also, this only works with some SMTP servers -- not all SMTP servers 
		** check the validity of each email address.
		**
		** Note: An SMTP server can only validate the email addresses within it's own domain. 
		** External email address are not verifiable at the time of sending.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, loChilkatStringArray AS CHILKAT_STRINGARRAY_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatStringArray 
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatStringArray = m.loChilkatObject.GetBadEmailAddresses()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatStringArray
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatStringArray = NEWOBJECT(CHILKAT_STRINGARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getfullemail		&& If a partial email was obtained using GetHeaders or GetAllHeaders, this method will take the partial email as an argument, and download the full email from the server.
		*==============================================================================
		* Method:            GetFullEmail
		* Purpose:           If a partial email was obtained using GetHeaders or GetAllHeaders, 
		*                    this method will take the partial email as an argument, 
		*                    and download the full email from the server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		* Returns:           Chilkat Email Object, or NULL
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** If a partial email was obtained using GetHeaders or GetAllHeaders, 
		** this method will take the partial email as an argument, 
		** and download the full email from the server. 
		** A new email object (separate from the partial email) is returned. 
		**
		** A null reference is returned on failure.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, loChilkatFullEmail AS CHILKAT_EMAIL_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatFullEmail, m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		
		      loChilkatFullEmail = m.loChilkatObject.GetFullEmail(m.loChilkatEmail)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.loChilkatFullEmail
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatFullEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

