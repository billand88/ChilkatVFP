		liIntroducedInBuild = 96
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcUnWrappedData = m.loChilkatObject.AESKeyUnwrapWithPadding(;
		        m.tcKeyEncryptionKey, m.tcWrappedKeyData, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcUnWrappedData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE aeskeywrap		&& Introduced in version 9.5.0.66. Implements the AES Key Wrap Algorithm (RFC 3394). The kek is the Key Encryption Key (the AES key used to encrypt the keyData).
		*==============================================================================
		* Method:            AESKeyWrap
		* Purpose:           Implements the AES Key Wrap Algorithm (RFC 3394).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyEncryptionKey -- The kek, or Key Encryption Key
		*                    tcKeyData -- the key data to wrap
		*                    tcEncoding -- the string encoding.
		* Returns:           The wrapped data. 
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Implements the AES Key Wrap Algorithm (RFC 3394). 
		** The kek is the Key Encryption Key (the AES key used to encrypt the keyData). 
		** The arguments and return value are binary encoded strings 
		** using the encoding specified by encoding 
		** (which can be "base64", "hex", "base64url", etc.) 
		** The full list of supported encodings is available at the link below.
		** 
		** The kek should be an AES key of 16 bytes, 24 bytes, or 32 bytes 
		** (i.e. 128-bits, 192- bits, or 256-bits). 
		** For example, if passed as a hex string, then the kek should be 32 chars in length, 
		** 48 chars, or 64 chars (because each byte is represented as 2 chars in hex).
		** 
		** The keyData contains the data to be key wrapped. 
		** It must be a multiple of 64-bits in length. 
		** In other words, if the keyData is decoded to binary, it should be 
		** a number of bytes that is a multiple of 8.
		** 
		** The return string, if decoded to binary bytes, is equal 
		** to the size of the key data + 8 additional bytes.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcKeyEncryptionKey AS Character, ;
		tcKeyData AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcWrappedData AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcWrappedData = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcWrappedData = m.loChilkatObject.AESKeyWrap(;
		        m.tcKeyEncryptionKey, m.tcKeyData, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcWrappedData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE aeskeywrapwithpadding		&& Introduced in version 9.5.0.96. Implements the AES Key Wrap with Padding Algorithm (RFC 5649). The kek is the Key Encryption Key (the AES key used to encrypt the keyData).
		*==============================================================================
		* Method:            AESKeyWrapWithPadding
		* Purpose:           Implements the AES Key Wrap with Padding Algorithm (RFC 5649). 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyEncryptionKey -- The kek, or Key Encryption Key
