	PROCEDURE authenticatepw		&& Introduced in version 9.5.0.50. Authenticates with the SSH server using a login and password. An SSH session always begins by first calling Connect to connect to the SSH server, and then calling either AuthenticatePw or AuthenticatePk to login.
		*==============================================================================
		* Method:            AuthenticatePw
		* Purpose:           Authenticates with the SSH server using a login and password.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLogin -- the login name
		*                    tcPassword, the login password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		** 
		** Authenticates with the SSH server using a login and password.
		** 
		** An SSH session always begins by first calling Connect to connect to the SSH server, 
		** and then calling either AuthenticatePw or AuthenticatePk to login.
		** 
		** Important: When reporting problems, please send the full contents 
		** of the LastErrorText property to support@chilkatsoft.com.
		** Note: To learn about how to handle password change requests, 
		** see the PasswordChangeRequested property (above).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcLogin AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHTUNNEL_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 50
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AuthenticatePw(m.tcLogin, m.tcPassword) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

