	PROCEDURE findcertbyrfc822name		&& Locates and returns a certificate by its RFC 822 name. If multiple certificates match, then non-expired certificates will take precedence over expired certificates.
		*==============================================================================
		* Method:            FindCertByRFC822Name
		* Purpose:           Locates and returns a certificate by its RFC 822 name.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName, the RFC 822 name to locate.
		* Returns:           Chilkat Certificate object or NULL
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Locates and returns a certificate by its RFC 822 name.
		**
		** If multiple certificates match, then non-expired certificates 
		** will take precedence over expired certificates. In other words, 
		** Chilkat will aways return the non-expired certificate over the expired certificate.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.FindCertByRFC822Name(m.tcName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

