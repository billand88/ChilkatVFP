		* Author:            Bill Anderson
		* Parameters:        tcFileName, the file name to read. 
		* Returns:           A VFP DateTime value.
		* Date Added:        05/27/2022
		*==============================================================================
		
		**
		** Undocumented method! Returns the file-creation date/time for a remote file by filename.
		**
		** Note: The filename passed to this method must NOT include a path. Prior to calling
		** this method, make sure to set the current remote directory (via the
		** ChangeRemoteDir method) to the remote directory where this file exists.
		**
		** Note: Prior to calling this method, it should be ensured that the ListPattern
		** property is set to a pattern that would match the requested filename. (The default
		** value of ListPattern is "*", which will match all filenames.)
		**
		** Note: Linux/Unix type filesystems do not store "create" date/times. If the FTP
		** server is on such as system, this method will return a date/time equal to the
		** last-modified date/time.
		**
		** It is assumed that this method returns the value in a DateTime format.
		**
		
		LPARAMETERS tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, ltCreate AS DateTime
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		ltCreate = {/:}
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        ltCreate = m.loChilkatObject.GetCreateTimeByName(m.tcFileName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.ltCreate
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

