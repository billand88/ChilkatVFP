DEFINE CLASS jsonarray AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents a JSON array, which contains an ordered list of JSON values, where each value can be a string, number, JSON object, JSON array, true, false, or null.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addarrayat		&& Introduced in version 9.5.0.56. Inserts a new and empty JSON array member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*m: addarrayat2		&& Introduced in version 11.1.0. Inserts a new and empty JSON array member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*m: addboolat		&& Introduced in version 9.5.0.56. Inserts a new boolean member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addintat		&& Introduced in version 9.5.0.56. Inserts a new integer member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Returns 1 for success, 0 for failure. Indexing is 0-based (the 1st member is at index 0).
		*m: addnullat		&& Introduced in version 9.5.0.56. Inserts a new null member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addnumberat		&& Introduced in version 9.5.0.56. Inserts a new numeric member to the position indicated by index. The numericStr is an integer, float, or double already converted to a string in the format desired by the application. To prepend, pass an index of 0.
		*m: addobjectat		&& Introduced in version 9.5.0.56. Inserts a new and empty JSON object member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*m: addobjectat2		&& Introduced in version 11.1.0. Inserts a new and empty JSON object member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*m: addobjectcopyat		&& Introduced in version 9.5.0.82. Inserts a copy of a JSON object to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: addstringat		&& Introduced in version 9.5.0.56. Inserts a new string at the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: adduintat		&& Introduced in version 9.5.0.96. Inserts a new unsigned integer member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*m: appendarrayitems		&& Introduced in version 9.5.0.82. Appends the array items contained in jarr. Returns 1 for success, 0 for failure.
		*m: arrayat		&& Introduced in version 9.5.0.56. Returns the JSON array that is the value of the Nth array element. Indexing is 0-based (the 1st member is at index 0). Returns Nothing on failure.
		*m: arrayat2		&& Introduced in version 11.0.0. Sets jarr to reference the JSON array found at index, where indexing starts at 0. Returns 1 for success, 0 for failure.
		*m: boolat		&& Introduced in version 9.5.0.56. Returns the boolean value of the Nth array element. Indexing is 0-based (the 1st member is at index 0).
		*m: clear		&& Introduced in version 9.5.0.76. Deletes all array elements.
		*m: dateat		&& Introduced in version 9.5.0.73. Fills the dateTime with the date/time string located in the Nth array element. Indexing is 0-based (the 1st member is at index 0).
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat JSONArray DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: deleteat		&& Introduced in version 9.5.0.56. Deletes the array element at the given index. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: dtat		&& Introduced in version 9.5.0.73. Fills the dt with the date/time string located in the Nth array element. If bLocal is 1, then dt is filled with the local date/time values, otherwise it is filled with the UTC/GMT values.
		*m: emit		&& Introduced in version 9.5.0.58. Writes the JSON array (rooted at the caller) and returns as a string. Note: To control the compact/non-compact format, and to control the LF/CRLF line-endings, set the EmitCompact and EmitCrlf properties.
		*m: emitcompact_access		&& Access method used to retrieve the Chilkat JSONArray EmitCompact property.
		*m: emitcompact_assign		&& Assign method used to hold a reference to the EmitCompact property.
		*m: emitcrlf_access		&& Access method used to retrieve the Chilkat JSONArray EmitCRLF property.
		*m: emitcrlf_assign		&& Assign method used to hold a reference to the EmitCRLF property.
		*m: emitsb		&& Introduced in version 9.5.0.65. Writes the JSON array to the sb. Note: To control the compact/non-compact format, and to control the LF/CRLF line-endings, set the EmitCompact and EmitCrlf properties. Returns 1 for success, 0 for failure.
		*m: findobject		&& Introduced in version 9.5.0.73. Return the index of the first object in the array where value of the field at name matches value. name is an object member name. The value is a value pattern which can use "*" chars to indicate zero or more of any char.
		*m: findstartindex_access		&& Access method used to retrieve the Chilkat JSONArray FindStartIndex property.
		*m: findstartindex_assign		&& Assign method used to hold a reference to the FindStartIndex property.
		*m: findstring		&& Introduced in version 9.5.0.73. Return the index of the first matching string in the array. The value is a value pattern which can use "*" chars to indicate zero or more of any char.
		*m: intat		&& Introduced in version 9.5.0.56. Returns the integer value of the Nth array element. Indexing is 0-based (the 1st member is at index 0).
		*m: isnullat		&& Introduced in version 9.5.0.56. Returns the 1 if the Nth array element is null, otherwise returns 0. Indexing is 0-based (the 1st member is at index 0).
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat JSONArray LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat JSONArray LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat JSONArray LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat JSONArray LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat JSONArray LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat JSONArray LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat JSONArray LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: load		&& Introduced in version 9.5.0.64. Loads a JSON array from a string. A JSON array must begin with a "[" and end with a "]". Note: The Load method causes the JsonArray to detach and become it's own JSON document.
		*m: loadsb		&& Introduced in version 9.5.0.64. Loads a JSON array from a StringBuilder. A JSON array must begin with a "[" and end with a "]". Note: The Load method causes the JsonArray to detach and become it's own JSON document.
		*m: objectat		&& Introduced in version 9.5.0.56. Returns the JSON object that is the value of the Nth array element. Indexing is 0-based (the 1st member is at index 0). Returns Nothing on failure
		*m: objectat2		&& Introduced in version 11.0.0. Sets jsonObj to reference the JSON object found at index, where indexing starts at 0. Returns 1 for success, 0 for failure.
		*m: setboolat		&& Introduced in version 9.5.0.56. Sets the boolean value of the Nth array element. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setintat		&& Introduced in version 9.5.0.56. Sets the integer value of the Nth array element. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setnullat		&& Introduced in version 9.5.0.56. Sets the Nth array element to the value of null. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setnumberat		&& Introduced in version 9.5.0.56. Sets the numeric value of the Nth array element. The value is an integer, float, or double already converted to a string in the format desired by the application. Indexing is 0-based (the 1st member is at index 0).
		*m: setstringat		&& Introduced in version 9.5.0.56. Sets the string value of the Nth array element. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: setuintat		&& Introduced in version 9.5.0.96. Sets the unsigned integer value of the Nth array element. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
		*m: size_access		&& Access method used to retrieve the Chilkat JSONArray Size property.
		*m: size_assign		&& Assign method used to hold a reference to the Size property.
		*m: stringat		&& Introduced in version 9.5.0.56. Returns the string value of the Nth array element. Indexing is 0-based (the 1st member is at index 0). Returns Nothing on failure.
		*m: swap		&& Introduced in version 9.5.0.76. Swaps the items at positions index1 and index2. Returns 1 for success, 0 for failure.
		*m: typeat		&& Introduced in version 9.5.0.58. Returns the type of data at the given index. Possible return values are: 1.string 2. number 3. object 4.array 5. boolean 6. null. Returns -1 if no member exists at the given index.
		*m: uintat		&& Introduced in version 9.5.0.96. Returns the unsigned integer value of the Nth array element. Indexing is 0-based (the 1st member is at index 0).
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat JSONArray VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: emitcompact		&& Introduced in version 9.5.0.64. If 1 then the Emit method outputs in the most compact form possible (a single-line with no extra whitespace). If 0, then emits with whitespace and indentation to make the JSON human-readable. The default value is 1.
		*p: emitcrlf		&& If 1 then the Emit method uses CRLF line-endings when emitting the non-compact (pretty-print) format. If 0, then bare-LF's are emitted. (The compact format emits to a single line with no end-of-line characters.)
		*p: findstartindex		&& Introduced in version 11.6.0. Specifies the zero-based array index at which FindString and FindObject begin searching. The default value is 0.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: size		&& Introduced in version 9.5.0.56. The number of JSON values in the array.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = JsonArray
		debuglogfilepath = 
		emitcompact = 1
		emitcrlf = 1
		findstartindex = 0
		iinstancepatch = 56
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "jsonarray"
		size = 0
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addarrayat		&& Introduced in version 9.5.0.56. Inserts a new and empty JSON array member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*==============================================================================
		* Method:            AddArrayAt
		* Purpose:           Inserts a new and empty JSON array member 
		*                    to the position indicated by index.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, determines where the array is added.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Inserts a new and empty JSON array member to the position indicated by index. 
		** To prepend, pass an index of 0. To append, pass an index of -1. 
		** Indexing is 0-based (the 1st member is at index 0).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_JSONARRAY_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddArrayAt(m.tiIndex) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addarrayat2		&& Introduced in version 11.1.0. Inserts a new and empty JSON array member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0).
		*==============================================================================
		* Method:            AddArrayAt2
		* Purpose:           Inserts a new and empty JSON array member to the position indicated by index. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, determines where the array is added.
		*                    toChilkatJSONArray, a Chilkat JSON array to add.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/29/2025
		*==============================================================================
		
		**
		** Introduced in version 11.1.0
		**
		** Inserts a new and empty JSON array member to the position indicated by index. 
		** To prepend, pass an index of 0. To append, pass an index of -1. 
		** Indexing is 0-based (the 1st member is at index 0).
		** The jarr is an output argument that references the appended JSON array.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, toChilkatJsonArray AS CHILKAT_JSONARRAY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JSONARRAY_COM_CALL, ;
		loParkParameterJSONArray AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONArray AS CHILKAT_JSONARRAY_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonArray, m.loChilkatJSONArray
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonArray = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONArray)
		
		      loChilkatJSONArray = m.loParkParameterJsonArray.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddArrayAt2(m.tiIndex, ;
		        m.loChilkatJSONArray) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONArray = ;
		      m.loParkParameterJsonArray.SetObject(m.toChilkatJSONArray, m.loChilkatJSONArray)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonArray, m.loChilkatJSONArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  toChilkatJSONArray = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  loParkParameterJsonArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONArray = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addboolat		&& Introduced in version 9.5.0.56. Inserts a new boolean member to the position indicated by index. To prepend, pass an index of 0. To append, pass an index of -1. Indexing is 0-based (the 1st member is at index 0). Returns 1 for success, 0 for failure.
