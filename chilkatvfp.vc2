		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE desthostname_access		&& Access method used to retrieve the Chilkat SSHTunnel DestHostName property.
		*==============================================================================
		* Method:            DestHostName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSHTunnel DestHostName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DestHostName
		* Date Added:        07/07/2022
		*==============================================================================
		
		**
		** The destination hostname or IP address (in dotted decimal notation) 
		** of the service (such as a database server). Data sent through the SSH tunnel 
		** is forwarded by the SSH server to this destination. 
		** Data received from the destination (by the SSH server) 
		** is forwarded back to the client through the SSH tunnel.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
