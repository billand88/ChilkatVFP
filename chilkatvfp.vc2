		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loParkParameterStream = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encryptstring		&& Encrypts a string and returns the encrypted data as a byte array. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey, Charset.
		*==============================================================================
		* Method:            EncryptString
		* Purpose:           Encrypts a string and returns the encrypted data as a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcData -- the string data to encrypt. 
		* Returns:           The encrypted binary data bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Encrypts a string and returns the encrypted data as a byte array. 
		** The minimal set of properties that should be set before encrypting are: 
		** CryptAlgorithm, SecretKey, Charset. Other properties that control encryption are: 
		** CipherMode, PaddingScheme, KeyLength, IV. When decrypting, 
		** all property settings must match otherwise garbled data is returned. 
		** The Charset property controls the exact bytes that get encrypted. 
		** Languages such as VB.NET, C#, and Visual Basic work with Unicode strings, 
		** thus the input string is Unicode. If Unicode is to be encrypted 
		** (i.e. 2 bytes per character) then set the Charset property to "Unicode". 
		** To implicitly convert the string to another charset before the encryption is applied, 
		** set the Charset property to something else, such as "iso-8859-1", "Shift_JIS", 
		** "big5", "windows-1252", etc. The complete list of possible charsets is listed here:
		** 
		**   <font size="2" face="MS Sans Serif">
		**   us-ascii
		**   unicode
		**   unicodefffe
		**   iso-8859-1
		**   iso-8859-2
		**   iso-8859-3
		**   iso-8859-4
		**   iso-8859-5
		**   iso-8859-6
		**   iso-8859-7
		**   iso-8859-8
		**   iso-8859-9
		**   iso-8859-13
		**   iso-8859-15
		**   windows-874
		**   windows-1250
		**   windows-1251
		**   windows-1252
		**   windows-1253
		**   windows-1254
		**   windows-1255
		**   windows-1256
		**   windows-1257
		**   windows-1258
		**   utf-7
		**   utf-8
		**   utf-32
		**   utf-32be
		**   shift_jis
		**   gb2312
		**   ks_c_5601-1987
		**   big5
		**   iso-2022-jp
		**   iso-2022-kr
		**   euc-jp
		**   euc-kr
		**   macintosh
		**   x-mac-japanese
		**   x-mac-chinesetrad
		**   x-mac-korean
		**   x-mac-arabic
		**   x-mac-hebrew
		**   x-mac-greek
		**   x-mac-cyrillic
		**   x-mac-chinesesimp
		**   x-mac-romanian
		**   x-mac-ukrainian
		**   x-mac-thai
		**   x-mac-ce
		**   x-mac-icelandic
		**   x-mac-turkish
		**   x-mac-croatian
		**   asmo-708
		**   dos-720
		**   dos-862
		**   ibm037
		**   ibm437
		**   ibm500
		**   ibm737
		**   ibm775
		**   ibm850
		**   ibm852
		**   ibm855
		**   ibm857
		**   ibm00858
		**   ibm860
		**   ibm861
		**   ibm863
		**   ibm864
		**   ibm865
		**   cp866
		**   ibm869
		**   ibm870
		**   cp875
		**   koi8-r
		**   koi8-u
		**   </font>
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tcData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqEncryptedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDecryptedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqEncryptedBytes = m.loChilkatObject.EncryptString(m.tcData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqEncryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE encryptstringenc		&& Encrypts a string and returns the encrypted data as an encoded (printable) string. The minimal set of properties that should be set before encrypting are: CryptAlgorithm, SecretKey, Charset, and EncodingMode.
		*==============================================================================
		* Method:            EncryptStringENC
		* Purpose:           Encrypts a string and returns the encrypted data as an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcData -- the string data to encrypt. 
		* Returns:           The encrypted string bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		** 
		** Encrypts a string and returns the encrypted data as an encoded (printable) string. 
		** The minimal set of properties that should be set before encrypting are: 
		** CryptAlgorithm, SecretKey, Charset, and EncodingMode. 
		** Other properties that control encryption are: CipherMode, PaddingScheme, 
		** KeyLength, IV. When decrypting (with DecryptStringENC), 
		** all property settings must match otherwise garbled data is returned. 
		** The Charset property controls the exact bytes that get encrypted. 
		** Languages such as VB.NET, C#, and Visual Basic work with Unicode strings, 
		** thus the input string is Unicode. If Unicode is to be encrypted 
		** (i.e. 2 bytes per character) then set the Charset property to "Unicode". 
		** To implicitly convert the string to another charset before the encryption is applied, 
		** set the Charset property to something else, such as "iso-8859-1", "Shift_JIS", 
		** "big5", "windows-1252", etc. (Refer to EncryptString for the complete list of charsets.)
		**
		** The EncodingMode property controls the encoding of the string that is returned. 
		** It can be set to "Base64", "QP", or "Hex".
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncryptedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncryptedString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncryptedString = m.loChilkatObject.EncryptStringENC(m.tcData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncryptedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE firstchunk_access		&& Access method used to retrieve the Chilkat Crypt2 FirstChunk property.
		*==============================================================================
		* Method:            FirstChunk_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 FirstChunk property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FirstChunk
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** Chilkat Crypt2 provides the ability to feed 
		** the encryption/decryption methods with chunks of data. 
		** This allows a large amount of data, or a data stream, 
		** to be fed piecemeal for encrypting or decrypting. 
		** It applies to all symmetric algorithms currently supported 
		** (AES, Blowfish, Twofish, 3DES, RC2, DES, ARC4), and all algorithms supported in the future.
		** 
		** The default value for both FirstChunk and LastChunk is 1. 
		** This means when an Encrypt* or Decrypt* method is called, 
		** it is both the first and last chunk (i.e. it's the entire amount of data to be encrypted or decrypted).
		**
		** If you wish to feed the data piecemeal, do this:
		** 
		**   1) Set FirstChunk = 1, LastChunk = 0 for the first chunk of data.
		**   2) For all "middle" chunks (i.e. all chunks except for the final chunk) 
		**      set FirstChunk = 0 and LastChunk = 0.
		**   3) For the final chunk, set FirstChunk = 0 and LastChunk = 1
		**
		** There is no need to worry about feeding data 
		** according to the block size of the encryption algorithm. 
		** For example, AES has a block size of 16 bytes. Data may be fed in chunks of any size. 
		** The Chilkat Crypt2 component will buffer the data. When the final chunk is passed, 
		** the output is padded to the algorithm's block size according to the PaddingScheme.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE firstchunk_assign		&& Assign method used to hold a reference to the FirstChunk property.
		*==============================================================================
		* Method:            FirstChunk_Assign
		* Purpose:           Assign method used to hold a reference to the FirstChunk property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the FirstChunk property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE genencodedsecretkey		&& Identical to the GenerateSecretKey method, except it returns the binary secret key as a string encoded according to encoding, which may be "base64", "hex", "url", etc. Please see the documentation for GenerateSecretKey for more information.
		*==============================================================================
		* Method:            GenEncodedSecretKey
		* Purpose:           Identical to the GenerateSecretKey method, except 
		*                    it returns the binary secret key as a string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- the password to encode.
		*                    tcEncoding -- the password encoding.
		* Returns:           The encoded secret key.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Important: In the v9.5.0.49 release, a bug involving this method was introduced: 
		** The encoding is ignored and instead the encoding used is the current 
		** value of the EncodingMode property. The workaround is to make sure the EncodingMode property 
		** is set to the value of the desired output encoding. This problem will be fixed in v9.5.0.50.
		** 
		** Identical to the GenerateSecretKey method, except it returns the binary secret key 
		** as a string encoded according to encoding, which may be "base64", "hex", "url", etc. 
		** Please see the documentation for GenerateSecretKey for more information.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcPassword AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcEncodedSecretKey AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedSecretKey = ;
		      m.loChilkatObject.GenEncodedSecretKey(m.tcPassword, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedSecretKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE generatesecretkey		&& Hashes a string to a byte array that has the same number of bits as the current value of the KeyLength property. For example, if KeyLength is equal to 128 bits, then a 16-byte array is returned.
		*==============================================================================
		* Method:            GenerateSecretKey
		* Purpose:           Hashes a string to a byte array that has the same number 
		*                    of bits as the current value of the KeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- the password to encode.
		* Returns:           The secret key.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Hashes a string to a byte array that has the same number of bits 
		** as the current value of the KeyLength property. 
		** For example, if KeyLength is equal to 128 bits, then a 16-byte array is returned. 
		** This can be used to set the SecretKey property. In order to decrypt, 
		** the SecretKey must match exactly. To use "password-based" encryption, 
		** the password is passed to this method to generate a binary secret key 
		** that can then be assigned to the SecretKey property.
		** 
		** IMPORTANT: If you are trying to decrypt something encrypted by another party 
		** such that the other party provided you with the secret key, 
		** DO NOT use this method. This method is for transforming an arbitrary-length password 
		** into a binary secret key of the proper length. Please see this Chilkat blog post: 
		** Getting Started with AES Decryption
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqSecretKey AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqSecretKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqSecretKey = m.loChilkatObject.GenerateSecretKey(m.tcPassword)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqSecretKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE generateuuid		&& Introduced in version 9.5.0.55. Generates a random UUID string having standard UUID format, such as "de305d54-75b4-431b-adb2-eb6b9e546014". Note: This generates a "version 4 UUID" using random byte values. See RFC 4122. Returns Nothing on failure.
		*==============================================================================
		* Method:            GenerateUUID
		* Purpose:           Generates a random UUID string having standard UUID format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           UUID
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** Generates a random UUID string having standard UUID format, 
		** such as "de305d54-75b4-431b-adb2-eb6b9e546014".
		** 
		** Note: This generates a "version 4 UUID" using random byte values. See RFC 4122.
		**
		** Fixed for version 59: Fixed this method to respect RFC 4122. 
		** This method generates the version 4 variant, which is composed of 
		** entirely random data except for the few bits that signify version 4.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed for version 69: This method should now correctly generate a v4 UUID 
		** (as opposed to a completely random UUID).
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcUUID AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcUUID = []
		llImplemented = .F.
		liIntroducedInBuild = 55
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcUUID = m.loChilkatObject.GenerateUUID()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcUUID
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

