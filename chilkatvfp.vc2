	HIDDEN PROCEDURE oauthbodyhash_access		&& Access method used to retrieve the Chilkat HTTP OAuthBodyHash property.
		*==============================================================================
		* Method:            OAuthBodyHash_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP OAuthBodyHash property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.OAuthBodyHash
		* Date Added:        06/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		**
		** If set to 1, then the oauth_body_hash is automatically added 
		** to an OAuth1 Authorization header. The oauth_body_hash contains the SHA-256 hash 
		** of the HTTP request body that is sent.
		**
		** Fixed for Verison 93: Fixed Twitter OAuth1 authentication problems.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 91
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE oauthbodyhash_assign		&& Assign method used to hold a reference to the OAuthBodyHash property.
		*==============================================================================
		* Method:            OAuthBodyHash_Assign
		* Purpose:           Assign method used to hold a reference to the OAuthBodyHash property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the OAuthBodyHash property.
		* Returns:           
		* Date Added:        06/02/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 91
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE oauthcallback_access		&& Access method used to retrieve the Chilkat HTTP OAuthCallback property.
		*==============================================================================
		* Method:            OAuthCallback_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP OAuthCallback property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.OAuthCallback
		* Date Added:        01/28/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.53
		** 
		** The OAuth 1.0 callback URL. Defaults to "oob".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 53
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

