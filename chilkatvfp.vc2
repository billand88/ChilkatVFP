		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE totext		&& Converts HTML to plain-text. Returns Nothing on failure
		*==============================================================================
		* Method:            ToText
		* Purpose:           Converts HTML to plain-text.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHTML -- the HTML content to translate
		* Returns:           Text
		* Date Added:        05/13/2022
		*==============================================================================
		
		**
		** Converts HTML to plain-text.
		**
		** Fixed in version 11.2.0: Fixed a rarely encountered crash bug in the ToText method.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHTML AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTMLTOTEXT_COM_CALL, ;
		loException AS Exception, lcText AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcText = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcText = m.loChilkatObject.ToText(m.tcHTML)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcText
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTMLTOTEXT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE totextsb		&& Introduced in version 9.5.0.97. Converts the HTML in sb to plain-text. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            ToTextSb
		* Purpose:           Converts the HTML in sb to plain-text.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat StringBuilder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.97
		**
		** Converts the HTML in sb to plain-text.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTMLTOTEXT_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 97
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ToTextSb(m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTMLTOTEXT_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTMLToText UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        05/55/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This property usually remains an empty string but can be set to a list of comma-separated keywords.
		** 
		** "NoReferencesList" - Do not generate the list of hyperlink references at the end of the plain-text.
		** "EmitUrls" - Introduced in version 11.1.0 - Cause hyperlink URLs to be emitted within the text 
		** rather than being listed at the end of the generated plain text.
		**
		** Enhancement in Version 11.1.0: Added the EmitUrls uncommon option 
		** to cause hyperlink URLs to be emitted within the text 
		** rather than being listed at the end of the generated plain text.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat HTMLToText UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
