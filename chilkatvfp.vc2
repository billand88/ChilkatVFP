	PROCEDURE secretspectojson		&& Introduced in version 11.5.0. Converts a secret specification string (secretSpec) to JSON. A secret specification string is formatted as !!part1|part2|part3|part4" where parts 3 and 4 are optional. json is the output argument.
		*==============================================================================
		* Method:            SecretSpecToJson
		* Purpose:           Converts a secret specification string (secretSpec) to JSON. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSecretSpec, a character string holding the secret.
		*                    toChilkatJSON, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/02/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Converts a secret specification string (secretSpec) to JSON. 
		** A secret specification string is formatted as "!!part1|part2|part3|part4" 
		** where parts 3 and 4 are optional. json is the output argument.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcSecretSpec AS Character, toChilkatJSON AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Secrets], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJson AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS [Chilkat.JsonObject], lcSecretSpec AS Character, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		lcSecretSpec = []
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJson = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJson.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SecretSpecToJson(m.tcSecretSpec, ;
		        m.loChilkatJSON) TO liReturn, luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJson.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		RETURN m.lcSecretSpec
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Secrets])
		  toChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJson = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setbootstrapsecret		&& Introduced in version 10.1.0. Accessing a cloud-based secrets manager requires authentication credentials, which cannot be stored in the manager itself. Instead, they must be securely stored locally.
		*==============================================================================
		* Method:            SetBootStrapSecret
		* Purpose:           Sets the bootstrap secret.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSON, a Chilkat JSON object.
		*                    toChilkatSecrets, a Chilkat Secrets object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/26/2024
		*==============================================================================
		
		**
		** Introduced in version 10.1.0.
		**
		** Accessing a cloud-based secrets manager requires authentication credentials, 
		** which cannot be stored in the manager itself. Instead, they must be securely stored locally.
		**
		** One solution is to store the authentication credentials as a secret 
		** in the Windows Credentials Manager or Apple Keychain. These credentials serve 
		** as the "bootstrap secret" for authenticating with the cloud-based secrets manager.
		** 
		** jsonId contains the name of the bootstrap secret. 
		** secretContent contains the bootstrap's secret content.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSON AS [Chilkat.JsonObject], toChilkatSecrets AS [Chilkat.Secrets]
		
		LOCAL loChilkatObject AS [Chilkat.Secrets], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJson AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterSecrets AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS [Chilkat.JsonObject], loChilkatSecrets AS [Chilkat.Secrets], ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterJson, ;
		m.loParkParameterSecrets, m.loChilkatJSON, m.loChilkatSecrets
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJson = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loParkParameterSecrets = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecrets)
		
		      loChilkatJSON = m.loParkParameterJson.GetObject()
		      loChilkatSecrets = m.loParkParameterSecrets.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetBootStrapSecret(m.loChilkatJSON, m.loChilkatSecrets) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJson.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		
		      toChilkatSecrets = ;
		      m.loParkParameterSecrets.SetObject(m.toChilkatSecrets, m.loChilkatSecrets)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON, ;
		m.loParkParameterSecrets, m.loChilkatSecrets
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Secrets])
		  toChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJson = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  toChilkatSecrets = NEWOBJECT([Chilkat.Secrets])
		  loParkParameterSecrets = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecrets = NEWOBJECT([Chilkat.Secrets])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat Secrets UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Secrets UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        12/26/2024
		*==============================================================================
		
		** 
		** Introduced in version 10.1.0
		** 
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty.
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Secrets UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        07/31/2025
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = [] && [UnCommonOptions_Secrets]
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 10
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		** No actual options exist...
		*!*  THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

