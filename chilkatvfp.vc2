	PROCEDURE loadp7b		&& Introduced in version 9.5.0.49. Loads the PEM from the contents of an in-memory PKCS7 container (.p7b). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadP7B
		* Purpose:           Loads the PEM from the contents of an in-memory PKCS7 container (.p7b).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqP7BData - P7B byte data.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Loads the PEM from the contents of an in-memory PKCS7 container (.p7b).
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tqP7BData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadP7B(m.tqP7BData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loadp7basync		&& Introduced in version 9.5.0.49. Creates an asynchronous task to call the LoadP7b method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            LoadP7BAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    LoadP7B method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqP7BData - P7B byte data.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the LoadP7B method 
		** with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tqP7BData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_PEM_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.LoadP7BAsync(m.tqP7BData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PEM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

