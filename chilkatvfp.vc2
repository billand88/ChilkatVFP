		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.GetLastModifiedTimeByNameStrAsync(m.tcFileName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getlastmodifiedtimestr		&& Returns the last modified date/time (in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500") for the Nth file or sub-directory in the current remote directory. The first file/dir is at index 0, and the last one is at index (GetDirCount()-1)
		*==============================================================================
		* Method:            GetLastModifiedTimeStr
		* Purpose:           Returns the last modified date/time for the Nth file 
		*                    or sub-directory in the current remote directory
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the file/subdirectory array. 
		* Returns:           lcLastModifiedTime, the last modified date/time.
		* Date Added:        03/03/2022
		*==============================================================================
		
		**
		** Returns the last modified date/time 
		** (in RFC822 string format, such as "Tue, 25 Sep 2012 12:25:32 -0500") 
		** for the Nth file or sub-directory in the current remote directory. 
		** The first file/dir is at index 0, and the last one is at index (GetDirCount()-1)
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, lcLastModifiedTime AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
