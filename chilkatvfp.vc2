	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat Atom VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/29/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/29/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS authaws AS ibasechilkat OF "chilkatvfp.vcx" 		&& Implements AWS Signature V4 for signing and authenticating AWS REST requests.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: accesskey_access		&& Access method used to retrieve the Chilkat AuthAWS AccessKey property.
		*m: accesskey_assign		&& Assign method used to hold a reference to the AccessKey property.
		*m: canonicalizedresourcev2_access		&& Access method used to retrieve the Chilkat AuthAWS CanonicalizedResourceV2 property.
		*m: canonicalizedresourcev2_assign		&& Assign method used to hold a reference to the CanonicalizedResourceV2 property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat AuthAWS DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: enablesecrets_access		&& Access method used to retrieve the Chilkat AuthAws EnableSecrets property.
		*m: enablesecrets_assign		&& Assign method used to hold a reference to the EnableSecrets property.
		*m: genpresignedurl		&& Introduced in version 9.5.0.85. Generates a temporary pre-signed URL for an Amazon AWS service using AWS Signature V4. Requires that the SecretKey, AccessKey, and Region properties be set to valid values prior to calling this method.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat AuthAWS LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat AuthAWS LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat AuthAWS LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat AuthAWS LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat AuthAWS LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat AuthAWS LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat AuthAWS LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: precomputedmd5_access		&& Access method used to retrieve the Chilkat AuthAWS PreComputedMD5 property.
		*m: precomputedmd5_assign		&& Assign method used to hold a reference to the PreComputedMD5 property.
		*m: precomputedsha256_access		&& Access method used to retrieve the Chilkat AuthAWS PreComputedSHA256 property.
		*m: precomputedsha256_assign		&& Assign method used to hold a reference to the PreComputedSHA256 property.
		*m: region_access		&& Access method used to retrieve the Chilkat AuthAWS Region property.
		*m: region_assign		&& Assign method used to hold a reference to the Region property.
		*m: secretkey_access		&& Access method used to retrieve the Chilkat AuthAWS SecretKey property.
		*m: secretkey_assign		&& Assign method used to hold a reference to the SecretKey property.
		*m: servicename_access		&& Access method used to retrieve the Chilkat AuthAWS ServiceName property.
		*m: servicename_assign		&& Assign method used to hold a reference to the ServiceName property.
		*m: signatureversion_access		&& Access method used to retrieve the Chilkat AuthAWS SignatureVersion property.
		*m: signatureversion_assign		&& Assign method used to hold a reference to the SignatureVersion property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat AuthAWS VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: accesskey		&& Introduced in version 9.5.0.58. The AWS access key.
		*p: canonicalizedresourcev2		&& Introduced in version 9.5.0.58. If AWS Signature Version V2 is used, then this property must be set.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: enablesecrets		&& Introduced in version 11.5.0
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult propert
		*p: precomputedmd5		&& Introduced in version 9.5.0.58. This property can optionally be set for AWS requests that have a non-empty request body. This should be the base64 encoding of the 16 bytes of the MD5 hash.
		*p: precomputedsha256		&& Introduced in version 9.5.0.58. This property can optionally be set for AWS requests that have a non-empty request body. This should be the lowercase hex encoding of the 32-bytes of the SHA256 hash.
		*p: region		&& Introduced in version 9.5.0.58. The AWS region, such as "us-east-1", "us-west-2", "eu-west-1", "eu-central-1", etc. The default is "us-east-1". It is only used when the SignatureVersion property is set to 4.
		*p: secretkey		&& Introduced in version 9.5.0.58. The AWS secret key.
		*p: servicename		&& Introduced in version 9.5.0.58. The AWS service namespace, such as "s3", "ses", etc. See http://docs.aws.amazon.com/general/latest/gr/aws-arns-and-namespaces.html#genref-aws-service-namespaces
		*p: signatureversion		&& Introduced in version 9.5.0.58. The AWS Signature Version to be used in authentication. The default value is 4. This can optionally be set to the value 2 to use the older V2 signature version.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		accesskey = 
		canonicalizedresourcev2 = 
		cchilkatclass = AuthAws
		debuglogfilepath = 
		enablesecrets = 0
		iinstancepatch = 58
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "authaws"
		precomputedmd5 = 
		precomputedsha256 = 
		region = us-east-1
		secretkey = 
		servicename = 
		signatureversion = 4
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE accesskey_access		&& Access method used to retrieve the Chilkat AuthAWS AccessKey property.
		*==============================================================================
		* Method:            AccessKey_Access
		* Purpose:           Access method used to retrieve the 
		*                    Chilkat AuthAWS AccessKey property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AccessKey
		* Date Added:        07/30/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.58
		**
		** The AWS access key.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

