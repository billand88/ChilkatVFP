		* Returns:           Logical, indicating success.
		* Date Added:        10/22/2022
		*==============================================================================
		
		LPARAMETERS tcPath AS Character, ;
		tiCompressedFileSize AS Integer, tiFileSize AS Integer
		
		LOCAL lcPath AS Character, liCompressedFileSize AS Integer, ;
		liFileSize AS Integer, llReturn AS Logical
		
		lcPath = m.tcPath
		liCompressedFileSize = m.tiCompressedFileSize
		liFileSize = m.tiFileSize
		
		llReturn = .T.
		
		tcPath = m.lcPath
		tiCompressedFileSize = m.liCompressedFileSize
		tiFileSize = m.liFileSize
		
		RETURN m.llReturn
	ENDPROC

