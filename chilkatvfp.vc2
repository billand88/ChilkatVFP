		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatJSONObject  = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatTask = NEWOBJECT([Task])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE rawcommandbd		&& Introduced in version 11.0.0. Sends the raw command contained in bdCmd and returns the response in bdResp. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            RawCommandBd
		* Purpose:           Sends the raw command contained in bdCmd and returns the response in bdResp.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinDataCommand -- a Chilkat Binary Data object.
		*                    toChilkatBinDataResponse -- a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Sends the raw command contained in bdCmd and returns the response in bdResp.
		**
		
		LPARAMETERS toChilkatBinDataCommand AS CHILKAT_BINDATA_COM_CALL, ;
		toChilkatBinDataResponse AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loParkParameterBinDataCommand AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataCommand AS CHILKAT_BINDATA_COM_CALL, llImplemented AS Logical, ;
		loParkParameterBinDataResponse AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinDataResponse AS CHILKAT_BINDATA_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinDataCommand, m.loChilkatBinDataCommand, ;
		m.loParkParameterBinDataResponse, m.loChilkatBinDataResponse
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
