	ENDPROC

	PROCEDURE gethash		&& Introduced in version 9.5.0.91. Returns the hash of the contents of this object.
		*==============================================================================
		* Method:            GetHash
		* Purpose:           Returns the hash of the contents of this object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcAlgorithm, the hash algorithm
		*                    tcEncoding, the hash encoding.
		*                    tcCharset, the charset of the hash.
		* Returns:           lcHash, the found (or not) substring.
		* Date Added:        06/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		**
		** Returns the hash of the contents of this object. 
		** The algorithm is the hash algorithm, and can be "sha1", "sha256", "sha384", 
		** "sha512", "sha3-224", "sha3-256", "sha3-384", "sha3-512", "md2", "md5", 
		** "ripemd128", "ripemd160","ripemd256", or "ripemd320". 
		** The encoding can be "base64", "modBase64", "base64Url", "base32", "base58", 
		** "qp" (for quoted-printable), "url" (for url-encoding), "hex", "hexLower", 
		** or any of the encodings found at Chilkat Binary Encodings List.
		** 
		** The charset is the character encoding byte representation to hash. 
		** It is typically "utf-8". It can be any of the chacter encodings listed 
		** at Chilkat Character Encodings List.
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure 
		** 
		
		LPARAMETERS tcAlgorithm AS Character, tcEncoding AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcHash AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHash = []
		llImplemented = .F.
		liIntroducedInBuild = 91
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcHash = m.loChilkatObject.GetHash(m.tcAlgorithm, m.tcEncoding, m.tcCharset)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHash
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getnth		&& Introduced in version 9.5.0.62. Returns the Nth substring in string that is a list delimted by delimiterChar. The first substring is at index 0.
		*==============================================================================
		* Method:            GetNth
		* Purpose:           Returns the Nth substring in string that is a list delimted by delimiterChar.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMatch, the matching substring number
		*                    tcDelimiter, the beginning delimiter.
		*                    tuDontSearchBetweenDoubleQuotes, whether or not
		*                    to search between double quotes within string.
		*                    tuEscapeNotADelimiter, whether or not
		*                    the escape character is treated as a delimiter.
		* Returns:           lcReturnString, the found (or not) substring.
		* Date Added:        03/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62.
		**
		** Returns the Nth substring in string that is a list delimted by delimiterChar. 
		** The first substring is at index 0. If exceptDoubleQuoted is 1, 
		** then the delimiter char found between double quotes is not treated as a delimiter. 
		** If exceptEscaped is 1, then an escaped (with a backslash) delimiter char 
		** is not treated as a delimiter.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiMatch AS Integer, tcDelimiter AS Character, ;
		tuDontSearchBetweenDoubleQuotes AS Unknown, tuEscapeNotADelimiter AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcReturnString AS Character, ;
		liDontSearchBetweenDoubleQuotes AS Integer, liEscapeNotADelimiter AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liDontSearchBetweenDoubleQuotes, m.liEscapeNotADelimiter 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcReturnString = []
		llImplemented = .F.
		liIntroducedInBuild = 62
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liDontSearchBetweenDoubleQuotes = .LogicalToBit(m.tuDontSearchBetweenDoubleQuotes)
		      liEscapeNotADelimiter = .LogicalToBit(m.tuEscapeNotADelimiter)
		
		      TRY
		
		        lcReturnString = m.loChilkatObject.GetNth(m.tiMatch, m.tcDelimiter, ;
		        m.liDontSearchBetweenDoubleQuotes, m.liEscapeNotADelimiter)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReturnString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getrange		&& Introduced in version 9.5.0.87. Returns a string containing the specified range of characters from this instance. If removeFlag is 1, then the range of chars is removed from this instance.
		*==============================================================================
		* Method:            GetRange
		* Purpose:           Returns a string containing the specified range of characters from this instance.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiStartIndex, the starting index number
		*                    tiNumCharacters, the number of characters to return.
		*                    tuRemoveCharacters, determines if the range is removed.
		* Returns:           lcRange, the string range.
		* Date Added:        03/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87.
		**
		** Returns a string containing the specified range of characters from this instance.
		** If removeFlag is 1, then the range of chars is removed from this instance.
		**
		** Note: It was discovered that the range of chars was always removed 
		** regardless of the value of removeFlag. This is fixed in v9.5.0.89.
		**
		** Fixed for version 89: The method ignored the last argument which is to tell 
		** whether to remove from the StringBuilder the range that is returned. 
		** The range was always removed regardless of the value of the last arg. 
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiStartIndex AS Integer, ;
		tiNumCharacters AS Integer, tuRemoveCharacters AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGBUILDER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liRemoveCharacters AS Integer, lcRange AS Character
		
		STORE 0 TO m.liRemoveCharacters, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcRange = []
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liRemoveCharacters = .LogicalToBit(m.tuRemoveCharacters)
		
		      TRY
		
		        lcRange = ;
		        m.loChilkatObject.GetRange(m.tiStartIndex, m.tiNumCharacters, m.liRemoveCharacters)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcRange
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getrangesb		&& Introduced in version 11.3.0. Appends to startIndex the specified range of characters from this instance. If removeFlag is 1, then the range of chars is removed from this instance. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetRangeSb
		* Purpose:           Appends to startIndex the specified range of characters from this instance.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiStartIndex, the starting index number
		*                    tiNumCharacters, the number of characters to return.
		*                    tuRemoveCharacters, determines if the range is removed.
		*                    toChilkatStringBuilder, the Chilkat Stringbuilder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/15/2025
		*==============================================================================
		
		**
		** Introduced in version 11.3.0.
		**
		** Appends to startIndex the specified range of characters from this instance. 
		** If removeFlag is 1, then the range of chars is removed from this instance.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tiStartIndex AS Integer, tiNumCharacters AS Integer, ;
		tuRemoveCharacters AS Unknown, toChilkatStringBuilder AS [Chilkat.StringBuilder]
		
		LOCAL loChilkatObject AS [Chilkat.StringBuilder], llImplemented AS Logical, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS [Chilkat.StringBuilder], liReturn AS Integer, ;
		luReturn AS Unknown, loException AS Exception
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 3, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AppendSb(m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.StringBuilder])
		  toChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder])
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT([Chilkat.StringBuilder])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE hasemojis_access		&& Access method used to retrieve the Chilkat HasEmojis property.
		*==============================================================================
		* Method:            HasEmojis_Access
		* Purpose:           Returns 1 if the content contains one or more emoji characters.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HasEmojis
		* Date Added:        07/31/2025
		*==============================================================================
		
		**
		** Introduced in version 11.1.0
		**
		** Returns 1 if the content contains one or more emoji characters.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

