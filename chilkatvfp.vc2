		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE connecttimeout_access		&& Access method used to retrieve the Chilkat HTTP ConnectTimeout property.
		*==============================================================================
		* Method:            ConnectTimeout_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP ConnectTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectTimeout
		* Date Added:        01/27/2022
		*==============================================================================
		
		**
		** The amount of time in seconds to wait before timing out when connecting to an HTTP server. 
		** The default ConnectTimeout is 30 seconds.
		**
		** Note: This is the maximum number of seconds to wait for a server to accept a TCP connection. 
		** Once the connection is accepted, and bytes begin flowing back-and-forth, 
		** then it is the ReadTimeout property that applies. 
		** It is the ReadTimeout that applies when receiving data, 
		** which includes the reads that occur during a TLS handshake.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connecttimeout_assign		&& Assign method used to hold a reference to the ConnectiTimeout property.
		*==============================================================================
		* Method:            ConnectTimeout_Assign
		* Purpose:           Assign method used to hold a reference to the ConnectTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
