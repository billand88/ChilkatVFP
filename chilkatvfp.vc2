	PROCEDURE excludeimagesmatching		&& (This method rarely needs to be called.) Tells Chilkat MHT .NET to not embed any images whose URL matches a pattern. Sometimes images can be referenced within style sheets and not actually used when rendering the page.
		*==============================================================================
		* Method:            ExcludeImagesMatching
		* Purpose:           Tells Chilkat MHT .NET to not embed 
		*                    any images whose URL matches a pattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPattern, the pattern to exclude.
		* Returns:           
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** (This method rarely needs to be called.) Tells Chilkat MHT .NET 
		** to not embed any images whose URL matches a pattern. 
		** Sometimes images can be referenced within style sheets 
		** and not actually used when rendering the page. 
		** In cases like those, the image will appear as an attachment in the HTML email. 
		** This feature allows you to explicitly remove those images 
		** from the email so no attachments appear.
		**
		
		LPARAMETERS tcPattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.ExcludeImagesMatching(m.tcPattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE fetchfromcache_access		&& Access method used to retrieve the Chilkat MHT FetchFromCache property.
		*==============================================================================
		* Method:            FetchFromCache_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MHT FetchFromCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.FetchFromCache
		* Date Added:        07/18/2022
		*==============================================================================
		
		**
		** If 1, page parts such as images, style sheets, etc. will be fetched from the disk cache 
		** if possible. The disk cache root may be defined by calling AddCacheRoot. 
		** The default value is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE fetchfromcache_assign		&& Assign method used to hold a reference to the MHT FetchFromCache property.
		*==============================================================================
		* Method:            FetchFromCache_Assign
		* Purpose:           Assign method used to hold a reference to the FetchFromCache property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the FetchFromCache property.
		* Returns:           
		* Date Added:        07/18/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE getandsaveeml		&& Creates an EML file from a web page or HTML file. All external images and style sheets are downloaded and embedded in the EML file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetAndSaveEML
		* Purpose:           Creates an EML file from a web page or HTML file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURLOrHTMLPath, the URL or HTML file path.
		*                    tcEMLFilePath, the file path to the saved EML file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Creates an EML file from a web page or HTML file. 
		** All external images and style sheets are downloaded and embedded in the EML file.
		** 
		** Fixed in version 59: MS-Word html files with %20 in file paths needed to be replaced with SPACE chars.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURLOrHTMLPath AS Character, tcEMLFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MHT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.GetAndSaveEML(m.tcURLOrHTMLPath, m.tcEMLFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MHT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

