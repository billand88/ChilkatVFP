		RETURN m.tiAbort 
		
	ENDPROC

	PROCEDURE percentdone_process		&& Template PercentDone processing method.
		*==============================================================================
		* Method:            PercentDone_Process
		* Purpose:           Template PercentDone processing method. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
