	PROCEDURE downloadbinary		&& Introduced in version 9.5.0.51. Downloads a binary file from the SSH server and returns the contents. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
		* Method:            DownloadBinary
		* Purpose:           Downloads a binary file from the SSH server and returns the contents.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePath, the path to the remote binary file.
		* Returns:           The binary file, or NULL
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.51
		**
		** Downloads a binary file from the SSH server and returns the contents.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		**
		** Fix for version 77: This method did not succeed if the remote filename contained a SPACE char.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcRemotePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCP_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lqBinaryContents AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqBinaryContents
		
		llImplemented = .F.
		liIntroducedInBuild = 51
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lqBinaryContents = m.loChilkatObject.DownloadBinary(m.tcRemotePath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqBinaryContents
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

