	ENDPROC

	HIDDEN PROCEDURE trustsystemcaroots_access		&& Access method used to retrieve the Chilkat TrustedRoots TrustSystemCARoots property.
		*==============================================================================
		* Method:            TrustSystemCARoots_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 TrustSystemCaRoots property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.TrustSystemCARoots
		* Date Added:        07/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.41
		**
		** Indicates whether the operating system's CA root certificates are automatically trusted.
		**
		** On a Windows operating system, this would be the registry-based CA certificate stores. 
		** On a Linux system, this could be /etc/ssl/certs/ca-certificates.crt, if it exists. 
		** The default value is 1. Set this property equal to 0 to prevent Chilkat 
		** from automatically trusting system-provided root CA certificates.
		**
		** Fixed for Version 59: When verifying the web server certificate for a TLS connection, 
		** the Windows registry-based root CA cert stores were not being searched when this property was set to true.
		** Now Chilkat will correctly search for the root cert, and if found, will trust the root cert.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 41
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE trustsystemcaroots_assign		&& Assign method used to hold a reference to the TrustSystemCARoots property.
		*==============================================================================
		* Method:            TrustSystemCARoots_Assign
		* Purpose:           Assign method used to hold a reference to the TrustSystemCARoots property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the TrustSystemCARoots property.
		* Returns:           
		* Date Added:        07/07/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 41
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat TrustedRoots VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/07/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/07/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 38
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS unixcompress AS ibasechilkat OF "chilkatvfp.vcx" 		&& UNIX (.Z) compression component.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat UnixCompress AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: compressfile		&& Compresses a file to create a UNIX compressed file (.Z). This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm. Returns 1 for success, 0 for failure.
		*m: compressfileasync		&& Creates an asynchronous task to call the CompressFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressfiletomem		&& Unix compresses a file to an in-memory image of a .Z file. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: compressfiletomemasync		&& Creates an asynchronous task to call the CompressFileToMem method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: compressmemory		&& Compresses in-memory data to an in-memory image of a .Z file. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns a zero-length byte array (as a Variant) on failure.
		*m: compressmemtofile		&& Unix compresses and creates a .Z file from in-memory data. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns 1 for success, 0 for failure.
		*m: compressstring		&& Compresses a string to an in-memory image of a .Z file. Prior to compression, the string is converted to the character encoding specified by charset.
		*m: compressstringtofile		&& Unix compresses and creates a .Z file from string data. The charset specifies the character encoding used for the byte representation of the characters when compressed.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat UnixCompress DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: heartbeatms_access		&& Access method used to retrieve the Chilkat UnixCompress HeartbeatMs property.
		*m: heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*m: isunlocked		&& Undocumented method! Returns true if the class has been unlocked. It is necessary to call UnlockComponent before calling any other methods. Passing any string to UnlockComponent will automatically activate a 30-day trial period.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat UnixCompress LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat UnixCompress LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat UnixCompress LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText  property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat UnixCompress LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat UnixCompress LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat UnixCompress LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat UnixCompress LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: readfile		&& Convenience method to read an entire file and return as a byte array. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: uncompressfile		&& Uncompresses a .Z file. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns 1 for success, 0 for failure.
		*m: uncompressfileasync		&& Creates an asynchronous task to call the UncompressFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uncompressfiletomem		&& Uncompresses a .Z file directly to memory. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*m: uncompressfiletomemasync		&& Creates an asynchronous task to call the UncompressFileToMem method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uncompressfiletostring		&& Uncompresses a .Z file that contains a text file. The contents of the text file are returned as a string. The character encoding of the text file is specified by charset.
		*m: uncompressfiletostringasync		&& Creates an asynchronous task to call the UncompressFileToString method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: uncompressmemory		&& Uncompresses from an in-memory image of a .Z file directly into memory. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns a zero-length byte array (as a Variant) on failure.
		*m: uncompressmemtofile		&& Uncompresses from an in-memory image of a .Z file to a file. (This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.) Returns 1 for success, 0 for failure.
		*m: uncompressstring		&& Uncompresses from an in-memory image of a .Z file directly to a string. The charset specifies the character encoding used to interpret the bytes resulting from the decompression.
		*m: unlockcomponent		&& Undocumented function! Appears related to Chilkat licensing.
		*m: untarz		&& Unpacks a .tar.Z file. The decompress and untar occur in streaming mode. There are no temporary files and the memory footprint is constant (and small) while untarring. Returns 1 for success, 0 for failure.
		*m: untarzasync		&& Creates an asynchronous task to call the UnTarZ method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat UnixCompress VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: writefile		&& Convenience method for writing the contents of a byte array to a file. Returns 1 for success, 0 for failure.
		*p: abortcurrent		&& Introduced in version 9.5.0.58. When set to 1, causes the currently running method to abort. Methods that always finish quickly (i.e.have no length file operations or network communications) are not affected.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: heartbeatms		&& The number of milliseconds between each AbortCheck event callback. The AbortCheck callback allows an application to abort any method call prior to completion. If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		abortcurrent = 0
		cchilkatclass = UnixCompress
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		heartbeatms = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "unixcompress"
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat UnixCompress AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat UnixCompress AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        07/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/07/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Removed the UnlockComponent method.
		
		  Removed the IsUnlocked method.
		
		** Version 10.1.2
		
		  Fixed a crash bug in UnixCompress. This fix could also apply to the Chilkat Tar 
		  when creating .tar.Z compressed archives.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Added the AbortCurrent property to classes that can have event callbacks.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added asynchronous functionality for all qualifying methods
		  across all programming languages, operating systems, and architectures.
		  Each Chilkat method that can potentially be time-consuming or involve network communications,
		  now has a corresponding asynchronous version of the method with the name ending in “Async”.
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE compressfile		&& Compresses a file to create a UNIX compressed file (.Z). This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            CompressFile
		* Purpose:           Compresses a file to create a UNIX compressed file (.Z).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file to compress
		*                    tcDestinationFilePath, the path to the compressed file.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Compresses a file to create a UNIX compressed file (.Z). 
		** This compression uses the LZW (Lempel-Ziv-Welch) compression algorithm.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFileName AS Character, tcDestinationFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_UNIXCOMPRESS_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.CompressFile(m.tcFileName, ;
		      m.tcDestinationFilePath) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UNIXCOMPRESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE compressfileasync		&& Creates an asynchronous task to call the CompressFile method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            CompressFileAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    CompressFile method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file to compress
		*                    tcDestinationFilePath, the path to the compressed file.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the CompressFile method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character, tcDestinationFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_UNIXCOMPRESS_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.CompressFileAsync(m.tcFileName, m.tcDestinationFilePath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_UNIXCOMPRESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

