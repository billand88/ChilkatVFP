	PROCEDURE rc2effectivekeylength		&& Method run to validate the data for the RC2EffectiveKeyLength property.
		*==============================================================================
		* Method:            RC2EffectiveKeyLength
		* Purpose:           Method run to validate the data for 
		*                    the Crypt2 RC2EffectiveKeyLength property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, the value to validate
		*                    toChilkatWrapper, the object holding the property to set.
		* Returns:           Logical, indicating successful validation.
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX]
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		liValue AS Integer, llValidated AS Logical, ;
		lcEncryptionAlgorithm AS Character
		
		** "Park" the parameters
		loChilkatWrapper = m.toChilkatWrapper
		liValue = m.tiValue
		
		lcEncryptionAlgorithm = m.loChilkatWrapper.CryptAlgorithm
		
		llValidated = NOT (UPPER(ALLTRIM(m.lcEncryptionAlgorithm)) == [RC2])
		
		** Not validated yet test
		IF NOT m.llValidated
		
		  llValidated = (VARTYPE(m.liValue) == T_INTEGER) ;
		  AND BETWEEN(m.liValue, 8, 1024)
		
		ENDIF NOT m.llValidated
		** End not validated yet test
		
		loChilkatWrapper = NULL
		
		RETURN m.llValidated
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

