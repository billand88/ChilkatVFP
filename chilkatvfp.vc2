		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fetchmimebymsgnum		&& Fetches an email by message number and returns the MIME source of the email in a byte array. WARNING: Message sequend numbers are specific to a POP3 session.
		*==============================================================================
		* Method:            FetchMIMEByMsgNum
		* Purpose:           Fetches an email by message number 
		*                    and returns the MIME source of the email in a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMsgNum -- the email message number.
		* Returns:           Email MIME source
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** Fetches an email by message number and returns the MIME source of the email in a byte array. 
		** WARNING: Message sequend numbers are specific to a POP3 session. 
		** If a maildrop has (for example) 10 messages, the message numbers will be 1, 2, 3, ... 10. 
		** If message number 1 is deleted and a new POP3 session is established, 
		** there will be 9 messages numbered 1, 2, 3, ... 9.
		**
		** IMPORTANT: A POP3 connection must first be established by either calling Pop3BeginSession explicitly, 
		** or implicitly by calling some other method that automatically establishes the session. 
		** This method will not automatically establish a new POP3 session 
		** (because if it did, the message numbers would potentially be different than what the application expects).
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tiMsgNum AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, lqEmailMIMESource AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqEmailMIMESource
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      lqEmailMIMESource = m.loChilkatObject.FetchMIMEByMsgNum(m.tiMsgNum)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqEmailMIMESource
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

