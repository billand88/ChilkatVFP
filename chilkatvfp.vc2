	PROCEDURE getreceivedsb		&& Introduced in version 11.6.0. Decodes and appends to sb all text currently accumulated in the normal receive buffer for channelNum, using charset. The receive buffer is cleared after the text is returned. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetReceivedSb
		* Purpose:           Appends all bytes currently accumulated in the normal 
		*                    receive buffer for channelNum to bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		*                    toChilkatStringBuilder, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0
		**
		** Decodes and appends to sb all text currently accumulated in the normal receive buffer 
		** for channelNum, using charset. The receive buffer is cleared after the text is returned.
		** 
		** For a valid retained channel with no buffered data, an empty string is returned successfully. 
		** For an invalid or no-longer-retained channel, the string-returning API reports failure. 
		** After channel completion, retrieve text immediately before unrelated SSH operations 
		** can discard the completed channel record.
		**
		** When StripColorCodes is 1, ANSI SGR color/style sequences are removed 
		** from the returned normal text. Other terminal-control sequences can remain.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiChannel AS Integer, toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, luReturn AS Unknown, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatStringBuilder
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetReceivedSb(m.tiChannel, m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getreceivedstderr		&& Introduced in version 9.5.0.48. Returns the accumulated stderr bytes received on the channel indicated by channelNum and clears the channel's internal stderr receive buffer.
		*==============================================================================
		* Method:            GetReceivedStdErr
		* Purpose:           Returns the accumulated stderr bytes received on the channel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		* Returns:           The accumulated standard error bytes
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.48
		**
		** Returns the accumulated stderr bytes received on the channel indicated 
		** by channelNum and clears the channel's internal stderr receive buffer.
		**
		** Note: If the StderrToStdout property is set to 1, 
		** then stderr is automatically redirected to stdout. This is the default behavior. 
		** The following methods can be called to retrieve the channel's stdout: 
		** GetReceivedData, GetReceivedDataN, GetReceivedText, and GetReceivedTextS.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		**
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tiChannel AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		lqData AS VarBinary, llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqData
		
		llImplemented = .F.
		liIntroducedInBuild = 48
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lqData = m.loChilkatObject.GetReceivedStdErr(m.tiChannel)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getreceivedstderrtext		&& Returns the accumulated stderr text received on the channel indicated by channelNum and clears the channel's internal receive buffer. The charset indicates the charset of the character data in the internal receive buffer.
