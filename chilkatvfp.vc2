		* Method:            PrngName_Assign
		* Purpose:           Assign method used to hold
		*                    the PrngName of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the PrngName property.
		* Returns:           
		* Date Added:        04/23/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE randomint		&& Introduced in version 9.5.0.52. Generates and returns a random integer between low and high (inclusive). For example, if low is 4 and high is 8, then random integers in the range 4, 5, 6, 7, 8 are returned.
		*==============================================================================
		* Method:            RandomInt
		* Purpose:           Generates and returns a random integer between low and high (inclusive).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiLowValue -- the low integer value
		*                    tiHighValue -- the high integer value
		* Returns:           Random string bytes
		* Date Added:        04/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Generates and returns a random integer between low and high (inclusive). 
		** For example, if low is 4 and high is 8, 
		** then random integers in the range 4, 5, 6, 7, 8 are returned.
		**
		
		LPARAMETERS tiLowValue AS Integer, tiHighValue AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		liRandom AS Integer, llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liRandom, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liRandom = m.loChilkatObject.RandomInt(m.tiLowValue, m.tiHighValue)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		 
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liRandom 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE randompassword		&& Introduced in version 9.5.0.52. Generates and returns a random password of a specified length. If mustIncludeDigit is 1, the generated password will contain at least one digit (0-9).
		*==============================================================================
		* Method:            RandomPassword
		* Purpose:           Generates and returns a random password of a specified length. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiPasswordLength -- the password length
		*                    tuMustIncludeDigit -- whether or not digits are included
		*                    tuCaseInsensitive -- whether it is case insensitive
		*                    tcMustHaveOneOf -- characters that must be in string
		*                    tcExcludeCharacters -- characters to exclude from string
		* Returns:           Random password
		* Date Added:        04/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** Generates and returns a random password of a specified length. 
		** If mustIncludeDigit is 1, the generated password will contain at least one digit (0-9). 
		** If upperAndLowercase is 1, then generated password will contain 
		** both lowercase and uppercase USASCII chars (a-z and A-Z). 
		** If mustHaveOneOf is a non-empty string, ;
		** it contains the set of non-alphanumeric characters, 
		** one of which must be included in the password. 
		** For example, mustHaveOneOf might be the string "!@#$%". 
		** If excludeChars is a non-empty string, 
		** it contains chars that should be excluded from the password. 
		** A typical need would be to exclude chars that appear 
		** similar to others, such as i, l, 1, L, o, 0, O.
		**
		** Fixed for Version 55: This method was fixed. 
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiPasswordLength AS Integer, tuMustIncludeDigit AS Unknown, ;
		tuCaseInsensitive AS Unknown, tcMustHaveOneOf AS Character, ;
		tcExcludeCharacters AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liMustIncludeDigit AS Integer, liCaseInsensitive AS Integer, ;
		lcRandomPassword AS Character
		
		STORE 0 TO m.liIntroducedInBuild, m.liMustIncludeDigit, m.liCaseInsensitive
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		lcRandomPassword = []
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liMustIncludeDigit = .LogicalToBit(m.tuMustIncludeDigit)
		      liCaseInsensitive = .LogicalToBit(m.tuCaseInsensitive)
		
		      TRY
		
		        lcRandomPassword = m.loChilkatObject.RandomPassword(m.tiPasswordLength, ;
		        m.liMustIncludeDigit, m.liCaseInsensitive, m.tcMustHaveOneOf, m.tcExcludeCharacters)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcRandomPassword 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE randomstring		&& Introduced in version 9.5.0.52. Generates and returns a random string that may contain digits (0-9), lowercase ASCII (a-z) , and uppercase ASCII (A-Z). To include numeric digits, set bDigits equal to 1. To include lowercase ASCII, set bLower equal to 1.
		*==============================================================================
		* Method:            RandomString
		* Purpose:           Generates and returns a random string that may contain digits (0-9), 
		*                    lowercase ASCII (a-z) , and uppercase ASCII (A-Z).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiStringLength -- the String length
		*                    tuUseDigits -- whether or not digits are included
		*                    tuUseLowerCase -- whether it is case insensitive
		*                    tuUseUpperCase -- characters that must be in string
		* Returns:           Random string
		* Date Added:        04/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		**
		** Generates and returns a random string that may contain digits (0-9), 
		** lowercase ASCII (a-z) , and uppercase ASCII (A-Z). 
		** To include numeric digits, set bDigits equal to 1. 
		** To include lowercase ASCII, set bLower equal to 1. 
		** To include uppercase ASCII, set bUpper equal to 1. 
		** The length of the string to be generated is specified by length.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiStringLength AS Integer, tuUseDigits AS Unknown, ;
		tuUseLowerCase AS Unknown, tuUseUpperCase AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PRNG_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liUseDigits AS Integer, liUseLowerCase AS Integer, ;
		liUseUpperCase AS Integer, lcRandomString AS Character
		
		STORE 0 TO m.liIntroducedInBuild, m.liUseDigits, m.liUseLowerCase, m.liUseUpperCase
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		lcRandomString = []
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUseDigits = .LogicalToBit(m.tuUseDigits)
		      liUseLowerCase = .LogicalToBit(m.tuUseLowerCase)
		      liUseUpperCase = .LogicalToBit(m.tuUseUpperCase)
		
		      TRY
		
		        lcRandomString = m.loChilkatObject.RandomString(m.tiStringLength, ;
		        m.liUseDigits, m.liUseLowerCase, m.liUseUpperCase)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcRandomString 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PRNG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat Prng VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        04/24/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        04/24/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 52
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS process AS ibase OF "chilkatvfp.vcx" 		&& Template processing object.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<PropValue>
		Name = "process"
	*</PropValue>

ENDDEFINE

DEFINE CLASS process_access AS iprocess OF "chilkatvfp.vcx" 		&& Object used to generically process an Access method.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: callchilkat		&& Method run to call the Chilkat object to retrieve the property.
		*m: datetime		&& Method run to process the Access method for a property that returns a DateTime from the Chilkat object.
		*m: datetimereadonly		&& Method run to process the Access method for a property that returns a DateTime and is read only from the Chilkat object.
		*m: long		&& Method run to process the Access method for a property that returns a Long from the Chilkat object.
		*m: longbit		&& Method run to process the Access method for a property that returns a Long (0 or a 1) from the Chilkat object.
		*m: longbitreadonly		&& Method run to process the Access method for a property that returns a Long (0 or a 1) and is read only from the Chilkat object.
		*m: longreadonly		&& Method run to process the Access method for a property that returns a Long and is read only from the Chilkat object.
		*m: string		&& Method run to process the Access method for a property that returns a String (character) from the Chilkat object.
		*m: stringreadonly		&& Method run to process the Access method for a property that returns a String and is read only from the Chilkat object.
		*m: variant		&& Method run to process the Access method for a property that returns a VarBinary from the Chilkat object.
		*m: variantreadonly		&& Method run to process the Access method for a property that returns a Variant and is read only from the Chilkat object.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "process_access"
	*</PropValue>
	
	PROCEDURE callchilkat		&& Method run to call the Chilkat object to retrieve the property.
		*==============================================================================
		* Method:            CallChilkat
		* Purpose:           Method run to call the Chilkat object to retrieve the property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the calling Chilkat wrapper object
		*                    tcMethodToCall -- the method to call after validation
		* Returns:           
		* Date Added:        03/30/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcMethodToCall AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcProperty AS Character, ;
		lcMethodToCall AS Character, lcMethod AS Character, lcSecondParameter AS Character, ;
		liStackLevel AS Integer, lcClass AS Character, liCurrentBuild AS Integer, ;
		lcObject AS Character, lcPEMType AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liCurrentBuild, m.liStackLevel
		STORE [] TO m.lcProperty, m.lcMethodToCall, m.lcMethod, ;
		m.lcSecondParameter, m.lcClass, m.lcObject, m.lcPEMType, m.la_Stack
		
		** "Park" the parameters, use local memory variables
		loChilkatWrapper = m.toChilkatWrapper
		lcMethodToCall = m.tcMethodToCall
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(IIF(m.liStackLevel > 2, m.liStackLevel - 2, m.liStackLevel), 3)
		lcObject = PROPER(LEFTC(m.lcMethod, MAX(ATC([.], m.lcMethod) - 1, 0)))
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		** Normally I prefer clearer code but this method will get called a lot...
		lcClass = LEFTC(PROPER(m.la_Stack(m.liStackLevel - 2, 3)), ;
		MAX(ATC([.], m.la_Stack(m.liStackLevel - 2, 3)) - 1, 0))
		
		lcSecondParameter = m.lcClass + [~] + m.lcMethod + [~] + m.lcPEMType
		
		WITH THIS
		
		  ** Parameter validation test
		  IF TYPE([loChilkatWrapper.Name]) == T_CHARACTER
		
		    ** Parameter validation test
		    IF (NOT EMPTY(m.lcMethodToCall) ;
		    AND PEMSTATUS(THIS, m.lcMethodToCall, 5))
		
		      ** Call the next method...
		      .&lcMethodToCall.(m.loChilkatWrapper, m.lcMethod)
		
		    ELSE
		
		      lcMethod = m.la_Stack(m.liStackLevel, 3)
		      lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		      lcSecondParameter = .Class + [~] + m.lcMethod + [~] + [method]
		
		      ** Error processing branch
		      DO CASE
		
		        ** No Chilkat property passed test
		        CASE EMPTY(m.lcMethodToCall)
		
		          lcSecondParameter = [calling Chilkat] + [~] + m.lcMethod + [~] + [method]
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		        ** No method to call test
		        CASE NOT PEMSTATUS(THIS, m.lcMethodToCall, 5)
		
		          lcSecondParameter = .Class + [~] + m.lcMethod + [~] + [method]
		          lcErrorMessage = ChMsgSvc([Missing object method], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF (NOT EMPTY(m.lcMethodToCall) ;
		    AND PEMSTATUS(THIS, m.lcMethodToCall, 5))
		    ** End parameter validation test
		
		  ELSE
		
		    ** Error processing branch
		    DO CASE
		
		      ** No object test
		      CASE TYPE([loChilkatWrapper.Name]) # T_CHARACTER
		
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ** No wrapper property test
		      CASE NOT PEMSTATUS(m.loChilkatWrapper, [Version], 5)
		
		        lcErrorMessage = ChMsgSvc([Missing object method], m.lcSecondParameter, , THIS)
		
		    ENDCASE
		    ** End error processing branch
		
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF TYPE([loChilkatWrapper.Name]) == T_CHARACTER
		  ** End parameter validation test
		
		ENDWITH
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		loChilkatWrapper = NULL
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE datetime		&& Method run to process the Access method for a property that returns a DateTime from the Chilkat object.
		*==============================================================================
		* Method:            DateTime
		* Purpose:           Method run to process the Access method for a property 
		*                    that returns a DateTime value from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        05/26/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		** For accessing a property, DateTime is exactly the same as DateTimeReadOnly. 
		
		RETURN THIS.DateTimeReadOnly(m.toChilkatWrapper, m.tcCallingMethod)
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE datetimereadonly		&& Method run to process the Access method for a property that returns a DateTime and is read only from the Chilkat object.
		*==============================================================================
		* Method:            DateTimeReadOnly
		* Purpose:           Method run to process the Access method for a property 
		*                    that returns a DateTime and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        05/26/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcStatement AS Character lcErrorMessage AS Character, loChilkatObject AS Object, ;
		ltValue AS DateTime, lcProperty AS Character, lcStatement AS Character, ;
		lcMethod AS Character, liStackLevel AS Integer, lcPEMType AS Character, ;
		lcSecondParameter AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcStatement, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		ltValue = {/:}
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = PROPER(STRTRAN(m.la_Stack(IIF(m.liStackLevel > 1, ;
		m.liStackLevel - 1, m.liStackLevel), 3), [.], [ ]))
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([ ], m.lcMethod) + 1))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		  lcProperty = LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7)
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcProperty)) == T_DATETIME
		
		      ltValue = EVALUATE([loChilkatObject.] + m.lcProperty)
		      lcValue = TTOC(m.ltValue)
		
		      lcStatement = [loChilkatWrapper.] + m.lcProperty + [ = CTOT(] + '[' + m.lcValue + ']' + [)]
		
		      TRY
		
		        ** This line below is where the property is set to the value.
		        &lcStatement.
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Object not referenced correctly test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcProperty)) # T_DATETIME
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcProperty)) == T_DATETIME
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

