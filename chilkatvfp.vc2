	HIDDEN PROCEDURE abortcurrent_access		&& Access method used to retrieve the Chilkat MailMan AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AbortCurrent
		* Date Added:        01/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** When set to 1, causes the currently running method to abort. 
		** Methods that always finish quickly (i.e.have no length file operations or network communications) 
		** are not affected. If no method is running, then this property is automatically 
		** reset to 0 when the next method is called. When the abort occurs, 
		** this property is reset to 0. Both synchronous and asynchronous method calls can be aborted. 
		** (A synchronous method call could be aborted by setting this property from a separate thread.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*==============================================================================
		* Method:            AbortCurrent_Assign
		* Purpose:           Assign method used to hold a reference to the AbortCurrent property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AbortCurrent property.
		* Returns:           
		* Date Added:        01/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE addpfxsourcebd		&& Introduced in version 11.0.0. Adds a PFX file to the object's list of sources for locating certificates and private keys during decryption or signing. To add multiple PFX sources, call this method for each file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AddPfxSourceBd
		* Purpose:           Adds a PFX file to the object's list of sources for locating 
		*                    certificates and private keys during decryption or signing. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Email object.
		*                    tcPassword, the PFX password.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Adds a PFX file to the object's list of sources for locating certificates 
		** and private keys during decryption or signing. To add multiple PFX sources, 
		** call this method for each file. bd should contain the bytes of a PFX file 
		** (also known as PKCS12 or .p12). The password is the password to the PFX.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown, llImplemented AS Logical
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddPfxSourceBd(m.loChilkatBinData, ;
		        m.tcPassword) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addpfxsourcedata		&& Adds a PFX to the object's internal list of sources to be searched for certificates and private keys when decrypting or when creating signed email for sending. Multiple PFX sources can be added by calling this method once for each.
		*==============================================================================
		* Method:            AddPfxSourceData
		* Purpose:           Adds a PFX to the object's internal list of sources 
		*                    to be searched for certificates and private keys 
		*                    when decrypting or when creating signed email for sending. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPFXData -- contains the bytes of a PFX file
		*                    tcPassword -- the password to the PFX file
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/13/2022
		*==============================================================================
		
		**
		** Adds a PFX to the object's internal list of sources to be searched for certificates 
		** and private keys when decrypting or when creating signed email for sending. 
		** Multiple PFX sources can be added by calling this method once for each. 
		** (On the Windows operating system, the registry-based certificate stores 
		** are also automatically searched, so it is commonly not required to explicitly add PFX sources.)
		**
		** The pfxData contains the bytes of a PFX file (also known as PKCS12 or .p12).
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqPFXData AS VarBinary, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddPFXSourceData(m.tqPFXData, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addpfxsourcefile		&& Adds a PFX file to the object's internal list of sources to be searched for certificates and private keys when decrypting or when sending signed email. Multiple PFX files can be added by calling this method once for each.
		*==============================================================================
		* Method:            AddPFXSourceFile
		* Purpose:           Adds a PFX to the object's internal list of sources 
		*                    to be searched for certificates and private keys 
		*                    when decrypting or when creating signed email for sending. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath -- contains the path to the PFX file
		*                    tcPassword -- the password to the PFX file
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Adds a PFX file to the object's internal list of sources to be searched 
		** for certificates and private keys when decrypting or when sending signed email. 
		** Multiple PFX files can be added by calling this method once for each. 
		** (On the Windows operating system, the registry-based certificate stores 
		** are also automatically searched, so it is commonly not required 
		** to explicitly add PFX sources.)
		**
		** The pfxFilePath contains the bytes of a PFX file (also known as PKCS12 or .p12).
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePath AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AddPFXSourceFile(m.tcFilePath, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE allornone_access		&& Access method used to retrieve the Chilkat MailMan AllOrNone property.
		*==============================================================================
		* Method:            AllOrNone_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan AllOrNone property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AllOrNone
		* Date Added:        01/06/2022
		*==============================================================================
		
		** Prevents sending any email if any of the addresses in the recipient list are rejected 
		** by the SMTP server. The default value is 0, which indicates that the mail sending 
		** should continue even if some email addresses are invalid. 
		** (Note: Not all SMTP servers check the validity of email addresses, 
		** and even for those that do, it is not 100% accurate.)
		**
		** Note: An SMTP server only knows the validity of email addresses within the domain it controls.
		**
		** Important: The AllOrNone property only works if SMTP pipelining is turned off. 
		** By default, the SmtpPipelining property is turned on and has the value of 1. 
		** If all-or-none behavior is desired, make sure to set SmtpPipelining equal to 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE allornone_assign		&& Assign method used to hold a reference to the AllOrNone property.
		*==============================================================================
		* Method:            AllOrNone_Assign
		* Purpose:           Assign method used to hold a reference to the AllOrNone property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AllOrNone property.
		* Returns:           
		* Date Added:        01/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character, llValue AS Logical
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		llValue = .F.
		
		WITH THIS
		
		  .CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		  llValue = .BitToLogical(m.tuValue)
		
		  ** Value turned on test
		  IF m.llValue
		
		    .SMTPPipelining = 0
		
		  ENDIF m.llValue
		  ** End value turned on test
		
		ENDWITH
		
		RETURN
	ENDPROC

	PROCEDURE autofixsettings		&& Method to run after a connection is made to the server and the AutoFix property is set to 1.
		*==============================================================================
		* Method:            AutoFixSettings
		* Purpose:           Method to run after a connection is made to the server 
		*                    and the AutoFix property is set to 1.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/20/2022
		* Note:              Not a native Chilkat method.
		*==============================================================================
		
		LOCAL liStackLevel AS Integer, liReturn AS Integer, ;
		lcMethod AS Character, luReturn AS Unknown, llIsSMTP AS Logical, ;
		liSMTPPort AS Integer, liMailPort AS Integer, llIsAsynchronous AS Logical, ;
		llConnectionVerified AS Logical
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcMethod, m.la_Stack
		STORE 0 TO m.liReturn, m.liSMTPPort, m.liMailPort, m.liStackLevel, m.luReturn
		STORE .F. TO m.llIsSMTP, m.llIsAsynchronous, m.llConnectionVerified
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		** What method did we come from?
		lcMethod = UPPER(STRTRAN(m.la_Stack(m.liStackLevel - 1, 3), [.], [ ]))
		
		llIsSMTP = [SMTP] $ m.lcMethod
		llIsAsynchronous = [ASYNC] $ m.lcMethod
		
		WITH THIS
		
		  luReturn = .AutoFix
		  liReturn = .LogicalToBit(m.luReturn)
		
		  liSMTPPort = .SMTPPort
		  liMailPort = .MailPort
		
		  ** AutoFix On test
		  IF m.liReturn = 1
		
		    ** Synchronous thread test
		    IF NOT m.llIsAsynchronous
		
		      ** Connection verification branch
		      DO CASE
		
		        ** POP3 connection test
		        CASE NOT m.llIsSMTP
		
		          llConnectionVerified = .VerifyPOPConnection()
		
		        ** SMTP Connection test
		        CASE m.llIsSMTP
		
		          llConnectionVerified = .VerifySMTPConnection()
		
		      ENDCASE
		      ** End connection verification branch
		
		    ELSE && asynchronous thread
		
		      ** Connection verification branch
		      DO CASE
		
		        ** POP3 connection test
		        CASE NOT m.llIsSMTP
		
		          llConnectionVerified = .VerifyPOPConnectionAsync()
		
		        ** SMTP Connection test
		        CASE m.llIsSMTP
		
		          llConnectionVerified = .VerifySMTPConnectionAsync()
		
		      ENDCASE
		      ** End connection verification branch
		
		    ENDIF NOT m.llIsAsynchronous
		    ** End synchronous connection test
		
		    ** Verified connection test
		    IF m.llConnectionVerified
		
		      ** SMTP Port processing branch
		      DO CASE
		
		        ** SMTP Port = 465 test
		        CASE m.liSMTPPort = 465
		
		          .StartTLS = 0
		          .SMTPSSL = 1
		
		        ** SMTP Port = 25 test
		        CASE m.liSMTPPort = 465
		
		          .SMTPSSL = 0
		
		      ENDCASE
		      ** End SMTP Port processing branch
		
		      ** Mail Port processing branch
		      DO CASE
		
		        ** Mail Port = 995 test
		        CASE m.liMailPort = 995
		
		          .PopSSL = 1
		
		        ** Mail Port = 995 test
		        CASE m.liMailPort = 110
		
		          .PopSSL = 0
		
		      ENDCASE
		      ** End mail Port processing branch
		
		    ELSE
		
		      .ProcessErrorMessage([Connection not verified at ] + TTOC(DATETIME(), 1) + [!], THIS)
		
		    ENDIF m.llConnectionVerified
		    ** End verified connection test
		
		  ENDIF m.liReturn = 1
		  ** End AutoFix On test
		
		ENDWITH
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE autofix_access		&& Access method used to retrieve the Chilkat MailMan AutoFix property.
		*==============================================================================
		* Method:            AutoFix_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan AutoFix property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoFix
		* Date Added:        01/06/2022
		*==============================================================================
		
		** If 1, then the following will occur when a connection is made to an SMTP or POP3 server:
		** 
		** 1) If the SmtpPort property = 465, then sets StartTLS = 0 and SmtpSsl = 1
		** 2) If the SmtpPort property = 25, sets SmtpSsl = 0
		** 3) If the MailPort property = 995, sets PopSsl = 1
		** 4) If the MailPort property = 110, sets PopSsl = 0
		** 
		** The default value of this property is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autofix_assign		&& Assign method used to hold a reference to the AutoFix property.
		*==============================================================================
		* Method:            AutoFix_Assign
		* Purpose:           Assign method used to hold a reference to the AutoFix property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoFix property.
		* Returns:           
		* Date Added:        01/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE autogenmessageid_access		&& Access method used to retrieve the Chilkat MailMan AutoGenMessageID property.
		*==============================================================================
		* Method:            AutoGenMessageID_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan AutoGenMessageID property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoGenMessageID
		* Date Added:        01/06/2022
		*==============================================================================
		
		** 
		** Controls whether a unique Message-ID header is auto-generated for each email sent.
		**
		** The Message-ID header field should contain a unique message ID for each email that is sent. 
		** The default behavior is to auto-generate this header field at the time the message is sent. 
		** This makes it easier for the same email object to be re-used. 
		** If the message ID is not unique, the SMTP server may consider the message to be a duplicate 
		** of one that has already been sent, and may discard it without sending. 
		** This property controls whether message IDs are automatically generated. 
		** If auto-generation is turned on (1), the value returned by GetHeaderField("Message-ID") 
		** will not reflect the actual message ID that gets sent with the email.
		**
		** To turn off automatic Message-ID generation, set this property to 0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autogenmessageid_assign		&& Assign method used to hold a reference to the AutoGenMessageID property.
		*==============================================================================
		* Method:            AutoGenMessageID_Assign
		* Purpose:           Assign method used to hold a reference to the AutoGenMessageID property.
