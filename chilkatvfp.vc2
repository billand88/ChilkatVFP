		RETURN
	ENDPROC

	PROCEDURE converttotls		&& Explicitly converts the control channel to a secure SSL/TLS connection.
		*==============================================================================
		* Method:            ConvertToTLS
		* Purpose:           Explicitly converts the control channel to a secure SSL/TLS connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Explicitly converts the control channel to a secure SSL/TLS connection.
		**
		** Note: If you initially connect with either the AuthTls or AuthSsl property set to 1, 
		** then DO NOT call ConvertToTls. The control channel is automatically converted 
		** to SSL/TLS from within the Connect method when these properties are set.
		**
		** Note: It is very uncommon for this method to be needed.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ConvertToTLS() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE converttotlsasync		&& Creates an asynchronous task to call the ConvertToTls method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            ConvertToTLSAsync
		* Purpose:           Creates an asynchronous task to call the 
