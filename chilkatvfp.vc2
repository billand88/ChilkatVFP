	PROCEDURE appenddataencoded		&& Introduced in version 9.5.0.59. Appends in-memory data as a new entry to a Zip object. The filename is the filename of the entry as it will appear within the zip. The encoding is the encoding of the data, such as "base64", "hex", etc.
		*==============================================================================
		* Method:            AppendDataEncoded
		* Purpose:           Appends in-memory data as a new entry to a Zip object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- Filename of the entry within the zip. 
		*                    tcEncoding -- the data encoding
		*                    tcData -- the data to apend.
		* Returns:           toChilkatZipEntry, a Chilkat Zip Entry object.
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		**
		** Appends in-memory data as a new entry to a Zip object. 
		** The filename is the filename of the entry as it will appear within the zip. 
		** The encoding is the encoding of the data, such as "base64", "hex", etc. 
		** The full list of encodings is listed at the web page linked below.
		**
		** Returns the zip entry object.
		** 
		** Note: This method only updates the zip object. 
		** To update (rewrite) a zip file, either the WriteZip 
		** or WriteZipAndClose method would need to be called.
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character, tcEncoding AS Character, tcData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, loChilkatZipEntry AS CHILKAT_ZIPENTRY_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatZipEntry
		
		llImplemented = .F.
		liIntroducedInBuild = 59
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatZipEntry = ;
		        m.loChilkatObject.AppendDataEncoded(m.tcFileName, m.tcEncoding, m.tcData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatZipEntry
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE appendfiles		&& Appends one or more files to the Zip object. The filePattern can use the "*" wildcard character for 0 or more of any characterSet recurse equal to True to recursively add all subdirectories, or False to only add files in the current directory.
		*==============================================================================
		* Method:            AppendFiles
		* Purpose:           Appends one or more files to the Zip object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePattern -- the file pattern filter.
		*                    tuRecursive -- whether or not to recurse subdirectories.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/29/2022
		*==============================================================================
		
		**
		** Appends one or more files to the Zip object. 
		** The filePattern can use the "*" wildcard character for 0 or more
		** of any characterSet recurse equal to True to recursively 
		** add all subdirectories, or False to only add files in the current directory.
		**
		** Note: This method only updates the zip object. 
		** To update (rewrite) a zip file, either the WriteZip 
		** or WriteZipAndClose method would need to be called.
		**
		** Fixed for Version 52: Fixed this method for non-Windows implementations.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePattern AS Character, tuRecursive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liRecursive AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liRecursive
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liRecursive = .LogicalToBit(m.tuRecursive)
		
		    TRY
		
		      STORE m.loChilkatObject.AppendFiles(m.tcFilePattern, m.liRecursive) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

