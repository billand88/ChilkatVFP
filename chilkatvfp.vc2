	PROCEDURE getsearchresults		&& Introduced in version 11.6.0. Returns the web search sources the model used in the most recent Ask, if web search was enabled via the web_search param of SetAskParams .
		*==============================================================================
		* Method:            GetSearchResults
		* Purpose:           Returns the web search sources the model used in the most recent Ask.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObject, a Chilkat Json object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Returns the web search sources the model used in the most recent Ask, 
		** if web search was enabled via the web_search param of SetAskParams. 
		** Returns 1 if the last Ask performed one or more web searches, 
		** in which case the normalized results are placed in json. 
		** Returns 0 if no web search occurred.
		**
		** Chilkat normalizes the differing citation formats of each AI provider into a single flat structure. 
		** json is populated as follows:
		
		**   {
		**     "search_results": [
		**       {
		**         "url": "https://example.com/article",
		**         "title": "Example Article Title",
		**         "snippet": "The relevant excerpt the model drew from...",
		**         "page_age": "2025-08-01"
		**       }
		**     ]
		**   }
		**
		** The snippet and page_age members are populated only when the provider supplies them, 
		** and may be absent otherwise. Each provider returns a different citation shape 
		** (for example, OpenAI returns url_citation annotations with character offsets, 
		** Anthropic returns web_search_tool_result content blocks, Google returns groundingMetadata, 
		** and Perplexity returns a search_results array). 
		** 
		** The full, unmodified provider response — including any character-offset annotations not represented 
		** in the normalized form — remains available via GetLastJsonData.
		**
		** Streaming: In streaming mode, a standardized web_search_call event is delivered through NextAiEvent 
		** when the provider begins a search, and the normalized results are available from this method 
		** after the null_terminator event completes the response.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJsonObject AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJson AS [Chilkat.JsonObject], liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJson
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 6, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatJson)
		
		      loChilkatJson = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetSearchResults(m.loChilkatJson) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterBinData.SetObject(m.oChilkatJson, m.loChilkatJson)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatJson
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJson = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE hasfunctioncalls_access		&& Access method used to retrieve the Chilkat AI HasFunctionCalls property.
		*==============================================================================
		* Method:            HasFunctionCalls_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat AI HasFunctionCalls property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HasFunctionCalls
		* Date Added:        04/01/2026
		*==============================================================================
		
		**  
		** Introduced in version 11.4.0
		**
		** 1 if the response output has function calls. Otherwise 0. 
		** This only applies to manual function tool calling, not automatic JS tool calls.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, ;
		m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 4
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE hasfunctioncalls_assign		&& Assign method used to hold a reference to the HasFunctionCalls property.
		*==============================================================================
		* Method:            HasFunctionCalls_Assign
		* Purpose:           Assign method used to hold a reference to the HasFunctionCalls property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the HasFunctionCalls property.
		* Returns:           
		* Date Added:        04/01/2026
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 4
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat AI HeartBeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat AI HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** The interval in milliseconds between each AbortCheck event callback, 
		** which enables an application to abort certain method calls before they complete. 
		** By default, HeartbeatMs is set to 0, meaning no AbortCheck event callbacks will trigger.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold a reference to the HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold a 
		*                    reference to the HeartbeatMs property.
		* Returns:           
		* Date Added:        11/03/2025
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [HeartbeatMs]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE hostedconvo_access		&& Access method used to retrieve the Chilkat AI HostedConvo property.
		*==============================================================================
		* Method:            HostedConvo_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat AI HostedConvo property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HostedConvo
		* Date Added:        11/03/2025
		*==============================================================================
		
		**  
		** Introduced in version 11.2.0
		**
		** This applies to providers like OpenAI that can maintain conversation state on the server. 
		** If set to 1, only the conversation ID is sent with each query. 
		** If set to 0, the entire conversation transcript is sent with each query, 
		** making each query stateless.
		** 
		** This only applies if a conversation is selected.
		** 
		** The default value of this property is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, ;
		m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE hostedconvo_assign		&& Assign method used to hold a reference to the HostedConvo property.
		*==============================================================================
		* Method:            HostedConvo_Assign
