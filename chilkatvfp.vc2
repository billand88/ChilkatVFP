	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat JSONObject UncommonOpotions property
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat JSONObject UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        06/03/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.90
		**
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 90
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat JSONObject UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        06/03/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 90
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE updatebd		&& Introduced in version 9.5.0.68. Updates or appends a new string member with the encoded contents of bd. If the full path specified by jsonPath does not exist, it is automatically created as needed.
		*==============================================================================
		* Method:            UpdateBd
		* Purpose:           Updates or appends a new string member with the encoded contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSONPath, the JSON path.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.68
		**
		** Updates or appends a new string member with the encoded contents of bd. 
		** If the full path specified by jsonPath does not exist, 
		** it is automatically created as needed. 
		** The bytes contained in bd are encoded according to encoding 
		** (such as "base64", "hex", etc.)
		**
		** Fixed for version 65: Fixed auto-create issue in this method 
		** for array paths that end in a primitive.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcJSONPath AS Character, ;
		tcEncoding AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		liIntroducedInBuild AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 68
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.UpdateBd(m.tcJSONPath, ;
		        m.tcEncoding, m.loChilkatBinData) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE updatebool		&& Introduced in version 9.5.0.63. Updates or appends a new boolean member. If the full path specified by jsonPath does not exist, it is automatically created as needed. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            UpdateBool
		* Purpose:           Updates or appends a new boolean member.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcJSONPath, the JSON path.
		*                    tuValue, the boolean value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.63
		**
		** Updates or appends a new boolean member. 
		** If the full path specified by jsonPath does not exist, 
		** it is automatically created as needed.
		**
		** Fixed for version 65: Fixed auto-create issue in this method 
		** for array paths that end in a primitive.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcJSONPath AS Character, tuValue AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, ;
		luReturn AS Unknown, liValue AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liValue, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 63
		
