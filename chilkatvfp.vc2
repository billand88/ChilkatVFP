	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat Compression UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the UncommonOptions property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UncommonOptions
		* Date Added:        05/09/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** This is a catch-all property to be used for uncommon needs. 
		** This property defaults to the empty string and should typically remain empty.
		**
		** Can be set to a list of the following comma separated keywords:
		**
		** Crypt2CompressHdr - Duplicates the compression and decompression as implemented 
		** in the decremented and removed Crypt2 compression functions.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the UncommonOptions property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        05/09/2025
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = [UncommonOptions_Compression]
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat Compression VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/24/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/24/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS createcs AS ibasechilkat OF "chilkatvfp.vcx" 		&& Factory class for creating certificate store objects. This class is specific to the Windows operating system, and therefore is only available on Windows systems. Decremented in version 10.0.0.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: createfilestore		&& Creates a file-based certificate store. If 'filename' already exists, the method will fail. Returns Nothing on failure.
		*m: creatememorystore		&& Creates a temporary certificate store in memory that is initially empty. Returns Nothing on failure.
		*m: createregistrystore		&& Creates a registry-based certificate store. The 'hiveName' can either be "CurrentUser" or "LocalMachine". The 'regPath' argument should be specified without a leading slash, such as "Software/Chilkat/MyCertStore". Returns Nothing on failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat CreateCS DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat CreateCS LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat CreateCS LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat CreateCS LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat CreateCS LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat CreateCS LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat CreateCS LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat CreateCS LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: openchilkatstore		&& Opens the certificate store used by Chilkat Mail and returns the object representing that store. Returns Nothing on failure.
		*m: opencurrentuserstore		&& Opens the local system's Current User Certificate Store and returns the object representing that store. Returns Nothing on failure.
		*m: openfilestore		&& Opens an existing file certificate store. To open it read-only, readOnly should be non-zero. Returns Nothing on failure.
		*m: openlocalsystemstore		&& Opens the local system's Local Machine Certificate Store and returns the object representing that store. Returns Nothing on failure.
		*m: openoutlookstore		&& Opens the certificate store used by Microsoft Outlook (and Office) and returns the object representing that store. Returns Nothing on failure.
		*m: openregistrystore		&& Opens an existing registry-based certificate store. 'hiveName' should be either "CurrentUser" or "LocalMachine". The 'regPath' argument should be specified without a leading slash, such as "Software/Chilkat/MyCertStore". Returns Nothing on failure.
		*m: readonly_access		&& Access method used to retrieve the Chilkat CreateCS ReadOnly property.
		*m: readonly_assign		&& Assign method used to hold a reference to the ReadOnly property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat CreateCS VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: readonly		&& Determines whether certificate stores are opened with read-only or read/write permissions. Only applies to methods such as OpenCurrentUserStore, where the a readOnly parameter is not present.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = CreateCS
		debuglogfilepath = 
		iretirementmajor = 11
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "createcs"
		readonly = 1
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Class removed.
		
		** Version 10.0.0
		
		  Now this class is marked as decremented.
		
		** Version 94
		
		  Fixed a problem with the CreateFileStore method, where an application
		  would create a file-based certificate store, add certificates, and then save,
		  but the resulting file would be 0 bytes in length.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE createfilestore		&& Creates a file-based certificate store. If 'filename' already exists, the method will fail. Returns Nothing on failure.
		*==============================================================================
		* Method:            CreateFileStore
		* Purpose:           Creates a file-based certificate store.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the file path to the certificate store.
		* Returns:           Chilkat Certificate Store Object, or NULL
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Creates a file-based certificate store. 
		** If 'filename' already exists, the method will fail.
		** 
		** Fixed in version 94: Fixed a problem where an application would create 
		** a file-based certificate store, add certificates, and then save, 
		** but the resulting file would be 0 bytes in length.
		** 
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tcFilePath AS Character
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.CreateCS], ;
		loException AS Exception, loChilkatCertStore AS [Chilkat_9_5_0.CertStore]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCertStore
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCertStore = m.loChilkatObject.CreateFileStore(m.tcFilePath)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCertStore
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.CreateCS])
		  loChilkatCertStore = NEWOBJECT([Chilkat_9_5_0.CertStore])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

