		RETURN
	ENDPROC

	PROCEDURE setallowedalgorithms		&& Introduced in version 9.5.0.99. Provides a way to specific the exact set of algorithms allowed for the connection. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetAllowedAlgorithms
		* Purpose:           Provides a way to specify the exact set 
		*                    of algorithms allowed for the connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/09/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.99
		**
		** Provides a way to specify the exact set of algorithms allowed for the connection.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		llImplemented = .F.
		liIntroducedInBuild = 99
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetAllowedAlgorithms(m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setcreatedt		&& Sets the create date/time for a file on the server. The pathOrHandle may be a filepath or the handle of a currently open file. isHandle should be set to 1 if the pathOrHandle is a handle, otherwise set isHandle to 0.
		*==============================================================================
		* Method:            SetCreateDt
		* Purpose:           Sets the create date/time for a file on the server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathOrHandle -- the file handle returned by OpenFile()
		*                    tuIsHandle -- determines whether or not the first 
		*                    parameter is a path or a handle to a file
		*                    toChilkatCkDateTime, a Chilkat Date/Time object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/23/2022
		*==============================================================================
		
		**
		** Sets the create date/time for a file on the server. 
		** The pathOrHandle may be a filepath or the handle of a currently open file. 
		** isHandle should be set to 1 if the pathOrHandle is a handle, 
		** otherwise set isHandle to 0.
		**
		** Note: Servers running version 3 or lower of the SFTP protocol 
		** do not support setting the create date/time.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPathOrHandle AS Character, tuIsHandle AS Unknown, ;
		toChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loParkParameterCkDateTime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown, liIsHandle AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIsHandle
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liIsHandle = .LogicalToBit(m.tuIsHandle)
		
		    loParkParameterCkDateTime = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTime)
		
		    loChilkatCkDateTime = m.loParkParameterCkDateTime.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetCreateDt(m.tcPathOrHandle, m.liIsHandle, ;
		      m.loChilkatCkDateTime) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCkDateTime = ;
		    m.loParkParameterCkDateTime.SetObject(m.toChilkatCkDateTime, m.loChilkatCkDateTime)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loParkParameterCkDateTime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

