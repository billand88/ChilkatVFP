	HIDDEN PROCEDURE sorcvbuf_access		&& Access method used to retrieve the Chilkat SoRcvBuf property.
		*==============================================================================
		* Method:            SoRcvBuf_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 SoRcvBuf property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SoRcvBuf
		* Date Added:        02/26/2022
		*==============================================================================
		
		**
		** Sets the receive buffer size socket option. 
		** Normally, this property should be left unchanged. The default value is 4194304.
		**
		** This property can be increased if download performance seems slow. 
		** It is recommended to be a multiple of 4096.
		**
		** Note: This property only applies to FTP data connections. 
		** The FTP control connection is not used for uploading or downloading files, 
		** and is therefore not performance sensitive.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sorcvbuf_assign		&& Assign method used to hold a reference to the SoRcvBuf property.
