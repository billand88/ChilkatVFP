		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStream = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStream)
		
		      loChilkatStream = m.loParkParameterStream.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SendReqStreamBody(m.tcHTTPVerb, ;
		        m.tcURLPath, m.loChilkatStream) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStream = ;
		      m.loParkParameterStream.SetObject(m.toChilkatStream, m.loChilkatStream)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStream, m.loChilkatStream
		
		RETURN m.luReturn
		
