		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readuntilmatch		&& Introduced in version 9.5.0.56. Reads the stream until the string indicated by matchStr is received. If no data is immediately available, it waits up to ReadTimeoutMs milliseconds for data to arrive. The data is returned as a string.
		*==============================================================================
		* Method:            ReadUntilMatch
		* Purpose:           Reads the stream until the string indicated by matchStr is received.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMatchString, the matching string.
		* Returns:           The stream
		* Date Added:        06/14/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.56
		**
		** Reads the stream until the string indicated by matchStr is received. 
		** If no data is immediately available, it waits up to ReadTimeoutMs milliseconds 
		** for data to arrive. The data is returned as a string. 
		** The incoming bytes are interpreted according to the StringCharset property. 
		** For example, if utf-8 bytes are expected, then StringCharset should be set 
		** to "utf-8" prior to calling ReadString.
		** 
		** Note: If the end-of-stream is reached prior to receiving the match string, 
		** then the remaining data is returned, and the ReadFailReason property will be set to 3 
		** (to indicate end-of-file). This is the only case where as string would be returned 
		** that does not end with the desired match string.
		**
		** Fixed in Version 10.1.2: Fixed a problem in this method having to do 
		** with the very last read which should return the remaining data 
		** if the match string is not found before the EOF.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcMatchString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_STREAM_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcStream AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcStream = []
		llImplemented = .F.
		liIntroducedInBuild = 56
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcStream = m.loChilkatObject.ReadUntilMatch(m.tcMatchString)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcStream
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readuntilmatchasync		&& Introduced in version 9.5.0.56. Creates an asynchronous task to call the ReadUntilMatch method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
