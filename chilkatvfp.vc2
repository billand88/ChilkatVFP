		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the RequiredContentType property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE requirehostnamematch_access		&& Access method used to retrieve the Chilkat HTTP RequiredHostNameMatch property.
		*==============================================================================
		* Method:            RequireHostnameMatch_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP RequireHostnameMatch property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.RequireHostnameMatch
		* Date Added:        05/01/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** If 1, then the hostname/domain in the URL must match at least one 
		** of the entries in the server certificate's SAN. 
		** A SAN (Subject Alternative Name) field in an SSL/TLS certificate contains 
		** a list of additional domain names, subdomains, IP addresses, 
		** or other identifiers that the certificate is valid for.
		**
		** In actuality, it is the SNI hostname in the TLS handshake that must match a SAN entry. 
		** By default, Chilkat uses the hostname from the URL as the SNI hostname. 
		** An application can explicitly set the SNI hostname via the SniHostname property, 
		** which would be typical if connecting via an IP address. See the example below.
		** 
		** The default value is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE requirehostnamematch_assign		&& Assign method used to hold a reference to the RequiredHostNameMatch property.
		*==============================================================================
		* Method:            RequireHostnameMatch_Assign
		* Purpose:           Assign method used to hold a reference to the RequireHostnameMatch property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the RequireHostnameMatch property.
		* Returns:           
		* Date Added:        05/01/2025
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 0
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE requiresslcertverify_access		&& Access method used to retrieve the Chilkat HTTP RequireSSLCertVerify property.
		*==============================================================================
		* Method:            RequireSSLCertVerify_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP RequireSSLCertVerify property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.RequireSSLCertVerify
		* Date Added:        01/28/2022
		*==============================================================================
		
		**
		** If 1, then the HTTP client will verify the server's SSL certificate. 
		** The certificate is expired, or if the cert's signature is invalid, 
		** the connection is not allowed. The default value of this property is 0.
		**
		** Enhancement in version 63: Made the method more flexible 
		** in handling out-of-order certs from a web server.
		**
		** Fixed in Version 11.1.0: If RequireSslCertVerify is True and the server 
		** did not provide all intermediate certificates in the chain of authentication 
		** in the TLS handshake, then Chilkat would be unable to validate 
		** the server certificate. This was rare.  Chilkat will now try to get 
		** the missing intermediate certs from trusted certs already installed 
		** on the local system (such as in the Windows certificate store).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE requiresslcertverify_assign		&& Assign method used to hold a reference to the RequireSSLCertVerify property.
		*==============================================================================
		* Method:            RequireSSLCertVerify_Assign
		* Purpose:           Assign method used to hold a reference to the RequireSSLCertVerify property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the RequireSSLCertVerify property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE resumedownload		&& Same as the Download method, except a failed download may be resumed. The targetFilename is automatically checked and if it exists, the download will resume at the point where it previously failed.
		*==============================================================================
		* Method:            ResumeDownload
		* Purpose:           Same as the Download method, except a failed download may be resumed.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to retrieve the content.
		*                    tcTargetFileName -- the file name to resume.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Same as the Download method, except a failed download may be resumed. 
		** The targetFilename is automatically checked and if it exists, 
		** the download will resume at the point where it previously failed. 
		** ResumeDownload may be called any number of times until the full download is complete.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURL AS Character, tcTargetFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ResumeDownload(m.tcURL, m.tcTargetFileName) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE resumedownloadasync		&& Creates an asynchronous task to call the ResumeDownload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            ResumeDownloadAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the ResumeDownload method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to retrieve the content.
		*                    tcTargetFileName -- the file name to resume.
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the ResumeDownload method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcURL AS Character, tcTargetFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, llImplemented AS Logical, ;
		loException AS Exception, loChilkatTask AS CHILKAT_TASK_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.ResumeDownloadAsync(m.tcURL, m.tcTargetFileName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE resumedownloadbd		&& Same as the DownloadBd method, except a failed download may be resumed. The download will resume at a point based on the number of bytes already contained in binData
		*==============================================================================
		* Method:            ResumeDownloadBd
		* Purpose:           Same as the DownloadBd method, except a failed download may be resumed. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURL -- the URL to retrieve the content.
		*                    toChilkatBinData, a Chilkat binary data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.75
		**
		** Same as the DownloadBd method, except a failed download may be resumed. 
		** The download will resume at a point based 
		** on the number of bytes already contained in binData. 
		** ResumeDownloadBd may be called any number of times until the full download is complete.
		**
		** The incoming data is appended to binData.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURL AS Character, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 75
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ResumeDownloadBd(m.tcURL, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

