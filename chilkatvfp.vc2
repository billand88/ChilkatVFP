	PROCEDURE setsigningcert		&& Introduced in version 11.5.0. Use the certificate's private key (ECC or RSA) when signing for the following algorithms: RS256, RS384, RS512, ES256, ES384, ES512, PS256, PS384, PS512
		*==============================================================================
		* Method:            SetSigningCert
		* Purpose:           Use the certificate's private key (ECC or RSA) when signing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the index value.
		*                    toCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Use the certificate's private key (ECC or RSA) when signing for the following algorithms:
		** 
		** RS256
		** RS384
		** RS512
		** ES256
		** ES384
		** ES512
		** PS256
		** PS384
		** PS512
		** 
		** The JWS algorithms are described in RFC 7518, section 3.1. Here is a summary:
		**    +--------------+-------------------------------+--------------------+
		**    | "alg" Param  | Digital Signature or MAC      | Implementation     |
		**    | Value        | Algorithm                     | Requirements       |
		**    +--------------+-------------------------------+--------------------+
		**    | HS256        | HMAC using SHA-256            | Required           |
		**    | HS384        | HMAC using SHA-384            | Optional           |
		**    | HS512        | HMAC using SHA-512            | Optional           |
		**    | RS256        | RSASSA-PKCS1-v1_5 using       | Recommended        |
		**    |              | SHA-256                       |                    |
		**    | RS384        | RSASSA-PKCS1-v1_5 using       | Optional           |
		**    |              | SHA-384                       |                    |
		**    | RS512        | RSASSA-PKCS1-v1_5 using       | Optional           |
		**    |              | SHA-512                       |                    |
		**    | ES256        | ECDSA using P-256 and SHA-256 | Recommended+       |
		**    | ES384        | ECDSA using P-384 and SHA-384 | Optional           |
		**    | ES512        | ECDSA using P-521 and SHA-512 | Optional           |
		**    | PS256        | RSASSA-PSS using SHA-256 and  | Optional           |
		**    |              | MGF1 with SHA-256             |                    |
		**    | PS384        | RSASSA-PSS using SHA-384 and  | Optional           |
		**    |              | MGF1 with SHA-384             |                    |
		**    | PS512        | RSASSA-PSS using SHA-512 and  | Optional           |
		**    |              | MGF1 with SHA-512             |                    |
		**    | none         | No digital signature or MAC   | Optional           |
		**    |              | performed                     |                    |
		**    +--------------+-------------------------------+--------------------+
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, toCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loCert
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toCert)
		
		      loCert = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetSigningCert(m.tiIndex, m.loCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toCert = ;
		      m.loParkParameterJsonObject.SetObject(m.toCert, m.loCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  toCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setunprotectedheader		&& Introduced in version 9.5.0.66. Sets a signature's optional unprotected header. The index is the index of the signature. The 1st signature is at index 0. In most cases, a JWS contains a single signature at index 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetUnprotectedHeader
		* Purpose:           Sets a signature's optional unprotected header.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the signature array value.
		*                    toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Sets a signature's optional unprotected header. The index is the index of the signature. 
		** The 1st signature is at index 0. In most cases, a JWS contains a single signature at index 0.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetUnprotectedHeader(m.tiIndex, m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE validate		&& Introduced in version 9.5.0.66. Validates the Nth signature or MAC using the Nth public key or MAC key. Returns 1 if the signature was validated, thus verifying that the signer used the same MAC key or the matching private key.
		*==============================================================================
		* Method:            Validate
		* Purpose:           Validates the Nth signature or MAC using the Nth public key or MAC key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the signature array value.
		* Returns:           Validation status
		* Date Added:        07/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Validates the Nth signature or MAC using the Nth public key or MAC key.
		** 
		** Returns 1 if the signature was validated, thus verifying that the signer 
		** used the same MAC key or the matching private key.
		** 
		** Returns 0 if the incorrect public key or MAC key was provided.
		** 
		** Returns -1 for any other error, such as if no public key or MAC key 
		** was previously set for the given index.
		** 
		** Prior to calling this method, a program should provide the public key 
		** or MAC key via the SetPublicKey, SetMacKey, or SetMacKeyBd methods.
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_JWS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liValidationStatus AS Integer
		
		STORE 0 TO m.liValidationStatus, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liValidationStatus = m.loChilkatObject.Validate(m.tiIndex)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liValidationStatus
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWS_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat JWS VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/20/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/20/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 66
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS jwt AS ibasechilkat OF "chilkatvfp.vcx" 		&& A class for signing and verifying JWT's (JSON Web Tokens).
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: autocompact_access		&& Access method used to retrieve the Chilkat JWT AutoCompact property.
		*m: autocompact_assign		&& Assign method used to hold a reference to the AutoCompact property.
		*m: createjwt		&& Introduced in version 9.5.0.58. Creates a JWT. The header is the JOSE JSON header.
		*m: createjwtcert		&& Introduced in version 9.5.0.99. Creates a JWT using a certificate's private key. The header is the JOSE JSON header. It can be the full JOSE JSON, or it can be a shorthand string such as "RS256", "RS384", "RS512", "ES256", "ES384", or "ES512".
		*m: createjwtpk		&& troduced in version 9.5.0.58. Creates a JWT using an RSA or ECC private key. The header is the JOSE JSON header.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat JWT DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: gennumericdate		&& Introduced in version 9.5.0.58. Generates a JSON numeric value representing the number of seconds from 1970-01-01T00:00:00Z UTC until the specified UTC date/time, ignoring leap seconds.
		*m: getheader		&& Introduced in version 9.5.0.58. Decodes the first part of a JWT (the "xxxxx" part of the "xxxxx.yyyyy.zzzzz" JWT) and returns the JSON string. This is the JOSE header of the JWT. Returns Nothing on failure
		*m: getpayload		&& Introduced in version 9.5.0.58. Decodes the second part of a JWT (the "yyyyy" part of the "xxxxx.yyyyy.zzzzz" JWT) and returns the JSON string. This is the claims payload of the JWT. Returns Nothing on failure
		*m: istimevalid		&& Introduced in version 9.5.0.58. Verifies the "exp" and/or "nbf" claims and returns 1 if the current system date/time is within range. Returns 0 if the current system date/time is outside the allowed range of time.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat JWT LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat JWT LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat JWT LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat JWT LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat JWT LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat JWT LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat JWT LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat JWT VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifyjwt		&& Introduced in version 9.5.0.58. Verifies a JWT that requires a shared password string for verification. The token should be a JWT with the format xxxxx.yyyyy.zzzzz. This method should only be called for JWT's using the HS256, HS384, or HS512 algorithms.
		*m: verifyjwtpk		&& Introduced in version 9.5.0.58. Verifies a JWT that requires an RSA or ECC public key for verification. The token should be a JWT with the format xxxxx.yyyyy.zzzzz.
		*p: autocompact		&& Introduced in version 9.5.0.58. If 1, the JSON passed to CreateJwt and CreateJwtPk will be compacted to remove unnecessary whitespace. This will result in the smallest possible JWT. The default value is 1.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		autocompact = 1
		cchilkatclass = Jwt
		debuglogfilepath = 
		iinstancepatch = 58
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "jwt"
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE autocompact_access		&& Access method used to retrieve the Chilkat JWT AutoCompact property.
		*==============================================================================
		* Method:            AutoCompact_Access
		* Purpose:           Assign method used to retrieve 
		*                    the AutoCompact property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoCompact
		* Date Added:        07/19/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.58
		**
		** If 1, the JSON passed to CreateJwt and CreateJwtPk will be compacted 
		** to remove unnecessary whitespace. This will result in the smallest possible JWT. 
		** The default value is 1.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE autocompact_assign		&& Assign method used to hold a reference to the AutoCompact property.
		*==============================================================================
		* Method:            AutoCompact_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the AutoCompact property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the AutoCompact property.
		* Returns:           
		* Date Added:        07/19/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 99
		
		  Added the CreateJwtCert method to allow for a JWT to be created using a certificate’s private key. 
		  This is especially needed if the certificate and private key reside on a smartcard or USB token, 
		  because it’s not possible to directly access the private key material, 
		  and thus the private key is indirectly accessed via the certificate 
		  (assuming the Chilkat Cert object was loaded by calling Cert.LoadFromSmartcard).
		
		** Version 95
		
		  Added support for JWT’s using Ed25519.
		
		** Version 83
		
		  Improved support for Ed25519 private keys.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  Added the Jwt class.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE createjwt		&& Introduced in version 9.5.0.58. Creates a JWT. The header is the JOSE JSON header.
		*==============================================================================
		* Method:            CreateJWT
		* Purpose:           Creates a JWT.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeader -- the JOSE JSON header.
		*                    tcPayload -- the JSON payload that contains the claims.
		*                    tcPassword -- the secret.
		* Returns:           The Java Web Token, or nothing.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Creates a JWT. The header is the JOSE JSON header. It can be the full JOSE JSON, 
		** or it can be a shorthand string such as "HS256", "HS384", or "HS512", 
		** in which case the standard JOSE header for the given algorithm will be used.
		** 
		** The payload is the JSON payload that contains the claims. 
		** The password is the secret. Given that the secret is a shared passwod string, 
		** this method should only be called for creating JWT's where the JOSE header's 
		** "alg" is HS256, HS384, or HS512. For RS256, RS384, RS512, ES256, ES384, and ES512, 
		** call CreateJwtPk instead.
		** 
		** When successful, this method returns a JWT with the format xxxxx.yyyyy.zzzzz, 
		** where xxxxx is the base64url encoded JOSE header, yyyyy is the base64url encoded payload, 
		** and zzzzz is the base64url signature.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHeader AS Character, ;
		tcPayload AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_JWT_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, lcJavaWebToken AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcJavaWebToken = []
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcJavaWebToken = ;
		        m.loChilkatObject.CreateJWT(m.tcHeader, m.tcPayload, m.tcPassword)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcJavaWebToken
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE createjwtcert		&& Introduced in version 9.5.0.99. Creates a JWT using a certificate's private key. The header is the JOSE JSON header. It can be the full JOSE JSON, or it can be a shorthand string such as "RS256", "RS384", "RS512", "ES256", "ES384", or "ES512".
		*==============================================================================
		* Method:            CreateJwtCert
		* Purpose:           Creates a JWT using a certificate's private key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeader -- the JOSE JSON header.
		*                    tcPayload -- the JSON payload that contains the claims.
		*                    toChilkatCert -- the Chilkat Cert object.
		* Returns:           The Java Web Token, or nothing.
		* Date Added:        07/08/2024
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.99
		**
		** Creates a JWT using a certificate's private key. The header is the JOSE JSON header. 
		** It can be the full JOSE JSON, or it can be a shorthand string such as "RS256", "RS384", 
		** "RS512", "ES256", "ES384", or "ES512", in which case the standard JOSE header 
		** for the given algorithm will be used.
		**
		** The payload is the JSON payload that contains the claims. The cert is the certificate with private key. 
		** This method should only be called for creating JWT's where the JOSE header's 
		** "alg" is RS256, RS384, RS512, ES256, ES384, and ES512. 
		** If the secret is a shared password string, then call CreateJwt instead.
		**
		** When successful, this method returns a JWT with the format xxxxx.yyyyy.zzzzz, 
		** where xxxxx is the base64url encoded JOSE header, yyyyy is the base64url encoded payload, 
		** and zzzzz is the base64url signature.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHeader AS Character, tcPayload AS Character, ;
		toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWT_COM_CALL, loException AS Exception, ;
		lcJavaWebToken AS Character, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatCert
		
		lcJavaWebToken = []
		llImplemented = .F.
		liIntroducedInBuild = 99
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		       loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.CreateJwtCert(m.tcHeader, ;
		        m.tcPayload, m.loChilkatCert) TO m.lcJavaWebToken
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatCert
		
		RETURN m.lcJavaWebToken
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWT_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE createjwtpk		&& troduced in version 9.5.0.58. Creates a JWT using an RSA or ECC private key. The header is the JOSE JSON header.
		*==============================================================================
		* Method:            CreateJWTPK
		* Purpose:           Creates a JWT using an RSA or ECC private key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeader -- the JOSE JSON header.
		*                    tcPayload -- the JSON payload that contains the claims.
		*                    toChilkatPrivateKey -- a Chilkat Private Key object.
		* Returns:           The Java Web Token, or nothing.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Creates a JWT using an RSA or ECC private key. The header is the JOSE JSON header. 
		** It can be the full JOSE JSON, or it can be a shorthand string such as "RS256", 
		** "RS384", "RS512", "ES256", "ES384", or "ES512", in which case the standard 
		** JOSE header for the given algorithm will be used.
		** 
		** The payload is the JSON payload that contains the claims. The key is the private key. 
		** This method should only be called for creating JWT's where the JOSE header's "alg" is RS256, 
		** RS384, RS512, ES256, ES384, and ES512. If the secret is a shared password string, 
		** then call CreateJwt instead.
		** 
		** When successful, this method returns a JWT with the format xxxxx.yyyyy.zzzzz, 
		** where xxxxx is the base64url encoded JOSE header, yyyyy is the base64url encoded payload, 
		** and zzzzz is the base64url signature.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHeader AS Character, tcPayload AS Character, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_JWT_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		loException AS Exception, lcJavaWebToken AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		lcJavaWebToken = []
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterPrivateKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		      loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		      TRY
		
		        lcJavaWebToken = ;
		        m.loChilkatObject.CreateJWTPK(m.tcHeader, m.tcPayload, m.loChilkatPrivateKey)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatPrivateKey = ;
		      m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.lcJavaWebToken
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat JWT DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat JWT DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/19/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat JWT DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/19/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE gennumericdate		&& Introduced in version 9.5.0.58. Generates a JSON numeric value representing the number of seconds from 1970-01-01T00:00:00Z UTC until the specified UTC date/time, ignoring leap seconds.
		*==============================================================================
		* Method:            GetNumericDate
		* Purpose:           Generates a JSON numeric value representing the number of seconds 
		*                    from 1970-01-01T00:00:00Z UTC until the specified UTC date/time.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiOffsetSeconds, the seconds to offset value.
		* Returns:           The calculated number of seconds since 1/1/1970 UTC.
		* Date Added:        07/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Generates a JSON numeric value representing the number of seconds 
		** from 1970-01-01T00:00:00Z UTC until the specified UTC date/time, ignoring leap seconds. 
		** The date/time generated is equal to the current system time plus the number of seconds 
		** specified by numSecOffset. The numSecOffset can be negative.
		**
		
		LPARAMETERS tiOffsetSeconds AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_JWT_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, liSeconds AS Integer
		
		STORE 0 TO m.liSeconds, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liSeconds = m.loChilkatObject.GetNumericDate(m.tiOffsetSeconds)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liSeconds
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_JWT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getheader		&& Introduced in version 9.5.0.58. Decodes the first part of a JWT (the "xxxxx" part of the "xxxxx.yyyyy.zzzzz" JWT) and returns the JSON string. This is the JOSE header of the JWT. Returns Nothing on failure
		*==============================================================================
