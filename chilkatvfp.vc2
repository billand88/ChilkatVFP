	PROCEDURE receiveuntilmatch		&& Reads text from the connected TCP/IP or SSL socket until a matching string (matchStr) is received. Returns the text up to and including the matching string.
		*==============================================================================
		* Method:            ReceiveUntilMatch
		* Purpose:           Reads text from the connected TCP/IP or SSL socket 
		*                    until a matching string (matchStr) is received.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMatching -- the matching string.
		* Returns:           The received string.
		* Date Added:        05/29/2022
		*==============================================================================
		
		**
		** Reads text from the connected TCP/IP or SSL socket 
		** until a matching string (matchStr) is received. 
		** Returns the text up to and including the matching string. 
		** As an example, to one might read the header of an HTTP request 
		** or a MIME message by reading up to the first double CRLF ("\r\n\r\n"). 
		** The incoming bytes are interpreted according to the charset specified 
		** by the StringCharset property.
		**
		** Fixed for Version 52: The session log did not include data received from this method.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcMatching AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, lcReturn AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcReturn = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcReturn = m.loChilkatObject.ReceiveUntilMatch(m.tcMatching)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

