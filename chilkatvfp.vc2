		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE getfunctioncalls		&& Introduced in version 11.4.0. This method returns the function calls in json if the output contains any. Returns 1 if one or more function calls were returned, otherwise returns 0.
		*==============================================================================
		* Method:            GetFunctionCalls
		* Purpose:           Returns the function calls in json if the output contains any. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSON, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/01/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0.
		**
		** Returns a list of models available to your account, such as GPT-4o and GPT-5. 
		** The models are listed in st, sorted in ascending, case-insensitive order. 
		** To access the raw JSON response after calling this method, use GetLastJsonData.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSON AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJson AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS [Chilkat.JsonObject], liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJson = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJson.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetFunctionCalls(m.loChilkatJSON) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJson.SetObject(m.toChilkatJSON, m.loChilkatJSON)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJson, m.loChilkatJSON
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJson = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getlastjsondata		&& Introduced in version 11.2.0. Provides details about the last method called on this object instance.
		*==============================================================================
		* Method:            GetLastJsonData
		* Purpose:           Provides information about what transpired 
		*                    in the last method called on this object instance. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** Introduced in version 11.2.0.
		**
		** Provides information about what transpired 
		** in the last method called on this object instance. 
		** For many methods, there is no information. However, for some methods, 
		** details about what occurred can be obtained by getting 
		** the LastJsonData right after the method call returns.
		**
		** Methods that produce last JSON information include: GetModels.
		** 
		
		LPARAMETERS toChilkatJSONObject AS [Chilkat.JsonObject]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], llImplemented AS Logical, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS [Chilkat.JsonObject], loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 2, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        m.loChilkatObject.GetLastJsonData(m.loChilkatJSONObject)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJSONObject, m.loChilkatJSONObject)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJSONObject
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJSONObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

