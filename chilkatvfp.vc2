	PROCEDURE getcreatedtbyname		&& Returns the file-creation date/time for a remote file by filename. Note: The filename passed to this method must NOT include a path.
		*==============================================================================
		* Method:            GetCreateDtByName
		* Purpose:           Returns the file-creation date/time for a remote file by filename.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name.
		* Returns:           Chilkat Date/Time Object, or NULL
		* Date Added:        03/02/2022
		*==============================================================================
		
		**
		** Returns the file-creation date/time for a remote file by filename.
		**
		** Note: The filename passed to this method must NOT include a path. 
		** Prior to calling this method, make sure to set the current remote directory 
		** (via the ChangeRemoteDir method) to the remote directory where this file exists.
		**
		** Note: Prior to calling this method, it should be ensured that 
		** the ListPattern property is set to a pattern that would match the requested filename. 
		** (The default value of ListPattern is "*", which will match all filenames.)
		**
		** Note: Linux/Unix type filesystems do not store "create" date/times. 
		** Therefore, if the FTP server is on such as system, 
		** this method will return a date/time equal to the last-modified date/time.
		**
		** Fixed in version 65: This method will return the current date/time instead of NULL for failure.
		** The method now correctly will return NULL (i.e. 0, null, Nothing, etc.)
		**
		** Fixed for version 69: Fixed this method for the following situation. 
		** If the value of the ListPattern property changes, 
		** then the internal cache of remote file information needed 
		** to be automatically cleared so that this method would not return 
		** null and would instead fetch the information from the server.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcFileName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCkDateTime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      loChilkatCkDateTime = m.loChilkatObject.GetCreateDtByName(m.tcFileName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCkDateTime
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

