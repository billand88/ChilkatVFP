	PROCEDURE synclocaltree		&& Downloads files from the FTP server to a local directory tree.
		*==============================================================================
		* Method:            SyncLocalTree
		* Purpose:           Downloads files from the FTP server to a local directory tree.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalRootDirectory -- the local root directory to sync.
		*                    tiSyncMode -- the synchronization mode.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** Downloads files from the FTP server to a local directory tree. 
		** Synchronization modes include:
		**
		** mode=0: Download all files
		** mode=1: Download all files that do not exist on the local filesystem.
		** mode=2: Download newer or non-existant files.
		** mode=3: Download only newer files. 
		** If a file does not already exist on the local filesystem, 
		** it is not downloaded from the server.
		** mode=5: Download only missing files or files with size differences.
		** mode=6: Same as mode 5, but also download newer files.
		** mode=99: Do not download files, 
		** but instead delete remote files that do not exist locally.
		** There is no mode #4. It is a mode used internally by the DirTreeXml method.
		**
		** Note: In v9.5.0.51 and higher, the list of downloaded (or deleted) files is available 
		** in the SyncedFiles property.
		**
		** Fixed for Version 47: The SyncMustMatch and SyncMustNotMatch 
		** properties were not obeyed in this method.
		**
		** Fixed for Version 47: This method will now continue past any access-denied errors.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcLocalRootDirectory AS Character, tiSyncMode AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFiles = m.loChilkatObject.SyncLocalTree(m.tcLocalRootDirectory, m.tiSyncMode)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

