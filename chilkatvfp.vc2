	PROCEDURE verifydata		&& Returns true if the byte data conforms to the charset passed in the first argument.
		*==============================================================================
		* Method:            VerifyData
		* Purpose:           Returns true if the byte data conforms 
		*                    to the charset passed in the first argument.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset, the charset name to test.
		*                    tqByteDataIn, the byte data to verify.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Returns true if the byte data conforms to the charset passed in the first argument.
		**
		** Fixed for Version 58: Fixed problems in this method having to do with us-ascii and utf-8.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCharset AS Character, tqByteDataIn AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.VerifyData(m.tcCharset, m.tqByteDataIn) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE verifyfile		&& Returns true if the file contains character data that conforms to the charset passed in the 1st argument.
		*==============================================================================
		* Method:            VerifyFile
		* Purpose:           Returns true if the file contains character data 
		*                    that conforms to the charset passed in the 1st argument.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCharset, the charset name to verify.
		*                    tcFilePath, the path to the file to verify.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Returns true if the file contains character data that conforms 
		** to the charset passed in the 1st argument.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCharset AS Character, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.VerifyFile(m.tcCharset, m.tcFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE writefile		&& Convenience method for saving an entire byte array to a file.
		*==============================================================================
