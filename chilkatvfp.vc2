	PROCEDURE getsigningcert		&& Return the certificate that will be used to digitally sign this email. This is the cerficate that was previously set by calling the SetSigningCert method. Returns Nothing on failure
		*==============================================================================
		* Method:            GetSigningCert
		* Purpose:           Return the certificate that will be used to digitally sign this email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Certificate object or NULL
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Return the certificate that will be used to digitally sign this email. 
		** This is the cerficate that was previously set by calling the SetSigningCert method.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.GetSigningCert()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getto		&& Returns a "to" recipient's full email address. Returns Nothing on failure
		*==============================================================================
		* Method:            GetTo
		* Purpose:           Returns a "to" recipient's full email address.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the To array. 
		* Returns:           lcEmailAddress, the full email address.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Returns a "to" recipient's full email address.
		**
		** Fixed for Version 52: This method returned Q/B encoded (if 8 bit) 
		** instead of automatically decoding (as was the behavior in prior versions).
		**
		** Fixed for Verison 80: Fixed automatic Q/B decoding for email address header fields. 
		** Normally, a TO or CC email header may be Q/B encoded such that the friendly-name part 
		** is encoded but not the address part.  
		** For example:  “=?utf-8?B?TWF0dA==?= <support@chilkatsoft.com>”. This was already handled correctly.
		** However, if the entire name+address string, including the quotes around the name part are Q/B encoded, 
		** such as like this  “=?utf-8?B?Ik1hdHQiIDxzdXBwb3J0QGNoaWxrYXRzb2Z0LmNvbT4=?=”, 
		** then Chilkat returned the entire string as the email address, without decoding. 
		** This method will now return automatically decoded strings for this case.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcEmailAddress AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEmailAddress = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEmailAddress = m.loChilkatObject.GetTo(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEmailAddress
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE gettoaddr		&& Returns the Nth To address (only the address part, not the friendly-name part). Returns Nothing on failure
		*==============================================================================
		* Method:            GetToAddr
		* Purpose:           Returns the Nth To address.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the To array. 
		* Returns:           lcAddress, the To address
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Returns the Nth To address (only the address part, not the friendly-name part).
		**
		** Fix for verison 80: Fixed automatic Q/B decoding for email address header fields. 
		** Normally, a TO or CC email header may be Q/B encoded such that the friendly-name part 
		** is encoded but not the address part.  
		** For example:  “=?utf-8?B?TWF0dA==?= <support@chilkatsoft.com>”. This was already handled correctly.
		** However, if the entire name+address string, including the quotes around the name part are Q/B encoded, 
		** such as like this  “=?utf-8?B?Ik1hdHQiIDxzdXBwb3J0QGNoaWxrYXRzb2Z0LmNvbT4=?=”, 
		** then Chilkat returned the entire string as the email address, without decoding. 
		** This method will now return automatically decoded strings for this case.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcAddress AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcAddress = []
		
		WITH THIS
		
		  loChilkatObject = EVALUATE([.] + .TohilkatObjectName)
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcAddress = m.loChilkatObject.GetToAddr(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcAddress
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

