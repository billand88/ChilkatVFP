	PROCEDURE appendmimewithflagssb		&& Introduced in version 9.5.0.62. Same as AppendMimeWithFlags, but the MIME to be uploaded to the IMAP server is passed in a StringBuilder object. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            AppendMIMEWithFlagsSb
		* Purpose:           Same as AppendMimeWithFlags, but the MIME to be uploaded 
		*                    to the IMAP server is passed in a StringBuilder object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMailBox -- the mailbox to append the MIME
		*                    toChilkatStringBuilder -- a Chilkat String Builder object.
		*                    tuSeen -- whether or not the email is set to Seen.
		*                    tuFlagged -- whether or not the email is set to Flagged.
		*                    tuAnswered -- whether or not the email is set to Answered.
		*                    tuDraft -- whether or not the email is set to Draft.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62
		**
		** Same as AppendMimeWithFlags, but the MIME to be uploaded 
		** to the IMAP server is passed in a StringBuilder object.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcMailBox AS Character, toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tuSeen AS Unknown, tuFlagged AS Unknown, tuAnswered AS Unknown, tuDraft AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liDraft AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		liSeen AS Integer, liFlagged AS Integer, liAnswered AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liSeen, m.liFlagged, ;
		m.liAnswered, m.liDraft, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 62
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liSeen = .LogicalToBit(m.tuSeen)
		      liFlagged = .LogicalToBit(m.tuFlagged)
		      liAnswered = .LogicalToBit(m.tuAnswered)
		      liDraft = .LogicalToBit(m.tuDraft)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AppendMIMEWithFlagsSb(m.tcMailBox, ;
		        m.loChilkatStringBuilder, m.liSeen, m.liFlagged, m.liAnswered, m.liDraft) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

