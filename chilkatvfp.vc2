	PROCEDURE converttosigned		&& Digitally signs a MIME message. The MIME is converted to an application/x-pkcs7-mime which is a PKCS7 signature that includes both the original MIME message and the signature.
		*==============================================================================
		* Method:            ConvertToSigned
		* Purpose:           Digitally signs a MIME message.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Digitally signs a MIME message. The MIME is converted to 
		** an application/x-pkcs7-mime which is a PKCS7 signature 
		** that includes both the original MIME message and the signature. 
		** This is different than AddDetachedSignature, where the signature is appended to the MIME.
		** 
		** Note: This is commonly referred to as an "opaque" signature.
		**
		** Fixed in Version 72: 
		** Fixed certain cases where creating PKCS7 signatures embedded the same certificate twice.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.ConvertToSigned(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE converttosignedpk		&& Digitally signs the MIME to convert it to an "opaque" signed message using a certificate and it's associated private key.
		*==============================================================================
		* Method:            ConvertToSignedPK
		* Purpose:           Digitally signs the MIME to convert it to an "opaque" signed message.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Digitally signs the MIME to convert it to an "opaque" signed message 
		** using a certificate and it's associated private key. 
		** This method would be used when the private key 
		** is external to the certificate -- for example, if a PFX/P12 file is not used, 
		** but instead a pair of .cer and .pem files are used 
		** (one for the certificate and one for the associated private key).
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.ConvertToSignedPK(;
		      m.loChilkatCert, m.loChilkatPrivateKey) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		 
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE currentdatetime_access		&& Access method used to retrieve the Chilkat MIME CurrentDateTime property.
		*==============================================================================
		* Method:            CurrentDateTime_Access
		* Purpose:           Access method used to retrieve 
		*                    the CurrentDateTime property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CurrentDateTime
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** Returns the current date/time in RFC 822 format.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE currentdatetime_assign		&& Assign method used to hold a reference to the CurrentDateTime property.
		*==============================================================================
		* Method:            CurrentDateTime_Assign
		* Purpose:           Assign method used to hold
		*                    the CurrentDateTime of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CurrentDateTime property.
		* Returns:           
		* Date Added:        06/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat MIME DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MIME DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat MIME DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE decrypt		&& Decrypts PKCS7 encrypted MIME (also known as S/MIME). Information about the certificates required for decryption is always embedded within PKCS7 encrypted MIME.
		*==============================================================================
		* Method:            Decrypt
		* Purpose:           Decrypts PKCS7 encrypted MIME (also known as S/MIME).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Decrypts PKCS7 encrypted MIME (also known as S/MIME). 
		** Information about the certificates required for decryption 
		** is always embedded within PKCS7 encrypted MIME. 
		** This method will automatically find and use the certificate + private key required 
		** from three possible sources:
		**
		**   1) PFX files that were provided in one or more calls to AddPfxSourceData or AddPfxSourceFile.
		**   2) Certificates found in an XML certificate vault provided by calling the UseCertVault method.
		**   3) (On Windows systems) Certificates found in the system's registry-based certificate stores.
		** 
		** Fixed for Version 59: When a cert doesn’t have the Issuer CN, 
		** the encrypted message could not be decrypted using Chilkat library, 
		** even though the cert does have subject key id.
		**
		** Fixed for Version 89: Fixed a problem with decrypting messages 
		** that used AES-GCM with a certificate having a non-exportable private key
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.Decrypt() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decrypt2		&& The same as Decrypt, but useful when the certificate and private key are available in separate files (as opposed to a single file such as a .pfx/.p12). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            Decrypt2
		* Purpose:           The same as Decrypt, but useful when the certificate 
		*                    and private key are available in separate files.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** The same as Decrypt, but useful when the certificate 
		** and private key are available in separate files 
		** (as opposed to a single file such as a .pfx/.p12).
		** 
		** Fixed for Version 59: When a cert doesn’t have the Issuer CN, 
		** the encrypted message could not be decrypted using Chilkat library, 
		** even though the cert does have subject key id.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.Decrypt2(;
		      m.loChilkatCert, m.loChilkatPrivateKey) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptusingcert		&& Introduced in version 9.5.0.40. Decrypts PKCS7 encrypted MIME (also known as S/MIME) using a specific certificate. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DecryptUsingCert
		* Purpose:           Decrypts PKCS7 encrypted MIME using a specific certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Decrypts PKCS7 encrypted MIME (also known as S/MIME) using a specific certificate.
		** 
		** Fixed for Version 59: When a cert doesn’t have the Issuer CN, 
		** the encrypted message could not be decrypted using Chilkat library, 
		** even though the cert does have subject key id.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Fixed for Version 89: Fixed a problem with decrypting messages 
		** that used AES-GCM with a certificate having a non-exportable private key
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 40
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.DecryptUsingCert(m.loChilkatCert) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		   
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptusingpfxdata		&& Decrypts MIME using a specific PFX ( also known as PKCS12, which is a file format commonly used to store private keys with accompanying public key certificates, protected with a password-based symmetric key).
		*==============================================================================
		* Method:            DecryptUsingPFXData
		* Purpose:           Decrypts MIME using a specific PFX.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqPFXBytes -- contains the bytes of a PFX file
		*                    tcPassword -- the password to the PFX file
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Decrypts MIME using a specific PFX (also known as PKCS12, 
		** which is a file format commonly used to store private keys 
		** with accompanying public key certificates, protected with a password-based symmetric key).
		** This method allows the bytes of the PKCS12 file to be passed directly, 
		** thus allowing PKCS12's to be persisted and retrieved from non-file-based locations, 
		** such as in LDAP or a database.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqPFXBytes AS VarBinary, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DecryptUsingPFXData(m.tqPFXBytes, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptusingpfxfile		&& Decrypts MIME using a specific PFX file (also known as PKCS12) as the source for any required certificates and private keys. (Note: .pfx and .p12 files are both PKCS12 format.) Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DecryptUsingPFXFile
		* Purpose:           Decrypts MIME using a specific PFX file. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath -- the path to the PFX file
		*                    tcPassword -- the password to the PFX file
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Decrypts MIME using a specific PFX file (also known as PKCS12) 
		** as the source for any required certificates and private keys. 
		** (Note: .pfx and .p12 files are both PKCS12 format.)
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePath AS Character, tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DecryptUsingPFXFile(m.tcFilePath, m.tcPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE disposition_access		&& Access method used to retrieve the Chilkat MIME Disposition property.
		*==============================================================================
		* Method:            Disposition_Access
		* Purpose:           Access method used to retrieve the Chilkat MIME Disposition property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Disposition
		* Date Added:        06/24/2022
		*==============================================================================
		
		** 
		** The value of the Content-Disposition header field, excluding any attributes. 
		** For example, if the Content-Disposition header is this:
		** 
		** Content-Disposition: attachment; filename="starfish.gif"
		** 
		** then the value of the Disposition property is "attachment".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

