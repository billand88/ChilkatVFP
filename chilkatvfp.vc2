	HIDDEN PROCEDURE readtimeout_access		&& Access method used to retrieve the Chilkat HTTP ReadTimeout property.
		*==============================================================================
		* Method:            ReadTimeout_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP ReadTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReadTimeout
		* Date Added:        01/28/2022
		*==============================================================================
		
		**
		** The amount of time in seconds to wait before timing out when reading from an HTTP server. 
		** The ReadTimeout is the amount of time 
		** that needs to elapse while no additional data is forthcoming. 
		** During a long download, if the data stream halts for more than this amount, it will timeout. 
		** Otherwise, there is no limit on the length of time for the entire download.
		**
		** The default value is 60 seconds. Note: Prior to v9.5.0.76, the default was 20 seconds.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE readtimeout_assign		&& Assign method used to hold a reference to the ReadTimeout property.
		*==============================================================================
		* Method:            ReadTimeout_Assign
		* Purpose:           Assign method used to hold a reference to the ReadTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ReadTimeout property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE receivedcertreq_access		&& Access method used to retrieve the Chilkat HTTP ReceivedCertReq property.
		*==============================================================================
		* Method:            ReceivedCertReq_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP ReceivedCertReq property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReceivedCertReq
		* Date Added:        08/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.92
		**
		** Indicates whether the last HTTPS connection received a TLS CertificateRequest 
		** handshake message indicating that the server may require a client certificate.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 92
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE receivedcertreq_assign		&& Assign method used to hold a reference to the ReceivedCertReq property.
		*==============================================================================
		* Method:            ReceivedCertReq_Assign
		* Purpose:           Assign method used to hold 
		*                    the ReceivedCertReq property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ReceivedCertReq property.
		* Returns:           
		* Date Added:        08/18/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 92
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE redirectverb_access		&& Access method used to retrieve the Chilkat HTTP RedirectVerb property.
		*==============================================================================
		* Method:            RedirectVerb_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP RedirectVerb property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.RedirectVerb
		* Date Added:        01/28/2022
		*==============================================================================
		
		** 
		** Indicates the HTTP verb, such as GET, POST, PUT, etc. 
		** to be used for a redirect when the FollowRedirects property is set to 1. 
		** The default value of this property is "GET". 
		** This will produce the same behavior as a web browser (such as FireFox). 
		** If this property is set to the empty string, 
		** then it will cause the same verb as the original HTTP request to be used.
		**
		** Note: Prior to version 9.5.0.44, the default value of this property was the empty string.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE redirectverb_assign		&& Assign method used to hold a reference to the RedirectVerb property.
		*==============================================================================
		* Method:            RedirectVerb_Assign
		* Purpose:           Assign method used to hold a reference to the RedirectVerb property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the RedirectVerb property.
		* Returns:           
		* Date Added:        01/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE referer_access		&& Access method used to retrieve the Chilkat HTTP Referer property.
		*==============================================================================
		* Method:            Referer_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat HTTP Referer property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Referer
		* Date Added:        01/28/2022
		*==============================================================================
		
		** 
		** The Referer header field to be automatically included with 
		** GET requests issued by QuickGet or QuickGetStr. 
		** The default value is the empty string which causes the Referer field 
		** to be omitted from the request header.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

