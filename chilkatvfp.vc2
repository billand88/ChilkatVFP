	ENDPROC

	PROCEDURE longbitreadonly		&& Method run to process the Access method for a property that returns a Long (0 or a 1) and is read only from the Chilkat object.
		*==============================================================================
		* Method:            LongBitReadOnly
		* Purpose:           Method run to process the Access method for a property that 
		*                    returns a Long (0 or a 1) and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/12/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcStatement AS Character lcErrorMessage AS Character, loChilkatObject AS Object, ;
		liLongBit AS Integer, lcProperty AS Character, lcStatement AS Character, ;
		lcMethod AS Character, liStackLevel AS Integer, liLongBit AS Integer, ;
		luLongBit AS Unknown, llReturnBitAsLogical AS Logical, lcPEMType AS Character, ;
		lcSecondParameter AS Character, lcChilkatProperty AS Character, ;
		lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcStatement, m.lcPEMType, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.luLongBit
		
		liLongBit = 0
		llReturnBitAsLogical = .F.
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = PROPER(STRTRAN(m.la_Stack(IIF(m.liStackLevel > 1, ;
		m.liStackLevel - 1, m.liStackLevel), 3), [.], [ ]))
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([ ], m.lcMethod) + 1))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		
		      llReturnBitAsLogical = .lReturnBitAsLogical
		
		      TRY
		
		        STORE EVALUATE([loChilkatObject.] + m.lcChilkatProperty) ;
		        TO m.liLongBit, m.luLongBit
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      ** Return a logical type to the VFP object test
		      IF m.llReturnBitAsLogical
		
		        luLongBit = (m.liLongBit = 1)
		
		      ENDIF m.llReturnBitAsLogical
		      ** End return a logical type to the VFP object test
		
		      lcStatement = ([loChilkatWrapper.] + m.lcProperty) + [ = ] + ;
		      IIF(NOT m.llReturnBitAsLogical, ALLTRIM(STR(m.luLongBit)), ;
		      [.] + TRANSFORM(m.luLongBit, [Y]) + [.])
		
		      ** This line below is where the property is set to the value.
		      &lcStatement.
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Object not referenced correctly test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_INTEGER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE longreadonly		&& Method run to process the Access method for a property that returns a Long and is read only from the Chilkat object.
		*==============================================================================
		* Method:            LongReadOnly
		* Purpose:           Method run to process the Access method for a property 
		*                    that returns a Long and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcStatement AS Character lcErrorMessage AS Character, loChilkatObject AS Object, ;
		liLong AS Integer, lcProperty AS Character, lcStatement AS Character, ;
		lcMethod AS Character, liStackLevel AS Integer, lcPEMType AS Character, ;
		lcSecondParameter AS Character, lcChilkatProperty AS Character, ;
		lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcStatement, m.lcPEMType, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		liLong = 0
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = PROPER(STRTRAN(m.la_Stack(IIF(m.liStackLevel > 1, ;
		m.liStackLevel - 1, m.liStackLevel), 3), [.], [ ]))
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([ ], m.lcMethod) + 1))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		
		      liLong = EVALUATE([loChilkatObject.] + m.lcChilkatProperty)
		
		      lcStatement = ([loChilkatWrapper.] + m.lcProperty) + [ = ] + ALLTRIM(STR(m.liLong))
		
		      TRY
		
		        ** This line below is where the property is set to the value.
		        &lcStatement.
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Object not referenced correctly test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_INTEGER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE string		&& Method run to process the Access method for a property that returns a String (character) from the Chilkat object.
		*==============================================================================
		* Method:            String
		* Purpose:           Method run to process the Access method for a property 
		*                    that returns a String (character) from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		** For accessing a property, String is exactly the same as StringReadOnly. 
		
		RETURN THIS.StringReadOnly(m.toChilkatWrapper, m.tcCallingMethod)
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE stringreadonly		&& Method run to process the Access method for a property that returns a String and is read only from the Chilkat object.
		*==============================================================================
		* Method:            StringReadOnly
		* Purpose:           Method run to process the Access method for a property 
		*                    that returns a String (character) and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcStatement AS Character, lcErrorMessage AS Character, loChilkatObject AS Object, ;
		lcProperty AS Character, lcMethod AS Character, lcString AS Character, ;
		liStackLevel AS Integer, llSingleQuoteInString AS Logical, ;
		llDoubleQuoteInString AS Logical, llBracketsInString AS Logical, ;
		llOKToTry AS Logical, lcPEMType AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character, ;
		llCkStringVersionProperty AS Logical, lcScratch AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, m.lcMethod, ;
		m.lcString, m.lcStatement, m.lcSecondParameter, m.lcPEMType, m.lcScratch, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE .F. TO m.llSingleQuoteInString, m.llDoubleQuoteInString, ;
		m.llBracketsInString, m.llOKToTry, m.llCkStringVersionProperty
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([ ], m.lcMethod) + 1))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_CHARACTER
		
		      lcString = EVALUATE([loChilkatObject.] + m.lcChilkatProperty)
		
		      llOKToTry = .F.
		      llSingleQuoteInString = (['] $ m.lcString)
		
		      ** No single quote in string test
		      IF NOT m.llSingleQuoteInString
		
		        lcStatement = ([loChilkatWrapper.] + m.lcProperty) + [ = '] + m.lcString + [']
		
		        ** The line below handles carriage returns in HTML strings...
		        lcStatement = STRTRAN(m.lcStatement, CHR(13) + CHR(10), [' + CHR(13) + CHR(10) + '])
		        llOKToTry = .T.
		
		      ENDIF NOT m.llSingleQuoteInString
		      ** End no single quote in string test
		
		      ** Not processed yet test
		      IF NOT m.llOKToTry
		
		        llDoubleQuoteInString = (["] $ m.lcString)
		
		        ** No double quote in string test
		        IF NOT m.llDoubleQuoteInString
		
		          lcStatement = ([loChilkatWrapper.] + m.lcProperty) + [ = "] + m.lcString + ["]
		
		          ** The line below handles carriage returns in HTML strings...
		          lcStatement = STRTRAN(m.lcStatement, CHR(13) + CHR(10), [" + CHR(13) + CHR(10) + "])
		          llOKToTry = .T.
		
		        ENDIF NOT m.llDoubleQuoteInString
		        ** End no double quote in string test
		
		      ENDIF NOT m.llOKToTry
		      ** End not processed yet test
		
		      ** Not processed yet test
		      IF NOT m.llOKToTry
		
		        llBracketsInString = ('[' $ m.lcString OR ']' $ m.lcString)
		
		        ** No brackets in string test
		        IF NOT m.llBracketsInString 
		
		          lcStatement = ([loChilkatWrapper.] + m.lcProperty) + " = '" + m.lcString + [']
		
		          ** The line below handles carriage returns in HTML strings...
		          lcStatement = STRTRAN(m.lcStatement, CHR(13) + CHR(10), "' + CHR(13) + CHR(10) + '")
		          llOKToTry = .T.
		
		        ENDIF NOT m.llBracketsInString 
		        ** End no brackets in string test
		
		      ENDIF NOT m.llOKToTry
		      ** End not processed yet test
		
		      ** Okay to attempt to set the property test
		      IF m.llOKToTry 
		
		        TRY
		 
		          ** Not a long string test (should be true for a vast majority)
		          IF LENC(m.lcString) < 175
		
		            ** This line below is where the property is set to the value.
		            &lcStatement.
		
		          ELSE
		
		            lcScratch = m.loChilkatWrapper.cScratch
		            ADDPROPERTY(m.loChilkatWrapper, [cScratch], m.lcString)
		
		            lcStatement = ([loChilkatWrapper.] + m.lcProperty) + [ = loChilkatWrapper.cScratch]
		            &lcStatement.
		
		            loChilkatWrapper.cScratch = m.lcScratch
		
		          ENDIF LENC(m.lcString) < 175
		          ** End not a long string test (should be true for a vast majority)
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcMethod = m.la_Stack(m.liStackLevel, 3)
		        lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		        lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		        lcSecondParameter = [Process_Access] + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([No String Delimiter Available], m.lcSecondParameter, , THIS)
		
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF m.llOKToTry
		      ** End okay to attempt to set the property test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_CHARACTER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_CHARACTER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE variant		&& Method run to process the Access method for a property that returns a VarBinary from the Chilkat object.
		*==============================================================================
		* Method:            Variant
		* Purpose:           Method run to process the Access method for a property 
		*                    that returns a VarBinart from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		** For accessing a property, Variant is exactly the same as VariantReadOnly. 
		
		RETURN THIS.VariantReadOnly(m.toChilkatWrapper, m.tcCallingMethod)
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE variantreadonly		&& Method run to process the Access method for a property that returns a Variant and is read only from the Chilkat object.
		*==============================================================================
		* Method:            VariantReadOnly
		* Purpose:           Method run to process the Access method for a property 
		*                    that returns a Variant and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/11/2022
		*==============================================================================
		
		LPARAMETERS toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcStatement AS Character lcErrorMessage AS Character, loChilkatObject AS Object, ;
		lqValue AS VarBinary, lcProperty AS Character, lcStatement AS Character, ;
		lcMethod AS Character, liStackLevel AS Integer, lcPEMType AS Character, ;
		lcSecondParameter AS Character, lcBlob AS Character, lcChilkatProperty AS Character, ;
		lcAlternateChilkatProperty AS Character, lqScratch AS VarBinary
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcStatement, m.lcPEMType, m.lcSecondParameter, m.lcBlob, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.lqValue, m.lqScratch
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = PROPER(STRTRAN(m.la_Stack(IIF(m.liStackLevel > 1, ;
		m.liStackLevel - 1, m.liStackLevel), 3), [.], [ ]))
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([ ], m.lcMethod) + 1))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_VARBINARY
		
		      lqValue = EVALUATE([loChilkatObject.] + m.lcChilkatProperty)
		      lcBlob = CAST(m.lqValue AS Blob)
		
		      lcStatement = ([loChilkatWrapper.] + m.lcProperty) + [ = CAST(lcBlob AS VarBinary)]
		
		      TRY
		 
		        ** Not a long string test (should be true for a vast majority)
		        IF LENC(m.lcStatement) < 175
		
		          ** This line below is where the property is set to the value.
		          &lcStatement.
		
		        ELSE
		
		          lqScratch = m.loChilkatWrapper.qScratch
		          ADDPROPERTY(m.loChilkatWrapper, [qScratch], CAST(m.lcBlob AS VarBinary))
		
		          lcStatement = ([loChilkatWrapper.] + m.lcProperty) + [ = loChilkatWrapper.qScratch]
		          &lcStatement.
		
		          loChilkatWrapper.qScratch = m.lqScratch
		
		        ENDIF LENC(lcString) < 175
		        ** End not a long string test (should be true for a vast majority)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Object not referenced correctly test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_VARBINARY
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_VARBINARY
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.lqValue
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

ENDDEFINE

DEFINE CLASS process_assign AS iprocess OF "chilkatvfp.vcx" 		&& Object used to generically process an Assign method.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: callchilkat		&& Method run to call the Chilkat object to retrieve the property.
		*m: datetime		&& Method run to process the Assign method for property that returns a DateTime from the Chilkat object.
		*m: datetimereadonly		&& Method run to process the Assign method for a property that returns a DateTime and is read only from the Chilkat object.
		*m: long		&& Method run to process the Assign method for property that returns a Long bit from the Chilkat object.
		*m: longbit		&& Method run to process the Assign method for property that returns a Long bit (0 or a 1) from the Chilkat object.
		*m: longbitreadonly		&& Method run to process the Access method for a property that returns a Long (0 or a 1) and is read only from the Chilkat object.
		*m: longreadonly		&& Method run to process the Access method for a property that returns a Long and is read only from the Chilkat object.
		*m: ovalidateproperty_access		&& Access method used to retrieve a reference to the property validation object.
		*m: ovalidateproperty_assign		&& Assign method used to hold a reference to the property validation object.
		*m: string		&& Method run to process the Assign method for a property that returns a String from the Chilkat object.
		*m: stringreadonly		&& Method run to process the Assign method for a property that returns a String and is read only from the Chilkat object.
		*m: variant		&& Method run to process the Assign method for a property that returns a Variant from the Chilkat object.
		*m: variantreadonly		&& Method run to process the Assign method for a property that returns a Variant and is read only from the Chilkat object.
		*p: ovalidateproperty		&& Object property used to hold the property validator object.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "process_assign"
		ovalidateproperty = .NULL.
	*</PropValue>
	
	PROCEDURE callchilkat		&& Method run to call the Chilkat object to retrieve the property.
		*==============================================================================
		* Method:            CallChilkat
		* Purpose:           Method run to call the Chilkat object to retrieve the property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue -- the value to assign.
		*                    toChilkatWrapper -- the calling Chilkat wrapper object
		*                    tcMethodToCall -- the method to call after validation
		*                    tcValidationMethod -- the validation method (if relevant).
		* Returns:           
		* Date Added:        04/12/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown, toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], ;
		tcMethodToCall AS Character, tcValidationMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcProperty AS Character, ;
		lcMethodToCall AS Character, lcMethod AS Character, lcSecondParameter AS Character, ;
		liStackLevel AS Integer, lcClass AS Character, lcObject AS Character, ;
		luValue AS Unknown, lcPEMType AS Character, lcValidationMethod AS Character, ;
		loValidateProperty AS [iValidateProperty OF ChilkatVFP.VCX], llValidated AS Logical
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcProperty, m.lcMethodToCall, m.lcMethod, m.lcValidationMethod, ;
		m.lcSecondParameter, m.lcClass, m.lcObject, m.lcPEMType, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loValidateProperty, m.luValue 
		
		** "Park" the parameters, use local memory variables
		luValue = m.tuValue
		loChilkatWrapper = m.toChilkatWrapper
		lcMethodToCall = m.tcMethodToCall
		lcValidationMethod = m.tcValidationMethod
		
		llValidated = .F.
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(IIF(m.liStackLevel > 2, m.liStackLevel - 2, m.liStackLevel), 3)
		lcObject = PROPER(LEFTC(m.lcMethod, MAX(ATC([.], m.lcMethod) - 1, 0)))
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		** Normally I prefer clearer code but this method will get called a lot...
		lcClass = LEFTC(PROPER(m.la_Stack(m.liStackLevel - 2, 3)), ;
		MAX(ATC([.], m.la_Stack(m.liStackLevel - 2, 3)) - 1, 0))
		
		lcSecondParameter = m.lcClass + [~] + m.lcMethod + [~] + m.lcPEMType
		
		WITH THIS
		
		  ** Parameter validation test
		  IF (NOT EMPTY(m.lcMethodToCall) ;
		  AND PEMSTATUS(THIS, m.lcMethodToCall, 5))
		
		    ** Need to validate data test
		    IF NOT EMPTY(m.lcValidationMethod)
		
		      loValidateProperty = .oValidateProperty
		
		      ** Have a good object test
		      IF TYPE([loValidateProperty.Name]) == T_CHARACTER
		
		        ** Have method on validation object test
		        IF PEMSTATUS(m.loValidateProperty, m.lcValidationMethod, 5)
		
		          llValidated = EVALUATE([loValidateProperty.] + m.lcValidationMethod + [(luValue, loChilkatWrapper)])
		
		          ** Validation failed test
		          IF NOT m.llValidated
		
		            lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		
		            lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		            .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		          ENDIF NOT m.llValidated
		          ** End validation failed test
		
		        ELSE
		
		          lcSecondParameter = m.loValidateProperty.Class + [~] + m.lcMethod + [~] + [method]
		          lcErrorMessage = ChMsgSvc([Missing object method], m.lcSecondParameter, , THIS)
		          .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		        ENDIF PEMSTATUS(m.loValidateProperty, m.lcValidationMethod, 5)
		        ** End have method on validation object test
		
		      ELSE
		
		        lcSecondParameter = [loValidateProperty] + [~] + m.lcMethod + [~] + [method]
		
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF TYPE([loValidateProperty.Name]) == T_CHARACTER
		      ** End have a good object test
		
		    ELSE
		
		      llValidated = .T.
		
		    ENDIF NOT EMPTY(m.lcValidationMethod)
		    ** End need to validate data test
		
		    ** Validated test
		    IF m.llValidated
		
		      ** Call the next method...
		      .&lcMethodToCall.(m.luValue, m.loChilkatWrapper, m.lcMethod)
		
		    ENDIF m.llValidated
		    ** End validated test
		
		  ELSE
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		    lcSecondParameter = .Class + [~] + m.lcMethod + [~] + [method]
		
		    ** Error processing branch
		    DO CASE
		
		      ** No Chilkat property passed test
		      CASE EMPTY(m.lcMethodToCall)
		
		        lcSecondParameter = [calling Chilkat] + [~] + m.lcMethod + [~] + [method]
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ** No method to call test
		      CASE NOT PEMSTATUS(THIS, m.lcMethodToCall, 5)
		
		        lcSecondParameter = .Class + [~] + m.lcMethod + [~] + [method]
		        lcErrorMessage = ChMsgSvc([Missing object method], m.lcSecondParameter, , THIS)
		
		    ENDCASE
		    ** End error processing branch
		
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		  ENDIF (NOT EMPTY(m.lcMethodToCall) ;
		  AND PEMSTATUS(THIS, m.lcMethodToCall, 5))
		  ** End parameter validation test
		
		ENDWITH
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loValidateProperty
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE datetime		&& Method run to process the Assign method for property that returns a DateTime from the Chilkat object.
		*==============================================================================
		* Method:            DateTime
		* Purpose:           Method run to process the Assign method for 
		*                    a property that returns a DateTime from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        ttValue -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        05/10/2022
		*==============================================================================
		
		LPARAMETERS ttValue AS DateTime, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, lcProperty AS Character, ;
		lcMethod AS Character, ltValue AS DateTime, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		ltValue = {}
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  ** "Park" the parameters...
		  ltValue = m.ttValue
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_DATETIME
		
		      ** Have a good parameter test
		      IF VARTYPE(m.ltValue) == T_DATETIME
		
		        lcStatement = [STORE ltValue TO loChilkatWrapper.] + ;
		        m.lcProperty + [, loChilkatObject.] + m.lcChilkatProperty
		
		        TRY
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(liValue) == T_DATETIME
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_DATETIME
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_DATETIME
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE datetimereadonly		&& Method run to process the Assign method for a property that returns a DateTime and is read only from the Chilkat object.
		*==============================================================================
		* Method:            DateTime
		* Purpose:           Method run to process the Assign method for a property 
		*                    that returns a DateTime and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        ttValue -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        06/02/2022
		*==============================================================================
		
		LPARAMETERS ttValue AS DateTime, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, lcProperty AS Character, ;
		lcMethod AS Character, ltValue AS DateTime, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		ltValue = {}
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  ** "Park" the parameters...
		  ltValue = m.ttValue
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_DATETIME
		
		      ** Have a good parameter test
		      IF VARTYPE(m.ltValue) == T_DATETIME
		
		        lcStatement = [STORE ltValue TO loChilkatWrapper.] + m.lcProperty
		
		        TRY
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(liValue) == T_DATETIME
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_DATETIME
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_DATETIME
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE Destroy
		*==============================================================================
		* Method:            Destroy
		* Purpose:           Occurs when an object is released.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        04/12/2022
		*==============================================================================
		
		WITH THIS
		
		  ** Have a good object test
		  IF TYPE([.oValidateProperty.Name]) == T_CHARACTER
		
		    ** Have a Release method test
		    IF PEMSTATUS(.oValidateProperty, [Release], 5)
		
		      .oValidateProperty.Release()
		
		    ENDIF PEMSTATUS(.oValidateProperty, [Release], 5)
		    ** End have a Release method test
		
		  ENDIF TYPE([.oValidateProperty.Name]) == T_CHARACTER
		  ** End have a good object test
		
		  .oValidateProperty = NULL
		
		ENDWITH
		
		RETURN DODEFAULT()
	ENDPROC

	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        04/12/2022
		*==============================================================================
		
		LOCAL llReturn AS Logical, loValidateProperty AS Custom, lcErrorMessage AS Character
		
		loValidateProperty = NULL
		lcErrorMessage = []
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loValidateProperty = NEWOBJECT([iValidateProperty])
		
		    ** Have a good object test
		    IF TYPE([loValidateProperty.Name]) == T_CHARACTER
		
		      .oValidateProperty = m.loValidateProperty
		
		    ELSE
		
		      lcErrorMessage = ChMsgSvc([Not Instantiate ValidateProperty], , , THIS)
		     .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		     llReturn = .F.
		
		    ENDIF TYPE([loValidateProperty.Name]) == T_CHARACTER
		    ** End have a good object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loValidateProperty = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loValidateProperty = NEWOBJECT([iValidateProperty], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE long		&& Method run to process the Assign method for property that returns a Long bit from the Chilkat object.
		*==============================================================================
		* Method:            Long
		* Purpose:           Method run to process the Assign method for 
		*                    a property that returns a Long from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, lcProperty AS Character, ;
		lcMethod AS Character, liValue AS Integer, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		liValue = 0
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  ** "Park" the parameters...
		  liValue = m.tiValue
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		
		      ** Have a good parameter test
		      IF VARTYPE(m.liValue) == T_INTEGER
		
		        TRY
		
		          lcStatement = [STORE liValue TO .] + m.lcProperty + ;
		          [, loChilkatObject.] + m.lcChilkatProperty
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(m.liValue) == T_INTEGER
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_INTEGER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE longbit		&& Method run to process the Assign method for property that returns a Long bit (0 or a 1) from the Chilkat object.
		*==============================================================================
		* Method:            LongBit
		* Purpose:           Method run to process the Assign method for 
		*                    a property that returns a Long bit (0 or a 1) from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuLongBit -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS tuLongBit AS Unknown, toChilkatWrapper AS [iBaseChilkat OF iChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF iChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, liLongBit AS Integer, ;
		lcProperty AS Character, llReturnBitAsLogical AS Logical, ;
		lcMethod AS Character, luLongBit AS Unknown, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcPEMType, ;
		m.lcSecondParameter, m.lcStatement, m.lcProperty, m.lcMethod, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.luLongBit
		STORE 0 TO m.liLongBit, m.liStackLevel
		
		llReturnBitAsLogical = .F.
		
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  ** "Park" the parameters...
		  luLongBit = m.tuLongBit
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		
		      llReturnBitAsLogical = .lReturnBitAsLogical
		
		      ** Have a good parameter test
		      IF (VARTYPE(m.luLongBit) == T_INTEGER ;
		      AND INLIST(m.luLongBit, 0, 1)) ;
		      OR (VARTYPE(m.luLongBit) == T_LOGICAL)
		
		        ** Passed parameter is logical test
		        IF VARTYPE(m.luLongBit) == T_LOGICAL
		
		          liLongBit = IIF(NOT m.luLongBit, 0, 1)
		
		        ELSE
		
		          liLongBit = m.luLongBit
		
		        ENDIF VARTYPE(m.luLongBit) == T_LOGICAL
		        ** End passed parameter is logical test
		
		        TRY
		
		          ** Set the Chilkat object correctly
		          lcStatement = [loChilkatObject.] + m.lcChilkatProperty + [ = ] + ALLTRIM(STR(m.liLongBit))
		          &lcStatement.
		
		          ** Passing a logical value to Chilkat wrapper object test
		          IF m.llReturnBitAsLogical
		
		            ** Now pass a logical to the wrapper.
		            lcStatement = [loChilkatWrapper.] + m.lcProperty + [ = .] + TRANSFORM(m.luLongBit, [Y]) + [.]
		
		          ELSE && send back a number
		
		            lcStatement = [loChilkatWrapper.] + m.lcProperty + [ = ] + ALLTRIM(STR(m.liLongBit))
		
		          ENDIF m.llReturnBitAsLogical
		          ** End passing a logical value to Chilkat wrapper object test
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF (VARTYPE(m.luLongBit) == T_INTEGER ;
		      AND INLIST(m.luLongBit, 0, 1)) ;
		      OR (VARTYPE(m.luLongBit) == T_LOGICAL)
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_INTEGER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcProperty)) == T_INTEGER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.luLongBit
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE longbitreadonly		&& Method run to process the Access method for a property that returns a Long (0 or a 1) and is read only from the Chilkat object.
		*==============================================================================
		* Method:            LongBitReadOnly
		* Purpose:           Method run to process the Assign method for 
		*                    a property that returns a Long bit (0 or a 1) from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuLongBit -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS tuLongBit AS Unknown, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF iChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, liLongBit AS Integer, ;
		lcProperty AS Character, lcMethod AS Character, liStackLevel AS Integer, ;
		luLongBit AS Unknown, lcStatement AS Character, lcPEMType AS Character, ;
		llReturnBitAsLogical AS Logical, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE 0 TO m.liLongBit, m.liStackLevel
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.luLongBit
		
		llReturnBitAsLogical = .F.
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  ** "Park" the parameters...
		  luLongBit = m.tuLongBit
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		      
		      llReturnBitAsLogical = .lReturnBitAsLogical
		
		      ** Note that the property on the Chilkat object (loChilkatObject) is not set.
		      ** Setting a value is simply ignored.
		
		      ** Have a good parameter test
		      IF (VARTYPE(m.luLongBit) == T_INTEGER ;
		      AND INLIST(m.luLongBit, 0, 1)) ;
		      OR (VARTYPE(m.luLongBit) == T_LOGICAL)
		
		        ** Passed parameter is logical test
		        IF VARTYPE(m.luLongBit) == T_LOGICAL
		
		          liLongBit = IIF(NOT m.luLongBit, 0, 1)
		
		        ELSE
		
		          liLongBit = m.luLongBit
		
		        ENDIF VARTYPE(m.luLongBit) == T_LOGICAL
		        ** End passed parameter is logical test
		
		        TRY
		
		          ** Passing a logical value to Chilkat wrapper object test
		          IF m.llReturnBitAsLogical
		
		            ** Now pass a logical to the wrapper.
		            lcStatement = [loChilkatWrapper.] + m.lcProperty + [ = .] + TRANSFORM(m.luLongBit, [Y]) + [.]
		
		          ELSE && send back a number
		
		            lcStatement = [loChilkatWrapper.] + m.lcProperty + [ = ] + ALLTRIM(STR(m.liLongBit))
		
		          ENDIF m.llReturnBitAsLogical
		          ** End passing a logical value to Chilkat wrapper object test
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(m.liLongBit) == T_INTEGER
		      ** End passed correct parameter type test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_INTEGER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.luLongBit
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE longreadonly		&& Method run to process the Access method for a property that returns a Long and is read only from the Chilkat object.
		*==============================================================================
		* Method:            LongReadOnly
		* Purpose:           Method run to process the Assign method for 
		*                    a property that returns a Long and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, lcProperty AS Character, ;
		lcMethod AS Character, liValue AS Integer, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, m.lcMethod, ;
		m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		liValue = 0
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  ** "Park" the parameters...
		  liValue = m.tiValue
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		
		      ** Note that the property on the Chilkat object (loChilkatObject) is not set.
		      ** Setting a value is simply ignored.
		
		      ** Have a good parameter test
		      IF VARTYPE(m.liValue) == T_INTEGER
		
		        lcStatement = [STORE liValue TO loChilkatWrapper.] + m.lcProperty
		
		        TRY
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(m.liValue) == T_INTEGER
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_INTEGER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_INTEGER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	HIDDEN PROCEDURE ovalidateproperty_access		&& Access method used to retrieve a reference to the property validation object.
		*==============================================================================
		* Method:            oValidateProperty_Access
		* Purpose:           Access method used to retrieve a reference to the Validate Property object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           .oValidateProperty, the Validate Property object, or NULL.
		* Date Added:        04/12/2022
		* Notes:             Don't instantiate the object if we're sitting in the Destroy method.
		*==============================================================================
		
		LOCAL loValidateProperty AS [iValidateProperty OF ChilkatVFP.VCX], lcErrorMessage AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcPEMType AS Character, lcSecondParameter AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcProperty, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		WITH THIS
		
		  loValidateProperty = .oValidateProperty
		
		  ** Object doesn't exist test
		  IF ISNULL(m.loValidateProperty) ;
		  OR TYPE([loValidateProperty.Name]) # T_CHARACTER
		
		    ASTACKINFO(la_Stack)
		
		    ** Not in Destroy method test
		    IF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		
		      loValidateProperty = CREATEOBJECT([iValidateProperty])
		 
		      ** Problems with instantiation test
		      IF TYPE([loValidateProperty.Name]) # T_CHARACTER
		
		        liStackLevel = ASTACKINFO(la_Stack)
		        lcMethod = m.la_Stack(m.liStackLevel, 3)
		        lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		        lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		        lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		        lcSecondParameter = m.lcProperty + [~] + m.lcMethod + [~] + m.lcPEMType
		
		        lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF TYPE([loValidateProperty.Name]) # T_CHARACTER
		      ** End problems with instantiation test
		
		    ENDIF NOT (UPPER(ALLTRIM(JUSTEXT(m.la_Stack(MAX(ALEN(m.la_Stack, 1) - 1, 1), 3)))) == [DESTROY])
		    ** End not in Destroy method test
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.loValidateProperty) ;
		  OR TYPE([loValidateProperty.Name]) # T_CHARACTER
		  ** End object doesn't exist test
		
		  .oValidateProperty = m.loValidateProperty
		
		ENDWITH
		
		loValidateProperty = NULL
		
		RETURN THIS.oValidateProperty
		
		** Design time IntelliSense test
		#IF .F.
		
		  loValidateProperty = NEWOBJECT([iValidateProperty], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE ovalidateproperty_assign		&& Assign method used to hold a reference to the property validation object.
		*==============================================================================
		* Method:            oValidateProperty_Assign
		* Purpose:           Assign method used to hold a reference to the Validate Property object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toValidateProperty, the Validate Property object, or NULL
		* Returns:           
		* Date Added:        04/12/2022
		*==============================================================================
		
		LPARAMETERS toValidateProperty AS [iValidateProperty OF ChilkatVFP.VCX]
		
		LOCAL loValidateProperty AS [iValidateProperty OF ChilkatVFP.VCX], ;
		lcErrorMessage AS Character, lcPEMType AS Character, lcSecondParameter AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		liStackLevel = 0
		
		loValidateProperty = m.toValidateProperty
		
		WITH THIS
		
		  ** Parameter validation test
		  IF ISNULL(m.loValidateProperty) ;
		  OR TYPE([loValidateProperty.Name]) == T_CHARACTER
		
		    .oValidateProperty = m.loValidateProperty
		
		  ELSE
		
		    liStackLevel = ASTACKINFO(la_Stack)
		
		    lcMethod = m.la_Stack(m.liStackLevel, 3)
		    lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		
		    lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		
		    lcErrorMessage = ChMsgSvc([Passed value not correct type], m.lcSecondParameter, , THIS)
		    .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ** Redefine when not in use.
		    LOCAL ARRAY la_Stack[1, 1]
		    la_Stack[1, 1] = []
		
		  ENDIF ISNULL(m.loValidateProperty) ;
		  OR TYPE([loValidateProperty.Name]) == T_CHARACTER
		  ** End parameter validation test
		
		ENDWITH
		
		loValidateProperty = NULL
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loValidateProperty = NEWOBJECT([iValidateProperty], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE string		&& Method run to process the Assign method for a property that returns a String from the Chilkat object.
		*==============================================================================
		* Method:            String
		* Purpose:           Method run to process the Assign method for 
		*                    a property that returns a String from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/10/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, lcProperty AS Character, ;
		lcMethod AS Character, lcValue AS String, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcValue, m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  lcValue = m.tcValue
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_CHARACTER
		
		      ** Have a good parameter test
		      IF VARTYPE(m.lcValue) == T_CHARACTER
		
		        lcStatement = [STORE lcValue TO loChilkatWrapper.] + ;
		        m.lcProperty + [, loChilkatObject.] + m.lcChilkatProperty
		   
		        ** The line below handles carriage returns in HTML strings...
		        lcStatement = STRTRAN(m.lcStatement, CHR(13) + CHR(10), [' + CHR(13) + CHR(10) + '])
		
		        TRY
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(m.lcValue) == T_CHARACTER
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_CHARACTER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_CHARACTER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE stringreadonly		&& Method run to process the Assign method for a property that returns a String and is read only from the Chilkat object.
		*==============================================================================
		* Method:            StringReadOnly
		* Purpose:           String run to process the Assign method for 
		*                    a property that returns a String and is read only from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        01/11/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, lcProperty AS Character, ;
		lcMethod AS Character, lcValue AS String, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcValue, m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  lcValue = m.tcValue
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_CHARACTER
		
		      ** Have a good parameter test
		      IF VARTYPE(m.lcValue) == T_CHARACTER
		
		        ** Note that the property on the Chilkat object (loChilkatObject) is not set.
		        ** Setting a value is simply ignored.
		
		        lcStatement = [STORE lcValue TO loChilkatWrapper.] + m.lcProperty
		
		        ** The line below handles carriage returns in HTML strings...
		        lcStatement = STRTRAN(m.lcStatement, CHR(13) + CHR(10), [' + CHR(13) + CHR(10) + '])
		
		        TRY
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(m.lcValue) == T_CHARACTER
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_CHARACTER
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_CHARACTER
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE variant		&& Method run to process the Assign method for a property that returns a Variant from the Chilkat object.
		*==============================================================================
		* Method:            Variant
		* Purpose:           Method run to process the Assign method for 
		*                    a property that returns a Variant from the Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqValue -- the value to set
		*                    toChilkatWrapper -- the Chilkat wrapper object
		*                    tcCallingMethod -- the calling method from the wrapper object.
		* Returns:           
		* Date Added:        04/08/2022
		*==============================================================================
		
		LPARAMETERS tqValue AS VarBinary, ;
		toChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], tcCallingMethod AS Character
		
		LOCAL loChilkatWrapper AS [iBaseChilkat OF ChilkatVFP.VCX], lcCallingMethod AS Character, ;
		lcErrorMessage AS Character, loChilkatObject AS Object, lcProperty AS Character, ;
		lcMethod AS Character, lqValue AS VarBinary, liStackLevel AS Integer, ;
		lcPEMType AS Character, lcStatement AS Character, lcSecondParameter AS Character, ;
		lcChilkatProperty AS Character, lcAlternateChilkatProperty AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcCallingMethod, m.lcErrorMessage, m.lcProperty, ;
		m.lcMethod, m.lcPEMType, m.lcStatement, m.lcSecondParameter, ;
		m.lcChilkatProperty, m.lcAlternateChilkatProperty, m.la_Stack
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject, m.lqValue
		
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		** Parameter validation test
		IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ASSIGN])
		
		  ** "Park" the parameters...
		  lqValue = m.tqValue
		  loChilkatWrapper = m.toChilkatWrapper
		  lcCallingMethod = m.tcCallingMethod
		
		  lcCallingMethod = SUBSTRC(m.lcCallingMethod, AT_C([.], m.lcCallingMethod) + 1)
		
		  STORE LEFTC(m.lcCallingMethod, LENC(m.lcCallingMethod) - 7) ;
		  TO m.lcProperty, m.lcChilkatProperty
		
		  WITH m.loChilkatWrapper
		
		    loChilkatObject = .oChilkat
		
		    lcAlternateChilkatProperty = m.loChilkatWrapper.cChilkatProperty
		
		    ** Have an alternate Chilkat property name test
		    IF NOT EMPTY(m.lcAlternateChilkatProperty)
		
		      ** In this situation, the VFP property name
		      ** and the Chilkat property name are different.
		      ** See MIME.MimeName property (vs. Chilkat's MIME Name property)
		
		      lcChilkatProperty = m.lcAlternateChilkatProperty
		
		    ENDIF NOT EMPTY(m.lcAlternateChilkatProperty)
		    ** End have an alternate Chilkat property name test
		
		    ** Have a good Chilkat object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_VARBINARY
		
		      ** Have a good parameter test
		      IF VARTYPE(m.lqValue) == T_VARBINARY
		
		        lcBlob = CAST(m.lqValue AS Blob)
		        lcStatement = [loChilkatWrapper.] + m.lcProperty + [ = CAST(lcBlob AS VarBinary)]
		
		        lcStatement = [STORE CAST(lcBlob AS VarBinary) TO ] + ;
		        [loChilkatWrapper.] + m.lcProperty + [, loChilkatObject.] + m.lcChilkatProperty
		
		        TRY
		
		          &lcStatement.
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ELSE
		
		        lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		        lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		        .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		      ENDIF VARTYPE(m.lqValue) == T_VARBINARY
		      ** End have a good parameter test
		
		    ELSE
		
		      lcPEMType = LOWER(PEMSTATUS(m.loChilkatWrapper, m.lcMethod, 3))
		
		      ** Error processing branch
		      DO CASE
		
		        ** Property has incorrect value type test
		        CASE VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) # T_VARBINARY
		
		          lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Passed parameter not correct value], m.lcSecondParameter, , THIS)
		
		        ** Property has incorrect value type test
		        CASE NOT (VARTYPE(m.loChilkatObject) == T_OBJECT AND (NOT ISNULL(m.loChilkatObject)))
		
		          lcSecondParameter = [loProcess_Access] + [~] + m.lcMethod + [~] + m.lcPEMType
		          lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		      ENDCASE
		      ** End error processing branch
		
		      .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_VARBINARY
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

