	PROCEDURE savetofile		&& Saves the string to a file, using the character encoding specified by charsetEncoding. This method allows for the string to be saved using character encodings such as "utf-8", "Unicode", "Shift-JIS", or anything else...
		*==============================================================================
		* Method:            SaveToFile
		* Purpose:           Saves the string to a file,
		*                    using the character encoding specified by charsetEncoding.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath, the path to the file to save.
		*                    tcEncoding, the character encoding of the file to save.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/25/2022
		*==============================================================================
		
		**
		** Saves the string to a file, using the character encoding specified by charsetEncoding. 
		** This method allows for the string to be saved using character encodings 
		** such as "utf-8", "Unicode", "Shift-JIS", or anything else...
		**
		** Fixed for version 75: This method did not write a file with no BOM (Byte Order Mark) 
		** when passing “no-bom-utf-8” for the charsetEncoding. 
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcFilePath AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CKSTRING_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SaveToFile(m.tcFilePath, m.tcEncoding) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CKSTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

