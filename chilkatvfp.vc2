	PROCEDURE setcsp		&& Undocumented method! Accepts a (decremented) Chilkat CSP reference.
		*==============================================================================
		* Method:            SetCSP
		* Purpose:           Undocumented method! Accepts a (decremented) Chilkat CSP reference.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCSP, a Chilkat CSP object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		**
		** Decremented function! Accepts a (decremented) Chilkat CSP reference.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCSP AS [Chilkat_9_5_0.Csp]
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loParkParameterCsp AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCsp AS [Chilkat_9_5_0.Csp], loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      loParkParameterCsp = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCsp)
		
		      loChilkatCsp = m.loParkParameterCsp.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetCSP(m.loChilkatCSP) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCsp = ;
		      m.loParkParameterCsp.SetObject(m.toChilkatCsp, m.loChilkatCsp)
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  toChilkatCSP = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loParkParameterCsp = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCsp = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

