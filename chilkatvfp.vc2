	PROCEDURE signbytes		&& Digitally signs a byte array and returns the detached digital signature. A certificate must be set by calling SetSigningCert prior to calling this method. Returns a zero-length byte array (as a Variant) on failure.
		*==============================================================================
		* Method:            SignBytes
		* Purpose:           Digitally signs a byte array and returns the detached digital signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqDataBytes -- the bytes to sign. 
		* Returns:           A detached digital signature.
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Digitally signs a byte array and returns the detached digital signature. 
		** A certificate must be set by calling SetSigningCert prior to calling this method.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqDataBytes AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqDetachedSignature AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDetachedSignature
		
		WITH THIS
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lqDetachedSignature = m.loChilkatObject.SignBytes(m.tqDataBytes)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDetachedSignature
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

