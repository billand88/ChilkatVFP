	PROCEDURE setsecurepassword		&& Introduced in version 9.5.0.76. Sets the password in a more secure way than setting the Password property. Calling this method is the equivalent of setting the Password property. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetSecurePassword
		* Purpose:           Sets the password in a more secure way than setting the Password property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSecureString, a Chilkat Secure String object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** Sets the password in a more secure way than setting the Password property. 
		** Calling this method is the equivalent of setting the Password property.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterSecureString AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString 
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSecureString = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureString)
		
		      loChilkatSecureString = m.loParkParameterSecureString.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetSecurePassword(m.loChilkatSecureString) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSecureString = m.loParkParameterSecureString.SetObject(;
		      m.toChilkatSecureString, m.loChilkatSecureString)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  toChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loParkParameterSecureString = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsslcertrequirement		&& Enforces a requirement on the server's certificate. The reqName can be one of the following: SubjectDN, SubjectCN, IssuerDN, IssuerCN, SAN (added in v9.5.0.84).
		*==============================================================================
		* Method:            SetSSLCertRequirement
		* Purpose:           Enforces a requirement on the server's certificate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRequirementName -- the name of the requirement.
		*                    tcRequirementValue -- the value of the requirement.
		* Returns:           
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** Enforces a requirement on the server's certificate. 
		** The reqName can be one of the following:
		**
		** SubjectDN
		** SubjectCN
		** IssuerDN
		** IssuerCN
		** SAN (added in v9.5.0.84)
		** 
		** The reqName specifies the part of the certificate, 
		** and the reqValue is the value that it must match exactly or with a wildcard (*). 
		** If the server's certificate does not match, the SSL / TLS connection is aborted.
		**
		** Fix for version 80: Fixed the method. 
		** It was not working as indicated in the reference documentation.
		**
		
		LPARAMETERS tcRequirementName AS Character, tcRequirementValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.SetSSLCertRequirement(m.tcRequirementName, m.tcRequirementValue)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsslclientcert		&& Allows for a client-side certificate to be used for the SSL / TLS connection. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetSSLClientCert
		* Purpose:           Allows for a client-side certificate to be used for the SSL / TLS connection. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.  
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** Allows for a client-side certificate to be used for the SSL / TLS connection.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], liReturn AS Integer, ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetSSLClientCert(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsslclientcertpem		&& Allows for a client-side certificate to be used for the SSL / TLS connection. If the PEM requires no password, pass an empty string in pemPassword. If the PEM is in a file, pass the path to the file in pemDataOrFilename.
		*==============================================================================
		* Method:            SetSSLClientCertPEM
		* Purpose:           Allows for a client-side certificate to be used for the SSL / TLS connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMDataOrFileName -- the PEM information.
		*                    tcPEMPassword -- the PEM password, if relevant.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/07/2022
		*==============================================================================
		
		**
		** Allows for a client-side certificate to be used for the SSL / TLS connection. 
		** If the PEM requires no password, pass an empty string in pemPassword. 
		** If the PEM is in a file, pass the path to the file in pemDataOrFilename. 
		** If the PEM is already loaded into a string variable, 
		** then pass the string containing the contents of the PEM in pemDataOrFilename.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPEMDataOrFileName AS Character, tcPEMPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn 
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetSSLClientCertPEM(m.tcPEMDataOrFileName, m.tcPEMPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

