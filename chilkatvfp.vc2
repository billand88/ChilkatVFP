		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  toChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loParkParameterStream = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStream = NEWOBJECT(CHILKAT_STREAM_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE unziptostring		&& Inflate and return the uncompressed data as a string The lineEndingBehavior is as follows: 0 = leave unchanged.
		*==============================================================================
		* Method:            UnZipToString
		* Purpose:           Inflate and return the uncompressed data as a string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        tiLineEndingBehavior, how to end the line
		*                    tcCharSet, the charset of the source string
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Inflate and return the uncompressed data as a string.
		**
		** The lineEndingBehavior is as follows:
		** 
		** 0 = leave unchanged.
		** 1 = convert all to bare LF's
		** 2 = convert all to CRLF's
		** 
		** The srcCharset tells the component how to interpret the bytes 
		** of the uncompressed file -- i.e. as utf-8, utf-16, windows-1252, etc.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiLineEndingBehavior AS Integer, tcCharSet AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.UnZipToString(m.tiLineEndingBehavior, m.tcCharSet) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

