	HIDDEN PROCEDURE readframefailreason_access		&& Access method used to retrieve the Chilkat WebSocket ReadFrameFailReason property.
		*==============================================================================
		* Method:            ReadFrameFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat WebSocket ReadFrameFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReadFrameFailReason
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** If the ReadFrame method returns 0, this property holds the fail reason. 
		** It can have one of the following values:
		** 
		**   0 - No failure.
		**   1 - Read Timeout.
		**   2 - Aborted by Application Callback.
		**   3 - Fatal Socket Error (Lost Connection).
		**   4 - Received invalid WebSocket frame bytes.
		**   99 - A catch-all for any unknown failure. 
		**        (Should not ever occur.  If it does, contact Chilkat.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 70
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE readframefailreason_assign		&& Assign method used to hold a reference to the ReadFrameFailReason property.
		*==============================================================================
		* Method:            ReadFrameFailReason_Assign
		* Purpose:           Assign method used to hold a reference to the ReadFrameFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ReadFrameFailReason property.
		* Returns:           
		* Date Added:        07/06/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 70
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE sendclose		&& Introduced in version 9.5.0.70. Sends a Close control frame. If includeStatus is 1, then the statusCode is sent in the application data part of the Close frame. A Close reason may be provided only if includeStatus is 1.
		*==============================================================================
		* Method:            SendClose
		* Purpose:           Sends a Close control frame.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuIncludeStatus -- whether or not to include status information.
		*                    tiStatusCode -- the status code.
		*                    tcReason -- the close reason.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.70
		**
		** Sends a Close control frame. If includeStatus is 1, then the statusCode 
		** is sent in the application data part of the Close frame. 
		** A Close reason may be provided only if includeStatus is 1. 
		** If this Close was sent to satisfy an already-received Close frame, 
		** then the underlying connection will also automatically be closed.
		** 
		** Note: If a status code and reason are provided, 
		** the utf-8 representation of the reason string must be 123 bytes or less. 
		** Chilkat will automatically truncate the reason to 123 bytes if necessary. 
		** Also, the status code must be an integer in the range 0 to 16383.
		** 
		** The WebSocket protocol specifies some pre-defined status codes 
		** at WebSocket Status Codes. For a normal closure, a status code value 
		** of 1000 should be used. The reason can be any string, 
		** as long as it is 123 bytes or less.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tuIncludeStatus AS Unknown, ;
		tiStatusCode AS Integer, tcReason AS Character
		
		LOCAL loChilkatObject AS CHILKAT_WEBSOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liIncludeStatus AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeStatus, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 70
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		        liIncludeStatus = .LogicalToBit(m.tuIncludeStatus)
		
		      TRY
		
		        STORE m.loChilkatObject.SendClose(m.liIncludeStatus, ;
		        m.tiStatusCode, m.tcReason) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_WEBSOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

