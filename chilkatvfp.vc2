	ENDPROC

	PROCEDURE getcc		&& Returns a carbon-copy recipient's full email address. Returns Nothing on failure
		*==============================================================================
		* Method:            GetCC
		* Purpose:           Returns a carbon-copy recipient's full email address.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, index to the CC array. 
		* Returns:           lcEmailAddress, the full email address.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** Returns a carbon-copy recipient's full email address.
		**
		** Fix for verison 80: Fixed automatic Q/B decoding for email address header fields. 
		** Normally, a TO or CC email header may be Q/B encoded such that the friendly-name part 
		** is encoded but not the address part.  
		** For example:  “=?utf-8?B?TWF0dA==?= <support@chilkatsoft.com>”. This was already handled correctly.
		** However, if the entire name+address string, including the quotes around the name part are Q/B encoded, 
		** such as like this  “=?utf-8?B?Ik1hdHQiIDxzdXBwb3J0QGNoaWxrYXRzb2Z0LmNvbT4=?=”, 
		** then Chilkat returned the entire string as the email address, without decoding. 
		** This method will now return automatically decoded strings for this case.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, lcEmailAddress AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEmailAddress = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEmailAddress = m.loChilkatObject.GetCC(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEmailAddress
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

