	PROCEDURE loadx5c		&& Introduced in version 9.5.0.66. Loads a certificate chain from the "x5c" parameter of a JWK (JSON Web Key). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadX5C
		* Purpose:           Loads a certificate chain from the "x5c" parameter of a JWK (JSON Web Key).
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		**
		** Loads a certificate chain from the "x5c" parameter of a JWK (JSON Web Key).
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERTCHAIN_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loParkParameterc AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJSONObject)
		
		      loChilkatJSONObject = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadX5C(m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSONObject = m.loParkParameterJSONObject.SetObject(;
		      m.toChilkatJSONObject, m.loChilkatJSONObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatJSONObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTCHAIN_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE numcerts_access		&& Access method used to retrieve the Chilkat CertChain NumCerts property.
		*==============================================================================
		* Method:            NumCerts_Access
		* Purpose:           Access method used to retrieve the Chilkat CertChain NumCerts property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumCerts
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** The number of certificates in the chain. 
		** The end-user subscriber certificate is at index 0. 
		** This is the certificate most removed from the trusted root. 
		** Intermediate certificates are at indices 1 to NumCerts - 2. 
		** The trusted root (or self-signed certificate) is at index NumCerts - 1.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 40
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

