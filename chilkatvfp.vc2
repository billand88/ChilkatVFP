		  toChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loParkParameterZipEntry = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatZipEntry = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

