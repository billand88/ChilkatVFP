	PROCEDURE sortbycolumn		&& Sorts the rows in the CSV by the contents of a specific column. If ascending is 1, the sort is in ascending order, otherwise descending order. If caseSensitive is 1 then the sorting is case sensitive. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SortByColumn
		* Purpose:           Sorts the rows in the CSV by the contents of a specific column.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcColumnName, the column name.
		*                    tuAscending, whether or not to use an ascending sort.
		*                    tuCaseSensitive, whether or not the pattern match is case sensitive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/25/2022
		*==============================================================================
		
		**
		** Sorts the rows in the CSV by the contents of a specific column. 
		** If ascending is 1, the sort is in ascending order, otherwise descending order. 
		** If caseSensitive is 1 then the sorting is case sensitive.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcColumnName AS Character, tuAscending AS Unknown, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CSV_COM_CALL, liCaseSensitive AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		liAscending AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive, m.liAscending
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liAscending = .LogicalToBit(m.tuAscending)
		    liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		    TRY
		
		      STORE m.loChilkatObject.SortByColumn(m.tcColumnName, ;
		      m.liAscending, m.liCaseSensitive) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSV_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sortbycolumnindex		&& Introduced in version 9.5.0.83. Sorts the rows in the CSV by the contents of a specific column index. If ascending is 1, the sort is in ascending order, otherwise descending order. If caseSensitive is 1 then the sorting is case sensitive.
		*==============================================================================
		* Method:            SortByColumnIndex
		* Purpose:           Sorts the rows in the CSV by the contents of a specific column index.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiColumnIndex, the related column index value.
		*                    tuAscending, whether or not to use an ascending sort.
		*                    tuCaseSensitive, whether or not the pattern match is case sensitive.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/25/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.83
		**
		** Sorts the rows in the CSV by the contents of a specific column index. 
		** If ascending is 1, the sort is in ascending order, otherwise descending order. 
		** If caseSensitive is 1 then the sorting is case sensitive.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiColumnIndex AS Integer, tuAscending AS Unknown, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CSV_COM_CALL, liCaseSensitive AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		liAscending AS Integer, llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn, m.liCaseSensitive, m.liAscending, m.liIntroducedInBuild
		
		llImplemented = .F.
		liIntroducedInBuild = 83
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liAscending = .LogicalToBit(m.tuAscending)
		      liCaseSensitive = .LogicalToBit(m.tuCaseSensitive)
		
		      TRY
		
		        STORE m.loChilkatObject.SortByColumnIndex(m.tiColumnIndex, ;
		        m.liAscending, m.liCaseSensitive) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSV_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat CSV UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CSV UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Delimiter
		* Date Added:        05/25/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.88
		**
		** This is a catch-all property to be used for uncommon needs. 
		** Chilkat may from time to time define keywords, which if present, 
		** change behavior in some way. If multiple keywords are needed, 
		** set this property to the comma separated list of keywords.
		**
		** The following keywords are defined:
		**
		** QuotedCells (v9.5.0.96) Forces all cell contents to be double-quoted 
		** when emitting the CSV to a file or string
		**
		** QuotedColumnNames (v9.5.0.96) Forces all column names to be double-quoted 
		** when emitting the CSV to a file or string
		**
		** EMIT_BOM (v9.5.0.93) Causes Chilkat to emit the utf-8 BOM (byte order mark) 
		** when writing the CSV to a file (assuming the CSV is written using utf-8).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 88
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*==============================================================================
		* Method:            UncommonOptions_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat CSV UncommonOptions property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the UncommonOptions property.
		* Returns:           
		* Date Added:        05/25/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 88
		
		lcValidationMethod = [UncommonOptions_CSV]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat CSV VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        05/25/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        05/25/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE xlsxdateformat_access		&& Access method used to retrieve the Chilkat CSV XLSXDateFormat property.
		*==============================================================================
		* Method:            XLSXDateFormat_Access
		* Purpose:           Access method used to retrieve the Chilkat CSV XLSXDateFormat property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.XLSXDateFormat
		* Date Added:        12/15/2025
		*==============================================================================
		
		**
		** Introduced in version 11.3.0
		**
		** The standard date format to use when converting Excel (.xlsx) spreadsheets to CSV. 
		** The default is "mm-dd-yy", but can be changed to "d/m/yyyy", or "m/d/yyyy", etc.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_Implemented[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_Implemented[1] = 11
		la_Implemented[2] = 3
		la_Implemented[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_Implemented)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE xlsxdateformat_assign		&& Assign method used to hold a reference to the XLSXDateFormat property.
		*==============================================================================
		* Method:            XLSXDateFormat_Assign
		* Purpose:           Assign method used to hold the Chilkat CSV XLSXDateFormat property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold a reference to the XLSXDateFormat property.
		* Returns:           
		* Date Added:        12/15/2025
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Implemented[3]
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		la_Implemented[1] = 11
		la_Implemented[2] = 3
		la_Implemented[3] = 0
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_Implemented)
		
		RETURN
	ENDPROC

	PROCEDURE xlsxgetsheets		&& Introduced in version 11.3.0. Returns the names of the sheets contained in the Excel spreadsheet. The xlsx is the Zip object containing the already opened .xlsx file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            XLSXGetSheets
		* Purpose:           Returns the names of the sheets contained in the Excel spreadsheet.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatZipFileName, a Chilkat Zip object.
		*                    toChilkatSheetNames, a Chilkat StringTable object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/15/2025
		*==============================================================================
		
		**
		** Introduced in version 11.3.0.
		** 
		** Returns the names of the sheets contained in the Excel spreadsheet. 
		** The xlsx is the Zip object containing the already opened .xlsx file. 
		** The sheet names are returned in sheetNames.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatZipFileName AS CHILKAT_ZIP_COM_CALL, ;
		toChilkatSheetNames AS CHILKAT_STRINGTABLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CSV_COM_CALL, loException AS Exception, ;
		loParkParameterZipFileName AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatZipFileName AS CHILKAT_ZIP_COM_CALL, ;
		loChilkatSheetNames AS CHILKAT_STRINGTABLE_COM_CALL, ;
		loParkParameterSheetNames AS [iParkParameter OF ChilkatVFP.VCX], ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.llImplemented, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterZipFileName, m.loChilkatZipFileName, ;
		m.loParkParameterSheetNames, m.loChilkatSheetNames
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 3, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterZipFileName = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatZipFileName)
		
		      loChilkatZipFileName = m.loParkParameterZipFileName.GetObject()
		
		      loParkParameterSheetNames = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSheetNames)
		
		      loChilkatSheetNames = m.loParkParameterSheetNames.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.XLSXGetSheets(m.loChilkatZipFileName, ;
		        m.loChilkatSheetNames) TO liReturn, luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatZipFileName = m.loParkParameterZipFileName.SetObject(;
		      m.toChilkatZipFileName, m.loChilkatZipFileName)
		
		      toChilkatSheetNames = m.loParkParameterSheetNames.SetObject(;
		      m.toChilkatSheetNames, m.loChilkatSheetNames)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterZipFileName, m.loChilkatZipFileName, ;
		m.loParkParameterSheetNames, m.loChilkatSheetNames
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CSV_COM_CALL)
		  toChilkatZipFileName = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  loParkParameterZipFileName = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatZipFileName = NEWOBJECT(CHILKAT_ZIP_COM_CALL)
		  toChilkatSheetNames = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loParkParameterSheetNames = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSheetNames = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense tes
	ENDPROC

	PROCEDURE xlsxloadsheet		&& Introduced in version 11.3.0. Loads the named sheet in the Excel spreadsheet into this CSV object. The zip is the Zip object containing the already opened .xlsx file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            XLSXLoadSheet
		* Purpose:           Returns the names of the sheets contained in the Excel spreadsheet.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatZipFileName, a Chilkat Zip object.
		*                    tcSheetName, the XLSX sheet name to load.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/15/2025
		*==============================================================================
		
		**
		** Introduced in version 11.3.0.
		** 
		** Loads the named sheet in the Excel spreadsheet into this CSV object. 
		** The zip is the Zip object containing the already opened .xlsx file. 
		** The sheetName is the name of the sheet to load. To load the 1st (default) sheet, 
		** pass an empty string in sheetName.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatZipFileName AS [Chilkat.Zip], tcSheetName AS Character
		
		LOCAL loChilkatObject AS [Chilkat.Csv], loException AS Exception, ;
		loParkParameterZipFileName AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatZipFileName AS [Chilkat.Zip], llImplemented AS Logical, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.llImplemented, m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterZipFileName, m.loChilkatZipFileName
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 3, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterZipFileName = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatZipFileName)
		
		      loChilkatZipFileName = m.loParkParameterZipFileName.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.XLSXLoadSheet(m.loChilkatZipFileName, ;
		        tcSheetName) TO liReturn, luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatZipFileName = m.loParkParameterZipFileName.SetObject(;
		      m.toChilkatZipFileName, m.loChilkatZipFileName)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterZipFileName, m.loChilkatZipFileName
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Csv])
		  toChilkatZipFileName = NEWOBJECT([Chilkat.Zip])
		  loParkParameterZipFileName = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatZipFileName = NEWOBJECT([Chilkat.Zip])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense tes
	ENDPROC

ENDDEFINE

DEFINE CLASS dh AS ibasechilkat OF "chilkatvfp.vcx" 		&& Diffie-Hellman (D-H) key exchange is a cryptographic protocol that allows two parties that have no prior knowledge of each other to jointly establish a shared secret key over an insecure communications channel. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: createe		&& The 1st step in Diffie-Hellman key exchange (to generate a shared-secret). The numBits should be twice the size (in bits) of the shared secret to be generated.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat DH DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: findk		&& The 2nd and final step in Diffie-Hellman (DH) key exchange. E is the E created by the other party. Returns the shared secret (K) as an SSH1-format bignum encoded as a hex string. Returns Nothing on failure.
		*m: genpg		&& Generates a large safe prime that is numBits bits in size using the generator G. Generating a new (random) P is expensive in both time and CPU cycles. A prime should be 1024 or more bits in length. Returns 1 for success, 0 for failure.
		*m: g_access		&& Access method used to retrieve the Chilkat DH G property.
		*m: g_assign		&& Assign method used to hold a reference to the G property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat DH LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat DH LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat DH LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat DH LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat DH LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat DH LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat DH LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: p_access		&& Access method used to retrieve the Chilkat DH P property.
		*m: p_assign		&& Assign method used to hold a reference to the P property.
		*m: setpg		&& Sets explicit values for P and G. Returns 1 if P and G conform to the requirements for Diffie-Hellman. P is an SSH1-format bignum passed as a hexidecimalized string. Returns 1 for success, 0 for failure.
		*m: unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*m: useknownprime		&& Sets P and G to a known safe prime.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat DH VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: g		&& The generator. The value of G should be either 2 or 5.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: p		&& A "safe" large prime returned as a hex string. The hex string represent a bignum in SSH1 format.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	HIDDEN lastmethodsuccess
	*<PropValue>
		cchilkatclass = Dh
		debuglogfilepath = 
		g = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "dh"
		p = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/07/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.0.0
		
		  Removed the UnlockComponent method.
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	PROCEDURE createe		&& The 1st step in Diffie-Hellman key exchange (to generate a shared-secret). The numBits should be twice the size (in bits) of the shared secret to be generated.
		*==============================================================================
		* Method:            CreateE
		* Purpose:           The 1st step in Diffie-Hellman key exchange.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiNumberOfBits, the number of bits to create.
		* Returns:           lcHexString, bignum in SSH format.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** The 1st step in Diffie-Hellman key exchange (to generate a shared-secret). 
		** The numBits should be twice the size (in bits) of the shared secret 
		** to be generated. For example, if you are using DH to create 
		** a 128-bit AES session key, then numBits should be set to 256. 
		** Returns E as a bignum in SSH-format as a hex string.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiNumberOfBits AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_DH_COM_CALL, ;
		loException AS Exception, lcHexString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHexString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcHexString = m.loChilkatObject.CreateE(m.tiNumberOfBits)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHexString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat DH DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DH DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/23/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat DH DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/23/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE findk		&& The 2nd and final step in Diffie-Hellman (DH) key exchange. E is the E created by the other party. Returns the shared secret (K) as an SSH1-format bignum encoded as a hex string. Returns Nothing on failure.
		*==============================================================================
		* Method:            FindK
		* Purpose:           The 2nd and final step in Diffie-Hellman (DH) key exchange. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcE, the value from the CreateE method.
		* Returns:           lcHexString, bignum in SSH format.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** The 2nd and final step in Diffie-Hellman (DH) key exchange. 
		** E is the E created by the other party. Returns the shared secret (K) 
		** as an SSH1-format bignum encoded as a hex string.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcE AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DH_COM_CALL, ;
		loException AS Exception, lcHexString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcHexString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcHexString = m.loChilkatObject.FindK(m.tcE)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcHexString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE genpg		&& Generates a large safe prime that is numBits bits in size using the generator G. Generating a new (random) P is expensive in both time and CPU cycles. A prime should be 1024 or more bits in length. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GenPG
		* Purpose:           Generates a large safe prime that is numBits bits in size 
		*                    using the generator G.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiNumberOfBits, the number of bits to create.
		*                    tiG, a generator number.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Generates a large safe prime that is numBits bits in size 
		** using the generator G. Generating a new (random) P is expensive 
		** in both time and CPU cycles. A prime should be 1024 or more bits in length.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiNumberOfBits AS Integer, tiG AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_DH_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.GenPG(m.tiNumberOfBits, m.tiG) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE g_access		&& Access method used to retrieve the Chilkat DH G property.
		*==============================================================================
		* Method:            G_Access
		* Purpose:           Access method used to retrieve the Chilkat DH G property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.G
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** The generator. The value of G should be either 2 or 5.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

