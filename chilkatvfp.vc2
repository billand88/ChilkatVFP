	PROCEDURE getheaderfieldattribute		&& Parses a MIME header field and returns the value of an attribute.
		*==============================================================================
		* Method:            GetHeaderFieldAttribute
		* Purpose:           Parses a MIME header field and returns the value of an attribute.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHeaderFieldName, the header field name.
		*                    tcAttributeName, the attribute name to retrieve the value from.
		* Returns:           The attribute value.
		* Date Added:        06/25/2022
		*==============================================================================
		
		**
		** Parses a MIME header field and returns the value of an attribute. 
		** MIME header fields w/ attributes are formatted like this:
		** 
		**   Header-Name:  value;  attrName1="value1"; attrName2="value2"; ....  attrNameN="valueN"
		** 
		** Semi-colons separate attribute name=value pairs. 
		** The Content-Type header field often contains attributes. Here is an example:
		** 
		**   Content-Type: multipart/signed;
		**     protocol="application/x-pkcs7-signature";
		**     micalg=SHA1;
		**     boundary="----=_NextPart_000_0000_01CB03E4.D0BAF010"
		** 
		** In the above example, to access the value of the "protocol" attribute, 
		** call GetHeaderFieldAttribute("Content-Type", "protocol");
		** 
		** Returns Nothing on failure.
		** 
		
		LPARAMETERS tcHeaderFieldName AS Character, tcAttributeName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MIME_COM_CALL, ;
		loException AS Exception, lcAttributeValue AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcAttributeValue = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcAttributeValue = m.loChilkatObject.GetHeaderFieldAttribute(;
		      m.tcHeaderFieldName, m.tcAttributeName)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcAttributeValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

