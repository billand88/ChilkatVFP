	HIDDEN PROCEDURE passwordchangerequested_access		&& Access method used to retrieve the Chilkat SSH PasswordChangeRequested property.
		*==============================================================================
		* Method:            PasswordChangeRequested_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH PasswordChangeRequested property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PasswordChangeRequested
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** Set by the AuthenticatePw and AuthenticatePwPk methods. 
		** If the authenticate method returns a failed status, 
		** and this property is set to 1, 
		** then it indicates the server requested a password change. 
		** In this case, re-call the authenticate method, 
		** but provide both the old and new passwords in the following format, 
		** where vertical bar characters encapsulate the old and new passwords:
		**
		** |oldPassword|newPassword|
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE passwordchangerequested_assign		&& Assign method used to hold a reference to the SSH PasswordChanged property.
		*==============================================================================
		* Method:            PasswordChangeRequested_Assign
		* Purpose:           Assign method used to hold a reference 
		*                    to the PasswordChangeRequested property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value used to hold 
		*                    a reference to the PasswordChangeRequested property.
		* Returns:           
		* Date Added:        04/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE peekreceivedtext		&& This is the same as GetReceivedText, except the internal receive buffer is not cleared. Returns Nothing on failure.
		*==============================================================================
		* Method:            PeekReceivedText
		* Purpose:           This is the same as GetReceivedText, 
		*                    except the internal receive buffer is not cleared.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		*                    tcCharset, the character set 
		*                    of the data through the channel.
		* Returns:           The (uncleared) received text
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** This is the same as GetReceivedText, except the internal receive buffer is not cleared.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiChannel AS Integer, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, ;
		loException AS Exception, lcReceivedText AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcReceivedText = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcReceivedText = m.loChilkatObject.PeekReceivedText(m.tiChannel, m.tcCharset)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcReceivedText
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE preferipv6_access		&& Access method used to retrieve the Chilkat SSH PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PreferIPV6
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** If 1, then use IPv6 over IPv4 when both are supported for a particular domain. 
		** The default value of this property is 0, which will choose IPv4 over IPv6.
		**
		** Enhancement for version 70: Added internal re-try functionality 
		** to cope with various situations for IPv4-only and IPv6-only networks.
		**
		** (Note: Chilkat was updated in v9.5.0.97 to enable "dual-stack" support, 
		** where a server can handle both IPv6 and IPv4 traffic using a single socket. 
		** Prior to v9.5.0.97, setting this property to 1 
		** had the effect that only IPv6 connections could be accepted.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE preferipv6_assign		&& Assign method used to hold a reference to the SSH PreferIPV6 property.
		*==============================================================================
		* Method:            PreferIPV6_Assign
		* Purpose:           Assign method used to hold a reference to the PreferIPV6 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the PreferIPV6 property.
		* Returns:           
		* Date Added:        04/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE quickcmdcheck		&& Introduced in version 9.5.0.65. Returns a channel number for a completed command that was previously sent via QuickCmdSend. Returns -1 if no commands have yet completed.
		*==============================================================================
		* Method:            QuickCmdCheck
		* Purpose:           Returns a channel number for a completed command 
		*                    that was previously sent via QuickCmdSend.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiTimeoutMs, the polling timeout, in milliseconds.
		* Returns:           The completed command channel.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.65
		**
		** Returns a channel number for a completed command that was previously sent via QuickCmdSend. 
		** Returns -1 if no commands have yet completed. 
		** The pollTimeoutMs indicates how long to wait (in milliseconds) 
		** for any command in progress (on any channel) to complete before returning -1.
		**
		** Returns -2 if an error occurred 
		** (for example, if the connection to the SSH server was lost while checking for responses).
		**
		
		LPARAMETERS tiTimeoutMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		liCmdChannel AS Integer, liIntroducedInBuild AS Integer, llImplemented AS Logical
		
		STORE 0 TO m.liCmdChannel, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 65
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liCmdChannel = m.loChilkatObject.QuickCmdCheck(m.tiTimeoutMs)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
