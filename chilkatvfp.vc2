		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sendmimebytes		&& This method is the same as SendMime, except the MIME is passed in a byte array. This can be important if the MIME uses a binary encoding, or if a DKIM/DomainKey signature is included.
		*==============================================================================
		* Method:            SendMIMEBytes
		* Purpose:           This method is the same as SendMime, 
		*                    except the MIME is passed in a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFromAddress -- the From: email address.
		*                    tcRecipients -- the comma separated list of recipient email addresses. 
		*                    tqMIMESource -- the binary MIME source.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** This method is the same as SendMime, except the MIME is passed in a byte array. 
		** This can be important if the MIME uses a binary encoding, 
		** or if a DKIM/DomainKey signature is included.
		**
		** To understand how the fromAddr and recipients relate 
		** to the email addresses found in the MIME headers (FROM, TO, CC), 
		** see the link below entitled "SMTP Protocol in a Nutshell". 
		** The fromAddr is what is passed to the SMTP server in the "MAIL FROM" command. 
		** The recipients are the email addresses passed in "RCPT TO" commands. 
		** These are usually the same email addresses found in the MIME headers, 
		** but need not be (unless the SMTP server enforces policies 
		** that require them to be the same).
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFromAddress AS Character, tcRecipients AS Character, tqMIMESource AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SendMIMEBytes(m.tcFromAddress, m.tcRecipients, m.tqMIMESource) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

