	HIDDEN PROCEDURE sourcefilepart_access		&& Access method used to retrieve the Chilkat Stream SourceFilePart property.
		*==============================================================================
		* Method:            SourceFilePart_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Stream SourceFilePart property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SourceFilePart
		* Date Added:        06/14/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		**
		** If the source is a file, then this property can be used 
		** to stream one part of the file. The SourceFilePartSize property defines 
		** the size (in bytes) of each part. The SourceFilePart and SourceFilePartSize 
		** have default values of 0, which means the entire SourceFile is streamed.
		** 
		** This property is a 0-based index. For example, if the SourceFilePartSize is 1000, 
		** then part 0 is for bytes 0 to 999, part 1 is for bytes 1000 to 1999, etc.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 59
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

