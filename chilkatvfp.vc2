	PROCEDURE getdt		&& Gets the last-modification date/time to be embedded within the .gz. Returns Nothing on failure
		*==============================================================================
		* Method:            GetDt
		* Purpose:           Returns the last-modified date/time of this zip entry.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Date Time object or NULL
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** Gets the last-modification date/time to be embedded within the .gz.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, ;
		loException AS Exception, loChilkatCkDateTime AS CHILKAT_CKDATETIME_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCkDateTime
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCkDateTime = m.loChilkatObject.GetDt()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCkDateTime
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loChilkatCkDateTime = NEWOBJECT(CHILKAT_CKDATETIME_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getgzipinfo		&& Introduced in version 11.5.0. Retrieves metadata stored in a Gzip file and returns the information in a JsonObject.
		*==============================================================================
		* Method:            GetGZipInfo
		* Purpose:           Retrieves metadata stored in a Gzip file 
		*                    and returns the information in a JsonObject.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath -- the path to the file.
		*                    toChilkatJsonObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/02/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Retrieves metadata stored in a Gzip file and returns the information in a JsonObject.
		** 
		** The metadata is returned using the following JSON structure:
		** 
		** {
		**   "extraData": "AAECAw==",
		**   "filename": "example.txt",
		**   "comment": "This is the comment"
		** }
		** 
		** filename – the original filename embedded in the Gzip file (if present)
		** comment – an optional descriptive comment (if present)
		** extraData – optional additional binary data, returned as a Base64-encoded string
		** Any of these fields may be omitted if they were not included when the Gzip file was created.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFilePath AS Character, toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetGZipInfo(m.tcFilePath, m.loChilkatJsonObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getgzipinfobd		&& Introduced in version 11.5.0. Retrieves metadata stored in Gzip data contained within a BinData object and returns the information in a JsonObject.
		*==============================================================================
		* Method:            GetGZipInfoBd
		* Purpose:           Retrieves metadata stored in Gzip data contained within a 
		*                    BinData object and returns the information in a JsonObject.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFilePath -- the path to the file.
		*                    toChilkatJsonObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/02/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Retrieves metadata stored in Gzip data contained within a BinData object 
		** and returns the information in a JsonObject.
		** 
		** 
		** The metadata is returned using the same JSON structure:
		** 
		** {
		**   "extraData": "AAECAw==",
		**   "filename": "example.txt",
		**   "comment": "This is the comment"
		** }
		** 
		** filename – the original filename embedded in the Gzip data (if present)
		** comment – an optional descriptive comment (if present)
		** extraData – optional additional binary data, returned as a Base64-encoded string
		** Any of these fields may be omitted if they were not included when the Gzip data was created.** 
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetGZipInfoBd(m.loChilkatBinData, ;
		        m.loChilkatJsonObject) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_access		&& Access method used to retrieve the Chilkat GZip HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat GZip HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.HeartbeatMs
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** The number of milliseconds between each AbortCheck event callback. 
		** The AbortCheck callback allows an application 
		** to abort any method call prior to completion. 
		** If HeartbeatMs is 0 (the default), no AbortCheck event callbacks will fire.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE heartbeatms_assign		&& Assign method used to hold a reference to the HeartbeatMs property.
		*==============================================================================
		* Method:            HeartbeatMs_Assign
		* Purpose:           Assign method used to hold a reference to the HeartbeatMs property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the HeartbeatMs property.
		* Returns:           
		* Date Added:        05/05/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [HeartbeatMs]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE inflatestringenc		&& This the reverse of DeflateStringENC. The input string is first decoded according to inputEncoding. (Possible values for inputEncoding are "hex", "base64", "url", and "quoted-printable".)
		*==============================================================================
		* Method:            InflateStringEnc
		* Purpose:           This the reverse of DeflateStringENC.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string name to compress
		*                    tcConvertFromCharset -- the string charset
		*                    tcInputEncoding -- the encoding of the returned string
		* Returns:           Character
		* Date Added:        05/05/2022
		*==============================================================================
		
		**
		** This the reverse of DeflateStringENC.
		** 
		** The input string is first decoded according to inputEncoding. 
		** (Possible values for inputEncoding are "hex", "base64", "url", and "quoted-printable".) 
		** The compressed data is then inflated, and the result 
		** is then converted from convertFromCharset (if necessary) to return a string.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcString AS Character, ;
		tcConvertFromCharset AS Character, tcInputEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GZIP_COM_CALL, lcErrorMessage AS Character, ;
		liStackLevel AS Integer, lcMethod AS Character, loException AS Exception, ;
		lcPEMType AS Character, lcSecondParameter AS Character, lcDecodedString AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcPEMType, ;
		m.lcDecodedString, m.lcSecondParameter, m.la_Stack
		STORE NULL TO m.loChilkatObject, m.loException
		
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcDecodedString = ;
		      m.loChilkatObject.InflateStringEnc(m.tcString, m.tcConvertFromCharset, m.tcInputEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcDecodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GZIP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE isgzip		&& Introduced in version 11.0.0. Checks if the data in bd is in Gzip format. Returns 1 if it is, otherwise returns 0.
		*==============================================================================
		* Method:            IsGZip
