DEFINE CLASS authazuread AS ibasechilkat OF "chilkatvfp.vcx" 		&& Provides functionality for obtaining an Azure AD access token via OAuth2 for Service to Service Calls Using Client Credentials. (See https://msdn.microsoft.com/en-us/library/dn645543.aspx) Decremented in version 10.1.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: accesstoken_access		&& Access method used to retrieve the Chilkat AuthAzureAD AccessToken property.
		*m: accesstoken_assign		&& Assign method used to hold a reference to the AccessToken property.
		*m: clientid_access		&& Access method used to retrieve the Chilkat AuthAzureAD ClientID property.
		*m: clientid_assign		&& Assign method used to hold a reference to the ClientID property.
		*m: clientsecret_access		&& Access method used to retrieve the Chilkat AuthAzureAD ClientSecret property.
		*m: clientsecret_assign		&& Assign method used to hold a reference to the ClientSecret property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat AuthAzureAD DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat AuthAzureAD LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat AuthAzureAD LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat AuthAzureAD LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat AuthAzureAD LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat AuthAzureAD LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat AuthAzureAD LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat AuthAzureAD LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: numsecondsremaining_access		&& Access method used to retrieve the Chilkat AuthAzureAD NumSecondsRemaining property.
		*m: numsecondsremaining_assign		&& Assign method used to hold a reference to the NumSecondsRemaining property
		*m: obtainaccesstoken		&& Introduced in version 9.5.0.58. Sends the HTTP request to fetch the access token. When this method completes successfully, the access token is available in the AccessToken property. The connection is an existing connection to login.microsoftonline.com.
		*m: obtainaccesstokenasync		&& Introduced in version 9.5.0.58. Creates an asynchronous task to call the ObtainAccessToken method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*m: resource_access		&& Access method used to retrieve the Chilkat AuthAzureAD Resource property.
		*m: resource_assign		&& Assign method used to hold a reference to the Resource property
		*m: tenantid_access		&& Access method used to retrieve the Chilkat AuthAzureAD TenantID property.
		*m: tenantid_assign		&& Assign method used to hold a reference to the TenantID property
		*m: valid_access		&& Access method used to retrieve the Chilkat AuthAzureAD Valid property.
		*m: valid_assign		&& Assign method used to hold a reference to the Valid property
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat AuthAzureAD VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property
		*p: accesstoken		&& Introduced in version 9.5.0.58. The access token to be used in Azure AD REST API requests. This property is set on a successful call to ObtainAccessToken.
		*p: clientid		&& Introduced in version 9.5.0.58. Specifies the Azure AD client id of the calling web service.
		*p: clientsecret		&& Introduced in version 9.5.0.58. A key registered for the calling web service in Azure AD. To create a key, in the Azure Management Portal, click Active Directory, click the directory, click the application, and then click Configure.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult propert
		*p: numsecondsremaining		&& Introduced in version 9.5.0.58. If the access token is valid, contains the number of seconds remaining until it expires. A value of 0 indicates an invalid or expired access token.
		*p: resource		&& Introduced in version 9.5.0.58. The App ID URI of the receiving web service. To find the App ID URI, in the Azure Management Portal, click Active Directory, click the directory, click the application, and then click Configure.
		*p: tenantid		&& Introduced in version 9.5.0.58. Your Azure account tenant ID. (If you don't know what it is, Google "how to find my azure tenant id" for help.)
		*p: valid		&& Introduced in version 9.5.0.58. 1 if the AccessToken property contains a valid non-expired access token obtained via the call to ObtainAccessToken.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		accesstoken = 
		cchilkatclass = AuthAzureAD
		ceventhandlerclass = iBaseEventHandler
		clientid = 
		clientsecret = 
		debuglogfilepath = 
		iinstancepatch = 58
		iretirementmajor = 11
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "authazuread"
		numsecondsremaining = 0
		resource = 
		tenantid = 
		valid = 0
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE accesstoken_access		&& Access method used to retrieve the Chilkat AuthAzureAD AccessToken property.
