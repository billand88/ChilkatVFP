		liIntroducedInBuild = 91
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.XTSSetEncodedTweakKey(m.tcTweakKey, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE xtssetencodedtweakvalue		&& Introduced in version 9.5.0.91. Sets the XTS-AES mode tweak value from an encoded string. The encoding argument can be set to any of the following strings: "base64", "hex", "quoted-printable", "ascii", or "url".
		*==============================================================================
		* Method:            XTSSetEncodedTweakValue
		* Purpose:           Sets the XTS-AES mode tweak value from an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTweakValue -- the tweak value to set.
		*                    tcEncoding -- the key encoding.
		* Returns:           
		* Date Added:        07/01/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.91
		**
		** Sets the XTS-AES mode tweak value from an encoded string. 
		** The encoding argument can be set to any of the following strings: 
		** "base64", "hex", "quoted-printable", "ascii", or "url".
		**
		** The tweak value must be 16 bytes in length. 
		** An application can set the initial tweak value by calling this method, 
		** or by calling XtsSetDataUnitNumber (but not both).
		** 
		
		LPARAMETERS tcTweakValue AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, loException AS Exception, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical
		
