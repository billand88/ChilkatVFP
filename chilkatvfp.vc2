	PROCEDURE setpg		&& Sets explicit values for P and G. Returns 1 if P and G conform to the requirements for Diffie-Hellman. P is an SSH1-format bignum passed as a hexidecimalized string. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetPG
		* Purpose:           Sets explicit values for P and G.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiP, the prime number.
		*                    tiG, a generator number.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Sets explicit values for P and G. Returns 1 if P and G conform 
		** to the requirements for Diffie-Hellman. P is an SSH1-format bignum passed 
		** as a hexidecimalized string.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiP AS Integer, tiG AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_DH_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetPG(m.tiP, m.tiG) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE unlockcomponent		&& Undocumented method! Appears related to Chilkat licensing.
		*==============================================================================
		* Method:            UnlockComponent
		* Purpose:           Undocumented function! Appears related to Chilkat licensing.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUnlockSetting, the unlock setting.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Undocumented function! Appears related to Chilkat licensing.
		**
		** Unlocks the component. This must be called once at the beginning of your program. 
		** It is very fast and has negligible overhead. An arbitrary string, 
		** such as "Hello World" may be passed to automatically begin a
		** fully-functional 30-day trial.
		**
		** Version 11.0.0: Method removed.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUnlockSetting AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DH_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockComponent(m.tcUnlockSetting) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE useknownprime		&& Sets P and G to a known safe prime.
		*==============================================================================
		* Method:            UseKnownPrime
		* Purpose:           Sets P and G to a known safe prime.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the values as indicated in the description below.
		* Returns:           
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Sets P and G to a known safe prime. The index may have the following values:
		** 
		**   1: First Oakley Default Group from RFC2409, section 6.1. Generator is 2. 
		**      The prime is: 2^768 - 2 ^704 - 1 + 2^64 * { [2^638 pi] + 149686 }
		**
		**   2: Prime for 2nd Oakley Group (RFC 2409) -- 1024-bit MODP Group. 
		**      Generator is 2. The prime is: 2^1024 - 2^960 - 1 + 2^64 * { [2^894 pi] + 129093 }.
		**
		**   3: 1536-bit MODP Group from RFC3526, Section 2. Generator is 2. 
		**      The prime is: 2^1536 - 2^1472 - 1 + 2^64 * { [2^1406 pi] + 741804 }
		**
		**   4: Prime for 14th Oakley Group (RFC 3526) -- 2048-bit MODP Group. 
		**      Generator is 2. The prime is: 2^2048 - 2^1984 - 1 + 2^64 * { [2^1918 pi] + 124476 }
		**
		**   5: 3072-bit MODP Group from RFC3526, Section 4. Generator is 2. 
		**      The prime is: 2^3072 - 2^3008 - 1 + 2^64 * { [2^2942 pi] + 1690314 }
		**
		**   6: 4096-bit MODP Group from RFC3526, Section 5. Generator is 2. 
		**      The prime is: 2^4096 - 2^4032 - 1 + 2^64 * { [2^3966 pi] + 240904 }
		**
		**   7: 6144-bit MODP Group from RFC3526, Section 6. Generator is 2. 
		**      The prime is: 2^6144 - 2^6080 - 1 + 2^64 * { [2^6014 pi] + 929484 }
		**
		**   8: 8192-bit MODP Group from RFC3526, Section 7. Generator is 2. 
		**      The prime is: 2^8192 - 2^8128 - 1 + 2^64 * { [2^8062 pi] + 4743158 }
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_DH_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.UseKnownPrime(m.tiIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat DH VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        07/23/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        07/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS dirtree AS ibasechilkat OF "chilkatvfp.vcx" 		&& API for iterating over the files and sub-directories in a directory tree. The intent of this class is to provide a simplified, non-recursive way to iterate over an entire directory tree.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: advanceposition		&& Advances the current position in the directory tree traversal to the next file or sub-directory. Important: If AdvancePosition returns 0, it can be an error, or it could be that there are no more files and directories.
		*m: basedir_access		&& Access method used to retrieve the Chilkat DirTree BaseDir property.
		*m: basedir_assign		&& Assign method used to hold a reference to the BaseDir property.
		*m: beginiterate		&& Begins a directory tree traversal. After calling this method, the various property values such as Fullpath, FileSize32, etc. can be retrieved for the 1st file / sub-directory in the traversal.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat DirTree DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: doneiterating_access		&& Access method used to retrieve the Chilkat DirTree DoneIterating property.
		*m: doneiterating_assign		&& Assign method used to hold a reference to the DoneIterating property.
		*m: filesize32_access		&& Access method used to retrieve the Chilkat DirTree FileSize32 property.
		*m: filesize32_assign		&& Assign method used to hold a reference to the FileSize32 property.
		*m: filesizestr_access		&& Access method used to retrieve the Chilkat DirTree FileSizeStr property.
		*m: filesizestr_assign		&& Assign method used to hold a reference to the FileSizeStr property.
		*m: fullpath_access		&& Access method used to retrieve the Chilkat DirTree FullPath property.
		*m: fullpath_assign		&& Assign method used to hold a reference to the FullPath property.
		*m: fulluncpath_access		&& Access method used to retrieve the Chilkat DirTree FullUNCPath property.
		*m: fulluncpath_assign		&& Assign method used to hold a reference to the FullUNCPath property.
		*m: isdirectory_access		&& Access method used to retrieve the Chilkat DirTree IsDirectory property.
		*m: isdirectory_assign		&& Assign method used to hold a reference to the IsDirectory property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat DirTree LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat DirTree LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat DirTree LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat DirTree LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat DirTree LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat DirTree LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat DirTree LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: recurse_access		&& Access method used to retrieve the Chilkat DirTree Recurse property.
		*m: recurse_assign		&& Assign method used to hold a reference to the Recurse property.
		*m: relativepath_access		&& Access method used to retrieve the Chilkat DirTree RelativePath property.
		*m: relativepath_assign		&& Assign method used to hold a reference to the RelativePath property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat DirTree UnCommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UnCommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat DirTree VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: basedir		&& Begin iterating from this directory.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: doneiterating		&& Set to 1 when the last file or sub-directory has been iterated.
		*p: filesize32		&& The file size of the current file in the iteration. (0 if it is a directory.)
		*p: filesizestr		&& Introduced in version 9.5.0.88. The file size of the current file in the iteration as a decimal string. (0 if it is a directory.)
		*p: fullpath		&& The absolute directory path of the current file or sub-directory.
		*p: fulluncpath		&& The absolute UNC directory path of the current file or sub-directory.
		*p: isdirectory		&& 1 if the current position is a sub-directory, 0 if it is a file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: recurse		&& If 1, the iteration will be recursive. If 0 the iteration is non-recursive. The default value is 1.
		*p: relativepath		&& The relative directory path of the current file or sub-directory. (Relative to the BaseDir)
		*p: uncommonoptions		&& Introduced in version 11.1.0. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		basedir = 
		cchilkatclass = DirTree
		debuglogfilepath = 
		doneiterating = 0
		filesize32 = 0
		filesizestr = 
		fullpath = 
		fulluncpath = 
		isdirectory = 0
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "dirtree"
		recurse = 1
		relativepath = 
		uncommonoptions = 
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE advanceposition		&& Advances the current position in the directory tree traversal to the next file or sub-directory. Important: If AdvancePosition returns 0, it can be an error, or it could be that there are no more files and directories.
		*==============================================================================
		* Method:            AdvancePosition
		* Purpose:           Advances the current position in the directory tree 
		*                    traversal to the next file or sub-directory.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Advances the current position in the directory tree traversal 
		** to the next file or sub-directory.
		**
		** Important: If AdvancePosition returns 0, it can be an error, 
		** or it could be that there are no more files and directories. 
		** To distinguish between the two cases, examine the DoneIterating property. 
		** If DoneIterating is 1, then the 0 return value is not an error, 
		** but instead indicates that the end has been reached.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_DIRTREE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.AdvancePosition() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DIRTREE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE basedir_access		&& Access method used to retrieve the Chilkat DirTree BaseDir property.
		*==============================================================================
		* Method:            BaseDir_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DirTree BaseDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BaseDir
		* Date Added:        07/23/2022
		*==============================================================================
		
		** 
		** Begin iterating from this directory.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE basedir_assign		&& Assign method used to hold a reference to the BaseDir property.
		*==============================================================================
		* Method:            BaseDir_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat DirTree BaseDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the BaseDir property.
		* Returns:           
		* Date Added:        07/23/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE beginiterate		&& Begins a directory tree traversal. After calling this method, the various property values such as Fullpath, FileSize32, etc. can be retrieved for the 1st file / sub-directory in the traversal.
		*==============================================================================
		* Method:            BeginIterate
		* Purpose:           Begins a directory tree traversal.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Begins a directory tree traversal. After calling this method, 
		** the various property values such as Fullpath, FileSize32, etc. 
		** can be retrieved for the 1st file / sub-directory in the traversal.
		** 
		** Important: If BeginIterate returns 0, it can be an error, 
		** or it could be that there are 0 files and directories. 
		** To distinguish between the two cases, examine the DoneIterating property. 
		** If DoneIterating is 1, then the 0 return value is not an error, 
		** but instead indicates 0 files/directories.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LOCAL loChilkatObject AS CHILKAT_DIRTREE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.BeginIterate() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DIRTREE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/05/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.1.0
		
		  Added the UncommonOptions property.
		
		** Version 78
		
		  Fixed internal problem mainly involving emoji chars.
		  The actual problem had to do with internal utf-8 to utf-16 conversion 
		  when surrogate pairs are present
		  (and emoji chars are the typical chars where surrogate pairs occur).
		
		** Version 76
		
		  Rewritten internally to avoid all recursion
		  (so there is never a chance of the stack being blown).
		
		** Version 65
		
		  ActiveX LastStringResultLen property incorrectly returned the size of the string in bytes (utf-16)
		  rather than in number of characters. This is fixed to return the number of characters.
		  (Note: this is a property that only exists in ActiveX classes, and is only useful
		  for certain programming languages such as SQL Server to help programs determine
		  if temp tables are required.)
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat DirTree DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DirTree DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/23/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat DirTree DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        07/23/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE doneiterating_access		&& Access method used to retrieve the Chilkat DirTree DoneIterating property.
		*==============================================================================
		* Method:            DoneIterating_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DirTree DoneIterating property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DoneIterating
		* Date Added:        07/23/2022
		*==============================================================================
		
		**
		** Set to 1 when the last file or sub-directory has been iterated.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE doneiterating_assign		&& Assign method used to hold a reference to the DoneIterating property.
		*==============================================================================
		* Method:            DoneIterating_Assign
		* Purpose:           Assign method used to hold a reference to the DoneIterating property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the DoneIterating property.
		* Returns:           
