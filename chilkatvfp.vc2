	PROCEDURE s3_uploadbd		&& The same as S3_UploadFile, except the contents of the file come from bd instead of a local file. Note: x-amz-* headers, including metadata, can be added to any S3 request by adding each header with a call to SetRequestHeader.
		*==============================================================================
		* Method:            S3_UploadBd
		* Purpose:           The same as S3_UploadFile, except the contents 
		*                    of the file come from bd instead of a local file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData -- the Chilkat Binary Data object.
		*                    tcContentType -- the content type of the binary data
		*                    tcBucketPath -- the path to the Amazon bucket
		*                    tcObjectName -- the object within the bucket path to append to.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.76
		**
		** The same as S3_UploadFile, except the contents of the file come from bd instead of a local file.
		** Note: x-amz-* headers, including metadata, can be added to any S3 request 
		** by adding each header with a call to SetRequestHeader. 
		** This applies to all S3 methods, even if not explicitly stated.
		**
		** Note: If the bucket is in a region different than us-east-1, 
		** makes sure to set the AwsEndpoint property to the correct region, such as "eu-central-1". 
		** Also, if using an S3 compatible service such as Wasabi, always set the AwsEndpoint property. 
		** For example: "s3.wasabisys.com", "s3.eu-central-1.wasabisys.com".
		**
		** Fixed in Version 90: Fixed problems when “:” chars are used in bucket names.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		tcContentType AS Character, tcBucketPath AS Character, tcObjectName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 76
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.S3_UploadBd(m.loChilkatBinData, ;
		        m.tcContentType, m.tcBucketPath, m.tcObjectName) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

