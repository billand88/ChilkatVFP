		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BZ2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE compressmemory		&& Compresses in-memory data to an in-memory image of a .bz2 file. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
		* Method:            CompressMemory
		* Purpose:           Compresses in-memory data to an in-memory image of a .bz2 file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqByteData, the byte data to compress.
		* Returns:           Binary in-memory Bz2 image.
		* Date Added:        07/29/2022
		*==============================================================================
		
		**
		** Compresses in-memory data to an in-memory image of a .bz2 file.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tqByteData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_BZ2_COM_CALL, ;
		loException AS Exception, lqBz2Image AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqBz2Image
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqBz2Image = m.loChilkatObject.CompressMemory(m.tqByteData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqBz2Image
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_BZ2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

