	PROCEDURE entryat		&& Introduced in version 11.0.0. Returns the entry at index in entry. The 1st entry is at index 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            EntryAt
		* Purpose:           Returns the entry at index in entry. The 1st entry is at index 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the zip entry index to return.
		*                    toChilkatZipEntry -- the Chilkat Zip Entry object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Returns the entry at index in entry. The 1st entry is at index 0.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiIndex AS Integer, toChilkatZipEntry AS CHILKAT_ZIPENTRY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_ZIP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterZipEntry AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatZipEntry AS CHILKAT_ZIPENTRY_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterZipEntry, m.loChilkatZipEntry
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterZipEntry = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatZipEntry)
		
		      loChilkatZipEntry = m.loParkParameterZipEntry.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.EntryAt(m.tiIndex, ;
		        m.loChilkatZipEntry) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatZipEntry = ;
		      m.loParkParameterZipEntry.SetObject(m.toChilkatZipEntry, m.loChilkatZipEntry)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterZipEntry, m.loChilkatZipEntry
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
