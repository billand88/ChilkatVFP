	HIDDEN PROCEDURE textflag_access		&& Access method used to retrieve the Chilkat ZIPEntry TextFlag property.
		*==============================================================================
		* Method:            TextFlag_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ZIPEntry TextFlag property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        
		* Returns:           THIS.TextFlag
		* Date Added:        05/02/2022
		*==============================================================================
		
		**
		** Controls whether the "text flag" of the internal file attributes 
		** for this entry within the zip is set. 
		** This is a bit flag that indicates whether the file contents are text or binary. 
		** It is for informational use 
		** and it is not imperative that this bit flag is accurately set. 
		** The ability to set this bit flag is only provided 
		** to satisfy certain cases where another application might be sensitive to the flag.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE textflag_assign		&& Assign method used to hold a reference to the TextFlag property.
		*==============================================================================
		* Method:            TextFlag_Assign
		* Purpose:           Assign method used to hold a reference to the TextFlag property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the TextFlag property.
		* Returns:           
		* Date Added:        05/02/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

