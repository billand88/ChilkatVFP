	HIDDEN PROCEDURE autosyst_access		&& Access method used to retrieve the Chilkat AutoSyst property.
		*==============================================================================
		* Method:            AutoSyst_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 AutoSyst property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoSyst
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** When 1 (which is the default value), a "SYST" command is automatically 
		** sent to the FTP server immediately after connecting. 
		** This allows the Chilkat FTP2 component to know more about the server 
		** and automatically adjust any applicable internal settings based on the response. 
		** If the SYST command causes trouble (which is rare), 
		** this behavior can be turned off by setting this property equal to 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autosyst_assign		&& Assign method used to hold a reference to the AutoSyst property.
		*==============================================================================
		* Method:            AutoSyst_Assign
		* Purpose:           Assign method used to hold a reference to the AutoSyst property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoSyst property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE autoxcrc_access		&& Access method used to retrieve the Chilkat AutoXCRC property.
		*==============================================================================
		* Method:            AutoXCRC_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 AutoXCRC property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.AutoXCRC
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** Many FTP servers support the XCRC command. 
		** The Chilkat FTP component will automatically know if XCRC is supported 
		** because it automatically sends a FEAT command to the server immediately after connecting.
		**
		** If this property is set to 1, then all uploads will be automatically verified 
		** by sending an XCRC command immediately after the transfer completes. 
		** If the CRC is not verified, the upload method (such as PutFile) will return a failed status.
		**
		** To prevent XCRC checking, set this property to 0.
		**
		** Fixed for version 92: AutoXcrc would sometimes mistakenly indicate a CRC mismatch 
		** when no mismatch actually existed. Also, XCRC will not be attempted by Chilkat 
		** if the FTP server’s FEAT command indicates it is not supported.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE autoxcrc_assign		&& Assign method used to hold a reference to the AutoXCRC property.
		*==============================================================================
		* Method:            AutoXCRC_Assign
		* Purpose:           Assign method used to hold a reference to the AutoXCRC property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the AutoXCRC property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE bandwidththrottledown_access		&& Access method used to retrieve the Chilkat BandwidthThrottleDown property.
		*==============================================================================
		* Method:            BandwidthThrottleDown_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 BandwidthThrottleDown property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BandwidthThrottleDown
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** If set to a non-zero value, the FTP2 component 
		** will bandwidth throttle all downloads to this value.
		**
		** The default value of this property is 0. 
		** The value should be specified in bytes/second.
		** 
		** Note: It is difficult to throttle very small downloads. 
		** (For example, how do you bandwidth throttle a 1-byte download???) 
		** As the downloaded file size gets larger, 
		** the transfer rate will better approximate this property's setting.
		
		** Also note: When downloading, the FTP server has no knowledge of the client's desire 
		** for throttling, and is always sending data as fast as possible. 
		** (There's nothing in the FTP protocol to request throttling.) 
		** Therefore, any throttling for a download on the client side 
		** is simply to allow system socket buffers 
		** (outgoing buffers on the sender, and incoming buffers on the client) 
		** to fill to 100% capacity, and this also poses the threat of causing 
		** a data connection to become broken. 
		** It's probably not worthwhile to attempt to throttle downloads. 
		** It may have been better that this property never existed.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE bandwidththrottledown_assign		&& Assign method used to hold a reference to the BandwidthThrottleDown property.
		*==============================================================================
		* Method:            BandwidthThrottleDown_Assign
		* Purpose:           Assign method used to hold a reference to the BandwidthThrottleDown property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the BandwidthThrottleDown property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

