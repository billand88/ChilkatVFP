		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT([Chilkat.JsonObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE responsestatuscode_access		&& Access method used to retrieve the Chilkat AI ResponseStatusCode property.
		*==============================================================================
		* Method:            ResponseStatusCode_Access
		* Purpose:           Access method used to retrieve 
		*                    the ResponseStatusCode property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ResponseStatusCode
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** Introduced in version 11.2.0.
		** 
		** The HTTP response status code for the last Ask is as follows:
		** 
		** 0 indicates an error occurred before receiving an HTTP response.
		** 200 indicates a successful response.
		** A failed response has a status code of 400 or higher.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE responsestatuscode_assign		&& Assign method used to hold a reference to the ResponseStatusCode property.
		*==============================================================================
		* Method:            ResponseStatusCode_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the ResponseStatusCode property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ResponseStatusCode property.
		* Returns:           
		* Date Added:        11/03/2025
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE selectedconvo_access		&& Access method used to retrieve the Chilkat AI SelectConvo property.
		*==============================================================================
		* Method:            SelectedConvo_Access
		* Purpose:           Access method used to retrieve the Chilkat AI SelectedConvo property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SelectedConvo
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** Introduced in version 11.2.0
		** 
		** The currently selected conversation can be set to your desired conversation name. 
		** Once set, all future queries will be part of that conversation, 
		** updating its state with each input and output. By default, 
		** no conversation is selected, indicated by an empty string, 
		** leading to stateless queries. The first conversation created or imported 
		** will be automatically selected. If you attempt to select a non-existent conversation, 
		** the selection will not change. You can reset this property to an empty string 
		** to revert to stateless querying.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE selectedconvo_assign		&& Assign method used to hold a reference to the SelectedConvo property.
		*==============================================================================
		* Method:            SelectedConvo_Assign
		* Purpose:           Assign method used to hold the Chilkat AI SelectedConvo property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold a reference to the SelectedConvo property.
		* Returns:           
		* Date Added:        11/03/2025
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE setaskparams		&& Introduced in version 11.3.0. Sets additional Ask params such as temperature, effort, and max_output_tokens. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetAskParams
		* Purpose:           Sets additional Ask params.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSON, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        12/15/2025
		*==============================================================================
		
		**
		** Introduced in version 11.3.0.
		**
		** Sets additional Ask params such as:
		** 
		** effort (see below)
		** 
		** max_output_tokens (see below)
		** 
		** max_tool_iterations - v11.4.0 Applies only to automatic JavaScript tool function calls. 
		** Sets a maximum number of AI model tool responses that can be received. 
		** The default is 5. This is to prevent an unlikely and unexpected infinite cycle 
		** of AI model tool responses and automatic tool calling.
		**
		** temperature (see below)
		**
		** verbose_ai_logging- v11.4.0 Adds even more detailed logging to the LastErrorText, 
		** more than what is added when the VerboseLogging property is enabled.
		**
		** web_search - v11.6.0 A JSON object that enables provider-hosted web search 
		** (also called "grounding") so the model can retrieve live results 
		** and answer with citations. See below.
		** 
		** Fixed in version 11.4.0: Chilkat was sending the temperature as a JSON string 
		** instead of a decimal value, but only for OpenAI's Responses API. 
		** This caused a 400 error response. This was fixed.
		**
		** Note: See documentation for more extensive details.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatJSON AS [Chilkat.JSONObject]
		
		LOCAL loChilkatObject AS [Chilkat.Ai], loException AS Exception, ;
		llImplemented AS Logical, loParkParameterJSON AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJSON AS [Chilkat.JSONObject], liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSON, m.loChilkatJSON
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 3, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSON = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.oChilkatJSON)
		
		      loChilkatJSON = m.loParkParameterJSON.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetAskParams(m.loChilkatJSON) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJSON = ;
		      m.loParkParameterJSON.SetObject(m.oChilkatJSON, m.loChilkatJSON)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSON, m.loChilkatJSON
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Ai])
		  toChilkatJSON = NEWOBJECT([Chilkat.JSONObject])
		  loParkParameterJSON = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJSON = NEWOBJECT([Chilkat.JSONObject])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

