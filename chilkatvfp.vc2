	PROCEDURE crcfile		&& Introduced in version 9.5.0.38. Calculates a CRC for the contents of a file. To compute the CRC used in the Zip file format, pass "CRC-32" for the crcAlg.
		*==============================================================================
		* Method:            CRCFile
		* Purpose:           Calculates a CRC for the contents of a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCRCAlgorithm -- the CRC algorithm
		*                    tcFilePath -- the path to the file containing CRC content.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.38
		**
		** Calculates a CRC for the contents of a file. 
		** To compute the CRC used in the Zip file format, pass "CRC-32" for the crcAlg. 
		** (The crcAlg argument provides the flexibility to add additional CRC algorithms 
		** on an as-needed basis in the future.) 
		** A value of 0 is returned if the file is unable to be read. 
		** Given that there is a 1 in 4 billion chance of having an actual CRC of 0, 
		** an application might choose to react to a 0 return value 
		** by testing to see if the file can be opened and read.
		** 
		** Starting in v9.5.0.88, crc8 can be computed by passing "CRC8" in crcAlg.
		** 
		
		LPARAMETERS tcCRCAlgorithm AS Character, tcFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 38
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.CRCFile(m.tcCRCAlgorithm, m.tcFilePath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

