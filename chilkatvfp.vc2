		*==============================================================================
		
		**
		** Returns the bytes of the Signature property as a hex or base64 encoded string. 
		** The encoding should be set to either "hex" or "base64". 
		** The Signature property is set when SignHash is called.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, lcEncodedSignature AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedSignature = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcEncodedSignature = m.loChilkatObject.GetEncodedSignature(m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedSignature
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE groupsize_access		&& Access method used to retrieve the Chilkat DSA GroupSize property.
		*==============================================================================
		* Method:            GroupSize_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat DtObj GroupSize property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.GroupSize
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** The group size (in bits) to be used in DSA key generation. 
		** The default value is 160 and corresponds to the fact that SHA-1 is used in signature generation. 
		** This property setting should not be changed. 
		** It exists for future expansion when additional underlying hash algorithms are supported.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE groupsize_assign		&& Assign method used to hold a reference to the GroupSize property.
		*==============================================================================
