		RETURN
	ENDPROC

	PROCEDURE findmatch		&& Introduced in version 11.1.0. This string table object holds strings with wildcards. The method returns the index of the wildcarded string that matches the text in sb, or -1 if no match is found.
		*==============================================================================
		* Method:            FindMatch
		* Purpose:           The method returns the index of the wildcarded string 
		*                    that matches the text in sb.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder -- a Chilkat StringBuilder object.
		*                    tuCaseSensitive -- whether or not a case sensitive search is performed.
		* Returns:           Returns the number of matches, or -1 for failure.
		* Date Added:        08/01/2025
		*==============================================================================
		
		**
		** Introduced in version 11.1.0.
		**
		** This string table object holds strings with wildcards. 
		** The method returns the index of the wildcarded string that matches the text in sb, 
		** or -1 if no match is found. caseSensitive specifies 
		** whether the matching should be case-sensitive.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGTABLE_COM_CALL, loException AS Exception, ;
		liMatches AS Integer, loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loParkParameterStringBuilderWord AS [iParkParameter OF ChilkatVFP.VCX], ;
		llImplemented AS Logical, liCaptureEmailAddress AS Integer
		
		STORE 0 TO m.liMatches, m.liCaptureEmailAddress
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCaptureEmailAddress = .LogicalToBit(m.tuCaseSensitive)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        liMatches = m.loChilkatObject.FindMatch(m.loChilkatStringBuilder, ;
		        m.liCaptureEmailAddress, m.loChilkatStringBuilderWord)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.liMatches
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_STRINGTABLE_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE findsubstring		&& Introduced in version 9.5.0.77. Return the index of the first string in the table containing substr. Begins searching strings starting at startIndex. If caseSensitive is 1, then the search is case sensitive.
		*==============================================================================
		* Method:            FindSubstring
		* Purpose:           Return the index of the first string in the table containing substr.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiStartIndex, the starting index value.
		*                    tcSubString, the substring to search.
		*                    tuCaseSensitive, whether or not the search is case sensitive.
		* Returns:           Returns the index of the first string
		* Date Added:        06/21/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Return the index of the first string in the table containing substr. 
		** Begins searching strings starting at startIndex. 
		** If caseSensitive is 1, then the search is case sensitive. 
		** If caseSensitive is 0 then the search is case insensitive. 
		** Returns -1 if the substr is not found.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiStartIndex AS Integer, ;
		tcSubString AS Character, tuCaseSensitive AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_STRINGTABLE_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liIndex AS Integer, ;
