	PROCEDURE transfermail		&& Downloads and removes all email from a POP3 server. A bundle containing the emails is returned. A null reference is returned on failure. Returns Nothing on failure
		*==============================================================================
		* Method:            TransferMail
		* Purpose:           Downloads and removes all email from a POP3 server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Email Bundle Object, or NULL
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Downloads and removes all email from a POP3 server. 
		** A bundle containing the emails is returned. A null reference is returned on failure.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmailBundle
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatEmailBundle = m.loChilkatObject.TransferMail()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmailBundle
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

