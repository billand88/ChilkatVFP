		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.AddExternalFileRef(m.tcURI, ;
		        m.tcFilePath, m.tcDigestMethod, m.tcReferenceType) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIGGEN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addexternaltextref		&& Introduced in version 9.5.0.69. Specifies an external non-XML text data Reference to be added to the Signature when generated. The uri is the value of the URI attribute of the Reference.
		*==============================================================================
		* Method:            AddExternalTextRef
		* Purpose:           Specifies an external non-XML text data Reference 
		*                    to be added to the Signature when generated.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURI -- the URI attribute of the reference.
		*                    toChilkatStringBuilder -- a Chilkat String Builder object.
		*                    tcCharset -- the charset of the string data.
		*                    tuIncludeBOM -- whether or not to include the Byte Order Mark.
		*                    tcDigestMethod -- the digest method.
		*                    tcReferenceType -- the reference type (optional).
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Specifies an external non-XML text data Reference to be added to the Signature when generated.
		** 
		** The uri is the value of the URI attribute of the Reference.
		** 
		** The content contains the non-XML data to be digested according to the charset. 
		** The charset specifies the charset (such as "utf-8", "windows-1252", etc.) 
		** for the byte reprsentation of the text to be digested. 
		** The includeBom indicates whether the BOM (Byte Order Mark, also known as the preamble) 
		** is included in the byte representation that is digested.
		** 
		** The digestMethod is the digest method and can be one of the following: 
		** "sha1", "sha256", "sha384", "sha512", "ripemd160", or "md5".
		** 
		** The refType is optional and is usually not needed. 
		** Set this to the empty string unless it is desired to add a Type attribute 
		** to the Reference that is advisory only.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURI AS Character, toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tcCharset AS Character, tuIncludeBOM AS Unknown, ;
		tcDigestMethod AS Character, tcReferenceType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIGGEN_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		luReturn AS Unknown, liIncludeBOM AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIncludeBOM, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeBOM = .LogicalToBit(m.tuIncludeBOM)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddExternalTextRef(m.tcURI, m.loChilkatStringBuilder, ;
		        m.tcCharset, m.liIncludeBOM, m.tcDigestMethod, m.tcReferenceType) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIGGEN_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addexternalxmlref		&& Introduced in version 9.5.0.69. Specifies an external XML Reference to be added to the Signature when generated. The uri is the value of the URI attribute of the Reference. The content contains the XML document to be referenced.
		*==============================================================================
		* Method:            AddExternalXMLRef
		* Purpose:           Specifies an external XML Reference to be added 
		*                    to the Signature when generated.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcURI -- the URI attribute of the reference.
		*                    toChilkatStringBuilder -- a Chilkat String Builder object.
		*                    tcDigestMethod -- the digest method.
		*                    tcCanonicalMethod -- whether or not to include the Byte Order Mark.
		*                    tcReferenceType -- the reference type (optional).
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Specifies an external XML Reference to be added to the Signature when generated.
		** 
		** The uri is the value of the URI attribute of the Reference.
		** 
		** The content contains the XML document to be referenced.
		** 
		** The digestMethod is the digest method and can be one of the following: 
		** "sha1", "sha256", "sha384", "sha512", "ripemd160", or "md5".
		** 
		** The canonMethod is the canonicalization method, and can be one of the following.
		** 
		**   "C14N" -- for Inclusive Canonical XML (without comments)
		**   "C14N_11" -- for Inclusive Canonical XML 1.1 (without comments)
		**   "EXCL_C14N" -- for Exclusive Canonical XML (without comments)
		**   "C14N_WithComments" -- for Inclusive Canonical XML (with comments)
		**   "C14N_11_WithComments" -- for Inclusive Canonical XML 1.1 (with comments)
		**   "EXCL_C14N_WithComments" -- for Exclusive Canonical XML (with comments)
		**   "" -- An empty string indicates that no transformation should be included / applied 
		**   for this reference.
		**   Note: The WithComments options are available in Chilkat v9.5.0.71 and later.
		**   Note: The empty-string canonMethod is available in Chilkat v9.5.0.75 and later.
		** 
		** The refType is optional and is usually not needed. 
		** Set this to the empty string unless it is desired to add a Type attribute 
		** to the Reference that is advisory only.
		**
		** Enhancement in version 75: Added the empty-string option for the canonMethod argument to 
		** this method. This makes it possible to add a reference with no transformations.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcURI AS Character, toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tcDigestMethod AS Character, tcCanonicalMethod AS Character, ;
		tcReferenceType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIGGEN_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddExternalXMLRef(m.tcURI, m.loChilkatStringBuilder, ;
		        m.tcDigestMethod, m.tcCanonicalMethod, m.tcReferenceType) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIGGEN_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE AddObject
		*==============================================================================
