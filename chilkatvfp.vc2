	PROCEDURE channelreceivedclose		&& 1 if a CLOSE message has been received on the channel indicated by channelNum. When a CLOSE is received, no subsequent data should be sent in either direction -- the channel is closed in both directions.
		*==============================================================================
		* Method:            ChannelReceivedClose
		* Purpose:           1 if a CLOSE message has been received 
		*                    on the channel indicated by channelNum.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** 1 if a CLOSE message has been received on the channel indicated by channelNum. 
		** When a CLOSE is received, no subsequent data should be sent 
		** in either direction -- the channel is closed in both directions.
		**
		
		LPARAMETERS tiChannel AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ChannelReceivedClose(m.tiChannel) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE channelreceivedeof		&& 1 if an EOF message has been received on the channel indicated by channelNum. When an EOF is received, no more data will be forthcoming on the channel. However, data may still be sent in the opposite direction.
		*==============================================================================
		* Method:            ChannelReceivedEOF
		* Purpose:           1 if an EOF message has been received 
		*                    on the channel indicated by channelNum.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** 1 if an EOF message has been received on the channel indicated by channelNum. 
		** When an EOF is received, no more data will be forthcoming on the channel. 
		** However, data may still be sent in the opposite direction.
		**
		
		LPARAMETERS tiChannel AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.ChannelReceivedEOF(m.tiChannel) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
