	PROCEDURE decompressbytes		&& The opposite of CompressBytes. Returns a zero-length byte array (as a Variant) on failure. An empty array will have a UBound of -1 meaning 0 elements.
		*==============================================================================
		* Method:            DecompressBytes
		* Purpose:           The opposite of CompressBytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqCompressedData, the byte data to decompress.
		* Returns:           The original decompressed byte data.
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** The opposite of CompressBytes.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tqCompressedData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_COMPRESSION_COM_CALL, ;
		loException AS Exception, lqByteData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqByteData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqByteData = m.loChilkatObject.DecompressBytes(m.tqCompressedData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqByteData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_COMPRESSION_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

