	PROCEDURE verifyreferencedigest		&& Introduced in version 9.5.0.69. This method allows for an application to verify the digest for each reference separately.
		*==============================================================================
		* Method:            VerifyReferenceDigest
		* Purpose:           This method allows for an application to verify
		*                    the digest for each reference separately.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the external reference array value.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** This method allows for an application to verify the digest for each reference separately.
		** This can be helpful if the full XMLDSIG validation fails, 
		** then one can test each referenced data's digest to see which, if any, fail to match.
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.VerifyReferenceDigest(m.tiIndex) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE verifysignature		&& Introduced in version 9.5.0.69. Verifies the signature indicated by the Selector property. If verifyReferenceDigests is 1, then the digest of each Reference within the signature's SignedInfo is also validated. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            VerifySignature
		* Purpose:           This method allows for an application to verify
		*                    the digest for each reference separately.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuVerifyReferenceDigests, whether or not
		*                    to test each referenced data digest.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** This method allows for an application to verify the digest 
		** for each reference separately. This can be helpful if the full XMLDSIG validation fails, 
		** then one can test each referenced data's digest to see which, if any, fail to match.
		**
		
		LPARAMETERS tuVerifyReferenceDigests AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liVerifyReferenceDigests AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liVerifyReferenceDigests, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liVerifyReferenceDigests = .LogicalToBit(m.tuVerifyReferenceDigests)
		
		      TRY
		
		        STORE m.loChilkatObject.VerifySignature(m.liVerifyReferenceDigests) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE withcomments_access		&& Access method used to retrieve the Chilkat XMLDSig WIthComments property.
		*==============================================================================
		* Method:            WithComments_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XMLDSig WithComments property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.WithComments
		* Date Added:        07/06/2022
		*==============================================================================
		
		** 
		** Undocumented property! 
		**
		** This could be related to the last parameter of the Canonicalize* methods.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		** PEM not removed from class test
		IF NOT THIS.IsPEMRemoved(11, 0, 0)
		
		  STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		  STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		  liStackLevel = ASTACKINFO(la_Stack)
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		  lcMethodToCall = [LongBit]
		
		  THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		  RETURN EVALUATE([THIS.] + m.lcProperty)
		
		ELSE
		
		  RETURN 0
		
		ENDIF NOT THIS.IsPEMRemoved(11, 0, 0)
		** PEM not removed from class test  
	ENDPROC

	HIDDEN PROCEDURE withcomments_assign		&& Assign method used to hold a reference to the WithComments property.
		*==============================================================================
		* Method:            WithComments_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the WithComments property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the WithComments property.
		* Returns:           
		* Date Added:        07/06/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 69
		
		WITH THIS
		
		  ** PEM not removed from class test
		  IF NOT .IsPEMRemoved(11, 0, 0)
		
		    lcValidationMethod = []
		    lcMethodToCall = [LongBit]
		
		    .CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		  ENDIF NOT .IsPEMRemoved(11, 0, 0)
		  ** End PEM not removed from class test
		
		ENDWITH
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS xmldsiggen AS ibasechilkat OF "chilkatvfp.vcx" 		&& An API for generating/creating XML Digital Signatures. Use the XmlDSig class for verifying XML Digital Signatures.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addenvelopedref		&& Introduced in version 9.5.0.69. Specifies an enveloped Reference to be added to the Signature when generated. An enveloped Reference is for data contained within the Signature.
		*m: addexternalbinaryref		&& Introduced in version 9.5.0.69. Specifies an external non-XML binary data Reference to be added to the Signature when generated. The uri is the value of the URI attribute of the Reference.
		*m: addexternalfileref		&& Introduced in version 9.5.0.69. Specifies an external file Reference to be added to the Signature when generated. The uri is the value of the URI attribute of the Reference.
		*m: addexternaltextref		&& Introduced in version 9.5.0.69. Specifies an external non-XML text data Reference to be added to the Signature when generated. The uri is the value of the URI attribute of the Reference.
		*m: addexternalxmlref		&& Introduced in version 9.5.0.69. Specifies an external XML Reference to be added to the Signature when generated. The uri is the value of the URI attribute of the Reference. The content contains the XML document to be referenced.
		*m: addobject2		&& Introduced in version 9.5.0.75. Specifies an Object to be added to the Signature. Note that the Chilkat method is AddObject but that collides with the VFP method by the same name.
		*m: addobjectref		&& Introduced in version 9.5.0.75. This is the same as the AddSameDocRef method, except the reference is to content within an Object previously added via the AddObject method.
		*m: addobjectref2		&& Introduced in version 9.5.0.90. This method is the same as AddObjectRef, except it allows the Transforms to be specified exactly with a fragment of XML. See the example below. Returns 1 for success, 0 for failure.
		*m: addsamedocref		&& Introduced in version 9.5.0.69. Specifies a same document Reference to be added to the Signature when generated. A same document Reference can be the entire XML document, or a fragment of the XML document.
		*m: addsamedocref2		&& Introduced in version 9.5.0.90. This method is the same as AddSameDocRef, except it allows the Transforms to be specified exactly with a fragment of XML. See the example below. Returns 1 for success, 0 for failure.
		*m: addsignaturenamespace		&& Introduced in version 9.5.0.75. Can be called one or more times to add additional namespaces to the Signature element. Returns 1 for success, 0 for failure.
		*m: behaviors_access		&& Access method used to retrieve the Chilkat XMLDSigGen Behaviors property.
		*m: behaviors_assign		&& Assign method used to hold a reference to the Behaviors property.
		*m: constructsignedinfo		&& Introduced in version 9.5.0.74. This method will construct and return the canonicalized SignedInfo XML. The digests of each Reference are computed and included in the SignedInfo.
		*m: createxmldsig		&& Introduced in version 9.5.0.69. Creates an XML Digital Signature. The application passes in the XML to be signed, and the signed XML is returned.
		*m: createxmldsigsb		&& Introduced in version 9.5.0.69. Creates an XML Digital Signature. The application passes the XML to be signed in sbXml, and it is replaced with the signed XML if successful. (Thus, sbXml is both an input and output argument.)
		*m: customkeyinfoxml_access		&& Access method used to retrieve the Chilkat XMLDSigGen CustomKeyInfoXML property.
		*m: customkeyinfoxml_assign		&& Assign method used to hold a reference to the CustomKeyInfoXML property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat XMLDSigGen DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: incnamespaceprefix_access		&& Access method used to retrieve the Chilkat XMLDSigGen IncNamespacePrefix property.
		*m: incnamespaceprefix_assign		&& Assign method used to hold a reference to the IncNamespacePrefix property.
		*m: incnamespaceuri_access		&& Access method used to retrieve the Chilkat XMLDSigGen IncNamespaceURI property.
		*m: incnamespaceuri_assign		&& Assign method used to hold a reference to the IncNamespaceURI property.
		*m: keyinfoid_access		&& Access method used to retrieve the Chilkat XMLDSigGen KeyInfoID property.
		*m: keyinfoid_assign		&& Assign method used to hold a reference to the KeyInfoID property.
		*m: keyinfokeyname_access		&& Access method used to retrieve the Chilkat XMLDSigGen KeyInfoKeyName property.
		*m: keyinfokeyname_assign		&& Assign method used to hold a reference to the KeyInfoKeyName property.
		*m: keyinfotype_access		&& Access method used to retrieve the Chilkat XMLDSigGen KeyInfoType property.
		*m: keyinfotype_assign		&& Assign method used to hold a reference to the KeyInfoType property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat XMLDSigGen LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat XMLDSigGen LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat XMLDSigGen LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat XMLDSigGen LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat XMLDSigGen LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat XMLDSigGen LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat XMLDSigGen LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: sethmackey		&& Introduced in version 9.5.0.69. Sets the HMAC key to be used if the Signature is to use an HMAC signing algorithm.
		*m: sethttpobj		&& Introduced in version 9.5.0.90. Sets the HTTP object to be used to communicate with OCSP responders, CRL distribution points, or timestamp authority (TSA) servers if needed.
		*m: setprivatekey		&& Introduced in version 9.5.0.69. Sets the private key to be used for creating the XML signature. The private key may be an RSA key, a DSA key, or an ECDSA key. Returns 1 for success, 0 for failure.
		*m: setrefidattr		&& Introduced in version 9.5.0.75. Sets the "Id" attribute for a Reference. Returns 1 for success, 0 for failure.
		*m: settsa		&& Introduced in version 9.5.0.90. Sets the TSA (Timestamp Authority) URL and other related settings for automatically adding an EncapsulatedTimestamp. Returns 1 for success, 0 for failure.
		*m: setx509cert		&& Introduced in version 9.5.0.69. Specifies the X.509 certificate to be used for the KeyInfo element when the KeyInfoType equals "X509Data". If usePrivateKey is 1, then the private key will also be set using the certificate's private key.
		*m: sigid_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigID property.
		*m: sigid_assign		&& Assign method used to hold a reference to the SigID property.
		*m: siglocationidx_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigLocationIdx property.
		*m: siglocationidx_assign		&& Assign method used to hold a reference to the SigLocationIdx property.
		*m: siglocationmod_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigLocationMod property.
		*m: siglocationmod_assign		&& Assign method used to hold a reference to the SigLocationMod property.
		*m: siglocation_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigLocation property.
		*m: siglocation_assign		&& Assign method used to hold a reference to the SigLocation property.
		*m: signamespaceprefix_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigNamespacePrefix property.
		*m: signamespaceprefix_assign		&& Assign method used to hold a reference to the SigNamespacePrefix property.
		*m: signamespaceuri_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigNamespaceURI property.
		*m: signamespaceuri_assign		&& Assign method used to hold a reference to the SigNamespaceURI property.
		*m: signedinfocanonalg_access		&& Access method used to retrieve the Chilkat XMLDSigGen SignedInfoCanonAlg property.
		*m: signedinfocanonalg_assign		&& Assign method used to hold a reference to the SignedInfoCanonAlg property.
		*m: signedinfodigestmethod_access		&& Access method used to retrieve the Chilkat XMLDSigGen SignedInfoDigestMethod property.
		*m: signedinfodigestmethod_assign		&& Assign method used to hold a reference to the SignedInfoDigestMethod property.
		*m: signedinfoid_access		&& Access method used to retrieve the Chilkat XMLDSigGen SignedInfoID property.
		*m: signedinfoid_assign		&& Assign method used to hold a reference to the SignedInfoID property.
		*m: signedinfoprefixlist_access		&& Access method used to retrieve the Chilkat XMLDSigGen SignedInfoPrefixList property.
		*m: signedinfoprefixlist_assign		&& Assign method used to hold a reference to the SignedInfoPrefixList property.
		*m: signingalg_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigningAlg property.
		*m: signingalg_assign		&& Assign method used to hold a reference to the SigningAlg property.
		*m: sigvalueid_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigValueID property.
		*m: sigvalueid_assign		&& Assign method used to hold a reference to the SigValueID property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat XMLDSigGen UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat XMLDSigGen VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: x509type_access		&& Access method used to retrieve the Chilkat XMLDSigGen X509Type property.
		*m: x509type_assign		&& Assign method used to hold a reference to the X509Type property.
		*p: behaviors		&& A comma-separated list of keywords to specify special behaviors to work around potential oddities or special requirements needed for providing signatures to particular systems.
		*p: customkeyinfoxml		&& Introduced in version 9.5.0.69. Specifies custom XML to be inserted in the KeyInfo element of the Signature. A common use is to provide a wsse:SecurityTokenReference fragment of XML.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: incnamespaceprefix		&& Introduced in version 9.5.0.70. The namespace prefix to use for InclusiveNamespaces elements. The default value is "ec". Set this property to the empty string to omit an InclusiveNamespaces prefix.
		*p: incnamespaceuri		&& Introduced in version 9.5.0.70. The namespace URI for any InclusiveNamespaces elements that are created. The default value is "http://www.w3.org/2001/10/xml-exc-c14n#".
		*p: keyinfoid		&& Introduced in version 9.5.0.75. If set, causes the generated KeyInfo element to include an Id attribute with this value.
		*p: keyinfokeyname		&& Introduced in version 9.5.0.69. Specifies the KeyName to be inserted in the KeyInfo element of the Signature if the KeyInfoType equals "KeyName".
		*p: keyinfotype		&& Introduced in version 9.5.0.69. Specifies the type of information that will be included in the optional KeyInfo element of the Signature.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: sigid		&& Introduced in version 9.5.0.69. An option Id attribute value for the Signature element. The default value is the empty string, which generates a Signature element with no Id attribute.
		*p: siglocation		&& Indicates where the Signature is to be located within the XML that is signed. This is a path to the position in the XML where the Signature will be inserted, using Chilkat path syntax (using vertical bar characters to delimit tag names).
		*p: siglocationidx		&& Introduced in version 11.1.0. Insert the signature at the Nth occurrence of the SigLocation. The default is 0, which is to insert.
		*p: siglocationmod		&& Introduced in version 9.5.0.77. Modifies the placement of the signature at the location specified by SigLocation.
		*p: signamespaceprefix		&& Introduced in version 9.5.0.69. The namespace prefix of the Signature that is to be created. The default value is "ds". Set this property to the empty string to omit a Signature namespace URI and prefix.
		*p: signamespaceuri		&& The namespace URI of the Signature that is to be created. The default value is "http://www.w3.org/2000/09/xmldsig#".
		*p: signedinfocanonalg		&& Introduced in version 9.5.0.69. The canonicalization method to be used for the SignedInfo when creating the XML signature.
		*p: signedinfodigestmethod		&& Introduced in version 9.5.0.69. The digest method to be used for signing the SignedInfo part of the Signature. Possible values are "sha1", "sha256", "sha384", and "sha512". The default is "sha256".
		*p: signedinfoid		&& Introduced in version 9.5.0.75. Optional Id attribute to be added to the SignedInfo element. The default value is the empty string, meaning that the SignedInfo is generated without an Id attribute.
		*p: signedinfoprefixlist		&& Introduced in version 9.5.0.69. The inclusive namespace prefix list to be added, if any, when the SignedInfoCanonAlg is equal to "EXCL_C14N". The defautl value is the empty string. If namespaces are listed, they are separated by space characters.
		*p: signingalg		&& Selects the signature algorithm to be used when using an RSA key to sign. The default value is "PKCS1-v1_5". This can be set to "RSASSA-PSS" (or simply "pss") to use the RSASSA-PSS signature scheme.
		*p: sigvalueid		&& Introduced in version 9.5.0.75. An option Id attribute value for the SignatureValue element. The default value is the empty string, which generates a SignatureValue element with no Id attribute.
		*p: uncommonoptions		&& Introduced in version 9.5.0.87. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: x509type		&& Introduced in version 9.5.0.69. Specifies the kind of X.509 certificate information is provided in the KeyInfo element when the KeyInfoType equals "X509Data".
	*</DefinedPropArrayMethod>

	*<PropValue>
		behaviors = 
		cchilkatclass = XmlDSigGen
		customkeyinfoxml = 
		debuglogfilepath = 
		iinstancepatch = 69
		incnamespaceprefix = ec
		incnamespaceuri = http://www.w3.org/2001/10/xml-exc-c14n#
		keyinfoid = 
		keyinfokeyname = 
		keyinfotype = KeyValue
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "xmldsiggen"
		sigid = 
		siglocation = 
		siglocationidx = 0
		siglocationmod = 0
		signamespaceprefix = ds
		signamespaceuri = http://www.w3.org/2000/09/xmldsig#
		signedinfocanonalg = EXCL_C14N
		signedinfodigestmethod = sha256
		signedinfoid = 
		signedinfoprefixlist = 
		signingalg = PKCS1-v1_5
		sigvalueid = 
		uncommonoptions = 
		verboselogging = 0
		x509type = Certificate
	*</PropValue>
	
	PROCEDURE addenvelopedref		&& Introduced in version 9.5.0.69. Specifies an enveloped Reference to be added to the Signature when generated. An enveloped Reference is for data contained within the Signature.
		*==============================================================================
		* Method:            AddEnvelopedRef
		* Purpose:           Specifies an enveloped Reference to be added to the Signature when generated. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcID -- the value of the ID attribute.
		*                    toChilkatStringBuilder -- a Chilkat String Builder object.
		*                    tcDigestMethod -- the digest method.
		*                    tcCanonicalMethod -- the canonicalization method.
		*                    tcReferenceType -- the reference type (optional).
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Specifies an enveloped Reference to be added to the Signature when generated. 
		** An enveloped Reference is for data contained within the Signature. 
		** (The Signature is to be an enveloping signature, and the data is enveloped by the Signature.)
		** 
		** The id is the value of the Id attribute of the Object element that 
		** is to be contained within the generated Signature. 
		** The content is the text content to be contained in the Object. 
		** Binary data can be signed by passing the bytes in content in an encoded format 
		** (such as base64 or hex).
		** 
		** The digestMethod is the digest method and can be one of the following: 
		** "sha1", "sha256", "sha384", "sha512", "ripemd160", or "md5".
		**
		** The canonMethod is the canonicalization method, and can be one of the following.
		** 
		**   "C14N" -- for Inclusive Canonical XML (without comments)
		**   "C14N_11" -- for Inclusive Canonical XML 1.1 (without comments)
		**   "EXCL_C14N" -- for Exclusive Canonical XML (without comments)
		**   "C14N_WithComments" -- for Inclusive Canonical XML (with comments)
		**   "C14N_11_WithComments" -- for Inclusive Canonical XML 1.1 (with comments)
		**   "EXCL_C14N_WithComments" -- for Exclusive Canonical XML (with comments)
		**   Note: The WithComments options are available in Chilkat v9.5.0.71 and later.
		** 
		** The refType is optional and is usually not needed.
		** Set this to the empty string unless it is desired to add a Type attribute 
		** to the Reference that is advisory only.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcID AS Character, toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		tcDigestMethod AS Character, tcCanonicalMethod AS Character, tcReferenceType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIGGEN_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
