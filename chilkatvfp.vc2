	PROCEDURE genkey		&& Generates a new DSA key that is numBits bits in length. The numBits should be at least 1024 bits and a multiple of 64. Typical values are 1024 and 2048. The newly generated key may be exported by calling one of the To* methods.
		*==============================================================================
		* Method:            GenKey
		* Purpose:           Generates a new DSA key that is numBits bits in length.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiKeyLength, the DSA key length.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Generates a new DSA key that is numBits bits in length. 
		** The numBits should be at least 1024 bits and a multiple of 64. 
		** Typical values are 1024 and 2048. The newly generated key may be exported 
		** by calling one of the To* methods.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiKeyLength AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.GenKey(m.tiKeyLength) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE genkey2		&& Introduced in version 9.5.0.90. Generates a new DSA key that is keyLenBits bits in length with a modulus of size modLenBits bits.
		*==============================================================================
		* Method:            GenKey2
		* Purpose:           Generates a new DSA key that is keyLenBits bits in length 
		*                    with a modulus of size modLenBits bits.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiKeyLength, the DSA key length.
		*                    tiModulusLength, the modulus size length.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.90
		**
		** Generates a new DSA key that is keyLenBits bits in length 
		** with a modulus of size modLenBits bits. The keyLenBits should be at least 1024 bits 
		** and a multiple of 64. FIPS 186-4 specifies the key length (bits) and modulus size (bits) 
		** to have one of the values: (1024, 160), (2048, 224), (2048, 256), or (3072, 256).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiKeyLength AS Integer, tiModulusLength AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 90
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.GenKey2(m.tiKeyLength, m.tiModulusLength) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

