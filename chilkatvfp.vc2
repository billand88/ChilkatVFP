		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMP_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE removestructprop		&& Removes a single member from an XMP structured property.
		*==============================================================================
		* Method:            RemoveStructProp
		* Purpose:           Removes a single member from an XMP structured property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML -- a Chilkat XML object.
		*                    tcStructureName -- the structure name to retrieve.
		*                    tcPropertyName -- the property name to remove.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/04/2022
		*==============================================================================
		
		**
		** Removes a single member from an XMP structured property.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL, ;
		tcStructureName AS Character, tcPropertyName AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XMP_COM_CALL, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.RemoveStructProp(m.loChilkatXML, ;
		      m.tcStructureName, m.tcPropertyName) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMP_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE saveappfile		&& Persists all changes made to the XMP document(s) by saving the XMP object to a file. Changes made by adding, updating, or removing properties are not persisted to the filesystem until this is called.
		*==============================================================================
		* Method:            SaveAppFile
		* Purpose:           Persists all changes made to the XMP document(s) 
		*                    by saving the XMP object to a file.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFileName -- the file name to save.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/04/2022
		*==============================================================================
		
		**
		** Persists all changes made to the XMP document(s) by saving the XMP object to a file. 
		** Changes made by adding, updating, or removing properties are not persisted 
		** to the filesystem until this is called.
		**
		
		LPARAMETERS tcFileName AS Character
		
