		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE getcert		&& Introduced in version 9.5.0.49. Returns the Nth certificate from the PEM. The first certificate is at index 0. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetCert
		* Purpose:           Returns the Nth certificate from the PEM.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex, the certificate array index value
		* Returns:           A Chilkat Certificate Object, or NULL.
