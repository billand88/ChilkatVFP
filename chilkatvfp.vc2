	PROCEDURE unlockbundle		&& Unlocks the entire Chilkat API for all classes. This should be called once at the beginning of a program. Once unlocked, objects of any Chilkat class may be instantiated and used.
		*==============================================================================
		* Method:            UnlockBundle
		* Purpose:           Unlocks the entire Chilkat API for all classes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBundleUnlockCode, the unlock bundle code.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Unlocks the entire Chilkat API for all classes. 
		** This should be called once at the beginning of a program. 
		** Once unlocked, objects of any Chilkat class may be instantiated and used. 
		** To unlock in fully-functional 30-day trial mode, pass any string, 
		** such as "Hello", in bundleUnlockCode. 
		** If a license is purchased, then replace the "Hello" with the purchased unlock code.
		**
		** After calling UnlockBundle once, the instance of the Global object 
		** may be discarded/deleted (assuming the programming language requires explicit deletes). 
		** Multiple calls to UnlockComponent are harmless. 
		** If the Chilkat API is already unlocked, the duplicate calls to UnlockBundle are no-ops.
		**
		** Important: Unlocking sets a flag in memory to indicate the unlocked status. 
		** There are no licensing files, and there is no communication with any Chilkat servers. 
		** This means your application, script, etc. must call UnlockBundle 
		** once at the start each time it runs. 
		** The good thing is that your application can 
		** run on any computer -- there are no licensing files to worry about. 
		** Also: If an application forgets to call UnlockBundle, 
		** Chilkat will automatically unlock in trial mode, 
		** and this will eventually fail when the trial runs out. 
		** If you purchased a license, it is very important to make sure 
		** you call UnlockBundle with the purchased unlock code.
		**
		** Enhancement for Version 11.6.0: Method is now Secrets aware.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcBundleUnlockCode AS Character
		
		LOCAL loChilkatObject AS CHILKAT_GLOBAL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.UnlockBundle(m.tcBundleUnlockCode) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_GLOBAL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE unlockstatus_access		&& Access method used to retrieve the Chilkat Global UnlockStatus property.
		*==============================================================================
		* Method:            UnlockStatus_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Global UnlockStatus property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.UnlockStatus
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62
		** 
		** Indicates the unlocked status for the last call to UnlockBundle, 
		** or any UnlockComponent call. The possible values are:
		**
		** 1) Not unlocked. (Still in locked state.)
		** 2) Unlocked with in fully-functional trial mode.
		** 3) Unlocked using a valid purchased unlock code.
		**
		** Note: If UnlockComponent or UnlockBundle is called with a purchased unlock code, 
		** the UnlockStatus is correctly set to the value 2. 
		** This value is intentionally sticky. 
		** If a subsequent and redundant call to UnlockComponent (or UnlockBundle) happens, 
		** it is effectively a "No-Op" because the library is already unlocked. 
		** The UnlockStatus will not change.
		**
		** If however, if the 1st call resulted in UnlockStatus = 1, 
		** and THEN the unlock method is called again with a purchased unlock code, 
		** the UnlockStatus should change from 1 to 2.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 62
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

