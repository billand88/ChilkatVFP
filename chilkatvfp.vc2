	PROCEDURE symlinkcreate		&& Introduced in version 9.5.0.77. Creates a symbolic link. Note: On Windows systems, this is not the same as creating a shortcut. A Windows symbolic link and a Windows shortcut are two different things.
		*==============================================================================
		* Method:            SymLinkCreate
		* Purpose:           Creates a symbolic link.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTargetPath, the target path.
		*                    tcLinkPath, the symbolic link path.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Creates a symbolic link.
		** 
		** Note: On Windows systems, this is not the same as creating a shortcut. 
		** A Windows symbolic link and a Windows shortcut are two different things. 
		** Shortcut files are common on Windows, but not symbolic links. 
		** Creating a symbolic link requires a special privilege, 
		** unless running as administrator. To be able to create symbolic links, 
		** your user account or group needs to be listed in secpol.msc ? Security Settings ? 
		** Local Policies ? User Rights Assignment ? Create symbolic links. 
		** However the special setting is not needed when running 
		** within the development environment, such as from Visual Studio.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcTargetPath AS Character, tcLinkPath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FILEACCESS_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SymLinkCreate(m.tcTargetPath, m.tcLinkPath) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FILEACCESS_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

