	PROCEDURE setrefreshheader		&& Introduced in version 9.5.0.77. Provides for the ability to add HTTP request headers for the request sent by the RefreshAccesToken method.
		*==============================================================================
		* Method:            SetRefreshHeader
		* Purpose:           Provides for the ability to add HTTP request headers 
		*                    for the request sent by the RefreshAccesToken method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcName, the name of the request header.
		*                    tcValue, the value of request header.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Provides for the ability to add HTTP request headers 
		** for the request sent by the RefreshAccesToken method. 
		** For example, if the "Accept: application/json" header needs to be sent, 
		** then add it by calling this method with name = "Accept" and value = "application/json".
		**
		** Multiple headers may be added by calling this method once for each. 
		** To remove a header, call this method with name equal to the header name, 
		** and with an empty string for value.
		**
		
		LPARAMETERS tcName AS Character, tcValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH2_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetRefreshHeader(m.tcName, m.tcValue) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

