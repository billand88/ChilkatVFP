	PROCEDURE verifysmtpconnection		&& Return 1 if a TCP/IP connection can be established with the SMTP server, otherwise returns 0.
		*==============================================================================
		* Method:            VerifySMTPConnection
		* Purpose:           Return 1 if a TCP/IP connection can be 
		*                    established with the SMTP server, otherwise returns 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Return 1 if a TCP/IP connection can be established with the SMTP server, otherwise returns 0.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, lcErrorMessage AS Character, ;
		liStackLevel AS Integer, liReturn AS Integer, lcMethod AS Character, ;
		luReturn AS Unknown, loException AS Exception, lcPEMType AS Character, ;
		lcSecondParameter AS Character
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE [] TO m.lcErrorMessage, m.lcMethod, m.lcPEMType, m.lcSecondParameter, m.la_Stack
		STORE 0 TO m.liReturn, m.luReturn, m.liStackLevel
		STORE NULL TO m.loChilkatObject, m.loException
		
		liStackLevel = ASTACKINFO(la_Stack)
		lcMethod = PROPER(STRTRAN(m.la_Stack(m.liStackLevel, 3), [.], [ ]))
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.VerifySMTPConnection() TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

