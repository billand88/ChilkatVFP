	HIDDEN PROCEDURE readtimeout_access		&& Access method used to retrieve the Chilkat ReadTimeout property.
		*==============================================================================
		* Method:            ReadTimeout_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 ReadTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ReadTimeout
		* Date Added:        02/25/2022
		*==============================================================================
		
		**
		** Forces a timeout when incoming data is expected on a data channel, 
		** but no data arrives for this number of seconds. 
		** The ReadTimeout is the amount of time that needs to elapse 
		** while no additional data is forthcoming.
		** During a long download, if the data stream halts for more than this amount, it will timeout. 
		** Otherwise, there is no limit on the length of time for the entire download.
		**
		** The default value is 60.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE readtimeout_assign		&& Assign method used to hold a reference to the ReadTimeOut property.
		*==============================================================================
		* Method:            ReadTimeout_Assign
		* Purpose:           Assign method used to hold a reference to the ReadTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ReadTimeout property.
		* Returns:           
		* Date Added:        02/25/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

