	PROCEDURE searchforcontent		&& Returns the first node having a tag equal to tag, whose content matches contentPattern. The contentPattern is a case-sensitive string that may contain any number of '*'s, each representing 0 or more occurrences of any character.
		*==============================================================================
		* Method:            SearchForContent
		* Purpose:           Returns the first node having a tag equal to tag, 
		*                    whose content matches contentPattern.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML, a Chilkat XML object.
		*                    tcTag, the tag to search.
		*                    tcContentPattern, the value pattern to search.
		* Returns:           loChilkatXMLMatch, a Chilkat XML object.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Returns the first node having a tag equal to tag, whose content matches contentPattern. 
		** The contentPattern is a case-sensitive string that may contain any number 
		** of '*'s, each representing 0 or more occurrences of any character. 
		** The search is breadth-first over the sub-tree rooted at the caller. 
		** A match is returned only after the search has traversed past the node indicated by afterPtr. 
		** To find the 1st occurrence, set afterPtr equal to Nothing. 
		** (For the ActiveX implementation, the afterPtr should never be Nothing. 
		** A reference to the caller's node should be passed instead.)
		** 
		** To iterate over matching nodes, the returned node can be passed in afterPtr 
		** for the next call to SearchForContent, until the method returns Nothing.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL, tcTag AS Character, ;
		tcContentPattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		loChilkatXMLMatch AS CHILKAT_XML_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatXMLMatch, m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      loChilkatXMLMatch = m.loChilkatObject.SearchForContent(;
		      m.loChilkatXML, m.tcTag, m.tcContentPattern)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.loChilkatXMLMatch
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loChilkatXMLMatch = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE searchforcontent2		&& Same as SearchForContent except the internal reference of the caller is updated to point to the search result (instead of returning a new object). Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SearchForContent2
		* Purpose:           Same as SearchForContent except the internal reference 
		*                    of the caller is updated to point to the search result
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatXML, a Chilkat XML object.
		*                    tcTag, the tag to search.
		*                    tcContentPattern, the value pattern to search.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/10/2022
		*==============================================================================
		
		**
		** Same as SearchForContent except the internal reference of the caller is updated 
		** to point to the search result (instead of returning a new object).
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatXML AS CHILKAT_XML_COM_CALL, tcTag AS Character, ;
		tcContentPattern AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		loParkParameterXml AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatXml AS CHILKAT_XML_COM_CALL, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterXml = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatXml)
		
		    loChilkatXml = m.loParkParameterXml.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SearchForContent2(m.loChilkatXML, ;
		      m.tcTag, m.tcContentPattern) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatXml = ;
		    m.loParkParameterXml.SetObject(m.toChilkatXml, m.loChilkatXml)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterXml, m.loChilkatXml
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  toChilkatXML = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loParkParameterXml = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatXml = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE searchfortag		&& Returns the first node having a tag equal to tag. The search is breadth-first over the sub-tree rooted at the caller. A match is returned only after the search has traversed past the node indicated by afterPtr.
