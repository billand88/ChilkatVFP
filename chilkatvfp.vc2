		RETURN
	ENDPROC

	HIDDEN PROCEDURE encoding_access		&& Access method used to retrieve the Chilkat XML Encoding property.
		*==============================================================================
		* Method:            Encoding_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML Encoding property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Encoding
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** This is the encoding attribute in the XML declaration, such as "utf-8" or "iso-8859-1". 
		** The default is "utf-8". 
		** This property can be set from any node in the XML document and when set, 
		** causes the encoding property to be added to the XML declaration. 
		** Setting this property does not cause the document to be converted to a different encoding.
		** 
		** Calling any of the LoadXml* methods causes this property 
		** to be set to the charset found within the XML, if any. 
		** If no charset is specified within the loaded XML, 
		** then the LoadXml method resets this property to its default value of "utf-8".
		** 
		** Enhancement for Version 49: Added Base58 encoding as an additional choice 
		** for all places where an encoding (such as “base64”, “hex”, etc.) can be selected.
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character. 
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE encoding_assign		&& Assign method used to hold a reference to the Encoding property.
		*==============================================================================
		* Method:            Encoding_Assign
		* Purpose:           Assign method used to hold a reference to the Encoding property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the Encoding property.
		* Returns:           
		* Date Added:        05/09/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE encryptcontent		&& Encrypts the content of the calling XML node using 128-bit CBC AES encryption. The base64-encoded encrypted content replaces the original content. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            EncryptContent
		* Purpose:           Encrypts the content of the calling XML node 
		*                    using 128-bit CBC AES encryption.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPassword -- the Encryption keyword.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Encrypts the content of the calling XML node using 128-bit CBC AES encryption. 
		** The base64-encoded encrypted content replaces the original content.
		**
		** Update for Version 72: Modification: Encrypting 0 bytes for block cipher algorithms 
		** with padding now results in one block of output, rather than 0 bytes.
		** (Decrypting the 16-byte block will return the original 0 bytes.) 
		** This only applies to block ciphers operating in modes such as ECB, CBC, etc. 
		** This does not apply to stream ciphers, or block ciphers operating in a streaming mode.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.EncryptContent(m.tcPassword) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XML_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE extractchildbyindex		&& Removes and returns the Nth child of an XML node. The first child is at index 0. Returns Nothing on failure.
		*==============================================================================
		* Method:            ExtractChildByIndex
		* Purpose:           Removes and returns the Nth child of an XML node.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- the Nth child of an XML node.
		* Returns:           loChilkatXML -- a Chilkat XML object.
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Removes and returns the Nth child of an XML node. The first child is at index 0.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_XML_COM_CALL, ;
		loException AS Exception, loChilkatXML AS CHILKAT_XML_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatXML
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
