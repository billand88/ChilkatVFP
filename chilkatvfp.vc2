	PROCEDURE sshauthenticatepk		&& Introduced in version 9.5.0.50. Authenticates with the SSH server using public-key authentication. The corresponding public key must have been installed on the SSH server for the sshLogin.
		*==============================================================================
		* Method:            SSHAuthenticatePK
		* Purpose:           Authenticates with the SSH server using public-key authentication.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSSHLogin -- the email UIDL.
		*                    toChilkatSSHKey, a Chilkat SSHKey object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/30/2022
		*==============================================================================
		
		**
		** Authenticates with the SSH server using public-key authentication. 
		** The corresponding public key must have been installed on the SSH server for the sshLogin. 
		** Authentication will succeed if the matching sshUsername is provided.
		** 
		** Important: When reporting problems, please send the full contents of the LastErrorText property 
		** to support@chilkatsoft.com.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcSSHLogin AS Character, toChilkatSSHKey AS CHILKAT_SSHKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterSshKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSshKey AS CHILKAT_SSHKEY_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.liReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		llImplemented = .F.
		liIntroducedInBuild = 50
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSshKey = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSshKey)
		
		      loChilkatSshKey = m.loParkParameterSshKey.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SSHAuthenticatePK(m.tcSSHLogin, m.loChilkatSSHKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSshKey = m.loParkParameterSshKey.SetObject(m.toChilkatSshKey, m.loChilkatSshKey)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  toChilkatSSHKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loParkParameterSshKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sshauthenticatepkasync		&& Introduced in version 9.5.0.50. Creates an asynchronous task to call the SshAuthenticatePk method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SSHAuthenticatePKAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    SshAuthenticatePk method with the arguments provided. 
