	HIDDEN PROCEDURE emitbom_access		&& Access method used to retrieve the Chilkat XML EmitBOM property.
		*==============================================================================
		* Method:            EmitBOM_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML EmitBOM property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EmitBOM
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** If 1, then emit the BOM (byte order mark, also known as a preamble) 
		** for encodings such as utf-8, utf-16, etc. The default value is 0. 
		** This only applies when writing XML files. 
		** It does not apply when getting the XML as a string via the GetXml method.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 44
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE emitbom_assign		&& Assign method used to hold a reference to the EmitBOM property.
		*==============================================================================
		* Method:            EmitBOM_Assign
		* Purpose:           Assign method used to hold a reference to the EmitBOM property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the EmitBOM property.
		* Returns:           
		* Date Added:        05/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 44
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE emitcompact_access		&& Access method used to retrieve the Chilkat XML EmitCompact property.
		*==============================================================================
		* Method:            EmitCompact_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML EmitCompact property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EmitCompact
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.64
		**
		** If 1, then GetXml and GetXmlSb emit compact XML. 
		** The XML emitted has no unnecessary whitespace, 
		** incuding no end-of-lines (CR's and/or LF's). 
		** The default value is 0, which maintains backward compatibility.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 64
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE emitcompact_assign		&& Assign method used to hold a reference to the EmitCompact property.
		*==============================================================================
		* Method:            EmitCompact_Assign
		* Purpose:           Assign method used to hold a reference to the EmitCompact property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the EmitCompact property.
		* Returns:           
		* Date Added:        05/09/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 64
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE emitxmldecl_access		&& Access method used to retrieve the Chilkat XML EmitXMLDecl property.
		*==============================================================================
		* Method:            EmitXMLDecl_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XML EmitXMLDecl property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.EmitXMLDecl
		* Date Added:        05/09/2022
		*==============================================================================
		
		**
		** If 1, then the XML declaration is emitted for methods (such as GetXml or SaveXml) 
		** where the XML is written to a file or string. The default value of this property is 1. 
		** If set to 0, the XML declaration is not emitted. 
		** (The XML declaration is the 1st line of an XML document starting with "<?xml ...".
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

