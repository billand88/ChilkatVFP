	PROCEDURE initsslserver		&& SSL Server applications should call this method with the SSL server certificate to be used for SSL connections. It should be called prior to accepting connections.
		*==============================================================================
		* Method:            InitSSLServer
		* Purpose:           SSL Server applications should call this method 
		*                    with the SSL server certificate to be used for SSL connections.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/28/2022
		*==============================================================================
		
		**
		** SSL Server applications should call this method with the SSL server certificate 
		** to be used for SSL connections. It should be called prior to accepting connections. 
		** This method has an intended side-effect: 
		** If not already connected, then the SSL property is set to 1.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.InitSSLServer(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		     toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE isconnected_access		&& Access method used to retrieve the Chilkat Socket IsConnected property.
		*==============================================================================
		* Method:            IsConnected_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket IsConnected property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IsConnected
		* Date Added:        05/27/2022
		*==============================================================================
		
		**
		** Returns 1 if the socket is connected. Otherwise returns 0.
		** 
		** Note: In general, this property indicates the last known state of the socket. 
		** For example, if the socket is connected, and your application does not read 
		** or write the socket, then IsConnected will remain 1. 
		** This property is updated when your application tries to read 
		** or write and discovers that the socket is no longer connected. 
		** It is also updated if your application explicitly closes the socket.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE isconnected_assign		&& Assign method used to hold a reference to the IsConnected property.
		*==============================================================================
		* Method:            IsConnected_Assign
		* Purpose:           Assign method used to hold 
		*                    the IsConnected property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the IsConnected property.
		* Returns:           
		* Date Added:        05/27/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE isunlocked		&& Undocumented method! Returns true if the component is unlocked.
		*==============================================================================
		* Method:            IsUnlocked
		* Purpose:           Undocumented method! Returns true if the class has been unlocked.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/09/2022
		*==============================================================================
		
		** 
		** Undocumented method! Returns true if the class has been unlocked. 
		** It is necessary to call UnlockComponent before calling any other methods. 
		** Passing any string to UnlockComponent will automatically activate a 30-day trial period.
		**
		** Version 11.0.0: Method removed.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.IsUnlocked() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE keepalive_access		&& Access method used to retrieve the Chilkat Socket KeepAlive property.
		*==============================================================================
		* Method:            KeepAlive_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Socket KeepAlive property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.KeepAlive
		* Date Added:        05/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Controls whether the SO_KEEPALIVE socket option is used for the underlying TCP/IP socket. 
		** The default value is 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
