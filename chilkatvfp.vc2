DEFINE CLASS xmldsig AS ibasechilkat OF "chilkatvfp.vcx" 		&& An API for validating XML Digital Signatures. Use the XmlDSigGen class for creating XML Digital Signatures.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: addencapsulatedtimestamp		&& Introduced in version 9.5.0.90. Adds an EncapsulatedTimeStamp to the signature indicated by the Selector property.
		*m: canonicalizefragment		&& Applies XML canonicalization to a fragment of the passed-in XML, and returns the canonicalized XML string. The fragmentId identifies the XML element where output begins. It is the XML element having an "id" attribute equal to fragmentId.
		*m: canonicalizexml		&& Applies XML canonicalization to the passed-in XML, and returns the canonicalized XML string.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat XMLDSig DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: externalrefdirs_access		&& Access method used to retrieve the Chilkat XMLDSig ExternalRefDirs property.
		*m: externalrefdirs_assign		&& Assign method used to hold a reference to the ExternalRefDirs property.
		*m: getcerts		&& Introduced in version 9.5.0.76. Returns the certificates found in the signature indicated by the Selector property. The base64 representation of each certificate is returned. Returns 1 for success, 0 for failure.
		*m: getkeyinfo		&& Introduced in version 9.5.0.69. Returns the KeyInfo XML for the signature indicated by the Selector property. Returns Nothing if no KeyInfo exists. Returns Nothing on failure.
		*m: getpublickey		&& Introduced in version 9.5.0.69. Returns the public key from the KeyInfo XML for the signature indicated by the Selector property. Returns Nothing if no KeyInfo exists, or if no public key is actually contained in the KeyInfo.
		*m: hasencapsulatedtimestamp		&& Introduced in version 9.5.0.90. Returns 1 if the signature indicated by the Selector property contains an EncapsulatedTimeStamp. Otherwise returns 0.
		*m: ignoreexternalrefs_access		&& Access method used to retrieve the Chilkat XMLDSig IgnoreExternalRefs property.
		*m: ignoreexternalrefs_assign		&& Assign method used to hold a reference to the IgnoreExternalRefs property.
		*m: isreferenceexternal		&& Introduced in version 9.5.0.69. Returns 1 if the reference at index is external. Each external reference would first need to be provided by the application prior to validating the signature.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat XMLDSig LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat XMLDSig LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat XMLDSig LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat XMLDSig LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat XMLDSig LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat XMLDSig LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat XMLDSig LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadsignature		&& Introduced in version 9.5.0.69. Loads an XML document containing 1 or more XML digital signatures. An application would first load XML containing digital signature(s), then validate.
		*m: loadsignaturebd		&& Introduced in version 9.5.0.69. Loads an XML document containing one or more XML digital signatures from the contents of a BinData object. An application would first load the XML, then validate.
		*m: loadsignaturesb		&& Introduced in version 9.5.0.69. Loads an XML document containing one or more XML digital signatures from the contents of a StringBuilder object. An application would first load the XML, then validate.
		*m: numreferences_access		&& Access method used to retrieve the Chilkat XMLDSig NumReferences property.
		*m: numreferences_assign		&& Assign method used to hold a reference to the NumReferences property.
		*m: numsignatures_access		&& Access method used to retrieve the Chilkat XMLDSig NumSignatures property.
		*m: numsignatures_assign		&& Assign method used to hold a reference to the NumSignatures property.
		*m: referenceuri		&& Introduced in version 9.5.0.69. Returns the URI of the Nth reference specified by index. (The 1st reference is at index 0.) URI's beginning with a pound sign ('#') are internal references. Returns Nothing on failure.
		*m: reffailreason_access		&& Access method used to retrieve the Chilkat XMLDSig RefFailReason property.
		*m: reffailreason_assign		&& Assign method used to hold a reference to the RefFailReason property.
		*m: selector_access		&& Access method used to retrieve the Chilkat XMLDSig Selector property.
		*m: selector_assign		&& Assign method used to hold a reference to the Selector property.
		*m: sethmackey		&& Introduced in version 9.5.0.69. Sets the HMAC key to be used if the Signature used an HMAC signing algorithm.
		*m: sethttpobj		&& Introduced in version 9.5.0.90. Sets the HTTP object to be used to communicate with OCSP responders, CRL distribution points, or timestamp authority (TSA) servers if needed.
		*m: setpublickey		&& Introduced in version 9.5.0.69. Sets the public key to be used for verifying the signature indicated by the Selector property.
		*m: setrefdatabd		&& Introduced in version 9.5.0.69. Provides the binary data for the external reference at index.
		*m: setrefdatafile		&& Introduced in version 9.5.0.69. Provides the data for the external reference at index. When validating the signature, the data contained in path will be streamed to compute the digest for validation.
		*m: setrefdatasb		&& Introduced in version 9.5.0.69. Provides the text data for the external reference at index.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat XMLDSig UncommonOptions property.
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: usecertvault		&& Introduced in version 9.5.0.69. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates having public keys when verifying an XML signature.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat XMLDSig VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifyreferencedigest		&& Introduced in version 9.5.0.69. This method allows for an application to verify the digest for each reference separately.
		*m: verifysignature		&& Introduced in version 9.5.0.69. Verifies the signature indicated by the Selector property. If verifyReferenceDigests is 1, then the digest of each Reference within the signature's SignedInfo is also validated. Returns 1 for success, 0 for failure.
		*m: withcomments_access		&& Access method used to retrieve the Chilkat XMLDSig WIthComments property.
		*m: withcomments_assign		&& Assign method used to hold a reference to the WithComments property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: externalrefdirs		&& Introduced in version 9.5.0.77. May contain a set of directory paths specifying where referenced external files are located. Directory paths should be separated using a semicolon character.
		*p: ignoreexternalrefs		&& Introduced in version 9.5.0.77. If 1, then ignore failures caused by external references not being available. This allows for the XML signature to be at least partially validated if the external referenced files are not available.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numreferences		&& Introduced in version 9.5.0.69. The number of data objects referenced in the XML digital signature. A data object may be self-contained within the loaded XML signature, or it may be an external URI reference.
		*p: numsignatures		&& Introduced in version 9.5.0.69. The number of digital signatures found within the loaded XML.
		*p: reffailreason		&& Introduced in version 9.5.0.77. Indicates the failure reason for the last call to VerifyReferenceDigest.
		*p: selector		&& Introduced in version 9.5.0.69. If the loaded XML contains multiple signatures, this property can be set to specify which signature is in effect when calling other methods or properties.
		*p: uncommonoptions		&& Introduced in version 9.5.0.90. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
		*p: withcomments		&& Undocumented property! This could be related to the last parameter of the Canonicalize* methods.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = XmlDSig
		debuglogfilepath = 
		externalrefdirs = 
		ignoreexternalrefs = 0
		iinstancepatch = 69
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "xmldsig"
		numreferences = 0
		numsignatures = 0
		reffailreason = 0
		selector = 
		uncommonoptions = 
		verboselogging = 0
		withcomments = 0
	*</PropValue>
	
	PROCEDURE addencapsulatedtimestamp		&& Introduced in version 9.5.0.90. Adds an EncapsulatedTimeStamp to the signature indicated by the Selector property.
		*==============================================================================
		* Method:            AddEncapsulatedTimeStamp
		* Purpose:           Adds an EncapsulatedTimeStamp to the signature 
		*                    indicated by the Selector property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJsonObject, a Chilkat JSON object.
		*                    toChilkatStringBuilder, a Chilkat String Builder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.90
		**
		** Adds an EncapsulatedTimeStamp to the signature indicated by the Selector property. 
		** The updated signed XML with the added EncapsulatedTimeStamp is returned in sbOut. 
		** See the example below for details.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, llImplemented AS Logical, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 90
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.AddEncapsulatedTimeStamp(m.loChilkatJsonObject, ;
		        m.loChilkatStringBuilder) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  toChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE canonicalizefragment		&& Applies XML canonicalization to a fragment of the passed-in XML, and returns the canonicalized XML string. The fragmentId identifies the XML element where output begins. It is the XML element having an "id" attribute equal to fragmentId.
		*==============================================================================
		* Method:            CanonicalizeFragment
		* Purpose:           Applies XML canonicalization to a fragment of the passed-in XML, 
		*                    and returns the canonicalized XML string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcXML -- the XML to canonicalize.
		*                    tcFragmentID -- the XML element where output begins.
		*                    tcVersion -- the canonicalization version.
		*                    tcPrefixList -- Empty, or a space separated list of prefixes.
		*                    tuWithComments -- whether or not comments are included in output.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Applies XML canonicalization to a fragment of the passed-in XML, 
		** and returns the canonicalized XML string. The fragmentId identifies 
		** the XML element where output begins. It is the XML element having 
		** an "id" attribute equal to fragmentId. The version may be one of the following:
		** 
		**   "C14N" -- for Inclusive Canonical XML
		**   "EXCL_C14N" -- for Exclusive Canonical XML
		** 
		** The prefixList only applies when the version is set to "EXCL_C14N". 
		** The prefixList may be an empty string, or a SPACE separated list of namespace prefixes. 
		** It is the InclusiveNamespaces PrefixList, which is the list of namespaces 
		** that are propagated from ancestor elements for canonicalization purposes.
		** 
		** If withComments is 1, then XML comments are included in the output. 
		** If withComments is 0, then XML comments are excluded from the output.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcXML AS Character, tcFragmentID AS Character, ;
		tcVersion AS Character, tcPrefixList AS Character, ;
		tuWithComments AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liWithComments AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liWithComments
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liWithComments = .LogicalToBit(m.tuWithComments)
		
		    TRY
		
		      STORE m.loChilkatObject.CanonicalizeFragment(m.tcXML, m.tcFragmentID, ;
		      m.tcVersion, m.tcPrefixList, m.liWithComments) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE canonicalizexml		&& Applies XML canonicalization to the passed-in XML, and returns the canonicalized XML string.
		*==============================================================================
		* Method:            CanonicalizeXML
		* Purpose:           Applies XML canonicalization to the passed-in XML,
		*                    and returns the canonicalized XML string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcXML -- the XML to canonicalize.
		*                    tcVersion -- the canonicalization version.
		*                    tuWithComments -- whether or not comments are included in output.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/06/2022
		*==============================================================================
		
		**
		** Applies XML canonicalization to the passed-in XML, 
		** and returns the canonicalized XML string. 
		** The version may be one of the following:
		** 
		**   "C14N" -- for Inclusive Canonical XML
		**   "EXCL_C14N" -- for Exclusive Canonical XML
		** 
		** If withComments is 1, then XML comments are included in the output. 
		** If withComments is 0, then XML comments are excluded from the output.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcXML AS Character, ;
		tcVersion AS Character, tuWithComments AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIG_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liWithComments AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liWithComments
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liWithComments = .LogicalToBit(m.tuWithComments)
		
		    TRY
		
		      STORE m.loChilkatObject.CanonicalizeXML(m.tcXML, ;
		      m.tcVersion, m.liWithComments) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIG_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/03/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.2.0
		
		  Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		
		** Version 10
		
		  Fixed a problem having to do with sending OCSP requests for ECDSA based certificates.
		
		** Version 99
		
		  Added “Base45” to the set of binary encodings supported by Chilkat. 
		  “base45” can now be used in any Chilkat function or property 
		  where a binary encoding such as “base64”, “hex”, “base58”, etc., can be used.
		
		** Version 94
		
		  Fixed problem such that an empty xades:UnsignedSignatureProperties tag could get emitted in the signed XML.
		
		  Fixed a rare ebXml signature verification problem (complicated and difficult to explain).
		
		** Version 94
		
		  Chilkat improved OCSP requests (used in various parts of the Chilkat API)
		  to satisfy some servers that are more picky about certain parts
		  of the OCSP protocol which should be optional.
		
		** Version 92
		
		  Added the ability to produce and validate ZATCA compatible XML signatures.
		
		  Problems with creating XML Signatures for TicketBAI and FacturaE in Spain are fixed.
		
		  Problems with creating XML Signatures for EBICS are fixed.
		  (EBICS is a German money transfer standard – Electronic Banking Internet Communication Standard)
		
		** Version 90
		
		  Added the ability to add an EncapsulatedTimeStamp to an already signed XML document.
		  Two new methods were added to help: HasEncapsulatedTimeStamp and AddEncapsulatedTimeStamp.
		
		** Version 79
		
		  Encoding: Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		  “ascii85” can be used anywhere in the Chilkat API where an encoding such as “base64”, “hex”, “base58”, etc. is used.
		
		  Fixed multiple signature verification problem with certain SAML signed messages (involving saml2p:ArtifactResponse).
		
		** Version 78
		
		  Fixed a problem having to do with exclusive canonicalization w/ namespace emission.
		  The problem occurred infrequently enough to be unnoticed for quite some time.
		
		** Version 77
		
		  Fixed a bug in XML canonicalization. This problem occurred when the default namespace
		  is defined at the root node, and exclusive canonicalization (EXCL_C14N) is used,
		  and a fragment is canonicalized where no usage of the default namespace exists
		  and non-qualified attribute names were used.
		  (It is a situation that is not common and therefore was not noticed for quite some time.)
		
		  Added the RefFailReason property.
		
		  Added the ExternalRefDirs property.
		
		** Version 75
		
		  Added the “hexlower” encoding. “hexlower” may be used instead of “hex”
		  to get the hexadecimal encoding using lowercase a-f (“hex” produces uppercase A-F).
		
		** Version 69
		
		    Chilkat introduces two new classes for creating and verifying XML Digital Signatures:
		    XmlDSig (for verification) and XmlDSigGen for generating XML signatures.
		    More examples will be available soon.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat XMLDSig DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XMLDSig DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        07/05/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

