	PROCEDURE gethostkeyfp		&& Introduced in version 9.5.0.92. Returns the host key fingerprint of the server, which is automatically set after connecting to an SSH/SFTP server.
		*==============================================================================
		* Method:            GetHostKeyFP
		* Purpose:           Returns the host key fingerprint of the server, 
		*                    which is automatically set after connecting to an SSH/SFTP server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHashAlgorithm -- a supported Chilkat Hash Algorithm
		*                    tuIncludeKeyType, whether or not to include the key type.
		*                    tuIncludeHashName, whether or not to include the hash name.
		* Returns:           The host key fingerprint of the server.
		* Date Added:        08/18/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.92
		**
		** Returns the host key fingerprint of the server, which is automatically set 
		** after connecting to an SSH/SFTP server. The hashAlg can be any hash algorithm 
		** supported by Chilkat, such as "SHA256", "SHA384", "SHA512", "SHA1", "MD5", 
		** "SHA3-224", "SHA3-256", "SHA3-384", "SHA3-512", etc.
		** 
		** If both includeKeyType and includeHashName are 1, 
		** then the fingerprint string is formatted like this:
		** 
		**   ssh-rsa SHA256:L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** If includeKeyType is 1 and includeHashName is 0:
		** 
		**   ssh-rsa L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** If includeKeyType is 0 and includeHashName is 1:
		** 
		**   SHA256:L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** If includeKeyType is 0 and includeHashName is 0:
		** 
		**   L7sQgnpnoBwRoyIYXAFBs8SdSnwtyYmhXs1p/mQDK...
		** 
		** SSH host key types can be: ssh-rsa, ecdsa-*-* (such as ecdsa-sha2-nistp256), 
		** ssh-ed25519, and ssh-dss.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		**
		** Fixed for Version 11.4.0: There was a problem in the coalescing of SSH curve names to the standard curve names 
		** used by OpenSSH in the creation of the blob that is hashed to create the fingerprint. 
		** Also, the trailing “=” chars are now automatically stripped. 
		** (Stripping the “=” padding in SSH SHA256 fingerprints is now the de-facto standard behavior 
		** across SSH implementations. )
		** 
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tcHashAlgorithm AS Character, ;
		tuIncludeKeyType AS Unknown, tuIncludeHashName AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		lcFingerPrint AS Character, liIncludeKeyType AS Integer, liIncludeHashName AS Integer, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical
		
		STORE 0 TO m.liIncludeKeyType, m.liIncludeHashName, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 92
		
		lcFingerPrint = []
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liIncludeKeyType = .LogicalToBit(m.tuIncludeKeyType)
		      liIncludeHashName = .LogicalToBit(m.tuIncludeHashName)
		
		      TRY
		
		        lcFingerPrint = ;
		        m.loChilkatObject.GetHostKeyFP(m.tcHashAlgorithm, m.liIncludeKeyType, m.liIncludeHashName)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFingerPrint
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getreceivedbd		&& Introduced in version 11.4.0. Appends the accumulated data received on the channel indicated by channelNum to bd, and clears the channel's internal receive buffer. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetReceivedBd
		* Purpose:           Appends the accumulated data received on the channel.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiChannel, the channel number.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0
		**
		** Appends the accumulated data received on the channel indicated by channelNum to bd, 
		** and clears the channel's internal receive buffer.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tiChannel AS Integer, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, luReturn AS Unknown, ;
		loParkParameterJSONObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn 
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJSONObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterJSONObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetReceivedBd(m.tiChannel, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterJSONObject.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJSONObject, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterJSONObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

