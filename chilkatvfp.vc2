	PROCEDURE setckpermission		&& Introduced in version 11.4.0. Sets sandbox related permissions for Chilkat objects. The chilkatClassName is the name of the Chilkat class (case-insensitive), such as Http, Rest, "MailMan", "Ftp2", "Ssh", etc.
		*==============================================================================
		* Method:            SetCkPermission
		* Purpose:           Sets sandbox related permissions for Chilkat objects. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcChilkatClassName - the name of the Chilkat class.
		*                    tcPermission, the permission status.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/01/2026
		*==============================================================================
		
		**
		** Introduced in version 11.4.0
		**
		** Sets sandbox related permissions for Chilkat objects. The chilkatClassName is the name 
		** of the Chilkat class (case-insensitive), such as Http, Rest, "MailMan", "Ftp2", "Ssh", etc. 
		** The chilkatClassName can also be set to "all" to apply the permission to all Chilkat classes.
		**
		** Possible values for permission are:
		**
		** disable - Your JavaScript code is not allowed to create an instance of the Chilkat class. 
		** A JavaScript exception is thrown when trying to create a Chilkat object of a class that is disabled.
		** sandbox - Objects for the Chilkat class can be instantiated in JavaScript, 
		** but they have no read or write access to the local filesystem.
		** readOnly - Objects for the Chilkat class can be instantiated in JavaScript 
		** and have read-only access to the local filesystem.
		** writeOnly - Objects for the Chilkat class can be instantiated in JavaScript 
		** and have write-only access to the local filesystem.
		** readWrite - Objects for the Chilkat class can be instantiated in JavaScript 
		** and have read/write access to the local filesystem.
		**
		** By default, all Chilkat classes are disabled. Your application must enable "all" 
		** or specific Chilkat classes before calling Eval or CallFunction.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcChilkatClassName AS Character, tcPermission AS Character 
		
		LOCAL loChilkatObject AS [Chilkat.Js], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown
		
		STORE NULL TO m.loChilkatObject, m.loException
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 4, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetCkPermission(m.tcChilkatClassName, m.tcPermission) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.Js])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

