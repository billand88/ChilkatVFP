	PROCEDURE findcertbysubject		&& Finds a certificate where one of the Subject properties (SubjectCN, SubjectE, SubjectO, SubjectOU, SubjectL, SubjectST, SubjectC) matches exactly (but case insensitive) with the passed string.
		*==============================================================================
		* Method:            FindCertBySubject
		* Purpose:           Finds a certificate where one of the Subject properties 
		*                    matches exactly (but case insensitive) with the passed string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString, the string to search.
		* Returns:           Chilkat Certificate object or NULL
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Finds a certificate where one of the Subject properties 
		** (SubjectCN, SubjectE, SubjectO, SubjectOU, SubjectL, SubjectST, SubjectC) 
		** matches exactly (but case insensitive) with the passed string. 
		** A match in SubjectCN will be tried first, followed by SubjectE, 
		** and SubjectO. After that, the first match found in SubjectOU, 
		** SubjectL, SubjectST, or SubjectC, but in no guaranteed order, is returned. 
		** All matches are case insensitive.
		** 
		** Returns Nothing on failure.
		**
		
		LPARAMETERS tcString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		loException AS Exception, loChilkatCert AS CHILKAT_CERT_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCert = m.loChilkatObject.FindCertBySubject(m.tcString)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCert
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

