	PROCEDURE fetchrange		&& Introduced in version 11.0.0. Downloads a range of full emails or email headers based on a starting sequence number (seqnum) and count. The downloaded emails are returned in bundle. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FetchRange
		* Purpose:           Downloads a range of full emails or email headers 
		*                    based on a starting sequence number (seqnum) and count. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuHeadersOnly -- whether or not to download just the headers.
		*                    tiSequenceNumber -- whether or not the message ID is a UID.
		*                    tiCount -- the email count to fetch.
		*                    toChilkatEMailBundle -- a Chilkat EmailBundle object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/06/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** Downloads a range of full emails or email headers based on a starting sequence number 
		** (seqnum) and count. The downloaded emails are returned in bundle.
		**
		** Important: The 1st email is at sequence number 1. 
		** This method will fail and return 0 if your application 
		** accidentally passes 0 for the seqnum.
		**
		** Fixed for Version 11.6.0: No longer appends an empty Email 
		** (with an invalid ckx-imap-uid of 0) when requesting sequence numbers 
		** past the end of the mailbox.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuHeadersOnly AS Unknown, tiSequenceNumber AS Integer, ;
		tiCount AS Integer, toChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, liUID AS Integer, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterEMailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEMailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL, llImplemented AS Logical, ;
		liHeadersOnly AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liHeadersOnly
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liHeadersOnly = .LogicalToBit(m.tuHeadersOnly)
		
		      loParkParameterEMailBundle = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEMailBundle)
		
		      loChilkatEMailBundle = m.loParkParameterEMailBundle.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FetchRange(m.liHeadersOnly, ;
		        m.tiSequenceNumber, m.tiCount, m.loChilkatEMailBundle) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEMailBundle = m.loParkParameterEMailBundle.SetObject(;
		      m.toChilkatEMailBundle, m.loChilkatEMailBundle)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEMailBundle, m.loChilkatEMailBundle
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatEMailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterEMailBundle = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEMailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

