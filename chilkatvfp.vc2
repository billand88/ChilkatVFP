	PROCEDURE copy		&& Returns the compressed data as a byte array. Note: The Copy method can only be called if the zip entry already contains compressed data (i.e. it is a "mapped entry").
		*==============================================================================
		* Method:            Copy
		* Purpose:           Returns the compressed data as a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        
		* Returns:           A byte array.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Returns the compressed data as a byte array.
		** 
		** Note: The Copy method can only be called 
		** if the zip entry already contains compressed data (i.e. it is a "mapped entry"). 
		** This is the case when an existing .zip is opened (from memory or from a file), 
		** or after the .zip has been written (by calling WriteZip or WriteToMemory). 
		** If a zip entry is created via AppendData, AppendFiles, etc., 
		** then it does not yet contain compressed data. 
		** When the zip is written, each entry becomes a "mapped entry" 
		** (The value of the EntryType property becomes 0.)
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, ;
		loException AS Exception, lqByteArray AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqByteArray
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqByteArray = m.loChilkatObject.Copy()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqByteArray
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE copytobase64		&& Returns the compressed data as a Base64-encoded string. It is only possible to retrieve the compressed data from a pre-existing .zip that has been opened or after writing the .zip but not closing it.
		*==============================================================================
		* Method:            CopyToBase64
		* Purpose:           Returns the compressed data as a Base64-encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights .oChilkat.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/03/2022
		*==============================================================================
		
		**
		** Returns the compressed data as a Base64-encoded string. 
		** It is only possible to retrieve the compressed data 
		** from a pre-existing .zip that has been opened 
		** or after writing the .zip but not closing it.
		**
		** Note: The CopyToBase64 method can only be called if the zip entry 
		** already contains compressed data (i.e. it is a "mapped entry").
		** 
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_ZIPENTRY_COM_CALL, ;
		loException AS Exception, lcString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcString = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcString = m.loChilkatObject.CopyToBase64()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ZIPENTRY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE copytohex		&& Returns the compressed data as a hexidecimal encoded string. It is only possible to retrieve the compressed data from a pre-existing .zip that has been opened or after writing the .zip but not closing it.
		*==============================================================================
