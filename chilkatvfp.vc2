	PROCEDURE loadencoded		&& Introduced in version 9.5.0.49. Loads ASN.1 from an encoded string. The encoding can be "base64", "hex", "uu", "quoted-printable", "base32", or "modbase64". Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadEncoded
		* Purpose:           Loads ASN.1 from an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcASNContent -- the ASN content to load.
		*                    tcEncoding, the encoding of the cvontent.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/31/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** Loads ASN.1 from an encoded string. The encoding can be "base64", 
		** "hex", "uu", "quoted-printable", "base32", or "modbase64".
		** 
		** Enhancement for Version 55: A new Chilkat encoding named “fingerprint” was added. 
		** The “fingerprint” encoding is lowercase hex with each byte separated by a colon character.
		** 
		** Enhancement for Version 56: 
		** Added the “base64url” encoding to the list of supported encodings. 
		**
		** Enhancement for Version 65: Added the “eda” encoding for UN/EDIFACT Syntax Level A.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcASNContent AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_ASN_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.LoadEncoded(m.tcASNContent, m.tcEncoding) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_ASN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE numsubitems_access		&& Access method used to retrieve the Chilkat ASN NumSubItems property.
		*==============================================================================
		* Method:            NumSubItems_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat ASN NumSubItems property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.NumSubItems
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** The number of sub-items contained within this ASN.1 item. 
		** Only constructed items, such as Sequence and Set will contain sub-iitems. 
		** Primitive items such as OIDs, octet strings, integers, etc. will never contain sub-items.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 49
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

