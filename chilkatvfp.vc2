	PROCEDURE wait		&& Introduced in version 9.5.0.52. Waits for the task chain to complete. Returns when all of the tasks in the chain have completed, or after maxWaitMs milliseconds have elapsed. (A maxWaitMs value of 0 is to wait indefinitely.)
		*==============================================================================
		* Method:            Wait
		* Purpose:           Waits for the task chain to complete.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiMaxWaitMs -- the maximum millisecond wait time.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.52
		** 
		** Waits for the task chain to complete. 
		** Returns when all of the tasks in the chain have completed, 
		** or after maxWaitMs milliseconds have elapsed. 
		** (A maxWaitMs value of 0 is to wait indefinitely.) 
		** Returns (0) if the task chain has not yet been started by calling the Run method, 
		** or if the maxWaitMs expired. If the task chain completed, was already completed, 
		** was canceled, or aborted, then this method returns 1.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiMaxWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_TASKCHAIN_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.Wait(m.tiMaxWaitMs) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_TASKCHAIN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS trustedroots AS ibasechilkat OF "chilkatvfp.vcx" 		&& Used to set and manage the CA root certificates trusted by your application. This applies to PKCS7 (S/MIME) signature validation and SSL/TLS server certificates.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: activate		&& Introduced in version 9.5.0.38. Activates this collection of trusted roots as the set of CA and self-signed root certificates that are to be trusted Chilkat-wide for PKCS7 signature validation and SSL/TLS server certificate validation.
		*m: addcert		&& Introduced in version 9.5.0.41. Adds a certificate to the collection of trusted roots.
		*m: addjavakeystore		&& Introduced in version 9.5.0.44. Adds the trusted certificates from a Java key store to the collection of trusted roots. Returns 1 for success, 0 for failure.
		*m: addjavakeystoreasync		&& Introduced in version 9.5.0.44. Creates an asynchronous task to call the AddJavaKeyStore method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: certat		&& Introduced in version 11.0.0. Returns in cert the Nth cert contained within this object. The 1st certificate is at index 0. Returns 1 for success, 0 for failure.
		*m: deactivate		&& Introduced in version 9.5.0.40. Deactivates a previous set of activated trusted roots so that all roots / self-signed certificates are implicitly trusted. Returns 1 for success, 0 for failure.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat TrustedRoots DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: getcert		&& Introduced in version 9.5.0.38. Returns the Nth cert contained within this object. The 1st certificate is at index 0. Returns Nothing on failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat TrustedRoots LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat TrustedRoots LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat TrustedRoots LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat TrustedRoots LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat TrustedRoots LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat TrustedRoots LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat TrustedRoots LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadcacertspem		&& Introduced in version 9.5.0.38. Loads a CA bundle in PEM format. This is a file containing CA root certificates that are to be trusted.
		*m: loadcacertspemasync		&& Introduced in version 9.5.0.38. Creates an asynchronous task to call the LoadCaCertsPem method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: numcerts_access		&& Access method used to retrieve the Chilkat TrustedRoots NumCerts property.
		*m: numcerts_assign		&& Assign method used to hold a reference to the NumCerts property.
		*m: rejectselfsignedcerts_access		&& Access method used to retrieve the Chilkat TrustedRoots RejectSelfSignedCerts property.
		*m: rejectselfsignedcerts_assign		&& Assign method used to hold a reference to the RejectSelfSignedCerts property.
		*m: trustsystemcaroots_access		&& Access method used to retrieve the Chilkat TrustedRoots TrustSystemCARoots property.
		*m: trustsystemcaroots_assign		&& Assign method used to hold a reference to the TrustSystemCARoots property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat TrustedRoots VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numcerts		&& Introduced in version 9.5.0.38. he number of certificates contained within this object. This is the number of certificates explicitly added by the methods AddCert, AddJavaKeyStore, and LoadCaCertsPem.
		*p: rejectselfsignedcerts		&& Introduced in version 9.5.0.80. Indicates whether all self-signed certificates are to be rejected in SSL/TLS connections. The default value of this property is 0.
		*p: trustsystemcaroots		&& Introduced in version 9.5.0.41. Indicates whether the operating system's CA root certificates are automatically trusted. On a Windows operating system, this would be the registry-based CA certificate stores.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = TrustedRoots
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		iinstancepatch = 38
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "trustedroots"
		numcerts = 0
		rejectselfsignedcerts = 0
		trustsystemcaroots = 1
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE activate		&& Introduced in version 9.5.0.38. Activates this collection of trusted roots as the set of CA and self-signed root certificates that are to be trusted Chilkat-wide for PKCS7 signature validation and SSL/TLS server certificate validation.
		*==============================================================================
		* Method:            Activate
