	HIDDEN PROCEDURE separatorchar_access		&& Access method used to retrieve the Chilkat IMAP SeparatorChar property.
		*==============================================================================
		* Method:            SeparatorChar_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP SeparatorChar property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SeparatorChar
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** The separator character used by the IMAP server for the mailbox hierarchy. 
		** It is typically "/" or ".", but may vary depending on the IMAP server. 
		** The ListMailboxes method has the side-effect of setting this property 
		** to the correct value because the IMAP server's response 
		** when listing mailboxes includes information about the separator char.
		** 
		** Note: Starting in version 9.5.0.47, this property changed from a "char" 
		** type to a "string" type. The separator char property will always be 
		** a string of length 1 character.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE separatorchar_assign		&& Assign method used to hold a reference to the SeparatorChar property.
		*==============================================================================
		* Method:            SeparatorChar_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat IMAP SeparatorChar property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SeparatorChar property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sessionlog_access		&& Access method used to retrieve the Chilkat IMAP SessionLog property.
		*==============================================================================
		* Method:            SessionLog_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP SessionLog property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SessionLog
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Contains an in-memory log of the raw commands sent to the IMAP server, 
		** and the raw responses received from the IMAP server. 
		** The KeepSessionLog property must be set to 1 to enable session logging. 
		** Call ClearSessionLog to reset the log.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sessionlog_assign		&& Assign method used to hold a reference to the SessionLog property.
		*==============================================================================
		* Method:            SessionLog_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat IMAP SessionLog property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SessionLog property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE setcsp		&& Undocumented method! Accepts a (decremented) Chilkat CSP reference.
		*==============================================================================
		* Method:            SetCSP
		* Purpose:           Decremented function! Accepts a (decremented) Chilkat CSP reference.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCSP, a Chilkat CSP object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/23/2022
		*==============================================================================
		
		**
		** Decremented function! Accepts a (decremented) Chilkat CSP reference.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCSP AS [Chilkat_9_5_0.Csp]
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loParkParameterCsp AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCsp AS [Chilkat_9_5_0.Csp], liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCsp = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCsp)
		
		    loChilkatCsp = m.loParkParameterCsp.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetCSP(m.loChilkatCSP) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCsp = m.loParkParameterCsp.SetObject(m.toChilkatCsp, m.loChilkatCsp)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCsp, m.loChilkatCsp
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatCSP = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loParkParameterCsp = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCsp = NEWOBJECT([Chilkat_9_5_0.Csp])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setdecryptcert		&& Introduced in version 9.5.0.40. Explicitly specifies the certificate to be used for decrypting encrypted email. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetDecryptCert
		* Purpose:           Explicitly specifies the certificate 
		*                    to be used for decrypting encrypted email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.40
		**
		** Explicitly specifies the certificate to be used for decrypting encrypted email.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
