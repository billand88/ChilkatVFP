	PROCEDURE readfilebd		&& Introduced in version 9.5.0.77. Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method. The numBytes is the maximum number of bytes to read.
		*==============================================================================
		* Method:            ReadFileBd
		* Purpose:           Reads file data from a remote file on the SSH server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the file handle returned by OpenFile()
		*                    tiBytes -- the user's password
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           The number of bytes
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		**
		** Reads file data from a remote file on the SSH server. 
		** The handle is a file handle returned by the OpenFile method. 
		** The numBytes is the maximum number of bytes to read. 
		** If the end-of-file is reached prior to reading the number of requested bytes, 
		** then fewer bytes may be returned. The received bytes are appended to the contents of bd.
		**
		** To read an entire file, one may call ReadFileBd repeatedly until Eof(handle) returns 1.
		**
		
		LPARAMETERS tcHandle AS Character, tiBytes AS Integer, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liBytes AS Integer
		
		STORE 0 TO m.liBytes, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        liBytes = m.loChilkatObject.ReadFileBd(m.tcHandle, m.tiBytes, m.loChilkatBinData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.liBytes 
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readfilebdasync		&& Introduced in version 9.5.0.77. Creates an asynchronous task to call the ReadFileBd method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            ReadFileBdAsync
		* Purpose:           Reads file data from a remote file on the SSH server. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the file handle returned by OpenFile()
		*                    tiBytes -- the user's password
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.77
		** 
		** Creates an asynchronous task to call the ReadFileBd method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHandle AS Character, tiBytes AS Integer, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loChilkatTask, m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 77
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.ReadFileBdAsync(m.tcHandle, m.tiBytes, m.loChilkatBinData)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readfilebytes		&& Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method. The numBytes is the maximum number of bytes to read.
		*==============================================================================
		* Method:            ReadFileBytes
		* Purpose:           Reads file data from a remote file on the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		*                    tiBytes, the maximum number of bytes to read
		* Returns:           VarBinary
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Reads file data from a remote file on the SSH server. 
		** The handle is a file handle returned by the OpenFile method. 
		** The numBytes is the maximum number of bytes to read. 
		** If the end-of-file is reached prior to reading the number of requested bytes, 
		** then fewer bytes may be returned.
		**
		** To read an entire file, one may call ReadFileBytes repeatedly until Eof(handle) returns 1.
		**
		** Fixed for Version 61: This method could hang for duration of IdleTimeoutMs 
		** if file size was smaller than number of bytes requested.
		**
		** Fixed for version 67: Fixed this method for the case where 
		** one tries to read more bytes than what exists in the remote file.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcHandle AS Character, tiBytes AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, lqData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqData = m.loChilkatObject.ReadFileBytes(m.tcHandle, m.tiBytes)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readfilebytes32		&& Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method. The offset is measured in bytes relative to the beginning of the file.
		*==============================================================================
		* Method:            ReadFileBytes32
		* Purpose:           Reads file data from a remote file on the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		*                    tiByteOffset, the offset from the beginning of the file
		*                    tiBytes, the maximum number of bytes to read
		* Returns:           VarBinary
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** Reads file data from a remote file on the SSH server. 
		** The handle is a file handle returned by the OpenFile method. 
		** The offset is measured in bytes relative to the beginning of the file. 
		** (64-bit offsets are supported via the ReadFileBytes64 and ReadFileBytes64s methods.) 
		** The offset is ignored if the "textMode" flag was specified during the OpenFile. 
		** The numBytes is the maximum number of bytes to read. 
		** If the end-of-file is reached prior to reading the number 
		** of requested bytes, then fewer bytes may be returned.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcHandle AS Character, tiByteOffset AS Integer, tiBytes AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, lqData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqData = ;
		      m.loChilkatObject.ReadFileBytes32(m.tcHandle, m.tiByteOffset, m.tiBytes)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE readfilebytes64s		&& (This method exists for systems that do not support 64-bit integers. The 64-bit integer offset is passed as a decimal string instead.). Reads file data from a remote file on the SSH server. The handle is a file handle returned by the OpenFile method.
		*==============================================================================
		* Method:            ReadFileBytes64s
		* Purpose:           Reads file data from a remote file on the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHandle -- the handle returned by OpenFile()
		*                    tiByteOffset, the offset from the beginning of the file
		*                    tiBytes, the maximum number of bytes to read
		* Returns:           VarBinary
		* Date Added:        04/22/2022
		*==============================================================================
		
		**
		** (This method exists for systems that do not support 64-bit integers. ;
		** The 64-bit integer offset is passed as a decimal string instead.)
		
		** Reads file data from a remote file on the SSH server. 
		** The handle is a file handle returned by the OpenFile method. 
		** The offset is a 64-bit integer represented as a decimal string. 
		** It represents an offset in bytes from the beginning of the file. 
		** The offset is ignored if the "textMode" flag was specified during the OpenFile. 
		** The numBytes is the maximum number of bytes to read. 
		** If the end-of-file is reached prior to reading the number 
		** of requested bytes, then fewer bytes may be returned.
		** 
		** Fix for version 83: If reading past the end of the file, 
		** did not cause the Eof(handle) function to subsequently return True.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tcHandle AS Character, tiByteOffset AS Integer, tiBytes AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, lqData AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqData
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqData = ;
		      m.loChilkatObject.ReadFileBytes64s(m.tcHandle, m.tiByteOffset, m.tiBytes)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

