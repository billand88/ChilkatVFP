		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject)) ;
		    AND VARTYPE(EVALUATE([loChilkatObject.] + m.lcChilkatProperty)) == T_VARBINARY
		    ** End have a good Chilkat object test
		
		  ENDWITH
		
		ELSE
		
		  lcMethod = m.la_Stack(m.liStackLevel, 3)
		  lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		  lcPEMType = LOWER(PEMSTATUS(THIS, m.lcMethod, 3))
		
		  ** Have wrapper object test
		  IF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		
		    lcSecondParameter = m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Bad value], m.lcSecondParameter, , THIS)
		
		  ELSE
		
		    lcSecondParameter = [Process_Assign] + [~] + m.lcMethod + [~] + m.lcPEMType
		    lcErrorMessage = ChMsgSvc([Missing object], m.lcSecondParameter, , THIS)
		
		  ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER
		  ** End have wrapper object test
		
		  .ProcessErrorMessage(m.lcErrorMessage, THIS)
		
		ENDIF TYPE([toChilkatWrapper.Name]) = T_CHARACTER ;
		AND (VARTYPE(m.tcCallingMethod) = T_CHARACTER) ;
		AND (UPPER(RIGHTC(m.tcCallingMethod, 7)) = [_ACCESS])
		** End parameter validation test
		
		** Redefine when not in use.
		LOCAL ARRAY la_Stack[1, 1]
		la_Stack[1, 1] = []
		
		STORE NULL TO m.loChilkatWrapper, m.loChilkatObject
		
		RETURN
		
		** Design time IntelliSense test
		IF .F.
		
		  loChilkatWrapper = NEWOBJECT([iBaseChilkat], [ChilkatVFP.VCX])
		
		ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

ENDDEFINE

DEFINE CLASS publickey AS ibasechilkat OF "chilkatvfp.vcx" 		&& Contains an RSA, DSA, or ECC public key. Provides methods for importing and exporting to/from PEM, DER, PKCS8, PKCS1, and XML formats. Public keys can be imported/exported to both memory and files.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat PublicKey DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: empty_access		&& Access method used to retrieve the Chilkat PublicKey Empty property.
		*m: empty_assign		&& Assign method used to hold a reference to the Empty property.
		*m: getder		&& Introduced in version 9.5.0.58. Returns the public key in binary DER format. If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned.
		*m: getderbd		&& Introduced in version 11.0.0. Returns the public key in binary DER format into bd. For key types that support both PKCS1 and PKCS8 formats (e.g., RSA), preferPkcs1 specifies the format to be returned. Returns 1 for success, 0 for failure.
		*m: getencoded		&& Introduced in version 9.5.0.58. Returns the public key in DER format as an encoded string (such as base64 or hex). If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned.
		*m: getjwk		&& Introduced in version 9.5.0.66. Gets the public key in JWK (JSON Web Key) format.
		*m: getjwkthumbprint		&& Introduced in version 9.5.0.66. Returns the JWK thumbprint for the public key. This is the thumbprint of the JSON Web Key (JWK) as per RFC 7638. Returns Nothing on failure.
		*m: getopensslder		&& Undocumented method! This method is deprecated. Applications should call GetDer with preference for PKCS8 instead.
		*m: getopensslpem		&& Undocumented method! This method is deprecated. Applications should call GetPem with preference for PKCS8 instead. Gets the public key in PKCS8 PEM format.
		*m: getpem		&& Introduced in version 9.5.0.58. Returns the public key in PEM format. If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned. Returns Nothing on failure.
		*m: getpkcs1enc		&& Undocumented method! This method is deprecated. Applications should call GetEncoded with preference for PKCS1 instead. Gets the public key in PKCS1 format and returns in an encoded string, as specified by the encoding argument.
		*m: getpkcs8enc		&& Unodcumented function! This method is deprecated. Applications should call GetEncoded with preference for PKCS8 instead. Gets the public key in PKCS8 format and returns in an encoded string, as specified by the encoding argument.
		*m: getrsader		&& Undocumented method! This method is deprecated. Applications should call GetDer with preference for PKCS1 instead.
		*m: getxml		&& Gets the public key in XML format. The format depends on the key type. The key parts indicated by "..." are base64 encoded.
		*m: keysize_access		&& Access method used to retrieve the Chilkat PublicKey KeySize property.
		*m: keysize_assign		&& Assign method used to hold a reference to the KeySize property.
		*m: keytype_access		&& Access method used to retrieve the Chilkat PublicKey KeyType property.
		*m: keytype_assign		&& Assign method used to hold a reference to the KeyType property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat PublicKey LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat PublicKey LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat PublicKey LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat PublicKey LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat PublicKey LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat PublicKey LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat PublicKey LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadbase64		&& Introduced in version 9.5.0.47. Loads a public key from base64-encoded DER (can be PKCS1 or PKCS8). Returns 1 for success, 0 for failure.
		*m: loadbd		&& Introduced in version 9.5.0.83. Loads a public key from any binary or string format where the data is contained in bd. Chilkat automatically recognizes the format and key type (RSA, EC, DSA, Ed25519, ..)  Returns 1 for success, 0 for failure.
		*m: loadecdsa		&& Introduced in version 9.5.0.85. Loads an ECDSA public key directly from Qx, Qy values specified as a hex strings.
		*m: loaded25519		&& Introduced in version 9.5.0.83. Loads the public key object from a 32-byte ed25519 key specified as a hex string. Returns 1 for success, 0 for failure.
		*m: loadfrombinary		&& Introduced in version 9.5.0.58. Loads a public key from binary DER. Auto-recognizes both PKCS1 and PKCS8 formats. Returns 1 for success, 0 for failure.
		*m: loadfromfile		&& Introduced in version 9.5.0.58. Loads a public key from a file. The file can be in any string or binary format such as binary DER (PKCS1 or PKCS8), PEM, XML, or encoded binary DER (such as base64 encoded binary DER).
		*m: loadfromstring		&& Introduced in version 9.5.0.58. Loads a public key from any string format, such as PEM, XML, or encoded binary DER (such as base64 encoded binary DER). The format of the keyString is auto-recognized.
		*m: loadopensslder		&& Undocumented method! This method is deprecated. Applications should call LoadFromBinary instead. Loads a public key from in-memory PKCS8 DER formatted byte data.
		*m: loadopensslderfile		&& Undocumented method! This method is deprecated. Applications should call LoadFromFile instead. Loads a public key from an PKCS8 DER format file.
		*m: loadopensslpem		&& Undocumented function! This method is deprecated. Applications should call LoadFromString instead. Loads a public key from an PKCS8 PEM string.
		*m: loadopensslpemfile		&& Undocumented method! This method is deprecated. Applications should call LoadFromFile instead. Loads a public key from an PKCS8 PEM file.
		*m: loadpkcs1pem		&& Undocumented method! This method is deprecated. Applications should call LoadFromString instead. Loads an RSA public key from PKCS#1 PEM format.
		*m: loadrsader		&& Undocumented function! This method is deprecated. Applications should call LoadFromBinary instead. Loads a public key from in-memory PKCS1 DER formatted byte data.
		*m: loadrsaderfile		&& Undocumented method! This method is deprecated. Applications should call LoadFromFile instead. Loads a public key from an PKCS1 DER formatted file.
		*m: savederfile		&& Introduced in version 9.5.0.58. Saves the public key to a file in binary DER format. If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned. Returns 1 for success, 0 for failure.
		*m: saveopensslderfile		&& Undocumented function! This method is deprecated. Applications should call SaveDerFile with preference for PKCS8 instead.
		*m: saveopensslpemfile		&& Undocumented method! This method is deprecated. Applications should call SavePemFile with preference for PKCS8 instead. Saves the public key to an PKCS8 PEM format file.
		*m: savepemfile		&& Introduced in version 9.5.0.58. Saves the public key to a file in PEM format. If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned. Returns 1 for success, 0 for failure.
		*m: saversaderfile		&& Undocumented method! This method is deprecated. Applications should call SaveDerFile with preference for PKCS1 instead. Saves the public key to an PKCS1 DER format file.
		*m: savexmlfile		&& Saves the public key to an XML file. Returns 1 for success, 0 for failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat PublicKey VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: empty		&& Introduced in version 9.5.0.87. Indicates whether this object is empty or holds a public key.
		*p: keysize		&& Introduced in version 9.5.0.67. Gets the size (in bits) of the public key. For example: 1024, 2048, etc.
		*p: keytype		&& Introduced in version 9.5.0.52. The type of public key. Can be "empty", "rsa", "dsa", or "ecc".
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = PublicKey
		debuglogfilepath = 
		empty = 0
		keysize = 0
		keytype = 
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "publickey"
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE chilkatchangelog
		*==============================================================================
		* Method:            ChilkatChangeLog
		* Purpose:           Documentation method used to hold 
		*                    the Chilkat class changes per release version.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           
		* Date Added:        02/04/2024
		*==============================================================================
		
		#IF .F.
		
		TEXT
		
		** Version 11.6.0
		
		  GetJwkThumbprint: unsupported/empty hash algorithm now fails instead of using SHA-1.
		
		  JWK validation now fails on missing required members, unsupported key type, 
		  or a zero RSA exponent, without leaving a partially initialized object.
		
		  LoadEd25519 requires exactly 32 bytes (64 hex chars) and rejects prefixes, 
		  whitespace, and bad lengths.
		  
		  LoadEcdsa rejects malformed/short coordinates, prefixes, whitespace, 
		  empty and all-zero values, and unsupported curves.
		
		  Standardized failure behavior across all load methods: 
		  a failed load clears the object (Empty = true, KeyType = "empty", 
		  KeySize = 0, LastMethodSuccess = false) and preserves no previous key.
		
		** Version 11.0.0
		
		  Added the GetDerBd method.
		
		** Version 95
		
		  Added support for SHA224 in all places where a hash algorithm might be specified.
		
		** Version 85
		
		  Added the LoadEcdsa method.
		
		** Version 83
		
		  Added the SHA3 hash algorithms: sha3-224, sha3-256, sha3-384, sha3-512.
		  The SHA3 hash algorithms may generally be used in any property or method
		  of any Chilkat class where a hash algorithm is specified.
		
		  Added the LoadEd25519 method to load an ed25519 public key from a 32-byte hex string.
		
		  Improved support for ECDSA certs.
		
		** Version 76
		
		  The KeySize property (indicating the size of the key in bits)
		  did not always properly return a size that was a multiple of 8 bits.
		
		** Version 67
		
		  Added the KeySize property.
		
		** Version 66
		
		  Added PublicKey.GetJwk and PrivateKey.GetJwk to get public/private keys in JSON Web Key format.
		
		** Version 58
		
		  The Windows logged-on username is no longer automatically logged at the top of every LastErrorText.
		  (This was originally done to help w/ support issues so tht Chilkat might notice if the program runs
		  in the context of a Service or IIS, which could be a clue to the cause of certain problems.)
		
		  Decremented many methods and added new methods. Originally these classes were for RSA keys,
		  but have since become a classes that can contain either RSA, DSA, or ECC keys.
		  Methods with “RSA” in the name were decremented. Also, methods with confusing names were decremented
		  and replaced with methods having better names.
		
		** Version 53
		
		  The LastStringResultLen property is added to each Chilkat class.
		  This is helpful for certain programming languages such as DataFlex or SQL Server
		  where the size of the string returned may need to be known before using it.
		  Each Chilkat ActiveX object has its own LastStringResult and LastStringResultLen properties.
		  The KeepStringResult is a property of Chilkat.Global only.
		  (It may be confusing that Chilkat.Global also has a LastStringResult property —
		  but this is just like any other object.)
		
		  Therefore, your code would set Global.KeepStringResult once at the beginning of your code.
		
		  Let’s say you have an HttpResult object, and you want the BodyQP.
		  You would access the BodyQP, but ignore the string returned.
		  Then examine the HttpResult.LastStringResultLen, adjust your max string length (in DataFlex) if necessary,
		  and then get the cached string from HttpResult.LastStringResult.
		
		** Version 52
		
		  Added the LastMethodSuccess property.
		
		** Version 47
		
		  Added the LoadBase64 method.
		
		ENDTEXT
		
		#ENDIF .F.
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat PublicKey DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat PublicKey DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/20/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat PublicKey DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        06/20/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE empty_access		&& Access method used to retrieve the Chilkat PublicKey Empty property.
		*==============================================================================
		* Method:            Empty_Access
		* Purpose:           Access method used to retrieve the Chilkat PublicKey Empty property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.Empty
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		**
		** Indicates whether this object is empty or holds a public key.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE empty_assign		&& Assign method used to hold a reference to the Empty property.
		*==============================================================================
		* Method:            Empty_Assign
		* Purpose:           Assign method used to hold 
		*                    the Empty property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the Empty property.
		* Returns:           
		* Date Added:        06/20/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 87
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	PROCEDURE getder		&& Introduced in version 9.5.0.58. Returns the public key in binary DER format. If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned.
		*==============================================================================
		* Method:            GetDER
		* Purpose:           Returns the public key in binary DER format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuPreferPKCS1Format, whether or not to return PKCS1 format
		* Returns:           The public key in binary DER format
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Returns the public key in binary DER format. If the key type (such as RSA) 
		** supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tuPreferPKCS1Format AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liPreferPKCS1Format AS Integer, lqDERFormattedPublicKey AS VarBinary
		
		STORE 0 TO m.liPreferPKCS1Format, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDERFormattedPublicKey
		
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liPreferPKCS1Format = .LogicalToBit(m.tuPreferPKCS1Format)
		
		      TRY
		
		        lqDERFormattedPublicKey = m.loChilkatObject.GetDER(m.liPreferPKCS1Format)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDERFormattedPublicKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getderbd		&& Introduced in version 11.0.0. Returns the public key in binary DER format into bd. For key types that support both PKCS1 and PKCS8 formats (e.g., RSA), preferPkcs1 specifies the format to be returned. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetDerBd
		* Purpose:           Returns the public key in binary DER format into bd. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuPkcs1Format, whether or not to use Pkcs1 format
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Returns the public key in binary DER format into bd. 
		** For key types that support both PKCS1 and PKCS8 formats (e.g., RSA), 
		** preferPkcs1 specifies the format to be returned.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuPkcs1Format AS Unknown, toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown, liUsePkcs1Format AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUsePkcs1Format
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUsePkcs1Format = .LogicalToBit(m.tuPkcs1Format)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetDerBd(m.liUsePkcs1Format) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = m.loParkParameterBinData.SetObject(;
		      m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.luReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getencoded		&& Introduced in version 9.5.0.58. Returns the public key in DER format as an encoded string (such as base64 or hex). If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, then preferPkcs1 determine which format is returned.
		*==============================================================================
		* Method:            GetEncoded
		* Purpose:           Returns the public key in DER format as an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuPreferPKCS1Format, whether or not to return PKCS1 format.
		*                    tcEncoding, the return string encoding.
		* Returns:           The encoded public key.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.58
		**
		** Returns the public key in DER format as an encoded string (such as base64 or hex). 
		** If the key type (such as RSA) supports both PKCS1 and PKCS8 formats, 
		** then preferPkcs1 determine which format is returned. 
		** The encoding specifies the encoding, which is typically "base64".
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tuPreferPKCS1Format AS Unknown, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liPreferPKCS1Format AS Integer, lcEncodedString AS Character
		
		STORE 0 TO m.liPreferPKCS1Format, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcEncodedString = []
		llImplemented = .F.
		liIntroducedInBuild = 58
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liPreferPKCS1Format = .LogicalToBit(m.tuPreferPKCS1Format)
		
		      TRY
		
		        lcEncodedString = m.loChilkatObject.GetEncoded(m.liPreferPKCS1Format, m.tcEncoding)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcEncodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getjwk		&& Introduced in version 9.5.0.66. Gets the public key in JWK (JSON Web Key) format.
		*==============================================================================
		* Method:            GetJWK
		* Purpose:           Gets the public key in JWK (JSON Web Key) format.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The public key in JWK format.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Gets the public key in JWK (JSON Web Key) format.
		** 
		** RSA public keys have this JWK format:
		** 
		**          {"kty":"RSA",
		**           "n": "0vx7agoebGcQSuuPiLJXZptN9 ... U8awapJzKnqDKgw",
		**           "e":"AQAB"}
		** 
		** ECC public keys have this JWK format:
		** 
		**          {"kty":"EC",
		**           "crv":"P-256",
		**           "x":"MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4",
		**           "y":"4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM"}
		** 
		** Ed25519 public keys (added in v9.5.0.83) have this JWK format:
		** 
		**          {"kty":"OKP",
		**           "crv":"Ed25519",
		**           "x": "SE2Kne5xt51z1eciMH2T2ftDQp96Gl6FhY6zSQujiP0"}
		** 
		**
		** Fixed for Version 11.6.0: JWK validation now fails on missing 
		** required members, unsupported key type, or a zero RSA exponent, 
		** without leaving a partially initialized object.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcJWKFormattedKey AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcJWKFormattedKey = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcJWKFormattedKey = m.loChilkatObject.GetJWK()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcJWKFormattedKey
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getjwkthumbprint		&& Introduced in version 9.5.0.66. Returns the JWK thumbprint for the public key. This is the thumbprint of the JSON Web Key (JWK) as per RFC 7638. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetJWKThumbPrint
		* Purpose:           Returns the JWK thumbprint for the public key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHashAlgorithm, the hash algorithm
		* Returns:           The JWK thumbprint for the public key.
		* Date Added:        06/20/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.66
		** 
		** Returns the JWK thumbprint for the public key. 
		** This is the thumbprint of the JSON Web Key (JWK) as per RFC 7638.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement to Version 95: Added support for SHA224 
		** in all places where a hash algorithm might be specified.
		**
		** Fixed for Version 11.6.0: Unsupported/empty 
		** hash algorithm now fails instead of using SHA-1.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcHashAlgorithm AS Character
		
		LOCAL loChilkatObject AS CHILKAT_PUBLICKEY_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcJWKThumbPrint AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcJWKThumbPrint = []
		llImplemented = .F.
		liIntroducedInBuild = 66
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcJWKThumbPrint = m.loChilkatObject.GetJWKThumbPrint(m.tcHashAlgorithm)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcJWKThumbPrint
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_PUBLICKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

