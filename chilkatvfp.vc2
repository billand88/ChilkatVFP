	PROCEDURE downloadfilebyname		&& Simplified method for downloading files. The last-modified date/time is only preserved when the PreserveDate property is set to 1. (The default value of PreserveDate is 0.)
		*==============================================================================
		* Method:            DownloadFileByName
		* Purpose:           Simplified method for downloading files.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteFilePath -- the OpenFile() remote file handle
		*                    tcLocalFilePath, the local file name
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/20/2022
		*==============================================================================
		
		**
		** Simplified method for downloading files.
		**
		** The last-modified date/time is only preserved when the PreserveDate property is set to 1. 
		** (The default value of PreserveDate is 0.)
		**
		** Important: If the remoteFilePath is an absolute path, 
		** then it is a path from the root of the server's filesystem. 
		** For example, "/home/joe/someFile.txt". Use a relative path to specify 
		** a directory relative to the $HOME directory of the SSH user account. 
		** For example, "./someFile.txt".
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Enhancement for version 75: Downloading to a file will check 
		** to see if the local target file already exists. If so, it will try to delete it prior to downloading. 
		** If it is not possible to delete, then this method will return failure before trying to download the file.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcRemoteFilePath AS Character, tcLocalFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DownloadFileByName(m.tcRemoteFilePath, m.tcLocalFilePath) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE downloadfilebynameasync		&& Creates an asynchronous task to call the DownloadFileByName method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            DownloadFileByNameAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    DownloadFileByName method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemoteFilePath -- the OpenFile() remote file handle
		*                    tcLocalFilePath, the local file name
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/20/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the DownloadFileByName method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Enhancement for version 75: Downloading to a file will check 
		** to see if the local target file already exists. If so, it will try to delete it prior to downloading. 
		** If it is not possible to delete, then this method will return failure before trying to download the file.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemoteFilePath AS Character, tcLocalFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.DownloadFileByNameAsync(m.tcRemoteFilePath, m.tcLocalFilePath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE downloadsb		&& Introduced in version 9.5.0.62. Downloads the contents of a remote file to a StringBuilder object. (Appends to the StringBuilder.) Returns 1 for success, 0 for failure.
		*==============================================================================
