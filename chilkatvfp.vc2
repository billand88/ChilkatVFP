		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonArray, m.loChilkatJsonArray
		
		llImplemented = .F.
		liIntroducedInBuild = 89
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterJsonArray = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonArray)
		
		      loChilkatJsonArray = m.loParkParameterJsonArray.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetBodyJArr(m.loChilkatJSONArray) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatJsonArray = m.loParkParameterJsonArray.SetObject(;
		      m.toChilkatJsonArray, m.loChilkatJsonArray)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterJsonArray, m.loChilkatJsonArray
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTPRESPONSE_COM_CALL)
		  toChilkatJSONArray = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  loParkParameterJsonArray = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonArray = NEWOBJECT(CHILKAT_JSONARRAY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getbodyjson		&& Introduced in version 9.5.0.89. Loads the JSON response body into a JsonObject. This method should only be called when it is known that the response body contains JSON (beginning with a curly brace '{' and ending with a curly brace '}')
		*==============================================================================
		* Method:            GetBodyJSON
		* Purpose:           Loads the JSON response body into a JsonObject.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatJSONObject, a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
