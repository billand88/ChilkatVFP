		  loException = NEWOBJECT([Exception])
		  
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE verboselogging_access		&& Access method used to retrieve the Chilkat Cache VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Access
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.VerboseLogging
		* Date Added:        06/28/2022
		*==============================================================================
		
		** 
		** If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) 
		** may contain more verbose information. The default value is 0. 
		** Verbose logging should only be used for debugging. 
		** The potentially large quantity of logged information may adversely affect peformance.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*==============================================================================
		* Method:            VerboseLogging_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the VerboseLogging property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer or logical value 
		*                    used to hold a reference to the VerboseLogging property.
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

ENDDEFINE

DEFINE CLASS cert AS ibasechilkat OF "chilkatvfp.vcx" 		&& Digital certificate component / class
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: authoritykeyid_access		&& Access method used to retrieve the Chilkat Cert AuthorityKeyID property.
		*m: authoritykeyid_assign		&& Assign method used to hold a reference to the AuthorityKeyID property.
		*m: avoidwindowspkaccess_access		&& Access method used to retrieve the Chilkat Cert AvoidWindowsPKAccess property.
		*m: avoidwindowspkaccess_assign		&& Assign method used to hold a reference to the AvoidWindowsPKAccess property.
		*m: buildcertchain		&& Introduced in version 11.0.0. Builds the certificate chain in certChain containing all the certificates (including this one), in the chain of authentication to the trusted root (if possible).
		*m: certversion_access		&& Access method used to retrieve the Chilkat Cert CertVersion property.
		*m: certversion_assign		&& Assign method used to hold a reference to the CertVersion property.
		*m: checkrevoked		&& Returns 1 if the certificate has been revoked, 0 if not revoked, and -1 if unable to check the revocation status. Note: This method is only implemented on Windows systems.
		*m: checksmartcardpin		&& Introduced in version 9.5.0.77. Verifies that the SmartCardPin property setting is correct. Returns 1 if correct, 0 if incorrect, and -1 if unable to check because the underlying CSP does not support the functionality.
		*m: cspname_access		&& Access method used to retrieve the Chilkat Cert CSPName property.
		*m: cspname_assign		&& Assign method used to hold a reference to the CSPName property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Cert DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: expired_access		&& Access method used to retrieve the Chilkat Cert Expired property.
		*m: expired_assign		&& Assign method used to hold a reference to the Expired property.
		*m: exportcertder		&& Exports the digital certificate to ASN.1 DER format. Returns a zero-length byte array (as a Variant) on failure.
		*m: exportcertderbd		&& Introduced in version 9.5.0.70. Exports the digital certificate in ASN.1 DER format to a BinData object. Returns 1 for success, 0 for failure.
		*m: exportcertderfile		&& Exports the digital certificate to ASN.1 DER format binary file. Returns 1 for success, 0 for failure.
		*m: exportcertpem		&& Exports the digital certificate to an unencrypted PEM formatted string. Returns Nothing on failure.
		*m: exportcertpemfile		&& Exports the digital certificate to an unencrypted PEM formatted file. Returns 1 for success, 0 for failure.
		*m: exportcertxml		&& Exports a certificate to an XML format where the XML tags are the names of the ASN.1 objects that compose the X.509 certificate. Binary data is either hex or base64 encoded.
		*m: exportprivatekey		&& Exports the certificate's private key. Returns Nothing on failure.
		*m: exportpublickey		&& Exports the certificate's public key. Returns Nothing on failure.
		*m: exporttopfxbd		&& Introduced in version 9.5.0.70. Exports the certificate and private key (if available) to pfxData. The password is what will be required to access the PFX contents at a later time.
		*m: exporttopfxdata		&& Introduced in version 9.5.0.31. Exports the certificate and private key (if available) to an in-memory PFX image. The password is what will be required to access the PFX contents at a later time.
		*m: exporttopfxfile		&& Exports the certificate and private key (if available) to a PFX (.pfx or .p12) file. The output PFX is secured using the pfxPassword. If bIncludeCertChain is 1, then the certificates in the chain of authority are also included in the PFX output file.
		*m: extendedkeyusage_access		&& Access method used to retrieve the Chilkat Cert ExtendedKeyUsage property.
		*m: extendedkeyusage_assign		&& Assign method used to hold a reference to the ExtendedKeyUsage property.
		*m: findissuer		&& Finds and returns the issuer certificate. If the certificate is a root or self-issued, then the certificate returned is a copy of the caller certificate. (The IsRoot property can be check to see if the certificate is a root (or self-issued) certificate.)
		*m: forclientauthentication_access		&& Access method used to retrieve the Chilkat Cert ForClientAuthentication property.
		*m: forclientauthentication_assign		&& Assign method used to hold a reference to the ForClientAuthentication property.
		*m: forcodesigning_access		&& Access method used to retrieve the Chilkat Cert ForCodeSigning property.
		*m: forcodesigning_assign		&& Assign method used to hold a reference to the ForCodeSigning property.
		*m: forsecureemail_access		&& Access method used to retrieve the Chilkat Cert ForSecureEmail property.
		*m: forsecureemail_assign		&& Assign method used to hold a reference to the ForSecureEmail property.
		*m: forserverauthentication_access		&& Access method used to retrieve the Chilkat Cert ForServerAuthentication property.
		*m: forserverauthentication_assign		&& Assign method used to hold a reference to the ForServerAuthentication property.
		*m: fortimestamping_access		&& Access method used to retrieve the Chilkat Cert ForTimeStamping property.
		*m: fortimestamping_assign		&& Assign method used to hold a reference to the ForTimeStamping property.
		*m: getcertchain		&& Introduced in version 9.5.0.40. Returns a certficate chain object containing all the certificates (including this one), in the chain of authentication to the trusted root (if possible).
		*m: getencoded		&& Returns a base64 encoded string representation of the certificate's binary DER format, which can be passed to SetFromEncoded to recreate the certificate object. Returns Nothing on failure.
		*m: getextensionastext		&& Introduced in version 9.5.0.89. Returns the certificate extension data as a string. This method should only be called for those extensions with text values NOT stored as binary ASN.1.
		*m: getextensionasxml		&& Introduced in version 9.5.0.49. Returns the certificate extension data in XML format (converted from ASN.1). The oid is an OID, such as the ones listed here: http://www.alvestrand.no/objectid/2.5.29.html
		*m: getextensionbd		&& Introduced in version 9.5.0.96. Returns the certificate extension data specified by oid in bd. Returns 1 for success, 0 for failure.
		*m: getprivatekey		&& Introduced in version 11.0.0. Loads the privKey with the certificate's private key, if it exists. Returns 0 if the certificate has no associated private key. Returns 1 for success, 0 for failure.
		*m: getprivatekeypem		&& Exports the certificate's private key to a PEM string (if the private key is available). Returns Nothing on failure.
		*m: getpubkeyder		&& Introduced in version 9.5.0.92. Loads the bd with the certificate's public key in ASN.1 DER format.
		*m: getpublickey		&& Introduced in version 11.0.0. Loads the pubKey with the certificate's public key. Returns 1 for success, 0 for failure.
		*m: getsignature		&& Introduced in version 9.5.0.92. Loads the bd with the certificate's signature. Returns 1 for success, 0 for failure.
		*m: getspkifingerprint		&& Introduced in version 9.5.0.55. Returns the SPKI Fingerprint suitable for use in pinning. (See RFC 7469.)
		*m: getsubjectpart		&& Introduced in version 9.5.0.85. Returns a part of the certificate's subject by name or OID. The partNameOrOid can be a part name, such as "CN", "O", "OU", "E", "S", "L", "C", or "SERIALNUMBER", or it can be an OID such as "2.5.4.3".
		*m: getvalidfromdt		&& Returns the date/time this certificate becomes (or became) valid. Returns Nothing on failure.
		*m: getvalidtodt		&& Returns the date/time this certificate becomes (or became) invalid. Returns Nothing on failure.
		*m: hashof		&& Introduced in version 9.5.0.75. Returns an encoded hash of a particular part of the certificate. The part may be one of the following: IssuerDN - IssuerPublicKey - SubjectDN -
		*m: haskeycontainer_access		&& Access method used to retrieve the Chilkat Cert HasKeyContainer property.
		*m: haskeycontainer_assign		&& Assign method used to hold a reference to the HasKeyContainer property.
		*m: hasprivatekey		&& Returns 1 if a private key associated with the certificate is available.
		*m: intendedkeyusage_access		&& Access method used to retrieve the Chilkat Cert IntendedKeyUsage property.
		*m: intendedkeyusage_assign		&& Assign method used to hold a reference to the IntendedKeyUsage property.
		*m: isecdsa		&& Introduced in version 10.1.0. Returns 1 if certificate is ECDSA-based (i.e. has an ECDSA key).
		*m: isroot_access		&& Access method used to retrieve the Chilkat Cert IsRoot property.
		*m: isroot_assign		&& Assign method used to hold a reference to the IsRoot property.
		*m: isrsa		&& Introduced in version 10.1.0. Returns 1 if certificate is RSA-based (i.e. has an RSA key).
		*m: issuercn_access		&& Access method used to retrieve the Chilkat Cert IssuerCN property.
		*m: issuercn_assign		&& Assign method used to hold a reference to the IssuerCN property.
		*m: issuerc_access		&& Access method used to retrieve the Chilkat Cert IssuerC property.
		*m: issuerc_assign		&& Assign method used to hold a reference to the IssuerC property.
		*m: issuerdn_access		&& Access method used to retrieve the Chilkat Cert IssuerDN property.
		*m: issuerdn_assign		&& Assign method used to hold a reference to the IssuerDN property.
		*m: issuere_access		&& Access method used to retrieve the Chilkat Cert IssuerE property.
		*m: issuere_assign		&& Assign method used to hold a reference to the IssuerE property.
		*m: issuerl_access		&& Access method used to retrieve the Chilkat Cert IssuerL property.
		*m: issuerl_assign		&& Assign method used to hold a reference to the IssuerL property.
		*m: issuerou_access		&& Access method used to retrieve the Chilkat Cert IssuerOU property.
		*m: issuerou_assign		&& Assign method used to hold a reference to the IssuerOU property.
		*m: issuero_access		&& Access method used to retrieve the Chilkat Cert IssuerO property.
		*m: issuero_assign		&& Assign method used to hold a reference to the IssuerO property.
		*m: issuers_access		&& Access method used to retrieve the Chilkat Cert IssuerS property.
		*m: issuers_assign		&& Assign method used to hold a reference to the IssuerS property.
		*m: keycontainername_access		&& Access method used to retrieve the Chilkat Cert KeyContainerName property.
		*m: keycontainername_assign		&& Assign method used to hold a reference to the KeyContainerName property.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Cert LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Cert LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Cert LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Cert LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Cert LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Cert LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Cert LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: linkpkcs11		&& Introduced in version 9.5.0.96. Links to the certificate's private key located on an HSM (smart card, token, or cloud HSM). Once linked, the certificate can be used for signing where the signing occurs on the HSM.
		*m: loadbycommonname		&& (Relevant only when running on a Microsoft Windows operating system.) Searches the Windows Local Machine and Current User registry-based certificate stores for a certificate having the common name specified.
		*m: loadbyemailaddress		&& (Relevant only when running on a Microsoft Windows operating system.) Searches the Windows Local Machine and Current User registry-based certificate stores for a certificate containing the email address specified.
		*m: loadbyissuerandserialnumber		&& (Relevant only when running on a Microsoft Windows operating system.) Searches the Windows Local Machine and Current User registry-based certificate stores for a certificate matching the issuerCN and having an issuer matching the serialNumber.
		*m: loadbysubjectoid		&& Introduced in version 9.5.0.85. Searches the Windows Local Machine and Current User registry-based certificate stores for a certificate containing a subject part matching the oid and value.
		*m: loadbythumbprint		&& Searches the Windows Local Machine and Current User registry-based certificate stores for a certificate having an MD5 or SHA1 thumbprint equal to the thumbprint.
		*m: loadfrombase64		&& Loads an ASN.1 or DER encoded certificate represented in a Base64 string. Returns 1 for success, 0 for failure.
		*m: loadfrombd		&& Introduced in version 9.5.0.70. Loads an X.509 certificate from data contained in certBytes.Note: The certBytes may contain the certificate in any format. It can be binary DER (ASN.1), PEM, Base64, etc. Chilkat will automatically detect the format.
		*m: loadfrombinary		&& Loads an X.509 certificate from ASN.1 DER encoded bytes. Note: The data may contain the certificate in any format. It can be binary DER (ASN.1), PEM, Base64, etc. Chilkat will automatically detect the format. Returns 1 for success, 0 for failure.
		*m: loadfromfile		&& Loads a certificate from a .cer, .crt, .p7b, or .pem file.
		*m: loadfromsmartcard		&& Introduced in version 9.5.0.77. Starting in Chilkat v9.5.0.87, the csp can be a string that specifies the certificate to be loaded by either Subject Common Name (CN) or hex serial number.
		*m: loadpem		&& Introduced in version 9.5.0.49. Loads the certificate from a PEM string. Returns 1 for success, 0 for failure.
		*m: loadpfxbd		&& Introduced in version 9.5.0.70. Loads the certificate from the PFX contained in pfxData. Note: If the PFX contains multiple certificates, the 1st certificate in the PFX is loaded. Returns 1 for success, 0 for failure.
		*m: loadpfxdata		&& Loads a PFX from an in-memory image of a PFX file. Note: If the PFX contains multiple certificates, the 1st certificate in the PFX is loaded. Returns 1 for success, 0 for failure.
		*m: loadpfxfile		&& Loads a PFX file. Note: If the PFX contains multiple certificates, the 1st certificate in the PFX is loaded. Returns 1 for success, 0 for failure.
		*m: loadtaskresult		&& Introduced in version 9.5.0.52. Loads the certificate from a completed asynchronous task. Returns 1 for success, 0 for failure.
		*m: machinekeyset_access		&& Access method used to retrieve the Chilkat Cert MachineKeySet property.
		*m: machinekeyset_assign		&& Assign method used to hold a reference to the MachineKeySet property.
		*m: ocspurl_access		&& Access method used to retrieve the Chilkat Cert OCSPURL property.
		*m: ocspurl_assign		&& Assign method used to hold a reference to the OCSPURL property.
		*m: pemfiletoderfile		&& Converts a PEM file to a DER file. Returns 1 for success, 0 for failure.
		*m: privatekeyexportable_access		&& Access method used to retrieve the Chilkat Cert PrivateKeyExportable property.
		*m: privatekeyexportable_assign		&& Assign method used to hold a reference to the PrivateKeyExportable property.
		*m: revoked_access		&& Access method used to retrieve the Chilkat Cert Revoked property.
		*m: revoked_assign		&& Assign method used to hold a reference to the Revoked property.
		*m: rfc822name_access		&& Access method used to retrieve the Chilkat Cert RFC822Name property.
		*m: rfc822name_assign		&& Assign method used to hold a reference to the RFC822Name property.
		*m: savetofile		&& Saves a certificate object to a .cer file. Returns 1 for success, 0 for failure.
		*m: selfsigned_access		&& Access method used to retrieve the Chilkat Cert SelfSigned property.
		*m: selfsigned_assign		&& Assign method used to hold a reference to the SelfSigned property.
		*m: serialdecimal_access		&& Access method used to retrieve the Chilkat Cert SerialDecimal property.
		*m: serialdecimal_assign		&& Assign method used to hold a reference to the SerialDecimal property.
		*m: serialnumber_access		&& Access method used to retrieve the Chilkat Cert SerialNumber property.
		*m: serialnumber_assign		&& Assign method used to hold a reference to the SerialNumber property.
		*m: setcloudsigner		&& Introduced in version 9.5.0.96. Provides information for a cloud signing service to do the signing via a remote signing server. Current supported services are AWS KMS, Azure Key Vault, and ARSS (Aruba Remote Signing Service).
		*m: setfromencoded		&& Initializes the certificate object from a base64 encoded string representation of the certificate's binary DER format. Returns 1 for success, 0 for failure.
		*m: setprivatekey		&& Used to associate a private key with the certificate for subsequent (PKCS7) signature creation or decryption. Returns 1 for success, 0 for failure.
		*m: setprivatekeypem		&& Same as SetPrivateKey, but the key is provided in unencrypted PEM format. (Note: The privKeyPem is not a file path, it is the actual PEM text.) Returns 1 for success, 0 for failure.
		*m: sha1thumbprint_access		&& Access method used to retrieve the Chilkat Cert SHA1Thumbprint property.
		*m: sha1thumbprint_assign		&& Assign method used to hold a reference to the SHA1Thumbprint property.
		*m: signatureverified_access		&& Access method used to retrieve the Chilkat Cert SignatureVerified property.
		*m: signatureverified_assign		&& Assign method used to hold a reference to the SignatureVerified property.
		*m: silent_access		&& Access method used to retrieve the Chilkat Cert Silent property.
		*m: silent_assign		&& Assign method used to hold a reference to the Silent property.
		*m: smartcardfailreason_access		&& Access method used to retrieve the Chilkat Cert SmartCardFailReason property.
		*m: smartcardfailreason_assign		&& Assign method used to hold a reference to the SmartCardFailReason property.
		*m: smartcardnodialog_access		&& Access method used to retrieve the Chilkat Cert SmartCardNoDialog property.
		*m: smartcardnodialog_assign		&& Assign method used to hold a reference to the SmartCardNoDialog property.
		*m: smartcardpin_access		&& Access method used to retrieve the Chilkat Cert SmartCardPIN property.
		*m: smartcardpin_assign		&& Assign method used to hold a reference to the SmartCardPIN property.
		*m: subjectalternativename_access		&& Access method used to retrieve the Chilkat Cert SubjectAlternativeName property.
		*m: subjectalternativename_assign		&& Assign method used to hold a reference to the SubjectAlternativeName property.
		*m: subjectcn_access		&& Access method used to retrieve the Chilkat Cert SubjectCN property.
		*m: subjectcn_assign		&& Assign method used to hold a reference to the SubjectCN property.
		*m: subjectc_access		&& Access method used to retrieve the Chilkat Cert SubjectC property.
		*m: subjectc_assign		&& Assign method used to hold a reference to the SubjectC property.
		*m: subjectdn_access		&& Access method used to retrieve the Chilkat Cert SubjectDN property.
		*m: subjectdn_assign		&& Assign method used to hold a reference to the SubjectDN property.
		*m: subjecte_access		&& Access method used to retrieve the Chilkat Cert SubjectE property.
		*m: subjecte_assign		&& Assign method used to hold a reference to the SubjectE property.
		*m: subjectkeyid_access		&& Access method used to retrieve the Chilkat Cert SubjectKeyID property.
		*m: subjectkeyid_assign		&& Assign method used to hold a reference to the SubjectKeyID property.
		*m: subjectl_access		&& Access method used to retrieve the Chilkat Cert SubjectL property.
		*m: subjectl_assign		&& Assign method used to hold a reference to the SubjectL property.
		*m: subjectou_access		&& Access method used to retrieve the Chilkat Cert SubjectOU property.
		*m: subjectou_assign		&& Assign method used to hold a reference to the SubjectOU property.
		*m: subjecto_access		&& Access method used to retrieve the Chilkat Cert SubjectO property.
		*m: subjecto_assign		&& Assign method used to hold a reference to the SubjectO property.
		*m: subjects_access		&& Access method used to retrieve the Chilkat Cert SubjectS property
		*m: subjects_assign		&& Assign method used to hold a reference to the SubjectS property.
		*m: trustedroot_access		&& Access method used to retrieve the Chilkat Cert TrustedRoot property
		*m: trustedroot_assign		&& Assign method used to hold a reference to the TrustedRoot property.
		*m: uncommonoptions_access		&& Access method used to retrieve the Chilkat Cert UncommonOptions property
		*m: uncommonoptions_assign		&& Assign method used to hold a reference to the UncommonOptions property.
		*m: unload		&& Introduced in version 11.0.0. Unload the certificate, which could mean closing a PKCS11 session if the certificate was loaded from a smart card.
		*m: uploadtocloud		&& Introduced in version 9.5.0.96. This is an open-ended method to accomodate uploading the private key to a cloud service, such as AWS KMS, or Azure Key Vault. For details, see the examples below. Returns 1 for success, 0 for failure.
		*m: uploadtocloudasync		&& Introduced in version 9.5.0.96. Creates an asynchronous task to call the UploadToCloud method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: usecertvault		&& Introduced in version 9.5.0.40. Adds an XML certificate vault to the object's internal list of sources to be searched for certificates for help in building certificate chains and verifying the certificate signature to the trusted root.
		*m: validfromstr_access		&& Access method used to retrieve the Chilkat Cert ValidFromStr property
		*m: validfromstr_assign		&& Assign method used to hold a reference to the ValidFromStr property.
		*m: validtostr_access		&& Access method used to retrieve the Chilkat Cert ValidToStr property
		*m: validtostr_assign		&& Assign method used to hold a reference to the ValidToStr property.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Cert VerboseLogging property
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*m: verifysignature		&& Introduced in version 9.5.0.40. Verifies the certificate signature, as well as the signatures of all certificates in the chain of authentication to the trusted root. Returns 1 if all signatures are verified to the trusted root. Otherwise returns 0.
		*m: x509pkipathv1		&& Introduced in version 9.5.0.77. Returns the base64 representation of an X509PKIPathv1 containing just the calling certificate. This is typically used in an X.509 Binary Security Token.
		*p: authoritykeyid		&& Introduced in version 9.5.0.40. The authority key identifier of the certificate in base64 string format. This is only present if the certificate contains the extension OID 2.5.29.35.
		*p: avoidwindowspkaccess		&& Applies only when running on a Microsoft Windows operating system. If 1, then any method that returns a certificate will not try to also access the associated private key, assuming one exists.
		*p: certversion		&& The version of the certificate (1, 2, or 3). A value of 0 indicates an error -- the most likely cause being that the certificate object is empty (i.e. was never loaded with a certificate).
		*p: cspname		&& (Relevant only when running on a Microsoft Windows operating system.) If the HasKeyContainer property is 1, then the certificate is linked to a key container and this property contains the name of the associated CSP (cryptographic service provider).
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: expired		&& Has a value of 1 if the certificate or any certificate in the chain of authority has expired. (This information is not available when running on Windows 95/98 computers.)
		*p: extendedkeyusage		&& Introduced in version 9.5.0.85. Returns a string containing a comma separated list of keywords with the extended key usages of the certificate.
		*p: forclientauthentication		&& 1 if this certificate can be used for client authentication, otherwise 0.
		*p: forcodesigning		&& 1 if this certificate can be used for code signing, otherwise 0.
		*p: forsecureemail		&& 1 if this certificate can be used for sending secure email, otherwise 0.
		*p: forserverauthentication		&& 1 if this certificate can be used for server authentication, otherwise 0.
		*p: fortimestamping		&& 1 if this certificate can be used for time stamping, otherwise 0.
		*p: haskeycontainer		&& (Relevant only when running on a Microsoft Windows operating system.) Indicates whether this certificate is linked to a key container. If 1 then the certificate is linked to a key container (usually containing a private key). If 0, then it is not.
		*p: intendedkeyusage		&& Bitflags indicating the intended usages of the certificate. The flags are: Digital Signature: 0x80 Non-Repudiation: 0x40 Key Encipherment: 0x20 Data Encipherment: 0x10
		*p: isroot		&& 1 if this is the root certificate, otherwise 0.
		*p: issuerc		&& The certificate issuer's country.
		*p: issuercn		&& The certificate issuer's common name.
		*p: issuerdn		&& The issuer's full distinguished name.
		*p: issuere		&& The certificate issuer's email address.
		*p: issuerl		&& The certificate issuer's locality, which could be a city, count, township, or other geographic region.
		*p: issuero		&& The certificate issuer's organization, which is typically the company name.
		*p: issuerou		&& The certificate issuer's organizational unit, which is the unit within the organization.
		*p: issuers		&& The certificate issuer's state or province.
		*p: keycontainername		&& (Relevant only when running on a Microsoft Windows operating system.) If the HasKeyContainer property is 1, then the certificate is linked to a key container and this property contains the name of the key container.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: machinekeyset		&& If the HasKeyContainer property is 1, then the certificate is linked to a key container and this property indicates whether the key container is in the machine's keyset or in the keyset specific to the logged on user's account.
		*p: ocspurl		&& If present in the certificate's extensions, returns the OCSP URL of the certificate. (The Online Certificate Status Protocol (OCSP) is an Internet protocol used for obtaining the revocation status of an X.509 digital certificate.)
		*p: privatekeyexportable		&& (Relevant only when running on a Microsoft Windows operating system.) Indicates whether the private key was installed with security settings that allow it to be re-exported.
		*p: revoked		&& 1 if the certificate or any certificate in the chain of authority has been revoked. This information is not available when running on Windows 95/98 computers. Note: If this property is 0, it could mean that it was not able to check the revocation statu
		*p: rfc822name		&& The RFC822 name of the certificate. (The RFC822 name is one part of the Subject Alternative Name extension of a certificate, if it exists. It is often the only part of the SAN.)
		*p: selfsigned		&& 1 if this is a self-signed certificate, otherwise 0.
		*p: serialdecimal		&& Introduced in version 9.5.0.75. The certificate's serial number as a decimal string.
		*p: serialnumber		&& The certificate's serial number as a hexidecimal string.
		*p: sha1thumbprint		&& Hexidecimal string of the SHA-1 thumbprint for the certificate. (This is the SHA1 hash of the binary DER representation of the entire X.509 certificate.)
		*p: signatureverified		&& Returns 1 if the certificate and all certificates in the chain of authority have valid signatures, otherwise returns 0.
		*p: silent		&& If the HasKeyContainer property is 1, then the certificate is linked to a key container and this property indicates that the key container will attempt to open any keys silently without any user interface prompts.
		*p: smartcardfailreason		&& Introduced in version 10.1.0. Set after calling LoadFromSmartcard.
		*p: smartcardnodialog		&& Introduced in version 9.5.0.77. If set to 1, then no dialog will automatically popup if the SmartCardPin is incorrect. Instead, the method requiring the private key on the smart card will fail.
		*p: smartcardpin		&& Introduced in version 9.5.0.75. Can be set to the PIN value for a certificate / private key stored on a smart card.
		*p: subjectalternativename		&& Introduced in version 9.5.0.85. The subject alternative name (SAN) name of the certificate returned as XML.
		*p: subjectc		&& The certificate subject's country.
		*p: subjectcn		&& The certificate subject's common name.
		*p: subjectdn		&& The certificate subject's full distinguished name.
		*p: subjecte		&& The certificate subject's email address.
		*p: subjectkeyid		&& Introduced in version 9.5.0.40. The subject key identifier of the certificate in base64 string format. This is only present if the certificate contains the extension OID 2.5.29.14.
		*p: subjectl		&& The certificate subject's locality, which could be a city, count, township, or other geographic region.
		*p: subjecto		&& The certificate subject's organization, which is typically the company name.
		*p: subjectou		&& The certificate subject's organizational unit, which is the unit within the organization.
		*p: subjects		&& The certificate subject's state or province.
		*p: trustedroot		&& Returns 1 if the certificate has a trusted root authority, otherwise returns 0.
		*p: uncommonoptions		&& Introduced in version 9.5.0.87. This is a catch-all property to be used for uncommon needs. This property defaults to the empty string, and should typically remain empty.
		*p: validfromstr		&& The date (in RFC822 string format) that this certificate becomes (or became) valid. It is a GMT/UTC date that is returned.
		*p: validtostr		&& The date (in RFC822 string format) that this certificate becomes (or became) invalid. It is a GMT/UTC date that is returned.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

