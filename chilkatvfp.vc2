	PROCEDURE gethtmlbodysb		&& Introduced in version 10.1.2. Returns the body having the "text/html" content type. If inlineImageData is 1, the related images found in the MIME are inlined as base64 directly within the returned HTML. The HTML is returned in sb.
		*==============================================================================
		* Method:            GetHTMLBodySb
		* Purpose:           Returns the body having the "text/html" content type. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuInLineImageData, determines whether or not the related 
		*                    images found in the MIME are inlined.
		*                    toStringBuilder, a Chilkat StringBuilder object.
		* Returns:           Returns the related header field, or the empty string.
		* Date Added:        01/28/2025
		*==============================================================================
		
		**
		** Introduced in version 10.1.2
		**
		** Returns the body having the "text/html" content type. If inlineImageData is 1, 
		** the related images found in the MIME are inlined as base64 directly within the returned HTML. 
		** The HTML is returned in sb.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuInLineImageData AS Unknown, toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, liInLineImageData AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liInLineImageData, liReturn, luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder  
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 2)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liInLineImageData = .LogicalToBit(m.tuInLineImageData)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetHTMLBodySb(m.liInLineImageData, m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getimapuid		&& This method returns the UID if ckx-imap-uid exists and contains a UID, otherwise it returns -1.
		*==============================================================================
		* Method:            GetIMAPUID
		* Purpose:           This method returns the UID if ckx-imap-uid 
		*                    exists and contains a UID, otherwise it returns -1.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           liUID, the UID if it exists.
		* Date Added:        01/25/2022
		*==============================================================================
		
		**
		** When email headers are downloaded from an IMAP server (using Chilkat IMAP), 
		** a "ckx-imap-uid" header field is added. 
		** The content of this header is the UID or sequence number 
		** of the email on the IMAP server. 
		** In addition, a "ckx-imap-isUid" header field is added, 
		** and this will have the value YES or NO. 
		** If the value is YES, then ckx-imap-uid contains a UID, 
		** if the value is NO, then ckx-imap-uid contains the sequence number. 
		** This method returns the UID if ckx-imap-uid exists and contains a UID, otherwise it returns -1.
		**
		** An application that wishes to download the full email would use this UID 
		** and then call the Chilkat IMAP object's FetchSingle or FetchSingleAsMime methods.
		**
		** Note: If an email was downloaded from the IMAP server 
		** in a way such that the UID is not received, 
		** then there will be no "ckx-imap-uid" header field 
		** and this method would return -1. For example, 
		** if emails are downloaded by sequence numbers via the Imap.FetchSequence method, 
		** then UIDs are not used and therefore the email object will not contain this information.
		**
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loException AS Exception, liUID AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liUID = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liUID = m.loChilkatObject.GetIMAPUID()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liUID
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

