	PROCEDURE startkeyboardauth		&& Introduced in version 9.5.0.46. Begins keyboard-interactive authentication with the SSH server. Returns an XML string providing the name, instruction, and prompts.
		*==============================================================================
		* Method:            StartKeyboardAuth
		* Purpose:           Begins keyboard-interactive authentication with the SSH server.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLogin -- the login name.
		* Returns:           Character, in XML format.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.46
		** 
		** Begins keyboard-interactive authentication with the SSH server. 
		** Returns an XML string providing the name, instruction, and prompts. 
		** The XML has the following format:
		** 
		**    <infoRequest numPrompts="N">
		**       <name>name_string</name>
		**       <instruction>instruction_string</instruction>
		**       <prompt1 echo="1_or_0">prompt_string</prompt1>
		**       ...
		**       <promptN echo="1_or_0">prompt_string</promptN>
		**   </infoRequest>
		** 
		** If the authentication immediately succeeds because no password is required, 
		** or immediately fails, the XML response can be:
		** 
		** <success>success_message</success>
		** 
		** or
		** 
		** <error>error_message</error>
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLogin AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcXML AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcXML = []
		llImplemented = .F.
		liIntroducedInBuild = 46
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcXML = m.loChilkatObject.StartKeyboardAuth(m.tcLogin)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcXML
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE startkeyboardauthasync		&& Introduced in version 9.5.0.46. Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            StartKeyboardAuthAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    StartKeyboardAuth method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLogin -- the login name.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/10/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the StartKeyboardAuth method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLogin AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52 && 46
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.StartKeyboardAuthAsync(m.tcLogin)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE stderrtostdout_access		&& Access method used to retrieve the Chilkat SSH StdErrToStdOut property.
		*==============================================================================
		* Method:            StdErrToStdOut_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSH StdErrToStdOut property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.StdErrToStdOut
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** If 1, then stderr is redirected to stdout. 
		** In this case, channel output for both stdout and stderr 
		** is combined and retrievable via the following methods: 
		** GetReceivedData, GetReceivedDataN, GetReceivedText, GetReceivedTextS. 
		** If this property is 0, then stderr is available separately via the GetReceivedStderr method.
		**
		** The default value of this property is 1.
		**
		** Note: Most SSH servers do not send stderr output as "extended data" packets 
		** as specified in RFC 4254. The SessionLog may be examined to see if 
		** any CHANNEL_EXTENDED_DATA messages exist. If not, then all of the output 
		** (stdout + stderr) was sent via CHANNEL_DATA messages, 
		** and therefore it is not possible to differentiate stderr output from stdout. 
		** In summary: This feature will not work for most SSH servers.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

