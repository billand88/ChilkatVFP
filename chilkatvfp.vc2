		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            LoadTaskCaller
		* Purpose:           Loads the caller of the task's async method.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatTask, a Chilkat Task object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/04/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Loads the caller of the task's async method.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatTask AS CHILKAT_TASK_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterTask AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liReturn, m.luReturn  
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterTask = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatTask)
		
		      loChilkatTask = m.loParkParameterTask.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.LoadTaskCaller(m.loChilkatTask) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatTask = ;
		      m.loParkParameterTask.SetObject(m.toChilkatTask, m.loChilkatTask)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterTask, m.loChilkatTask
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  toChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loParkParameterTask = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loginafterconnectonly		&& Authenticates with the FTP server using the values provided in the Username, Password, and/or other properties. This can be called after establishing the connection via the ConnectOnly method. (The Connect method both connects and authenticates.)
		*==============================================================================
		* Method:            LoginAfterConnectOnly
		* Purpose:           Authenticates with the FTP server using the values provided 
		*                    in the Username, Password, and/or other properties.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/04/2022
		*==============================================================================
		
		**
		** Authenticates with the FTP server using the values provided 
		** in the Username, Password, and/or other properties. 
		** This can be called after establishing the connection via the ConnectOnly method. 
		** (The Connect method both connects and authenticates.) 
		** The combination of calling ConnectOnly followed by LoginAfterConnectOnly 
		** is the equivalent of calling the Connect method.
		**
		** Note: After successful authentication, the FEAT and SYST commands are automatically 
		** sent to help the client understand what is supported by the FTP server. 
		** To prevent these commands from being sent, 
		** set the AutoFeat and/or AutoSyst properties equal to 0.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.LoginAfterConnectOnly() ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE loginafterconnectonlyasync		&& Creates an asynchronous task to call the LoginAfterConnectOnly method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            LoginAfterConnectOnlyAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    LoginAfterConnectOnly method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        03/04/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the LoginAfterConnectOnly method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.LoginAfterConnectOnlyAsync()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE loginverified_access		&& Access method used to retrieve the Chilkat LoginVerified property.
		*==============================================================================
		* Method:            LoginVerified_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 LoginVerified property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LoginVerified
		* Date Added:        02/25/2022
		*==============================================================================
		
		**
		** True if the FTP2 component was able to login to the FTP server after calling Connect.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE loginverified_assign		&& Assign method used to hold a reference to the LoginVerified property.
		*==============================================================================
		* Method:            LoginVerified_Assign
		* Purpose:           Assign method used to hold a reference to the LoginVerified property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the LoginVerified property.
		* Returns:           
		* Date Added:        02/25/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE mgetfiles		&& Copies all the files in the current remote FTP directory to a local directory. To copy all the files in a remote directory, set remotePattern to "*.*" The pattern can contain any number of "*"characters, where "*" matches 0 or more of any character.
		*==============================================================================
		* Method:            MGetFiles
		* Purpose:           Copies all the files in the current remote FTP directory to a local directory.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePattern -- contains the remote directory pattern.
		*                    tcLocalDirectory -- contains the path to the local directory.
		* Returns:           liFiles, the number of files copied, or -1
		* Date Added:        03/04/2022
		*==============================================================================
		
		**
		** Copies all the files in the current remote FTP directory to a local directory. 
		** To copy all the files in a remote directory, set remotePattern to "*.*". 
		** The pattern can contain any number of "*"characters, where "*" matches 
		** 0 or more of any character. The return value is the number of files transferred, 
		** and on error, a value of -1 is returned. 
		** Detailed information about the transfer can be obtained 
		** from the last-error information (LastErrorText/LastErrorHtml/LastErrorXml/SaveLastError).
		**
		** About case sensitivity: The MGetFiles command works by sending the "LIST" command 
		** to the FTP server. For example: "LIST *.txt". The FTP server responds 
		** with a directory listing of the files matching the wildcarded pattern, 
		** and it is these files that are downloaded. Case sensitivity depends 
		** on the case-sensitivity of the remote file system. 
		** If the FTP server is running on a Windows-based computer, 
		** it is likely to be case insensitive. However, if the FTP server is running on Linux, 
		** MAC OS X, etc. it is likely to be case sensitive. 
		** There is no good way to force case-insensitivity if the remote filesystem 
		** is case-sensitive because it is not possible for the FTP client to send 
		** a LIST command indicating that it wants the matching to be case-insensitive.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed in version 93: Fixed with wildcard input for certain FTP servers 
		** that don’t allow for the LIST command with wildcards.
		**
		
		LPARAMETERS tcRemotePattern AS Character, tcLocalDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, liFiles AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		liFiles = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      liFiles = m.loChilkatObject.MGetFiles(m.tcRemotePattern, m.tcLocalDirectory)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liFiles
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE mgetfilesasync		&& Creates an asynchronous task to call the MGetFiles method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            MGetFilesAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the MGetFiles method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcRemotePattern -- contains the remote directory pattern.
		*                    tcLocalDirectory -- contains the path to the local directory.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        03/04/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the MGetFiles method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread 
		** may require special considerations.
		**
		** Enhancement to Version 66:
		** Improved performance for SFTP, FTP, and HTTP data transfers.
		**
		** Fixed in version 93: Fixed with wildcard input for certain FTP servers 
		** that don’t allow for the LIST command with wildcards.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcRemotePattern AS Character, tcLocalDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
