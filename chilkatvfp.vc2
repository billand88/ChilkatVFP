	PROCEDURE rendertomime		&& When an email is sent by calling SendEmail, it is first "rendered" according to the values of the email properties and contents. The rendered MIME string is returned on success.
		*==============================================================================
		* Method:            RenderToMIME
		* Purpose:           When an email is sent by calling SendEmail, it is first "rendered" 
		*                    according to the values of the email properties and contents. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		* Returns:           Character
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** When an email is sent by calling SendEmail, it is first "rendered" 
		** according to the values of the email properties and contents. 
		** It may be digitally signed, encrypted, values substituted for replacement patterns, 
		** and header fields "Q"or "B" encoded as needed based on the email. 
		** The RenderToMime method performs the rendering, but without the actual sending. 
		** The MIME text produced is exactly what would be sent to the SMTP server 
		** had SendEmail been called. 
		** (The SendEmail method is effectively the same as calling RenderToMime 
		** followed by a call to SendRendered.)
		**
		** The rendered MIME string is returned on success.
		**
		** Returns Nothing on failure
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, lcRendering AS Character, ;
		loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		lcRendering = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		
		      lcRendering = m.loChilkatObject.RenderToMIME(m.loChilkatEmail)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail
		
		RETURN m.lcRendering
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE rendertomimebd		&& The same as RenderToMimeBytes, except the MIME is rendered into renderedMime. The rendered MIME is appended to renderedMime. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            RenderToMIMEBd
		* Purpose:           The same as RenderToMimeBytes, 
		*                    except the MIME is rendered into renderedMime.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		*                    toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62
		**
		** The same as RenderToMimeBytes, except the MIME is rendered into renderedMime. 
		** The rendered MIME is appended to renderedMime.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], llImplemented AS Logical, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, loChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterEmail, ;
		m.loParkParameterBinData, m.loChilkatEmail, m.loChilkatBinData  
		
		llImplemented = .F.
		liIntroducedInBuild = 62
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterEmail = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.RenderToMIMEBd(m.loChilkatEmail, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterEmail, ;
		m.loParkParameterBinData, m.loChilkatEmail, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE rendertomimebytes		&& This method is the same as RenderToMime, but the MIME is returned in a byte array. If an email uses an 8bit or binary MIME encoding, then calling RenderToMime may introduce errors because it is not possible to return non-text binary data as a string.
		*==============================================================================
		* Method:            RenderToMIMEBytes
		* Purpose:           This method is the same as RenderToMime, 
		*                    but the MIME is returned in a byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		* Returns:           Variant
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** This method is the same as RenderToMime, but the MIME is returned in a byte array. 
		** If an email uses an 8bit or binary MIME encoding, 
		** then calling RenderToMime may introduce errors because it 
		** is not possible to return non-text binary data as a string. 
		** Therefore, calling RenderToMimeBytes is recommended over RenderToMime, 
		** unless it is assured that the email (MIME) does not use a binary encoding for non-text data.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, lqReturn AS VarBinary, ;
		loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.lqReturn, m.loParkParameterEmail, m.loChilkatEmail
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterEmail = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		    loChilkatEmail = m.loParkParameterEmail.GetObject()
		
		    TRY
		
		      lqReturn = m.loChilkatObject.RenderToMIMEBytes(m.loChilkatEmail)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatEmail = ;
		    m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE rendertomimesb		&& The same as RenderToMime, except the MIME is rendered into renderedMime. The rendered MIME is appended to renderedMime. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            RenderToMIMESb
		* Purpose:           The same as RenderToMime, except the MIME is rendered into renderedMime. .
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmail, a Chilkat Email object.
		*                    toChilkatStringBuilder, a Chilkat String Builder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/19/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.62
		**
		** The same as RenderToMime, except the MIME is rendered into renderedMime. 
		** The rendered MIME is appended to renderedMime.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEmail AS CHILKAT_EMAIL_COM_CALL, ;
		toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liIntroducedInBuild AS Integer, ;
		loParkParameterEmail AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmail AS CHILKAT_EMAIL_COM_CALL, llImplemented AS Logical, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		liIntroducedInBuild = 62
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterEmail = ;
		        NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatEmail)
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatEmail = m.loParkParameterEmail.GetObject()
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.RenderToMIMESb(m.loChilkatEmail, m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatEmail = ;
		      m.loParkParameterEmail.SetObject(m.toChilkatEmail, m.loChilkatEmail)
		
		      toChilkatStringBuilder = m.loParkParameterStringBuilder.SetObject(;
		      m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH 
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmail, m.loChilkatEmail, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE requirehostnamematch_access		&& Access method used to retrieve a reference to the RequireHostNameMatch property.
		*==============================================================================
		* Method:            RequireHostnameMatch_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan RequireHostnameMatch property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.RequireHostnameMatch
		* Date Added:        09/06/2026
		*==============================================================================
		
		**
		** Introduced in version 11.6.0.
		**
		** Determines whether the hostname used for the TLS connection 
		** must match a name in the server certificate's Subject Alternative Name (SAN) extension.
		**
		** The comparison is made against the SNI hostname sent in the TLS handshake. 
		** MailMan normally uses the configured server hostname. When connecting by IP address
		** or through an alternate endpoint, set SniHostname to the expected DNS hostname.
		**
		** Hostname matching is enforced independently of RequireSslCertVerify. 
		** Therefore, it still occurs when certificate-chain verification is not required.
		**
		** The default value is 0.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

	HIDDEN PROCEDURE requirehostnamematch_assign		&& Assign method used to hold a reference to the RequireHostNameMatch property.
		*==============================================================================
		* Method:            RequireHostnameMatch_Assign
		* Purpose:           Assign method used to hold a reference to the RequireHostnameMatch property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the RequireHostnameMatch property.
		* Returns:           
		* Date Added:        09/06/2026
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 6
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE requiresslcertverify_access		&& Access method used to retrieve a reference to the RequireSSLCertVerify property.
		*==============================================================================
		* Method:            RequireSSLCertVerify_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan RequireSSLCertVerify property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.RequireSSLCertVerify
		* Date Added:        01/12/2022
		*==============================================================================
		
		**
		** If 1, then the mailman will verify the SMTP or POP3 server's SSL certificate when connecting. 
		** The certificate is expired, or if the cert's signature is invalid, 
		** the connection is not allowed. The default value of this property is 0. 
		** (Obviously, this only applies to SSL/TLS connections.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE requiresslcertverify_assign		&& Assign method used to hold a reference to the RequireSSLCertVerify property.
		*==============================================================================
		* Method:            RequireSSLCertVerify_Assign
		* Purpose:           Assign method used to hold a reference to the RequireSSLCertVerify property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the RequireSSLCertVerify property.
		* Returns:           
		* Date Added:        01/12/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE resetdateonload_access		&& Access method used to retrieve a reference to the ResetDateOnLoad property.
		*==============================================================================
		* Method:            ResetDateOnLoad_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat MailMan ResetDateOnLoad property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ResetDateOnLoad
		* Date Added:        01/12/2022
		*==============================================================================
		
		**
		** Controls whether the Date header field is reset to the current date/time 
		** when an email is loaded from LoadMbx, LoadEml, LoadMime, LoadXml, or LoadXmlString. 
		** The default is 0 (to not reset the date). 
		** To automatically reset the date, set this property equal to 1.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE resetdateonload_assign		&& Assign method used to hold a reference to the ResetDateOnLoad property.
		*==============================================================================
		* Method:            ResetDateOnLoad_Assign
		* Purpose:           Assign method used to hold a reference to the ResetDateOnLoad property.
