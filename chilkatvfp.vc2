	PROCEDURE Init
		*==============================================================================
		* Method:            Init
		* Purpose:           Occurs when an object is created.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Logical, indicating success.
		* Date Added:        02/02/2024
		*==============================================================================
		
		LOCAL llReturn AS Logical, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning of ChilkatVFP.VCX]
		
		liCalculatedBuildNumber = 0
		loVersioning = NULL
		
		llReturn = DODEFAULT()
		
		** Okay to continue test
		IF m.llReturn
		
		  WITH THIS
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      ** Before version 77 test
		      IF m.liCalculatedBuildNumber <= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 76)
		
		        .PassiveUseHostAddr = 0
		
		      ENDIF m.liCalculatedBuildNumber <= ;
		      m.loVersioning.GenerateVersionNumber(9, 5, 76)
		      ** End before version 77 test
		
		    ELSE
		
		      llReturn = .F.
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have a good object test
		
		  ENDWITH
		
		ENDIF m.llReturn
		** End okay to continue test
		
		loVersioning = NULL
		
		RETURN m.llReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE isconnected_access		&& Access method used to retrieve the Chilkat IsConnected property.
		*==============================================================================
		* Method:            IsConnected_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 IsConnected property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IsConnected
		* Date Added:        02/24/2022
		*==============================================================================
		
		** 
		** Important: This property is decremented. 
		** Applications should instead call the CheckConnection method.
		**
		** Returns 1 if currently connected and logged into an FTP server, otherwise returns 0.
		**
		** Note: Accessing this property may cause a NOOP command to be sent to the FTP server.
		**
		** Per the 9.5.0.56 release notes: The IsConnected and NumFilesAndDirs properties 
		** should be avoided. They were already decremented prior to this version release, 
		** but this is another recommendation to avoid these properties. 
		** Instead use the CheckConnection and GetDirCount methods.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE isconnected_assign		&& Assign method used to hold a reference to the IsConnected property.
		*==============================================================================
