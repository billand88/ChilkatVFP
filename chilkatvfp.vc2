		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatOAuth2, a Chilkat OAuth2 object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		**
		** Causes the "Authorization: Bearer <access_token>" header to be added to each request. 
		** The authProvider should have been loaded with an OAuth2 access token, 
		** which is JSON that looks similar to this:
		** 
		** {
		**   "access_token": "...",
		**   "refresh_token": "...",
		**   "expires_in": 14400,
		**   "scope": "...",
		**   "token_type": "bearer",
		**   "expires_on": "1611099058"
		** }
		** 
		** Your access token may contain different JSON members, 
		** but it should contain the two required members "access_token" and "token_type". 
		** The "token_type" should be "bearer" (case-insensitive).
		** 
		** Note: It is also possible to manually add the Authorization header 
		** in the same way as any other header by calling the AddHeader method. 
		** If the Authorization header is added via AddHeader, then don't use this method.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatOAuth2 AS CHILKAT_OAUTH2_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_REST_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterOAuth2 AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatOAuth2 AS CHILKAT_OAUTH2_COM_CALL, ;
		liIntroducedInBuild AS Integer, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterOAuth2, m.loChilkatOAuth2
		
		llImplemented = .F.
		liIntroducedInBuild = 59
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterOAuth2 = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatOAuth2)
		
		      loChilkatOAuth2 = m.loParkParameterOAuth2.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetAuthOAuth2(m.loChilkatOAuth2) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatOAuth2 = ;
		      m.loParkParameterOAuth2.SetObject(m.toChilkatOAuth2, m.loChilkatOAuth2)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterOAuth2, m.loChilkatOAuth2
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_REST_COM_CALL)
		  toChilkatOAuth2 = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  loParkParameterOAuth2 = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatOAuth2 = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

