		** D8nGANN8BYVFDEcuFk8SCks5Xk76YfL+9uAETKv7y//AE8dyrCRk8/7kyOdMhHtq
		** 1bHsAutfxeiYrdRWyK0ZApAKdSEy+BvdVRv9hbECgYEAzcNdvlUg2gKsNMcSxpym
		** GMe5nknj6svEJ2uyRLLJf91yDgEGLSIFp7Pn4AhYiW9Vn3tCZHoQEvo5yuVjr2zC
		** /Q2wE63iroGjZpbRCp+VhnI371OeYAMSF0KqdK5/Km7E9qraHOk53E1N6iKlWepP
		** e8Tm781btG9F72NjnAhQUjcCgYEA1XB2FIVsAQQ/BAx5v+cbkZHCg185ID2j/0LY
		** sSYGAFa+2lF1X03iycl3EAg8gMgU8w43KyTegNls8EWmCCKA/NX9dUIXajMan9G6
		** +akLvdlGxjfvxQN4WikdRSHJ11mx43lt10mE+pFJdX5FMVxG9g/BZsX595qNewUu
		** tJKWXcECgYEAqHYYHyZI9dah6JVpm5UQ6kJbDPZad7uus/lmJfTgY+ZCH1sEVySL
		** UYk4TyswyUqzLfazhhQ9yZsDBmdm6jRJLYtQBo9fybpOzeyK20aFIGQTSaVFbAGG
		** YIsv2DOWk9HHr0TSG7yu/1hiMf3ol0ofpTEQpXyM8qjVuqCeqsMeJ9I=
		** -----END RSA PRIVATE KEY-----
		** 
		** Fix for version 78: Fixed for loading non-encrypted and encrypted RSA private keys.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcKeyString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SSHKEY_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      STORE m.loChilkatObject.FromOpenSSHPrivateKey(m.tcKeyString) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fromopensshpublickey		&& Loads an OpenSSH public-key from an OpenSSH formatted public-key. Note: keyStr is not a filename -- it should contain the contents of the OpenSSH formatted public key.
		*==============================================================================
		* Method:            FromOpenSSHPublicKey
		* Purpose:           Loads an OpenSSH public-key from an OpenSSH formatted public-key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcKeyString -- Contains the contents of the public key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/08/2022
		*==============================================================================
		
		**
		** Loads an OpenSSH public-key from an OpenSSH formatted public-key.
		**
		** Note: keyStr is not a filename -- it should contain the contents 
		** of the OpenSSH formatted public key. To load from a file, 
		** you may first call LoadText to load the complete contents 
		** of a text file into a string.
		**
		** Sample OpenSSH-formatted DSA and RSA public keys are below:
		** 
