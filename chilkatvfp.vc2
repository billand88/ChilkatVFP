	PROCEDURE connect		&& Connects to an IMAP server, but does not login. The domainName is the domain name of the IMAP server. (May also use the IPv4 or IPv6 address in string format.)
		*==============================================================================
		* Method:            Connect
		* Purpose:           Connects to an IMAP server, but does not login.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcDomain, the connection domain.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** Connects to an IMAP server, but does not login. 
		** The domainName is the domain name of the IMAP server. 
		** (May also use the IPv4 or IPv6 address in string format.)
		** 
		** Important: All TCP-based Internet communications, regardless of the protocol 
		** (such as HTTP, FTP, SSH, IMAP, POP3, SMTP, etc.), and regardless of SSL/TLS, 
		** begin with establishing a TCP connection to a remote host:port. 
		** External security-related infrastructure such as software firewalls 
		** (Windows Firewall), hardware firewalls, anti-virus, at either source or destination 
		** (or both) can block the connection. If the connection fails, 
		** make sure to check all potential external causes of blockage.
		**
		** Fixed for Version 48: 
		** Improved performance through the automatic (internal) use of pipelining.
		**
		** Fixed in version 99: In some cases, Chilkat failed to establish connections 
		** trying to use aes-gcm. This was fixed. (It was not common.)
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcDomain AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.Connect(m.tcDomain) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  ** Process successful test
		  IF m.liReturn = 1
		
		    .AutoFixSettings()
		
		  ENDIF m.liReturn = 1
		  ** End process successful test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE connectasync		&& Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
