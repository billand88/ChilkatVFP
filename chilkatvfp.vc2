	PROCEDURE authenticatepwpk		&& Authentication for SSH servers that require both a password and private key. (Most SSH servers are configured to require one or the other, but not both.)
		*==============================================================================
		* Method:            AuthenticatePwPK
		* Purpose:           Authentication for SSH servers that require both a password and private key.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUserName -- the user name
		*                    tcPassword -- the user's password
		*                    toChilkatSSHKey, a Chilkat SSH Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        04/09/2022
		*==============================================================================
		
		**
		** Authentication for SSH servers that require both a password and private key. 
		** (Most SSH servers are configured to require one or the other, but not both.)
		**
		** Important: When reporting problems, please send the full contents 
		** of the LastErrorText property to support@chilkatsoft.com.
		**
		** Fixed in version 94: Fixed login/authentication problems encountered 
		** w/ some SSH servers when password + private key authentication is required.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUserName AS Character, tcPassword AS Character, ;
		toChilkatSSHKey AS CHILKAT_SSHKEY_COM_CALL 
		
		LOCAL loChilkatObject AS CHILKAT_SSH_COM_CALL, loException AS Exception, ;
		loParkParameterSshKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSshKey AS CHILKAT_SSHKEY_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterSshKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSshKey)
		
		    loChilkatSshKey = m.loParkParameterSshKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.AuthenticatePwPK(m.tcUserName, ;
		      m.tcPassword, m.loChilkatSSHKey) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatSshKey = ;
		    m.loParkParameterSshKey.SetObject(m.toChilkatSshKey, m.loChilkatSshKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSshKey, m.loChilkatSshKey
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSH_COM_CALL)
		  toChilkatSSHKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loParkParameterSshKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSshKey = NEWOBJECT(CHILKAT_SSHKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

