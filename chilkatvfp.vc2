DEFINE CLASS bounce AS ibasechilkat OF "chilkatvfp.vcx" 		&& Recognize a variety of bounced email messages and extract the email address from a bounced email message. Decremented in version 10.1.0.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: bounceaddress_access		&& Access method used to retrieve the Chilkat Bounce BounceAddress property.
		*m: bounceaddress_assign		&& Assign method used to hold a reference to the BounceAddress property.
		*m: bouncedata_access		&& Access method used to retrieve the Chilkat Bounce BounceData property.
		*m: bouncedata_assign		&& Assign method used to hold a reference to the BounceData property.
		*m: bouncetype_access		&& Access method used to retrieve the Chilkat Bounce BounceType property.
		*m: bouncetype_assign		&& Assign method used to hold a reference to the BounceType property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Bounce DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: examineemail		&& Examines an email and sets the properties (BounceType, BounceAddress, BounceData) according to how the email is classified.
		*m: examineeml		&& Examines an email from a .eml file and sets the properties (BounceType, BounceAddress, BounceData) according to how the email is classified. Returns 1 for success, 0 for failure.
		*m: examinemime		&& Examines an email represented as raw MIME text and sets the properties (BounceType, BounceAddress, BounceData) according to how the email is classified. The return value is 1 for a successful classification, or 0 for a failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat Bounce LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat Bounce LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat Bounce LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat Bounce LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat Bounce LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat Bounce LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat Bounce LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: unlockcomponent		&& Unlocks the component. This must be called once at the beginning of your program to unlock the component. A purchased unlock code is provided when the Bounce component is licensed.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat Bounce VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: bounceaddress		&& The bounced email address when a bounced email is recognized.
		*p: bouncedata		&& The raw body of the bounced mail.
		*p: bouncetype		&& A number representing the type of bounce that was recognized. A value of 0 indicates "No Bounce"
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		bounceaddress = 
		bouncedata = 
		bouncetype = 0
		cchilkatclass = Bounce
		debuglogfilepath = 
		iretirementmajor = 11
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "bounce"
		verboselogging = 0
	*</PropValue>
	
	HIDDEN PROCEDURE bounceaddress_access		&& Access method used to retrieve the Chilkat Bounce BounceAddress property.
		*==============================================================================
		* Method:            BounceAddress_Access
		* Purpose:           Access method used to retrieve 
		*                    the BounceAddress property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.BounceAddress
		* Date Added:        06/26/2022
		*==============================================================================
		
		** 
		** The bounced email address when a bounced email is recognized.
		**
		** Fixed for version 73: Fixed a few situations where bounce type 11 (Suspected Bounce) 
		** was returned, but should have been 6 (Auto-Reply). 
		** In general, minor improvements to Bounce categorization are added 
		** as customers report issues, and each new Chilkat version can be assumed 
		** to have minor Bounce categorization refinements.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE bounceaddress_assign		&& Assign method used to hold a reference to the BounceAddress property.
		*==============================================================================
		* Method:            BounceAddress_Assign
		* Purpose:           Assign method used to hold
		*                    the BounceAddress of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the BounceAddress property.
		* Returns:           
		* Date Added:        06/26/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE bouncedata_access		&& Access method used to retrieve the Chilkat Bounce BounceData property.
		*==============================================================================
