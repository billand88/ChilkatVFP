	HIDDEN PROCEDURE paddingscheme_access		&& Access method used to retrieve the Chilkat Crypt2 PaddingScheme property.
		*==============================================================================
		* Method:            PaddingScheme_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 PaddingScheme property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PaddingScheme
		* Date Added:        06/29/2022
		*==============================================================================
		
		**
		** The padding scheme used by block encryption algorithms 
		** such as AES (Rijndael), Blowfish, Twofish, RC2, DES, 3DES, etc. 
		** Block encryption algorithms pad encrypted data to a multiple of algorithm's block size. 
		** The default value of this property is 0.
		** 
		** Possible values are:
		** 
		**   0 = RFC 1423 padding scheme: Each padding byte is set to the number of padding bytes.
		**       If the data is already a multiple of algorithm's block size bytes, 
		**       an extra block is appended each having a value equal to the block size. 
		**       (for example, if the algorithm's block size is 16, 
		**       then 16 bytes having the value 0x10 are added.). 
		**       (This is also known as PKCS5 padding: PKCS #5 padding string 
		**       consists of a sequence of bytes, each of which is equal 
		**       to the total number of padding bytes added. )
		** 
		**   1 = FIPS81 (Federal Information Processing Standards 81) 
		**       where the last byte contains the number of padding bytes, including itself, 
		**       and the other padding bytes are set to random values.
		** 
		**   2 = Each padding byte is set to a random value. 
		**       The decryptor must know how many bytes are in the original unencrypted data.
		** 
		**   3 = Pad with NULLs. (If already a multiple of the algorithm's block size, no padding is added).
		** 
		**   4 = Pad with SPACE chars(0x20). (If already a multiple of algorithm's block size, 
		**       no padding is added).
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE paddingscheme_assign		&& Assign method used to hold a reference to the PaddingScheme property.
		*==============================================================================
		* Method:            PaddingScheme_Assign
		* Purpose:           Assign method used to hold a reference to the PaddingScheme property.
		* Author:            Bill Anderson
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the PaddingScheme property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [PaddingScheme]
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE pbesalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 PBESAlgorithm property.
		*==============================================================================
		* Method:            PBESAlgorithm_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 PBESAlgorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PBESAlgorithm
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** If the CryptAlgorithm property is set to "pbes1" or "pbes2", 
		** this property specifies the underlying encryption algorithm 
		** to be used with password-based encryption (PBE). 
		** Password-based encryption is defined in the PKCS5 Password-Based 
		** Cryptography Standard at http://www.rsa.com/rsalabs/node.asp?id=2127
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE pbesalgorithm_assign		&& Assign method used to hold a reference to the PBESAlgorithm property.
		*==============================================================================
		* Method:            PBESAlgorithm_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Crypt2 PBESAlgorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the PBESAlgorithm property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE pbespassword_access		&& Access method used to retrieve the Chilkat Crypt2 PBESPassword property.
		*==============================================================================
		* Method:            PBESPassword_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 PBESPassword property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PBESPassword
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** If the CryptAlgorithm property is set to "pbes1" or "pbes2", 
		** this property specifies the underlying encryption algorithm 
		** to be used with password-based encryption (PBE). 
		** Password-based encryption is defined in the PKCS5 Password-Based 
		** Cryptography Standard at http://www.rsa.com/rsalabs/node.asp?id=2127
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE pbespassword_assign		&& Assign method used to hold a reference to the PBESPassword property.
		*==============================================================================
		* Method:            PBESPassword_Assign
