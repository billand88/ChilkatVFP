	PROCEDURE createplan		&& Creates an "FTP plan" that lists the FTP operations that would be performed when PutTree is called. Additionally, the PutPlan method executes an "FTP plan" and logs each successful operation to a plan log file.
		*==============================================================================
		* Method:            CreatePlan
		* Purpose:           Creates an "FTP plan" that lists the FTP operations 
		*                    that would be performed when PutTree is called.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcLocalDirectory -- the local directory.
		* Returns:           Character
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates an "FTP plan" that lists the FTP operations that would be performed 
		** when PutTree is called. Additionally, the PutPlan method executes an "FTP plan" 
		** and logs each successful operation to a plan log file. 
		** If a large-scale upload is interrupted, the PutPlan can be resumed, 
		** skipping over the operations already listed in the plan log file.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcLocalDirectory AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, lcFTPPlan AS lcFTPPlan
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcFTPPlan = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcFTPPlan = m.loChilkatObject.CreatePlan(m.tcLocalDirectory)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcFTPPlan
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

