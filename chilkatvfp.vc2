		LPARAMETERS tcFileToSign AS Character, tcP7SSignedFilePath AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        loChilkatTask = ;
		        m.loChilkatObject.CreateP7SAsync(m.tcFileToSign, m.tcP7SSignedFilePath)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE cryptalgorithm_access		&& Access method used to retrieve the Chilkat Crypt2 CryptAlgorithm property.
		*==============================================================================
		* Method:            CryptAlgorithm_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 CryptAlgorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CryptAlgorithm
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** Selects the encryption algorithm for encrypting and decrypting. 
		** Possible values are: "chacha20", "pki", "aes", "blowfish2", "des", 
		** "3des", "rc2", "arc4", "twofish", "pbes1" and "pbes2". 
		** The "pki" encryption algorithm isn't a specific algorithm, 
		** but instead tells the component to encrypt/decrypt 
		** using public-key encryption with digital certificates. 
		** The other choices are symmetric encryption algorithms 
		** that do not involve digital certificates and public/private keys.
		** 
		** The default value is "aes"
		** 
		** The original Chilkat implementation of Blowfish (in 2004) 
		** has a 4321 byte-swapping issue (the results are 4321 byte-swapped). 
		** The newer implementation (in 2006 and named "blowfish2") does not byte swap. 
		** This should be used for compatibility with other Blowfish software. 
		** If an application needs to decrypt something encrypted with the old 4321 byte-swapped blowfish, 
		** set the property to "blowfish_old".
		** 
		** Password-based encryption (PBE) is selected by setting this property to "pbes1" or "pbes2". 
		** Password-based encryption is defined in the 
		** PKCS5 Password-Based Cryptography Standard at https://tools.ietf.org/html/rfc2898. 
		** If PBE is used, the underlying encryption algorithm is specified by the PbesAlgorithm property. 
		** The underlying encryption (PbesAlgorithm) for PBES1 is limited to 56-bit DES or 64-bit RC2.
		** 
		** Note:The chacha20 algorithm is introduced in Chilkat v9.5.0.55.
		**
		** Fixed for version 65: When setting the CryptAlgorithm = “PBES2”, 
		** Chilkat was doing PBES1 encryption. This problem started sometime after v9.5.0.45.  
		**
		** Fixed for version 78: An attempt to set this property to an invalid (unrecognized) value 
		** will effectively be a no-op (will not change the value of CryptAlgorithm).
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE cryptalgorithm_assign		&& Assign method used to hold a reference to the CryptAlgorithm property.
		*==============================================================================
		* Method:            CryptAlgorithm_Assign
		* Purpose:           Assign method used to hold a reference to the CryptAlgorithm property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CryptAlgorithm property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [CryptAlgorithm]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_access		&& Access method used to retrieve the Chilkat Crypt2 DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DebugLogFilePath
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** If set to a file path, causes each Chilkat method or property call to automatically 
		** append it's LastErrorText to the specified log file. 
		** The information is appended such that if a hang or crash occurs, 
		** it is possible to see the context in which the problem occurred, 
		** as well as a history of all Chilkat calls up to the point of the problem. 
		** The VerboseLogging property can be set to provide more detailed information.
		**
		** This property is typically used for debugging the rare cases where a 
		** Chilkat method call hangs or generates an exception that halts program execution (i.e. crashes). 
		** A hang or crash should generally never happen. The typical causes of a hang are:
		** 
		** 1) a timeout related property was set to 0 to explicitly indicate that an infinite timeout is desired,
		** 2) the hang is actually a hang within an event callback (i.e. it is a hang within the application code), or
		** 3) there is an internal problem (bug) in the Chilkat code that causes the hang.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*==============================================================================
		* Method:            DebugLogFilePath_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Crypt2 DebugLogFilePath property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DebugLogFilePath property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE decode		&& Decode binary data from an encoded string.
		*==============================================================================
		* Method:            Decode
		* Purpose:           Decode binary data from an encoded string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string to decode. 
		*                    tcEncoding -- the encoding algorithm to use.
		* Returns:           The decoded data.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Decode binary data from an encoded string. 
		** The encoding can be set to any of the following strings: "base64", "hex", 
		** "quoted-printable", "url", "base32", "Q", "B", "url_rc1738", "url_rfc2396", 
		** "url_rfc3986", "url_oauth", "uu", "modBase64", 
		** or "html" (for HTML entity encoding).
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		
		LPARAMETERS tcString AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqDecodedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDecodedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqDecodedBytes = m.loChilkatObject.Decode(m.tcString, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDecodedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decodestring		&& Decodes from an encoding back to the original string.
		*==============================================================================
		* Method:            DecodeString
		* Purpose:           Decodes from an encoding back to the original string.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcString -- the string to decode. 
		*                    tcCharset -- the string charset.
		*                    tcEncoding -- the encoding algorithm to use.
		* Returns:           The decoded string.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Decodes from an encoding back to the original string. 
		** The encoding can be set to any of the following strings: "base64", "hex", 
		** "quoted-printable", "url", "base32", "Q", "B", "url_rc1738", "url_rfc2396", 
		** "url_rfc3986", "url_oauth", "uu", "modBase64", or "html" (for HTML entity encoding).
		**
		** Enhancement to Version 67: Added the “base64_mime” to the list of possible encodings. 
		** This is the same as “base64”, but causes the base64 to be emitted 
		** in lines just like it would be found in MIME or in a PEM.
		**
		** Enhancement for Version 75: Added the “hexlower” encoding. 
		** “hexlower” may be used instead of “hex” to get the hexadecimal encoding 
		** using lowercase a-f (“hex” produces uppercase A-F).
		**
		** Enhancement for Version 79: 
		** Added ascii85 encoding/decoding to the list of supported binary encoding algorithms.
		**
		** Enhancement for Version 99: 
		** Added “Base45” to the set of binary encodings supported by Chilkat. 
		** “base45” can now be used in any Chilkat function or property where a binary encoding 
		** such as “base64”, “hex”, “base58”, etc., can be used.
		**
		** Enhancement for Version 11.2.0:
		** Added base62 encoding as an additional encoding choice recognized throughout Chilkat.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcString AS Character, tcCharset AS Character, tcEncoding AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcDecodedString AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lcDecodedString
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcDecodedString = ;
		      m.loChilkatObject.DecodeString(m.tcString, m.tcCharset, m.tcEncoding)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcDecodedString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptbd		&& Introduced in version 9.5.0.67. In-place decrypts the contents of bd. The minimal set of properties that should be set before decrypting are: CryptAlgorithm, SecretKey.
		*==============================================================================
		* Method:            DecryptBd
		* Purpose:           In-place decrypts the contents of bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.67
		**
		** In-place decrypts the contents of bd. 
		** The minimal set of properties that should be set before decrypting are: 
		** CryptAlgorithm, SecretKey. Other properties that control encryption are: 
		** CipherMode, PaddingScheme, KeyLength, IV.
		**
		** Enhancement for Version 71: Added feature to be able to decrypt files 
		** encrypted using an openssl command such as “openssl enc -e -aes-256-cbc 
		** -in hamlet.xml -out hamlet.enc -pass file:./secret.txt”. 
		** See https://www.example-code.com/foxpro/openssl_enc_decrypt.asp
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 67
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.DecryptBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptbytes		&& Decrypts a byte array and returns the unencrypted byte array. The property settings used when encrypting the data must match the settings when decrypting.
		*==============================================================================
		* Method:            DecryptBytes
		* Purpose:           Decrypts a byte array and returns the unencrypted byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqData -- the byte data to compress. 
		* Returns:           The decrypted binary data bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Decrypts a byte array and returns the unencrypted byte array. 
		** The property settings used when encrypting the data 
		** must match the settings when decrypting. Specifically, the CryptAlgorithm, 
		** CipherMode, PaddingScheme, KeyLength, IV, and SecretKey properties must match.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tqData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqDecryptedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDecryptedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqDecryptedBytes = m.loChilkatObject.DecryptBytes(m.tqData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDecryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptbytesenc		&& Decrypts string-encoded encrypted data and returns the unencrypted byte array. Data encrypted with EncryptBytesENC can be decrypted with this method.
		*==============================================================================
		* Method:            DecryptBytesENC
		* Purpose:           Decrypts string-encoded encrypted data 
		*                    and returns the unencrypted byte array.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcData -- the string data to decrypt. 
		* Returns:           The decrypted binary data bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Decrypts string-encoded encrypted data and returns the unencrypted byte array. 
		** Data encrypted with EncryptBytesENC can be decrypted with this method. 
		** The property settings used when encrypting the data 
		** must match the settings when decrypting. 
		** Specifically, the EncodingMode, CryptAlgorithm, CipherMode, PaddingScheme, 
		** KeyLength, IV, and SecretKey properties must match.
		** 
		** Returns a zero-length byte array (as a Variant) on failure.
		** 
		** An empty array will have a UBound of -1 meaning 0 elements.
		** 
		
		LPARAMETERS tcData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lqDecryptedBytes AS VarBinary
		
		STORE NULL TO m.loChilkatObject, m.loException, m.lqDecryptedBytes
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lqDecryptedBytes = m.loChilkatObject.DecryptBytesENC(m.tcData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqDecryptedBytes
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE decryptencoded		&& Encrypted data is passed to this method as an encoded string (base64, hex, etc.). This method first decodes the input data according to the EncodingMode property setting.
		*==============================================================================
		* Method:            DecryptEncoded
		* Purpose:           See below.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEncodedEncryptedData -- the string data to compress. 
		* Returns:           The decoded string bytes.
		* Date Added:        06/30/2022
		*==============================================================================
		
		**
		** Encrypted data is passed to this method as an encoded string (base64, hex, etc.). 
		** This method first decodes the input data according to the EncodingMode property setting. 
		** It then decrypts and re-encodes using the EncodingMode setting, 
		** and returns the decrypted data in encoded string form.
		** 
		** Returns Nothing on failure
		** 
		
		LPARAMETERS tcEncodedEncryptedData AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CRYPT2_COM_CALL, ;
		loException AS Exception, lcDecryptedData AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcDecryptedData = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcDecryptedData = ;
		      m.loChilkatObject.DecryptEncoded(m.tcEncodedEncryptedData)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcDecryptedData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CRYPT2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

