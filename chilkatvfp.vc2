	PROCEDURE setreplacepattern		&& Create a pattern/replacement-text pair for mail-merge. When the email is sent via the MailMan's SendEmail method, or any other mail-sending method, the patterns are replaced with the replacement strings during the sending process.
		*==============================================================================
		* Method:            SetReplacePattern
		* Purpose:           Create a pattern/replacement-text pair for mail-merge. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPattern -- the pattern to search for.
		*                    tcReplaceString -- the replacement string.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Create a pattern/replacement-text pair for mail-merge. 
		** When the email is sent via the MailMan's SendEmail method, 
		** or any other mail-sending method, the patterns are replaced 
		** with the replacement strings during the sending process. 
		** Do define multiple replacement patterns, 
		** simply call SetReplacePattern once per pattern/replacement string. 
		** (Note: The MailMan's RenderToMime method will also do pattern replacements. 
		** Methods such as SaveEml or GetMime do not replace patterns.)
		**
		** Note: Replacement patterns may be placed in any header field, 
		** and in both HTML and plain-text email bodies.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPattern AS Character, tcReplaceString AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      STORE m.loChilkatObject.SetReplacePattern(m.tcPattern, m.tcReplaceString) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsigningcert		&& Set the certificate to be used in creating a digital signature. Use the CreateCS, CertStore, and Cert classes to create a Cert object by either locating a certificate in a certificate store or loading one from a file.
		*==============================================================================
		* Method:            SetSigningCert
		* Purpose:           Set the certificate to be used in creating a digital signature. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Set the certificate to be used in creating a digital signature. 
		** Use the CreateCS, CertStore, and Cert classes 
		** to create a Cert object by either locating a certificate 
		** in a certificate store or loading one from a file.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed for version 75: Fixed a problem with this method.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetSigningCert(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setsigningcert2		&& Explicitly sets the certificate and private key to be used for sending digitally signed email.
		*==============================================================================
		* Method:            SetSigningCert2
		* Purpose:           Explicitly sets the certificate and private key 
		*                    to be used for sending digitally signed email.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    toChilkatPrivateKey, a Chilkat Private Key object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Explicitly sets the certificate and private key to be used for sending digitally signed email. 
		** If the certificate's private key is already installed on the computer, 
		** then one may simply call SetSigningCert because the Chilkat component 
		** will automatically locate and use the corresponding private key 
		** (stored in the Windows Protected Store). 
		** In most cases, if the digital certificate is already installed w/ private key on the computer, 
		** it is not necessary to explicitly set the signing certificate at all. 
		** The Chilkat component will automatically locate and use the certificate 
		** containing the FROM email address 
		** (from the registry-based certificate store where it was installed).
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed for version 75: Fixed a problem with this method.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, toChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loParkParameterPrivateKey AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatPrivateKey AS CHILKAT_PRIVATEKEY_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert, ;
		m.loParkParameterPrivateKey, m.loChilkatPrivateKey  
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loParkParameterPrivateKey = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatPrivateKey)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		    loChilkatPrivateKey = m.loParkParameterPrivateKey.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetSigningCert2(m.loChilkatCert, m.loChilkatPrivateKey) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    toChilkatPrivateKey = ;
		    m.loParkParameterPrivateKey.SetObject(m.toChilkatPrivateKey, m.loChilkatPrivateKey)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  toChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loParkParameterPrivateKey = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loChilkatPrivateKey = NEWOBJECT(CHILKAT_PRIVATEKEY_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE settextbody		&& Sets the body of the email and also sets the Content-Type header field of the contentType. If the email is already multipart/alternative, an additional alternative with the indicated Content-Type will be added.
		*==============================================================================
		* Method:            SetTextBody
		* Purpose:           Sets the body of the email and also sets the 
		*                    Content-Type header field of the contentType.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcBodyText -- the body text to set.
		*                    tcContentType -- the Content-Type header field value.
		* Returns:           
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Sets the body of the email and also sets the Content-Type header field of the contentType. 
		** If the email is already multipart/alternative, 
		** an additional alternative with the indicated Content-Type will be added. 
		** If an alternative with the same Content-Type already exists, it is replaced.
		**
		
		LPARAMETERS tcBodyText AS VarBinary, tcContentType AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      m.loChilkatObject.SetBodyText(m.tcBodyText, m.tcContentType)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE signaturesvalid_access		&& Access method used to retrieve the Chilkat Email SignaturesValid property.
		*==============================================================================
		* Method:            SignaturesValid_Access
		* Purpose:           Access method used to retrieve the Chilkat Email SignaturesValid property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SignaturesValid
		* Date Added:        01/23/2022
		*==============================================================================
		
		**
		** 1 if the email was received with one or more digital signatures, 
		** and if all the signatures were validated indicating that the email was not altered. 
		** Otherwise this property is set to 0. 
		** (This property is only meaningful when the ReceivedSigned property is equal to 1.)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE signaturesvalid_assign		&& Assign method used to hold a reference to the SignaturesValid property.
		*==============================================================================
		* Method:            SignaturesValid_Assign
		* Purpose:           Assign method used to hold 
		*                    the SignaturesValid property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuValue, integer/logical value 
		*                    used to hold a reference to the SignaturesValid property.
		* Returns:           
		* Date Added:        01/23/2022
		*==============================================================================
		
		LPARAMETERS tuValue AS Unknown
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE signedby_access		&& Access method used to retrieve the Chilkat Email SignedBy property.
		*==============================================================================
		* Method:            SignedBy_Access
		* Purpose:           Access method used to retrieve 
		*                    the SignedBy property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SignedBy
		* Date Added:        01/23/2022
		*==============================================================================
		
		** 
		** If the email was received digitally signed, this property contains the fields of the cert's SubjectDN.
		**
		** For example: US, 60187, Illinois, Wheaton, 1719 E Forest Ave, 
		** "Chilkat Software, Inc.", "Chilkat Software, Inc."
		**
		** It is like the DN (Distinguished Name), but without the "AttrName=" before each attribute.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE signedby_assign		&& Assign method used to hold a reference to the SignedBy property.
		*==============================================================================
		* Method:            SignedBy_Assign
		* Purpose:           Assign method used to hold
		*                    the SignedBy of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SignedBy property.
		* Returns:           
