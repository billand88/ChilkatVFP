		lcValidationMethod = []
		lcMethodToCall = [LongBit]
		
		THIS.CallAssignObject(m.tuValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE cachedir_access		&& Access method used to retrieve the Chilkat Spider CacheDir property.
		*==============================================================================
		* Method:            CacheDir_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Spider CacheDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.CacheDir
		* Date Added:        06/11/2022
		*==============================================================================
		
		** 
		** Specifies a cache directory to use for spidering. 
		** If either of the FetchFromCache or UpdateCache properties are true, 
		** this is the location of the cache to be used. 
		**
		** Note: the Internet Explorer, Netscape, and FireFox caches 
		** are completely separate from the Chilkat Spider cache directory. 
		** You should specify a new and empty directory.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE cachedir_assign		&& Assign method used to hold a reference to the CacheDir property.
		*==============================================================================
		* Method:            CacheDir_Assign
		* Purpose:           Assign method used to hold a reference to the CacheDir property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the CacheDir property.
		* Returns:           
