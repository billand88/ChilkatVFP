		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, 58)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE precomputedsha256_access		&& Access method used to retrieve the Chilkat AuthAWS PreComputedSHA256 property.
		*==============================================================================
		* Method:            PreComputedSHA256_Access
		* Purpose:           Access method used to retrieve the 
		*                    Chilkat AuthAWS PreComputedSHA256 property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.PreComputedSHA256
		* Date Added:        07/30/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.58
		**
		** This property can optionally be set for AWS requests that have a non-empty request body. 
		** This should be the lowercase hex encoding of the 32-bytes of the SHA256 hash. 
		** The most common need for this is if doing an S3 upload from a stream. 
		** (If the pre-computed SHA-256 is not provided, then Chilkat is forced to stream 
		** the entire file into memory so that it can calculate the SHA-256 for authentication.)
		** 
		** Note: AWS Signature Version 4 uses the SHA256 hash. (AWS Signature Version 2 uses MD5)
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 58
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

