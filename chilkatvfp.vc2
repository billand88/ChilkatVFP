	PROCEDURE fetchheaders		&& Retrieves a set of message headers from the IMAP server and returns them in an email bundle object. If the method fails, it may return a NULL reference.
		*==============================================================================
		* Method:            FetchHeaders
		* Purpose:           Retrieves a set of messages from the IMAP server 
		*                    and returns them in an email bundle object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatMessageSet -- a Chilkat Message Set object.
		* Returns:           Chilkat EMail Bundle object, or NULL
		* Date Added:        06/16/2022
		*==============================================================================
		
		**
		** Retrieves a set of message headers from the IMAP server 
		** and returns them in an email bundle object. 
		** If the method fails, it may return a NULL reference. 
		** The following methods are useful for retrieving information 
		** about attachments and flags after email headers are retrieved: 
		** GetMailNumAttach, GetMailAttachSize, GetMailAttachFilename, GetMailFlag.
		**
		** Update to Version 11.0.0: Method decremented.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS toChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loParkParameterMessageSet AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatMessageSet AS CHILKAT_MESSAGESET_COM_CALL, ;
		loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmailBundle, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterMessageSet = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		    loChilkatMessageSet = m.loParkParameterMessageSet.GetObject()
		
		    TRY
		
		      loChilkatEmailBundle = m.loChilkatObject.FetchHeaders(m.loChilkatMessageSet)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatMessageSet = m.loParkParameterMessageSet.SetObject(;
		    m.toChilkatMessageSet, m.loChilkatMessageSet)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterMessageSet, m.loChilkatMessageSet
		
		RETURN m.loChilkatEmailBundle
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loChilkatEmailBundle  = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loParkParameterMessageSet = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatMessageSet = NEWOBJECT(CHILKAT_MESSAGESET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

