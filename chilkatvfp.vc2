	PROCEDURE setoption		&& Introduced in version 9.5.0.57. This is a general purpose method to set miscellaneous options that might arise due to buggy or quirky FTP servers. The option is a string describing the option.
		*==============================================================================
		* Method:            SetOption
		* Purpose:           This is a general purpose method to set miscellaneous options 
		*                    that might arise due to buggy or quirky FTP servers.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOption, the option to set.  
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.57
		**
		** This is a general purpose method to set miscellaneous options that 
		** might arise due to buggy or quirky FTP servers. 
		** The option is a string describing the option. 
		**
		** The current list of possible options are:
		**
		** "Microsoft-TLS-1.2-Workaround" -- This is to force the data connection 
		** to use TLS 1.0 instead of the default. 
		** It works around the Microsoft FTP server bug found here: 
		** https://support.microsoft.com/en-us/kb/2888853
		**
		** To turn off an option, prepend the string "No-". For example "No-Microsoft-TLS-1.2-Workaround". 
		** All options are turned off by default.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcOption AS Character
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 57
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.SetOption(m.tcOption) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		    luReturn = .BitToLogical(m.liReturn)
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setpassword		&& Undocumented function! Sets the password in a more secure way than setting the Password property. Calling this method is the equivalent of setting the Password property.
		*==============================================================================
		* Method:            SetPassword
		* Purpose:           Undocumented function! Sets the password in a more secure 
		*                    way than setting the Password property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatSecureString, a Chilkat Secure String object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        03/06/2022
		*==============================================================================
		
		**
		** Undocumented function! Sets the password in a more secure way than
		** setting the Password property.
		**
		** Note: Starting in v9.5.0.76, this method has been copied to SetSecurePassword.
		** Applications should call SetSecurePassword instead because this method is now
		** decremented.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		loParkParameterSecureString AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString 
		
		WITH THIS
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      ** PEM not removed from class test
		      IF NOT .IsPEMRemoved(11, 0, 0)
		
		        loParkParameterSecureString = ;
		        NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureString)
		
		        loChilkatSecureString = m.loParkParameterSecureString.GetObject()
		
		        TRY
		
		          STORE m.loChilkatObject.SetPassword(m.loChilkatSecureString) ;
		          TO m.liReturn, m.luReturn
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		        toChilkatSecureString = m.loParkParameterSecureString.SetObject(;
		        m.toChilkatSecureString, m.loChilkatSecureString)
		
		      ELSE
		
		        .MissingObjectError(THIS)
		
		      ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		      AND (NOT ISNULL(m.loChilkatObject))
		      ** End have a good object test
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		    luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  toChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loParkParameterSecureString = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

