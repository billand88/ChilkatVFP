	PROCEDURE setx509cert		&& Introduced in version 9.5.0.69. Specifies the X.509 certificate to be used for the KeyInfo element when the KeyInfoType equals "X509Data". If usePrivateKey is 1, then the private key will also be set using the certificate's private key.
		*==============================================================================
		* Method:            SetX509Cert
		* Purpose:           Specifies the X.509 certificate to be used 
		*                    for the KeyInfo element when the KeyInfoType equals "X509Data".
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		*                    tuUsePrivateKey, whether or not to use a private key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Specifies the X.509 certificate to be used for the KeyInfo element 
		** when the KeyInfoType equals "X509Data". If usePrivateKey is 1, 
		** then the private key will also be set using the certificate's private key. 
		** Thus, the SetPrivateKey method does not need to be called. 
		** If usePrivateKey is 1, and the certificate does not have 
		** an associated private key available, then this method will return 0.
		** 
		** Note: A certificate's private key is not stored within a certificate itself. 
		** If the certificate (cert) was obtained from a PFX, Java KeyStore, 
		** or other such source, which are containers for both certs and private keys, 
		** then Chilkat would have associated the cert with the private key 
		** when loading the PFX or JKS, and all is good. The same holds true if, 
		** on a Windows system, the certificate was obtained from a Windows-based 
		** registry certificate store where the private key was installed 
		** with the permission to export.
		** 
		** If, however, the certificate was loaded from a .cer file, 
		** or another type of file that contains only the certificate 
		** and not the private key, then the associated private key needs 
		** to be obtained by the application and provided by calling SetPrivateKey.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL, tuUsePrivateKey AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_XMLDSIGGEN_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, liUsePrivateKey AS Integer, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liUsePrivateKey, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liUsePrivateKey = .LogicalToBit(m.tuUsePrivateKey)
		
		      loParkParameterCert = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		      loChilkatCert = m.loParkParameterCert.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SetX509Cert(m.loChilkatCert, m.liUsePrivateKey) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatCert = ;
		      m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_XMLDSIGGEN_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE sigid_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigID property.
		*==============================================================================
		* Method:            SigID_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XMLDSigGen SigID property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SigID
		* Date Added:        07/05/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.69
		**
		** An option Id attribute value for the Signature element. 
		** The default value is the empty string, which generates a Signature element 
		** with no Id attribute. For example:
		** 
		**   <ds:Signature xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
		** 
		** If this property is set to "abc123", then the Signature element would be generated like this:
		** 
		**   <ds:Signature xmlns:ds="http://www.w3.org/2000/09/xmldsig#" Id="abc123">
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 69
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sigid_assign		&& Assign method used to hold a reference to the SigID property.
		*==============================================================================
		* Method:            SigID_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat XMLDSigGen SigID property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SigID property.
		* Returns:           
		* Date Added:        07/05/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 69
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE siglocationidx_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigLocationIdx property.
		*==============================================================================
		* Method:            SigLocationIdx_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XMLDSigGen SigLocationIdx property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SigLocationIdx
		* Date Added:        07/31/2025
		*==============================================================================
		
		** 
		** Introduced in version 11.1.0
		**
		** Insert the signature at the Nth occurrence of the SigLocation. 
		** The default is 0, which is to insert (according to SigLocationMod ) at the 1st occurrence. 
		** (An index value of 1 is for the 2nd occurrence, and so on.)
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE siglocationidx_assign		&& Assign method used to hold a reference to the SigLocationIdx property.
		*==============================================================================
		* Method:            SigLocationIdx_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat XMLDSigGen SigLocationIdx property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the SigLocationIdx property.
		* Returns:           07/31/2025
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 1
		la_IntroducedInBuild[3] = 0
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE siglocationmod_access		&& Access method used to retrieve the Chilkat XMLDSigGen SigLocationMod property.
		*==============================================================================
		* Method:            SigLocationMod_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat XMLDSigGen SigLocationMod property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SigLocationMod
		* Date Added:        07/05/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.77
		**
		** Modifies the placement of the signature at the location specified by SigLocation. Possible values are:
		** 
		**   0: Insert the Signature as the last child of the element at SigLocation. This is the default.
		**   1: Insert the Signature as a sibling directly after the element at SigLocation.
		**   2: Insert the Signature as a sibling directly before the element at SigLocation.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 77
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

