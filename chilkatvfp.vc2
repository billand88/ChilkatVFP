		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE connect		&& Connects and logs in to the FTP server using the username/password provided in the component properties. Check the integer value of the ConnectFailReason if this method returns 0 (indicating failure).
		*==============================================================================
		* Method:            Connect
		* Purpose:           Connects and logs in to the FTP server 
		*                    using the username/password provided in the component properties. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Connects and logs in to the FTP server using the username/password 
		** provided in the component properties. 
		** Check the integer value of the ConnectFailReason if this method returns 0 (indicating failure).
		**
		** Note: To separately establish the connection and then authenticate 
		** (in separate method calls), call ConnectOnly followed by LoginAfterConnectOnly.
		**
		** Important: All TCP-based Internet communications, regardless of the protocol 
		** (such as HTTP, FTP, SSH, IMAP, POP3, SMTP, etc.), and regardless of SSL/TLS, 
		** begin with establishing a TCP connection to a remote host:port. 
		** External security-related infrastructure such as software firewalls 
		** (Windows Firewall), hardware firewalls, anti-virus, at either source 
		** or destination (or both) can block the connection. 
		** If the connection fails, make sure to check all potential external causes of blockage.
		** 
		** Fixed for Version 61: Fixed TLS connection issue 
		** with some cipher suites on Big Endian machines.
		**
		** Fixed for version 92: Automatically clears the internal cached directory 
		** listing when disconnecting or connecting. Previously, 
		** it might’ve been needed to call the ClearDirCache function.
		**
		** Fixed in version 99: In some cases, Chilkat failed to establish connections 
		** trying to use aes-gcm. This was fixed. (It was not common.)
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning OF iChilkat.VCX], lcCommandCharSet AS Character
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCalculatedBuildNumber
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		lcCommandCharSet = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      ** Before version 92 test
		      IF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 92)
		
		        .ClearDirCache()
		
		      ENDIF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 92)
		      ** Before version 92 test
		
		      TRY
		
		        STORE m.loChilkatObject.Connect() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have versioning object test
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  ** Process successful test
		  IF m.liReturn = 1
		
		    .AutoFixSettings()
		
		    ** This will update the property value...
		    lcCommandCharset = .CommandCharSet
		
		  ENDIF m.liReturn = 1
		  ** End process successful test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test 
	ENDPROC

	PROCEDURE connectasync		&& Creates an asynchronous task to call the Connect method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            ConnectAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    Connect method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the Connect method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		** 
		** Fixed for Version 61: Fixed TLS connection issue 
		** with some cipher suites on Big Endian machines.
		**
		** Fixed for version 92: Automatically clears the internal cached directory 
		** listing when disconnecting or connecting. Previously, 
		** it might’ve been needed to call the ClearDirCache function.
		**
		** Fixed in version 99: In some cases, Chilkat failed to establish connections 
		** trying to use aes-gcm. This was fixed. (It was not common.)
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liCalculatedBuildNumber AS Integer, ;
		lcCommandCharSet AS Character, loVersioning AS [iVersioning OF iChilkat.VCX]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, m.loVersioning
		STORE 0 TO m.liIntroducedInBuild, m.liCalculatedBuildNumber
		
		lcCommandCharSet = []
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF VARTYPE(m.loVersioning) == T_OBJECT ;
		      AND (NOT ISNULL(m.loVersioning))
		
		        ** Before version 92 test
		        IF m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 92)
		
		          .ClearDirCache()
		
		        ENDIF m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 92)
		        ** Before version 92 test
		
		        TRY
		
		          loChilkatTask = m.loChilkatObject.ConnectAsync()
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		      AND (NOT ISNULL(m.loVersioning))
		      ** Have a good object test
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		    ** Process successful test
		    IF NOT ISNULL(m.loChilkatTask)
		
		      .AutoFixSettings()
		
		      ** This will update the property value...
		      lcCommandCharset = .CommandCharSet
		
		    ENDIF NOT ISNULL(m.loChilkatTask)
		    ** End process successful test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE connectfailreason_access		&& Access method used to retrieve the Chilkat ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 ConnectFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectFailReason
		* Date Added:        02/23/2022
		*==============================================================================
		
		**
		** If the Connect method fails, this property can be checked 
		** to determine the reason for failure.
		**
		** Possible values are:
		**
		** 0 = success
		**
		** Normal (non-TLS) sockets:
		** 1 = empty hostname
		** 2 = DNS lookup failed
		** 3 = DNS timeout
		** 4 = Aborted by application.
		** 5 = Internal failure.
		** 6 = Connect Timed Out
		** 7 = Connect Rejected (or failed for some other reason)
		**
		** SSL/TLS:
		** 100 = TLS internal error.
		** 101 = Failed to send client hello.
		** 102 = Unexpected handshake message.
		** 103 = Failed to read server hello.
		** 104 = No server certificate.
		** 105 = Unexpected TLS protocol version.
		** 106 = Server certificate verify failed (the server certificate is expired or the cert's signature verification failed).
		** 107 = Unacceptable TLS protocol version.
		** 109 = Failed to read handshake messages.
		** 110 = Failed to send client certificate handshake message.
		** 111 = Failed to send client key exchange handshake message.
		** 112 = Client certificate's private key not accessible.
		** 113 = Failed to send client cert verify handshake message.
		** 114 = Failed to send change cipher spec handshake message.
		** 115 = Failed to send finished handshake message.
		** 116 = Server's Finished message is invalid.
		** 125 = TLS Pin Set Mismatch. (Added in version 78)
		** 
		** FTP:
		** 200 = Connected, but failed to receive greeting from FTP server.
		** 201 = Failed to do AUTH TLS or AUTH SSL.
		** Protocol/Component:
		** 300 = asynch op in progress
		** 301 = login failure.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connectfailreason_assign		&& Assign method used to hold a reference to the ConnectFailReason property.
		*==============================================================================
		* Method:            ConnectFailReason_Assign
		* Purpose:           Assign method used to hold a reference to the ConnectFailReason property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ConnectFailReason property.
		* Returns:           
		* Date Added:        02/23/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [LongReadOnly]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE connectonly		&& Connects to the FTP server, but does not authenticate. The combination of calling this method followed by LoginAfterConnectOnly is the equivalent of calling the Connect method (which both connects and authenticates).
		*==============================================================================
		* Method:            ConnectOnly
		* Purpose:           Connects to the FTP server, but does not authenticate.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Connects to the FTP server, but does not authenticate. 
		** The combination of calling this method followed by LoginAfterConnectOnly 
		** is the equivalent of calling the Connect method (which both connects and authenticates).
		**
		** Important: All TCP-based Internet communications, regardless of the protocol 
		** (such as HTTP, FTP, SSH, IMAP, POP3, SMTP, etc.), and regardless of SSL/TLS, 
		** begin with establishing a TCP connection to a remote host:port. 
		** External security-related infrastructure such as software firewalls (Windows Firewall), 
		** hardware firewalls, anti-virus, at either source or destination (or both) 
		** can block the connection. If the connection fails, 
		** make sure to check all potential external causes of blockage.
		** 
		** Fixed for Version 61: Fixed TLS connection issue 
		** with some cipher suites on Big Endian machines.
		**
		** Fixed for version 92: Automatically clears the internal cached directory 
		** listing when disconnecting or connecting. Previously, 
		** it might’ve been needed to call the ClearDirCache function.
		**
		** Fixed in version 99: In some cases, Chilkat failed to establish connections 
		** trying to use aes-gcm. This was fixed. (It was not common.)
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning OF iChilkat.VCX], lcCommandCharSet AS Character
		
		STORE 0 TO m.liReturn, m.luReturn, m.liCalculatedBuildNumber
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		lcCommandCharSet = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		    loVersioning = .oVersioning
		
		    ** Have versioning object test
		    IF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		
		      ** Before version 92 test
		      IF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 92)
		
		        .ClearDirCache()
		
		      ENDIF m.liCalculatedBuildNumber < loVersioning.GenerateVersionNumber(9, 5, 92)
		      ** Before version 92 test
		
		      TRY
		
		        STORE m.loChilkatObject.ConnectOnly() TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		    AND (NOT ISNULL(m.loVersioning))
		    ** End have versioning object test
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  ** Process successful test
		  IF m.liReturn = 1
		
		    .AutoFixSettings()
		
		    ** This will update the property value...
		    lcCommandCharset = .CommandCharSet
		
		  ENDIF m.liReturn = 1
		  ** End process successful test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE connectonlyasync		&& Creates an asynchronous task to call the ConnectOnly method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            ConnectOnlyAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    ConnectOnly method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Task Object, or NULL
		* Date Added:        02/28/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the ConnectOnly method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		** 
		** Fixed for Version 61: Fixed TLS connection issue 
		** with some cipher suites on Big Endian machines.
		**
		** Fixed for version 92: Automatically clears the internal cached directory 
		** listing when disconnecting or connecting. Previously, 
		** it might’ve been needed to call the ClearDirCache function.
		**
		** Fixed in version 99: In some cases, Chilkat failed to establish connections 
		** trying to use aes-gcm. This was fixed. (It was not common.)
		**
		** Returns Nothing on failure
		** 
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liCalculatedBuildNumber AS Integer, ;
		lcCommandCharSet AS Character, loVersioning AS [iVersioning OF iChilkat.VCX]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask, m.loVersioning
		STORE 0 TO m.liIntroducedInBuild, m.liCalculatedBuildNumber 
		
		lcCommandCharSet = []
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF VARTYPE(m.loVersioning) == T_OBJECT ;
		      AND (NOT ISNULL(m.loVersioning))
		
		        ** Before version 92 test
		        IF m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 92)
		
		          .ClearDirCache()
		
		        ENDIF m.liCalculatedBuildNumber < m.loVersioning.GenerateVersionNumber(9, 5, 92)
		        ** Before version 92 test
		
		        TRY
		
		          loChilkatTask = m.loChilkatObject.ConnectOnlyAsync()
		
		        CATCH TO m.loException
		
		          .CallToChilkatError(m.loException, THIS)
		
		        ENDTRY
		
		      ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		      AND (NOT ISNULL(m.loVersioning))
		      ** Have a good object test
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		    ** Process successful test
		    IF NOT ISNULL(m.loChilkatTask)
		
		      .AutoFixSettings()
		
		      ** This will update the property value...
		      lcCommandCharset = .CommandCharSet
		
		    ENDIF NOT ISNULL(m.loChilkatTask)
		    ** End process successful test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE connecttimeout_access		&& Access method used to retrieve the Chilkat ConnectTimeout property.
		*==============================================================================
		* Method:            ConnectTimeout_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 ConnectTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectTimeout
		* Date Added:        02/24/2022
		*==============================================================================
		
		**
		** Maximum number of seconds to wait when connecting to an FTP server. 
		** The default is 30 seconds. A value of 0 indicates the willingness to wait forever.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [Long]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connecttimeout_assign		&& Assign method used to hold a reference to the ConnectTimeout property.
		*==============================================================================
		* Method:            ConnectTimeout_Assign
		* Purpose:           Assign method used to hold a reference to the ConnectTimeout property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiValue, integer value 
		*                    used to hold a reference to the ConnectTimeout property.
		* Returns:           
		* Date Added:        02/24/2022
		*==============================================================================
		
		LPARAMETERS tiValue AS Integer
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [Long]
		
		THIS.CallAssignObject(m.tiValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE connectverified_access		&& Access method used to retrieve the Chilkat ConnectVerified property.
		*==============================================================================
		* Method:            ConnectVerified_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 ConnectVerified property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.ConnectVerified
		* Date Added:        02/24/2022
		*==============================================================================
		
		**
		** True if the FTP2 component was able to establish a TCP/IP connection 
		** to the FTP server after calling Connect.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBitReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE connectverified_assign		&& Assign method used to hold a reference to the ConnectVerified property.
		*==============================================================================
		* Method:            ConnectVerified_Assign
