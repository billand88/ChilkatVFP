	PROCEDURE fromder		&& Loads a DSA private key from in-memory DSA DER-encoded bytes. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FromDER
		* Purpose:           Loads a DSA private key from in-memory DSA DER-encoded bytes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqDERData, the DER data to load.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/22/2022
		*==============================================================================
		
		**
		** Loads a DSA private key from in-memory DSA DER-encoded bytes.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tqDERData AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.FromDER(m.tqDERData) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE fromderbd		&& Introduced in version 11.0.0. Loads a DSA private key from DER contained in bd. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            FromDERBd
		* Purpose:           Loads a DSA private key from DER contained in bd.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/05/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		** 
		** Loads a DSA private key from DER contained in bd.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_DSA_COM_CALL, loException AS Exception, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], llImplemented AS Logical, ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		    ** Method implemented test
		    IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.FromDERBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = m.loParkParameterBinData.SetObject(;
		      m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_DSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

