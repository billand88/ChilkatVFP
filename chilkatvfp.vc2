	PROCEDURE openchilkatstore		&& Opens the certificate store used by Chilkat Mail and returns the object representing that store. Returns Nothing on failure.
		*==============================================================================
		* Method:            OpenChilkatStore
		* Purpose:           Opens the certificate store used by Chilkat Mail 
		*                    and returns the object representing that store.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           Chilkat Certificate Store Object, or NULL
		* Date Added:        07/24/2022
		*==============================================================================
		
		**
		** Opens the certificate store used by Chilkat Mail 
		** and returns the object representing that store.
		** 
		** Returns Nothing on failure.
		**
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.CreateCS], ;
		loException AS Exception, loChilkatCertStore AS [Chilkat_9_5_0.CertStore]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatCertStore
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatCertStore = m.loChilkatObject.OpenChilkatStore()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatCertStore
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.CreateCS])
		  loChilkatCertStore = NEWOBJECT([Chilkat_9_5_0.CertStore])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

