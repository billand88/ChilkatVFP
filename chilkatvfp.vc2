	PROCEDURE opensmartcard		&& Introduced in version 9.5.0.80. Opens the certificate store on the smartcard currently in the reader or USB token. The csp can be set to the name of the CSP (Cryptographic Service Provider) that should be used.
		*==============================================================================
		* Method:            OpenSmartCard
		* Purpose:           Opens the certificate store on the smartcard 
		*                    currently in the reader or USB token.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCSP, the Cryptographic Service Provider to open the card.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.80
		**
		** Opens the certificate store on the smartcard currently in the reader or USB token.
		** 
		** The csp can be set to the name of the CSP (Cryptographic Service Provider) 
		** that should be used. If csp is an empty string, then the 1st CSP found 
		** matching one of the following names will be used:
		** 
		**   Microsoft Smart Card Key Storage Provider
		**   Microsoft Base Smart Card Crypto Provider
		**   Bit4id Universal Middleware Provider
		**   YubiHSM Key Storage Provider (starting in v9.5.0.83)
		**   eToken Base Cryptographic Provider
		**   FTSafe ePass1000 RSA Cryptographic Service Provider
		**   SecureStoreCSP
		**   EnterSafe ePass2003 CSP v2.0
		**   Gemalto Classic Card CSP
		**   PROXKey CSP India V1.0
		**   PROXKey CSP India V2.0
		**   TRUST KEY CSP V1.0
		**   Watchdata Brazil CSP V1.0
		**   Luna Cryptographic Services for Microsoft Windows
		**   Luna SChannel Cryptographic Services for Microsoft Windows
		**   Safenet RSA Full Cryptographic Provider
		**   nCipher Enhanced Cryptographic Provider
		**   SafeSign Standard Cryptographic Service Provider
		**   SafeSign Standard RSA and AES Cryptographic Service Provider
		**   MySmartLogon NFC CSP
		**   NFC Connector Enterprise
		**   ActivClient Cryptographic Service Provider
		**   EnterSafe ePass2003 CSP v1.0
		**   Oberthur Card Systems Cryptographic Provider
		**   Athena ASECard Crypto CSP"
		**
		** Fixed for version 83: Improved internal functionality relating to SmartCards, Storage Providers, etc. 
		** 
		** (This method is only available on Microsoft Windows operating systems.)
		**
		** --> Significanty enhanced for version 10.1.2. <--
		**
		** This function identifies connected HSM devices such as smart cards and USB tokens, 
		** and loads the certificates from each device. It has been significantly enhanced in Chilkat v10.1.2 
		** and is compatible with Windows, MacOS, iOS, and Linux. Android is not supported.
		** 
		** Note: If multiple HSM devices are connected, avoid setting the SmartCardPin property 
		** unless all devices share the same PIN. Otherwise, Chilkat will attempt to use that PIN for each device, 
		** which could cause issues.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcCSP AS Character
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 80
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        STORE m.loChilkatObject.OpenSmartCard(m.tcCSP) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE openwindowsstore		&& Introduced in version 9.5.0.49. (This method only available on Microsoft Windows operating systems.) Opens a Microsoft Windows certificate store. storeLocation must be "CurrentUser" or "LocalMachine".
		*==============================================================================
		* Method:            OpenWindowsStore
		* Purpose:           Opens an arbitrary registry-based certificate store. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcStoreLocation, the certificate store location.
		*                    tcStoreName, the name of the certificate store.
		*                    tuReadOnly, whether or not to open the certificate store read only.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.49
		**
		** (This method only available on Microsoft Windows operating systems.)
		** Opens a Microsoft Windows certificate store. 
		** storeLocation must be "CurrentUser" or "LocalMachine". 
		** storeName is the name of the certificate store to open. 
		** It may be any of the following:
		**
		**   AddressBook: Certificate store for other users.
		**   AuthRoot: Certificate store for third-party certification authorities (CAs).
		**   CertificationAuthority: Certificate store for intermediate certification authorities (CAs).
		**   Disallowed: Certificate store for revoked certificates.
		**   My: Certificate store for personal certificates.
		**   Root: Certificate store for trusted root certification authorities (CAs).
		**   TrustedPeople: Certificate store for directly trusted people and resources.
		**   TrustedPublisher: Certificate store for directly trusted publishers.
		**
		** Setting readOnly = 1 causes the certificate store to be opened read-only, 
		** and will prevent "permission denied" errors caused by the need for read-write permission.
		** 
		** Once loaded, the certificates within the store may be searched via the Find* methods. 
		** An application may also iterate from 0 to NumCertficates-1 and call GetCertificate 
		** to access each certificate by index.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcStoreLocation AS Character, tcStoreName AS Character, tuReadOnly AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		liIntroducedInBuild AS Integer, llImplemented AS Logical, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liReadOnly AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liReadOnly, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 49
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liReadOnly = .LogicalToBit(m.tuReadOnly)
		
		      TRY
		
		        STORE m.loChilkatObject.OpenWindowsStore(m.tcStoreLocation, ;
		        m.tcStoreName, m.liReadOnly) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE removecertificate		&& (This method only available on Microsoft Windows operating systems.) Removes the passed certificate from the store.  The certificate object passed as the argument can no longer be used once removed. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            RemoveCertificate
		* Purpose:           Removes the passed certificate from the store.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/27/2022
		*==============================================================================
		
		**
		** (This method only available on Microsoft Windows operating systems.)
		** 
		** Removes the passed certificate from the store. 
		** The certificate object passed as the argument can no longer be used once removed.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_CERTSTORE_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.RemoveCertificate(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		 
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CERTSTORE_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE smartcardpin_access		&& Access method used to retrieve the Chilkat CertStore SmartCardPIN property.
		*==============================================================================
		* Method:            SmartCardPIN_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat CertStore SmartCardPIN property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SmartCardPIN
		* Date Added:        07/27/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.86
		**
		** Can be set to the PIN value for a certificate / private key stored on a smart card.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 86
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE smartcardpin_assign		&& Assign method used to hold a reference to the SmartCardPIN property.
		*==============================================================================
		* Method:            SmartCardPIN_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat CertStore SmartCardPIN property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SmartCardPIN property.
		* Returns:           
		* Date Added:        07/27/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 86
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE uncommonoptions_access		&& Access method used to retrieve the Chilkat CertStore UncommonOptions property.
		*==============================================================================
