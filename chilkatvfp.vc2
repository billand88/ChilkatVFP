	PROCEDURE sleepms		&& Introduced in version 9.5.0.59. Convenience method to force the calling thread to sleep for a number of milliseconds.
		*==============================================================================
		* Method:            SleepMs
		* Purpose:           Convenience method to force the calling thread 
		*                    to sleep for a number of milliseconds.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiWaitMs -- the millisecond sleep time.
		* Returns:           
		* Date Added:        06/05/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		** 
		** Convenience method to force the calling thread to sleep for a number of milliseconds.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH2_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 59
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.SleepMs(m.tiWaitMs)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE startauth		&& Introduced in version 9.5.0.59. Initiates the three-legged OAuth2 flow. The various properties, such as ClientId, ClientSecret, Scope, CodeChallenge, AuthorizationEndpoint, and TokenEndpoint, should be set prior to calling this method.
		*==============================================================================
		* Method:            StartAuth
		* Purpose:           Initiates the three-legged OAuth2 flow.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           The returned URL.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.59
		** 
		** Initiates the three-legged OAuth2 flow. The various properties, such as ClientId, 
		** ClientSecret, Scope, CodeChallenge, AuthorizationEndpoint, and TokenEndpoint, 
		** should be set prior to calling this method.
		** 
		** This method does two things:
		** 
		**   1) Forms and returns a URL that is to be loaded in a browser.
		**   2) Starts a background thread that listens on a randomly selected unused port 
		**      to receive the redirect request from the browser. The receiving of the request 
		**      from the browser, and the sending of the HTTP request to complete the three-legged 
		**      OAuth2 flow is done entirely in the background thread. The application controls 
		**      this behavior by setting the various properties beforehand.
		**  
		** The return value is the URL to be loaded (navigated to) in a popup or embedded browser.
		**
		** Note: It's best not to call StartAuth 
		** if a previous call to StartAuth is in a non-completed state. 
		** However, starting in v9.5.0.76, if a background thread from a previous call to StartAuth 
		** is still running, it will be automatically canceled. 
		** However,rather than relying on this automatic behavior, your application 
		** should explicity Cancel the previous StartAuth before calling again.
		**
		** Fixed for version 92: Automatically add “prompt=login” to the URL returned by StartAuth 
		** for Microsoft endpoints. This is to prevent browser caching.
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH2_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcURL AS Character, liCalculatedBuildNumber AS Integer, ;
		loVersioning AS [iVersioning OF iChilkat.VCX]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		liCalculatedBuildNumber = 0
		lcURL = []
		llImplemented = .F.
		liIntroducedInBuild = 59
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcURL = m.loChilkatObject.StartAuth()
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		    ** Have somewhere to navigate test
		    IF NOT EMPTY(m.lcURL)
		
		      liCalculatedBuildNumber = .iCalculatedBuildNumber
		
		      loVersioning = .oVersioning
		
		      ** Have versioning object test
		      IF VARTYPE(m.loVersioning) == T_OBJECT ;
		      AND (NOT ISNULL(m.loVersioning))
		
		        ** Version 94 or greater test
		        IF m.liCalculatedBuildNumber > loVersioning.GenerateVersionNumber(9, 5, 93)
		
		          ** Update the local VFP property with the (potentially updated) value...
		          .ListenPortSelected = .ListenPortSelected
		
		        ENDIF m.liCalculatedBuildNumber > loVersioning.GenerateVersionNumber(9, 5, 93)
		        ** End version 94 or greater test
		
		      ENDIF VARTYPE(m.loVersioning) == T_OBJECT ;
		      AND (NOT ISNULL(m.loVersioning))
		      ** End have versioning object test
		
		    ENDIF NOT EMPTY(m.lcURL)
		    ** End have somewhere to navigate test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loVersioning
		
		RETURN m.lcURL
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loVersioning = NEWOBJECT([iVersioning], [ChilkatVFP.VCX])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE stateparam_access		&& Access method used to retrieve the Chilkat oAuth2 StateParam property.
		*==============================================================================
		* Method:            StateParam_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat oAuth2 StateParam property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.StateParam
		* Date Added:        12/12/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.94
		**
		** Allows the application to explicitly set the state parameter to a value. 
		** Typically this property should remain unset, 
		** and Chilkat will automatically generate a random state. 
		** (The generated random state is not reflected in this property. 
		** In other words, you can't get the random state that was generated by reading this property.)
		** 
		** Note: The special string "{listenPort}" can be included in the value of this property. 
		** Chilkat will replace "{listenPort}" with the actual listen port used. 
		** This can be useful if your application is listening on range of ports 
		** and you want the state param to include the chosen port.
		** 
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 94
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

