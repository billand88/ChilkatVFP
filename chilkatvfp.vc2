	HIDDEN PROCEDURE signingalg_access		&& Access method used to retrieve the Chilkat Crypt2 SigningAlg property.
		*==============================================================================
		* Method:            SigningAlg_Access
		* Purpose:           Access method used to retrieve the Chilkat Crypt2 SigningAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SigningAlg
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.67
		**
		** This property selects the signature algorithm for the OpaqueSign*, Sign*, 
		** and CreateDetachedSignature, CreateP7M, and CreateP7S methods. 
		** The default value is "PKCS1-v1_5". This can be set to "RSASSA-PSS" 
		** (or simply "pss") to use the RSASSA-PSS signature scheme.
		**
		** Note: This property only applies when signing with an RSA private key. 
		** It does not apply for ECC or DSA private keys.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 67
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE signingalg_assign		&& Assign method used to hold a reference to the SigningAlg property.
		*==============================================================================
		* Method:            SigningAlg_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat Crypt2 SigningAlg property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SigningAlg property.
		* Returns:           
		* Date Added:        06/29/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3, 1]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 67
		
		lcValidationMethod = [SigningAlg]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE signingattributes_access		&& Access method used to retrieve the Chilkat Crypt2 SigningAttributes  property.
		*==============================================================================
		* Method:            SigningAttributes_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Crypt2 SigningAttributes property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SigningAttributes
		* Date Added:        06/29/2022
		*==============================================================================
		
		** 
		** Introduced in version 9.5.0.75
		** 
		** Contains JSON to specify the authenticated (signed) attributes 
		** or unauthenticated (unsigned) attributes that are to be included in CMS signatures. 
		** The default value is:
		** 
		**   {
		**       "contentType": 1,
		**       "signingTime": 1,
		**       "messageDigest": 1
		**   }
		** 
		** Other possible values that can be added are:
		** 
		** signingCertificateV2
		** signingCertificate
		** sMIMECapabilities
		** microsoftRecipientInfo
		** encrypKeyPref
		** cmsAlgorithmProtection
		** 
		** Contact Chilkat (support@chilkatsoft.com) about other signed/unsigned attributes 
		** that may be needed for CAdES signatures.
		**
		** Fixed for Version 95:  If an application included a {“signingCertificateV2”: 0} in this property, 
		** with the desired intent to NOT include the SigningCertificateV2 authenticated attribute, 
		** Chilkat was not doing as directed and the SigningCertificateV2 attribute 
		** was still getting added to the PKCS7 signature. This is now fixed.
		** 
		** Enhancement for Version 10: Added the ability to create and verify 
		** AES-GCM authEnvelopedData. 
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 75
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

