	HIDDEN PROCEDURE sockshostname_access		&& Access method used to retrieve the Chilkat IMAP SOCKSHostName property.
		*==============================================================================
		* Method:            SOCKSHostName_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP SOCKSHostName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SOCKSHostName
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** The SOCKS4/SOCKS5 hostname or IPv4 address (in dotted decimal notation). 
		** This property is only used if the SocksVersion property is set to 4 or 5).
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sockshostname_assign		&& Assign method used to hold a reference to the SOCKSHostName property.
		*==============================================================================
		* Method:            SOCKSHostName_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat IMAP SOCKSHostName property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SOCKSHostName property.
		* Returns:           
		* Date Added:        06/15/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sockspassword_access		&& Access method used to retrieve the Chilkat IMAP SOCKSPassword property.
		*==============================================================================
		* Method:            SOCKSPassword_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat IMAP SOCKSPassword property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SOCKSPassword
		* Date Added:        06/15/2022
		*==============================================================================
		
		**
		** The SOCKS5 password (if required). The SOCKS4 protocol 
		** does not include the use of a password, so this does not apply to SOCKS4.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sockspassword_assign		&& Assign method used to hold a reference to the SOCKSPassword property.
		*==============================================================================
