	HIDDEN PROCEDURE apikeyheader_access		&& Access method used to retrieve the Chilkat AI APIKeyHeader property.
		*==============================================================================
		* Method:            APIKeyHeader_Access
		* Purpose:           Access method used to retrieve the Chilkat AI APIKeyHeader property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.APIKeyHeader
		* Date Added:        12/14/2025
		*==============================================================================
		
		**
		** Introduced in version 11.3.0
		** 
		** For custom Providers, use this field name for the API key in the HTTP header, 
		** but only if the API key is to be placed in a custom header field. 
		** If the API key is to be provided in an "Authorization: Bearer" header, 
		** then leave this property empty.
		** 
		** The default value of this property is the empty string.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 3
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE apikeyheader_assign		&& Assign method used to hold the Chilkat AI APIKeyHeader property.
		*==============================================================================
		* Method:            APIKeyHeader_Assign
		* Purpose:           Assign method used to hold the Chilkat AI APIKeyHeader property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value used to hold a reference to the APIKeyHeader property.
		* Returns:           
		* Date Added:        12/14/2025
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_IntroducedInBuild[3]
		
		lcValidationMethod = []
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 3
		la_IntroducedInBuild[3] = 0
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE apikey_access		&& Access method used to retrieve the Chilkat AI APIKey property.
		*==============================================================================
		* Method:            APIKey_Access
		* Purpose:           Access method used to retrieve the Chilkat AI APIKey property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.APIKey
		* Date Added:        11/03/2025
		*==============================================================================
		
		**
		** Introduced in version 11.2.0
		**
		** This is the API key used for authentication. Use your API key that matches your Provider.
		**
		** Suggestion: Use Chilkat's Secrets class to store and retrieve API keys in any of the following locations.
		** 
		** Windows Credentials Manager
		** Apple Keychain
		** AWS Secrets Manager
		** Azure Key Vault
		** IBM Cloud Secrets Manager
		** Oracle Cloud Secrets
		** Doppler Secrets
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		la_IntroducedInBuild[1] = 11
		la_IntroducedInBuild[2] = 2
		la_IntroducedInBuild[3] = 0
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

