	ENDPROC

	PROCEDURE addelementdt		&& Adds a new date-formatted element to the Atom document. The tag is a string such as "created", "modified", "issued", etc. Returns the index of the element added, or -1 for failure.
		*==============================================================================
		* Method:            AddElementDt
		* Purpose:           Adds a new date-formatted element to the Atom document.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcTag -- the tag name to add.
		*                    toChilkatCkDateTime -- a Chilkat Date Time object.
		* Returns:           Returns the index of the element added, or -1 for failure.
		* Date Added:        07/30/2022
		*==============================================================================
		
		**
		** Adds a new date-formatted element to the Atom document. 
		** The tag is a string such as "created", "modified", "issued", etc. 
		** The dateTimeStr should be an RFC822 formatted date/time string such as 
		** "Tue, 25 Sep 2012 12:25:32 -0500". 
		**
		** Returns the index of the element added, or -1 for failure.
		**
		
		LPARAMETERS tcTag AS Character, toChilkatCkDateTime AS [Chilkat_9_5_0.CkDateTime]
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Atom], ;
		loException AS Exception, liElementIndex AS Integer, ;
		loParkParameterCkDateTime AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCkDateTime AS [Chilkat_9_5_0.CkDateTime]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		liElementIndex = 0
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCkDateTime = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCkDateTime)
		
		    loChilkatCkDateTime = m.loParkParameterCkDateTime.GetObject()
		
		    TRY
		
		      liElementIndex = m.loChilkatObject.AddElementDt(m.tcTag, m.loChilkatCkDateTime)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCkDateTime = ;
		    m.loChilkatCkDateTime.SetObject(m.toChilkatCkDateTime, m.loChilkatCkDateTime)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCkDateTime, m.loChilkatCkDateTime
		
		RETURN m.liElementIndex
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Atom])
		  toChilkatCkDateTime = NEWOBJECT([Chilkat_9_5_0.CkDateTime])
		  loParkParameterCkDateTime = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCkDateTime = NEWOBJECT([Chilkat_9_5_0.CkDateTime])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

