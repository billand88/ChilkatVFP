		  AND (NOT ISNULL(m.loChilkatObject))
		
		    liValue = .LogicalToBit(m.tuValue)
		
		    loParkParameterMessageSet = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatMessageSet)
		
		    loChilkatMessageSet = m.loParkParameterMessageSet.GetObject()
		
		    TRY
		 
		      STORE m.loChilkatObject.SetFlags(m.loChilkatMessageSet, ;
		      m.tcFlagName, m.liValue) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatMessageSet = m.loParkParameterMessageSet.SetObject(;
