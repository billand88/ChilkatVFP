		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setedifactbody		&& Introduced in version 9.5.0.28. Creates a typical email used to send EDIFACT messages
		*==============================================================================
		* Method:            SetEDIFACTBody
		* Purpose:           Creates a typical email used to send EDIFACT messages.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcMessage -- the message to use in the EDIFACT message body
		*                    tcAttributeName -- sets the Content-Type header name to this parameter.
		*                    tcFileName -- set to Content-Disposition's 
		*                    "filename" attribute to this parameter.
		*                    tcCharset -- the message conversion setting.
		* Returns:           
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.28
		**
		** Creates a typical email used to send EDIFACT messages. Does the following:
		**
		** 1. Sets the email body to the EDIFACT message passed in message.
		** 2. Sets the Content-Transfer-Encoding to Base64.
		** 3. Set the Content-Type equal to "application/EDIFACT".
		** 4. Sets the Content-Type header's name attribute to name.
		** 5. Sets the Content-Disposition equal to "attachment".
		** 6. Sets the Content-Disposition's "filename" attribute equal to filename.
		** 7. The EDIFACT message is converted to the charset indicated by charset, 
		** and encoded using Base64 in the email body.
		**
		** The email's subject, recipients, FROM address, and other headers are left unmodified.
		**
		
		LPARAMETERS tcMessage AS Character, tcAttributeName AS Character, ;
		tcFileName AS Character, tcCharset AS Character
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 28
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        m.loChilkatObject.SetEDIFACTBody(m.tcMessage, m.tcAttributeName, m.tcFileName, m.tcCharset)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE setencryptcert		&& Set the encryption certificate to be used in encryption. Use the CreateCS, CertStore, and Cert classes to create a Cert object by either locating a certificate in a certificate store or loading one from a file. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            SetEncryptCert
		* Purpose:           Set the encryption certificate to be used in encryption.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Set the encryption certificate to be used in encryption. 
		** Use the CreateCS, CertStore, and Cert classes to create 
		** a Cert object by either locating a certificate 
		** in a certificate store or loading one from a file.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Fixed in Version 69: Fixed an issue with automatically locating 
		** pre-installed Windows certificates (for encryption) 
		** when the email address stored within the certificate used uppercase letters.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		loException AS Exception, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    loParkParameterCert = ;
		    NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		    loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetEncryptCert(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		    toChilkatCert = ;
		    m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

