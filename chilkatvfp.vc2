	PROCEDURE torawrequest		&& Introduced in version 11.5.0. Used for debugging purposes.
		*==============================================================================
		* Method:            ToRawRequest
		* Purpose:           Used for debugging purposes.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcCurl, the Curl to be examined.
		*                    toChilkatStringBuidler, the object to hold the results of the examination.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/15/2026
		*==============================================================================
		
		**
		** Introduced in version 11.5.0
		**
		** Used for debugging purposes. This method behaves the same as DoYourThing, 
		** but only converts the curlCommand to an HTTP request message in sb containing the full structure:
		** 
		**   start line
		**   headers
		**   optional body or multipart body
		** 
		** It does not actually send the HTTP request.
		** 
		** If no execution plan is possible with the current known inputs and outputs, 
		** then json provides information about what is missing and the method returns 0.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcCurl AS Character, toChilkatStringBuidler AS [Chilkat.StringBuidler]
		
		LOCAL loChilkatObject AS [Chilkat.HttpCurl], loException AS Exception, ;
		llImplemented AS Logical, liReturn AS Integer, luReturn AS Unknown, ;
		loParkParameterStringBuidler AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuidler AS [Chilkat.StringBuidler]
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuidler, m.loChilkatStringBuidler
		STORE 0 TO m.liReturn, m.luReturn
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 5, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuidler = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuidler)
		
		      loChilkatStringBuidler = m.loParkParameterStringBuidler.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.ToRawRequest(m.tcCurl, ;
		        m.loChilkatStringBuidler) TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuidler = ;
		      m.loParkParameterStringBuidler.SetObject(m.toChilkatStringBuidler, m.loChilkatStringBuidler)
		    
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuidler, m.loChilkatStringBuidler
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat.HttpCurl])
		  loException = NEWOBJECT([Exception])
		  toChilkatStringBuidler = NEWOBJECT([Chilkat.StringBuidler])
		  loParkParameterChilkatStringBuidler = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuidler = NEWOBJECT([Chilkat.StringBuidler])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

