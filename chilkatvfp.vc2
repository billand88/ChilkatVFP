	PROCEDURE setsslclientcert		&& Specifies a client-side certificate to be used for the SSL / TLS connection. In most cases, servers do not require client-side certificates for SSL/TLS.
		*==============================================================================
		* Method:            SetSSLClientCert
		* Purpose:           Specifies a client-side certificate to be used for the SSL / TLS connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatCert, a Chilkat Certificate object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Specifies a client-side certificate to be used for the SSL / TLS connection. 
		** In most cases, servers do not require client-side certificates for SSL/TLS. 
		** A client-side certificate is typically used in high-security situations 
		** where the certificate is an additional means to indentify the client to the server.
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Returns 1 for success, 0 for failure
		** 
		
		LPARAMETERS toChilkatCert AS CHILKAT_CERT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		loParkParameterCert AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatCert AS CHILKAT_CERT_COM_CALL, liReturn AS Integer, ;
		luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		     loParkParameterCert = ;
		     NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatCert)
		
		     loChilkatCert = m.loParkParameterCert.GetObject()
		
		    TRY
		
		      STORE m.loChilkatObject.SetSSLClientCert(m.loChilkatCert) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		     toChilkatCert = ;
		     m.loParkParameterCert.SetObject(m.toChilkatCert, m.loChilkatCert)
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterCert, m.loChilkatCert
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  toChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loParkParameterCert = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatCert = NEWOBJECT(CHILKAT_CERT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

	PROCEDURE setsslclientcertpem		&& Same as SetSslClientCert, but allows a .pfx/.p12 file to be used directly) Specifies a client-side certificate to be used for the SSL / TLS connection. In most cases, servers do not require client-side certificates for SSL/TLS.
		*==============================================================================
		* Method:            SetSSLClientCertPEM
		* Purpose:           Specifies a client-side certificate to be used for the SSL / TLS connection.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPEMDataOrPath -- the PEM data or path to the PEM 
		*                    tcPEMPassword -- the PEM password
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** (Same as SetSslClientCert, but allows a .pfx/.p12 file to be used directly)
		** Specifies a client-side certificate to be used for the SSL / TLS connection. 
		** In most cases, servers do not require client-side certificates for SSL/TLS. 
		** A client-side certificate is typically used in high-security situations 
		** where the certificate is an additional means to indentify the client to the server.
		**
		** The pemDataOrFilename may contain the actual PEM data, 
		** or it may contain the path of the PEM file. 
		** This method will automatically recognize whether it is a path or the PEM data itself.
		**
		** Enhancement for Version 75: Added the ability to open .pfx/.p12 
		** files where two different passwords are required: 
		** one for integrity and the other for the private keys. 
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcPEMDataOrPath AS Character, tcPEMPassword AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.SetSSLClientCertcPEM(m.tcPEMDataOrPath, m.tcPEMPassword) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

