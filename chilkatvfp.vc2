DEFINE CLASS upload AS ibasechilkat OF "chilkatvfp.vcx" 		&& This is a class to upload files over HTTP and HTTPS to a web server. Supports both HTTP and HTTPS protocols. Progress monitoring with percentage completion and "heartbeat" monitoring. 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "foxpro.h"
	*<DefinedPropArrayMethod>
		*m: abortcurrent_access		&& Access method used to retrieve the Chilkat Upload AbortCurrent property.
		*m: abortcurrent_assign		&& Assign method used to hold a reference to the AbortCurrent property.
		*m: abortupload		&& May be called during an asynchronous upload to abort.
		*m: addcustomheader		&& Adds a custom HTTP header to the HTTP upload.
		*m: addfilereference		&& Adds a file to the list of files to be uploaded in the next call to BlockingUpload, BeginUpload, or UploadToMemory. To upload more than one file, call this method once for each file to be uploaded.
		*m: addparam		&& Adds a custom HTTP request parameter to the upload.
		*m: bandwidththrottleup_access		&& Access method used to retrieve the Chilkat Upload BandwidthThrottleUp property.
		*m: bandwidththrottleup_assign		&& Assign method used to hold a reference to the BandwidthThrottleUp property.
		*m: beginupload		&& Starts an asynchronous upload. Only one asynchronous upload may be in progress at a time. To achieve multiple asynchronous uploads, use multiple instances of the Chilkat Upload object.
		*m: blockingupload		&& Uploads files to a web server using HTTP. The files to be uploaded are indicated by calling AddFileReference once for each file (prior to calling this method). Returns 1 for success, 0 for failure.
		*m: blockinguploadasync		&& Creates an asynchronous task to call the BlockingUpload method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: chunksize_access		&& Access method used to retrieve the Chilkat Upload ChunkSize property.
		*m: chunksize_assign		&& Assign method used to hold a reference to the ChunkSize property.
		*m: clearfilereferences		&& Clears the internal list of files created by calls to AddFileReference.
		*m: clearparams		&& Clears the internal list of params created by calls to AddParam.
		*m: clientipaddress_access		&& Access method used to retrieve the Chilkat Upload ClientIPAddress property.
		*m: clientipaddress_assign		&& Assign method used to hold a reference to the ClientIPAddress property.
		*m: currentfilename_access		&& Access method used to retrieve the Chilkat Upload CurrentFileName property.
		*m: currentfilename_assign		&& Assign method used to hold a reference to the CurrentFileName property.
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat Upload DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: expect100continue_access		&& Access method used to retrieve the Chilkat Upload Expect100Continue property.
		*m: expect100continue_assign		&& Assign method used to hold a reference to the Expect100Continue property.
