		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE dirlistingcharset_access		&& Access method used to retrieve the Chilkat DirListingCharset property.
		*==============================================================================
		* Method:            DirListingCharset_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat FTP2 DirListingCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DirListingCharset
		* Date Added:        02/24/2022
		*==============================================================================
		
		** 
		** Indicates the charset of the directory listings received from the FTP server. 
		** The FTP2 client must interpret the directory listing bytes using the correct 
		** character encoding in order to correctly receive non-English characters. 
		** The default value of this property is "ansi".
		**
		** This property may be updated to "utf-8" after connecting because 
		** a "FEAT" command is automatically sent to get the features of the FTP server. 
		** If UTF8 is indicated as a feature, then this property is automatically changed to "utf-8".
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE dirlistingcharset_assign		&& Assign method used to hold a reference to the DirListingCharset property.
		*==============================================================================
		* Method:            DirListingCharset_Assign
		* Purpose:           Assign method used to hold 
		*                    the Chilkat FTP2 DirListingCharset property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the DirListingCharset property.
		* Returns:           
		* Date Added:        02/24/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
		LOCAL lcValidationMethod AS Character, lcMethodToCall AS Character
		
		lcValidationMethod = [Charset]
		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE dirtreexml		&& Recursively downloads the structure of a complete remote directory tree. Returns an XML document with the directory structure. Note: Starting in version 9.5.0.47, the SyncMustMatch and SyncMustNotMatch properties apply to this method.
		*==============================================================================
		* Method:            DirTreeXML
		* Purpose:           Recursively downloads the structure of a complete remote directory tree.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcEmailAddress -- the email address to determine host name.
		* Returns:           XML document with directory structure
		* Date Added:        03/01/2022
		*==============================================================================
		
		**
		** Recursively downloads the structure of a complete remote directory tree. 
		** Returns an XML document with the directory structure.
		**
		** Note: Starting in version 9.5.0.47, the SyncMustMatch and SyncMustNotMatch properties 
		** apply to this method.
		**
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS CHILKAT_FTP2_COM_CALL, ;
		loException AS Exception, lcStructure AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcStructure = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcStructure = m.loChilkatObject.DirTreeXML()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcStructure
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_FTP2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

