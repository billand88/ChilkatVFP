	PROCEDURE renamemailbox		&& Renames a mailbox. Can also be used to move a mailbox from one location to another. For example, from "Inbox.parent.test" to "Inbox.newParent.test", or from "abc.xyz" to "def.qrs". Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            RenameMailBox
		* Purpose:           Renames a mailbox.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcFromMailBox -- the from mail box
		*                    tcToMailBox -- the renamed (or moved) mail box.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/22/2022
		*==============================================================================
		
		**
		** Renames a mailbox. Can also be used to move a mailbox from one location to another. 
		** For example, from "Inbox.parent.test" to "Inbox.newParent.test", 
		** or from "abc.xyz" to "def.qrs".
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcFromMailBox AS Character, tcToMailBox AS Character
		
		LOCAL loChilkatObject AS CHILKAT_IMAP_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.RenameMailBox(m.tcFromMailBox, m.tcToMailBox) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_IMAP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
		
	ENDPROC

