	PROCEDURE asyncdnsstart		&& Undocumented method! Initiates a background thread to do a DNS query (i.e. to resolve a hostname to an IP address). This functionality is replaced by the new model for asynchronous programming introduced in Chilkat v9.5.0.52.
		*==============================================================================
		* Method:            AsyncDNSStart
		* Purpose:           Undocumented method! 
		*                    Initiates a background thread to do a DNS query.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcHostName - the host name to resolve
		*                    tiWaitMs - the time to wait before timing out
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/10/2022
		*==============================================================================
		
		**
		** Undocumented method! 
		**
		** Initiates a background thread to do a DNS query (i.e. to resolve a hostname to
		** an IP address). The method will fail if an asynchronous operation is already in
		** progress, or if the timeout expired. The timeout (in milliseconds) is passed in
		** maxWaitMs. To wait indefinitely, set maxWaitMs to 0. Asynchronous DNS lookups can be
		** aborted by calling AsyncDnsAbort. When the async DNS operation completes, the
		** AsyncDnsFinished property will become true. If the DNS query was successful,
		** the AsyncDnsSuccess property is set to true. A debug log is available in the
		** AsyncDnsLog property. Finally, the DNS query result (i.e. IP address) is
		** available in nnn.nnn.nnn.nnn string form in the AsyncDnsResult property.
		**
		** This functionality is replaced by the new model for asynchronous programming
		** introduced in Chilkat v9.5.0.52. Applications should use the new model, which is
		** identified by methods having names ending with "Async" and return a task object.
		**
		
		LPARAMETERS tcHostName AS Character, tiMaxWaitMs AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_SOCKET_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    ** PEM not removed from class test
		    IF NOT .IsPEMRemoved(11, 0, 0)
		
		      TRY
		
		        STORE m.loChilkatObject.AsyncDNSStart(m.tcHostName, m.tiMaxWaitMs) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ENDIF NOT .IsPEMRemoved(11, 0, 0)
		    ** End PEM not removed from class test 
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SOCKET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

