		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod)
		
		RETURN
	ENDPROC

	PROCEDURE deletebundle		&& Marks multiple emails on the POP3 server for deletion. (Each email in emailBundle that is also present on the server is marked for deletion.) To complete the deletion of the emails, a "QUIT" message must be sent and the POP3 session ended.
		*==============================================================================
		* Method:            DeleteBundle
		* Purpose:           Marks multiple emails on the POP3 server for deletion.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatEmailBundle, a Chilkat Email Bundle object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Marks multiple emails on the POP3 server for deletion. 
		** (Each email in emailBundle that is also present on the server is marked for deletion.) 
		** To complete the deletion of the emails, a "QUIT" message must be sent 
		** and the POP3 session ended. This will happen automatically when the 
		** ImmediateDelete property equals 1, which is the default. 
		** If ImmediateDelete equals 0, then the Pop3EndSession method 
		** can be called to send the "QUIT" and end the session (i.e. disconnect.)
		**
		** Note: When making multiple calls to a Delete* method, 
		** it's best to turn off ImmediateDelete, and then manually 
		** call Pop3EndSession to finalize the deletions.
		**
		** Also, any method call requiring communication with the POP3 
		** server will automatically re-establish a session based on the current property settings.
		**
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loParkParameterEmailBundle AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterEmailBundle, m.loChilkatEmailBundle
		
		WITH THIS
		
