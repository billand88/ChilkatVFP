		  toChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loParkParameterEmail = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatEmail = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getheaders		&& The same as the GetAllHeaders method, except only the emails from fromIndex to toIndex on the POP3 server are returned. The first email on the server is at index 0. Returns Nothing on failure
		*==============================================================================
		* Method:            GetHeaders
		* Purpose:           The same as the GetAllHeaders method, except only the 
		*                    emails from fromIndex to toIndex on the POP3 server are returned.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiBodyLines -- the number of bodies to return.
		*                    tiFromIndex -- the beginning index number
		*                    tiToIndex -- the ending index number
		* Returns:           Chilkat Email Bundle Object, or NULL
		* Date Added:        01/17/2022
		*==============================================================================
		
		**
		** The same as the GetAllHeaders method, except only the emails from fromIndex to toIndex 
		** on the POP3 server are returned. The first email on the server is at index 0.
		**
		** Fixed for version 65: The fromIndex and toIndex arguments are inclusive. 
		** For example, if getting headers for emails 1 to 10, then 11 emails should be returned 
		** (assuming the mailbox has at least 11 emails). The fix had to do with the case when 
		** the fromIndex = 0. If fetching emails 0 to 2, then only 2 emails were returned. 
		** This is now fixed. Fetching 0 to 2 should return 3 emails.
		**
		** Update to Version 11.0.0: Method decremented.
		**
		** Fixed in Version 11.4.0: This method would return only 1 email header 
		** for calls after the first call where the requested chunk did not start at 0.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiBodyLines AS Integer, tiFromIndex AS Integer, tiToIndex AS Integer
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, loChilkatEmailBundle AS CHILKAT_EMAILBUNDLE_COM_CALL
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatEmailBundle
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		 
		      loChilkatEmailBundle = ;
		      m.loChilkatObject.GetHeaders(m.tiBodyLines, m.tiFromIndex, m.tiToIndex)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatEmailBundle
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loChilkatEmailBundle = NEWOBJECT(CHILKAT_EMAILBUNDLE_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

