	PROCEDURE getfilepermissionsasync		&& Creates an asynchronous task to call the GetFilePermissions method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*==============================================================================
		* Method:            GetFilePermissionsAsync
		* Purpose:           Creates an asynchronous task to call 
		*                    the GetFilePermissions method with the arguments provided. 
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPathOrHandle -- the file path or handle to file
		*                    tuFollowLinks, whether or not server symbolic links are followed.
		*                    tuIsHandle, whether or not the first parameter is a handle.
		* Returns:           toChilkatTask, a Chilkat Task object.
		* Date Added:        04/21/2022
		*==============================================================================
		
		**
		** Creates an asynchronous task to call the GetFilePermissions method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing 
		** in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcPathOrHandle AS Character, ;
		tuFollowLinks AS Unknown, tuIsHandle AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SFTP_COM_CALL, loException AS Exception, ;
		loChilkatTask AS CHILKAT_TASK_COM_CALL, liIntroducedInBuild AS Integer, ;
		llImplemented AS Logical, liFollowLinks AS Integer, liIsHandle AS Integer
		
		STORE 0 TO m.liIntroducedInBuild, m.liFollowLinks, m.liIsHandle 
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatTask
		
		llImplemented = .F.
		liIntroducedInBuild = 52
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liFollowLinks = .LogicalToBit(m.tuFollowLinks)
		      liIsHandle = .LogicalToBit(m.tuIsHandle)
		
		      TRY
		
		        loChilkatTask = m.loChilkatObject.GetFilePermissionsAsync(;
		        m.tcPathOrHandle, m.liFollowLinks, m.liIsHandle)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatTask
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SFTP_COM_CALL)
		  loException = NEWOBJECT([Exception])
		  loChilkatTask = NEWOBJECT(CHILKAT_TASK_COM_CALL)
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

