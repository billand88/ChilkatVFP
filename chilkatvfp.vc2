		llImplemented AS Logical, liIntroducedInBuild AS Integer, lcJSON AS Character, ;
		loParkParameterHashTable AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatHashTable AS CHILKAT_HASHTABLE_COM_CALL, liOmitOnly AS Integer
		
