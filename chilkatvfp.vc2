	PROCEDURE deletebyuidl		&& Marks an email on the POP3 server for deletion. To complete the deletion of an email, a "QUIT" message must be sent and the POP3 session ended. This will happen automatically when the ImmediateDelete property equals 1, which is the default.
		*==============================================================================
		* Method:            DeleteByUIDL
		* Purpose:           Marks an email on the POP3 server for deletion.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcUIDL, the UIDL string.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/14/2022
		*==============================================================================
		
		**
		** Marks an email on the POP3 server for deletion. 
		** To complete the deletion of an email, a "QUIT" message 
		** must be sent and the POP3 session ended. 
		** This will happen automatically when the ImmediateDelete 
		** property equals 1, which is the default. 
		** If ImmediateDelete equals 0, then the Pop3EndSession method 
		** can be called to send the "QUIT" and end the session (i.e. disconnect.)
		**
		** Note: When making multiple calls to a Delete* method, 
		** it's best to turn off ImmediateDelete, and then manually call 
		** Pop3EndSession to finalize the deletions.
		**
		** Also, any method call requiring communication with the POP3 server 
		** will automatically re-establish a session based on the current property settings.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcUIDL AS Character
		
		LOCAL loChilkatObject AS CHILKAT_MAILMAN_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.DeleteByUIDL(m.tcUIDL) ;
		      TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_MAILMAN_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

