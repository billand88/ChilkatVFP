		lcMethodToCall = [String]
		
		THIS.CallAssignObject(m.tcValue, m.lcMethodToCall, m.lcValidationMethod, @m.la_IntroducedInBuild)
		
		RETURN
	ENDPROC

	HIDDEN PROCEDURE sslprotocol_access		&& Access method used to retrieve the Chilkat Upload SSLProtocol property.
		*==============================================================================
		* Method:            SSLProtocol_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat Upload SSLProtocols property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.SSLProtocol
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.55
		**
		** Selects the secure protocol to be used for secure (SSL/TLS) connections (for both SMTP and POP3). 
		** Possible values are:
		**
		** default
		** TLS 1.3
		** TLS 1.2
		** TLS 1.1
		** TLS 1.0
		** SSL 3.0
		** TLS 1.3 or higher
		** TLS 1.2 or higher
		** TLS 1.1 or higher
		** TLS 1.0 or higher
		**
		** The default value is "default" which will choose the, 
		** which allows for the protocol to be selected dynamically at runtime based on the requirements 
		** of the server. Choosing an exact protocol will cause the connection to fail 
		** unless that exact protocol is negotiated. 
		** It is better to choose "X or higher" than an exact protocol. 
		** The "default" is effectively "SSL 3.0 or higher".
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [String]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 55
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE sslprotocol_assign		&& Assign method used to hold a reference to the SSLProtocol property.
		*==============================================================================
		* Method:            SSLProtocol_Assign
		* Purpose:           Assign method used to hold
		*                    the Chilkat Upload SSLProtocols property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcValue, character value 
		*                    used to hold a reference to the SSLProtocols property.
		* Returns:           
		* Date Added:        06/28/2022
		*==============================================================================
		
		LPARAMETERS tcValue AS Character
		
