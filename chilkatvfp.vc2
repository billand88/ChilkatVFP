	PROCEDURE gethtmlcharset		&& Examines HTML text and extracts the charset name specified by the META tag, if present. Returns Nothing on failure.
		*==============================================================================
		* Method:            GetHTMLCharset
		* Purpose:           Examines HTML text and extracts the charset name 
		*                    specified by the META tag, if present.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tqHTMLText, the HTML byte data to search.
		* Returns:           The charset name.
		* Date Added:        07/26/2022
		*==============================================================================
		
		**
		** Examines HTML text and extracts the charset name specified by the META tag, if present.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tqHTMLText AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_CHARSET_COM_CALL, ;
		loException AS Exception, lcCharsetName AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcCharsetName = []
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      lcCharsetName = m.loChilkatObject.GetHTMLCharset(m.tqHTMLText)
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcCharsetName
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_CHARSET_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

