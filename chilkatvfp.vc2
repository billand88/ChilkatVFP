	PROCEDURE getaccesstokenresponsesb		&& Introduced in version 10.1.0. Same as the AccessTokenResponse property, but returns the JSON in the sb. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            GetAccessTokenResponseSb
		* Purpose:           Calling this method is optional, and is only required if a proxy, an SSH tunnel, 
		*                    or if special connection related StringBuilder options need to be used.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatStringBuilder, a Chilkat StringBuilder object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        01/09/2025
		*==============================================================================
		
		**
		** Introduced in version 10.1.0
		**
		** Same as the AccessTokenResponse property, but returns the JSON in the sb.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS toChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH2_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		loParkParameterStringBuilder AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatStringBuilder AS CHILKAT_STRINGBUILDER_COM_CALL, ;
		liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		llImplemented = .F.
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(10, 1, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterStringBuilder = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatStringBuilder)
		
		      loChilkatStringBuilder = m.loParkParameterStringBuilder.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetAccessTokenResponseSb(m.loChilkatStringBuilder) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatStringBuilder = ;
		      m.loParkParameterStringBuilder.SetObject(m.toChilkatStringBuilder, m.loChilkatStringBuilder)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterStringBuilder, m.loChilkatStringBuilder
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  toChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loParkParameterStringBuilder = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatStringBuilder = NEWOBJECT(CHILKAT_STRINGBUILDER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getredirectrequestparam		&& Introduced in version 9.5.0.69. Some OAuth2 providers can provide additional parameters in the redirect request sent to the local listener (i.e. the Chilkat background thread).
		*==============================================================================
		* Method:            GetRedirectRequestParam
		* Purpose:           After the OAuth2 authentication is completed, 
		*                    an application can call this method to get any of the parameter values.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcParameterValue, the name of the query parameter.
		* Returns:           The parameter value.
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.69
		**
		** Some OAuth2 providers can provide additional parameters 
		** in the redirect request sent to the local listener 
		** (i.e. the Chilkat background thread). One such case is for QuickBooks, 
		** it contains a realmId parameter such as the following:
		**
		** http://localhost:55568/?state=xxxxxxxxxxxx&code=xxxxxxxxxxxx&realmId=1234567890
		**
		** After the OAuth2 authentication is completed, an application can call 
		** this method to get any of the parameter values. 
		** For example, to get the realmId value, pass "realmId" in paramName.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcParameterValue AS Character
		
		LOCAL loChilkatObject AS CHILKAT_OAUTH2_COM_CALL, ;
		loException AS Exception, llImplemented AS Logical, ;
		liIntroducedInBuild AS Integer, lcParameterValue AS Character
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcParameterValue = []
		llImplemented = .F.
		liIntroducedInBuild = 69
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        lcParameterValue = m.loChilkatObject.GetRedirectRequestParam(m.tcParameterValue)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcParameterValue
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_OAUTH2_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE includenonce_access		&& Access method used to retrieve the Chilkat oAuth2 IncludeNonce property.
		*==============================================================================
		* Method:            IncludeNonce_Access
		* Purpose:           Access method used to retrieve 
		*                    the IncludeNonce property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.IncludeNonce
		* Date Added:        06/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.78
		**
		** Optional. Set this to 1 to send a nonce with the authorization request. 
		** The default value is 0.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 78
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
		
	ENDPROC

