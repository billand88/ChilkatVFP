	PROCEDURE pinauthenticate		&& Introduced in version 9.5.0.87. Performs regular PIN authentication. The pinId can be "user", "admin", or "3" through "7". (It is typically "user".) The pin is the alphanumeric PIN. Returns 0 for success.
		*==============================================================================
		* Method:            PINAuthenticate
		* Purpose:           Performs regular PIN authentication.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcPINID, the PIN ID to authenticate.
		*                    tcPIN, the alphanumeric PIN.
		* Returns:           An integer value indicating the PIN status
		* Date Added:        07/09/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.87
		** 
		** Performs regular PIN authentication. The pinId can be "user", "admin", or "3" through "7". 
		** (It is typically "user".) The pin is the alphanumeric PIN.
		**
		** Returns 0 for success. If not successful, the return value indicates 
		** the number of attempts remaining before the PIN is locked. 
		** (The number of times an incorrect PIN may be presented to the card before the PIN is blocked, 
		** and requires the admin to unblock it.) If the PIN is already blocked, the return value is -1. 
		** If the method fails for some other reason, such as if a context has not yet been acquired, 
		** the return value is -2.
		**
		
		LPARAMETERS tcPINID AS Character, tcPIN AS Character
		
		LOCAL loChilkatObject AS CHILKAT_SCMINIDRIVER_COM_CALL, loException AS Exception, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, liPINStatus AS Integer
		
		STORE 0 TO m.liPINStatus, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 87
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      TRY
		
		        liPINStatus = m.loChilkatObject.PINAuthenticate(m.tcPINID, m.tcPIN)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liPINStatus
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SCMINIDRIVER_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

