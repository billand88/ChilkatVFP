	HIDDEN PROCEDURE lasterrorhtml_access		&& Access method used to retrieve the Chilkat TrustedRoots LastErrorHTML property.
		*==============================================================================
		* Method:            LastErrorHTML_Access
		* Purpose:           Access method used to retrieve 
		*                    the LastErrorHTML property of the referenced Chilkat object.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.LastErrorHTML
		* Date Added:        07/07/2022
		*==============================================================================
		
		** 
		** Provides information in HTML format about the last method/property called. 
		** If a method call returns a value indicating failure, or behaves unexpectedly, 
		** examine this property to get more information.
		** 
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, lcProperty AS Character, ;
		lcMethodToCall AS Character, liIntroducedInBuild AS Integer
		
		LOCAL ARRAY la_Stack[1, 1]
		
		STORE 0 TO m.liStackLevel, m.liIntroducedInBuild
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [StringReadOnly]
		
		THIS.CallAccessObject(m.lcMethodToCall, m.liIntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

	HIDDEN PROCEDURE lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*==============================================================================
		* Method:            LastErrorHTML_Assign
		* Purpose:           Assign method used to retrieve 
		*                    the LastErrorHTML property of the referenced Chilkat object.
		* Author:            Bill Anderson
