	PROCEDURE verifyprivatekey		&& Returns 1 if the XML contains a valid RSA private key. Otherwise returns 0. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            VerifyPrivateKey
		* Purpose:           Returns 1 if the XML contains a valid RSA private key. Otherwise returns 0.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcXML, the XML with the private key.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Returns 1 if the XML contains a valid RSA private key. Otherwise returns 0.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS tcXML AS Character
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.VerifyPrivateKey(m.tcXML) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .LogicalToBit(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE verifyrawbd		&& Introduced in version 11.0.0. This is legacy low-level raw RSA that duplicates the (now deprecated) OpenSSL rsautl utility.
		*==============================================================================
		* Method:            VerifyRawBd
		* Purpose:           This is legacy low-level raw RSA that duplicates 
		*                    the (now decremented) OpenSSL rsautl utility.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        toChilkatBinData, a Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        05/08/2025
		*==============================================================================
		
		**
		** Introduced in version 11.0.0
		**
		** This is legacy low-level raw RSA that duplicates the (now decremented) 
		** OpenSSL rsautl utility. It validates signed raw data and recovers the original data. 
		** The RSA signature to be verified is passed in bd, and on return the content of bd 
		** is replaced with the original data.
		** 
		** Returns 1 for success, 0 for failure.
		** 
		
		LPARAMETERS toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, liReturn AS Integer, ;
		llImplemented AS Logical, loException AS Exception, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(11, 0, 0)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.VerifyRawBd(m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE verifystring		&& Verifies an RSA digital signature. Returns 1 if the signature is valid for the originalString. The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*==============================================================================
		* Method:            VerifyString
		* Purpose:           Verifies an RSA digital signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOriginalString, the original string.
		*                    tcHashAlgorithm, the hash algorithm used to verify.
		*                    tqBinarySignature, the binary signature bytes.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Verifies an RSA digital signature. Returns 1 if the signature is valid for the originalString. 
		** The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". 
		** The recommended hash algorithm is "SHA-1".
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		** 
		
		LPARAMETERS tcOriginalString AS Character, ;
		tcHashAlgorithm AS Character, tqBinarySignature AS VarBinary
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.VerifyString(m.tcOriginalString, ;
		      m.tcHashAlgorithm, m.tqBinarySignature) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .LogicalToBit(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE verifystringenc		&& Verifies an RSA digital signature. Returns 1 if the signature is valid for the originalString. The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". The recommended hash algorithm is "SHA-1".
		*==============================================================================
		* Method:            VerifyStringENC
		* Purpose:           Verifies an RSA digital signature.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcOriginalString, the original string.
		*                    tcHashAlgorithm, the hash algorithm used to verify.
		*                    tcEncodedSignature, the encoded signature bytes.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/12/2022
		*==============================================================================
		
		**
		** Verifies an RSA digital signature. 
		** Returns 1 if the signature is valid for the originalString. 
		** The hashAlgorithm may be "SHA-1", "MD5", "MD2", "SHA-256", "SHA-384", or "SHA-512". 
		** The recommended hash algorithm is "SHA-1".
		** 
		** The encodedSig is a digital signature encoded according to the EncodingMode property 
		** (i.e. base64, hex, etc.).
		**
		** Enhancement to Version 67:
		** Chilkat now fully supports ECC certificates in all ways.
		**
		** Enhancement to Version 69:
		** Chilkat now fully supports certificates that use the RSASSA-PSS signature algorithm.
		**
		** Enhancement to Version 83: Added the SHA3 hash algorithms: 
		** sha3-224, sha3-256, sha3-384, sha3-512. 
		** The SHA3 hash algorithms may generally be used in any property or method 
		** of any Chilkat class where a hash algorithm is specified.
		**
		** Enhancement for Version 95: Added support for SHA224 in all places where a hash algorithm might be specified.
		** 
		
		LPARAMETERS tcOriginalString AS Character, ;
		tcHashAlgorithm AS Character, tcEncodedSignature AS Character
		
		LOCAL loChilkatObject AS CHILKAT_RSA_COM_CALL, ;
		loException AS Exception, liReturn AS Integer, luReturn AS Unknown
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      STORE m.loChilkatObject.VerifyStringENC(m.tcOriginalString, ;
		      m.tcHashAlgorithm, m.tcEncodedSignature) TO m.liReturn, m.luReturn
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		  luReturn = .LogicalToBit(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_RSA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

ENDDEFINE

DEFINE CLASS rss AS ibasechilkat OF "chilkatvfp.vcx" 		&& Represents an RSS document or sub-part of a document such as a channel, image, or item. The RSS API allows one to download, create and modify RSS documents. Decremented in version 10.1.0.
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "Foxpro.H"
	*<DefinedPropArrayMethod>
		*m: addnewchannel		&& Adds a new channel to the RSS document. Returns the Rss object representing the Channel which can then be edited. Returns Nothing on failure
		*m: addnewimage		&& Adds a new image to the RSS document. Returns the Rss object representing the image, which can then be edited. Returns Nothing on failure
		*m: addnewitem		&& Adds a new Item to an Rss channel. Returns the Rss object representing the item which can then be edited. LasReturns Nothing on failure
		*m: debuglogfilepath_access		&& Access method used to retrieve the Chilkat RSS DebugLogFilePath property.
		*m: debuglogfilepath_assign		&& Assign method used to hold a reference to the DebugLogFilePath property.
		*m: downloadrss		&& Downloads an RSS document from the Internet and populates the Rss object with the contents. Returns 1 for success, 0 for failure.
		*m: downloadrssasync		&& Creates an asynchronous task to call the DownloadRss method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.) Note: Async method event callbacks happen in the background thread.
		*m: getattr		&& Returns the value of a sub-element attribute. For example, to get the value of the "isPermaLink" attribute of the "guid" sub-element, call item.GetAttr("guid","isPermaLink"). Returns Nothing on failure.
		*m: getchannel		&& Returns the Nth channel of an RSS document. Usually there is only 1 channel per document, so the index argument should be set to 0. Returns Nothing on failure.
		*m: getcount		&& Return the number of sub-elements with a specific tag.
		*m: getdate		&& Undocumented method!
		*m: getdatestr		&& The same as GetDate, except the date/time is returned in RFC822 string format. Returns Nothing on failure.
		*m: getimage		&& Return the image associated with the channel. Returns Nothing on failure.
		*m: getint		&& Return the value of a numeric sub-element as an integer.
		*m: getitem		&& Return the Nth item of a channel as an RSS object. Returns Nothing on failure.
		*m: getstring		&& Return the value of an sub-element as a string. Returns Nothing on failure.
		*m: lastbinaryresult_access		&& Access method used to retrieve the Chilkat RSS LastBinaryResult property.
		*m: lastbinaryresult_assign		&& Assign method used to hold a reference to the LastBinaryResult property.
		*m: lasterrorhtml_access		&& Access method used to retrieve the Chilkat RSS LastErrorHTML property.
		*m: lasterrorhtml_assign		&& Assign method used to hold a reference to the LastErrorHTML property.
		*m: lasterrortext_access		&& Access method used to retrieve the Chilkat RSS LastErrorText property.
		*m: lasterrortext_assign		&& Assign method used to hold a reference to the LastErrorText property.
		*m: lasterrorxml_access		&& Access method used to retrieve the Chilkat RSS LastErrorXML property.
		*m: lasterrorxml_assign		&& Assign method used to hold a reference to the LastErrorXML property.
		*m: lastmethodsuccess_access		&& Access method used to retrieve the Chilkat RSS LastMethodSuccess property.
		*m: lastmethodsuccess_assign		&& Assign method used to hold a reference to the LastMethodSuccess property.
		*m: laststringresultlen_access		&& Access method used to retrieve the Chilkat RSS LastStringResultLen property.
		*m: laststringresultlen_assign		&& Assign method used to hold a reference to the LastStringResultLen property.
		*m: laststringresult_access		&& Access method used to retrieve the Chilkat RSS LastStringResult property.
		*m: laststringresult_assign		&& Assign method used to hold a reference to the LastStringResult property.
		*m: loadrssfile		&& Load an RSS document from a file. Returns 1 for success, 0 for failure.
		*m: loadrssstring		&& Loads an RSS feed document from an in-memory string. Returns 1 for success, 0 for failure.
		*m: loadtaskcaller		&& Introduced in version 9.5.0.80. Loads the caller of the task's async method. Returns 1 for success, 0 for failure.
		*m: mgetattr		&& Get an attribute value for the Nth sub-element having a specific tag. As an example, an RSS item may have several "category" sub-elements.  To get the value of the "domain" attribute for the 3rd category, call MGetAttr("category",2,"domain").
		*m: mgetstring		&& Get the value of the Nth occurrence of a sub-element. Indexing begins at 0. Returns Nothing on failure.
		*m: msetattr		&& Set an attribute on the Nth occurrence of a sub-element. Returns 1 for success, 0 for failure.
		*m: msetstring		&& Set the value of the Nth occurrence of a sub-element. Indexing begins at 0. Returns 1 for success, 0 for failure.
		*m: newrss		&& Clears the RSS document.
		*m: numchannels_access		&& Access method used to retrieve the Chilkat RSS NumChannels property.
		*m: numchannels_assign		&& Assign method used to hold a reference to the NumChannels property.
		*m: numitems_access		&& Access method used to retrieve the Chilkat RSS NumItems property.
		*m: numitems_assign		&& Assign method used to hold a reference to the NumItems property.
		*m: remove		&& Removes a sub-element from the RSS document.
		*m: setattr		&& Sets the value of a sub-element attribute.
		*m: setdate		&& Undocumented method!
		*m: setdatenow		&& Sets the value of a date/time sub-element to the current system date/time.
		*m: setdatestr		&& The same as SetDate, except the date/time is passed as an RFC822 string.The same as SetDate, except the date/time is passed as an RFC822 string.The same as SetDate, except the date/time is passed as an RFC822 string.
		*m: setint		&& Sets the value of an integer sub-element.
		*m: setstring		&& Sets the value of a sub-element.
		*m: toxmlstring		&& Returns the RSS document as an XML string. Returns Nothing on failure.
		*m: verboselogging_access		&& Access method used to retrieve the Chilkat RSS VerboseLogging property.
		*m: verboselogging_assign		&& Assign method used to hold a reference to the VerboseLogging property.
		*p: debuglogfilepath		&& If set to a file path, causes each Chilkat method or property call to automatically append it's LastErrorText to the specified log file.
		*p: lastbinaryresult		&& Introduced in version 9.5.0.52. The binary data returned by the last (binary data returning) method called. Only available if Chilkat.Global.KeepBinaryResult is set to 1.
		*p: lasterrorhtml		&& Provides information in HTML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrortext		&& Provides information in plain-text format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lasterrorxml		&& Provides information in XML format about the last method/property called. If a method call returns a value indicating failure, or behaves unexpectedly, examine this property to get more information.
		*p: lastmethodsuccess		&& Introduced in version 9.5.0.52. Indicate whether the last method call succeeded or failed. A value of 1 indicates success, a value of 0 indicates failure. This property is automatically set for method calls. It is not modified by property accesses.
		*p: laststringresult		&& Introduced in version 9.5.0.52. The string return value of the last (string returning) method called. Only available if Chilkat.Global.KeepStringResult is set to 1.
		*p: laststringresultlen		&& Introduced in version 9.5.0.53. The length, in characters, of the string contained in the LastStringResult property.
		*p: numchannels		&& The number of channels in the RSS document.
		*p: numitems		&& The number of items in the channel.
		*p: verboselogging		&& If set to 1, then the contents of LastErrorText (or LastErrorXml, or LastErrorHtml) may contain more verbose information. The default value is 0. Verbose logging should only be used for debugging.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchilkatclass = Rss
		ceventhandlerclass = iBaseEventHandler
		debuglogfilepath = 
		iretirementmajor = 11
		lastbinaryresult = .NULL.
		lasterrorhtml = 
		lasterrortext = 
		lasterrorxml = 
		lastmethodsuccess = 1
		laststringresult = 
		laststringresultlen = 0
		Name = "rss"
		numchannels = 0
		numitems = 0
		verboselogging = 0
	*</PropValue>
	
	PROCEDURE addnewchannel		&& Adds a new channel to the RSS document. Returns the Rss object representing the Channel which can then be edited. Returns Nothing on failure
		*==============================================================================
		* Method:            AddNewChannel
		* Purpose:           Adds a new channel to the RSS document.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           A Chilkat RSS object.
		* Date Added:        06/27/2022
		*==============================================================================
		
		**
		** Adds a new channel to the RSS document. 
		** Returns the Rss object representing the Channel which can then be edited.
		** 
		** Returns Nothing on failure
		**
		
		LOCAL loChilkatObject AS [Chilkat_9_5_0.Rss], ;
		loException AS Exception, loChilkatRSS AS [Chilkat_9_5_0.Rss]
		
		STORE NULL TO m.loChilkatObject, m.loException, m.loChilkatRSS
		
		WITH THIS
		
		  loChilkatObject = .oChilkat
		
		  ** Have a good object test
		  IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		
		    TRY
		
		      loChilkatRSS = m.loChilkatObject.AddNewChannel()
		
		    CATCH TO m.loException
		
		      .CallToChilkatError(m.loException, THIS)
		
		    ENDTRY
		
		  ELSE
		
		    .MissingObjectError(THIS)
		
		  ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		  AND (NOT ISNULL(m.loChilkatObject))
		  ** End have a good object test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.loChilkatRSS
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT([Chilkat_9_5_0.Rss])
		  loChilkatRSS = NEWOBJECT([Chilkat_9_5_0.Rss])
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE addnewimage		&& Adds a new image to the RSS document. Returns the Rss object representing the image, which can then be edited. Returns Nothing on failure
		*==============================================================================
