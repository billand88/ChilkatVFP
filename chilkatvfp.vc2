	PROCEDURE getnthbinarypartoftype		&& Returns the binary bytes of the Nth MIME sub-part having a specified content type (such as "application/pdf". Indexing begins at 0. Call GetNumPartsOfType to find out how many MIME sub-parts exist for any given content type.
		*==============================================================================
		* Method:            GetNthBinaryPartOfType
		* Purpose:           Returns the binary bytes of the Nth MIME sub-part 
		*                    having a specified content type (such as "application/pdf").
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- Index to the MIME array.
		*                    tcContentType -- the content type to filter on.
		*                    tuInlineOnly -- Flag to determine if only
		*                    the "inline" types are returned.
		*                    tuExcludeAttachments -- Set to 1 to exclude attachment types.
		* Returns:           lqBinData, the returned byte array
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Returns the binary bytes of the Nth MIME sub-part having a specified content type 
		** (such as "application/pdf"). Indexing begins at 0. 
		** Call GetNumPartsOfType to find out how many MIME sub-parts exist for any given content type. 
		** If inlineOnly is 1, then only MIME sub-parts having a content-disposition of "inline" are included. 
		** If excludeAttachments is 1, then MIME sub-parts 
		** having a content-disposition of "attachment" are excluded.
		**
		** Note: If the email was downloaded as header-only, it will not contain all the parts of the full email. 
		** Also, if downloaded from IMAP excluding attachments, 
		** those parts that are the attachments will (of course) be missing.
		**
		** Note: Beginning in v9.5.0.95, the contentType can be wildcarded. 
		** For example, it is possible to specify "text/*", or simply "*" to match any Content-Type.
		**
		** Note: Only non-multipart MIME parts are matched.
		**
		** Enhancement for Version 73: 
		** Added more internal flexibility for handling mixtures of CRLF and bare-LF line endings.
		**
		** Returns a zero-length byte array (as a Variant) on failure.
		** An empty array will have a UBound of -1 meaning 0 elements.
		**
		
		LPARAMETERS tiIndex AS Integer, tcContentType AS Character, ;
		tuInlineOnly AS Unknown, tuExcludeAttachments AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liInlineOnly AS Integer, liExcludeAttachments AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lqBinData AS VarBinary
		
		STORE 0 TO m.liInlineOnly, m.liExcludeAttachments, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException, m.lqBinData
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liInlineOnly = .LogicalToBit(m.tuInlineOnly)
		      liExcludeAttachments = .LogicalToBit(m.tuExcludeAttachments)
		
		      TRY
		
		        lqBinData = ;
		        m.loChilkatObject.GetNthBinaryPartOfType(m.tiIndex, ;
		        m.tcContentType, m.liInlineOnly, m.liExcludeAttachments)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lqBinData
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getnthbinarypartoftypebd		&& Introduced in version 9.5.0.95. Loads bd with the binary bytes of the Nth MIME sub-part matching the contentType, which can be an exact Content-Type such as "application/pdf", or a wildcarded Content-Type such as "application/*", or "*/*".
		*==============================================================================
		* Method:            GetNthBinaryPartOfTypeBd
		* Purpose:           Loads bd with the binary bytes of the Nth MIME 
		*                    sub-part matching the contentType.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- Index to the MIME array.
		*                    tcContentType -- the content type to filter on.
		*                    tuInlineOnly -- Flag to determine if only the "inline" types are returned.
		*                    toChilkatBinData -- A Chilkat Binary Data object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        06/16/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.95
		**
		** Loads bd with the binary bytes of the Nth MIME sub-part matching the contentType, 
		** which can be an exact Content-Type such as "application/pdf", or a wildcarded Content-Type 
		** such as "application/*", or "*/*". Indexing begins at 0. 
		** Call GetNumPartsOfType to find out how many MIME sub-parts exist for any given content type. 
		** If inlineOnly is 1, then only MIME sub-parts having a content-disposition of "inline" are included. 
		** If excludeAttachments is 1, then MIME sub-parts having a content-disposition of "attachment" are excluded.
		** 
		** Note: If the email was downloaded as header-only, it will not contain all the parts of the full email. 
		** Also, if downloaded from IMAP excluding attachments, those parts that are 
		** the attachments will (of course) be missing.
		** 
		** Note: Beginning in v9.5.0.95, the contentType can be wildcarded. For example, 
		** it is possible to specify "text/*", or simply "*" to match any Content-Type.
		** 
		** Note: Only non-multipart MIME parts are matched.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tiIndex AS Integer, tcContentType AS Character, ;
		tuInlineOnly AS Unknown, tuExcludeAttachments AS Unknown, ;
		toChilkatBinData AS CHILKAT_BINDATA_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liInlineOnly AS Integer, liExcludeAttachments AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liReturn AS Integer, luReturn AS Unknown, ;
		loChilkatBinData AS CHILKAT_BINDATA_COM_CALL, ;
		loParkParameterBinData AS [iParkParameter OF ChilkatVFP.VCX]
		
		STORE 0 TO m.liReturn, m.luReturn, m.liInlineOnly, m.liExcludeAttachments, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loChilkatBinData, m.loParkParameterBinData, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 95
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liInlineOnly = .LogicalToBit(m.tuInlineOnly)
		      liExcludeAttachments = .LogicalToBit(m.tuExcludeAttachments)
		
		      loParkParameterBinData = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatBinData)
		
		      loChilkatBinData = m.loParkParameterBinData.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.GetNthBinaryPartOfTypeBd(m.tiIndex, ;
		        m.tcContentType, m.liInlineOnly, m.liExcludeAttachments, m.loChilkatBinData) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatBinData = ;
		      m.loParkParameterBinData.SetObject(m.toChilkatBinData, m.loChilkatBinData)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterBinData, m.loChilkatBinData
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  toChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loParkParameterBinData = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatBinData = NEWOBJECT(CHILKAT_BINDATA_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getnthcontenttype		&& Introduced in version 9.5.0.95. Returns the Content-Type of the Nth MIME sub-part matching the specified contentType.
		*==============================================================================
		* Method:            GetNthContentType
		* Purpose:           Returns the Content-Type of the Nth MIME 
		*                    sub-part matching the specified contentType.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- Index to the MIME array.
		*                    tcContentType -- the content type to filter on.
		*                    tuInlineOnly -- Flag to determine if only
		*                    the "inline" types are returned.
		*                    tuExcludeAttachments -- Set to 1 to exclude attachment types.
		* Returns:           lcContentType, the Content-Type
		* Date Added:        06/16/2023
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.95
		**
		** Returns the Content-Type of the Nth MIME sub-part matching the specified contentType. 
		** The contentType can be a Content-Type such as "text/plain", 
		** or a wildcarded Content-Type such as "text/*", or even just "*" to match all Content-Types. 
		** If inlineOnly is 1, then only MIME sub-parts having a content-disposition of "inline" are included. 
		** If excludeAttachments is 1, then MIME sub-parts having a content-disposition of "attachment" are excluded.
		** 
		** Note: Only non-multipart content-types are matched.
		** 
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer, tcContentType AS Character, ;
		tuInlineOnly AS Unknown, tuExcludeAttachments AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liInlineOnly AS Integer, liExcludeAttachments AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcContentType AS Character
		
		STORE 0 TO m.liInlineOnly, m.liExcludeAttachments, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		lcContentType = []
		llImplemented = .F.
		liIntroducedInBuild = 95
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liInlineOnly = .LogicalToBit(m.tuInlineOnly)
		      liExcludeAttachments = .LogicalToBit(m.tuExcludeAttachments)
		
		      TRY
		
		        lcContentType = ;
		        m.loChilkatObject.GetNthContentType(m.tiIndex, ;
		        m.tcContentType, m.liInlineOnly, m.liExcludeAttachments)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcContentType
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getnthtextpartoftype		&& Returns the text of the Nth MIME sub-part having a specified content type (such as "text/plain". Indexing begins at 0. Call GetNumPartsOfType to find out how many MIME sub-parts exist for any given content type.
		*==============================================================================
		* Method:            GetNthTextPartOfType
		* Purpose:           Returns the text of the Nth 
		*                    MIME sub-part having a specified content type
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiIndex -- Index to the MIME array.
		*                    tcContentType -- the content type to filter on.
		*                    tuInlineOnly -- Flag to determine if only
		*                    the "inline" types are returned.
		*                    tuExcludeAttachments -- Set to 1 to exclude attachment types.
		* Returns:           lcMIMEString, the MIME text to return
		* Date Added:        01/26/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Returns the text of the Nth MIME sub-part having a specified content type 
		** (such as "text/plain"). Indexing begins at 0. 
		** Call GetNumPartsOfType to find out how many MIME sub-parts exist for any given content type. 
		** If inlineOnly is 1, then only MIME sub-parts having 
		** a content-disposition of "inline" are included. 
		** If excludeAttachments is 1, then MIME sub-parts having 
		** a content-disposition of "attachment" are excluded.
		**
		** Note: If the email was downloaded as header-only, 
		** it will not contain all the parts of the full email. 
		** Also, if downloaded from IMAP excluding attachments, 
		** those parts that are the attachments will (of course) be missing.
		**
		** Note: Beginning in v9.5.0.95, the contentType can be wildcarded. 
		** For example, it is possible to specify "text/*", or simply "*" to match any Content-Type.
		**
		** Note: Only non-multipart MIME parts are matched.
		**
		** Enhancement for Version 73: 
		** Added more internal flexibility for handling mixtures of CRLF and bare-LF line endings.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tiIndex AS Integer, tcContentType AS Character, ;
		tuInlineOnly AS Unknown, tuExcludeAttachments AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liInlineOnly AS Integer, liExcludeAttachments AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		lcMIMEString AS Character
		
		STORE 0 TO m.liInlineOnly, m.liExcludeAttachments, m.liIntroducedInBuild 
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		lcMimeString = []
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liInlineOnly = .LogicalToBit(m.tuInlineOnly)
		      liExcludeAttachments = .LogicalToBit(m.tuExcludeAttachments)
		
		      TRY
		
		        lcMIMEString = m.loChilkatObject.GetNthTextPartOfType(m.tiIndex, ;
		        m.tcContentType, m.liInlineOnly, m.liExcludeAttachments)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.lcMIMEString
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE getnumpartsoftype		&& Returns the number of MIME sub-parts within the email having a specified content type (such as "text/plain"). If inlineOnly is 1, then only MIME sub-parts having a content-disposition of "inline" are included.
		*==============================================================================
		* Method:            GetNumPartsOfType
		* Purpose:           Returns the number of MIME sub-parts within the email 
		*                    having a specified content type
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcContentType -- the content type to filter on.
		*                    tuInlineOnly -- Flag to determine if only
		*                    the "inline" types are returned.
		*                    tuExcludeAttachments -- Set to 1 to exclude attachment types.
		* Returns:           1 for success, 0 for failure.
		* Date Added:        01/24/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.44
		**
		** Returns the number of MIME sub-parts within the email 
		** having a specified content type (such as "text/plain"). 
		** If inlineOnly is 1, then only MIME sub-parts having a content-disposition of "inline" are included. 
		** If excludeAttachments is 1, then MIME sub-parts having a content-disposition of "attachment" are excluded.
		**
		** Note: If the email was downloaded as header-only, 
		** it will not contain all the parts of the full email. 
		** Also, if downloaded from IMAP excluding attachments, 
		** those parts that are the attachments will (of course) be missing.
		**
		** Note: Beginning in v9.5.0.95, the inlineOnly can be wildcarded. For example, it is possible 
		** to specify "text/*", or simply "*" to match any Content-Type.
		** 
		** Note: Only non-multipart MIME parts are matched 
		** (i.e. leaf-node MIME parts that contain a text or binary body).
		**
		** Enhancement for Version 73: 
		** Added more internal flexibility for handling mixtures of CRLF and bare-LF line endings.
		**
		
		LPARAMETERS tcContentType AS Character, ;
		tuInlineOnly AS Unknown, tuExcludeAttachments AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_EMAIL_COM_CALL, loException AS Exception, ;
		liInlineOnly AS Integer, liExcludeAttachments AS Integer, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		liMatches AS Integer
		
		STORE 0 TO m.liInlineOnly, m.liExcludeAttachments, m.liIntroducedInBuild, m.liMatches
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 44
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liInlineOnly = .LogicalToBit(m.tuInlineOnly)
		      liExcludeAttachments = .LogicalToBit(m.tuExcludeAttachments)
		
		      TRY
		
		        liMatches = ;
		        m.loChilkatObject.GetNumPartsOfType(m.tcContentType, m.liInlineOnly, m.liExcludeAttachments)
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liMatches
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_EMAIL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

