	PROCEDURE disconnectallclients		&& Introduced in version 9.5.0.50. Disconnects all clients, keeping the SSH tunnel open. If waitForThreads is 1, the method will wait for the client threads to exit before returning. Returns 1 for success, 0 for failure.
		*==============================================================================
		* Method:            DisconnectAllClients
		* Purpose:           Disconnects all clients, keeping the SSH tunnel open.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tuWaitForAllThreadExits, whether or not to wait
		*                    for all threads to exit before closing.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        07/08/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		**
		** Disconnects all clients, keeping the SSH tunnel open. 
		** If waitForThreads is 1, the method will wait for the client threads 
		** to exit before returning.
		** 
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tuWaitForAllThreadExits AS Unknown
		
		LOCAL loChilkatObject AS CHILKAT_SSHTUNNEL_COM_CALL, ;
		llImplemented AS Logical, liIntroducedInBuild AS Integer, ;
		loException AS Exception, liReturn AS Integer, ;
		luReturn AS Unknown, liWaitForAllThreadExits AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn, m.liWaitForAllThreadExits, m.liIntroducedInBuild
		STORE NULL TO m.loChilkatObject, m.loException
		
		llImplemented = .F.
		liIntroducedInBuild = 50
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      liWaitForAllThreadExits = .LogicalToBit(m.tuWaitForAllThreadExits)
		
		      TRY
		
		        STORE m.loChilkatObject.DisconnectAllClients(m.liWaitForAllThreadExits) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException
		
		RETURN m.liReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_SSHTUNNEL_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	HIDDEN PROCEDURE dynamicportforwarding_access		&& Access method used to retrieve the Chilkat SSHTunnel DynamicPortForwarding property.
		*==============================================================================
		* Method:            DynamicPortForwarding_Access
		* Purpose:           Access method used to retrieve 
		*                    the Chilkat SSHTunnel DynamicPortForwarding property.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        
		* Returns:           THIS.DynamicPortForwarding
		* Date Added:        07/07/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.50
		**
		** If 1, then this behaves as a SOCKS proxy server for inbound connections. 
		** When this property is 1, the DestHostname and DestPort properties 
		** are unused because the destination IP:port is dynamically provided 
		** by the SOCKS client. The default value of this property is 0.
		**
		** When dynamic port forwarding is used, the InboundSocksVersion property 
		** must be set to 4 or 5. If inbound SOCKS5 is used, then the InboundSocksUsername 
		** and InboundSocksPassword may be set to the required login/password 
		** for a client to gain access.
		**
		** Fixed in Version 51: Fixed issues related to using 
		** HTTP proxies for non-HTTP protocols where SSL/TLS is not used.
		**
		
		LOCAL liStackLevel AS Integer, lcMethod AS Character, ;
		lcProperty AS Character, lcMethodToCall AS Character
		
		LOCAL ARRAY la_Stack[1, 1], la_IntroducedInBuild[3, 1]
		
		STORE [] TO m.lcMethod, m.lcProperty, m.lcMethodToCall, m.la_Stack, m.la_IntroducedInBuild
		
		liStackLevel = ASTACKINFO(la_Stack)
		
		lcMethod = m.la_Stack(m.liStackLevel, 3)
		lcMethod = PROPER(SUBSTRC(m.lcMethod, AT_C([.], m.lcMethod) + 1))
		lcProperty = LEFTC(m.lcMethod, LENC(m.lcMethod) - 7)
		
		lcMethodToCall = [LongBit]
		
		la_IntroducedInBuild[1] = 9
		la_IntroducedInBuild[2] = 5
		la_IntroducedInBuild[3] = 50
		
		THIS.CallAccessObject(m.lcMethodToCall, @m.la_IntroducedInBuild)
		
		RETURN EVALUATE([THIS.] + m.lcProperty)
	ENDPROC

