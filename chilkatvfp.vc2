	PROCEDURE sharepointonlineauth		&& Authenticates with SharePoint Online, resulting in a cookie being set and used for subsequent SharePoint HTTP requests.
		*==============================================================================
		* Method:            SharePointOnlineAuth
		* Purpose:           Authenticates with SharePoint Online.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSiteURL -- the site URL 
		*                    tcUserName -- the login user name.
		*                    toChilkatSecureString -- a Chilkat Secure String object.
		*                    toChilkatJSONObject -- a Chilkat JSON object.
		* Returns:           Returns 1 for success, 0 for failure.
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.73
		**
		** Authenticates with SharePoint Online, resulting in a cookie being set 
		** and used for subsequent SharePoint HTTP requests. 
		** Prior to calling this method, an application 
		** should set the CookieDir property to either "memory" 
		** or a directory path to persist the SharePoint authentication cookie 
		** to be automatically used in subsequent runs.
		**
		** This method has the side-effect of setting the SaveCookies and SendCookies properties to 1, 
		** because these settings are required for SharePoint Online authentication.
		**
		** The siteUrl is a URL such as "https://yourdomain.sharepoint.com/". 
		** The username is an email address such as "username@yourdomain.com". 
		** The extraInfo is reserved for providing additional information as needed in the future.
		**
		** Returns 1 for success, 0 for failure.
		**
		
		LPARAMETERS tcSiteURL AS Character, tcUserName AS Character, ;
		toChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL, ;
		toChilkatJSONObject AS CHILKAT_JSONOBJECT_COM_CALL
		
		LOCAL loChilkatObject AS CHILKAT_HTTP_COM_CALL, loException AS Exception, ;
		liReturn AS Integer, luReturn AS Unknown, llImplemented AS Logical, ;
		loParkParameterSecureString AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatSecureString AS CHILKAT_SECURESTRING_COM_CALL, ;
		loParkParameterJsonObject AS [iParkParameter OF ChilkatVFP.VCX], ;
		loChilkatJsonObject AS CHILKAT_JSONOBJECT_COM_CALL, ;
		liIntroducedInBuild AS Integer
		
		STORE 0 TO m.liReturn, m.luReturn
		STORE NULL TO m.loChilkatObject, m.loException, m.loParkParameterSecureString, ;
		m.loChilkatSecureString, m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		llImplemented = .F.
		liIntroducedInBuild = 73
		
		WITH THIS
		
		  llImplemented = .IsPEMImplemented(9, 5, m.liIntroducedInBuild)
		
		  ** Method implemented test
		  IF m.llImplemented
		
		    loChilkatObject = .oChilkat
		
		    ** Have a good object test
		    IF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		
		      loParkParameterSecureString = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatSecureString)
		
		      loParkParameterJsonObject = ;
		      NEWOBJECT([iParkParameter], .ClassLibrary, [], m.toChilkatJsonObject)
		
		      loChilkatSecureString = m.loParkParameterSecureString.GetObject()
		      loChilkatJsonObject = m.loParkParameterJsonObject.GetObject()
		
		      TRY
		
		        STORE m.loChilkatObject.SharePointOnlineAuth(m.tcSiteURL, ;
		        m.tcUserName, m.loChilkatSecureString, m.loChilkatJSONObject) ;
		        TO m.liReturn, m.luReturn
		
		      CATCH TO m.loException
		
		        .CallToChilkatError(m.loException, THIS)
		
		      ENDTRY
		
		      toChilkatSecureString = m.loParkParameterSecureString.SetObject(;
		      m.toChilkatSecureString, m.loChilkatSecureString)
		
		      toChilkatJsonObject = ;
		      m.loParkParameterJsonObject.SetObject(m.toChilkatJsonObject, m.loChilkatJsonObject)
		
		    ELSE
		
		      .MissingObjectError(THIS)
		
		    ENDIF VARTYPE(m.loChilkatObject) == T_OBJECT ;
		    AND (NOT ISNULL(m.loChilkatObject))
		    ** End have a good object test
		
		  ENDIF m.llImplemented
		  ** End method implemented test
		
		  luReturn = .BitToLogical(m.liReturn)
		
		ENDWITH
		
		STORE NULL TO m.loChilkatObject, m.loException, ;
		m.loParkParameterSecureString, m.loChilkatSecureString, ;
		m.loParkParameterJsonObject, m.loChilkatJsonObject
		
		RETURN m.luReturn
		
		** Design time IntelliSense test
		#IF .F.
		
		  loChilkatObject = NEWOBJECT(CHILKAT_HTTP_COM_CALL)
		  toChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  toChilkatJSONObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loParkParameterSecureString = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatSecureString = NEWOBJECT(CHILKAT_SECURESTRING_COM_CALL)
		  loParkParameterJsonObject = NEWOBJECT([iParkParameter], [ChilkatVFP.VCX])
		  loChilkatJsonObject = NEWOBJECT(CHILKAT_JSONOBJECT_COM_CALL)
		  loException = NEWOBJECT([Exception])
		
		#ENDIF .F.
		** End design time IntelliSense test
	ENDPROC

	PROCEDURE sharepointonlineauthasync		&& Creates an asynchronous task to call the SharePointOnlineAuth method with the arguments provided. (Async methods are available starting in Chilkat v9.5.0.52.)
		*==============================================================================
		* Method:            SharePointOnlineAuthAsync
		* Purpose:           Creates an asynchronous task to call the 
		*                    SharePointOnlineAuth method with the arguments provided.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tcSiteURL -- the site URL 
		*                    tcUserName -- the login username.
		*                    toChilkatSecureString -- a Chilkat Secure String object.
		*                    toChilkatJSONObject -- a Chilkat JSON object.
		* Returns:           Chilkat Task object or NULL
		* Date Added:        02/02/2022
		*==============================================================================
		
		**
		** Introduced in version 9.5.0.73
		**
		** Creates an asynchronous task to call the SharePointOnlineAuth method with the arguments provided. 
		** (Async methods are available starting in Chilkat v9.5.0.52.)
		**
		** Note: Async method event callbacks happen in the background thread. 
		** Accessing and updating UI elements existing in the main thread may require special considerations.
		**
		** Returns Nothing on failure
		**
		
		LPARAMETERS tcSiteURL AS Character, tcUserName AS Character, ;
