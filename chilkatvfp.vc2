	PROCEDURE endreceive		&& This event is fired after the complete HTTP response has been received.
		*==============================================================================
		* Method:            EndReceive
		* Purpose:           This event is fired after the complete HTTP response has been received.
		* Author:            Bill Anderson
		* Notice:            Copyright (c) 2022 - 2026 The Anderson Files LLC, All Rights Reserved.
		* Parameters:        tiSuccess, boolean flag indicating success.
		* Returns:           
		* Date Added:        10/21/2022
		*==============================================================================
		
		**
		** This event is fired after the complete HTTP response has been received.
		**
		
		LPARAMETERS tiSuccess AS Integer
		
		LOCAL liSuccess AS Integer
		
		liSuccess = m.tiSuccess
		
		*!*  ? [EndReceive Event!]
		
		WITH THIS
		
		  ** OK to continue test
		  IF m.liSuccess = 1
		
		    liSuccess = .EndReceive_Pre(m.liSuccess)
		
		    ** OK to continue test
		    IF m.liSuccess = 1
		
		      liSuccess = .EndReceive_Process(m.liSuccess)
		
		      ** OK to continue test
		      IF m.liSuccess = 1
		
		        liSuccess = .EndReceive_Post(m.liSuccess)
		
		      ENDIF m.liSuccess = 1
		      ** End OK to continue test
		
		    ENDIF m.liSuccess = 1
		    ** End OK to continue test
		
		  ENDIF m.liSuccess = 1
		  ** End OK to continue test
		
		ENDWITH
		
		tiSuccess = m.liSuccess
		
		RETURN
	ENDPROC

